def _draw_screw(cr: cairo.Context, x: float, y: float, r: float = 4.2):
    cr.arc(x + 0.8, y + 1.0, r, 0, 2 * math.pi)
    cr.set_source_rgba(0.03, 0.04, 0.05, 0.8)
    cr.fill()
    g = cairo.LinearGradient(x - r, y - r, x + r, y + r)
    g.add_color_stop_rgb(0.0, 0.56, 0.60, 0.68)
    g.add_color_stop_rgb(1.0, 0.22, 0.25, 0.30)
    cr.arc(x, y, r, 0, 2 * math.pi)
    cr.set_source(g)
    cr.fill()
    cr.set_line_width(1.2)
    cr.set_source_rgb(0.12, 0.14, 0.17)
    cr.move_to(x - r * 0.55, y - r * 0.35)
    cr.line_to(x + r * 0.55, y + r * 0.35)
    cr.stroke()


def render_tape_well(
    cr: cairo.Context,
    W: float,
    H: float,
    reel_mode: str,
    progress: float,
    reel_angle_l: float,
    reel_angle_r: float,
    transport_mode: str,
    tension_flex: float,
):
    """Render the backlit smoked-acrylic 4-Track Tape Well (7" NAB Reels OR Studio Cassette Shell)."""
    # Outer brushed dark anodized aluminum deck plate
    cr.rectangle(0, 0, W, H)
    plate = cairo.LinearGradient(0, 0, 0, H)
    plate.add_color_stop_rgb(0.0, 0.18, 0.20, 0.25)
    plate.add_color_stop_rgb(0.5, 0.14, 0.16, 0.20)
    plate.add_color_stop_rgb(1.0, 0.11, 0.13, 0.16)
    cr.set_source(plate)
    cr.fill()

    for sx, sy in ((10, 10), (W - 10, 10), (10, H - 10), (W - 10, H - 10)):
        _draw_screw(cr, sx, sy, 3.8)

    # Recessed smoked acrylic viewing well
    wx, wy, ww, wh = 18.0, 8.0, W - 36.0, H - 16.0
    cr.rectangle(wx, wy, ww, wh)
    cr.set_source_rgb(0.07, 0.06, 0.06)
    cr.fill()

    # Warm honey-amber incandescent interior cabinet illumination
    lamp = cairo.RadialGradient(wx + ww * 0.5, wy + 18.0, 10.0, wx + ww * 0.5, wy + wh * 0.52, ww * 0.62)
    lamp.add_color_stop_rgb(0.0, 0.68, 0.45, 0.18)
    lamp.add_color_stop_rgb(0.45, 0.36, 0.23, 0.10)
    lamp.add_color_stop_rgb(1.0, 0.10, 0.08, 0.07)
    cr.rectangle(wx + 3, wy + 3, ww - 6, wh - 6)
    cr.set_source(lamp)
    cr.fill()

    # Brushed steel inner backplate texture lines
    cr.set_line_width(1.0)
    cr.set_source_rgba(1.0, 0.85, 0.55, 0.035)
    for y_line in range(int(wy + 8), int(wy + wh - 8), 4):
        cr.move_to(wx + 5, y_line)
        cr.line_to(wx + ww - 5, y_line)
    cr.stroke()

    p = max(0.0, min(1.0, progress))
    engaged = transport_mode in ("PLAY", "REC")

    if reel_mode == "nab":
        # ---- MODE A: Twin 7" Spun-Aluminum 3-Slot NAB Reels ----
        cy = wy + wh * 0.43
        cx_l = wx + ww * 0.275
        cx_r = wx + ww * 0.725
        r_flange = min(ww * 0.205, wh * 0.39)
        r_hub = r_flange * 0.34
        r_max_tape = r_flange * 0.91
        r_min_tape = r_hub * 1.15

        # Area-conserving magnetic tape pancake radii
        r_tape_l = math.sqrt((r_max_tape ** 2) * (1.0 - p) + (r_min_tape ** 2) * p)
        r_tape_r = math.sqrt((r_min_tape ** 2) * (1.0 - p) + (r_max_tape ** 2) * p)

        # Lower Tape Path Geometry (Tension arms, stainless guides, Permalloy head block, Capstan)
        head_y = wy + wh - 24.0
        guide_l_x, guide_l_y = wx + 36.0, wy + wh - 40.0 + tension_flex * 5.5
        guide_r_x, guide_r_y = wx + ww - 36.0, wy + wh - 40.0 - tension_flex * 4.5
        cap_x, cap_y = wx + ww * 0.66, head_y - 3.0

        # Draw dark ferric-oxide 1/4" magnetic tape ribbon first (behind reel top flanges)
        cr.set_line_width(3.0)
        cr.set_source_rgb(0.32, 0.18, 0.10)
        cr.move_to(cx_l - r_tape_l * 0.65, cy + r_tape_l * 0.75)
        cr.line_to(guide_l_x, guide_l_y)
        cr.line_to(wx + ww * 0.38, head_y - 2.0)
        cr.line_to(wx + ww * 0.62, head_y - 2.0)
        cr.line_to(cap_x, cap_y + 2.0)
        cr.line_to(guide_r_x, guide_r_y)
        cr.line_to(cx_r + r_tape_r * 0.65, cy + r_tape_r * 0.75)
        cr.stroke()

        # Draw Supply & Takeup NAB Reels
        for cx, r_tape, ang, tag in (
            (cx_l, r_tape_l, reel_angle_l, "SUPPLY"),
            (cx_r, r_tape_r, reel_angle_r, "TAKEUP"),
        ):
            # Drop shadow on backplate
            cr.arc(cx + 3.0, cy + 4.0, r_flange + 1.5, 0, 2 * math.pi)
            cr.set_source_rgba(0.02, 0.02, 0.02, 0.65)
            cr.fill()

            # Rear reel flange rim
            cr.arc(cx, cy, r_flange, 0, 2 * math.pi)
            cr.set_source_rgb(0.38, 0.40, 0.45)
            cr.fill()

            # Dark brown oxide magnetic tape pancake + subtle concentric winding sheen
            cr.arc(cx, cy, r_tape, 0, 2 * math.pi)
            cr.set_source_rgb(0.22, 0.12, 0.07)
            cr.fill()
            for ring_f in (0.55, 0.72, 0.88):
                rr = r_hub + (r_tape - r_hub) * ring_f
                if rr > r_hub + 2.0:
                    cr.arc(cx, cy, rr, 0, 2 * math.pi)
                    cr.set_line_width(0.8)
                    cr.set_source_rgba(0.46, 0.27, 0.15, 0.35)
                    cr.stroke()

            # Front Spun-Aluminum NAB Flange with 3 Trapezoidal Cutout Windows!
            cr.save()
            cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
            cr.arc(cx, cy, r_flange, 0, 2 * math.pi)
            for k in range(3):
                a_mid = ang + k * (2.0 * math.pi / 3.0)
                a_w_in = 0.34
                a_w_out = 0.42
                r_in = r_hub * 1.18
                r_out = r_flange * 0.86
                cr.move_to(cx + r_in * math.cos(a_mid - a_w_in), cy + r_in * math.sin(a_mid - a_w_in))
                cr.arc(cx, cy, r_out, a_mid - a_w_out, a_mid + a_w_out)
                cr.arc_negative(cx, cy, r_in, a_mid + a_w_in, a_mid - a_w_in)
                cr.close_path()

            alu = cairo.LinearGradient(cx - r_flange, cy - r_flange, cx + r_flange, cy + r_flange)
            alu.add_color_stop_rgb(0.0, 0.90, 0.92, 0.96)
            alu.add_color_stop_rgb(0.35, 0.68, 0.72, 0.79)
            alu.add_color_stop_rgb(0.52, 0.94, 0.95, 0.98)
            alu.add_color_stop_rgb(0.78, 0.56, 0.60, 0.68)
            alu.add_color_stop_rgb(1.0, 0.78, 0.81, 0.88)
            cr.set_source(alu)
            cr.fill_preserve()
            cr.set_fill_rule(cairo.FILL_RULE_WINDING)
            cr.set_line_width(1.1)
            cr.set_source_rgba(0.18, 0.20, 0.24, 0.85)
            cr.stroke()
            cr.restore()

            # Center NAB Hub Ring + 3 Mounting Screws + Trident Spindle Clamp
            cr.arc(cx, cy, r_hub * 0.88, 0, 2 * math.pi)
            cr.set_source_rgb(0.78, 0.81, 0.87)
            cr.fill()
            cr.arc(cx, cy, r_hub * 0.52, 0, 2 * math.pi)
            cr.set_source_rgb(0.15, 0.17, 0.21)
            cr.fill()
            for k in range(3):
                sa = ang + k * (2.0 * math.pi / 3.0) + 0.52
                cr.arc(cx + r_hub * 0.68 * math.cos(sa), cy + r_hub * 0.68 * math.sin(sa), 1.6, 0, 2 * math.pi)
                cr.set_source_rgb(0.24, 0.27, 0.32)
                cr.fill()
                # Trident spindle spline
                cr.set_line_width(2.0)
                cr.set_source_rgb(0.84, 0.87, 0.92)
                cr.move_to(cx, cy)
                cr.line_to(cx + r_hub * 0.46 * math.cos(sa), cy + r_hub * 0.46 * math.sin(sa))
                cr.stroke()

            # Subtle silkscreen label above reel
            cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(7.5)
            cr.set_source_rgba(0.96, 0.88, 0.70, 0.65)
            ext = cr.text_extents(tag)
            cr.move_to(cx - ext.width * 0.5, wy + 13.0)
            cr.show_text(tag)

        # Spring-loaded mechanical tension arms (Left & Right)
        for piv_x, piv_y, gx, gy in (
            (wx + 16.0, wy + wh - 66.0, guide_l_x, guide_l_y),
            (wx + ww - 16.0, wy + wh - 66.0, guide_r_x, guide_r_y),
        ):
            cr.set_line_width(3.0)
            cr.set_source_rgb(0.68, 0.72, 0.79)
            cr.move_to(piv_x, piv_y)
            cr.line_to(gx, gy)
            cr.stroke()
            cr.arc(piv_x, piv_y, 4.0, 0, 2 * math.pi)
            cr.set_source_rgb(0.42, 0.46, 0.52)
            cr.fill()
            # Stainless roller guide
            cr.arc(gx, gy, 5.2, 0, 2 * math.pi)
            cr.set_source_rgb(0.88, 0.91, 0.96)
            cr.fill()
            cr.arc(gx, gy, 2.0, 0, 2 * math.pi)
            cr.set_source_rgb(0.22, 0.25, 0.30)
            cr.fill()

    else:
        # ---- MODE B: Studio CrO2 Master Cassette Shell ----
        cw = min(ww * 0.76, 330.0)
        ch = min(wh * 0.76, 162.0)
        cx0 = wx + (ww - cw) * 0.5
        cy0 = wy + 12.0

        # Smoked transparent polycarbonate cassette body
        cr.rectangle(cx0, cy0, cw, ch)
        shell_g = cairo.LinearGradient(cx0, cy0, cx0, cy0 + ch)
        shell_g.add_color_stop_rgb(0.0, 0.23, 0.24, 0.28)
        shell_g.add_color_stop_rgb(1.0, 0.14, 0.15, 0.18)
        cr.set_source(shell_g)
        cr.fill_preserve()
        cr.set_line_width(2.0)
        cr.set_source_rgb(0.48, 0.52, 0.60)
        cr.stroke()

        # Champagne-Gold & Onyx Studio Cassette Label
        lx, ly, lw, lh = cx0 + 16.0, cy0 + 11.0, cw - 32.0, ch * 0.62
        cr.rectangle(lx, ly, lw, lh)
        lbl_g = cairo.LinearGradient(lx, ly, lx, ly + lh)
        lbl_g.add_color_stop_rgb(0.0, 0.88, 0.75, 0.46)
        lbl_g.add_color_stop_rgb(0.32, 0.78, 0.63, 0.34)
        lbl_g.add_color_stop_rgb(0.33, 0.16, 0.17, 0.21)
        lbl_g.add_color_stop_rgb(1.0, 0.12, 0.13, 0.16)
        cr.set_source(lbl_g)
        cr.fill()

        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.5)
        cr.set_source_rgb(0.14, 0.11, 0.06)
        cr.move_to(lx + 8.0, ly + 13.0)
        cr.show_text("dtDeck STUDIO CrO2  •  TYPE II 70µs")
        cr.move_to(lx + lw - 62.0, ly + 13.0)
        cr.show_text("SIDE A")

        # Center clear tape viewing window
        vwx, vwy, vww, vwh = lx + 18.0, ly + lh * 0.36, lw - 36.0, lh * 0.56
        cr.rectangle(vwx, vwy, vww, vwh)
        cr.set_source_rgb(0.18, 0.13, 0.08)
        cr.fill_preserve()
        cr.set_line_width(1.2)
        cr.set_source_rgb(0.55, 0.58, 0.65)
        cr.stroke()

        h_cy = vwy + vwh * 0.5
        h_l = cx0 + cw * 0.31
        h_r = cx0 + cw * 0.69
        r_hub_c = min(vwh * 0.38, 17.5)
        r_max_c = min(vwh * 0.92, 39.0)
        r_tl = math.sqrt((r_max_c ** 2) * (1.0 - p) + ((r_hub_c * 1.15) ** 2) * p)
        r_tr = math.sqrt(((r_hub_c * 1.15) ** 2) * (1.0 - p) + (r_max_c ** 2) * p)

        # Clip tape packs to cassette window
        cr.save()
        cr.rectangle(lx + 4, ly + lh * 0.34, lw - 8, lh * 0.62)
        cr.clip()
        for hcx, rt in ((h_l, r_tl), (h_r, r_tr)):
            cr.arc(hcx, h_cy, rt, 0, 2 * math.pi)
            cr.set_source_rgb(0.24, 0.13, 0.08)
            cr.fill()
        cr.restore()

        # 6-tooth splined cassette hubs
        for hcx, ang in ((h_l, reel_angle_l), (h_r, reel_angle_r)):
            cr.arc(hcx, h_cy, r_hub_c, 0, 2 * math.pi)
            cr.set_source_rgb(0.88, 0.90, 0.94)
            cr.fill()
            cr.arc(hcx, h_cy, r_hub_c * 0.62, 0, 2 * math.pi)
            cr.set_source_rgb(0.14, 0.15, 0.18)
            cr.fill()
            for t_i in range(6):
                ta = ang + t_i * (math.pi / 3.0)
                cr.set_line_width(2.2)
                cr.set_source_rgb(0.90, 0.92, 0.96)
                cr.move_to(hcx + r_hub_c * 0.38 * math.cos(ta), h_cy + r_hub_c * 0.38 * math.sin(ta))
                cr.line_to(hcx + r_hub_c * 0.66 * math.cos(ta), h_cy + r_hub_c * 0.66 * math.sin(ta))
                cr.stroke()

        # Cassette bottom trapezoid head shield
        bx0, bx1 = cx0 + cw * 0.16, cx0 + cw * 0.84
        cr.move_to(bx0, cy0 + ch)
        cr.line_to(bx0 + 12, cy0 + ch - 24)
        cr.line_to(bx1 - 12, cy0 + ch - 24)
        cr.line_to(bx1, cy0 + ch)
        cr.close_path()
        cr.set_source_rgb(0.26, 0.29, 0.35)
        cr.fill_preserve()
        cr.set_source_rgb(0.45, 0.49, 0.58)
        cr.stroke()
        for scx, scy in ((cx0 + 8, cy0 + 8), (cx0 + cw - 8, cy0 + 8), (cx0 + 8, cy0 + ch - 8), (cx0 + cw - 8, cy0 + ch - 8)):
            _draw_screw(cr, scx, scy, 2.8)

        head_y = wy + wh - 22.0
        cap_x, cap_y = wx + ww * 0.67, head_y - 3.0

    # ---- Lower Brushed Permalloy Head-Shield & Engaging Pinch Roller / Capstan ----
    hs_w, hs_h = 166.0, 28.0
    hs_x = wx + (ww - hs_w) * 0.5 - 10.0
    hs_y = wy + wh - hs_h - 5.0
    hs_grad = cairo.LinearGradient(hs_x, hs_y, hs_x, hs_y + hs_h)
    hs_grad.add_color_stop_rgb(0.0, 0.78, 0.82, 0.88)
    hs_grad.add_color_stop_rgb(0.45, 0.52, 0.56, 0.64)
    hs_grad.add_color_stop_rgb(1.0, 0.30, 0.34, 0.40)
    cr.rectangle(hs_x, hs_y, hs_w, hs_h)
    cr.set_source(hs_grad)
    cr.fill_preserve()
    cr.set_line_width(1.2)
    cr.set_source_rgb(0.14, 0.16, 0.20)
    cr.stroke()

    # Erase + Sync R/P Permalloy head tips peeking above head shield
    for hx_off, hcol in ((28.0, (0.20, 0.22, 0.26)), (76.0, (0.85, 0.76, 0.52)), (122.0, (0.78, 0.82, 0.88))):
        cr.rectangle(hs_x + hx_off, hs_y - 4.0, 14.0, 4.5)
        cr.set_source_rgb(*hcol)
        cr.fill()

    cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(7.4)
    cr.set_source_rgb(0.10, 0.12, 0.15)
    t1 = "4-TRACK SIMUL-SYNC"
    ext1 = cr.text_extents(t1)
    cr.move_to(hs_x + (hs_w - ext1.width) * 0.5, hs_y + 12.0)
    cr.show_text(t1)
    cr.set_font_size(6.6)
    cr.set_source_rgb(0.18, 0.20, 0.25)
    t2 = "PERMALLOY REC / REPRO"
    ext2 = cr.text_extents(t2)
    cr.move_to(hs_x + (hs_w - ext2.width) * 0.5, hs_y + 22.5)
    cr.show_text(t2)

    # Precision Capstan + Rubber Pinch Roller (engages upward in PLAY/REC!)
    pr_x = hs_x + hs_w + 22.0
    cap_sy = hs_y + 2.0
    pr_y = cap_sy + (10.5 if engaged else 15.5)
    # Capstan steel shaft
    cr.arc(pr_x, cap_sy, 3.2, 0, 2 * math.pi)
    cr.set_source_rgb(0.90, 0.93, 0.98)
    cr.fill()
    # Rubber pinch roller tire + brass bushing
    cr.arc(pr_x, pr_y, 8.2, 0, 2 * math.pi)
    cr.set_source_rgb(0.15, 0.16, 0.18)
    cr.fill()
    cr.arc(pr_x, pr_y, 3.6, 0, 2 * math.pi)
    cr.set_source_rgb(0.78, 0.66, 0.36)
    cr.fill()

    # Subtle diagonal smoked-acrylic glass reflection streak + recessed bevel
    cr.save()
    cr.rectangle(wx, wy, ww, wh)
    cr.clip()
    cr.move_to(wx + ww * 0.08, wy)
    cr.line_to(wx + ww * 0.22, wy)
    cr.line_to(wx + ww * 0.04, wy + wh)
    cr.line_to(wx - ww * 0.10, wy + wh)
    cr.close_path()
    cr.set_source_rgba(1.0, 1.0, 1.0, 0.04)
    cr.fill()
    cr.restore()

    # Well sunken 3D bezel
    cr.set_line_width(2.0)
    cr.set_source_rgb(0.05, 0.06, 0.08)
    cr.move_to(wx, wy + wh)
    cr.line_to(wx, wy)
    cr.line_to(wx + ww, wy)
    cr.stroke()
    cr.set_source_rgb(0.38, 0.42, 0.50)
    cr.move_to(wx, wy + wh)
    cr.line_to(wx + ww, wy + wh)
    cr.line_to(wx + ww, wy)
    cr.stroke()


def _vu_db_to_norm(db: float) -> float:
    """Authentic VU meter curve mapping (-24..+3 dB -> 0.0..1.0, with 0 dB at 0.74)."""
    if db <= -24.0:
        return 0.02
    if db < -10.0:
        return 0.02 + (db + 24.0) / 14.0 * 0.24
    if db < 0.0:
        return 0.26 + (db + 10.0) / 10.0 * 0.48
    return min(1.0, 0.74 + (db / 3.2) * 0.26)


def render_single_vu_meter(
    cr: cairo.Context,
    x: float,
    y: float,
    w: float,
    h: float,
    ch_label: str,
    needle_norm: float,
    peak_lit: bool,
):
    # Outer black studio bezel
    cr.rectangle(x, y, w, h)
    cr.set_source_rgb(0.07, 0.08, 0.10)
    cr.fill()

    mx, my, mw, mh = x + 5.0, y + 5.0, w - 10.0, h - 10.0
    glow = cairo.RadialGradient(mx + mw * 0.5, my + mh * 0.96, 6.0, mx + mw * 0.5, my + mh * 0.62, mw * 0.80)
    glow.add_color_stop_rgb(0.0, 1.00, 0.93, 0.70)
    glow.add_color_stop_rgb(0.62, 0.96, 0.82, 0.48)
    glow.add_color_stop_rgb(1.0, 0.82, 0.65, 0.33)
    cr.rectangle(mx, my, mw, mh)
    cr.set_source(glow)
    cr.fill()

    piv_x = mx + mw * 0.5
    piv_y = my + mh + 22.0
    arc_r = min(mw * 0.56, mh * 0.95)
    a0 = math.radians(-128.0)
    a1 = math.radians(-52.0)
    a_zero = a0 + 0.74 * (a1 - a0)

    # -20 .. 0 dB black scale arc
    cr.set_line_width(2.0)
    cr.set_source_rgb(0.14, 0.12, 0.09)
    cr.arc(piv_x, piv_y, arc_r, a0, a_zero)
    cr.stroke()

    # 0 .. +3 dB bold crimson overmodulation zone
    cr.set_line_width(4.2)
    cr.set_source_rgb(0.80, 0.13, 0.12)
    cr.arc(piv_x, piv_y, arc_r + 1.0, a_zero, a1)
    cr.stroke()

    vu_marks = [
        (0.06, "-20", False),
        (0.26, "-10", False),
        (0.40, "-7", False),
        (0.50, "-5", False),
        (0.60, "-3", False),
        (0.69, "-1", False),
        (0.74, "0", True),
        (0.83, "+1", True),
        (0.91, "+2", True),
        (1.00, "+3", True),
    ]
    cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(8.2)
    for frac, lbl, is_red in vu_marks:
        ang = a0 + frac * (a1 - a0)
        cr.set_source_rgb(0.78, 0.12, 0.11) if is_red else cr.set_source_rgb(0.15, 0.12, 0.09)
        cr.set_line_width(1.6 if lbl in ("-20", "-10", "-5", "0", "+3") else 1.1)
        cr.move_to(piv_x + (arc_r - 4.5) * math.cos(ang), piv_y + (arc_r - 4.5) * math.sin(ang))
        cr.line_to(piv_x + (arc_r + 5.5) * math.cos(ang), piv_y + (arc_r + 5.5) * math.sin(ang))
        cr.stroke()

        tx = piv_x + (arc_r + 14.0) * math.cos(ang)
        ty = piv_y + (arc_r + 14.0) * math.sin(ang)
        ext = cr.text_extents(lbl)
        cr.move_to(tx - ext.width * 0.5, ty + ext.height * 0.38)
        cr.show_text(lbl)

    # Lower 0..100% modulation legend + classic VU face badge
    cr.set_font_size(10.5)
    cr.set_source_rgba(0.20, 0.15, 0.09, 0.85)
    ext_vu = cr.text_extents("VU")
    cr.move_to(piv_x - ext_vu.width * 0.5, my + mh * 0.72)
    cr.show_text("VU")

    cr.set_font_size(8.2)
    cr.set_source_rgb(0.24, 0.18, 0.10)
    cr.move_to(mx + 7.0, my + 13.5)
    cr.show_text(ch_label)

    # Crimson Jewel PEAK Clip LED in upper-right corner
    lx, ly = mx + mw - 14.0, my + 11.5
    if peak_lit:
        halo = cairo.RadialGradient(lx, ly, 1.0, lx, ly, 9.0)
        halo.add_color_stop_rgba(0.0, 1.0, 0.25, 0.25, 0.95)
        halo.add_color_stop_rgba(1.0, 1.0, 0.08, 0.08, 0.0)
        cr.arc(lx, ly, 9.0, 0, 2 * math.pi)
        cr.set_source(halo)
        cr.fill()
        cr.arc(lx, ly, 4.0, 0, 2 * math.pi)
        cr.set_source_rgb(1.0, 0.22, 0.22)
        cr.fill()
    else:
        cr.arc(lx, ly, 4.0, 0, 2 * math.pi)
        cr.set_source_rgb(0.32, 0.10, 0.10)
        cr.fill()
    cr.set_font_size(7.0)
    cr.set_source_rgb(0.68, 0.12, 0.12) if peak_lit else cr.set_source_rgb(0.30, 0.22, 0.14)
    cr.move_to(lx - 29.0, ly + 2.8)
    cr.show_text("PEAK")

    # Ballistic Needle + Shadow (clipped to meter face)
    cr.save()
    cr.rectangle(mx, my, mw, mh)
    cr.clip()
    n_ang = a0 + max(0.0, min(1.02, needle_norm)) * (a1 - a0)
    cr.set_line_width(2.0)
    cr.set_source_rgba(0.10, 0.07, 0.04, 0.35)
    cr.move_to(piv_x + 2.0, piv_y + 2.0)
    cr.line_to(piv_x + 2.0 + (arc_r + 8.0) * math.cos(n_ang), piv_y + 2.0 + (arc_r + 8.0) * math.sin(n_ang))
    cr.stroke()

    cr.set_line_width(1.9)
    cr.set_source_rgb(0.14, 0.12, 0.11)
    cr.move_to(piv_x, piv_y)
    cr.line_to(piv_x + (arc_r + 8.0) * math.cos(n_ang), piv_y + (arc_r + 8.0) * math.sin(n_ang))
    cr.stroke()
    # Red pointer tip
    cr.set_source_rgb(0.84, 0.12, 0.12)
    cr.move_to(piv_x + (arc_r - 8.0) * math.cos(n_ang), piv_y + (arc_r - 8.0) * math.sin(n_ang))
    cr.line_to(piv_x + (arc_r + 8.0) * math.cos(n_ang), piv_y + (arc_r + 8.0) * math.sin(n_ang))
    cr.stroke()

    cr.arc(piv_x, my + mh + 3.5, 11.0, 0, 2 * math.pi)
    cr.set_source_rgb(0.15, 0.16, 0.19)
    cr.fill()
    cr.restore()

    # Sunken meter frame bevel
    cr.set_line_width(1.5)
    cr.set_source_rgb(0.03, 0.03, 0.04)
    cr.move_to(x, y + h)
    cr.line_to(x, y)
    cr.line_to(x + w, y)
    cr.stroke()
    cr.set_source_rgb(0.36, 0.40, 0.48)
    cr.move_to(x, y + h)
    cr.line_to(x + w, y + h)
    cr.line_to(x + w, y)
    cr.stroke()


def render_drum_and_vfd_counter(
    cr: cairo.Context,
    W: float,
    H: float,
    drum_val: float,
    cur_sec: float,
    tot_sec: float,
    mode: str,
    mem_drum: int,
    loop_state: int,
    varispeed_pct: float,
):
    """Render 4-digit rolling mechanical odometer drum (0000..9999) + glowing cyan VFD time strip."""
    cr.rectangle(0, 0, W, H)
    cr.set_source_rgb(0.11, 0.13, 0.16)
    cr.fill()

    # Left: 4-Digit Mechanical Rolling Drum Counter
    dx, dy, dw, dh = 6.0, 6.0, 122.0, H - 12.0
    cr.rectangle(dx, dy, dw, dh)
    cr.set_source_rgb(0.04, 0.05, 0.06)
    cr.fill()

    v = drum_val % 10000.0
    if v < 0:
        v += 10000.0
    int_v = int(math.floor(v))
    frac = v - int_v

    digits = [
        (int_v // 1000) % 10,
        (int_v // 100) % 10,
        (int_v // 10) % 10,
        int_v % 10,
    ]
    # Cascade roll when lower wheels pass 9 -> 0
    rolls = [0.0, 0.0, 0.0, frac]
    if digits[3] == 9:
        rolls[2] = frac
        if digits[2] == 9:
            rolls[1] = frac
            if digits[1] == 9:
                rolls[0] = frac

    ww = (dw - 14.0) / 4.0
    wh = dh - 8.0
    wy = dy + 4.0
    cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(15.5)

    for i in range(4):
        wx = dx + 5.0 + i * (ww + 1.3)
        cr.save()
        cr.rectangle(wx, wy, ww, wh)
        cr.clip()

        # Cylindrical 3D plastic number wheel shading
        wg = cairo.LinearGradient(wx, wy, wx, wy + wh)
        wg.add_color_stop_rgb(0.0, 0.06, 0.07, 0.08)
        wg.add_color_stop_rgb(0.28, 0.20, 0.22, 0.25)
        wg.add_color_stop_rgb(0.50, 0.26, 0.28, 0.32)
        wg.add_color_stop_rgb(0.72, 0.18, 0.20, 0.23)
        wg.add_color_stop_rgb(1.0, 0.05, 0.06, 0.07)
        cr.rectangle(wx, wy, ww, wh)
        cr.set_source(wg)
        cr.fill()

        d_cur = digits[i]
        d_nxt = (d_cur + 1) % 10
        r_off = rolls[i] * wh

        cr.set_source_rgb(0.95, 0.94, 0.88) if i < 3 else cr.set_source_rgb(1.0, 0.82, 0.42)
        for d_num, y_shift in ((d_cur, -r_off), (d_nxt, wh - r_off)):
            s = str(d_num)
            ext = cr.text_extents(s)
            cr.move_to(wx + (ww - ext.width) * 0.5 - ext.x_bearing, wy + wh * 0.5 + ext.height * 0.5 + y_shift - 1.0)
            cr.show_text(s)
        cr.restore()

    # Right: Glowing Cyan Vacuum Fluorescent Display (VFD)
    vx = dx + dw + 8.0
    vw = max(80.0, W - vx - 6.0)
    vy, vh = 6.0, H - 12.0
    cr.rectangle(vx, vy, vw, vh)
    cr.set_source_rgb(0.03, 0.08, 0.08)
    cr.fill()

    # Format MM:SS.d
    mm = int(cur_sec) // 60
    ss = int(cur_sec) % 60
    ds = int((cur_sec - math.floor(cur_sec)) * 10.0)
    t_mm = int(tot_sec) // 60
    t_ss = int(tot_sec) % 60
    time_str = f"{mm:02d}:{ss:02d}.{ds:1d}"

    cr.set_font_size(17.5)
    cr.set_source_rgb(0.32, 0.98, 0.86)
    cr.move_to(vx + 10.0, vy + 24.0)
    cr.show_text(time_str)

    cr.set_font_size(8.5)
    cr.set_source_rgb(0.24, 0.75, 0.68)
    cr.move_to(vx + 106.0, vy + 16.0)
    cr.show_text(f"/ {t_mm:02d}:{t_ss:02d}")

    # Mode Annunciator Pill
    mode_colors = {
        "PLAY": (0.28, 0.98, 0.62),
        "REC": (1.00, 0.30, 0.32),
        "FF": (1.00, 0.78, 0.28),
        "REW": (1.00, 0.78, 0.28),
        "RTZ": (0.42, 0.88, 1.00),
        "PAUSE": (1.00, 0.78, 0.28),
        "STOP": (0.46, 0.68, 0.66),
    }
    mc = mode_colors.get(mode, (0.46, 0.68, 0.66))
    badge_txt = "SIMUL-REC" if mode == "REC" else mode
    ext_m = cr.text_extents(badge_txt)
    bx = vx + vw - ext_m.width - 16.0
    cr.set_source_rgba(mc[0], mc[1], mc[2], 0.20)
    cr.rectangle(bx - 4.0, vy + 5.0, ext_m.width + 8.0, 14.0)
    cr.fill()
    cr.set_source_rgb(*mc)
    cr.move_to(bx, vy + 15.0)
    cr.show_text(badge_txt)

    # Bottom VFD telemetry line: MEM + LOOP + VARISPEED
    cr.set_font_size(7.8)
    cr.set_source_rgb(0.36, 0.86, 0.78)
    loop_txt = {0: "LOOP OFF", 1: "LOOP [A..]", 2: "LOOP [A-B]"}.get(loop_state, "LOOP OFF")
    sub_txt = f"MEM {mem_drum:04d}  •  {loop_txt}  •  PITCH {varispeed_pct:+.1f}%"
    cr.move_to(vx + 10.0, vy + vh - 6.5)
    cr.show_text(sub_txt)


