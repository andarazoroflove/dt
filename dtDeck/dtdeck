    def _set_transport(self, mode: str):
        self.engine.set_mode(mode)
        self._sync_transport_buttons()
        self._sync_strip_buttons()
        if mode == "REC":
            armed = [f"TRK {t.index+1}" for t in self.engine.tracks if t.rec_arm]
            self._set_status(f"● SIMUL-SYNC RECORDING ON {', '.join(armed)} -> ~/Music/dtDeck/")
        elif mode == "PLAY":
            self._set_status("▶ PLAYING 4-TRACK MASTER BUS")
        elif mode == "STOP":
            self._refresh_library_list()
            self._set_status("■ TRANSPORT STOPPED")
        elif mode in ("FF", "REW"):
            self._set_status(f"HIGH-SPEED TAPE WIND ({mode} 6x)")
        elif mode == "PAUSE":
            self._set_status("⏸ TRANSPORT PAUSED")

    def _sync_transport_buttons(self):
        m = self.engine.mode
        self._toggle_cls(self.btn_play, "piano-play-on", m == "PLAY")
        self._toggle_cls(self.btn_rew, "piano-wind-on", m in ("REW", "RTZ"))
        self._toggle_cls(self.btn_ff, "piano-wind-on", m == "FF")
        self._toggle_cls(self.btn_rec, "piano-rec-on", m == "REC")
        self._toggle_cls(self.btn_pause, "piano-wind-on", m == "PAUSE")
        self._toggle_cls(self.btn_rtz, "sw-amber", m == "RTZ")
        self._toggle_cls(self.btn_loop, "sw-active", self.engine.loop_state > 0)
        if self.engine.loop_state == 1:
            self.btn_loop.set_label("LOOP [A..]")
        elif self.engine.loop_state == 2:
            self.btn_loop.set_label("LOOP [A-B]")
        else:
            self.btn_loop.set_label("A-B LOOP")

    def _on_loop_clicked(self, _b):
        if self.engine.loop_state == 0:
            self.engine.loop_a = self.engine.playhead
            self.engine.loop_state = 1
            self._set_status(f"LOOP POINT [A] MARKED AT {self.engine.loop_a / SAMPLE_RATE:.1f}s — CLICK AGAIN TO SET [B]")
        elif self.engine.loop_state == 1:
            if self.engine.playhead > self.engine.loop_a + SAMPLE_RATE * 0.25:
                self.engine.loop_b = self.engine.playhead
                self.engine.loop_state = 2
                self._set_status(
                    f"A-B REPEAT ACTIVE ({self.engine.loop_a / SAMPLE_RATE:.1f}s .. {self.engine.loop_b / SAMPLE_RATE:.1f}s)"
                )
            else:
                self.engine.loop_state = 0
                self._set_status("A-B LOOP CLEARED")
        else:
            self.engine.loop_state = 0
            self._set_status("A-B LOOP CLEARED")
        self._sync_transport_buttons()

