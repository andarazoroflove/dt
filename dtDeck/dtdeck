    def _load_file_into_track(self, idx: int, path: Path):
        if not path.is_file():
            self._set_status(f"FILE NOT FOUND: {path}")
            return
        self._set_status(f"LOADING {path.name} -> TRK {idx+1}...")
        arr = load_audio_to_mono_f32(path)
        if len(arr) == 0:
            self._set_status(f"UNABLE TO DECODE AUDIO: {path.name}")
            return
        with self.engine._lock:
            trk = self.engine.tracks[idx]
            trk.samples = arr
            trk.name = path.stem[:14].upper()
            trk.path = str(path)
        self._sync_strip_buttons()
        self._set_status(f"LOADED TRK {idx+1}: {path.name} ({len(arr)/SAMPLE_RATE:.1f}s)")

    def _choose_file_for_track(self, idx: int):
        dlg = Gtk.FileChooserDialog(
            title=f"Load Audio Stem onto Track {idx+1}",
            parent=self,
            action=Gtk.FileChooserAction.OPEN,
        )
        dlg.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OPEN, Gtk.ResponseType.OK)
        start_dir = RADIO_DIR if RADIO_DIR.is_dir() else (MUSIC_DIR if MUSIC_DIR.is_dir() else HOME)
        dlg.set_current_folder(str(start_dir))

        flt = Gtk.FileFilter()
        flt.set_name("Audio Files (WAV, MP3, FLAC, OGG, M4A)")
        for pat in ("*.wav", "*.WAV", "*.mp3", "*.MP3", "*.flac", "*.ogg", "*.m4a", "*.opus"):
            flt.add_pattern(pat)
        dlg.add_filter(flt)

        if dlg.run() == Gtk.ResponseType.OK:
            fn = dlg.get_filename()
            if fn:
                self._load_file_into_track(idx, Path(fn))
        dlg.destroy()

