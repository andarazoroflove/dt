        self.eq_bank.set_gains(vals, notify=True)
        self._set_status(f"10-BAND EQ PRESET -> {pname}")

    def _on_varispeed_knob(self, v: float):
        self.engine.varispeed_pct = (v - 0.5) * 40.0
        self._update_spec_badge()
        self.counter_area.queue_draw()

    def _on_master_knob(self, v: float):
        self.engine.master_gain = v
        self.engine.apply_dsp()

    def _set_bias_mode(self, mode: str):
        self.engine.bias_mode = mode
        self.engine.apply_dsp()
        for bm, bb in self.bias_btns.items():
            self._toggle_cls(bb, "sw-active", bm == mode)
        self._update_spec_badge()
        self._set_status(f"TAPE BIAS / NR -> {mode}")

    def _update_spec_badge(self):
        self.spec_lbl.set_text(
            f"44.1 kHz • BIAS: {self.engine.bias_mode} • VARI: {self.engine.varispeed_pct:+.1f}%"
        )

    # ---- Aircheck & Library Browser ----
    def _set_browser_filter(self, flt_key: str):
        self.browser_filter = flt_key
        for k, fb in self.flt_btns.items():
            self._toggle_cls(fb, "sw-active", k == flt_key)
        self._refresh_library_list()

    def _refresh_library_list(self):
        self.lib_store.clear()
        DECK_DIR.mkdir(parents=True, exist_ok=True)
        RADIO_DIR.mkdir(parents=True, exist_ok=True)

        roots: list[tuple[str, Path]] = []
        if self.browser_filter in ("ALL", "dtRadio"):
            roots.append(("RAD", RADIO_DIR))
        if self.browser_filter in ("ALL", "dtDeck"):
            roots.append(("DCK", DECK_DIR))
        if self.browser_filter in ("ALL", "Music"):
            roots.append(("MUS", MUSIC_DIR))

        seen: set[Path] = set()
        items: list[tuple[float, str, str, str]] = []
        for tag, rdir in roots:
            if not rdir.is_dir():
                continue
            try:
                entries = list(rdir.iterdir()) if tag == "MUS" else list(rdir.rglob("*"))
            except Exception:
                continue
            for p in entries:
                if p.is_file() and p.suffix.lower() in AUDIO_EXTS:
                    rp = p.resolve()
                    if rp in seen:
                        continue
                    seen.add(rp)
                    try:
                        mt = p.stat().st_mtime
                    except Exception:
                        mt = 0.0
                    items.append((mt, p.name, tag, str(rp)))

        items.sort(reverse=True)
        for _mt, nm, tag, full in items[:120]:
            self.lib_store.append([nm, f"[{tag}]", full])

        if len(self.lib_store) == 0:
            for label, p, _arr in ensure_demo_4track_stems():
                self.lib_store.append([p.name, "[DEMO]", str(p)])

    def _on_lib_row_activated(self, tv, path, _col):
        it = self.lib_store.get_iter(path)
        if it:
            fp = self.lib_store.get_value(it, 2)
            # Load onto first empty track or Track 1
            empty = [t.index for t in self.engine.tracks if len(t.samples) == 0]
            target = empty[0] if empty else 0
            self._load_file_into_track(target, Path(fp))

    def _load_selected_to_track(self, track_idx: int):
        sel = self.lib_view.get_selection()
        model, it = sel.get_selected()
        if it is not None:
            fp = model.get_value(it, 2)
            self._load_file_into_track(track_idx, Path(fp))
        else:
            self._set_status("SELECT AN AIRCHECK OR WAV FILE IN THE BROWSER FIRST")

    def _sync_all_controls(self):
        self._set_reel_mode(self.reel_mode)
        self._set_bias_mode(self.engine.bias_mode)
        self._set_browser_filter(self.browser_filter)
        self._sync_transport_buttons()
        self._sync_strip_buttons()
        self._update_spec_badge()

    def _set_status(self, txt: str):
        self.status_lbl.set_text(txt)

    def _on_key_press(self, _w, ev):
        if ev.keyval == Gdk.KEY_space:
            self._set_transport("STOP" if self.engine.mode in ("PLAY", "REC") else "PLAY")
            return True
        return False

    # ---- State Persistence ----
    def _load_state(self) -> bool:
        if not STATE_FILE.is_file():
            return False
        try:
            st = json.loads(STATE_FILE.read_text(encoding="utf-8"))
            self.reel_mode = st.get("reel_mode", "nab")
            self.engine.bias_mode = st.get("bias_mode", "WARM")
            eq = st.get("eq_gains", [0.0] * 10)
            if isinstance(eq, list) and len(eq) == 10:
                self.eq_bank.set_gains([float(x) for x in eq], notify=True)
            vari_v = float(st.get("varispeed_knob", 0.50))
            self.knob_vari.set_value(vari_v, notify=True)
            mast_v = float(st.get("master_gain", 0.82))
            self.knob_master.set_value(mast_v, notify=True)

            loaded_any = False
            for idx, td in enumerate(st.get("tracks", [])[:4]):
                p_str = td.get("path", "")
                trk = self.engine.tracks[idx]
                trk.fader = float(td.get("fader", trk.fader))
                trk.pan = float(td.get("pan", trk.pan))
                trk.muted = bool(td.get("muted", False))
                self.strip_widgets[idx]["fader"].set_value(trk.fader, notify=False)
                self.strip_widgets[idx]["pan"].set_value(trk.pan, notify=False)
                if p_str and Path(p_str).is_file():
                    arr = load_audio_to_mono_f32(Path(p_str))
                    if len(arr) > 0:
                        trk.samples = arr
                        trk.path = p_str
                        trk.name = td.get("name", Path(p_str).stem[:12].upper())
                        loaded_any = True
            return loaded_any
        except Exception:
            return False

    def _save_state(self):
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            st = {
                "reel_mode": self.reel_mode,
                "bias_mode": self.engine.bias_mode,
                "eq_gains": self.engine.eq_gains,
                "varispeed_knob": self.knob_vari.value,
                "master_gain": self.knob_master.value,
                "tracks": [
                    {
                        "name": t.name,
                        "path": t.path,
                        "fader": t.fader,
                        "pan": t.pan,
                        "muted": t.muted,
                    }
                    for t in self.engine.tracks
                ],
            }
            STATE_FILE.write_text(json.dumps(st, indent=2), encoding="utf-8")
        except Exception:
            pass

    # ---- GUI Self-Test Mode (when X11 Display is present) ----
    def _run_gui_self_test(self, step: int):
        if step == 0:
            self._load_demo_4track(auto_play=True)
            self._apply_eq_preset("WARM TAPE")
            self.knob_vari.set_value(0.56, notify=True)
            GLib.timeout_add(450, self._run_gui_self_test, 1)
        elif step == 1:
            self._set_reel_mode("cassette")
            self._set_bias_mode("DOLBY-B")
            out_test = CACHE_DIR / "selftest_bounce.wav"
            ok, _msg, nframes = bounce_tracks_numpy(
                self.engine.tracks, out_test, varispeed_pct=4.0, bias_mode="WARM"
            )
            assert ok and nframes > SAMPLE_RATE, "4-track bounce failed"
            out_test.unlink(missing_ok=True)
            GLib.timeout_add(350, self._run_gui_self_test, 2)
        else:
            self._set_reel_mode("nab")
            self._set_transport("STOP")
            print("DTDECK_SELF_TEST_OK")
            sys.stdout.flush()
            self.destroy()
        return False

    def _on_destroy(self, _w):
        if not self._self_test:
            self._save_state()
        self.engine.shutdown()
        Gtk.main_quit()


# ---------------------------------------------------------------------------
# Headless / Sandbox Self-Test Runner (--self-test without X11 DISPLAY)
# ---------------------------------------------------------------------------
def run_headless_self_test() -> int:
    vu_events: list[tuple[float, float, float, float]] = []

    def on_vu(rl, rr, pl, pr):
        vu_events.append((rl, rr, pl, pr))

    eng = TapeDeckEngine(on_vu, None, headless=True)
    try:
        # 1. Synthesize 4-track demo stems & load into engine
        stems = ensure_demo_4track_stems()
        assert len(stems) == 4
        for idx, (lbl, path, arr) in enumerate(stems):
            eng.tracks[idx].name = lbl
            eng.tracks[idx].path = str(path)
            eng.tracks[idx].samples = arr.copy()

        # 2. Exercise GStreamer 10-band EQ + Tape Bias + Varispeed + Level telemetry
        eng.eq_gains = list(EQ_PRESETS["WARM TAPE"])
        eng.varispeed_pct = 5.0
        eng.bias_mode = "WARM"
        eng.apply_dsp()
        eng.set_mode("PLAY")

        t0 = time.monotonic()
        while time.monotonic() - t0 < 0.55:
            eng.poll_bus_sync()
            time.sleep(0.03)

        assert eng.playhead > SAMPLE_RATE * 0.2, "Playhead did not advance"
        assert len(vu_events) > 0, "GStreamer level element did not post RMS/peak messages"

        # 3. Verify 4-track numpy bounce math & stereo 16-bit WAV output
        bounce_out = CACHE_DIR / "selftest_headless_master.wav"
        ok, _msg, nframes = bounce_tracks_numpy(
            eng.tracks, bounce_out, varispeed_pct=5.0, bias_mode="WARM", master_gain=0.85
        )
        assert ok and nframes > SAMPLE_RATE * 10, "Numpy 4-track bounce failed"
        with wave.open(str(bounce_out), "rb") as wf:
            assert wf.getnchannels() == 2 and wf.getsampwidth() == 2 and wf.getframerate() == SAMPLE_RATE
        bounce_out.unlink(missing_ok=True)

        # 4. Verify Cairo Tape Well (both 7" NAB & Studio Cassette), Dual VU Meters & Mechanical Drum Counter
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 520, 240)
        cr = cairo.Context(surf)
        render_tape_well(cr, 520.0, 240.0, "nab", 0.35, 0.8, 1.4, "PLAY", 0.32)
        render_tape_well(cr, 520.0, 240.0, "cassette", 0.65, 1.8, 2.4, "REC", 0.25)
        render_single_vu_meter(cr, 0.0, 0.0, 250.0, 150.0, "CH L", 0.78, True)
        render_single_vu_meter(cr, 260.0, 0.0, 250.0, 150.0, "CH R", 0.62, False)
        render_drum_and_vfd_counter(cr, 420.0, 56.0, 128.6, 32.15, 16.0, "PLAY", 42, 2, 5.0)
    finally:
        eng.shutdown()

    print("DTDECK_SELF_TEST_OK")
    sys.stdout.flush()
    return 0


def main():
    args = [a for a in sys.argv[1:] if a != "--self-test"]
    self_test = "--self-test" in sys.argv[1:]
    init_file = args[0] if args else None

    has_display = Gtk.init_check(sys.argv)[0]
    if self_test and not has_display:
        sys.exit(run_headless_self_test())

    if not has_display:
        sys.stderr.write("dtDeck: cannot open X11 display (set DISPLAY or run --self-test).\n")
        sys.exit(1)

    win = DtDeckWindow(initial_file=init_file, self_test=self_test)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
