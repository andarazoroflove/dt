class RotaryKnob(Gtk.DrawingArea):
    def __init__(self, label: str, init_val: float, default_val: float, on_change, fmt_fn=None, compact: bool = False):
        super().__init__()
        self.label = label
        self.value = max(0.0, min(1.0, init_val))
        self.default_val = default_val
        self.on_change = on_change
        self.fmt_fn = fmt_fn
        self.compact = compact
        self._drag_y = None
        self._drag_start_val = self.value

        if compact:
            self.set_size_request(68, 60)
        else:
            self.set_size_request(86, 78)

        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.SCROLL_MASK
        )
        self.connect("draw", self._on_draw)
        self.connect("button-press-event", self._on_press)
        self.connect("button-release-event", self._on_release)
        self.connect("motion-notify-event", self._on_motion)
        self.connect("scroll-event", self._on_scroll)

    def set_value(self, v: float, notify: bool = False):
        self.value = max(0.0, min(1.0, v))
        self.queue_draw()
        if notify and self.on_change:
            self.on_change(self.value)

    def _on_press(self, _w, ev):
        if ev.type == Gdk.EventType._2BUTTON_PRESS:
            self.set_value(self.default_val, notify=True)
            return True
        if ev.button == 1:
            self._drag_y = ev.y
            self._drag_start_val = self.value
            return True
        return False

    def _on_release(self, _w, _ev):
        self._drag_y = None
        return True

    def _on_motion(self, _w, ev):
        if self._drag_y is not None:
            dy = self._drag_y - ev.y
            self.set_value(self._drag_start_val + dy / 100.0, notify=True)
            return True
        return False

    def _on_scroll(self, _w, ev):
        step = 0.04
        if ev.direction == Gdk.ScrollDirection.UP:
            self.set_value(self.value + step, notify=True)
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            self.set_value(self.value - step, notify=True)
        elif ev.direction == Gdk.ScrollDirection.SMOOTH:
            _, _dx, dy = ev.get_scroll_deltas()
            self.set_value(self.value - dy * 0.03, notify=True)
        return True

    def _on_draw(self, w, cr: cairo.Context):
        alloc = w.get_allocation()
        cx = alloc.width * 0.5
        cy = 23.0 if self.compact else 29.0
        r = 14.5 if self.compact else 19.5

        a_start = math.radians(135.0)
        a_span = math.radians(270.0)
        for i in range(11):
            frac = i / 10.0
            ang = a_start + frac * a_span
            r0 = r + 2.8
            r1 = r + (5.8 if i in (0, 5, 10) else 4.2)
            cr.set_line_width(1.4 if i in (0, 5, 10) else 0.9)
            if abs(self.default_val - 0.5) < 0.02:
                lit = (min(0.5, self.value) - 0.01 <= frac <= max(0.5, self.value) + 0.01)
            else:
                lit = frac <= self.value + 0.001
            cr.set_source_rgb(0.36, 0.95, 0.82) if lit else cr.set_source_rgb(0.58, 0.63, 0.72)
            cr.move_to(cx + r0 * math.cos(ang), cy + r0 * math.sin(ang))
            cr.line_to(cx + r1 * math.cos(ang), cy + r1 * math.sin(ang))
            cr.stroke()

        cr.arc(cx + 1.2, cy + 1.8, r + 0.8, 0, 2 * math.pi)
        cr.set_source_rgba(0.04, 0.05, 0.07, 0.75)
        cr.fill()

        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.set_source_rgb(0.15, 0.17, 0.21)
        cr.fill()

        pat = cairo.LinearGradient(cx - r, cy - r, cx + r, cy + r)
        pat.add_color_stop_rgb(0.0, 0.84, 0.87, 0.93)
        pat.add_color_stop_rgb(0.5, 0.54, 0.58, 0.66)
        pat.add_color_stop_rgb(1.0, 0.30, 0.34, 0.41)
        cr.arc(cx, cy, r - 2.6, 0, 2 * math.pi)
        cr.set_source(pat)
        cr.fill()

        val_ang = a_start + self.value * a_span
        cr.set_line_width(2.2)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_source_rgb(1.0, 0.48, 0.16)
        cr.move_to(cx + 3.0 * math.cos(val_ang), cy + 3.0 * math.sin(val_ang))
        cr.line_to(cx + (r - 3.8) * math.cos(val_ang), cy + (r - 3.8) * math.sin(val_ang))
        cr.stroke()

        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        sub_txt = self.fmt_fn(self.value) if self.fmt_fn else ""
        if self.compact:
            lbl = f"{self.label} {sub_txt}".strip()
            cr.set_font_size(7.6)
            ext = cr.text_extents(lbl)
            cr.set_source_rgb(0.84, 0.90, 0.96)
            cr.move_to(cx - ext.width * 0.5, 53.0)
            cr.show_text(lbl)
        else:
            cr.set_font_size(8.4)
            ext = cr.text_extents(self.label)
            cr.set_source_rgb(0.86, 0.90, 0.96)
            cr.move_to(cx - ext.width * 0.5, 62.0)
            cr.show_text(self.label)
            if sub_txt:
                cr.set_font_size(7.8)
                ext2 = cr.text_extents(sub_txt)
                cr.set_source_rgb(0.45, 0.94, 0.84)
                cr.move_to(cx - ext2.width * 0.5, 73.5)
                cr.show_text(sub_txt)
        return False


class ChannelFaderMeter(Gtk.DrawingArea):
    """Illuminated Vertical Studio Fader + 12-Segment Channel Bar Meter."""

    def __init__(self, init_val: float, on_change):
        super().__init__()
        self.value = max(0.0, min(1.0, init_val))
        self.default_val = 0.78
        self.meter_db = -60.0
        self.rec_armed = False
        self.on_change = on_change
        self._dragging = False

        self.set_size_request(88, 128)
        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.SCROLL_MASK
        )
        self.connect("draw", self._on_draw)
        self.connect("button-press-event", self._on_press)
        self.connect("button-release-event", self._on_release)
        self.connect("motion-notify-event", self._on_motion)
        self.connect("scroll-event", self._on_scroll)

    def set_value(self, v: float, notify: bool = False):
        self.value = max(0.0, min(1.0, v))
        self.queue_draw()
        if notify and self.on_change:
            self.on_change(self.value)

    def _y_to_val(self, y: float, h: float) -> float:
        top, bot = 12.0, h - 12.0
        return max(0.0, min(1.0, 1.0 - (y - top) / max(1.0, bot - top)))

    def _on_press(self, w, ev):
        if ev.type == Gdk.EventType._2BUTTON_PRESS:
            self.set_value(self.default_val, notify=True)
            return True
        if ev.button == 1:
            self._dragging = True
            self.set_value(self._y_to_val(ev.y, w.get_allocation().height), notify=True)
            return True
        return False

    def _on_release(self, _w, _ev):
        self._dragging = False
        return True

    def _on_motion(self, w, ev):
        if self._dragging:
            self.set_value(self._y_to_val(ev.y, w.get_allocation().height), notify=True)
            return True
        return False

    def _on_scroll(self, _w, ev):
        step = 0.04
        if ev.direction == Gdk.ScrollDirection.UP:
            self.set_value(self.value + step, notify=True)
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            self.set_value(self.value - step, notify=True)
        elif ev.direction == Gdk.ScrollDirection.SMOOTH:
            _, _dx, dy = ev.get_scroll_deltas()
            self.set_value(self.value - dy * 0.03, notify=True)
        return True

    def _on_draw(self, w, cr: cairo.Context):
        alloc = w.get_allocation()
        W, H = float(alloc.width), float(alloc.height)
        top, bot = 11.0, H - 11.0
        span = max(20.0, bot - top)

        fx = W * 0.34
        # Fader dB tick marks (-inf, -20, -10, -5, 0, +3)
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(6.8)
        for v_mark, lbl in ((1.0, "+3"), (0.78, " 0"), (0.58, "-5"), (0.38, "-10"), (0.18, "-20"), (0.0, " ∞")):
            ym = bot - v_mark * span
            cr.set_line_width(1.4 if v_mark == 0.78 else 0.9)
            cr.set_source_rgb(0.95, 0.78, 0.42) if v_mark == 0.78 else cr.set_source_rgb(0.62, 0.68, 0.78)
            cr.move_to(fx - 16.0, ym)
            cr.line_to(fx - 8.0, ym)
            cr.stroke()
            cr.move_to(2.0, ym + 2.5)
            cr.show_text(lbl)

        # Recessed dark fader slot
        cr.rectangle(fx - 3.0, top - 2.0, 6.0, span + 4.0)
        cr.set_source_rgb(0.06, 0.07, 0.09)
        cr.fill()

        # Illuminated track glow below fader cap
        cap_y = bot - self.value * span
        if self.value > 0.01:
            cr.rectangle(fx - 1.5, cap_y, 3.0, bot - cap_y)
            cr.set_source_rgb(1.0, 0.32, 0.32) if self.rec_armed else cr.set_source_rgb(0.32, 0.94, 0.80)
            cr.fill()

        # Sculpted TASCAM-style silver/charcoal fader cap
        cw, ch = 22.0, 15.0
        cr.rectangle(fx - cw * 0.5 + 1.5, cap_y - ch * 0.5 + 2.0, cw, ch)
        cr.set_source_rgba(0.03, 0.04, 0.05, 0.8)
        cr.fill()

        cg = cairo.LinearGradient(0, cap_y - ch * 0.5, 0, cap_y + ch * 0.5)
        cg.add_color_stop_rgb(0.0, 0.88, 0.91, 0.96)
        cg.add_color_stop_rgb(0.45, 0.52, 0.57, 0.65)
        cg.add_color_stop_rgb(0.55, 0.34, 0.38, 0.45)
        cg.add_color_stop_rgb(1.0, 0.72, 0.76, 0.84)
        cr.rectangle(fx - cw * 0.5, cap_y - ch * 0.5, cw, ch)
        cr.set_source(cg)
        cr.fill_preserve()
        cr.set_line_width(1.0)
        cr.set_source_rgb(0.14, 0.16, 0.20)
        cr.stroke()

        # Center hairline on fader cap
        cr.set_line_width(2.0)
        cr.set_source_rgb(1.0, 0.36, 0.24) if self.rec_armed else cr.set_source_rgb(1.0, 0.78, 0.28)
        cr.move_to(fx - cw * 0.5 + 2.0, cap_y)
        cr.line_to(fx + cw * 0.5 - 2.0, cap_y)
        cr.stroke()

        # Right side: 12-Segment Vertical LED Bar Meter
        mx = W - 20.0
        mw = 12.0
        cr.rectangle(mx - 2.0, top - 2.0, mw + 4.0, span + 4.0)
        cr.set_source_rgb(0.07, 0.08, 0.10)
        cr.fill()

        n_segs = 12
        seg_h = (span - (n_segs - 1) * 2.0) / n_segs
        norm_lvl = max(0.0, min(1.0, (self.meter_db + 48.0) / 51.0))
        lit_count = int(round(norm_lvl * n_segs))

        for s in range(n_segs):
            # s=0 bottom .. s=11 top
            sy = bot - (s + 1) * seg_h - s * 2.0
            is_lit = s < lit_count
            if s >= 10:
                col_on, col_off = (1.0, 0.22, 0.22), (0.28, 0.10, 0.10)
            elif s >= 7:
                col_on, col_off = (1.0, 0.78, 0.22), (0.28, 0.22, 0.09)
            else:
                col_on, col_off = (0.25, 0.95, 0.52), (0.09, 0.24, 0.14)
            cr.rectangle(mx, sy, mw, seg_h)
            cr.set_source_rgb(*(col_on if is_lit else col_off))
            cr.fill()
        return False


class GraphicEQBank(Gtk.DrawingArea):
    """Interactive 10-Band Illuminated Studio Graphic Equalizer (±12 dB)."""

    def __init__(self, on_band_change):
        super().__init__()
        self.gains = [0.0] * 10  # -12.0 .. +12.0 dB
        self.on_band_change = on_band_change
        self._active_band: int | None = None

        self.set_size_request(268, 178)
        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.SCROLL_MASK
        )
        self.connect("draw", self._on_draw)
        self.connect("button-press-event", self._on_press)
        self.connect("button-release-event", self._on_release)
        self.connect("motion-notify-event", self._on_motion)
        self.connect("scroll-event", self._on_scroll)

    def set_gains(self, gains: list[float], notify: bool = True):
        for i in range(min(10, len(gains))):
            self.gains[i] = max(-12.0, min(12.0, float(gains[i])))
        self.queue_draw()
        if notify and self.on_band_change:
            self.on_band_change(list(self.gains))

    def _band_at_x(self, x: float, w: float) -> int:
        left = 26.0
        col_w = max(12.0, (w - left - 6.0) / 10.0)
        return max(0, min(9, int((x - left) / col_w)))

    def _y_to_db(self, y: float, h: float) -> float:
        top, bot = 14.0, h - 22.0
        frac = 1.0 - max(0.0, min(1.0, (y - top) / max(1.0, bot - top)))
        return -12.0 + frac * 24.0

    def _on_press(self, w, ev):
        alloc = w.get_allocation()
        b = self._band_at_x(ev.x, alloc.width)
        if ev.type == Gdk.EventType._2BUTTON_PRESS:
            self.gains[b] = 0.0
            self.queue_draw()
            if self.on_band_change:
                self.on_band_change(list(self.gains))
            return True
        if ev.button == 1:
            self._active_band = b
            self.gains[b] = self._y_to_db(ev.y, alloc.height)
            self.queue_draw()
            if self.on_band_change:
                self.on_band_change(list(self.gains))
            return True
        return False

    def _on_release(self, _w, _ev):
        self._active_band = None
        return True

    def _on_motion(self, w, ev):
        if self._active_band is not None:
            alloc = w.get_allocation()
            b = self._band_at_x(ev.x, alloc.width)
            self._active_band = b
            self.gains[b] = self._y_to_db(ev.y, alloc.height)
            self.queue_draw()
            if self.on_band_change:
                self.on_band_change(list(self.gains))
            return True
        return False

    def _on_scroll(self, w, ev):
        alloc = w.get_allocation()
        b = self._band_at_x(ev.x, alloc.width)
        step = 1.0
        if ev.direction == Gdk.ScrollDirection.UP:
            self.gains[b] = min(12.0, self.gains[b] + step)
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            self.gains[b] = max(-12.0, self.gains[b] - step)
        elif ev.direction == Gdk.ScrollDirection.SMOOTH:
            _, _dx, dy = ev.get_scroll_deltas()
            self.gains[b] = max(-12.0, min(12.0, self.gains[b] - dy * 0.8))
        self.queue_draw()
        if self.on_band_change:
            self.on_band_change(list(self.gains))
        return True

    def _on_draw(self, w, cr: cairo.Context):
        alloc = w.get_allocation()
        W, H = float(alloc.width), float(alloc.height)
        cr.rectangle(0, 0, W, H)
        cr.set_source_rgb(0.14, 0.16, 0.20)
        cr.fill()

        left = 26.0
        top, bot = 14.0, H - 22.0
        span = max(20.0, bot - top)
        mid_y = top + span * 0.5
        col_w = (W - left - 6.0) / 10.0

        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(6.8)
        for db_v, lbl in ((12.0, "+12"), (6.0, " +6"), (0.0, "  0"), (-6.0, " -6"), (-12.0, "-12")):
            yy = top + (1.0 - (db_v + 12.0) / 24.0) * span
            cr.set_line_width(1.2 if db_v == 0.0 else 0.7)
            cr.set_source_rgba(0.95, 0.76, 0.36, 0.55) if db_v == 0.0 else cr.set_source_rgba(0.55, 0.62, 0.72, 0.28)
            cr.move_to(left, yy)
            cr.line_to(W - 6.0, yy)
            cr.stroke()
            cr.set_source_rgb(0.78, 0.83, 0.90)
            cr.move_to(2.0, yy + 2.5)
            cr.show_text(lbl)

        # Draw connected amber frequency response curve glow behind sliders
        pts = []
        for i in range(10):
            cx = left + (i + 0.5) * col_w
            cy = top + (1.0 - (self.gains[i] + 12.0) / 24.0) * span
            pts.append((cx, cy))
        cr.set_line_width(1.6)
        cr.set_source_rgba(0.38, 0.96, 0.84, 0.45)
        cr.move_to(*pts[0])
        for px, py in pts[1:]:
            cr.line_to(px, py)
        cr.stroke()

        # Individual band slots + illuminated LED thumb caps
        for i, (cx, cy) in enumerate(pts):
            cr.rectangle(cx - 2.0, top, 4.0, span)
            cr.set_source_rgb(0.06, 0.07, 0.09)
            cr.fill()

            # Boost/cut bar from 0dB center line
            y0, y1 = min(mid_y, cy), max(mid_y, cy)
            if y1 - y0 > 1.0:
                cr.rectangle(cx - 1.2, y0, 2.4, y1 - y0)
                cr.set_source_rgb(0.32, 0.94, 0.82)
                cr.fill()

            # Thumb cap with glowing amber center LED
            tw, th = min(16.0, col_w - 3.0), 9.0
            cr.rectangle(cx - tw * 0.5, cy - th * 0.5, tw, th)
            cr.set_source_rgb(0.66, 0.71, 0.80)
            cr.fill_preserve()
            cr.set_line_width(0.9)
            cr.set_source_rgb(0.12, 0.14, 0.18)
            cr.stroke()

            cr.rectangle(cx - tw * 0.32, cy - 1.2, tw * 0.64, 2.4)
            cr.set_source_rgb(1.0, 0.68, 0.18)
            cr.fill()

            # Band frequency label at bottom
            flbl = EQ_BANDS_LABELS[i]
            ext = cr.text_extents(flbl)
            cr.set_source_rgb(0.84, 0.88, 0.95)
            cr.move_to(cx - ext.width * 0.5, H - 6.0)
            cr.show_text(flbl)
        return False


