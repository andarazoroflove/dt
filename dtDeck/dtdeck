# Built-in 4-Stem Vintage Analog Tape Demo Synthesizer & Audio File Loader
# ---------------------------------------------------------------------------
def write_mono_wav_16(path: Path, samples: np.ndarray, sr: int = SAMPLE_RATE):
    path.parent.mkdir(parents=True, exist_ok=True)
    clipped = np.clip(samples, -1.0, 1.0)
    pcm16 = (clipped * 32767.0).astype("<i2")
    with wave.open(str(path), "wb") as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(sr)
        wf.writeframes(pcm16.tobytes())


def ensure_demo_4track_stems(cache_dir: Path = CACHE_DIR) -> list[tuple[str, Path, np.ndarray]]:
    """Synthesize a musical 16-second 4-stem 1980s analog Portastudio reel on demand."""
    cache_dir.mkdir(parents=True, exist_ok=True)
    stem_specs = [
        ("ANALOG BASS", cache_dir / "demo_trk1_bass.wav"),
        ("JUNO CHORDS", cache_dir / "demo_trk2_chords.wav"),
        ("TAPE DRUM+ARP", cache_dir / "demo_trk3_rhythm.wav"),
        ("SYNTH LEAD", cache_dir / "demo_trk4_lead.wav"),
    ]
    if all(p.is_file() and p.stat().st_size > SAMPLE_RATE for _, p in stem_specs):
        out = []
        for label, p in stem_specs:
            arr = load_audio_to_mono_f32(p)
            out.append((label, p, arr))
        return out

    dur = 16.0  # 8 bars at 120 BPM (2.0s per bar, 0.5s per beat)
    n = int(dur * SAMPLE_RATE)
    t = np.arange(n, dtype=np.float32) / SAMPLE_RATE

    # Chord progression (2 bars = 4s each): Am7 -> Fmaj7 -> Cmaj7 -> G6
    # --- Stem 1: Warm Analog Saw+Sub Bass (8th notes = 0.25s) ---
    bass = np.zeros(n, dtype=np.float32)
    bass_roots = [55.0, 55.0, 43.6535, 43.6535, 65.4064, 65.4064, 48.9994, 48.9994]  # A1, F1, C2, G1 (1 bar each -> repeat x2)
    bass_prog = [55.0, 55.0, 43.6535, 43.6535, 65.4064, 65.4064, 48.9994, 55.0]
    eighth_n = int(0.25 * SAMPLE_RATE)
    for step in range(int(dur / 0.25)):
        i0 = step * eighth_n
        i1 = min(n, i0 + eighth_n)
        lt = np.arange(i1 - i0, dtype=np.float32) / SAMPLE_RATE
        bar_idx = min(7, step // 8)
        f0 = bass_prog[bar_idx] * (2.0 if (step % 4 == 2) else 1.0)
        env = np.exp(-lt * 8.5) * (1.0 - np.exp(-lt * 180.0))
        sig = (
            0.62 * np.sin(2.0 * np.pi * f0 * lt)
            + 0.28 * np.sin(2.0 * np.pi * 2.0 * f0 * lt)
            + 0.12 * np.sin(2.0 * np.pi * 3.0 * f0 * lt) * env
        )
        bass[i0:i1] = sig * env * 0.78

    # --- Stem 2: Lush Chorus Polysynth Chords ---
    chords_hz = [
        [220.00, 261.63, 329.63, 392.00],  # Am7
        [174.61, 220.00, 261.63, 329.63],  # Fmaj7
        [196.00, 261.63, 329.63, 493.88],  # Cmaj7/G
        [196.00, 246.94, 293.66, 329.63],  # G6
    ]
    pad = np.zeros(n, dtype=np.float32)
    seg_n = int(4.0 * SAMPLE_RATE)
    for c_idx, freqs in enumerate(chords_hz):
        i0 = c_idx * seg_n
        i1 = min(n, i0 + seg_n)
        lt = np.arange(i1 - i0, dtype=np.float32) / SAMPLE_RATE
        lfo = 0.0035 * np.sin(2.0 * np.pi * 0.85 * lt)
        env = np.minimum(1.0, lt / 0.18) * np.minimum(1.0, (4.0 - lt) / 0.22)
        csum = np.zeros_like(lt)
        for fk in freqs:
            csum += np.sin(2.0 * np.pi * fk * (1.0 + lfo) * lt)
            csum += 0.45 * np.sin(2.0 * np.pi * fk * 2.0 * (1.0 - lfo * 0.7) * lt)
        pad[i0:i1] = np.tanh(csum * 0.22) * env * 0.65

    # --- Stem 3: 1980s Studio Drum Machine + Sparkling 16th Arp ---
    rhythm = np.zeros(n, dtype=np.float32)
    rng = np.random.default_rng(1984)
    beat_n = int(0.5 * SAMPLE_RATE)
    sixteenth_n = int(0.125 * SAMPLE_RATE)
    for b in range(int(dur / 0.5)):
        i0 = b * beat_n
        if b % 2 == 0:
            # Punchy analog kick
            kl = min(int(0.22 * SAMPLE_RATE), n - i0)
            kt = np.arange(kl, dtype=np.float32) / SAMPLE_RATE
            k_phase = 2.0 * np.pi * (48.0 * kt + 18.0 * (1.0 - np.exp(-kt * 38.0)))
            rhythm[i0 : i0 + kl] += 0.72 * np.sin(k_phase) * np.exp(-kt * 14.0)
        else:
            # Gated 80s snare
            sl = min(int(0.19 * SAMPLE_RATE), n - i0)
            st_arr = np.arange(sl, dtype=np.float32) / SAMPLE_RATE
            noise = rng.uniform(-1.0, 1.0, sl).astype(np.float32)
            body = np.sin(2.0 * np.pi * 185.0 * st_arr) * np.exp(-st_arr * 26.0)
            rhythm[i0 : i0 + sl] += (0.42 * noise * np.exp(-st_arr * 17.0) + 0.32 * body)

    arp_notes_sets = [
        [440.0, 523.25, 659.25, 783.99],
        [349.23, 440.0, 523.25, 659.25],
        [392.0, 523.25, 659.25, 783.99],
        [392.0, 493.88, 587.33, 783.99],
    ]
    for s16 in range(int(dur / 0.125)):
        i0 = s16 * sixteenth_n
        i1 = min(n, i0 + sixteenth_n)
        lt = np.arange(i1 - i0, dtype=np.float32) / SAMPLE_RATE
        # Closed hi-hat tick
        hh = rng.uniform(-1.0, 1.0, i1 - i0).astype(np.float32) * np.exp(-lt * 65.0) * 0.14
        c_idx = min(3, s16 // 32)
        fn = arp_notes_sets[c_idx][s16 % 4]
        arp = np.sin(2.0 * np.pi * fn * lt) * np.exp(-lt * 16.0) * 0.24
        rhythm[i0:i1] += hh + arp
    rhythm = np.clip(rhythm, -0.95, 0.95)

    # --- Stem 4: Analog Lead Melody + Broadcast Studio Sync Pips ---
    lead = np.zeros(n, dtype=np.float32)
    melody = [
        (0.5, 1.0, 659.25), (1.5, 0.5, 587.33), (2.0, 1.5, 523.25),
        (4.5, 1.0, 523.25), (5.5, 0.5, 587.33), (6.0, 1.5, 659.25),
        (8.5, 1.0, 783.99), (9.5, 0.5, 659.25), (10.0, 1.5, 523.25),
        (12.5, 1.0, 587.33), (13.5, 0.5, 659.25), (14.0, 1.6, 440.00),
    ]
    for t_start, n_dur, freq in melody:
        i0 = int(t_start * SAMPLE_RATE)
        i1 = min(n, int((t_start + n_dur) * SAMPLE_RATE))
        lt = np.arange(i1 - i0, dtype=np.float32) / SAMPLE_RATE
        vib = 1.0 + 0.0045 * np.sin(2.0 * np.pi * 5.4 * lt) * np.minimum(1.0, lt / 0.25)
        env = np.minimum(1.0, lt / 0.04) * np.minimum(1.0, (n_dur - lt) / 0.08)
        ph = 2.0 * np.pi * np.cumsum(np.full_like(lt, freq) * vib) / SAMPLE_RATE
        wave_sig = 0.65 * np.sin(ph) + 0.22 * np.sin(2.0 * ph) + 0.10 * np.sin(3.0 * ph)
        lead[i0:i1] += wave_sig * env * 0.56

    # Subtle 1kHz studio slate sync pip on bar 1 & bar 5
    for pip_t in (0.0, 8.0):
        i0 = int(pip_t * SAMPLE_RATE)
        i1 = min(n, i0 + int(0.06 * SAMPLE_RATE))
        lt = np.arange(i1 - i0, dtype=np.float32) / SAMPLE_RATE
        lead[i0:i1] += 0.35 * np.sin(2.0 * np.pi * 1000.0 * lt) * np.exp(-lt * 25.0)

    arrays = [bass, pad, rhythm, lead]
    out = []
    for (label, path), arr in zip(stem_specs, arrays):
        write_mono_wav_16(path, arr, SAMPLE_RATE)
        out.append((label, path, arr))
    return out


def load_audio_to_mono_f32(path: Path) -> np.ndarray:
    """Decode WAV (via `wave`+`numpy`) or any compressed audio (via GStreamer) to 44.1kHz mono float32."""
    if path.suffix.lower() == ".wav":
        try:
            with wave.open(str(path), "rb") as wf:
                nch = wf.getnchannels()
                sw = wf.getsampwidth()
                sr = wf.getframerate()
                nframes = wf.getnframes()
                raw = wf.readframes(nframes)
            if sw == 2:
                data = np.frombuffer(raw, dtype="<i2").astype(np.float32) / 32768.0
            elif sw == 1:
                data = (np.frombuffer(raw, dtype=np.uint8).astype(np.float32) - 128.0) / 128.0
            elif sw == 4:
                data = np.frombuffer(raw, dtype="<i4").astype(np.float32) / 2147483648.0
            elif sw == 3:
                b = np.frombuffer(raw, dtype=np.uint8).reshape(-1, 3)
                val = (
                    b[:, 0].astype(np.int32)
                    | (b[:, 1].astype(np.int32) << 8)
                    | (b[:, 2].astype(np.int8).astype(np.int32) << 16)
                )
                data = val.astype(np.float32) / 8388608.0
            else:
                raise ValueError("Unsupported PCM width")

            if nch > 1:
                data = data[: (len(data) // nch) * nch].reshape(-1, nch).mean(axis=1)
            if sr != SAMPLE_RATE and len(data) > 1:
                new_len = max(1, int(round(len(data) * SAMPLE_RATE / float(sr))))
                xp = np.linspace(0.0, 1.0, len(data), dtype=np.float32)
                xq = np.linspace(0.0, 1.0, new_len, dtype=np.float32)
                data = np.interp(xq, xp, data).astype(np.float32)
            return data
        except Exception:
            pass

    # Fallback: GStreamer decodebin -> 44.1kHz S16LE mono appsink
    uri = path.resolve().as_uri()
    pipe = Gst.Pipeline.new("file_loader")
    src = Gst.ElementFactory.make("uridecodebin", None)
    src.set_property("uri", uri)
    conv = Gst.ElementFactory.make("audioconvert", None)
    res = Gst.ElementFactory.make("audioresample", None)
    capsf = Gst.ElementFactory.make("capsfilter", None)
    capsf.set_property("caps", Gst.Caps.from_string(f"audio/x-raw,format=S16LE,channels=1,rate={SAMPLE_RATE}"))
    sink = Gst.ElementFactory.make("appsink", None)
    sink.set_property("sync", False)
    sink.set_property("emit-signals", False)

    for el in (src, conv, res, capsf, sink):
        pipe.add(el)
    conv.link(res)
    res.link(capsf)
    capsf.link(sink)

    def on_pad(_el, pad):
        caps = pad.get_current_caps() or pad.query_caps(None)
        if caps and caps.get_size() > 0 and caps.get_structure(0).get_name().startswith("audio/"):
            sp = conv.get_static_pad("sink")
            if sp and not sp.is_linked():
                pad.link(sp)

    src.connect("pad-added", on_pad)
    chunks: list[np.ndarray] = []
    pipe.set_state(Gst.State.PLAYING)
    bus = pipe.get_bus()
    deadline = time.monotonic() + 12.0
    try:
        while time.monotonic() < deadline:
            sample = sink.emit("try-pull-sample", 40_000_000)
            if sample is not None:
                buf = sample.get_buffer()
                ok, mi = buf.map(Gst.MapFlags.READ)
                if ok:
                    try:
                        chunks.append(np.frombuffer(mi.data, dtype="<i2").copy())
                    finally:
                        buf.unmap(mi)
            msg = bus.pop_filtered(Gst.MessageType.EOS | Gst.MessageType.ERROR)
            if msg is not None:
                break
    finally:
        pipe.set_state(Gst.State.NULL)

    if not chunks:
        return np.zeros(0, dtype=np.float32)
    return np.concatenate(chunks).astype(np.float32) / 32768.0


# ---------------------------------------------------------------------------
# 4-Track Channel Model & Numpy Master Bounce Engine
# ---------------------------------------------------------------------------
@dataclass
class TapeTrack:
    index: int
    name: str = "EMPTY"
    path: str = ""
    samples: np.ndarray = field(default_factory=lambda: np.zeros(0, dtype=np.float32))
    fader: float = 0.78       # 0.0 .. 1.0 (0.78 ~= 0 dB unity, 1.0 = +3.5 dB)
    pan: float = 0.5          # 0.0 = Hard L, 0.5 = Center, 1.0 = Hard R
    muted: bool = False
    solo: bool = False
    rec_arm: bool = False
    meter_db: float = -60.0   # Live channel strip post-fader dB

    def gain_linear(self) -> float:
        if self.fader <= 0.01:
            return 0.0
        # Smooth audio taper: 0.78 -> 1.0x (0dB), 1.0 -> 1.50x (+3.5dB)
        return float(math.pow(self.fader / 0.78, 1.85))

    def pan_gains(self) -> tuple[float, float]:
        ang = self.pan * (math.pi * 0.5)
        return float(math.cos(ang)), float(math.sin(ang))


def bounce_tracks_numpy(
    tracks: list[TapeTrack],
    out_path: Path,
    varispeed_pct: float = 0.0,
    bias_mode: str = "WARM",
    master_gain: float = 0.85,
) -> tuple[bool, str, int]:
    """Mix active 4-track stems with fader/pan/varispeed/tape-warmth into a stereo 16-bit WAV."""
    any_solo = any(t.solo for t in tracks)
    active: list[TapeTrack] = []
    max_len = 0
    for trk in tracks:
        is_audible = trk.solo if any_solo else (not trk.muted)
        if is_audible and len(trk.samples) > 0 and trk.fader > 0.01:
            active.append(trk)
            max_len = max(max_len, len(trk.samples))

    if max_len == 0 or not active:
        return False, "NO AUDIBLE TRACK AUDIO TO BOUNCE", 0

    mix_l = np.zeros(max_len, dtype=np.float32)
    mix_r = np.zeros(max_len, dtype=np.float32)

    for trk in active:
        g = trk.gain_linear()
        gl, gr = trk.pan_gains()
        n = len(trk.samples)
        mix_l[:n] += trk.samples * (g * gl)
        mix_r[:n] += trk.samples * (g * gr)

    # Apply Varispeed resampling if non-zero
    speed_ratio = max(0.80, min(1.20, 1.0 + varispeed_pct / 100.0))
    if abs(speed_ratio - 1.0) > 0.002 and max_len > 4:
        out_len = max(2, int(round(max_len / speed_ratio)))
        xp = np.arange(max_len, dtype=np.float32)
        xq = np.linspace(0.0, float(max_len - 1), out_len, dtype=np.float32)
        mix_l = np.interp(xq, xp, mix_l).astype(np.float32)
        mix_r = np.interp(xq, xp, mix_r).astype(np.float32)

    # Apply Tape Bias / Oxide character
    mg = float(max(0.05, master_gain * 1.15))
    mix_l *= mg
    mix_r *= mg
    if bias_mode == "WARM":
        drive = 1.28
        norm_t = float(math.tanh(drive))
        mix_l = np.tanh(mix_l * drive) / norm_t
        mix_r = np.tanh(mix_r * drive) / norm_t
    elif bias_mode == "DOLBY-B":
        # Gentle 1-pole HF hiss smoothing
        k = np.array([0.22, 0.56, 0.22], dtype=np.float32)
        mix_l = np.convolve(mix_l, k, mode="same")
        mix_r = np.convolve(mix_r, k, mode="same")

    stereo = np.empty((len(mix_l), 2), dtype=np.float32)
    stereo[:, 0] = np.clip(mix_l, -1.0, 1.0)
    stereo[:, 1] = np.clip(mix_r, -1.0, 1.0)
    pcm16 = (stereo * 32767.0).astype("<i2")

    out_path.parent.mkdir(parents=True, exist_ok=True)
    with wave.open(str(out_path), "wb") as wf:
        wf.setnchannels(2)
        wf.setsampwidth(2)
        wf.setframerate(SAMPLE_RATE)
        wf.writeframes(pcm16.tobytes())

    return True, str(out_path), len(mix_l)


# ---------------------------------------------------------------------------
# Audio Input Device Discovery (Mic + Desktop Monitor)
# ---------------------------------------------------------------------------
def discover_record_sources() -> list[tuple[str, str]]:
    """Return list of (id, label) audio capture sources including Desktop Monitor."""
    sources: list[tuple[str, str]] = [("auto", "DEFAULT MIC / INPUT")]
    try:
        out = subprocess.check_output(
            ["pactl", "list", "short", "sources"], text=True, stderr=subprocess.DEVNULL, timeout=1.5
        )
        for ln in out.splitlines():
            parts = ln.split("\t")
            if len(parts) >= 2:
                dev = parts[1].strip()
                if ".monitor" in dev:
                    short = dev.replace("alsa_output.", "").replace(".monitor", "")[:22]
                    sources.append((f"pulse:{dev}", f"MONITOR: {short}"))
                else:
                    short = dev.replace("alsa_input.", "")[:22]
                    sources.append((f"pulse:{dev}", f"MIC: {short}"))
    except Exception:
        sources.append(("pulse_default_monitor", "DESKTOP MONITOR (PULSE)"))
    sources.append(("sim_tone", "STUDIO TEST MIC (440Hz/VOX)"))
    return sources


# ---------------------------------------------------------------------------
# Real-Time 4-Track Tape Transport, Simul-Sync Recorder & GStreamer Master Bus
# ---------------------------------------------------------------------------
class TapeDeckEngine:
    def __init__(self, on_vu_cb, on_status_cb, headless: bool = False):
        self.on_vu_cb = on_vu_cb
        self.on_status_cb = on_status_cb
        self.headless = headless

        self.tracks: list[TapeTrack] = [
            TapeTrack(0, "EMPTY", fader=0.80, pan=0.35),
            TapeTrack(1, "EMPTY", fader=0.76, pan=0.65),
            TapeTrack(2, "EMPTY", fader=0.78, pan=0.45),
            TapeTrack(3, "EMPTY", fader=0.78, pan=0.55),
        ]
        self._lock = threading.Lock()

        # Transport state: "STOP", "PLAY", "PAUSE", "REW", "FF", "REC", "RTZ"
        self.mode: str = "STOP"
        self.playhead: float = 0.0          # Sample index at 44.1 kHz
        self.counter_zero_sample: float = 0.0
        self.memory_sample: float = 0.0
        self.rtz_target_sample: float = 0.0

        # Loop A-B state: 0=off, 1=A set waiting B, 2=active A..B loop
        self.loop_state: int = 0
        self.loop_a: float = 0.0
        self.loop_b: float = 0.0

        # DSP parameters
        self.eq_gains: list[float] = [0.0] * 10
        self.varispeed_pct: float = 0.0     # -20.0 .. +20.0 %
        self.bias_mode: str = "WARM"        # "FLAT" | "WARM" | "DOLBY-B"
        self.master_gain: float = 0.82
        self.input_source_id: str = "auto"

        # GStreamer master bus elements
        self._pipe: Gst.Pipeline | None = None
        self._appsrc: Gst.Element | None = None
        self._eq: Gst.Element | None = None
        self._lp: Gst.Element | None = None
        self._vol: Gst.Element | None = None

        # Live recording capture pipeline & WAV writers
        self._rec_pipe: Gst.Pipeline | None = None
        self._rec_wavs: dict[int, tuple[wave.Wave_write, Path]] = {}
        self._rec_write_cursor: int = 0

        self._running = True
        self._build_master_pipeline()
        self._feeder_thread = threading.Thread(target=self._feeder_loop, daemon=True)
        self._feeder_thread.start()

    def total_samples(self) -> int:
        m = max((len(t.samples) for t in self.tracks), default=0)
        if self.mode == "REC":
            m = max(m, int(self.playhead) + SAMPLE_RATE * 2)
        return max(m, SAMPLE_RATE * 16)

    def progress_fraction(self) -> float:
        tot = max(1, self.total_samples())
        return max(0.0, min(1.0, self.playhead / float(tot)))

    def _build_master_pipeline(self):
        pipe = Gst.Pipeline.new("dtdeck_master_bus")
        appsrc = Gst.ElementFactory.make("appsrc", "tape_src")
        appsrc.set_property("is-live", True)
        appsrc.set_property("format", Gst.Format.TIME)
        appsrc.set_property("do-timestamp", True)
        appsrc.set_property("block", False)
        appsrc.set_property("max-bytes", BLOCK_FRAMES * 4 * 6)
        appsrc.set_property(
            "caps",
            Gst.Caps.from_string(
                f"audio/x-raw,format=S16LE,channels=2,rate={SAMPLE_RATE},layout=interleaved"
            ),
        )

        conv1 = Gst.ElementFactory.make("audioconvert", None)
        eq = Gst.ElementFactory.make("equalizer-10bands", "eq10")
        lp = Gst.ElementFactory.make("audiocheblimit", "tape_lp")
        Gst.util_set_object_arg(lp, "mode", "low-pass")
        lp.set_property("poles", 4)
        lp.set_property("cutoff", 12500.0)

        vol = Gst.ElementFactory.make("volume", "master_vol")
        lvl = Gst.ElementFactory.make("level", "vu_level")
        lvl.set_property("interval", 33_000_000)  # ~30 Hz
        lvl.set_property("post-messages", True)
        lvl.set_property("peak-ttl", 250_000_000)
        lvl.set_property("peak-falloff", 14.0)

        conv2 = Gst.ElementFactory.make("audioconvert", None)
        res2 = Gst.ElementFactory.make("audioresample", None)
        if self.headless:
            sink = Gst.ElementFactory.make("fakesink", None)
            sink.set_property("sync", True)
        else:
            sink = Gst.ElementFactory.make("autoaudiosink", None)

        for el in (appsrc, conv1, eq, lp, vol, lvl, conv2, res2, sink):
            pipe.add(el)

        appsrc.link(conv1)
        conv1.link(eq)
        eq.link(lp)
        lp.link(vol)
        vol.link(lvl)
        lvl.link(conv2)
        conv2.link(res2)
        res2.link(sink)

        bus = pipe.get_bus()
        bus.add_signal_watch()
        bus.connect("message", self._on_bus_message)

        self._pipe = pipe
        self._appsrc = appsrc
        self._eq = eq
        self._lp = lp
        self._vol = vol
        self.apply_dsp()
        pipe.set_state(Gst.State.PLAYING)

    def apply_dsp(self):
        if self._eq is not None:
            for i in range(10):
                g = float(max(-24.0, min(12.0, self.eq_gains[i])))
                if self.bias_mode == "WARM":
                    if i in (1, 2):
                        g = min(12.0, g + 1.8)
                    elif i == 9:
                        g = max(-24.0, g - 2.0)
                elif self.bias_mode == "DOLBY-B":
                    if i >= 8:
                        g = max(-24.0, g - 3.5)
                self._eq.set_property(f"band{i}", g)

        if self._lp is not None:
            cutoff = {"FLAT": 19500.0, "WARM": 12200.0, "DOLBY-B": 8400.0}.get(self.bias_mode, 15000.0)
            self._lp.set_property("cutoff", float(cutoff))

        if self._vol is not None:
            self._vol.set_property("volume", float(max(0.0, self.master_gain * 1.25)))

    def _on_bus_message(self, _bus, msg):
        if msg.type == Gst.MessageType.ELEMENT:
            st = msg.get_structure()
            if st and st.get_name() == "level":
                rms_list = st.get_value("rms")
                peak_list = st.get_value("peak")
                if rms_list and len(rms_list) >= 2:
                    rms_l = float(rms_list[0])
                    rms_r = float(rms_list[1])
                    pk_l = float(peak_list[0]) if peak_list and len(peak_list) >= 1 else rms_l
                    pk_r = float(peak_list[1]) if peak_list and len(peak_list) >= 2 else rms_r
                    if self.on_vu_cb:
                        self.on_vu_cb(rms_l, rms_r, pk_l, pk_r)
        elif msg.type == Gst.MessageType.ERROR:
            err, _dbg = msg.parse_error()
            if self.on_status_cb:
                GLib.idle_add(self.on_status_cb, f"AUDIO ENGINE NOTICE: {err.message[:48]}")

    def poll_bus_sync(self):
        """Pump GStreamer bus messages explicitly when no GLib main loop is active (headless self-test)."""
        if self._pipe is None:
            return
        bus = self._pipe.get_bus()
        while True:
            msg = bus.pop()
            if msg is None:
                break
            self._on_bus_message(bus, msg)

    # ---- Live Simul-Sync Multitrack Recording ----
    def _start_live_capture(self, armed_indices: list[int]):
        self._stop_live_capture()
        DECK_DIR.mkdir(parents=True, exist_ok=True)
        ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")

        with self._lock:
            self._rec_write_cursor = int(max(0.0, self.playhead))
            for idx in armed_indices:
                out_p = DECK_DIR / f"dtdeck_trk{idx+1}_{ts}.wav"
                wf = wave.open(str(out_p), "wb")
                wf.setnchannels(1)
                wf.setsampwidth(2)
                wf.setframerate(SAMPLE_RATE)
                self._rec_wavs[idx] = (wf, out_p)
                self.tracks[idx].name = f"REC TRK{idx+1}"
                self.tracks[idx].path = str(out_p)
                # Ensure buffer is at least up to current playhead
                need = self._rec_write_cursor + SAMPLE_RATE * 4
                if len(self.tracks[idx].samples) < need:
                    pad = np.zeros(need - len(self.tracks[idx].samples), dtype=np.float32)
                    self.tracks[idx].samples = np.concatenate([self.tracks[idx].samples, pad])

        if self.input_source_id == "sim_tone" or self.headless:
            # Built-in test microphone synth generated inside feeder loop
            return

        pipe = Gst.Pipeline.new("dtdeck_simul_rec")
        src = None
        if self.input_source_id.startswith("pulse:"):
            dev = self.input_source_id.split(":", 1)[1]
            src = Gst.ElementFactory.make("pulsesrc", None)
            if src is not None:
                src.set_property("device", dev)
        elif self.input_source_id == "pulse_default_monitor":
            src = Gst.ElementFactory.make("pulsesrc", None)
        if src is None:
            src = Gst.ElementFactory.make("autoaudiosrc", None)

        conv = Gst.ElementFactory.make("audioconvert", None)
        res = Gst.ElementFactory.make("audioresample", None)
        capsf = Gst.ElementFactory.make("capsfilter", None)
        capsf.set_property("caps", Gst.Caps.from_string(f"audio/x-raw,format=S16LE,channels=1,rate={SAMPLE_RATE}"))
        appsink = Gst.ElementFactory.make("appsink", "rec_sink")
        appsink.set_property("emit-signals", True)
        appsink.set_property("sync", False)
        appsink.set_property("drop", True)
        appsink.set_property("max-buffers", 24)
        appsink.connect("new-sample", self._on_capture_sample)

        for el in (src, conv, res, capsf, appsink):
            pipe.add(el)
        src.link(conv)
        conv.link(res)
        res.link(capsf)
        capsf.link(appsink)

        ret = pipe.set_state(Gst.State.PLAYING)
        if ret == Gst.StateChangeReturn.FAILURE:
            pipe.set_state(Gst.State.NULL)
            if self.on_status_cb:
                GLib.idle_add(self.on_status_cb, "MIC DEVICE UNAVAILABLE — USING STUDIO TEST INPUT")
            return
        self._rec_pipe = pipe

    def _on_capture_sample(self, appsink):
        sample = appsink.emit("pull-sample")
        if sample is None or self.mode != "REC":
            return Gst.FlowReturn.OK
        buf = sample.get_buffer()
        ok, mi = buf.map(Gst.MapFlags.READ)
        if ok:
            try:
                raw_bytes = bytes(mi.data)
                f32 = np.frombuffer(raw_bytes, dtype="<i2").astype(np.float32) / 32768.0
                self._append_recorded_chunk(raw_bytes, f32)
            finally:
                buf.unmap(mi)
        return Gst.FlowReturn.OK

    def _append_recorded_chunk(self, raw_s16: bytes, f32: np.ndarray):
        if len(f32) == 0:
            return
        rms = float(np.sqrt(np.mean(f32 * f32)) + 1e-9)
        db = max(-60.0, min(6.0, 20.0 * math.log10(rms)))
        with self._lock:
            c0 = self._rec_write_cursor
            c1 = c0 + len(f32)
            for idx, (wf, _p) in self._rec_wavs.items():
                try:
                    wf.writeframesraw(raw_s16)
                except Exception:
                    pass
                trk = self.tracks[idx]
                if len(trk.samples) < c1 + SAMPLE_RATE:
                    grow = np.zeros(max(SAMPLE_RATE * 4, c1 - len(trk.samples) + SAMPLE_RATE), dtype=np.float32)
                    trk.samples = np.concatenate([trk.samples, grow])
                trk.samples[c0:c1] = f32
                trk.meter_db = db
            self._rec_write_cursor = c1

    def _stop_live_capture(self):
        if self._rec_pipe is not None:
            try:
                self._rec_pipe.set_state(Gst.State.NULL)
            except Exception:
                pass
            self._rec_pipe = None

        saved_paths: list[str] = []
        with self._lock:
            end_cur = self._rec_write_cursor
            for idx, (wf, out_p) in list(self._rec_wavs.items()):
                try:
                    wf.close()
                except Exception:
                    pass
                trk = self.tracks[idx]
                if 0 < end_cur < len(trk.samples):
                    trk.samples = trk.samples[:end_cur].copy()
                saved_paths.append(out_p.name)
            self._rec_wavs.clear()

        if saved_paths and self.on_status_cb:
            GLib.idle_add(self.on_status_cb, f"SAVED SIMUL-SYNC TAKE -> ~/Music/dtDeck/{saved_paths[0]}")

    # ---- Transport Commands ----
    def set_mode(self, new_mode: str):
        if new_mode == self.mode and new_mode != "STOP":
            if new_mode == "PAUSE":
                self.mode = "PLAY"
            return

        if self.mode == "REC" and new_mode != "REC":
            self._stop_live_capture()

        if new_mode == "REC":
            armed = [t.index for t in self.tracks if t.rec_arm]
            if not armed:
                # Convenience: auto-arm Track 4 (or first empty track) if user clicks REC directly
                empty = [t.index for t in self.tracks if len(t.samples) == 0]
                pick = empty[0] if empty else 3
                self.tracks[pick].rec_arm = True
                armed = [pick]
            self.mode = "REC"
            self._start_live_capture(armed)
            return

        if new_mode == "PLAY" and self.playhead >= self.total_samples() - 64:
            self.playhead = 0.0

        self.mode = new_mode

    def start_rtz(self, to_memory: bool = False):
        if self.mode == "REC":
            self._stop_live_capture()
        self.rtz_target_sample = self.memory_sample if to_memory else self.counter_zero_sample
        self.rtz_target_sample = max(0.0, min(float(self.total_samples()), self.rtz_target_sample))
        if abs(self.playhead - self.rtz_target_sample) < BLOCK_FRAMES:
            self.playhead = self.rtz_target_sample
            self.mode = "STOP"
        else:
            self.mode = "RTZ"

    # ---- Real-Time 4-Track Tape Head Readout Loop ----
    def _feeder_loop(self):
        frame_dt = BLOCK_FRAMES / float(SAMPLE_RATE)
        next_t = time.monotonic()
        sim_phase = 0.0

        while self._running:
            now = time.monotonic()
            if now < next_t:
                time.sleep(min(0.012, next_t - now))
                continue
            next_t = max(now, next_t + frame_dt)

            m = self.mode
            if m in ("PLAY", "REC"):
                speed_ratio = max(0.80, min(1.20, 1.0 + self.varispeed_pct / 100.0))
                step_samples = BLOCK_FRAMES * speed_ratio

                with self._lock:
                    tot = self.total_samples()
                    pos0 = self.playhead
                    pos1 = pos0 + step_samples

                    if m == "PLAY" and self.loop_state == 2 and self.loop_b > self.loop_a + BLOCK_FRAMES:
                        if pos1 >= self.loop_b:
                            pos0 = self.loop_a
                            pos1 = pos0 + step_samples

                    if m == "PLAY" and pos0 >= tot:
                        self.playhead = float(tot)
                        self.mode = "STOP"
                        for trk in self.tracks:
                            trk.meter_db = -60.0
                        continue

                    any_solo = any(t.solo for t in self.tracks)
                    mix_l = np.zeros(BLOCK_FRAMES, dtype=np.float32)
                    mix_r = np.zeros(BLOCK_FRAMES, dtype=np.float32)
                    xq = np.linspace(pos0, pos1, BLOCK_FRAMES, endpoint=False, dtype=np.float32)

                    for trk in self.tracks:
                        # In Simul-Sync REC, play un-armed tracks so user can overdub without feedback
                        if m == "REC" and trk.rec_arm:
                            continue
                        n_s = len(trk.samples)
                        if n_s == 0:
                            trk.meter_db = max(-60.0, trk.meter_db - 3.2)
                            continue

                        idx_int = xq.astype(np.int64)
                        valid = (idx_int >= 0) & (idx_int < n_s - 1)
                        if not np.any(valid):
                            trk.meter_db = max(-60.0, trk.meter_db - 3.2)
                            continue

                        seg = np.zeros(BLOCK_FRAMES, dtype=np.float32)
                        vi = idx_int[valid]
                        frac = xq[valid] - vi
                        seg[valid] = trk.samples[vi] * (1.0 - frac) + trk.samples[vi + 1] * frac

                        g = trk.gain_linear()
                        post = seg * g
                        rms = float(np.sqrt(np.mean(post * post)) + 1e-9)
                        trk.meter_db = max(-60.0, min(6.0, 20.0 * math.log10(rms)))

                        audible = trk.solo if any_solo else (not trk.muted)
                        if audible and g > 0.0:
                            gl, gr = trk.pan_gains()
                            mix_l += post * gl
                            mix_r += post * gr

                    self.playhead = pos1

                # If recording via simulated mic / headless self-test, synthesize live input
                if m == "REC" and self._rec_pipe is None:
                    lt = (np.arange(BLOCK_FRAMES, dtype=np.float32) + sim_phase) / SAMPLE_RATE
                    sim_phase += BLOCK_FRAMES
                    sim_sig = (
                        0.42 * np.sin(2.0 * np.pi * 440.0 * lt)
                        + 0.18 * np.sin(2.0 * np.pi * 554.37 * lt)
                    ) * (0.65 + 0.35 * np.sin(2.0 * np.pi * 2.0 * lt))
                    pcm_rec = (np.clip(sim_sig, -1.0, 1.0) * 32767.0).astype("<i2")
                    self._append_recorded_chunk(pcm_rec.tobytes(), sim_sig.astype(np.float32))
                    # Monitor soft input in headphones
                    mix_l += sim_sig * 0.25
                    mix_r += sim_sig * 0.25

                if self.bias_mode == "WARM":
                    mix_l = np.tanh(mix_l * 1.2) / 0.83365
                    mix_r = np.tanh(mix_r * 1.2) / 0.83365

                stereo = np.empty((BLOCK_FRAMES, 2), dtype=np.float32)
                stereo[:, 0] = np.clip(mix_l, -1.0, 1.0)
                stereo[:, 1] = np.clip(mix_r, -1.0, 1.0)
                pcm_bytes = (stereo * 32767.0).astype("<i2").tobytes()
                if self._appsrc is not None:
                    self._appsrc.emit("push-buffer", Gst.Buffer.new_wrapped(pcm_bytes))

            elif m in ("FF", "REW", "RTZ"):
                wind_rate = 6.0 * BLOCK_FRAMES
                with self._lock:
                    tot = float(self.total_samples())
                    if m == "FF":
                        self.playhead = min(tot, self.playhead + wind_rate)
                        if self.playhead >= tot:
                            self.mode = "STOP"
                    elif m == "REW":
                        self.playhead = max(0.0, self.playhead - wind_rate)
                        if self.playhead <= 0.0:
                            self.mode = "STOP"
                    elif m == "RTZ":
                        diff = self.rtz_target_sample - self.playhead
                        if abs(diff) <= wind_rate:
                            self.playhead = self.rtz_target_sample
                            self.mode = "STOP"
                        else:
                            self.playhead += math.copysign(wind_rate, diff)
                    for trk in self.tracks:
                        trk.meter_db = max(-60.0, trk.meter_db - 4.0)
            else:
                # STOP or PAUSE: decay per-track meters cleanly
                with self._lock:
                    for trk in self.tracks:
                        trk.meter_db = max(-60.0, trk.meter_db - 3.5)

    def shutdown(self):
        self._running = False
        self._stop_live_capture()
        if self._feeder_thread.is_alive():
            self._feeder_thread.join(timeout=0.8)
        if self._pipe is not None:
            try:
                self._pipe.set_state(Gst.State.NULL)
            except Exception:
                pass
            self._pipe = None


