            t.path = ""
            t.rec_arm = False
            t.meter_db = -60.0
        self._sync_strip_buttons()
        self._set_status(f"CLEARED TRK {idx+1}")

    def _load_demo_4track(self, auto_play: bool = True):
        stems = ensure_demo_4track_stems()
        pans = (0.38, 0.64, 0.46, 0.56)
        faders = (0.80, 0.76, 0.78, 0.78)
        with self.engine._lock:
            for idx, (label, path, arr) in enumerate(stems):
                trk = self.engine.tracks[idx]
                trk.name = label
                trk.path = str(path)
                trk.samples = arr.copy()
                trk.pan = pans[idx]
                trk.fader = faders[idx]
                trk.muted = False
                trk.solo = False
                trk.rec_arm = False
                self.strip_widgets[idx]["pan"].set_value(trk.pan, notify=False)
                self.strip_widgets[idx]["fader"].set_value(trk.fader, notify=False)
            self.engine.playhead = 0.0
            self.engine.counter_zero_sample = 0.0
        self._sync_strip_buttons()
        if auto_play:
            self._set_transport("PLAY")
            self._set_status("★ PLAYING 4-STEM 1980s ANALOG DEMO REEL (SOLO/MUTE TRK 1..4 OR SWEEP EQ!)")
