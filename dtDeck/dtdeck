    def _on_draw_vu(self, w, cr: cairo.Context):
        alloc = w.get_allocation()
        W, H = float(alloc.width), float(alloc.height)
        gap = 8.0
        mw = (W - gap) * 0.5
        now = time.monotonic()
        render_single_vu_meter(cr, 0.0, 0.0, mw, H, "CH L", self.vu_needle_l, now < self.peak_hold_l)
        render_single_vu_meter(cr, mw + gap, 0.0, mw, H, "CH R", self.vu_needle_r, now < self.peak_hold_r)
        return False

    def _on_draw_counter(self, w, cr: cairo.Context):
        alloc = w.get_allocation()
        # 1 drum count = 0.25 sec of standard 1x tape travel (classic 4 counts/sec mechanical feel)
        drum_val = (self.engine.playhead - self.engine.counter_zero_sample) / (SAMPLE_RATE * 0.25)
        mem_drum = int(round((self.engine.memory_sample - self.engine.counter_zero_sample) / (SAMPLE_RATE * 0.25))) % 10000
        render_drum_and_vfd_counter(
            cr,
            float(alloc.width),
            float(alloc.height),
            drum_val,
            self.engine.playhead / float(SAMPLE_RATE),
            self.engine.total_samples() / float(SAMPLE_RATE),
            self.engine.mode,
            mem_drum,
            self.engine.loop_state,
            self.engine.varispeed_pct,
        )
        return False

    # ---- 30 fps Animation, Reel Physics, Tension Arm Spring & Ballistic VU Loop ----
    def _tick_30fps(self):
        dt = 0.033
        m = self.engine.mode
        p = self.engine.progress_fraction()

        # Impulse tension arm flex on transport transitions
        if m != self._last_mode:
            if m in ("PLAY", "REC"):
                self.tension_vel += 7.5
            elif m in ("FF", "RTZ"):
                self.tension_vel += 11.0
            elif m == "REW":
                self.tension_vel -= 11.0
            else:
                self.tension_vel -= 5.0
            self._last_mode = m
            self._sync_transport_buttons()

        # Spring-damper physics for mechanical tension arms
        steady = 0.32 if m in ("PLAY", "REC") else (0.58 if m in ("FF", "REW", "RTZ") else 0.0)
        force = -42.0 * (self.tension_pos - steady) - 7.5 * self.tension_vel
        self.tension_vel += force * dt
        self.tension_pos = max(-1.0, min(1.0, self.tension_pos + self.tension_vel * dt))

        # Angular velocity inversely proportional to instantaneous reel pack radius!
        vari = max(0.80, min(1.20, 1.0 + self.engine.varispeed_pct / 100.0))
        if m in ("PLAY", "REC"):
            lin_v = 1.65 * vari
        elif m == "FF":
            lin_v = 1.65 * 6.0
        elif m == "REW":
            lin_v = -1.65 * 6.0
        elif m == "RTZ":
            lin_v = 1.65 * 6.0 * (1.0 if self.engine.rtz_target_sample >= self.engine.playhead else -1.0)
        else:
            lin_v = 0.0

        r_l_norm = math.sqrt(1.0 * (1.0 - p) + 0.22 * p)
        r_r_norm = math.sqrt(0.22 * (1.0 - p) + 1.0 * p)
        self.reel_angle_l = (self.reel_angle_l + (lin_v / r_l_norm) * dt) % (2.0 * math.pi)
        self.reel_angle_r = (self.reel_angle_r + (lin_v / r_r_norm) * dt) % (2.0 * math.pi)

        # Ballistic VU needles: fast 10ms-class attack, smooth 300ms damped release
        for attr_t, attr_n in (("vu_target_l", "vu_needle_l"), ("vu_target_r", "vu_needle_r")):
            tgt = getattr(self, attr_t)
            cur = getattr(self, attr_n)
            diff = tgt - cur
            cur += diff * (0.48 if diff > 0 else 0.16)
            setattr(self, attr_n, cur)
            setattr(self, attr_t, max(0.02, tgt * 0.92))

        # Update channel strip LED meters
        for idx, sw in enumerate(self.strip_widgets):
            fader_w: ChannelFaderMeter = sw["fader"]
            trk = self.engine.tracks[idx]
            if abs(fader_w.meter_db - trk.meter_db) > 0.3:
                fader_w.meter_db = trk.meter_db
                fader_w.queue_draw()

        # Update shuttle slider without triggering seek loop
        if not self._updating_seek:
            self._updating_seek = True
            self.seek_scale.set_value(p * 1000.0)
            self._updating_seek = False

        self.well_area.queue_draw()
        self.vu_area.queue_draw()
        self.counter_area.queue_draw()
        return True

    def _on_vu_telemetry(self, rms_l: float, rms_r: float, pk_l: float, pk_r: float):
        if self.engine.mode not in ("PLAY", "REC"):
            return
        self.vu_target_l = _vu_db_to_norm(rms_l + 3.0)
        self.vu_target_r = _vu_db_to_norm(rms_r + 3.0)
        now = time.monotonic()
        if pk_l > -1.2:
            self.peak_hold_l = now + 0.35
        if pk_r > -1.2:
            self.peak_hold_r = now + 0.35

