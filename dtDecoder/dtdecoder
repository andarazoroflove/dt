    def _on_test_tx_clicked(self, _b):
        if self.router.is_transmitting_test():
            self.router.stop_test_tx()
            return

        m = self.ctrl.mode
        if m == "CW":
            wpm_txt = self.cw_wpm_combo.get_active_text() or "20 WPM"
            wpm = float(wpm_txt.split()[0])
            msg = self.cw_msg_entry.get_text().strip() or "CQ CQ DE W1AW FN31 K"
            self.ctrl.cw.reset()
            self._append_tty_text(f"\n[CW TEST TX {wpm:.0f} WPM @ {self.ctrl.cw.pitch_hz:.0f} Hz]: ")
            pcm = synthesize_cw_audio(msg, wpm=wpm, pitch_hz=self.ctrl.cw.pitch_hz)
            self.router.start_test_tx(pcm, f"CW {wpm:.0f} WPM ({msg[:28]})")

        elif m == "RTTY":
            msg = self.rtty_msg_entry.get_text().strip() or "RYRY DE W1AW 73"
            if not msg.startswith("\r\n"):
                msg = "\r\n" + msg + "\r\n"
            self.ctrl.rtty.reset()
            self._append_tty_text(
                f"\n[RTTY TEST TX {self.ctrl.rtty.baud:g} Bd / {self.ctrl.rtty.shift_hz:.0f} Hz]: "
            )
            pcm = synthesize_rtty_audio(
                msg,
                baud=self.ctrl.rtty.baud,
                mark_hz=self.ctrl.rtty.mark_hz,
                shift_hz=self.ctrl.rtty.shift_hz,
                reverse=self.ctrl.rtty.reverse,
            )
            self.router.start_test_tx(pcm, f"RTTY {self.ctrl.rtty.baud:g} BAUD ITA2")

        elif m == "SAME":
            idx = max(0, self.same_preset_combo.get_active())
            plbl, hdr = SAME_TEST_PRESETS[min(idx, len(SAME_TEST_PRESETS) - 1)]
            self.ctrl.same.reset_stream()
            pcm = synthesize_same_audio(hdr, include_attn_and_eom=True, bursts=2)
            self.router.start_test_tx(pcm, f"SAME AFSK ({plbl})")

        elif m == "WEFAX":
            self.ctrl.wefax.reset()
            lpm = 960.0 if self._wefax_turbo else 120.0
            self.ctrl.wefax.lpm = lpm
            chart = self.ctrl.get_wefax_chart()
            pcm = synthesize_wefax_audio(chart, lpm=lpm, phasing_lines=3)
            self.router.start_test_tx(pcm, f"NMC PT REYES WEFAX ({lpm:.0f} LPM)")

        elif m == "SSTV":
            sub = self.ctrl.sstv.mode_name
            self.ctrl.sstv.reset()
            self.ctrl.sstv.mode_name = sub
            if sub == "MARTIN M1":
                card = self.ctrl.get_sstv_card(256)
                pcm = synthesize_sstv_martin_m1(card)
            else:
                card = self.ctrl.get_sstv_card(240)
                pcm = synthesize_sstv_robot36(card)
            self.router.start_test_tx(pcm, f"SSTV {sub} W1AW TEST CARD")

    # ---- Rotary Knob Callbacks ----
    def _on_knob_tone(self, val: float):
        if self._updating_knobs:
            return
        hz = 380.0 + val * 2220.0
        self.ctrl.set_tone_mark_hz(hz)

    def _on_knob_sq(self, val: float):
        self.ctrl.squelch = val

    def _on_knob_gain(self, val: float):
        self.router.input_gain = max(0.05, val * 2.0)

    def _on_knob_gate(self, val: float):
        self.ctrl.noise_gate = val * 0.5

    def _on_knob_slant(self, val: float):
        self.ctrl.set_slant_fine((val - 0.5) * 2.0)

    def _on_knob_vol(self, val: float):
        self.router.mon_volume = val

    # ---- Persistence ----
    def _load_state(self):
        if not STATE_FILE.is_file():
            return
        try:
            st = json.loads(STATE_FILE.read_text(encoding="utf-8"))
            mode = str(st.get("mode", "CW"))
            if mode in MODES:
                self.ctrl.set_mode(mode)
            self.ctrl.cw.set_pitch(float(st.get("cw_pitch_hz", 700.0)))
            self.ctrl.rtty.configure(
                baud=float(st.get("rtty_baud", 45.45)),
                mark_hz=float(st.get("rtty_mark_hz", 2125.0)),
                shift_hz=float(st.get("rtty_shift_hz", 170.0)),
            )
            self.knob_sq.set_value(float(st.get("squelch", 0.0)), notify=True)
            self.knob_gain.set_value(float(st.get("gain", 0.5)), notify=True)
            self.knob_gate.set_value(float(st.get("gate", 0.16)), notify=True)
            self.knob_vol.set_value(float(st.get("mon_vol", 0.55)), notify=True)
            self.router.mon_speaker = bool(st.get("mon_speaker", True))
        except Exception:
            pass

    def _save_state(self):
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            st = {
                "mode": self.ctrl.mode,
                "cw_pitch_hz": self.ctrl.cw.pitch_hz,
                "rtty_baud": self.ctrl.rtty.baud,
                "rtty_mark_hz": self.ctrl.rtty.mark_hz,
                "rtty_shift_hz": self.ctrl.rtty.shift_hz,
                "squelch": self.knob_sq.value,
                "gain": self.knob_gain.value,
                "gate": self.knob_gate.value,
                "mon_vol": self.knob_vol.value,
                "mon_speaker": self.router.mon_speaker,
            }
            STATE_FILE.write_text(json.dumps(st, indent=2), encoding="utf-8")
        except Exception:
            pass

    def _run_gui_self_test(self) -> bool:
        rc = verify_all_decoders_and_cairo()
        if rc == 0:
            print("DTDECODER_SELF_TEST_OK")
            sys.stdout.flush()
        self.destroy()
        if rc != 0:
            sys.exit(rc)
        return False

    def _on_destroy(self, _w):
        if not self._self_test:
            self._save_state()
        self.router.stop()
        if Gtk.main_level() > 0:
            Gtk.main_quit()


# ---------------------------------------------------------------------------
# End-to-End Automated Self-Test (All 5 DSP Modes + Cairo Instrument Surfaces)
# ---------------------------------------------------------------------------
def verify_all_decoders_and_cairo() -> int:
    ctrl = DecoderController()

    # 1. Verify CW / MORSE synthesis + adaptive decoder + peak snap
    ctrl.set_mode("CW")
    ctrl.cw.set_pitch(700.0)
    cw_pcm = synthesize_cw_audio("CQ DE W1AW K", wpm=22.0, pitch_hz=700.0)
    for idx in range(0, len(cw_pcm), 600):
        ctrl.ingest_samples(cw_pcm[idx: idx + 600])
    ctrl.step_waterfall()
    assert "CQ DE W1AW K" in ctrl.cw.decoded_text, f"CW mismatch: {ctrl.cw.decoded_text!r}"

    # 2. Verify RTTY (BAUDOT ITA2 + FIGS/LTRS + USOS) synthesis + ATC UART decoder
    ctrl.set_mode("RTTY")
    ctrl.rtty.reset()
    ctrl.rtty.configure(baud=45.45, mark_hz=2125.0, shift_hz=170.0, reverse=False, usos=True)
    rtty_pcm = synthesize_rtty_audio(
        "\r\nZCZC DE W1AW FN31 73\r\n", baud=45.45, mark_hz=2125.0, shift_hz=170.0
    )
    for idx in range(0, len(rtty_pcm), 600):
        ctrl.ingest_samples(rtty_pcm[idx: idx + 600])
    ctrl.step_waterfall()
    assert "W1AW" in ctrl.rtty.decoded_text and "73" in ctrl.rtty.decoded_text, (
        f"RTTY mismatch: {ctrl.rtty.decoded_text!r}"
    )

    # 3. Verify SAME / EAS 520.83 baud AFSK header + EOM decoder
    ctrl.set_mode("SAME")
    ctrl.same.reset_stream()
    test_hdr = "ZCZC-WXR-RWT-009003+0030-3311830-KBOX/NWS-"
    same_pcm = synthesize_same_audio(test_hdr, include_attn_and_eom=True, bursts=2)
    for idx in range(0, len(same_pcm), 600):
        ctrl.ingest_samples(same_pcm[idx: idx + 600])
    assert ctrl.same.last_alert is not None, "SAME failed to decode ZCZC header"
    assert ctrl.same.last_alert["org"] == "WXR", f"Unexpected SAME org: {ctrl.same.last_alert}"
    assert ctrl.same.last_alert["event"] == "RWT", f"Unexpected SAME event: {ctrl.same.last_alert}"
    assert "009003" in ctrl.same.last_alert["locations"], "Missing Hartford County FIPS 009003"
    assert ctrl.same.eom_received, "SAME failed to detect NNNN EOM"

    # 4. Verify HF WEFAX (IOC 576) FM synthesis + phasing auto-align + drum scanlines
    ctrl.set_mode("WEFAX")
    ctrl.wefax.reset()
    ctrl.wefax.lpm = 960.0
    chart_slice = ctrl.get_wefax_chart()[:24]
    wf_pcm = synthesize_wefax_audio(chart_slice, lpm=960.0, phasing_lines=3)
    for idx in range(0, len(wf_pcm), 600):
        ctrl.ingest_samples(wf_pcm[idx: idx + 600])
    assert ctrl.wefax.phasing_locked, "WEFAX failed to lock white-on-black phasing pulse"
    assert ctrl.wefax.lines_decoded >= 20, f"WEFAX decoded too few lines: {ctrl.wefax.lines_decoded}"
    contrast = int(np.max(ctrl.wefax.canvas[:20])) - int(np.min(ctrl.wefax.canvas[:20]))
    assert contrast > 140, f"WEFAX scanline contrast too low: {contrast}"

    # 5. Verify SSTV (Robot 36 VIS 0x08 + color YCrCb scanlines)
    ctrl.set_mode("SSTV")
    ctrl.sstv.reset()
    card = ctrl.get_sstv_card(240)
    sstv_pcm = synthesize_sstv_robot36(card, max_lines=16)
    for idx in range(0, len(sstv_pcm), 600):
        ctrl.ingest_samples(sstv_pcm[idx: idx + 600])
    assert ctrl.sstv.vis_code == 0x08, f"SSTV VIS mismatch: {ctrl.sstv.vis_code}"
    assert ctrl.sstv.mode_name == "ROBOT 36", f"SSTV mode mismatch: {ctrl.sstv.mode_name}"
    assert ctrl.sstv.lines_decoded >= 14, f"SSTV decoded too few lines: {ctrl.sstv.lines_decoded}"
    rgb_span = int(np.max(ctrl.sstv.frame_rgb[:14])) - int(np.min(ctrl.sstv.frame_rgb[:14]))
    assert rgb_span > 140, f"SSTV color contrast too low: {rgb_span}"

    # 6. Verify Cairo UI rendering across all modes & custom canvases
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1100, 300)
    cr = cairo.Context(surf)
    for m in MODES:
        ctrl.set_mode(m)
        ctrl.step_waterfall()
        ctrl.draw_top_deck(cr, 1100.0, 180.0)
        ctrl.draw_telemetry_card(cr, 268.0, 220.0)
    ctrl.draw_tty_sprockets(cr, 18.0, 240.0)
    ctrl.draw_wefax_drum(cr, 800.0, 240.0)
    ctrl.draw_sstv_crt(cr, 800.0, 240.0)

    return 0


def main():
    self_test = "--self-test" in sys.argv[1:]
    gtk_ok, _ = Gtk.init_check(sys.argv)

    if self_test and not gtk_ok:
        rc = verify_all_decoders_and_cairo()
        if rc == 0:
            print("DTDECODER_SELF_TEST_OK")
            sys.stdout.flush()
        sys.exit(rc)

    if not gtk_ok:
        sys.stderr.write("dtDecoder: cannot open X11 display.\n")
        sys.exit(1)

    win = DtDecoderWindow(self_test=self_test)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
