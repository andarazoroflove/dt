# Spun-Aluminum Machined Rotary Knob Widget
# ---------------------------------------------------------------------------
class RotaryKnob(Gtk.DrawingArea):
    def __init__(
        self,
        label: str,
        init_val: float,
        default_val: float,
        on_change,
        fmt_fn=None,
        accent_rgb: tuple[float, float, float] = (1.0, 0.46, 0.18),
    ):
        super().__init__()
        self.label = label
        self.value = max(0.0, min(1.0, init_val))
        self.default_val = default_val
        self.on_change = on_change
        self.fmt_fn = fmt_fn
        self.accent_rgb = accent_rgb
        self._drag_y = None
        self._drag_start_val = self.value

        self.set_size_request(92, 72)
        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.SCROLL_MASK
        )
        self.connect("draw", self._on_draw)
        self.connect("button-press-event", self._on_press)
        self.connect("button-release-event", self._on_release)
        self.connect("motion-notify-event", self._on_motion)
        self.connect("scroll-event", self._on_scroll)

    def set_value(self, v: float, notify: bool = False):
        self.value = max(0.0, min(1.0, v))
        self.queue_draw()
        if notify and self.on_change:
            self.on_change(self.value)

    def _on_press(self, _w, ev):
        if ev.type == Gdk.EventType._2BUTTON_PRESS:
            self.set_value(self.default_val, notify=True)
            return True
        if ev.button == 1:
            self._drag_y = ev.y
            self._drag_start_val = self.value
            return True
        return False

    def _on_release(self, _w, _ev):
        self._drag_y = None
        return True

    def _on_motion(self, _w, ev):
        if self._drag_y is not None:
            dy = self._drag_y - ev.y
            self.set_value(self._drag_start_val + dy / 115.0, notify=True)
            return True
        return False

    def _on_scroll(self, _w, ev):
        step = 0.025
        if ev.direction == Gdk.ScrollDirection.UP:
            self.set_value(self.value + step, notify=True)
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            self.set_value(self.value - step, notify=True)
        elif ev.direction == Gdk.ScrollDirection.SMOOTH:
            _, _dx, dy = ev.get_scroll_deltas()
            self.set_value(self.value - dy * 0.02, notify=True)
        return True

    def _on_draw(self, w, cr: cairo.Context):
        alloc = w.get_allocation()
        cx = alloc.width * 0.5
        cy = 27.5
        r = 18.0

        a_start = math.radians(135.0)
        a_span = math.radians(270.0)
        for i in range(11):
            frac = i / 10.0
            ang = a_start + frac * a_span
            r0 = r + 2.8
            r1 = r + (6.0 if i in (0, 5, 10) else 4.4)
            cr.set_line_width(1.4 if i in (0, 5, 10) else 1.0)
            if frac <= self.value + 0.001:
                cr.set_source_rgb(0.34, 0.95, 0.82)
            else:
                cr.set_source_rgb(0.58, 0.63, 0.72)
            cr.move_to(cx + r0 * math.cos(ang), cy + r0 * math.sin(ang))
            cr.line_to(cx + r1 * math.cos(ang), cy + r1 * math.sin(ang))
            cr.stroke()

        # Drop shadow
        cr.arc(cx + 1.4, cy + 2.0, r + 1.0, 0, 2 * math.pi)
        cr.set_source_rgba(0.04, 0.05, 0.07, 0.78)
        cr.fill()

        # Knurled skirt
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.set_source_rgb(0.16, 0.18, 0.22)
        cr.fill()

        cr.set_line_width(1.0)
        cr.set_source_rgba(0.45, 0.50, 0.60, 0.55)
        for k in range(16):
            ka = k * (2.0 * math.pi / 16.0)
            cr.move_to(cx + (r - 2.3) * math.cos(ka), cy + (r - 2.3) * math.sin(ka))
            cr.line_to(cx + r * math.cos(ka), cy + r * math.sin(ka))
            cr.stroke()

        # Brushed spun-aluminum cap
        pat = cairo.LinearGradient(cx - r, cy - r, cx + r, cy + r)
        pat.add_color_stop_rgb(0.0, 0.85, 0.88, 0.93)
        pat.add_color_stop_rgb(0.5, 0.54, 0.58, 0.66)
        pat.add_color_stop_rgb(1.0, 0.28, 0.32, 0.38)
        cr.arc(cx, cy, r - 3.0, 0, 2 * math.pi)
        cr.set_source(pat)
        cr.fill()

        # Pointer indicator
        val_ang = a_start + self.value * a_span
        cr.set_line_width(2.3)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_source_rgb(*self.accent_rgb)
        cr.move_to(cx + 3.4 * math.cos(val_ang), cy + 3.4 * math.sin(val_ang))
        cr.line_to(cx + (r - 4.2) * math.cos(val_ang), cy + (r - 4.2) * math.sin(val_ang))
        cr.stroke()

        # Engraved label + glowing value readout
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.2)
        ext = cr.text_extents(self.label)
        cr.set_source_rgb(0.86, 0.90, 0.96)
        cr.move_to(cx - ext.width * 0.5, 58.5)
        cr.show_text(self.label)

        if self.fmt_fn:
            sub = self.fmt_fn(self.value)
            cr.set_font_size(7.9)
            ext2 = cr.text_extents(sub)
            cr.set_source_rgb(0.42, 0.96, 0.84)
            cr.move_to(cx - ext2.width * 0.5, 69.0)
            cr.show_text(sub)
        return False


# ---------------------------------------------------------------------------
# DSP Primitives: Resonant Quadrature Biquad & Complex Analytic FM Discriminator
# ---------------------------------------------------------------------------
class QuadratureBandpass:
    """2nd-order constant-0dB-peak IIR bandpass filter with exact 90-deg quadrature output."""

    def __init__(self, f0_hz: float, bw_hz: float, fs: float = DSP_RATE):
        self.fs = fs
        self.f0_hz = 0.0
        self.bw_hz = 0.0
        self.b0 = 0.0
        self.a1 = 0.0
        self.a2 = 0.0
        self.cos_w0 = 0.0
        self.inv_sin_w0 = 1.0
        self.x1 = 0.0
        self.x2 = 0.0
        self.y1 = 0.0
        self.y2 = 0.0
        self.configure(f0_hz, bw_hz)

    def configure(self, f0_hz: float, bw_hz: float):
        f0 = max(120.0, min(self.fs * 0.46, float(f0_hz)))
        bw = max(18.0, min(1600.0, float(bw_hz)))
        if abs(f0 - self.f0_hz) < 0.25 and abs(bw - self.bw_hz) < 0.25:
            return
        self.f0_hz = f0
        self.bw_hz = bw
        w0 = 2.0 * math.pi * f0 / self.fs
        q = max(0.7, f0 / bw)
        alpha = math.sin(w0) / (2.0 * q)
        inv_a0 = 1.0 / (1.0 + alpha)
        self.b0 = alpha * inv_a0
        self.a1 = (-2.0 * math.cos(w0)) * inv_a0
        self.a2 = (1.0 - alpha) * inv_a0
        self.cos_w0 = math.cos(w0)
        self.inv_sin_w0 = 1.0 / max(1e-4, math.sin(w0))

    def process(self, x: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
        """Return (in_phase, quadrature, envelope) arrays for block x."""
        n = len(x)
        if n == 0:
            z = np.zeros(0, dtype=np.float32)
            return z, z, z
        out_i = np.empty(n, dtype=np.float32)
        b0 = self.b0
        a1 = self.a1
        a2 = self.a2
        x1, x2, y1, y2 = self.x1, self.x2, self.y1, self.y2
        # Tight scalar IIR loop on 12 kHz blocks (600 samples = ~0.12 ms in Python)
        x_list = x.tolist()
        y_list = [0.0] * n
        for k in range(n):
            xk = x_list[k]
            yk = b0 * (xk - x2) - a1 * y1 - a2 * y2
            x2 = x1
            x1 = xk
            y2 = y1
            y1 = yk
            y_list[k] = yk
        prev_y0 = self.y1 if n == 0 else (self.y2 if n == 1 else 0.0)
        out_i[:] = y_list
        # Exact narrowband quadrature: q[n] = (cos(w0)*i[n] - i[n-1]) / sin(w0)
        i_prev = np.empty(n, dtype=np.float32)
        i_prev[0] = float(self.y1 if n == 0 else (y_list[0] * self.cos_w0))
        if n > 0:
            # Before loop self.y1 was y[-1]; capture cleanly:
            pass
        self.x1, self.x2, self.y1, self.y2 = x1, x2, y1, y2
        return out_i, out_i, out_i

    def process_iq(self, x: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
        n = len(x)
        if n == 0:
            z = np.zeros(0, dtype=np.float32)
            return z, z, z
        prev_last_y = self.y1
        b0, a1, a2 = self.b0, self.a1, self.a2
        x1, x2, y1, y2 = self.x1, self.x2, self.y1, self.y2
        x_list = x.tolist()
        y_list = [0.0] * n
        for k in range(n):
            xk = x_list[k]
            yk = b0 * (xk - x2) - a1 * y1 - a2 * y2
            x2 = x1
            x1 = xk
            y2 = y1
            y1 = yk
            y_list[k] = yk
        self.x1, self.x2, self.y1, self.y2 = x1, x2, y1, y2

        out_i = np.array(y_list, dtype=np.float32)
        i_prev = np.empty(n, dtype=np.float32)
        i_prev[0] = prev_last_y
        if n > 1:
            i_prev[1:] = out_i[:-1]
        out_q = ((self.cos_w0 * out_i - i_prev) * self.inv_sin_w0).astype(np.float32)
        env = np.hypot(out_i, out_q)
        return out_i, out_q, env


class AnalyticFmDiscriminator:
    """
    65-tap Hamming complex analytic bandpass FIR filter (950..2650 Hz) + instantaneous
    frequency discriminator for WEFAX (1500..2300 Hz) and SSTV (1100..2300 Hz).
    """

    def __init__(self, fs: float = DSP_RATE, smooth_taps: int = 7):
        self.fs = fs
        ntaps = 65
        half = ntaps // 2
        k = np.arange(ntaps, dtype=np.float64) - half
        # Lowpass prototype at +-850 Hz shifted to +1800 Hz -> analytic passband 950..2650 Hz
        fc = 850.0 / fs
        h_lp = 2.0 * fc * np.sinc(2.0 * fc * k) * np.hamming(ntaps)
        h_lp /= np.sum(h_lp)
        self.h_complex = (h_lp * np.exp(2j * np.pi * 1800.0 * k / fs)).astype(np.complex64)
        self.ntaps = ntaps
        self._hist = np.zeros(ntaps - 1, dtype=np.float32)
        self._prev_z = np.complex64(1.0 + 0.0j)
        self.smooth_taps = max(1, smooth_taps)
        self._f_hist = np.full(self.smooth_taps - 1, 1900.0, dtype=np.float32)

    def reset(self):
        self._hist.fill(0.0)
        self._prev_z = np.complex64(1.0 + 0.0j)
        self._f_hist.fill(1900.0)

    def process(self, x: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
        """Return (inst_freq_hz, inst_amp) for input float32 block x."""
        if len(x) == 0:
            z = np.zeros(0, dtype=np.float32)
            return z, z
        x_pad = np.concatenate((self._hist, x))
        self._hist[:] = x_pad[-(self.ntaps - 1):]
        z = np.convolve(x_pad, self.h_complex, mode="valid")
        amp = np.abs(z).astype(np.float32)

        z_prev = np.empty_like(z)
        z_prev[0] = self._prev_z
        if len(z) > 1:
            z_prev[1:] = z[:-1]
        self._prev_z = z[-1]

        dphi = np.angle(z * np.conj(z_prev))
        f_raw = (dphi * (self.fs / (2.0 * math.pi))).astype(np.float32)
        f_raw = np.clip(f_raw, 800.0, 2700.0)

        if self.smooth_taps > 1:
            f_pad = np.concatenate((self._f_hist, f_raw))
            self._f_hist[:] = f_pad[-(self.smooth_taps - 1):]
            kernel = np.ones(self.smooth_taps, dtype=np.float32) / float(self.smooth_taps)
            f_smooth = np.convolve(f_pad, kernel, mode="valid").astype(np.float32)
        else:
            f_smooth = f_raw
        return f_smooth, amp


# ---------------------------------------------------------------------------
# 1. CW / MORSE Decoder (Adaptive Dit/Dah & WPM Tracker)
# ---------------------------------------------------------------------------
class CwMorseDecoder:
    def __init__(self, fs: float = DSP_RATE):
        self.fs = fs
        self.pitch_hz = 700.0
        self.bp = QuadratureBandpass(self.pitch_hz, 110.0, fs)
        self.decim = 12  # 12000 / 12 = 1000 Hz envelope rate (1.0 ms resolution)
        self.env_rate = fs / self.decim
        self._rem = np.zeros(0, dtype=np.float32)
        self.reset()

    def reset(self):
        self._rem = np.zeros(0, dtype=np.float32)
        self.peak_env = 0.02
        self.floor_env = 0.001
        self.key_down = False
        self.state_dur = 0.0
        self.t_dit = 1.2 / 20.0  # 60 ms (20 WPM initial estimate)
        self.wpm = 20.0
        self.pulse_hist: collections.deque[float] = collections.deque(maxlen=18)
        self.char_pulses: list[float] = []
        self.current_pattern = ""
        self.space_sent = True
        self.decoded_text = ""
        self.last_env = 0.0
        self.last_thresh = 0.01
        self.sync_locked = False

    def set_pitch(self, hz: float):
        self.pitch_hz = max(350.0, min(2500.0, float(hz)))
        self.bp.configure(self.pitch_hz, 110.0)

    def _update_dit_estimate(self, dur: float):
        if dur < 0.018 or dur > 0.85:
            return
        self.pulse_hist.append(dur)
        if len(self.pulse_hist) >= 2:
            pmin = min(self.pulse_hist)
            pmax = max(self.pulse_hist)
            if pmax / max(1e-4, pmin) > 2.05:
                split = 0.52 * (pmin + pmax)
                dits = [p for p in self.pulse_hist if p < split]
                dahs = [p for p in self.pulse_hist if p >= split]
                est = float(np.median(dits)) if dits else (float(np.median(dahs)) / 3.0)
                self.t_dit = max(0.026, min(0.240, 0.35 * self.t_dit + 0.65 * est))
                self.wpm = 1.2 / self.t_dit
                return
        # Single-cluster fallback
        if dur < 1.85 * self.t_dit:
            self.t_dit = max(0.026, min(0.240, 0.80 * self.t_dit + 0.20 * dur))
        elif 2.0 * self.t_dit <= dur <= 5.0 * self.t_dit:
            self.t_dit = max(0.026, min(0.240, 0.82 * self.t_dit + 0.18 * (dur / 3.0)))
        self.wpm = 1.2 / self.t_dit

    def _flush_char(self) -> str:
        if not self.char_pulses:
            return ""
        thresh_dah = 2.0 * self.t_dit
        pat = "".join("." if p < thresh_dah else "-" for p in self.char_pulses)
        self.current_pattern = pat
        self.char_pulses.clear()
        ch = MORSE_TO_CHAR.get(pat, "")
        if not ch and len(pat) <= 6:
            ch = "·"
        return ch

    def process(self, x: np.ndarray, noise_gate: float = 0.05, squelch: float = 0.0) -> str:
        _, _, env = self.bp.process_iq(x)
        if len(self._rem) > 0:
            env = np.concatenate((self._rem, env))
        n_steps = len(env) // self.decim
        if n_steps == 0:
            self._rem = env
            return ""
        self._rem = env[n_steps * self.decim:]
        env_ds = env[: n_steps * self.decim].reshape(n_steps, self.decim).mean(axis=1)

        dt = 1.0 / self.env_rate
        min_gate = 0.004 + 0.08 * noise_gate + 0.10 * squelch
        emitted: list[str] = []

        for e_val in env_ds.tolist():
            if e_val > self.peak_env:
                self.peak_env = 0.65 * self.peak_env + 0.35 * e_val
            else:
                self.peak_env = max(0.006, 0.9985 * self.peak_env + 0.0015 * e_val)

            if e_val < self.floor_env:
                self.floor_env = 0.85 * self.floor_env + 0.15 * e_val
            else:
                self.floor_env = min(self.peak_env * 0.5, 0.9992 * self.floor_env + 0.0008 * e_val)

            span = max(0.0, self.peak_env - self.floor_env)
            th_hi = max(min_gate, self.floor_env + 0.44 * span)
            th_lo = max(min_gate * 0.78, self.floor_env + 0.30 * span)
            self.last_env = e_val
            self.last_thresh = th_hi

            want_down = (e_val >= th_hi) if not self.key_down else (e_val >= th_lo)
            if want_down == self.key_down:
                self.state_dur += dt
                if not self.key_down:
                    if self.char_pulses and self.state_dur >= 2.25 * self.t_dit:
                        ch = self._flush_char()
                        if ch:
                            emitted.append(ch)
                            self.space_sent = False
                    if not self.space_sent and self.state_dur >= 5.3 * self.t_dit:
                        emitted.append(" ")
                        self.space_sent = True
            else:
                if self.key_down:
                    # Tone just ended
                    if self.state_dur >= 0.016:
                        self._update_dit_estimate(self.state_dur)
                        self.char_pulses.append(self.state_dur)
                        thresh_dah = 2.0 * self.t_dit
                        self.current_pattern = "".join(
                            "." if p < thresh_dah else "-" for p in self.char_pulses
                        )
                        self.sync_locked = True
                self.key_down = want_down
                self.state_dur = dt

        if not self.key_down and self.state_dur > 1.5:
            self.sync_locked = False

        out = "".join(emitted)
        if out:
            self.decoded_text = (self.decoded_text + out)[-8000:]
        return out


# ---------------------------------------------------------------------------
# 2. RTTY (BAUDOT / ITA2) Decoder (45.45 / 50 / 75 Bd, 170 / 425 / 850 Hz)
# ---------------------------------------------------------------------------
class RttyBaudotDecoder:
    def __init__(self, fs: float = DSP_RATE):
        self.fs = fs
        self.baud = 45.45
        self.mark_hz = 2125.0
        self.shift_hz = 170.0
        self.reverse = False
        self.usos = True
        bw = max(52.0, self.baud * 1.25)
        self.bp_mark = QuadratureBandpass(self.mark_hz, bw, fs)
        self.bp_space = QuadratureBandpass(self.mark_hz + self.shift_hz, bw, fs)
        self.decim = 4  # 3000 Hz UART oversampling (~66x oversampling at 45.45 baud)
        self.uart_rate = fs / self.decim
        self.reset()

    def reset(self):
        self._rem_m = np.zeros(0, dtype=np.float32)
        self._rem_s = np.zeros(0, dtype=np.float32)
        self.uart_state = "WAIT_MARK"  # WAIT_MARK | IDLE | START | DATA | STOP
        self.timer = 0.0
        self.bit_idx = 0
        self.code_acc = 0
        self.last_bits = [0, 0, 0, 0, 0]
        self.figs_shift = False
        self.sync_locked = False
        self.mark_level = 0.0
        self.space_level = 0.0
        self.decoded_text = ""

    def configure(
        self,
        baud: float | None = None,
        mark_hz: float | None = None,
        shift_hz: float | None = None,
        reverse: bool | None = None,
        usos: bool | None = None,
    ):
        if baud is not None:
            self.baud = float(baud)
        if mark_hz is not None:
            self.mark_hz = max(400.0, min(2600.0, float(mark_hz)))
        if shift_hz is not None:
            self.shift_hz = float(shift_hz)
        if reverse is not None:
            self.reverse = bool(reverse)
        if usos is not None:
            self.usos = bool(usos)
        bw = max(52.0, min(self.shift_hz * 0.68, self.baud * 1.35))
        space_f = min(self.fs * 0.46, self.mark_hz + self.shift_hz)
        self.bp_mark.configure(self.mark_hz, bw)
        self.bp_space.configure(space_f, bw)

    def _decode_ita2(self, code: int) -> str:
        code &= 0x1F
        if code == 0x00:
            return ""
        if code == ITA2_CODE_LTRS:
            self.figs_shift = False
            return ""
        if code == ITA2_CODE_FIGS:
            self.figs_shift = True
            return ""
        if code == 0x04:  # SPACE
            if self.usos:
                self.figs_shift = False
            return " "
        ch = ITA2_FIGS[code] if self.figs_shift else ITA2_LTRS[code]
        if ch in ("\r", "\a"):
            return ""
        return ch

    def process(self, x: np.ndarray, noise_gate: float = 0.05, squelch: float = 0.0) -> str:
        _, _, env_m = self.bp_mark.process_iq(x)
        _, _, env_s = self.bp_space.process_iq(x)
        if len(self._rem_m) > 0:
            env_m = np.concatenate((self._rem_m, env_m))
            env_s = np.concatenate((self._rem_s, env_s))
        n_steps = len(env_m) // self.decim
        if n_steps == 0:
            self._rem_m = env_m
            self._rem_s = env_s
            return ""
        self._rem_m = env_m[n_steps * self.decim:]
        self._rem_s = env_s[n_steps * self.decim:]

        em = env_m[: n_steps * self.decim].reshape(n_steps, self.decim).mean(axis=1)
        es = env_s[: n_steps * self.decim].reshape(n_steps, self.decim).mean(axis=1)

        self.mark_level = float(np.mean(em))
        self.space_level = float(np.mean(es))

        tot = em + es
        disc = (em - es) / (tot + 1e-5)
        if self.reverse:
            disc = -disc

        min_carrier = 0.005 + 0.07 * noise_gate + 0.10 * squelch
        t_bit = self.uart_rate / self.baud
        emitted: list[str] = []

        for d_val, c_lvl in zip(disc.tolist(), tot.tolist()):
            if c_lvl < min_carrier:
                self.uart_state = "WAIT_MARK"
                self.sync_locked = False
                continue

            st = self.uart_state
            if st == "WAIT_MARK":
                if d_val > 0.18:
                    self.timer += 1.0
                    if self.timer >= 0.35 * t_bit:
                        self.uart_state = "IDLE"
                else:
                    self.timer = 0.0
            elif st == "IDLE":
                if d_val < -0.10:
                    self.uart_state = "START"
                    self.timer = 0.5 * t_bit
            elif st == "START":
                self.timer -= 1.0
                if self.timer <= 0.0:
                    if d_val < -0.05:
                        self.uart_state = "DATA"
                        self.bit_idx = 0
                        self.code_acc = 0
                        self.timer = t_bit
                    else:
                        self.uart_state = "IDLE"
            elif st == "DATA":
                self.timer -= 1.0
                if self.timer <= 0.0:
                    bit = 1 if d_val >= 0.0 else 0
                    self.code_acc |= (bit << self.bit_idx)
                    self.last_bits[self.bit_idx] = bit
                    self.bit_idx += 1
                    if self.bit_idx >= 5:
                        self.uart_state = "STOP"
                        self.timer = 0.85 * t_bit
                    else:
                        self.timer += t_bit
            elif st == "STOP":
                self.timer -= 1.0
                if self.timer <= 0.0:
                    if d_val > -0.12:
                        self.sync_locked = True
                        ch = self._decode_ita2(self.code_acc)
                        if ch:
                            emitted.append(ch)
                        self.uart_state = "IDLE"
                    else:
                        self.uart_state = "WAIT_MARK"
                        self.timer = 0.0

        out = "".join(emitted)
        if out:
            self.decoded_text = (self.decoded_text + out)[-8000:]
        return out


# ---------------------------------------------------------------------------
# 3. SAME / EAS (NOAA / FEMA) 520.83 Baud AFSK Decoder
# ---------------------------------------------------------------------------
class SameEasDecoder:
    """
    Decodes 520.8333 baud AFSK (Mark=2083.33 Hz, Space=1562.5 Hz) NOAA/FEMA SAME bursts:
      Preamble: 16x 0xAB (LSB-first) + "ZCZC-ORG-EEE-PSSCCC+TTTT-JJJHHMM-LLLLLLLL-"
      EOM:      16x 0xAB + "NNNN"
    """

    BAUD = 1000.0 / 1.92  # 520.833333... baud
    MARK_HZ = 2083.333333
    SPACE_HZ = 1562.5
    SYNC_ZCZC = 0x435A435AABAB  # [0xAB, 0xAB, 'Z', 'C', 'Z', 'C'] in 48-bit LSB-in shift reg
    SYNC_NNNN = 0x4E4E4E4EABAB  # [0xAB, 0xAB, 'N', 'N', 'N', 'N']

    def __init__(self, fs: float = DSP_RATE):
        self.fs = fs
        ntaps = 23  # 1 bit period @ 12,000 Hz = 23.04 samples -> exact orthogonal 3 vs 4 cycles
        k = np.arange(ntaps, dtype=np.float64)
        self.h_mark = (np.exp(-2j * np.pi * self.MARK_HZ * k / fs) / ntaps).astype(np.complex64)
        self.h_space = (np.exp(-2j * np.pi * self.SPACE_HZ * k / fs) / ntaps).astype(np.complex64)
        self.ntaps = ntaps
        self.alerts: list[dict] = []
        self.last_alert: dict | None = None
        self.alert_lamp_active = False
        self.eom_received = False
        self.reset_stream()

    def reset_stream(self):
        self._hist = np.zeros(self.ntaps - 1, dtype=np.float32)
        self.phase = 0.0
        self.prev_disc = 0.0
        self.sync_reg = 0
        self.rx_mode = "SEARCH"  # SEARCH | HEADER
        self.bit_cnt = 0
        self.byte_acc = 0
        self.header_chars: list[str] = []
        self.dash_after_plus = 0
        self.seen_plus = False
        self.sync_locked = False
        self._last_hdr_str = ""
        self._last_hdr_ts = 0.0

    def clear_alerts(self):
        self.alerts.clear()
        self.last_alert = None
        self.alert_lamp_active = False
        self.eom_received = False

    def _finalize_header(self) -> dict | None:
        raw = "ZCZC" + "".join(self.header_chars)
        self.rx_mode = "SEARCH"
        self.header_chars.clear()
        parsed = parse_same_header(raw)
        if not parsed["valid"]:
            return None
        now = time.monotonic()
        if raw == self._last_hdr_str and (now - self._last_hdr_ts) < 12.0 and self.last_alert is not None:
            self.last_alert["burst_count"] = self.last_alert.get("burst_count", 1) + 1
            self._last_hdr_ts = now
            return self.last_alert
        self._last_hdr_str = raw
        self._last_hdr_ts = now
        parsed["burst_count"] = 1
        parsed["rx_utc"] = datetime.datetime.now(datetime.timezone.utc).strftime("%H:%M:%S UTC")
        self.last_alert = parsed
        self.alerts.append(parsed)
        self.alert_lamp_active = True
        self.eom_received = False
        return parsed

    def process(self, x: np.ndarray, noise_gate: float = 0.05, squelch: float = 0.0) -> list[dict]:
        if len(x) == 0:
            return []
        x_pad = np.concatenate((self._hist, x))
        self._hist[:] = x_pad[-(self.ntaps - 1):]

        em = np.abs(np.convolve(x_pad, self.h_mark, mode="valid"))
        es = np.abs(np.convolve(x_pad, self.h_space, mode="valid"))
        tot = em + es
        disc = (em - es) / (tot + 1e-5)

        min_lvl = 0.004 + 0.05 * noise_gate + 0.08 * squelch
        step = self.BAUD / self.fs
        mask48 = (1 << 48) - 1
        new_alerts: list[dict] = []

        ph = self.phase
        p_disc = self.prev_disc
        for d_val, lvl in zip(disc.tolist(), tot.tolist()):
            if lvl < min_lvl:
                if self.rx_mode == "HEADER" and len(self.header_chars) >= 24:
                    al = self._finalize_header()
                    if al is not None:
                        new_alerts.append(al)
                self.rx_mode = "SEARCH"
                self.sync_locked = False
                p_disc = d_val
                continue

            # Zero-crossing Gardner/early-late bit-clock PLL
            if (p_disc < 0.0 <= d_val) or (p_disc >= 0.0 > d_val):
                err = ph if ph < 0.5 else (ph - 1.0)
                ph -= 0.22 * err
                if ph < 0.0:
                    ph += 1.0

            prev_ph = ph
            ph += step
            # Sample bit at eye center (phase crossing 0.5)
            if prev_ph < 0.5 <= ph:
                bit = 1 if d_val >= 0.0 else 0
                self.sync_reg = ((self.sync_reg >> 1) | (bit << 47)) & mask48

                if self.rx_mode == "SEARCH":
                    if self.sync_reg == self.SYNC_ZCZC:
                        self.rx_mode = "HEADER"
                        self.sync_locked = True
                        self.bit_cnt = 0
                        self.byte_acc = 0
                        self.header_chars = []
                        self.seen_plus = False
                        self.dash_after_plus = 0
                    elif self.sync_reg == self.SYNC_NNNN:
                        self.eom_received = True
                        self.sync_locked = True
                else:
                    self.byte_acc = (self.byte_acc >> 1) | (bit << 7)
                    self.bit_cnt += 1
                    if self.bit_cnt >= 8:
                        self.bit_cnt = 0
                        ch_code = self.byte_acc & 0x7F
                        if 32 <= ch_code <= 126:
                            ch = chr(ch_code)
                            self.header_chars.append(ch)
                            if ch == "+":
                                self.seen_plus = True
                                self.dash_after_plus = 0
                            elif ch == "-" and self.seen_plus:
                                self.dash_after_plus += 1
                                if self.dash_after_plus >= 3:
                                    al = self._finalize_header()
                                    if al is not None:
                                        new_alerts.append(al)
                            if len(self.header_chars) >= 240:
                                al = self._finalize_header()
                                if al is not None:
                                    new_alerts.append(al)
                        else:
                            al = self._finalize_header()
                            if al is not None:
                                new_alerts.append(al)

            if ph >= 1.0:
                ph -= 1.0
            p_disc = d_val

        self.phase = ph
        self.prev_disc = p_disc
        return new_alerts


