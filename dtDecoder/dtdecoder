# Built-In Authentic Signal Synthesizers (CW, RTTY, SAME, WEFAX Chart, SSTV Card)
# ---------------------------------------------------------------------------
def synthesize_cw_audio(
    text: str, wpm: float = 20.0, pitch_hz: float = 700.0, fs: float = DSP_RATE, amp: float = 0.72
) -> np.ndarray:
    t_dit = 1.2 / max(5.0, min(45.0, wpm))
    n_dit = max(24, int(round(t_dit * fs)))
    n_ramp = max(8, min(n_dit // 3, int(round(0.0045 * fs))))
    ramp_up = (np.sin(np.linspace(0.0, math.pi * 0.5, n_ramp, dtype=np.float32)) ** 2)
    ramp_dn = ramp_up[::-1]

    env_parts: list[np.ndarray] = [np.zeros(int(0.12 * fs), dtype=np.float32)]
    words = text.upper().strip().split(" ")
    for wi, word in enumerate(words):
        chars = [c for c in word if c in CHAR_TO_MORSE]
        for ci, ch in enumerate(chars):
            pat = CHAR_TO_MORSE[ch]
            for ei, sym in enumerate(pat):
                plen = n_dit if sym == "." else 3 * n_dit
                pulse = np.ones(plen, dtype=np.float32)
                pulse[:n_ramp] *= ramp_up
                pulse[-n_ramp:] *= ramp_dn
                env_parts.append(pulse)
                if ei + 1 < len(pat):
                    env_parts.append(np.zeros(n_dit, dtype=np.float32))
            if ci + 1 < len(chars):
                env_parts.append(np.zeros(3 * n_dit, dtype=np.float32))
        if wi + 1 < len(words):
            env_parts.append(np.zeros(7 * n_dit, dtype=np.float32))

    # Trailing silence so final character & word space flush cleanly
    env_parts.append(np.zeros(8 * n_dit, dtype=np.float32))
    env = np.concatenate(env_parts)
    t = np.arange(len(env), dtype=np.float64) / fs
    carrier = np.sin(2.0 * math.pi * pitch_hz * t).astype(np.float32)
    return (amp * env * carrier).astype(np.float32)


def encode_ita2_codes(text: str) -> list[int]:
    codes: list[int] = [ITA2_CODE_LTRS, ITA2_CODE_LTRS]
    figs = False
    for ch in text.upper():
        if ch == " ":
            codes.append(0x04)
            figs = False  # USOS friendly
        elif ch == "\r":
            codes.append(0x08)
        elif ch == "\n":
            codes.append(0x02)
        elif ch in CHAR_TO_ITA2_LTRS:
            if figs:
                codes.append(ITA2_CODE_LTRS)
                figs = False
            codes.append(CHAR_TO_ITA2_LTRS[ch])
        elif ch in CHAR_TO_ITA2_FIGS:
            if not figs:
                codes.append(ITA2_CODE_FIGS)
                figs = True
            codes.append(CHAR_TO_ITA2_FIGS[ch])
    return codes


def synthesize_rtty_audio(
    text: str,
    baud: float = 45.45,
    mark_hz: float = 2125.0,
    shift_hz: float = 170.0,
    reverse: bool = False,
    fs: float = DSP_RATE,
    amp: float = 0.70,
) -> np.ndarray:
    f_one = (mark_hz + shift_hz) if reverse else mark_hz
    f_zero = mark_hz if reverse else (mark_hz + shift_hz)
    codes = encode_ita2_codes(text)

    # Build timeline of (duration_seconds, freq_hz)
    t_bit = 1.0 / baud
    segs: list[tuple[float, float]] = [(0.28, f_one)]  # Mark lead-in carrier
    for code in codes:
        segs.append((t_bit, f_zero))  # Start bit (0 = Space)
        for b in range(5):
            bit = (code >> b) & 1
            segs.append((t_bit, f_one if bit else f_zero))
        segs.append((1.5 * t_bit, f_one))  # 1.5 Stop bits (1 = Mark)
    segs.append((0.22, f_one))

    total_samples = int(round(sum(d for d, _ in segs) * fs))
    freqs = np.empty(total_samples, dtype=np.float64)
    acc_t = 0.0
    prev_idx = 0
    for dur, f_hz in segs:
        acc_t += dur
        nxt_idx = min(total_samples, int(round(acc_t * fs)))
        freqs[prev_idx:nxt_idx] = f_hz
        prev_idx = nxt_idx
    if prev_idx < total_samples:
        freqs[prev_idx:] = f_one

    phase = np.cumsum(2.0 * math.pi * freqs / fs)
    return (amp * np.sin(phase)).astype(np.float32)


def synthesize_same_audio(
    header_str: str, include_attn_and_eom: bool = True, bursts: int = 2, fs: float = DSP_RATE, amp: float = 0.72
) -> np.ndarray:
    baud = SameEasDecoder.BAUD
    f_mark = SameEasDecoder.MARK_HZ
    f_space = SameEasDecoder.SPACE_HZ

    def afsk_bytes(raw_bytes: bytes) -> np.ndarray:
        bits: list[int] = []
        for b in raw_bytes:
            for i in range(8):
                bits.append((b >> i) & 1)
        total_n = int(round(len(bits) * fs / baud))
        freqs = np.empty(total_n, dtype=np.float64)
        for bi, bit in enumerate(bits):
            i0 = int(round(bi * fs / baud))
            i1 = min(total_n, int(round((bi + 1) * fs / baud)))
            freqs[i0:i1] = f_mark if bit else f_space
        ph = np.cumsum(2.0 * math.pi * freqs / fs)
        return (amp * np.sin(ph)).astype(np.float32)

    preamble = bytes([0xAB] * 16)
    hdr_payload = preamble + header_str.strip().encode("ascii", errors="ignore")
    eom_payload = preamble + b"NNNN"
    gap_short = np.zeros(int(0.28 * fs), dtype=np.float32)

    parts: list[np.ndarray] = [np.zeros(int(0.08 * fs), dtype=np.float32)]
    for b_idx in range(max(1, bursts)):
        parts.append(afsk_bytes(hdr_payload))
        if b_idx + 1 < bursts:
            parts.append(gap_short)

    if include_attn_and_eom:
        parts.append(gap_short)
        # Brief 0.65s dual-tone 853 + 960 Hz EAS/NWR attention signal
        t_att = np.arange(int(0.65 * fs), dtype=np.float64) / fs
        attn = (0.38 * (np.sin(2.0 * math.pi * 853.0 * t_att) + np.sin(2.0 * math.pi * 960.0 * t_att))).astype(
            np.float32
        )
        parts.append(attn)
        parts.append(gap_short)
        parts.append(afsk_bytes(eom_payload))

    parts.append(np.zeros(int(0.12 * fs), dtype=np.float32))
    return np.concatenate(parts)


