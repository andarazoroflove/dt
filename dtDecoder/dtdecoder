def format_same_location(pssccc: str) -> str:
    if len(pssccc) != 6 or not pssccc.isdigit():
        return pssccc
    sub = SAME_SUBDIV.get(pssccc[0], "")
    ss = pssccc[1:3]
    ccc = pssccc[3:6]
    st_ccc = pssccc[1:6]
    if st_ccc in FIPS_COUNTIES:
        return f"{sub}{FIPS_COUNTIES[st_ccc]} ({pssccc})"
    st = FIPS_STATES.get(ss, f"State {ss}")
    if ccc == "000":
        return f"All of {st} ({pssccc})"
    return f"{sub}County FIPS {ccc}, {st} ({pssccc})"


def parse_same_header(raw_header: str) -> dict:
    """Parse ZCZC-ORG-EEE-PSSCCC+TTTT-JJJHHMM-LLLLLLLL- into structured fields."""
    hdr = raw_header.strip()
    info = {
        "raw": hdr,
        "valid": False,
        "org": "---",
        "org_desc": "Unknown Originator",
        "event": "---",
        "event_desc": "Unknown Event",
        "severity": "ADVISORY",
        "locations": [],
        "location_names": [],
        "purge_hhmm": "0030",
        "purge_desc": "00h 30m",
        "jjjhhmm": "-------",
        "issued_desc": "UTC",
        "sender": "UNKNOWN",
        "summary": hdr,
    }
    if not hdr.startswith("ZCZC-"):
        return info

    body = hdr[5:].rstrip("-")
    if "+" not in body:
        return info
    left, right = body.split("+", 1)
    lparts = left.split("-")
    rparts = right.split("-")
    if len(lparts) < 3 or len(rparts) < 3:
        return info

    org = lparts[0][:3]
    ev = lparts[1][:3]
    locs = [p for p in lparts[2:] if p]
    tttt = rparts[0][:4]
    jjjhhmm = rparts[1][:7]
    sender = "-".join(rparts[2:])[:16].strip()

    org_desc = SAME_ORIGINATORS.get(org, f"Originator {org}")
    ev_desc, sev = SAME_EVENTS.get(ev, (f"EAS Event ({ev})", "ADVISORY"))
    loc_names = [format_same_location(c) for c in locs]

    if len(tttt) == 4 and tttt.isdigit():
        purge_desc = f"{int(tttt[:2]):02d}h {int(tttt[2:]):02d}m"
    else:
        purge_desc = tttt

    issued_desc = jjjhhmm
    if len(jjjhhmm) == 7 and jjjhhmm.isdigit():
        jday = max(1, min(366, int(jjjhhmm[:3])))
        hh = int(jjjhhmm[3:5])
        mm = int(jjjhhmm[5:7])
        yr = datetime.datetime.now(datetime.timezone.utc).year
        dt0 = datetime.datetime(yr, 1, 1, tzinfo=datetime.timezone.utc) + datetime.timedelta(
            days=jday - 1, hours=hh, minutes=mm
        )
        issued_desc = dt0.strftime("%b %d %H:%M UTC")

    loc_joined = "; ".join(loc_names[:4])
    if len(loc_names) > 4:
        loc_joined += f" (+{len(loc_names) - 4} more)"

    summary = (
        f"{ev_desc} issued by {org_desc} ({sender}) for {loc_joined}. "
        f"Effective {issued_desc}, valid {purge_desc}."
    )
    info.update({
        "valid": True,
        "org": org,
        "org_desc": org_desc,
        "event": ev,
        "event_desc": ev_desc,
        "severity": sev,
        "locations": locs,
        "location_names": loc_names,
        "purge_hhmm": tttt,
        "purge_desc": purge_desc,
        "jjjhhmm": jjjhhmm,
        "issued_desc": issued_desc,
        "sender": sender,
        "summary": summary,
    })
    return info


# ---------------------------------------------------------------------------
# Waterfall Color LUT (BGRA little-endian for Cairo FORMAT_ARGB32)
# ---------------------------------------------------------------------------
def _build_waterfall_lut() -> np.ndarray:
    lut = np.zeros((256, 4), dtype=np.uint8)
    stops = [
        (0.00, (8, 14, 24)),
        (0.24, (12, 42, 62)),
        (0.48, (22, 128, 118)),
        (0.70, (66, 232, 182)),
        (0.86, (245, 198, 66)),
        (1.00, (255, 250, 228)),
    ]
    for i in range(256):
        t = i / 255.0
        for k in range(len(stops) - 1):
            t0, c0 = stops[k]
            t1, c1 = stops[k + 1]
            if t <= t1 or k == len(stops) - 2:
                u = 0.0 if t1 <= t0 else max(0.0, min(1.0, (t - t0) / (t1 - t0)))
                r = int(c0[0] + u * (c1[0] - c0[0]))
                g = int(c0[1] + u * (c1[1] - c0[1]))
                b = int(c0[2] + u * (c1[2] - c0[2]))
                lut[i] = (b, g, r, 255)  # BGRA for little-endian Cairo ARGB32
                break
    return lut


WF_LUT_BGRA = _build_waterfall_lut()


