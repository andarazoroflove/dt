    # ---- Cairo Rendering: Alden Thermal Drum WEFAX Canvas ----
    def draw_wefax_drum(self, cr: cairo.Context, W: float, H: float):
        cr.rectangle(0, 0, W, H)
        cr.set_source_rgb(0.10, 0.12, 0.15)
        cr.fill()

        pad = 6.0
        dw = max(100.0, W - 2 * pad)
        dh = max(80.0, H - 2 * pad)

        # Convert grayscale canvas to BGRA for Cairo
        n_vis = max(220, min(self.wefax.MAX_LINES, max(260, self.wefax.line_idx + 24)))
        gray = self.wefax.canvas[:n_vis]
        # Warm thermal paper tint (#FFFDF7)
        bgra = np.empty((n_vis, self.wefax.WIDTH, 4), dtype=np.uint8)
        bgra[:, :, 0] = (gray.astype(np.uint16) * 244 // 255).astype(np.uint8)  # B
        bgra[:, :, 1] = (gray.astype(np.uint16) * 250 // 255).astype(np.uint8)  # G
        bgra[:, :, 2] = gray                                                    # R
        bgra[:, :, 3] = 255

        surf = cairo.ImageSurface.create_for_data(
            memoryview(bgra), cairo.FORMAT_ARGB32, self.wefax.WIDTH, n_vis, self.wefax.WIDTH * 4
        )
        cr.save()
        cr.translate(pad, pad)
        cr.scale(dw / float(self.wefax.WIDTH), dh / float(n_vis))
        cr.set_source_surface(surf, 0.0, 0.0)
        cr.get_source().set_filter(cairo.FILTER_BILINEAR)
        cr.paint()
        cr.restore()

        # Glowing thermal stylus line indicator at current drum row
        if 0 < self.wefax.line_idx < n_vis:
            sy = pad + (self.wefax.line_idx / float(n_vis)) * dh
            cr.set_source_rgba(0.98, 0.32, 0.18, 0.88)
            cr.set_line_width(2.0)
            cr.move_to(pad, sy)
            cr.line_to(pad + dw, sy)
            cr.stroke()

    # ---- Cairo Rendering: Slow-Scan TV Color Monitor ----
    def draw_sstv_crt(self, cr: cairo.Context, W: float, H: float):
        cr.rectangle(0, 0, W, H)
        cr.set_source_rgb(0.07, 0.08, 0.11)
        cr.fill()

        fh = self.sstv.active_height()
        fw = self.sstv.WIDTH
        aspect = fw / float(fh)
        avail_w = max(80.0, W - 16.0)
        avail_h = max(60.0, H - 16.0)
        if avail_w / avail_h > aspect:
            dh = avail_h
            dw = dh * aspect
        else:
            dw = avail_w
            dh = dw / aspect
        ox = (W - dw) * 0.5
        oy = (H - dh) * 0.5

        # Sunken studio monitor frame
        cr.rectangle(ox - 4, oy - 4, dw + 8, dh + 8)
        cr.set_source_rgb(0.03, 0.04, 0.06)
        cr.fill()

        rgb = self.sstv.frame_rgb[:fh]
        bgra = np.empty((fh, fw, 4), dtype=np.uint8)
        bgra[:, :, 0] = rgb[:, :, 2]
        bgra[:, :, 1] = rgb[:, :, 1]
        bgra[:, :, 2] = rgb[:, :, 0]
        bgra[:, :, 3] = 255

        surf = cairo.ImageSurface.create_for_data(memoryview(bgra), cairo.FORMAT_ARGB32, fw, fh, fw * 4)
        cr.save()
        cr.translate(ox, oy)
        cr.scale(dw / float(fw), dh / float(fh))
        cr.set_source_surface(surf, 0.0, 0.0)
        cr.get_source().set_filter(cairo.FILTER_BILINEAR)
        cr.paint()
        cr.restore()

        # Active horizontal electron scanline glow
        if self.sstv.rx_state == "ACTIVE_LINES" and 0 <= self.sstv.line_idx < fh:
            sy = oy + (self.sstv.line_idx / float(fh)) * dh
            cr.set_source_rgba(0.42, 1.0, 0.84, 0.85)
            cr.set_line_width(1.8)
            cr.move_to(ox, sy)
            cr.line_to(ox + dw, sy)
            cr.stroke()


