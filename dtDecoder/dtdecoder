    # ---- Interactive Waterfall Tuning ----
    def _tune_from_wf_x(self, ev_x: float):
        wf_x, wf_w = self._wf_geom
        if wf_w <= 10.0:
            return
        frac = max(0.0, min(1.0, (ev_x - wf_x) / wf_w))
        hz = WF_MIN_HZ + frac * (WF_MAX_HZ - WF_MIN_HZ)
        if self.ctrl.mode in ("CW", "RTTY"):
            self.ctrl.set_tone_mark_hz(hz)
            self._updating_knobs = True
            self.knob_tone.set_value((hz - 380.0) / 2220.0, notify=False)
            self._updating_knobs = False
            self.deck_area.queue_draw()

    def _on_deck_press(self, _w, ev):
        wf_x, wf_w = self._wf_geom
        if ev.button == 1 and wf_x <= ev.x <= wf_x + wf_w:
            self._wf_dragging = True
            self._tune_from_wf_x(ev.x)
            return True
        return False

    def _on_deck_release(self, _w, _ev):
        self._wf_dragging = False
        return False

    def _on_deck_motion(self, _w, ev):
        if self._wf_dragging:
            self._tune_from_wf_x(ev.x)
            return True
        return False

    def _on_deck_scroll(self, _w, ev):
        if self.ctrl.mode not in ("CW", "RTTY"):
            return False
        cur = self.ctrl.cw.pitch_hz if self.ctrl.mode == "CW" else self.ctrl.rtty.mark_hz
        step = 10.0
        if ev.direction == Gdk.ScrollDirection.UP:
            cur += step
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            cur -= step
        elif ev.direction == Gdk.ScrollDirection.SMOOTH:
            _, _dx, dy = ev.get_scroll_deltas()
            cur -= dy * step
        self.ctrl.set_tone_mark_hz(cur)
        self._sync_all_buttons()
        return True

