            # 5-Level Punched Paper Tape Graphic!
            tp_x, tp_y, tp_w, tp_h = 10.0, 116.0, max(80.0, W - 20.0), 46.0
            cr.rectangle(tp_x, tp_y, tp_w, tp_h)
