    def _append_tty_text(self, text: str):
        if not text:
            return
        end_it = self.tty_buf.get_end_iter()
        self.tty_buf.insert(end_it, text)
        # Keep buffer bounded cleanly
        if self.tty_buf.get_char_count() > 16000:
            s_it = self.tty_buf.get_start_iter()
            cut_it = self.tty_buf.get_iter_at_offset(2000)
            self.tty_buf.delete(s_it, cut_it)
        self.tty_view.scroll_mark_onscreen(self._tty_end_mark)

