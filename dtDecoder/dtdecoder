# 5. SSTV Color Decoder (VIS Auto-Detect + Robot 36 & Martin M1)
# ---------------------------------------------------------------------------
class SstvDecoder:
    WIDTH = 320
    MAX_H = 256

    def __init__(self, fs: float = DSP_RATE):
        self.fs = fs
        self.fm = AnalyticFmDiscriminator(fs, smooth_taps=5)
        self.mode_name = "ROBOT 36"  # "ROBOT 36" | "MARTIN M1"
        self.auto_vis = True
        self.slant_ppm = 0.0
        self.vis_code = -1
        self.frame_rgb = np.zeros((self.MAX_H, self.WIDTH, 3), dtype=np.uint8)
        self._y_even = np.full(self.WIDTH, 128.0, dtype=np.float32)
        self._cr_last = np.zeros(self.WIDTH, dtype=np.float32)
        self._cb_last = np.zeros(self.WIDTH, dtype=np.float32)
        self.reset()

    def reset(self):
        self.fm.reset()
        self._f_buf = np.zeros(0, dtype=np.float32)
        self.rx_state = "SEARCH_VIS"  # SEARCH_VIS | ACTIVE_LINES
        self.line_idx = 0
        self.lines_decoded = 0
        self.sync_locked = False
        self.vis_code = -1
        self._leader_ms = 0.0
        self._vis_stage = 0
        self._sync_Search_acc = 0
        self.frame_rgb.fill(18)
        self._cr_last.fill(0.0)
        self._cb_last.fill(0.0)

    def active_height(self) -> int:
        return 256 if self.mode_name == "MARTIN M1" else 240

    def samples_per_line(self) -> float:
        base = 0.446446 * self.fs if self.mode_name == "MARTIN M1" else 0.150 * self.fs
        return base * (1.0 + self.slant_ppm * 8e-4)

    def _decode_robot36_line(self, seg: np.ndarray):
        # Total 150.0 ms = 1800 samples @ 12 kHz:
        # 0..9ms sync, 9..12ms porch, 12..100ms Y, 100..104.5ms sep, 104.5..106ms porch, 106..150ms R-Y/B-Y
        n = len(seg)
        i_y0 = int(round(0.012 * n / 0.150))
        i_y1 = int(round(0.100 * n / 0.150))
        i_s0 = i_y1
        i_s1 = int(round(0.1045 * n / 0.150))
        i_c0 = int(round(0.106 * n / 0.150))
        i_c1 = n

        xg = np.linspace(0.0, 1.0, self.WIDTH, endpoint=False, dtype=np.float32)
        y_seg = np.clip((seg[i_y0:i_y1] - 1500.0) / 800.0, 0.0, 1.0) * 255.0
        c_seg = np.clip((seg[i_c0:i_c1] - 1500.0) / 800.0, 0.0, 1.0) * 255.0 - 128.0

        y_row = np.interp(xg, np.linspace(0.0, 1.0, max(2, len(y_seg)), endpoint=False), y_seg)
        c_row = np.interp(xg, np.linspace(0.0, 1.0, max(2, len(c_seg)), endpoint=False), c_seg)

        sep_freq = float(np.mean(seg[i_s0:max(i_s0 + 1, i_s1)]))
        is_even = (sep_freq < 1900.0) if (1350.0 <= sep_freq <= 2450.0) else ((self.line_idx % 2) == 0)
        if is_even:
            self._cr_last = c_row.astype(np.float32)
        else:
            self._cb_last = c_row.astype(np.float32)

        r = np.clip(y_row + 1.402 * self._cr_last, 0.0, 255.0).astype(np.uint8)
        g = np.clip(y_row - 0.34414 * self._cb_last - 0.71414 * self._cr_last, 0.0, 255.0).astype(np.uint8)
        b = np.clip(y_row + 1.772 * self._cb_last, 0.0, 255.0).astype(np.uint8)

        row = min(239, self.line_idx)
        self.frame_rgb[row, :, 0] = r
        self.frame_rgb[row, :, 1] = g
        self.frame_rgb[row, :, 2] = b

    def _decode_martin_m1_line(self, seg: np.ndarray):
        # 446.446 ms: 4.862ms sync, 0.572ms porch, 146.432ms G, 0.572ms sep, 146.432ms B, 0.572ms sep, 146.432ms R
        n = len(seg)
        tot_ms = 446.446
        def idx_ms(ms: float) -> int:
            return max(0, min(n, int(round(ms * n / tot_ms))))

        g0, g1 = idx_ms(5.434), idx_ms(151.866)
        b0, b1 = idx_ms(152.438), idx_ms(298.870)
        r0, r1 = idx_ms(299.442), idx_ms(445.874)
        xg = np.linspace(0.0, 1.0, self.WIDTH, endpoint=False, dtype=np.float32)

        def resamp(s: np.ndarray) -> np.ndarray:
            v = np.clip((s - 1500.0) / 800.0, 0.0, 1.0) * 255.0
            return np.interp(xg, np.linspace(0.0, 1.0, max(2, len(v)), endpoint=False), v).astype(np.uint8)

        row = min(255, self.line_idx)
        self.frame_rgb[row, :, 0] = resamp(seg[r0:r1])
        self.frame_rgb[row, :, 1] = resamp(seg[g0:g1])
        self.frame_rgb[row, :, 2] = resamp(seg[b0:b1])

    def _try_detect_vis_or_sync(self) -> bool:
        """Scan _f_buf for VIS header (leader + break + leader + 10*30ms VIS bits) or raw 1200 Hz sync."""
        bit_s = int(round(0.030 * self.fs))  # 360 samples
        vis_total = 10 * bit_s  # start + 8 bits + stop = 3600 samples
        lead_s = int(round(0.140 * self.fs))
        brk_s = int(round(0.010 * self.fs))

        # 1. Check for VIS header: ~140ms 1900Hz leader followed by 30ms 1200Hz VIS start bit
        need_vis = lead_s + vis_total + 60
        if self.auto_vis and len(self._f_buf) >= need_vis:
            # Coarse step scan every 30 samples (2.5 ms)
            buf = self._f_buf
            limit = len(buf) - vis_total - 10
            for pos in range(lead_s, limit, 24):
                # Check preceding 100 ms is ~1900 Hz leader and [pos : pos+bit_s] is ~1200 Hz start bit
                lead_mean = float(np.mean(buf[pos - int(0.09 * self.fs): pos - 12]))
                start_mean = float(np.mean(buf[pos + 36: pos + bit_s - 36]))
                stop_mean = float(np.mean(buf[pos + 9 * bit_s + 36: pos + 10 * bit_s - 36]))
                if 1820.0 <= lead_mean <= 1980.0 and 1130.0 <= start_mean <= 1270.0 and 1130.0 <= stop_mean <= 1270.0:
                    # Refine exact falling edge from 1900 Hz -> 1200 Hz around pos
                    win0 = max(0, pos - 48)
                    win1 = min(len(buf), pos + 48)
                    below = np.where(buf[win0:win1] < 1550.0)[0]
                    edge = (win0 + int(below[0])) if len(below) > 0 else pos

                    if edge + vis_total <= len(buf):
                        vis_byte = 0
                        for b in range(8):
                            c0 = edge + int((1.25 + b) * bit_s)
                            c1 = edge + int((1.75 + b) * bit_s)
                            bf = float(np.mean(buf[c0:c1]))
                            # VIS: 1100 Hz = 1, 1300 Hz = 0
                            if bf < 1205.0:
                                vis_byte |= (1 << b)
                        code7 = vis_byte & 0x7F
                        if code7 in (0x08, 0x2C):
                            self.vis_code = code7
                            self.mode_name = "ROBOT 36" if code7 == 0x08 else "MARTIN M1"
                            self._f_buf = buf[edge + vis_total:]
                            self.rx_state = "ACTIVE_LINES"
                            self.line_idx = 0
                            self.sync_locked = True
                            return True

        # 2. Fallback mid-transmission horizontal sync lock (only if no VIS header arrived after full window)
        spl = int(round(self.samples_per_line()))
        sync_len = int(round(0.009 * self.fs)) if self.mode_name == "ROBOT 36" else int(round(0.0048 * self.fs))
        fallback_min = max(need_vis + 2400, 2 * spl + 240) if self.auto_vis else (2 * spl + 240)
        if len(self._f_buf) >= fallback_min:
            buf = self._f_buf
            # Don't trigger fallback if a 1900 Hz VIS leader is currently in progress at tail of buffer
            tail_mean = float(np.mean(buf[-int(0.08 * self.fs):]))
            if not (self.auto_vis and 1830.0 <= tail_mean <= 1970.0):
                for pos in range(0, spl, 18):
                    m1 = float(np.mean(buf[pos: pos + sync_len]))
                    m2 = float(np.mean(buf[pos + spl: pos + spl + sync_len]))
                    after1 = float(np.mean(buf[pos + sync_len + 12: pos + sync_len + 80]))
                    if 1135.0 <= m1 <= 1265.0 and 1135.0 <= m2 <= 1265.0 and after1 > 1420.0:
                        self._f_buf = buf[pos:]
                        self.rx_state = "ACTIVE_LINES"
                        self.line_idx = 0
                        self.sync_locked = True
                        return True

            # Trim stale search buffer while preserving enough window for full VIS detection
            keep_n = max(need_vis + 1200, 2 * spl)
            if len(self._f_buf) > keep_n + 1200:
                self._f_buf = self._f_buf[-keep_n:]
        return False

    def process(self, x: np.ndarray, squelch: float = 0.0) -> int:
        f_inst, amp = self.fm.process(x)
        if len(f_inst) == 0:
            return 0
        if float(np.mean(amp)) < (0.004 + 0.06 * squelch):
            if self.rx_state == "ACTIVE_LINES" and self.line_idx >= self.active_height() - 2:
                self.rx_state = "SEARCH_VIS"
            self.sync_locked = False
            return 0

        self._f_buf = np.concatenate((self._f_buf, f_inst))
        if self.rx_state == "SEARCH_VIS":
            if not self._try_detect_vis_or_sync():
                return 0

        spl_f = self.samples_per_line()
        spl = int(round(spl_f))
        max_h = self.active_height()
        decoded_now = 0

        while self.rx_state == "ACTIVE_LINES" and len(self._f_buf) >= spl + 36:
            # Fine horizontal sync-edge tracking within +-24 samples so lines stay razor-aligned
            search_w = 24
            if len(self._f_buf) >= spl + search_w:
                win = self._f_buf[: 140]
                sync_pts = np.where((win >= 1110.0) & (win <= 1290.0))[0]
                if 0 < len(sync_pts) and int(sync_pts[0]) <= 20 and int(sync_pts[0]) > 2:
                    self._f_buf = self._f_buf[int(sync_pts[0]):]
                    if len(self._f_buf) < spl:
                        break

            seg = self._f_buf[:spl]
            self._f_buf = self._f_buf[spl:]

            if self.mode_name == "MARTIN M1":
                self._decode_martin_m1_line(seg)
            else:
                self._decode_robot36_line(seg)

            self.line_idx += 1
            self.lines_decoded += 1
            decoded_now += 1

            if self.line_idx >= max_h:
                self.rx_state = "SEARCH_VIS"
                self.sync_locked = False
                break

        return decoded_now


