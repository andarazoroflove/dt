def discover_pulse_sources() -> tuple[str | None, str | None]:
    """Discover default PulseAudio/PipeWire .monitor source (dtRadio output!) and mic via pactl."""
    monitor_src = None
    mic_src = None
    try:
        sink = subprocess.check_output(
            ["pactl", "get-default-sink"], text=True, stderr=subprocess.DEVNULL, timeout=1.2
        ).strip()
        if sink:
            monitor_src = f"{sink}.monitor"
    except Exception:
        pass

    try:
        src_out = subprocess.check_output(
            ["pactl", "list", "short", "sources"], text=True, stderr=subprocess.DEVNULL, timeout=1.2
        )
        monitors = []
        mics = []
        for ln in src_out.splitlines():
            parts = ln.split()
            if len(parts) >= 2:
                name = parts[1]
                if name.endswith(".monitor"):
                    monitors.append(name)
                else:
                    mics.append(name)
        if monitor_src and monitors and monitor_src not in monitors:
            monitor_src = monitors[0]
        elif not monitor_src and monitors:
            monitor_src = monitors[0]
        if mics:
            mic_src = mics[0]
    except Exception:
        pass

    try:
        def_src = subprocess.check_output(
            ["pactl", "get-default-source"], text=True, stderr=subprocess.DEVNULL, timeout=1.2
        ).strip()
        if def_src and not def_src.endswith(".monitor"):
            mic_src = def_src
    except Exception:
        pass

    return monitor_src, mic_src


def load_wav_mono_12k(path: Path) -> np.ndarray:
    """Load any PCM WAV file (8/16/24/32-bit, mono/stereo, arbitrary rate) into float32 @ 12000 Hz."""
    with wave.open(str(path), "rb") as wf:
        nch = wf.getnchannels()
        sw = wf.getsampwidth()
        sr = wf.getframerate()
        nframes = wf.getnframes()
        raw = wf.readframes(nframes)

    if sw == 1:
        x = (np.frombuffer(raw, dtype=np.uint8).astype(np.float32) - 128.0) / 128.0
    elif sw == 2:
        x = np.frombuffer(raw, dtype=np.int16).astype(np.float32) / 32768.0
    elif sw == 3:
        b = np.frombuffer(raw, dtype=np.uint8).reshape(-1, 3)
        signed = (
            b[:, 0].astype(np.int32)
            | (b[:, 1].astype(np.int32) << 8)
            | (b[:, 2].astype(np.int8).astype(np.int32) << 16)
        )
        x = signed.astype(np.float32) / 8388608.0
    elif sw == 4:
        x = np.frombuffer(raw, dtype=np.int32).astype(np.float32) / 2147483648.0
    else:
        raise ValueError(f"Unsupported WAV sample width: {sw} bytes")

    if nch > 1:
        x = x[: (len(x) // nch) * nch].reshape(-1, nch).mean(axis=1)

    if sr != DSP_RATE and len(x) > 1:
        out_len = max(1, int(round(len(x) * DSP_RATE / float(sr))))
        t_old = np.linspace(0.0, 1.0, len(x), endpoint=False, dtype=np.float64)
        t_new = np.linspace(0.0, 1.0, out_len, endpoint=False, dtype=np.float64)
        x = np.interp(t_new, t_old, x).astype(np.float32)
    return x.astype(np.float32)


class DecoderAudioRouter:
    """Routes live PulseAudio .monitor, Mic, WAV playback, or Test Signal TX into DSP queue & speaker."""

    def __init__(self, on_status_cb=None):
        self.on_status_cb = on_status_cb
        self.rx_queue: queue.Queue[tuple[str, np.ndarray]] = queue.Queue(maxsize=240)

        self.input_source = "monitor"  # "monitor" | "mic" | "wav" | "test"
        self.input_gain = 1.0
        self.mon_speaker = True
        self.mon_volume = 0.55

        self.monitor_dev, self.mic_dev = discover_pulse_sources()
        self.active_dev_label = "STANDBY"

        # Playback buffer state (used for WAV aircheck & built-in Test Signal Transmitter)
        self._pb_lock = threading.Lock()
        self._tx_buf: np.ndarray | None = None
        self._tx_pos = 0
        self._tx_label = ""
        self._wav_buf: np.ndarray | None = None
        self._wav_pos = 0
        self._wav_paused = False
        self.wav_name = ""

        self._cap_pipe = None
        self._out_pipe = None
        self._out_appsrc = None
        self._stop_evt = threading.Event()
        self._feeder_thread = None

    def _emit_status(self, msg: str):
        if self.on_status_cb:
            GLib.idle_add(self.on_status_cb, msg)

    def start(self, headless: bool = False):
        self._stop_evt.clear()
        if not headless:
            self.set_input_source(self.input_source)
            self._ensure_speaker_pipeline()
            self._feeder_thread = threading.Thread(target=self._feeder_loop, daemon=True)
            self._feeder_thread.start()

    def stop(self):
        self._stop_evt.set()
        if self._feeder_thread and self._feeder_thread.is_alive():
            self._feeder_thread.join(timeout=0.8)
        self._feeder_thread = None
        self._stop_capture_pipeline()
        self._stop_speaker_pipeline()

    def is_transmitting_test(self) -> bool:
        with self._pb_lock:
            return self._tx_buf is not None and self._tx_pos < len(self._tx_buf)

    def start_test_tx(self, samples: np.ndarray, label: str):
        with self._pb_lock:
            self._tx_buf = samples.astype(np.float32)
            self._tx_pos = 0
            self._tx_label = label
        self._emit_status(f"TX TEST SIGNAL: {label} ({len(samples)/DSP_RATE:.1f}s @ 12.0 kHz)")

    def stop_test_tx(self):
        with self._pb_lock:
            self._tx_buf = None
            self._tx_pos = 0
        self._emit_status(f"TX STOPPED — LISTENING ON {self.active_dev_label}")

    def load_wav_file(self, path: Path) -> bool:
        try:
            pcm = load_wav_mono_12k(path)
        except Exception as exc:
            self._emit_status(f"WAV LOAD ERROR: {exc}")
            return False
        with self._pb_lock:
            self._wav_buf = pcm
            self._wav_pos = 0
            self._wav_paused = False
            self.wav_name = path.name
        self.set_input_source("wav")
        self._emit_status(f"WAV AIRCHECK: {path.name} ({len(pcm)/DSP_RATE:.1f}s @ 12.0 kHz)")
        return True

    def toggle_wav_pause(self) -> bool:
        with self._pb_lock:
            self._wav_paused = not self._wav_paused
            return self._wav_paused

    def rewind_wav(self):
        with self._pb_lock:
            self._wav_pos = 0
            self._wav_paused = False

    def _stop_capture_pipeline(self):
        if self._cap_pipe is not None:
            try:
                self._cap_pipe.set_state(Gst.State.NULL)
            except Exception:
                pass
            self._cap_pipe = None

    def set_input_source(self, src_kind: str):
        self.input_source = src_kind
        self._stop_capture_pipeline()

        if src_kind == "test":
            self.active_dev_label = "BUILT-IN TEST LOOPBACK"
            self._emit_status("INPUT: BUILT-IN TEST SIGNAL LOOPBACK (12.0 kHz)")
            return
        if src_kind == "wav":
            lbl = f"WAV ({self.wav_name})" if self.wav_name else "WAV PLAYER"
            self.active_dev_label = lbl
            self._emit_status(f"INPUT: {lbl} @ 12.0 kHz")
            return

        self.monitor_dev, self.mic_dev = discover_pulse_sources()
        pipe = Gst.Pipeline.new("dtdecoder_capture")
        src = None
        dev_desc = "DEFAULT AUDIO"

        if src_kind == "monitor":
            if self.monitor_dev and Gst.ElementFactory.find("pulsesrc"):
                src = Gst.ElementFactory.make("pulsesrc", "cap_src")
                src.set_property("device", self.monitor_dev)
                dev_desc = self.monitor_dev
            elif Gst.ElementFactory.find("pulsesrc"):
                src = Gst.ElementFactory.make("pulsesrc", "cap_src")
                dev_desc = "pulsesrc (default)"
            else:
                src = Gst.ElementFactory.make("autoaudiosrc", "cap_src")
                dev_desc = "autoaudiosrc"
        else:
            if self.mic_dev and Gst.ElementFactory.find("pulsesrc"):
                src = Gst.ElementFactory.make("pulsesrc", "cap_src")
                src.set_property("device", self.mic_dev)
                dev_desc = self.mic_dev
            elif Gst.ElementFactory.find("pulsesrc"):
                src = Gst.ElementFactory.make("pulsesrc", "cap_src")
                dev_desc = "pulsesrc (mic)"
            else:
                src = Gst.ElementFactory.make("autoaudiosrc", "cap_src")
                dev_desc = "autoaudiosrc (mic)"

        q = Gst.ElementFactory.make("queue", None)
        q.set_property("max-size-buffers", 10)
        q.set_property("leaky", 2)
        conv = Gst.ElementFactory.make("audioconvert", None)
        res = Gst.ElementFactory.make("audioresample", None)
        capsf = Gst.ElementFactory.make("capsfilter", None)
        capsf.set_property(
            "caps",
            Gst.Caps.from_string(f"audio/x-raw,format=S16LE,layout=interleaved,rate={DSP_RATE},channels=1"),
        )
        appsink = Gst.ElementFactory.make("appsink", "cap_sink")
        appsink.set_property("emit-signals", True)
        appsink.set_property("sync", False)
        appsink.set_property("drop", True)
        appsink.set_property("max-buffers", 12)
        appsink.connect("new-sample", self._on_capture_sample)

        if not all((pipe, src, q, conv, res, capsf, appsink)):
            self.active_dev_label = "LOOPBACK STANDBY"
            self._emit_status("AUDIO CAPTURE UNAVAILABLE — TEST TRANSMITTER READY")
            return

        for el in (src, q, conv, res, capsf, appsink):
            pipe.add(el)
        src.link(q)
        q.link(conv)
        conv.link(res)
        res.link(capsf)
        capsf.link(appsink)

        bus = pipe.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", self._on_cap_error)

        ret = pipe.set_state(Gst.State.PLAYING)
        if ret == Gst.StateChangeReturn.FAILURE:
            pipe.set_state(Gst.State.NULL)
            self.active_dev_label = "LOOPBACK STANDBY"
            self._emit_status(f"CAPTURE STANDBY ({dev_desc}) — TEST TRANSMITTER READY")
        else:
            self._cap_pipe = pipe
            self.active_dev_label = dev_desc
            kind_lbl = "DESKTOP MONITOR (dtRadio)" if src_kind == "monitor" else "MIC / LINE-IN"
            self._emit_status(f"{kind_lbl}: {dev_desc} @ 12.0 kHz S16LE")

    def _on_cap_error(self, _bus, msg):
        err, _dbg = msg.parse_error()
        self._stop_capture_pipeline()
        self.active_dev_label = "LOOPBACK STANDBY"
        self._emit_status(f"CAPTURE STANDBY ({err.message[:38]}) — TEST TX READY")

    def _on_capture_sample(self, appsink):
        sample = appsink.emit("pull-sample")
        if not sample:
            return Gst.FlowReturn.OK
        # While Test Signal Transmitter is actively injecting a burst, mute external capture
        if self.is_transmitting_test() or self.input_source not in ("monitor", "mic"):
            return Gst.FlowReturn.OK
        buf = sample.get_buffer()
        ok, mapinfo = buf.map(Gst.MapFlags.READ)
        if ok:
            try:
                pcm = np.frombuffer(mapinfo.data, dtype=np.int16).astype(np.float32) * (1.0 / 32768.0)
                if len(pcm) > 0:
                    self._enqueue_chunk("ext", pcm)
                    # Only monitor Mic to speakers if enabled (never monitor .monitor to avoid feedback!)
                    if self.mon_speaker and self.input_source == "mic":
                        self._push_speaker(pcm)
            finally:
                buf.unmap(mapinfo)
        return Gst.FlowReturn.OK

    def _enqueue_chunk(self, origin: str, pcm: np.ndarray):
        scaled = np.clip(pcm * float(self.input_gain), -1.0, 1.0).astype(np.float32)
        try:
            self.rx_queue.put_nowait((origin, scaled))
        except queue.Full:
            try:
                self.rx_queue.get_nowait()
                self.rx_queue.put_nowait((origin, scaled))
            except Exception:
                pass

    def _ensure_speaker_pipeline(self):
        if self._out_pipe is not None:
            return
        pipe = Gst.Pipeline.new("dtdecoder_spk")
        appsrc = Gst.ElementFactory.make("appsrc", "spk_src")
        appsrc.set_property("is-live", True)
        appsrc.set_property("block", False)
        appsrc.set_property("format", Gst.Format.TIME)
        appsrc.set_property(
            "caps",
            Gst.Caps.from_string(f"audio/x-raw,format=S16LE,layout=interleaved,rate={DSP_RATE},channels=1"),
        )
        q = Gst.ElementFactory.make("queue", None)
        q.set_property("max-size-buffers", 8)
        q.set_property("leaky", 2)
        conv = Gst.ElementFactory.make("audioconvert", None)
        res = Gst.ElementFactory.make("audioresample", None)
        sink = Gst.ElementFactory.make("autoaudiosink", None)
        if sink:
            try:
                sink.set_property("sync", False)
            except Exception:
                pass
        if not all((pipe, appsrc, q, conv, res, sink)):
            return
        for el in (appsrc, q, conv, res, sink):
            pipe.add(el)
        appsrc.link(q)
        q.link(conv)
        conv.link(res)
        res.link(sink)
        if pipe.set_state(Gst.State.PLAYING) == Gst.StateChangeReturn.FAILURE:
            pipe.set_state(Gst.State.NULL)
        else:
            self._out_pipe = pipe
            self._out_appsrc = appsrc

    def _stop_speaker_pipeline(self):
        if self._out_pipe is not None:
            try:
                self._out_pipe.set_state(Gst.State.NULL)
            except Exception:
                pass
            self._out_pipe = None
            self._out_appsrc = None

    def _push_speaker(self, pcm: np.ndarray):
        if not self.mon_speaker or self._out_appsrc is None or self.mon_volume <= 0.01:
            return
        s16 = np.clip(pcm * (self.mon_volume * 30000.0), -32767.0, 32767.0).astype(np.int16)
        try:
            self._out_appsrc.emit("push-buffer", Gst.Buffer.new_wrapped(s16.tobytes()))
        except Exception:
            pass

    def _feeder_loop(self):
        """Real-time 25 Hz (480 samples = 40.0 ms) paced feeder for Test TX & WAV playback."""
        block_n = 480
        dt = block_n / float(DSP_RATE)
        next_t = time.monotonic()

        while not self._stop_evt.is_set():
            now = time.monotonic()
            if now < next_t:
                time.sleep(min(0.015, next_t - now))
                continue
            next_t = max(now, next_t + dt)

            chunk = None
            origin = "idle"
            tx_finished_msg = None

            with self._pb_lock:
                if self._tx_buf is not None:
                    end = min(len(self._tx_buf), self._tx_pos + block_n)
                    seg = self._tx_buf[self._tx_pos:end]
                    self._tx_pos = end
                    if len(seg) < block_n:
                        pad = np.zeros(block_n, dtype=np.float32)
                        pad[: len(seg)] = seg
                        chunk = pad
                    else:
                        chunk = seg.copy()
                    origin = "tx"
                    if self._tx_pos >= len(self._tx_buf):
                        self._tx_buf = None
                        self._tx_pos = 0
                        tx_finished_msg = f"TX COMPLETE — LISTENING ON {self.active_dev_label}"
                elif self.input_source == "wav" and self._wav_buf is not None and not self._wav_paused:
                    end = min(len(self._wav_buf), self._wav_pos + block_n)
                    seg = self._wav_buf[self._wav_pos:end]
                    self._wav_pos = end
                    if len(seg) > 0:
                        if len(seg) < block_n:
                            pad = np.zeros(block_n, dtype=np.float32)
                            pad[: len(seg)] = seg
                            chunk = pad
                        else:
                            chunk = seg.copy()
                        origin = "wav"
                    if self._wav_pos >= len(self._wav_buf):
                        self._wav_pos = 0
                        self._wav_paused = True
                        tx_finished_msg = f"WAV EOF ({self.wav_name}) — CLICK ▶ TO REPLAY"
                elif self.input_source == "test":
                    # Quiet receiver thermal noise floor (-58 dBFS) when idle in Loopback mode
                    chunk = np.random.normal(0.0, 0.0012, block_n).astype(np.float32)
                    origin = "noise"

            if chunk is not None:
                self._enqueue_chunk(origin, chunk)
                if origin in ("tx", "wav"):
                    self._push_speaker(chunk)

            if tx_finished_msg:
                self._emit_status(tx_finished_msg)


# ---------------------------------------------------------------------------
# Multi-Mode DSP Coordinator & Cairo Instrument Renderers
# ---------------------------------------------------------------------------
class DecoderController:
    def __init__(self):
        self.mode = "CW"  # CW | RTTY | SAME | WEFAX | SSTV
        self.squelch = 0.0
        self.noise_gate = 0.08
        self.slant_fine = 0.0  # -1.0 .. +1.0

        # Decoders
        self.cw = CwMorseDecoder(DSP_RATE)
        self.rtty = RttyBaudotDecoder(DSP_RATE)
        self.same = SameEasDecoder(DSP_RATE)
        self.wefax = WefaxDecoder(DSP_RATE)
        self.sstv = SstvDecoder(DSP_RATE)

        # Rolling FFT & Waterfall state
        self.fft_ring = np.zeros(FFT_SIZE, dtype=np.float32)
        self.fft_win = np.hanning(FFT_SIZE).astype(np.float32)
        self.wf_bgra = np.zeros((WF_H, WF_W, 4), dtype=np.uint8)
        self.wf_bgra[:, :] = WF_LUT_BGRA[0]
        self.spec_norm = np.zeros(WF_W, dtype=np.float32)
        self.fft_freqs = np.fft.rfftfreq(FFT_SIZE, 1.0 / DSP_RATE)
        self.wf_freq_grid = np.linspace(WF_MIN_HZ, WF_MAX_HZ, WF_W, dtype=np.float32)

        # HAL ST-6 Crossed-Ellipse X-Y Scope filters
        self.xy_mark_bp = QuadratureBandpass(2125.0, 85.0, DSP_RATE)
        self.xy_space_bp = QuadratureBandpass(2295.0, 85.0, DSP_RATE)
        self.xy_x = np.zeros(XY_TRACE_LEN, dtype=np.float32)
        self.xy_y = np.zeros(XY_TRACE_LEN, dtype=np.float32)
        self._update_xy_filters()

        # Telemetry & Ballistic S-Meter
        self.snr_db = 0.0
        self.rms_dbfs = -72.0
        self.target_s = 0.04
        self.needle_s = 0.04
        self.carrier_present = False
        self.mark_led = False
        self.space_led = False

        # Pre-built test images (lazy-cached)
        self._cached_wefax_chart: np.ndarray | None = None
        self._cached_sstv_240: np.ndarray | None = None
        self._cached_sstv_256: np.ndarray | None = None

    def get_wefax_chart(self) -> np.ndarray:
        if self._cached_wefax_chart is None:
            self._cached_wefax_chart = build_wefax_weather_chart(864, 360)
        return self._cached_wefax_chart

    def get_sstv_card(self, height: int = 240) -> np.ndarray:
        if height == 256:
            if self._cached_sstv_256 is None:
                self._cached_sstv_256 = build_sstv_test_card(320, 256, "W1AW", "FN31pr")
            return self._cached_sstv_256
        if self._cached_sstv_240 is None:
            self._cached_sstv_240 = build_sstv_test_card(320, 240, "W1AW", "FN31pr")
        return self._cached_sstv_240

    def active_mark_space_hz(self) -> tuple[float, float]:
        if self.mode == "CW":
            return self.cw.pitch_hz, min(2900.0, self.cw.pitch_hz + 170.0)
        if self.mode == "RTTY":
            m = self.rtty.mark_hz
            s = min(2950.0, m + self.rtty.shift_hz)
            return (s, m) if self.rtty.reverse else (m, s)
        if self.mode == "SAME":
            return SameEasDecoder.MARK_HZ, SameEasDecoder.SPACE_HZ
        # WEFAX & SSTV: White (2300 Hz) = X, Black (1500 Hz) = Y
        return 2300.0, 1500.0

    def _update_xy_filters(self):
        fm, fs_hz = self.active_mark_space_hz()
        bw = 72.0 if self.mode in ("CW", "RTTY") else 115.0
        self.xy_mark_bp.configure(fm, bw)
        self.xy_space_bp.configure(fs_hz, bw)

    def set_mode(self, mode: str):
        if mode in MODES:
            self.mode = mode
            self._update_xy_filters()

    def set_tone_mark_hz(self, hz: float):
        hz = max(380.0, min(2600.0, float(hz)))
        if self.mode == "CW":
            self.cw.set_pitch(hz)
        elif self.mode == "RTTY":
            self.rtty.configure(mark_hz=hz)
        self._update_xy_filters()

    def set_slant_fine(self, val_signed: float):
        """val_signed in [-1.0, +1.0]."""
        self.slant_fine = max(-1.0, min(1.0, float(val_signed)))
        self.wefax.slant_ppm = self.slant_fine
        self.sstv.slant_ppm = self.slant_fine

    def snap_cw_peak(self) -> float:
        """Find strongest spectral peak in 380..1400 Hz and snap CW pitch to it."""
        spec = np.abs(np.fft.rfft(self.fft_ring * self.fft_win))
        mask = (self.fft_freqs >= 380.0) & (self.fft_freqs <= 1400.0)
        idxs = np.where(mask)[0]
        if len(idxs) == 0:
            return self.cw.pitch_hz
        sub = spec[idxs]
        pk_local = int(np.argmax(sub))
        k = int(idxs[pk_local])
        # Parabolic bin interpolation
        if 1 <= k < len(spec) - 1:
            a, b, c = float(spec[k - 1]), float(spec[k]), float(spec[k + 1])
            denom = a - 2.0 * b + c
            delta = 0.5 * (a - c) / denom if abs(denom) > 1e-9 else 0.0
            delta = max(-0.5, min(0.5, delta))
        else:
            delta = 0.0
        hz = float((k + delta) * DSP_RATE / FFT_SIZE)
        self.cw.set_pitch(hz)
        self._update_xy_filters()
        return self.cw.pitch_hz

    def ingest_samples(self, x: np.ndarray) -> dict:
        """Feed mono 12 kHz float32 samples into spectrum, X-Y scope, and active mode decoder."""
        events = {"tty_text": "", "same_alerts": [], "wefax_rows": 0, "sstv_rows": 0}
        if len(x) == 0:
            return events

        # 1. Update rolling FFT ring
        n = len(x)
        if n >= FFT_SIZE:
            self.fft_ring[:] = x[-FFT_SIZE:]
        else:
            self.fft_ring[:-n] = self.fft_ring[n:]
            self.fft_ring[-n:] = x

        # 2. Update HAL ST-6 Crossed-Ellipse X-Y Scope buffers
        self._update_xy_filters()
        mi, mq, menv = self.xy_mark_bp.process_iq(x)
        si, sq, senv = self.xy_space_bp.process_iq(x)
        # Authentic ST-6 quadrature minor-axis coupling -> crisp 90-deg crossed ellipses!
        px = mi + 0.14 * sq
        py = si + 0.14 * mq
        pk = max(0.035, float(np.max(np.hypot(px, py))))
        px_n = np.clip(px / pk, -1.15, 1.15)
        py_n = np.clip(py / pk, -1.15, 1.15)
        if len(px_n) >= XY_TRACE_LEN:
            self.xy_x[:] = px_n[-XY_TRACE_LEN:]
            self.xy_y[:] = py_n[-XY_TRACE_LEN:]
        else:
            k = len(px_n)
            self.xy_x[:-k] = self.xy_x[k:]
            self.xy_x[-k:] = px_n
            self.xy_y[:-k] = self.xy_y[k:]
            self.xy_y[-k:] = py_n

        m_mean = float(np.mean(menv))
        s_mean = float(np.mean(senv))
        self.mark_led = m_mean > 0.018 and m_mean >= s_mean * 0.65
        self.space_led = s_mean > 0.018 and s_mean >= m_mean * 0.65

        # 3. Level & S-meter update
        rms = float(np.sqrt(np.mean(x * x) + 1e-12))
        self.rms_dbfs = 20.0 * math.log10(max(1e-5, rms))
        self.target_s = max(0.03, min(1.0, (self.rms_dbfs + 66.0) / 62.0))
        self.carrier_present = self.target_s > max(0.07, self.squelch * 0.85)

        # 4. Active mode demodulation
        if self.mode == "CW":
            events["tty_text"] = self.cw.process(x, self.noise_gate, self.squelch)
        elif self.mode == "RTTY":
            events["tty_text"] = self.rtty.process(x, self.noise_gate, self.squelch)
        elif self.mode == "SAME":
            events["same_alerts"] = self.same.process(x, self.noise_gate, self.squelch)
        elif self.mode == "WEFAX":
            events["wefax_rows"] = self.wefax.process(x, self.squelch)
        elif self.mode == "SSTV":
            events["sstv_rows"] = self.sstv.process(x, self.squelch)

        return events

    def step_waterfall(self):
        """Compute 2048-pt Hanning FFT, update SNR dB, and scroll waterfall 1 scanline."""
        mag = np.abs(np.fft.rfft(self.fft_ring * self.fft_win)) / (FFT_SIZE * 0.25)
        db = 20.0 * np.log10(np.maximum(mag, 1e-6))

        # Estimate in-band SNR vs median noise floor across 250..2900 Hz
        band_mask = (self.fft_freqs >= 250.0) & (self.fft_freqs <= 2900.0)
        band_db = db[band_mask]
        floor_db = float(np.percentile(band_db, 25))
        peak_db = float(np.max(band_db))
        self.snr_db = max(0.0, min(55.0, peak_db - floor_db))

        # Interpolate onto 200..3000 Hz waterfall width
        wf_db = np.interp(self.wf_freq_grid, self.fft_freqs, db)
        norm = np.clip((wf_db - (floor_db - 3.0)) / 46.0, 0.0, 1.0)
        self.spec_norm = 0.45 * self.spec_norm + 0.55 * norm.astype(np.float32)

        idx = np.clip((self.spec_norm * 255.0).astype(np.int32), 0, 255)
        self.wf_bgra[1:] = self.wf_bgra[:-1]
        self.wf_bgra[0] = WF_LUT_BGRA[idx]

        # Ballistic S-meter needle smoothing
        alpha = 0.34 if self.target_s > self.needle_s else 0.12
        self.needle_s += alpha * (self.target_s - self.needle_s)

    def is_sync_locked(self) -> bool:
        if self.mode == "CW":
            return self.cw.sync_locked
        if self.mode == "RTTY":
            return self.rtty.sync_locked
        if self.mode == "SAME":
            return self.same.sync_locked or self.same.alert_lamp_active
        if self.mode == "WEFAX":
            return self.wefax.sync_locked
        if self.mode == "SSTV":
            return self.sstv.sync_locked
        return False

    # ---- Cairo Rendering: Top Instrument Deck ----
    def draw_top_deck(self, cr: cairo.Context, W: float, H: float) -> tuple[float, float]:
        """
        Render Top Instrument Deck:
          [A] Warm Backlit Analog Signal/SNR Meter
          [B] 200-3000 Hz FFT Spectrum + Scrolling Phosphor Waterfall + Passband Cursors
          [C] HAL ST-6 Crossed-Ellipse X-Y Mark/Space Tuning Scope
          [D] Glowing Cyan-Green VFD Telemetry + Hardware LEDs
        Returns (wf_x, wf_w) for interactive waterfall mouse click/drag tuning.
        """
        cr.rectangle(0, 0, W, H)
        cr.set_source_rgb(0.11, 0.13, 0.16)
        cr.fill()

        pad = 6.0
        ih = H - 2.0 * pad
        sm_w = max(188.0, min(216.0, W * 0.185))
        xy_w = max(164.0, min(186.0, ih + 8.0))
        vfd_w = max(232.0, min(268.0, W * 0.235))
        wf_x = pad + sm_w + 6.0
        wf_w = max(260.0, W - wf_x - xy_w - vfd_w - pad - 12.0)
        xy_x0 = wf_x + wf_w + 6.0
        vfd_x = xy_x0 + xy_w + 6.0

        # ---- [A] Warm Backlit Analog Signal / SNR Meter ----
        sx, sy, sw, sh = pad, pad, sm_w, ih
        cr.rectangle(sx, sy, sw, sh)
        cr.set_source_rgb(0.06, 0.07, 0.09)
        cr.fill()

        mx, my, mw, mh = sx + 5, sy + 5, sw - 10, sh - 10
        glow = cairo.RadialGradient(mx + mw * 0.5, my + mh * 0.95, 6.0, mx + mw * 0.5, my + mh * 0.62, mw * 0.85)
        glow.add_color_stop_rgb(0.0, 1.00, 0.94, 0.74)
        glow.add_color_stop_rgb(0.65, 0.97, 0.85, 0.55)
        glow.add_color_stop_rgb(1.0, 0.83, 0.68, 0.37)
        cr.rectangle(mx, my, mw, mh)
        cr.set_source(glow)
        cr.fill()

        piv_x = mx + mw * 0.5
        piv_y = my + mh + 22.0
        arc_r = min(mw * 0.60, mh * 0.95)
        a0 = math.radians(-128.0)
        a1 = math.radians(-52.0)
        a_s9 = a0 + 0.58 * (a1 - a0)

        cr.set_line_width(2.1)
        cr.set_source_rgb(0.14, 0.12, 0.10)
        cr.arc(piv_x, piv_y, arc_r, a0, a_s9)
        cr.stroke()

        cr.set_line_width(3.0)
        cr.set_source_rgb(0.78, 0.14, 0.12)
        cr.arc(piv_x, piv_y, arc_r, a_s9, a1)
        cr.stroke()

        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.6)
        for frac, lbl, is_red in [
            (0.00, "1", False), (0.19, "3", False), (0.38, "6", False),
            (0.58, "9", False), (0.79, "+20", True), (1.00, "+40", True),
        ]:
            ang = a0 + frac * (a1 - a0)
            cr.set_source_rgb(0.78, 0.14, 0.12) if is_red else cr.set_source_rgb(0.14, 0.12, 0.10)
            cr.set_line_width(1.5)
            cr.move_to(piv_x + (arc_r - 4) * math.cos(ang), piv_y + (arc_r - 4) * math.sin(ang))
            cr.line_to(piv_x + (arc_r + 5) * math.cos(ang), piv_y + (arc_r + 5) * math.sin(ang))
            cr.stroke()
            tx = piv_x + (arc_r + 14) * math.cos(ang)
            ty = piv_y + (arc_r + 14) * math.sin(ang)
            ext = cr.text_extents(lbl)
            cr.move_to(tx - ext.width * 0.5, ty + ext.height * 0.4)
            cr.show_text(lbl)

        cr.set_font_size(8.5)
        cr.set_source_rgb(0.24, 0.19, 0.12)
        cr.move_to(mx + 6, my + 13)
        cr.show_text("SIGNAL / SNR")
        snr_txt = f"{self.snr_db:4.1f} dB"
        ext_s = cr.text_extents(snr_txt)
        cr.move_to(mx + mw - ext_s.width - 6, my + 13)
        cr.show_text(snr_txt)

        if self.squelch > 0.03 and not self.carrier_present:
            cr.set_source_rgb(0.78, 0.18, 0.12)
            cr.move_to(mx + 6, my + mh - 6)
            cr.show_text("SQL MUTED")

        cr.save()
        cr.rectangle(mx, my, mw, mh)
        cr.clip()
        n_ang = a0 + max(0.0, min(1.0, self.needle_s)) * (a1 - a0)
        cr.set_line_width(2.0)
        cr.set_source_rgba(0.1, 0.08, 0.05, 0.32)
        cr.move_to(piv_x + 1.8, piv_y + 1.8)
        cr.line_to(piv_x + 1.8 + (arc_r + 8) * math.cos(n_ang), piv_y + 1.8 + (arc_r + 8) * math.sin(n_ang))
        cr.stroke()
        cr.set_source_rgb(0.78, 0.12, 0.10)
        cr.move_to(piv_x, piv_y)
        cr.line_to(piv_x + (arc_r + 8) * math.cos(n_ang), piv_y + (arc_r + 8) * math.sin(n_ang))
        cr.stroke()
        cr.arc(piv_x, piv_y, 16.0, 0, 2 * math.pi)
        cr.set_source_rgb(0.14, 0.15, 0.18)
        cr.fill()
        cr.restore()

        # ---- [B] 200-3000 Hz Spectrum + Phosphor Waterfall + Tuning Cursors ----
        cr.rectangle(wf_x, pad, wf_w, ih)
        cr.set_source_rgb(0.03, 0.05, 0.09)
        cr.fill()

        scale_h = 16.0
        sp_h = max(34.0, (ih - scale_h) * 0.28)
        wf_y0 = pad + scale_h + sp_h
        wf_dh = max(30.0, ih - scale_h - sp_h - 2.0)

        # Frequency ruler bar at top of waterfall
        cr.rectangle(wf_x, pad, wf_w, scale_h)
        cr.set_source_rgb(0.08, 0.11, 0.16)
        cr.fill()
        cr.set_font_size(7.8)
        for f_tick in range(400, 3000, 400):
            fx = wf_x + ((f_tick - WF_MIN_HZ) / (WF_MAX_HZ - WF_MIN_HZ)) * wf_w
            cr.set_source_rgba(0.35, 0.48, 0.62, 0.55)
            cr.set_line_width(1.0)
            cr.move_to(fx, pad + scale_h)
            cr.line_to(fx, pad + scale_h + sp_h)
            cr.stroke()
            cr.set_source_rgb(0.72, 0.84, 0.94)
            lbl = f"{f_tick}"
            ext = cr.text_extents(lbl)
            cr.move_to(fx - ext.width * 0.5, pad + 11.5)
            cr.show_text(lbl)

        # Live FFT spectrum curve
        sy0 = pad + scale_h
        cr.save()
        cr.rectangle(wf_x, sy0, wf_w, sp_h)
        cr.clip()
        cr.move_to(wf_x, sy0 + sp_h)
        step_k = max(1, WF_W // 220)
        for k in range(0, WF_W, step_k):
            px = wf_x + (k / float(WF_W - 1)) * wf_w
            py = sy0 + sp_h - (self.spec_norm[k] * (sp_h - 4.0)) - 1.0
            cr.line_to(px, py)
        cr.line_to(wf_x + wf_w, sy0 + sp_h)
        cr.close_path()
        grad_sp = cairo.LinearGradient(0, sy0, 0, sy0 + sp_h)
        grad_sp.add_color_stop_rgba(0.0, 0.28, 0.98, 0.78, 0.52)
        grad_sp.add_color_stop_rgba(1.0, 0.05, 0.25, 0.28, 0.08)
        cr.set_source(grad_sp)
        cr.fill_preserve()
        cr.set_source_rgb(0.42, 1.00, 0.84)
        cr.set_line_width(1.3)
        cr.stroke()
        cr.restore()

        # Blit scrolling waterfall ImageSurface
        wf_surf = cairo.ImageSurface.create_for_data(
            memoryview(self.wf_bgra), cairo.FORMAT_ARGB32, WF_W, WF_H, WF_W * 4
        )
        cr.save()
        cr.translate(wf_x, wf_y0)
        cr.scale(wf_w / float(WF_W), wf_dh / float(WF_H))
        cr.set_source_surface(wf_surf, 0.0, 0.0)
        cr.get_source().set_filter(cairo.FILTER_BILINEAR)
        cr.paint()
        cr.restore()

        # Passband / Tone Cursors overlaid on Spectrum + Waterfall
        def hz_to_x(hz: float) -> float:
            return wf_x + ((hz - WF_MIN_HZ) / (WF_MAX_HZ - WF_MIN_HZ)) * wf_w

        cr.save()
        cr.rectangle(wf_x, pad + scale_h, wf_w, ih - scale_h)
        cr.clip()
        y_top = pad + scale_h
        y_bot = pad + ih

        if self.mode == "CW":
            cx = hz_to_x(self.cw.pitch_hz)
            bw_px = (55.0 / (WF_MAX_HZ - WF_MIN_HZ)) * wf_w
            cr.rectangle(cx - bw_px, y_top, 2 * bw_px, y_bot - y_top)
            cr.set_source_rgba(1.0, 0.72, 0.18, 0.16)
            cr.fill()
            cr.set_source_rgba(1.0, 0.45, 0.22, 0.95)
            cr.set_line_width(1.8)
            cr.move_to(cx, y_top)
            cr.line_to(cx, y_bot)
            cr.stroke()
        elif self.mode in ("RTTY", "SAME"):
            fm, fs_hz = self.active_mark_space_hz()
            xm, xs = hz_to_x(fm), hz_to_x(fs_hz)
            x_lo, x_hi = min(xm, xs), max(xm, xs)
            cr.rectangle(x_lo - 4, y_top, (x_hi - x_lo) + 8, y_bot - y_top)
            cr.set_source_rgba(0.25, 0.92, 0.78, 0.12)
            cr.fill()
            # Mark cursor (warm amber-red) & Space cursor (cyan-green)
            for x_pos, col in ((xm, (1.0, 0.46, 0.22)), (xs, (0.36, 0.98, 0.86))):
                cr.set_source_rgb(*col)
                cr.set_line_width(1.8)
                cr.move_to(x_pos, y_top)
                cr.line_to(x_pos, y_bot)
                cr.stroke()
        else:
            # WEFAX (1500..2300 Hz) & SSTV (1200 sync + 1500..2300 video)
            x_blk = hz_to_x(1500.0)
            x_wht = hz_to_x(2300.0)
            cr.rectangle(x_blk, y_top, x_wht - x_blk, y_bot - y_top)
            cr.set_source_rgba(0.38, 0.92, 1.0, 0.12)
            cr.fill()
            for x_p, col in ((x_blk, (0.45, 0.82, 1.0)), (x_wht, (1.0, 0.86, 0.36))):
                cr.set_source_rgb(*col)
                cr.set_line_width(1.5)
                cr.move_to(x_p, y_top)
                cr.line_to(x_p, y_bot)
                cr.stroke()
            if self.mode == "SSTV":
                x_syn = hz_to_x(1200.0)
                cr.set_source_rgb(1.0, 0.38, 0.32)
                cr.set_line_width(1.5)
                cr.move_to(x_syn, y_top)
                cr.line_to(x_syn, y_bot)
                cr.stroke()
        cr.restore()

        # ---- [C] HAL ST-6 / Tektronix Crossed-Ellipse X-Y Tuning Scope ----
        cr.rectangle(xy_x0, pad, xy_w, ih)
        cr.set_source_rgb(0.03, 0.08, 0.05)
        cr.fill()

        scx = xy_x0 + xy_w * 0.5
        scy = pad + ih * 0.52
        sr = min(xy_w, ih) * 0.42

        # Radial CRT phosphor vignette
        p31 = cairo.RadialGradient(scx, scy, 4.0, scx, scy, sr * 1.15)
        p31.add_color_stop_rgb(0.0, 0.05, 0.17, 0.10)
        p31.add_color_stop_rgb(1.0, 0.02, 0.06, 0.04)
        cr.arc(scx, scy, sr, 0, 2 * math.pi)
        cr.set_source(p31)
        cr.fill()

        # Graticule ring + Mark (X) / Space (Y) crosshairs
        cr.set_line_width(1.0)
        cr.set_source_rgba(0.22, 0.62, 0.38, 0.65)
        cr.arc(scx, scy, sr, 0, 2 * math.pi)
        cr.stroke()
        cr.arc(scx, scy, sr * 0.5, 0, 2 * math.pi)
        cr.stroke()
        cr.move_to(scx - sr, scy)
        cr.line_to(scx + sr, scy)
        cr.move_to(scx, scy - sr)
        cr.line_to(scx, scy + sr)
        cr.stroke()

        cr.set_font_size(7.8)
        cr.set_source_rgb(0.52, 0.92, 0.68)
        cr.move_to(xy_x0 + 6, pad + 12)
        cr.show_text("X-Y MARK/SPACE")
        cr.move_to(scx + sr - 10, scy - 4)
        cr.show_text("M")
        cr.move_to(scx + 4, scy - sr + 10)
        cr.show_text("S")

        # Glowing P31 Green Phosphor X-Y Beam (halo + bright core)
        if self.carrier_present:
            cr.save()
            cr.arc(scx, scy, sr, 0, 2 * math.pi)
            cr.clip()
            pts_x = scx + self.xy_x * (sr * 0.88)
            pts_y = scy - self.xy_y * (sr * 0.88)

            for lw, rgba in ((3.4, (0.08, 0.90, 0.44, 0.28)), (1.4, (0.58, 1.00, 0.78, 0.90))):
                cr.set_line_width(lw)
                cr.set_source_rgba(*rgba)
                cr.move_to(float(pts_x[0]), float(pts_y[0]))
                for px_i, py_i in zip(pts_x[1::2].tolist(), pts_y[1::2].tolist()):
                    cr.line_to(px_i, py_i)
                cr.stroke()
            cr.restore()
        else:
            # Resting center phosphor spot
            cr.arc(scx, scy, 2.5, 0, 2 * math.pi)
            cr.set_source_rgba(0.45, 1.0, 0.72, 0.8)
            cr.fill()

        # ---- [D] Glowing VFD Telemetry Readout + Hardware LEDs ----
        cr.rectangle(vfd_x, pad, vfd_w, ih)
        cr.set_source_rgb(0.04, 0.09, 0.10)
        cr.fill()
        cr.rectangle(vfd_x + 2, pad + 2, vfd_w - 4, ih - 4)
        cr.set_source_rgb(0.05, 0.12, 0.13)
        cr.fill()

        # Mode header badge
        cr.set_font_size(12.5)
        cr.set_source_rgb(0.36, 0.99, 0.86)
        cr.move_to(vfd_x + 10, pad + 22)
        cr.show_text(MODE_TITLES.get(self.mode, self.mode))

        # Mode-specific primary frequency & rate telemetry
        if self.mode == "CW":
            f_str = f"PITCH  {self.cw.pitch_hz:6.1f} Hz"
            r_str = f"SPEED  {self.cw.wpm:5.1f} WPM"
        elif self.mode == "RTTY":
            fm, fs_hz = self.active_mark_space_hz()
            f_str = f"M/S {fm:4.0f}/{fs_hz:4.0f} Hz"
            r_str = f"BAUD   {self.rtty.baud:5.2f} BD"
        elif self.mode == "SAME":
            f_str = "AFSK 2083/1563Hz"
            r_str = "RATE   520.8 BD"
        elif self.mode == "WEFAX":
            f_str = "FM  1500-2300 Hz"
            r_str = f"DRUM  {self.wefax.lpm:5.0f} LPM"
        else:
            f_str = "SYNC 1200/1900Hz"
            r_str = f"SSTV  {self.sstv.mode_name}"

        cr.set_font_size(10.5)
        cr.set_source_rgb(0.68, 0.98, 0.92)
        cr.move_to(vfd_x + 10, pad + 45)
        cr.show_text(f_str)

        cr.set_source_rgb(1.00, 0.80, 0.34)
        cr.move_to(vfd_x + 10, pad + 66)
        cr.show_text(r_str)

        cr.set_font_size(9.5)
        cr.set_source_rgb(0.52, 0.92, 0.84)
        cr.move_to(vfd_x + 10, pad + 86)
        cr.show_text(f"SNR {self.snr_db:4.1f} dB  LVL {self.rms_dbfs:5.1f}")

        # Hardware LED Annunciators along bottom of VFD
        leds = [
            ("SYNC", self.is_sync_locked(), (0.22, 0.98, 0.56)),
            ("DCD", self.carrier_present, (0.28, 0.94, 0.84)),
            ("MARK", self.mark_led, (1.00, 0.62, 0.24)),
            ("SPCE", self.space_led, (0.36, 0.96, 0.88)),
            ("EAS", self.same.alert_lamp_active, (1.00, 0.24, 0.20)),
        ]
        led_y = pad + ih - 24.0
        cell_w = (vfd_w - 16.0) / len(leds)
        cr.set_font_size(7.6)
        for li, (lname, is_on, rgb_on) in enumerate(leds):
            lx = vfd_x + 8.0 + (li + 0.5) * cell_w
            if is_on:
                cr.arc(lx, led_y - 6, 6.2, 0, 2 * math.pi)
                cr.set_source_rgba(rgb_on[0], rgb_on[1], rgb_on[2], 0.32)
                cr.fill()
                cr.arc(lx, led_y - 6, 4.0, 0, 2 * math.pi)
                cr.set_source_rgb(*rgb_on)
                cr.fill()
            else:
                cr.arc(lx, led_y - 6, 4.0, 0, 2 * math.pi)
                cr.set_source_rgb(0.16, 0.22, 0.24)
                cr.fill()
            ext = cr.text_extents(lname)
            cr.set_source_rgb(0.82, 0.90, 0.92) if is_on else cr.set_source_rgb(0.46, 0.56, 0.58)
            cr.move_to(lx - ext.width * 0.5, led_y + 9)
            cr.show_text(lname)

        return wf_x, wf_w

    # ---- Cairo Rendering: Tractor-Feed Sprocket Strips ----
    def draw_tty_sprockets(self, cr: cairo.Context, W: float, H: float):
        cr.rectangle(0, 0, W, H)
        cr.set_source_rgb(0.965, 0.930, 0.865)
        cr.fill()
        # Subtle perforated tear line
        cr.set_source_rgba(0.62, 0.56, 0.46, 0.55)
        cr.set_line_width(1.0)
        cr.set_dash([3.0, 3.0])
        cr.move_to(W - 1.5, 0)
        cr.line_to(W - 1.5, H)
        cr.stroke()
        cr.set_dash([])
        # Sprocket holes every 18 px
        cx = W * 0.5
        for yy in range(10, int(H), 18):
            cr.arc(cx, yy, 3.6, 0, 2 * math.pi)
            cr.set_source_rgb(0.32, 0.30, 0.27)
            cr.fill()
            cr.arc(cx, yy, 3.6, 0, 2 * math.pi)
            cr.set_source_rgba(0.82, 0.77, 0.68, 0.8)
            cr.set_line_width(1.0)
            cr.stroke()

    # ---- Cairo Rendering: Right-Hand Mode Telemetry / EAS Alert Card ----
    def draw_telemetry_card(self, cr: cairo.Context, W: float, H: float):
        cr.rectangle(0, 0, W, H)
        cr.set_source_rgb(0.08, 0.10, 0.13)
        cr.fill()

        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)

        if self.mode == "CW":
            cr.set_font_size(10.0)
            cr.set_source_rgb(0.42, 0.98, 0.84)
            cr.move_to(10, 20)
            cr.show_text("CW MORSE TELEMETRY")

            cr.set_font_size(9.0)
            cr.set_source_rgb(0.86, 0.90, 0.95)
            cr.move_to(10, 44)
            cr.show_text(f"TRACKED WPM : {self.cw.wpm:5.1f} WPM")
            cr.move_to(10, 62)
            cr.show_text(f"DIT UNIT    : {self.cw.t_dit*1000.0:5.1f} ms")
            cr.move_to(10, 80)
            cr.show_text(f"DAH (3x)    : {self.cw.t_dit*3000.0:5.1f} ms")
            cr.move_to(10, 98)
            cr.show_text(f"TONE PITCH  : {self.cw.pitch_hz:5.1f} Hz")

            # Live Envelope vs Adaptive Threshold bar
            cr.move_to(10, 124)
            cr.set_source_rgb(1.0, 0.80, 0.36)
            cr.show_text("ENVELOPE / THRESHOLD")
            bx, by, bw, bh = 10.0, 132.0, max(60.0, W - 20.0), 18.0
            cr.rectangle(bx, by, bw, bh)
            cr.set_source_rgb(0.14, 0.18, 0.22)
            cr.fill()
            scale = max(0.05, self.cw.peak_env * 1.15)
            ew = min(bw, (self.cw.last_env / scale) * bw)
            cr.rectangle(bx, by, ew, bh)
            cr.set_source_rgb(0.28, 0.96, 0.68) if self.cw.key_down else cr.set_source_rgb(0.22, 0.56, 0.52)
            cr.fill()
            tx = bx + min(bw, (self.cw.last_thresh / scale) * bw)
            cr.set_source_rgb(1.0, 0.38, 0.24)
            cr.set_line_width(2.0)
            cr.move_to(tx, by - 2)
            cr.line_to(tx, by + bh + 2)
            cr.stroke()

            # Current Element Pattern Preview
            cr.set_font_size(9.0)
            cr.set_source_rgb(0.75, 0.84, 0.92)
            cr.move_to(10, 174)
            cr.show_text("ELEMENT BUFFER:")
            pat = self.cw.current_pattern or "---"
            preview_ch = MORSE_TO_CHAR.get(self.cw.current_pattern, "")
            cr.set_font_size(14.0)
            cr.set_source_rgb(0.42, 0.99, 0.86)
            cr.move_to(10, 198)
            cr.show_text(f"{pat}  {('→ ' + preview_ch) if preview_ch else ''}")

        elif self.mode == "RTTY":
            cr.set_font_size(10.0)
            cr.set_source_rgb(0.42, 0.98, 0.84)
            cr.move_to(10, 20)
            cr.show_text("ITA2 BAUDOT REGISTER")

            cr.set_font_size(9.0)
            cr.set_source_rgb(0.86, 0.90, 0.95)
            fm, fs_hz = self.active_mark_space_hz()
            cr.move_to(10, 44)
            cr.show_text(f"MARK / SPACE: {fm:.0f}/{fs_hz:.0f} Hz")
            cr.move_to(10, 62)
            cr.show_text(f"BAUD / SHIFT: {self.rtty.baud:.2f} / {self.rtty.shift_hz:.0f}Hz")
            cr.move_to(10, 80)
            shift_lbl = "FIGS (NUM/SYM)" if self.rtty.figs_shift else "LTRS (ALPHA)"
            cr.set_source_rgb(1.0, 0.78, 0.32) if self.rtty.figs_shift else cr.set_source_rgb(0.42, 0.98, 0.76)
