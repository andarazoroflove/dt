def _append_sstv_vis_header(segs: list[tuple[float, float]], vis_code7: int):
    # Standard SSTV VIS header: 300ms 1900, 10ms 1200, 300ms 1900, 30ms 1200 start, 8x30ms bits, 30ms 1200 stop
    segs.append((0.300, 1900.0))
    segs.append((0.010, 1200.0))
    segs.append((0.300, 1900.0))
    segs.append((0.030, 1200.0))
    ones = bin(vis_code7 & 0x7F).count("1")
    vis_byte = (vis_code7 & 0x7F) | ((ones & 1) << 7)  # Even parity
    for b in range(8):
        bit = (vis_byte >> b) & 1
        segs.append((0.030, 1100.0 if bit else 1300.0))
    segs.append((0.030, 1200.0))


def synthesize_sstv_robot36(
    rgb_u8: np.ndarray, max_lines: int | None = None, fs: float = DSP_RATE, amp: float = 0.72
) -> np.ndarray:
    """Synthesize VIS 0x08 + Robot 36 color scanlines (150.0 ms / 1800 samples exact per line @ 12 kHz)."""
    h, w, _ = rgb_u8.shape
    n_lines = min(h, 240 if max_lines is None else max_lines)

    # Pre-render VIS header
    vis_segs: list[tuple[float, float]] = [(0.050, 1900.0)]
    _append_sstv_vis_header(vis_segs, 0x08)
    vis_n = int(round(sum(d for d, _ in vis_segs) * fs))
    vis_f = np.empty(vis_n, dtype=np.float64)
    acc = 0.0
    p0 = 0
    for dur, f_hz in vis_segs:
        acc += dur
        p1 = min(vis_n, int(round(acc * fs)))
        vis_f[p0:p1] = f_hz
        p0 = p1

    spl = int(round(0.150 * fs))  # 1800 samples
    n_sync = int(round(0.009 * fs))   # 108
    n_porch = int(round(0.003 * fs))  # 36
    n_y = int(round(0.088 * fs))      # 1056
    n_sep = int(round(0.0045 * fs))   # 54
    n_cpor = int(round(0.0015 * fs))  # 18
    n_c = spl - (n_sync + n_porch + n_y + n_sep + n_cpor)  # 528

    x_src = np.linspace(0.0, 1.0, w, endpoint=False, dtype=np.float32)
    xy_dst = np.linspace(0.0, 1.0, n_y, endpoint=False, dtype=np.float32)
    xc_dst = np.linspace(0.0, 1.0, n_c, endpoint=False, dtype=np.float32)

    lines_f = np.empty((n_lines, spl), dtype=np.float64)
    for row in range(n_lines):
        r = rgb_u8[row, :, 0].astype(np.float32)
        g = rgb_u8[row, :, 1].astype(np.float32)
        b = rgb_u8[row, :, 2].astype(np.float32)
        y_val = np.clip((0.299 * r + 0.587 * g + 0.114 * b) / 255.0, 0.0, 1.0)
        if (row % 2) == 0:
            c_val = np.clip((128.0 + 0.713 * (r - y_val * 255.0)) / 255.0, 0.0, 1.0)
            sep_hz = 1500.0
        else:
            c_val = np.clip((128.0 + 0.564 * (b - y_val * 255.0)) / 255.0, 0.0, 1.0)
            sep_hz = 2300.0

        lf = lines_f[row]
        idx = 0
        lf[idx: idx + n_sync] = 1200.0
        idx += n_sync
        lf[idx: idx + n_porch] = 1500.0
        idx += n_porch
        lf[idx: idx + n_y] = 1500.0 + 800.0 * np.interp(xy_dst, x_src, y_val)
        idx += n_y
        lf[idx: idx + n_sep] = sep_hz
        idx += n_sep
        lf[idx: idx + n_cpor] = 1900.0
        idx += n_cpor
        lf[idx: idx + n_c] = 1500.0 + 800.0 * np.interp(xc_dst, x_src, c_val)

    all_f = np.concatenate((vis_f, lines_f.ravel(), np.full(int(0.08 * fs), 1900.0, dtype=np.float64)))
    phase = np.cumsum(2.0 * math.pi * all_f / fs)
    return (amp * np.sin(phase)).astype(np.float32)


def synthesize_sstv_martin_m1(
    rgb_u8: np.ndarray, max_lines: int | None = None, fs: float = DSP_RATE, amp: float = 0.72
) -> np.ndarray:
    """Synthesize VIS 0x2C + Martin M1 color scanlines (320x256 G-B-R)."""
    h, w, _ = rgb_u8.shape
    n_lines = min(h, 256 if max_lines is None else max_lines)

    vis_segs: list[tuple[float, float]] = [(0.050, 1900.0)]
    _append_sstv_vis_header(vis_segs, 0x2C)
    vis_n = int(round(sum(d for d, _ in vis_segs) * fs))
    vis_f = np.empty(vis_n, dtype=np.float64)
    acc = 0.0
    p0 = 0
    for dur, f_hz in vis_segs:
        acc += dur
        p1 = min(vis_n, int(round(acc * fs)))
        vis_f[p0:p1] = f_hz
        p0 = p1

    spl_f = 0.446446 * fs
    x_src = np.linspace(0.0, 1.0, w, endpoint=False, dtype=np.float32)
    row_arrays: list[np.ndarray] = [vis_f]

    sample_carry = 0.0
    for row in range(n_lines):
        target = spl_f + sample_carry
        spl = int(round(target))
        sample_carry = target - spl

        def n_ms(ms: float) -> int:
            return max(1, int(round(ms * spl / 446.446)))

        nsync = n_ms(4.862)
        nsep = n_ms(0.572)
        nch = max(16, (spl - nsync - 4 * nsep) // 3)
        xc = np.linspace(0.0, 1.0, nch, endpoint=False, dtype=np.float32)

        g = np.interp(xc, x_src, rgb_u8[row, :, 1].astype(np.float32) / 255.0)
        b = np.interp(xc, x_src, rgb_u8[row, :, 2].astype(np.float32) / 255.0)
        r = np.interp(xc, x_src, rgb_u8[row, :, 0].astype(np.float32) / 255.0)

        lf = np.full(spl, 1500.0, dtype=np.float64)
        p = nsync + nsep
        lf[:nsync] = 1200.0
        lf[p: p + nch] = 1500.0 + 800.0 * g
        p += nch + nsep
        lf[p: p + nch] = 1500.0 + 800.0 * b
        p += nch + nsep
        end_r = min(spl, p + nch)
        lf[p:end_r] = 1500.0 + 800.0 * r[: end_r - p]
        row_arrays.append(lf)

    row_arrays.append(np.full(int(0.08 * fs), 1900.0, dtype=np.float64))
    all_f = np.concatenate(row_arrays)
    phase = np.cumsum(2.0 * math.pi * all_f / fs)
    return (amp * np.sin(phase)).astype(np.float32)


