def synthesize_wefax_audio(
    chart_u8: np.ndarray, lpm: float = 120.0, phasing_lines: int = 3, fs: float = DSP_RATE, amp: float = 0.72
) -> np.ndarray:
    """Synthesize WMO IOC-576 FM WEFAX audio (1500 Hz black .. 2300 Hz white + 5% white phasing lines)."""
    spl = int(round(fs * (60.0 / lpm)))
    h, w = chart_u8.shape
    x_dst = np.linspace(0.0, 1.0, spl, endpoint=False, dtype=np.float32)
    x_src = np.linspace(0.0, 1.0, w, endpoint=False, dtype=np.float32)

    freq_rows: list[np.ndarray] = []
    # Phasing lines: 5% white (2300 Hz) at column 0, 95% black (1500 Hz)
    white_n = max(8, int(round(0.05 * spl)))
    ph_line = np.full(spl, 1500.0, dtype=np.float64)
    ph_line[:white_n] = 2300.0
    for _ in range(max(1, phasing_lines)):
        freq_rows.append(ph_line)

    for r in range(h):
        lum = chart_u8[r].astype(np.float32) / 255.0
        lum_line = np.interp(x_dst, x_src, lum)
        freq_rows.append((1500.0 + 800.0 * lum_line).astype(np.float64))

    freqs = np.concatenate(freq_rows)
    phase = np.cumsum(2.0 * math.pi * freqs / fs)
    return (amp * np.sin(phase)).astype(np.float32)


