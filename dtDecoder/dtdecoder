    # ---- UI Tick (~30 fps) ----
    def _on_ui_tick(self) -> bool:
        # Drain queued audio chunks into DSP
        drained = 0
        while drained < 24:
            try:
                _origin, chunk = self.router.rx_queue.get_nowait()
            except queue.Empty:
                break
            drained += 1
            ev = self.ctrl.ingest_samples(chunk)
            if ev["tty_text"]:
                self._append_tty_text(ev["tty_text"])
            for al in ev["same_alerts"]:
                stamp = datetime.datetime.now().strftime("%H:%M:%S")
                self._append_tty_text(
                    f"\n*** [EAS {al['severity']}] {stamp} — {al['raw']} ***\n"
                    f"    {al['summary']}\n\n"
                )

        self.ctrl.step_waterfall()

        # Update TX button styling
        tx_active = self.router.is_transmitting_test()
        tctx = self.btn_test_tx.get_style_context()
        if tx_active:
            self.btn_test_tx.set_label("■ STOP TEST TX")
            tctx.remove_class("btn-tx")
            tctx.add_class("btn-tx-on")
        else:
            self.btn_test_tx.set_label("▶ SEND TEST SIGNAL")
            tctx.remove_class("btn-tx-on")
            tctx.add_class("btn-tx")

        # Update WEFAX & SSTV side telemetry labels
        if self.ctrl.mode == "WEFAX":
            ph_txt = "LOCKED (COL 0)" if self.ctrl.wefax.phasing_locked else "SEARCHING..."
            self.wefax_info_lbl.set_text(
                f"IOC:      576 (WMO STD)\n"
                f"SPEED:    {self.ctrl.wefax.lpm:.0f} LPM\n"
                f"PHASING:  {ph_txt}\n"
                f"SCANLINE: {self.ctrl.wefax.line_idx} / {self.ctrl.wefax.MAX_LINES}\n"
                f"SLANT:    {int(round(self.ctrl.slant_fine * 50)):+d}\n"
                f"POLARITY: {'INVERTED' if self.ctrl.wefax.invert else 'NORMAL'}\n\n"
                f"Click [▶ SEND TEST SIGNAL]\n"
                f"to transmit USCG NMC Pt. Reyes\n"
                f"Pacific Surface Analysis."
            )
            self.wefax_area.queue_draw()
        elif self.ctrl.mode == "SSTV":
            vis_s = f"0x{self.ctrl.sstv.vis_code:02X}" if self.ctrl.sstv.vis_code >= 0 else "AUTO"
            fh = self.ctrl.sstv.active_height()
            self.sstv_stat_lbl.set_text(
                f"VIS: {vis_s} ({self.ctrl.sstv.mode_name}) • LINE {self.ctrl.sstv.line_idx}/{fh}"
            )
            self.sstv_info_lbl.set_text(
                f"FORMAT:   {self.ctrl.sstv.mode_name}\n"
                f"RES:      320 x {fh} RGB\n"
                f"VIS CODE: {vis_s}\n"
                f"STATE:    {self.ctrl.sstv.rx_state}\n"
                f"SCANLINE: {self.ctrl.sstv.line_idx} / {fh}\n"
                f"SYNC:     1200 Hz (9.0 ms)\n"
                f"VIDEO:    1500-2300 Hz\n\n"
                f"Click [▶ SEND TEST SIGNAL]\n"
                f"to transmit W1AW / FN31pr\n"
                f"Color SSTV Test Card."
            )
            self.sstv_area.queue_draw()
        else:
            self.telem_area.queue_draw()

        self.deck_area.queue_draw()
        return True

