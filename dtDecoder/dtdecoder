# 4. HF WEFAX Decoder (IOC 576 / 120 LPM + Turbo 8x Mode + Slant & Phasing)
# ---------------------------------------------------------------------------
class WefaxDecoder:
    WIDTH = 864
    MAX_LINES = 560

    def __init__(self, fs: float = DSP_RATE):
        self.fs = fs
        self.fm = AnalyticFmDiscriminator(fs, smooth_taps=7)
        self.lpm = 120.0
        self.slant_ppm = 0.0  # fine adjustment knob (-1.0 .. +1.0 -> +-800 ppm)
        self.invert = False
        self.canvas = np.full((self.MAX_LINES, self.WIDTH), 246, dtype=np.uint8)
        self.reset()

    def reset(self):
        self.fm.reset()
        self._lum_buf = np.zeros(0, dtype=np.float32)
        self.line_idx = 0
        self.lines_decoded = 0
        self.phasing_locked = False
        self.phase_attempts = 0
        self.last_lum = 0.5
        self.sync_locked = False
        self.canvas.fill(246)

    def request_rephase(self):
        self.phasing_locked = False
        self.phase_attempts = 0

    def samples_per_line(self) -> float:
        base = self.fs * (60.0 / self.lpm)
        return base * (1.0 + self.slant_ppm * 8e-4)

    def process(self, x: np.ndarray, squelch: float = 0.0) -> int:
        f_inst, amp = self.fm.process(x)
        if len(f_inst) == 0:
            return 0
        mean_amp = float(np.mean(amp))
        if mean_amp < (0.004 + 0.06 * squelch):
            self.sync_locked = False
            return 0

        self.sync_locked = True
        lum = np.clip((f_inst - 1500.0) / 800.0, 0.0, 1.0)
        self.last_lum = float(np.mean(lum))
        self._lum_buf = np.concatenate((self._lum_buf, lum))

        spl = self.samples_per_line()
        need = int(round(spl))
        new_rows = 0
        x_grid = np.linspace(0.0, 1.0, self.WIDTH, endpoint=False, dtype=np.float32)

        while len(self._lum_buf) >= need + 8:
            # Check for WMO white-on-black phasing line (5% 2300 Hz white pulse, 95% 1500 Hz black)
            if not self.phasing_locked and self.phase_attempts < 16 and len(self._lum_buf) >= int(1.5 * need):
                seg = self._lum_buf[:need]
                if float(np.mean(seg)) < 0.28 and float(np.max(seg)) > 0.72:
                    # Find rising edge into the white phasing bar
                    above = np.where(seg > 0.62)[0]
                    if len(above) > 8:
                        # Walk to start of white pulse if pulse wraps around boundary
                        edge = int(above[0])
                        if edge == 0:
                            below = np.where(seg < 0.35)[0]
                            if len(below) > 0:
                                after_black = np.where(seg[below[0]:] > 0.62)[0]
                                if len(after_black) > 0:
                                    edge = int(below[0] + after_black[0])
                        if edge > 2:
                            self._lum_buf = self._lum_buf[edge:]
                        self.phasing_locked = True
                        if len(self._lum_buf) < need:
                            break
                self.phase_attempts += 1

            line_seg = self._lum_buf[:need]
            # Fractional line accumulator slice
            self._lum_buf = self._lum_buf[need:]

            src_x = np.linspace(0.0, 1.0, len(line_seg), endpoint=False, dtype=np.float32)
            row_f = np.interp(x_grid, src_x, line_seg)
            if self.invert:
                row_f = 1.0 - row_f
            row_u8 = np.clip(row_f * 255.0, 0.0, 255.0).astype(np.uint8)

            if self.line_idx >= self.MAX_LINES:
                self.canvas[:-1] = self.canvas[1:]
                self.canvas[-1] = row_u8
                self.line_idx = self.MAX_LINES - 1
            else:
                self.canvas[self.line_idx] = row_u8
                self.line_idx += 1

            self.lines_decoded += 1
            new_rows += 1

        return new_rows


