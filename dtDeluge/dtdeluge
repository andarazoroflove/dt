            self._ipc_sock = None
            IPC_SOCK_PATH.unlink(missing_ok=True)
        self.engine.shutdown()
        Gtk.main_quit()
        return False


# ---------------------------------------------------------------------------
# Comprehensive End-to-End Self-Test (--self-test)
# ---------------------------------------------------------------------------
def run_self_test() -> int:
    with tempfile.TemporaryDirectory(prefix="dtdeluge_selftest_") as tmp_s:
        tmp = Path(tmp_s)

        # 1. Test Bencode encode / decode + raw info slice
        sample = {
            b"announce": b"http://127.0.0.1:6969/announce",
            b"count": 42,
            b"neg": -17,
            b"list": [b"alpha", 0, [1, 2, 3]],
            b"info": {b"name": b"test.bin", b"piece length": 16384, b"pieces": b"\xaa" * 20},
        }
        enc = bencode(sample)
        dec = bdecode(enc)
        assert dec == sample, "Bencode round-trip mismatch"
        root_d, raw_info = extract_top_info_slice(enc)
        assert hashlib.sha1(raw_info).digest() == hashlib.sha1(bencode(sample[b"info"])).digest()

        # 2. Test multi-file .torrent creation & parsing (4 pieces × 16 KiB)
        seed_dir = tmp / "seed_data"
        pkg_dir = seed_dir / "CDE_Demo_Release"
        (pkg_dir / "docs").mkdir(parents=True)
        payload_a = os.urandom(36000)  # spans > 2 pieces
        payload_b = b"Common Desktop Environment BitTorrent Payload\n" * 450  # ~20.7 KiB
        (pkg_dir / "archive.dat").write_bytes(payload_a)
        (pkg_dir / "docs" / "README.txt").write_bytes(payload_b)

        torrent_path = tmp / "demo.torrent"
        created_meta = create_torrent_file(
            source_path=pkg_dir,
            out_torrent_path=torrent_path,
            trackers=["udp://127.0.0.1:9/announce"],
            comment="Self-test multi-file package",
            piece_length=16384,
        )
        parsed_meta = parse_torrent_file(torrent_path)
        assert parsed_meta.info_hash == created_meta.info_hash
        assert parsed_meta.num_pieces == 4
        assert parsed_meta.total_size == len(payload_a) + len(payload_b)

        # 3. Test Magnet URI parser (both 40-char hex AND 32-char RFC4648 Base32)
        ih_hex = parsed_meta.info_hash_hex
        ih_b32 = base64.b32encode(parsed_meta.info_hash).decode("ascii")
        m_hex = parse_magnet_uri(
            f"magnet:?xt=urn:btih:{ih_hex}&dn=HexTest&tr=udp%3A%2F%2Ftracker.example%3A80"
        )
        m_b32 = parse_magnet_uri(
            f"magnet:?xt=urn:btih:{ih_b32.lower()}&dn=Base32Test&x.pe=127.0.0.1:51413"
        )
        assert m_hex.info_hash == parsed_meta.info_hash
        assert m_b32.info_hash == parsed_meta.info_hash
        assert m_b32.peer_hints == [("127.0.0.1", 51413)]

        # 4. End-to-End Local Loopback Swarm Test on 127.0.0.1:
        #    Seeder Engine serves BOTH BEP-9 ut_metadata AND 4 × 16 KiB pieces over TCP
        #    to a Magnet Leecher Engine starting with ZERO metadata and an empty download dir!
        leech_dl_dir = tmp / "leech_downloads"
        leech_dl_dir.mkdir()

        seeder_engine = TorrentEngine(config_dir=tmp / "cfg_seed", listen_port=0, persist=False)
        leecher_engine = TorrentEngine(config_dir=tmp / "cfg_leech", listen_port=0, persist=False)
        try:
            assert seeder_engine.port_open and seeder_engine.listen_port > 0
            seed_tr = seeder_engine.add_meta(
                parsed_meta, download_dir=seed_dir, start_immediately=False
            )
            seed_tr.verify_local_data(auto_resume=True)

            # Wait until seeder finishes verifying all 4 pieces on disk
            deadline = time.monotonic() + 8.0
            while time.monotonic() < deadline:
                if all(seed_tr.have_pieces) and not seed_tr.verifying:
                    break
                time.sleep(0.05)
            assert all(seed_tr.have_pieces), "Seeder local verification failed"

            # Add via Magnet URI with x.pe pointing to local seeder!
            magnet_uri = (
                f"magnet:?xt=urn:btih:{ih_b32}&dn=CDE_Demo_Release"
                f"&x.pe=127.0.0.1:{seeder_engine.listen_port}"
            )
            leech_tr = leecher_engine.add_magnet_or_url(magnet_uri, download_dir=leech_dl_dir)

            deadline = time.monotonic() + 12.0
            while time.monotonic() < deadline:
                if leech_tr.meta.has_metadata and leech_tr.is_wanted_complete():
                    break
                leech_tr.connect_more_peers()
                time.sleep(0.05)

            assert leech_tr.meta.has_metadata, "BEP-9 ut_metadata exchange timed out"
            assert leech_tr.is_wanted_complete(), "Loopback 16 KiB piece transfer timed out"
            assert (leech_dl_dir / "CDE_Demo_Release" / "archive.dat").read_bytes() == payload_a
            assert (
                leech_dl_dir / "CDE_Demo_Release" / "docs" / "README.txt"
            ).read_bytes() == payload_b
            assert seed_tr.uploaded_bytes >= parsed_meta.total_size

            # 5. Exercise CDE Motif CSS, PangoCairo UI rendering, and GTK3 Window (if X11 active)
            pal = load_cde_palette()
            css_bytes = build_cde_css(*pal)
            assert b"cde-toolbar" in css_bytes and b"turtle-active" in css_bytes

            surf = cairo.ImageSurface(cairo.Format.ARGB32, 620, 260)
            cr = cairo.Context(surf)
            TorrentListCanvas.draw_transfer_list(
                cr, 620, 260, [leech_tr, seed_tr], {leech_tr.meta.info_hash_hex}, pal, False
            )
            TorrentListCanvas.draw_transfer_list(
                cr, 620, 260, [leech_tr, seed_tr], {leech_tr.meta.info_hash_hex}, pal, True
            )
            PieceMapCanvas.draw_piece_map(cr, 400, 220, leech_tr, pal[2])
            ThroughputSparkline.draw_sparkline(
                cr,
                118,
                20,
                collections.deque([0.0, 65536.0, 131072.0]),
                collections.deque([0.0, 16384.0, 32768.0]),
            )
            surf.flush()
            assert any(surf.get_data()), "Cairo surface rendered empty"

            ok_disp, _ = Gtk.init_check(sys.argv[:1])
            if ok_disp and Gdk.Display.get_default() is not None:
                win = DtDelugeWindow(leecher_engine, enable_ipc=False)
                win._refresh_ui()
                if win._timer_id:
                    GLib.source_remove(win._timer_id)
                    win._timer_id = 0
                win.destroy()
        finally:
            leecher_engine.shutdown()
            seeder_engine.shutdown()

    print("DTDELUGE_SELF_TEST_OK")
    return 0


# ---------------------------------------------------------------------------
# Entry Point & Single-Instance Argument Forwarding
# ---------------------------------------------------------------------------
def _try_forward_to_existing_instance(targets: list[str]) -> bool:
    if not IPC_SOCK_PATH.exists():
        return False
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(1.2)
        s.connect(str(IPC_SOCK_PATH))
        msg = "\n".join(targets if targets else ["__RAISE__"]) + "\n"
        s.sendall(msg.encode("utf-8"))
        s.close()
        return True
    except Exception:
        return False


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="dtdeluge",
        description="dtDeluge — CDE BitTorrent Client (Transmission UX in OSF/Motif Livery)",
    )
    parser.add_argument(
        "--self-test",
        action="store_true",
        help="Run built-in Bencode, .torrent, Magnet, Loopback Peer Wire, and Cairo UI self-tests",
    )
    parser.add_argument(
        "targets",
        nargs="*",
        help="Optional .torrent file paths, magnet:? URIs, or http(s) .torrent URLs",
    )
    args = parser.parse_args()

    if args.self_test:
        return run_self_test()

    clean_targets = [t for t in args.targets if t and t.strip()]
    if _try_forward_to_existing_instance(clean_targets):
        return 0

    ok, _ = Gtk.init_check(sys.argv[:1])
    if not ok:
        sys.stderr.write("dtDeluge: Unable to open X11/GTK display.\n")
        return 1

    engine = TorrentEngine(config_dir=CONFIG_DIR, persist=True)
    win = DtDelugeWindow(engine, enable_ipc=True)
    for t in clean_targets:
        win._ingest_external_arg(t)
    win._refresh_ui()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
