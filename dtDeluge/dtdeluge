    def _refresh_ui(self) -> None:
        with self.engine._lock:
            all_transfers = list(self.engine.transfers.values())

        # Sync tracker filter options if new hosts appeared
        hosts = sorted({t.host for tr in all_transfers for t in tr.trackers if t.host})
        if set(hosts) != self._known_tracker_hosts:
            self._known_tracker_hosts = set(hosts)
            cur = self.active_tracker_filter
            self.tracker_combo.remove_all()
            self.tracker_combo.append_text("All Trackers")
            active_i = 0
            for idx, h in enumerate(hosts, start=1):
                self.tracker_combo.append_text(h)
                if h == cur:
                    active_i = idx
            self.tracker_combo.set_active(active_i)

        visible = [tr for tr in all_transfers if self._matches_filters(tr)]
        compact = bool(self.engine.settings.get("compact_view", False))
        self.list_canvas.set_items(visible, compact=compact)

        total_n = len(all_transfers)
        vis_n = len(visible)
        if vis_n == total_n:
            self.count_label.set_text(f"{total_n} transfer{'s' if total_n != 1 else ''}")
        else:
            self.count_label.set_text(f"{vis_n} of {total_n} transfers")

        # Global speeds & sparkline
        g_down = sum(t.down_rate for t in all_transfers)
        g_up = sum(t.up_rate for t in all_transfers)
        self.lbl_global_down.set_text(f"▼ Down: {fmt_rate(g_down)}")
        self.lbl_global_up.set_text(f"▲ Up: {fmt_rate(g_up)}")
        self.sparkline.push(g_down, g_up)

        # Free disk space via os.statvfs
        dl_dir = Path(self.engine.settings.get("download_dir", str(HOME / "Downloads")))
        probe = dl_dir if dl_dir.exists() else HOME
        try:
            st = os.statvfs(probe)
            free_b = st.f_bavail * st.f_frsize
            self.lbl_disk_free.set_text(f"Free: {fmt_bytes(free_b)}")
        except Exception:
            self.lbl_disk_free.set_text("Free: —")

        led = "●" if self.engine.port_open else "○"
        self.lbl_port.set_text(f"{led} Port {self.engine.listen_port}")

        if self.inspector_box.get_visible():
            self._refresh_inspector(force_files=False)

    def _refresh_inspector(self, force_files: bool = False) -> None:
        tr = self.list_canvas.primary_selected()
        self.piece_map_canvas.set_transfer(tr)
        if tr is None:
            self.insp_title.set_markup("<b>Inspector — No Transfer Selected</b>")
            for lbl in self.info_labels.values():
                lbl.set_text("—")
            self.peers_store.clear()
            self.trackers_store.clear()
            self.files_store.clear()
            self.peers_summary_lbl.set_text("0 connected peers")
            return

        esc_name = GLib.markup_escape_text(tr.meta.name)
        self.insp_title.set_markup(f"<b>Inspector — {esc_name}</b>")

        # Tab 1: Activity / Info
        pct = tr.progress * 100.0
        self.info_labels["state"].set_text(tr.state)
        self.info_labels["progress"].set_text(
            f"{pct:.1f}% ({fmt_bytes(tr.verified_bytes)} of {fmt_bytes(tr.meta.total_size)})"
            if tr.meta.has_metadata
            else "Fetching magnet metadata (BEP-9)..."
        )
        self.info_labels["availability"].set_text(f"{tr.availability_pct():.1f}%")
        self.info_labels["downloaded"].set_text(fmt_bytes(max(tr.verified_bytes, tr.downloaded_session)))
        self.info_labels["uploaded"].set_text(fmt_bytes(tr.uploaded_bytes))
        self.info_labels["ratio"].set_text(f"{tr.ratio:.3f}")
        self.info_labels["speed"].set_text(f"▼ {fmt_rate(tr.down_rate)}   ▲ {fmt_rate(tr.up_rate)}")
        if tr.meta.has_metadata:
            done_p = sum(1 for x in tr.have_pieces if x)
            self.info_labels["pieces"].set_text(
                f"{done_p} / {tr.meta.num_pieces} × {fmt_bytes(tr.meta.piece_length)}"
            )
        else:
            self.info_labels["pieces"].set_text("Pending metadata")
        self.info_labels["infohash"].set_text(tr.meta.info_hash_hex)
        self.info_labels["folder"].set_text(str(tr.download_dir))
        c_str = tr.meta.created_by or "Unknown"
        if tr.meta.creation_date > 0:
            dt_s = datetime.datetime.fromtimestamp(tr.meta.creation_date).strftime("%Y-%m-%d")
            c_str = f"{c_str} ({dt_s})"
        self.info_labels["created"].set_text(c_str)
        self.info_labels["comment"].set_text(tr.meta.comment or "—")

        # Tab 2: Peers (greenbar alternating background)
        self.peers_store.clear()
        with tr._lock:
            peers_list = list(tr.peers.values())
        for idx, p in enumerate(peers_list):
            bg = self.well_hex if idx % 2 == 0 else self.well_alt_hex
            self.peers_store.append(
                [
                    p.address_label,
                    p.client_name,
                    p.flags_str,
                    f"{p.progress_pct:.0f}%",
                    f"{p.down_meter.rate() / 1024.0:.1f}",
                    f"{p.up_meter.rate() / 1024.0:.1f}",
                    bg,
                ]
            )
        self.peers_summary_lbl.set_text(
            f"{len(peers_list)} connected ({len(tr.known_peers)} known in swarm)"
        )

        # Tab 3: Trackers
        self.trackers_store.clear()
        for idx, t in enumerate(tr.trackers):
            bg = self.well_hex if idx % 2 == 0 else self.well_alt_hex
            self.trackers_store.append(
                [t.tier, t.url, t.status, t.seeders, t.leechers, bg]
            )

        # Tab 4: Files (rebuild if transfer changed or count differs, else update in-place)
        if len(self.files_store) != len(tr.meta.files) or force_files:
            self.files_store.clear()
            for idx, f in enumerate(tr.meta.files):
                bg = self.well_hex if idx % 2 == 0 else self.well_alt_hex
                fpct = (100.0 * f.completed_bytes / f.length) if f.length > 0 else 100.0
                self.files_store.append(
                    [
                        f.index,
                        f.wanted,
                        f.rel_path,
                        f.priority,
                        fmt_bytes(f.length),
                        f"{min(100.0, fpct):.1f}%",
                        bg,
                    ]
                )
        else:
            it = self.files_store.get_iter_first()
            idx = 0
            while it is not None and idx < len(tr.meta.files):
                f = tr.meta.files[idx]
                fpct = (100.0 * f.completed_bytes / f.length) if f.length > 0 else 100.0
                self.files_store.set_value(it, 1, f.wanted)
                self.files_store.set_value(it, 3, f.priority)
                self.files_store.set_value(it, 5, f"{min(100.0, fpct):.1f}%")
                it = self.files_store.iter_next(it)
                idx += 1

