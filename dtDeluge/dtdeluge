        self, _renderer: Gtk.CellRendererCombo, path_str: str, new_text: str
    ) -> None:
        tr = self.list_canvas.primary_selected()
        if tr is None or new_text not in ("High", "Normal", "Low"):
            return
        it = self.files_store.get_iter(path_str)
        file_idx = self.files_store.get_value(it, 0)
        tr.set_file_priority(file_idx, new_text)
        self.engine.save_session_state()
        self._refresh_inspector(force_files=True)

