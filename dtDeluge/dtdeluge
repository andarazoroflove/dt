    # ---- Drag & Drop + Single-Instance IPC ----
    def _setup_drag_and_drop(self) -> None:
        targets = [
            Gtk.TargetEntry.new("text/uri-list", 0, 1),
            Gtk.TargetEntry.new("STRING", 0, 2),
            Gtk.TargetEntry.new("text/plain", 0, 3),
        ]
        self.drag_dest_set(Gtk.DestDefaults.ALL, targets, Gdk.DragAction.COPY)
        self.connect("drag-data-received", self._on_drag_data_received)

    def _on_drag_data_received(
        self,
        _widget: Gtk.Widget,
        context: Gdk.DragContext,
        _x: int,
        _y: int,
        data: Gtk.SelectionData,
        info: int,
        time_val: int,
    ) -> None:
        handled = False
        if info == 1:
            for uri in data.get_uris() or []:
                if self._ingest_external_arg(uri):
                    handled = True
        else:
            txt = data.get_text() or ""
            for line in txt.splitlines():
                line = line.strip()
                if line and self._ingest_external_arg(line):
                    handled = True
        Gtk.drag_finish(context, handled, False, time_val)
        if handled:
            self._refresh_ui()

    def _ingest_external_arg(self, arg: str) -> bool:
        s = arg.strip()
        if not s:
            return False
        try:
            tr = self.engine.add_magnet_or_url(s)
            self.list_canvas.selected_hashes = {tr.meta.info_hash_hex}
            return True
        except Exception as exc:
            self._show_error(f"Could not add '{s}':\n{exc}")
            return False

    def _start_ipc_server(self) -> None:
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            if IPC_SOCK_PATH.exists():
                IPC_SOCK_PATH.unlink(missing_ok=True)
            srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            srv.bind(str(IPC_SOCK_PATH))
            srv.listen(8)
            srv.settimeout(1.0)
            self._ipc_sock = srv

            def _loop() -> None:
                while self._ipc_sock is srv:
                    try:
                        conn, _ = srv.accept()
                    except socket.timeout:
                        continue
                    except Exception:
                        break
                    try:
                        payload = conn.recv(16384).decode("utf-8", errors="ignore")
                        conn.close()
                        args = [l.strip() for l in payload.splitlines() if l.strip()]
                        GLib.idle_add(self._on_ipc_args, args)
                    except Exception:
                        pass

            threading.Thread(target=_loop, name="DtDelugeIPC", daemon=True).start()
        except Exception:
            pass

    def _on_ipc_args(self, args: list[str]) -> bool:
        for a in args:
            if a != "__RAISE__":
                self._ingest_external_arg(a)
        self.present()
        self._refresh_ui()
        return False

    # ---- Filtering, Selection & Periodic Refresh ----
    def _matches_filters(self, tr: TorrentTransfer) -> bool:
        st = tr.state
        f = self.active_status_filter
        if f == "Active":
            if tr.down_rate < 1.0 and tr.up_rate < 1.0 and st not in (
                TorrentTransfer.STATE_METADATA,
                TorrentTransfer.STATE_VERIFYING,
            ):
                return False
        elif f == "Downloading":
            if st not in (TorrentTransfer.STATE_DOWNLOADING, TorrentTransfer.STATE_METADATA):
                return False
        elif f == "Seeding":
            if st != TorrentTransfer.STATE_SEEDING:
                return False
        elif f == "Paused":
            if st != TorrentTransfer.STATE_PAUSED:
                return False
        elif f == "Finished":
            if not tr.is_wanted_complete():
                return False

        if self.active_tracker_filter != "All Trackers":
            hosts = {t.host for t in tr.trackers}
            if self.active_tracker_filter not in hosts:
                return False

        if self.search_query:
            q = self.search_query.lower()
            if q not in tr.meta.name.lower() and q not in tr.meta.info_hash_hex.lower():
                return False

        return True

