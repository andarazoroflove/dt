def _hex_to_rgb(hex_col: str) -> tuple[float, float, float]:
    h = hex_col.lstrip("#")
    if len(h) != 6:
        return (0.68, 0.70, 0.76)
    return (
        int(h[0:2], 16) / 255.0,
        int(h[2:4], 16) / 255.0,
        int(h[4:6], 16) / 255.0,
    )


def _shade_hex(hex_col: str, factor: float) -> str:
    h = hex_col.lstrip("#")
    if len(h) != 6:
        return hex_col
    r = max(0, min(255, int(int(h[0:2], 16) * factor)))
    g = max(0, min(255, int(int(h[2:4], 16) * factor)))
    b = max(0, min(255, int(int(h[4:6], 16) * factor)))
    return f"#{r:02x}{g:02x}{b:02x}"


def _compute_greenbar_hex(well_hex: str) -> str:
    """Match CDE dtMail / dtPod subtle greenbar alternating row shade."""
    h = well_hex.lstrip("#")
    if len(h) != 6:
        return "#eef4db"
    r = max(0, int(h[0:2], 16) - 17)
    g = max(0, int(h[2:4], 16) - 3)
    b = max(0, int(h[4:6], 16) - 14)
    return f"#{r:02x}{g:02x}{b:02x}"


def load_cde_palette() -> tuple[str, str, str, str]:
    chrome, sel, well = "#aeb2c3", "#2c567e", "#fff7e9"
    try:
        out = subprocess.check_output(
            ["xrdb", "-query"], text=True, stderr=subprocess.DEVNULL, timeout=1.5
        )
        pal_name = "Crimson.dp"
        for ln in out.splitlines():
            if "ColorPalette:" in ln:
                pal_name = ln.split(":", 1)[1].strip()
                break
        for pdir in (HOME / ".dt/palettes", Path("/usr/dt/palettes")):
            pf = pdir / pal_name
            if pf.is_file():
                hexes = [
                    l.strip()
                    for l in pf.read_text(errors="ignore").splitlines()
                    if l.strip().startswith("#")
                ]
                if len(hexes) >= 4:
                    def norm16(h: str) -> str:
                        h = h.lstrip("#")
                        return (
                            f"#{h[0:2]}{h[4:6]}{h[8:10]}"
                            if len(h) == 12
                            else "#" + h[:6]
                        )
                    chrome, sel, well = (
                        norm16(hexes[1]),
                        norm16(hexes[2]),
                        norm16(hexes[3]),
                    )
                break
    except Exception:
        pass
    well_alt = _compute_greenbar_hex(well)
    return chrome, sel, well, well_alt


