def _draw_motif_bevel(
    cr: cairo.Context,
    x: float,
    y: float,
    w: float,
    h: float,
    sunken: bool = True,
    thickness: float = 1.5,
) -> None:
    top_col = (0.30, 0.32, 0.38) if sunken else (0.93, 0.95, 0.98)
    bot_col = (0.93, 0.95, 0.98) if sunken else (0.30, 0.32, 0.38)
    cr.save()
    cr.set_line_width(thickness)
    cr.set_source_rgb(*top_col)
    cr.move_to(x + 0.5, y + h - 0.5)
    cr.line_to(x + 0.5, y + 0.5)
    cr.line_to(x + w - 0.5, y + 0.5)
    cr.stroke()

    cr.set_source_rgb(*bot_col)
    cr.move_to(x + 0.5, y + h - 0.5)
    cr.line_to(x + w - 0.5, y + h - 0.5)
    cr.line_to(x + w - 0.5, y + 0.5)
    cr.stroke()
    cr.restore()


def _state_bar_rgb(state: str) -> tuple[float, float, float]:
    if state == TorrentTransfer.STATE_DOWNLOADING:
        return (0.14, 0.39, 0.74)  # Royal Blue
    if state in (TorrentTransfer.STATE_SEEDING, TorrentTransfer.STATE_FINISHED):
        return (0.14, 0.56, 0.32)  # Emerald Green
    if state in (TorrentTransfer.STATE_VERIFYING, TorrentTransfer.STATE_METADATA):
        return (0.83, 0.53, 0.09)  # Warm Amber
    if state == TorrentTransfer.STATE_ERROR:
        return (0.73, 0.18, 0.18)  # Crimson Red
    return (0.47, 0.50, 0.58)  # Slate Grey (Paused)


class TorrentListCanvas(Gtk.DrawingArea):
    """Transmission-style 3-line (or Compact 1-line) transfer cards in Motif greenbar well."""

    CARD_H = 68
    COMPACT_H = 30

    def __init__(
        self,
        palette: tuple[str, str, str, str],
        on_selection_changed: Callable[[], None],
        on_activate_row: Callable[[], None],
        on_context_menu: Callable[[Gdk.EventButton], None],
    ) -> None:
        super().__init__()
        self.chrome_hex, self.sel_hex, self.well_hex, self.well_alt_hex = palette
        self.on_selection_changed = on_selection_changed
        self.on_activate_row = on_activate_row
        self.on_context_menu = on_context_menu

        self.items: list[TorrentTransfer] = []
        self.selected_hashes: set[str] = set()
        self.anchor_index: int = -1
        self.compact_view: bool = False

        self.set_can_focus(True)
        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.KEY_PRESS_MASK
            | Gdk.EventMask.SCROLL_MASK
        )
        self.connect("draw", self._on_draw)
        self.connect("button-press-event", self._on_button_press)
        self.connect("key-press-event", self._on_key_press)

    def row_height(self) -> int:
        return self.COMPACT_H if self.compact_view else self.CARD_H

    def set_items(self, items: list[TorrentTransfer], compact: bool) -> None:
        self.items = items
        self.compact_view = compact
        valid_ids = {t.meta.info_hash_hex for t in items}
        before = set(self.selected_hashes)
        self.selected_hashes &= valid_ids
        if not self.selected_hashes and items:
            self.selected_hashes.add(items[0].meta.info_hash_hex)
        if self.selected_hashes != before:
            self.on_selection_changed()
        total_h = max(180, len(items) * self.row_height() + 4)
        self.set_size_request(-1, total_h)
        self.queue_draw()

    def select_all(self) -> None:
        self.selected_hashes = {t.meta.info_hash_hex for t in self.items}
        self.on_selection_changed()
        self.queue_draw()

    def clear_selection(self) -> None:
        self.selected_hashes.clear()
        self.on_selection_changed()
        self.queue_draw()

    def primary_selected(self) -> Optional[TorrentTransfer]:
        for t in self.items:
            if t.meta.info_hash_hex in self.selected_hashes:
                return t
        return None

    def selected_transfers(self) -> list[TorrentTransfer]:
        return [t for t in self.items if t.meta.info_hash_hex in self.selected_hashes]

    def _on_button_press(self, _w: Gtk.Widget, ev: Gdk.EventButton) -> bool:
        self.grab_focus()
        rh = self.row_height()
        idx = int(ev.y // rh)
        if 0 <= idx < len(self.items):
            ih = self.items[idx].meta.info_hash_hex
            ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
            shift = bool(ev.state & Gdk.ModifierType.SHIFT_MASK)

            if ev.button == 3:
                if ih not in self.selected_hashes:
                    self.selected_hashes = {ih}
                    self.anchor_index = idx
                    self.on_selection_changed()
                    self.queue_draw()
                self.on_context_menu(ev)
                return True

            if ev.button == 1:
                if ev.type == Gdk.EventType._2BUTTON_PRESS:
                    self.on_activate_row()
                    return True
                if shift and 0 <= self.anchor_index < len(self.items):
                    lo, hi = sorted((self.anchor_index, idx))
                    self.selected_hashes = {
                        self.items[i].meta.info_hash_hex for i in range(lo, hi + 1)
                    }
                elif ctrl:
                    if ih in self.selected_hashes:
                        self.selected_hashes.discard(ih)
                    else:
                        self.selected_hashes.add(ih)
                    self.anchor_index = idx
                else:
                    self.selected_hashes = {ih}
                    self.anchor_index = idx
                self.on_selection_changed()
                self.queue_draw()
                return True
        else:
            if ev.button == 1:
                self.clear_selection()
        return False

    def _on_key_press(self, _w: Gtk.Widget, ev: Gdk.EventKey) -> bool:
        if not self.items:
            return False
        cur_idx = 0
        for i, t in enumerate(self.items):
            if t.meta.info_hash_hex in self.selected_hashes:
                cur_idx = i
                break
        if ev.keyval in (Gdk.KEY_Down, Gdk.KEY_Up):
            nxt = cur_idx + (1 if ev.keyval == Gdk.KEY_Down else -1)
            nxt = max(0, min(len(self.items) - 1, nxt))
            self.selected_hashes = {self.items[nxt].meta.info_hash_hex}
            self.anchor_index = nxt
            self.on_selection_changed()
            self.queue_draw()
            return True
        if ev.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.on_activate_row()
            return True
        return False

    def render_to_context(self, cr: cairo.Context, width: int, height: int) -> None:
        self.draw_transfer_list(
            cr=cr,
            width=width,
            height=height,
            items=self.items,
            selected_hashes=self.selected_hashes,
            palette=(self.chrome_hex, self.sel_hex, self.well_hex, self.well_alt_hex),
            compact_view=self.compact_view,
        )

    @classmethod
    def draw_transfer_list(
        cls,
        cr: cairo.Context,
        width: int,
        height: int,
        items: list[TorrentTransfer],
        selected_hashes: set[str],
        palette: tuple[str, str, str, str],
        compact_view: bool = False,
    ) -> None:
        _chrome_hex, sel_hex, well_hex, well_alt_hex = palette
        well_rgb = _hex_to_rgb(well_hex)
        alt_rgb = _hex_to_rgb(well_alt_hex)
        sel_rgb = _hex_to_rgb(sel_hex)

        cr.set_source_rgb(*well_rgb)
        cr.rectangle(0, 0, width, height)
        cr.fill()

        if not items:
            layout = PangoCairo.create_layout(cr)
            layout.set_width(max(100, width - 40) * Pango.SCALE)
            layout.set_alignment(Pango.Alignment.CENTER)
            layout.set_markup(
                "<span size='11000' weight='bold' foreground='#3d4352'>"
                "No Active Transfers in Current View</span>\n"
                "<span size='9200' foreground='#596073'>"
                "Click <b>[📂 Open]</b>, paste a <b>[🔗 Magnet]</b> URI, build a torrent with "
                "<b>[✚ Create]</b>,\nor drag-and-drop a <b>.torrent</b> file directly onto this window."
                "</span>"
            )
            _ink, log = layout.get_pixel_extents()
            cr.move_to(20, max(24, (height - log.height) / 2))
            PangoCairo.show_layout(cr, layout)
            return

        rh = cls.COMPACT_H if compact_view else cls.CARD_H
        for idx, tr in enumerate(items):
            y0 = idx * rh
            if y0 > height:
                break
            is_sel = tr.meta.info_hash_hex in selected_hashes
            if is_sel:
                cr.set_source_rgb(
                    well_rgb[0] * 0.72 + sel_rgb[0] * 0.28,
                    well_rgb[1] * 0.72 + sel_rgb[1] * 0.28,
                    well_rgb[2] * 0.72 + sel_rgb[2] * 0.28,
                )
            else:
                cr.set_source_rgb(*(well_rgb if idx % 2 == 0 else alt_rgb))
            cr.rectangle(0, y0, width, rh)
            cr.fill()

            cr.set_source_rgb(0.76, 0.78, 0.82)
            cr.set_line_width(1.0)
            cr.move_to(0, y0 + rh - 0.5)
            cr.line_to(width, y0 + rh - 0.5)
            cr.stroke()

            if is_sel:
                cr.set_source_rgb(*sel_rgb)
                cr.rectangle(0, y0, 4, rh - 1)
                cr.fill()
                cr.set_line_width(1.0)
                cr.rectangle(0.5, y0 + 0.5, width - 1.0, rh - 1.5)
                cr.stroke()

            if compact_view:
                cls._draw_compact_row(cr, tr, y0, width, rh)
            else:
                cls._draw_card_row(cr, tr, y0, width, rh)

    @staticmethod
    def _status_line_text(tr: TorrentTransfer) -> str:
        st = tr.state
        n_conn = len(tr.peers)
        n_known = max(n_conn, len(tr.known_peers))
        dr = tr.down_rate
        ur = tr.up_rate
        if st == TorrentTransfer.STATE_ERROR:
            return tr.error_msg or "Tracker or storage error"
        if st == TorrentTransfer.STATE_VERIFYING:
            return f"Verifying local data — {tr.progress * 100.0:.1f}% checked"
        if st == TorrentTransfer.STATE_METADATA:
            return (
                f"Magnet transfer — fetching metadata from {n_conn} of {n_known} peers "
                f"({tr.progress * 100.0:.0f}%)"
            )
        if st == TorrentTransfer.STATE_DOWNLOADING:
            active_dl = sum(1 for p in tr.peers.values() if not p.peer_choking and p.am_interested)
            return (
                f"Downloading from {active_dl} of {n_conn} connected peers "
                f"({n_known} swarm) — ▼ {fmt_rate(dr)}   ▲ {fmt_rate(ur)}"
            )
        if st == TorrentTransfer.STATE_SEEDING:
            active_up = sum(1 for p in tr.peers.values() if p.peer_interested)
            return (
                f"Seeding to {active_up} of {n_conn} connected peers — "
                f"▲ {fmt_rate(ur)}   (Uploaded {fmt_bytes(tr.uploaded_bytes)})"
            )
        if st == TorrentTransfer.STATE_FINISHED:
            return f"Finished (100%) — Ratio {tr.ratio:.2f}"
        return f"Paused — {tr.progress * 100.0:.1f}% complete"

    @classmethod
    def _draw_card_row(
        cls, cr: cairo.Context, tr: TorrentTransfer, y0: float, width: int, rh: int
    ) -> None:
        pad_x = 12
        pct = tr.progress * 100.0
        st = tr.state

        # Right-side Line 1: Size & Ratio
        size_str = fmt_bytes(tr.meta.total_size) if tr.meta.has_metadata else "Metadata pending"
        right_top = f"{size_str}  •  Ratio {tr.ratio:.2f}"
        rt_layout = PangoCairo.create_layout(cr)
        rt_layout.set_font_description(Pango.FontDescription("DejaVu Sans Mono 8.5"))
        rt_layout.set_text(right_top, -1)
        _, rt_ext = rt_layout.get_pixel_extents()
        cr.set_source_rgb(0.24, 0.27, 0.34)
        cr.move_to(max(pad_x + 120, width - pad_x - rt_ext.width), y0 + 7)
        PangoCairo.show_layout(cr, rt_layout)

        # Left Line 1: Bold Torrent Name
        name_w = max(80, width - pad_x * 2 - rt_ext.width - 14)
        nm_layout = PangoCairo.create_layout(cr)
        nm_layout.set_font_description(Pango.FontDescription("DejaVu Sans Bold 9.5"))
        nm_layout.set_width(name_w * Pango.SCALE)
        nm_layout.set_ellipsize(Pango.EllipsizeMode.END)
        nm_layout.set_text(tr.meta.name, -1)
        cr.set_source_rgb(0.06, 0.08, 0.11)
        cr.move_to(pad_x, y0 + 6)
        PangoCairo.show_layout(cr, nm_layout)

        # Line 2: Peer & Speed Status
        st_layout = PangoCairo.create_layout(cr)
        st_layout.set_font_description(Pango.FontDescription("DejaVu Sans 8.5"))
        st_layout.set_width(max(80, width - pad_x * 2) * Pango.SCALE)
        st_layout.set_ellipsize(Pango.EllipsizeMode.END)
        st_layout.set_text(cls._status_line_text(tr), -1)
        if st == TorrentTransfer.STATE_ERROR:
            cr.set_source_rgb(0.68, 0.12, 0.12)
        else:
            cr.set_source_rgb(0.25, 0.28, 0.35)
        cr.move_to(pad_x, y0 + 25)
        PangoCairo.show_layout(cr, st_layout)

        # Line 3 Right: % + ETA
        eta = tr.eta_seconds
        eta_part = f"  •  {fmt_eta(eta)}" if st == TorrentTransfer.STATE_DOWNLOADING else f"  •  {st}"
        pct_text = f"{pct:5.1f}%{eta_part}"
        pc_layout = PangoCairo.create_layout(cr)
        pc_layout.set_font_description(Pango.FontDescription("DejaVu Sans Mono 8"))
        pc_layout.set_text(pct_text, -1)
        _, pc_ext = pc_layout.get_pixel_extents()
        right_col_w = max(145, pc_ext.width + 8)
        cr.set_source_rgb(0.18, 0.20, 0.26)
        cr.move_to(width - pad_x - pc_ext.width, y0 + 45)
        PangoCairo.show_layout(cr, pc_layout)

        # Line 3 Left: Chiseled 3D Motif Progress Bar
        bx = float(pad_x)
        by = float(y0 + 45)
        bw = float(max(60, width - pad_x * 2 - right_col_w - 6))
        bh = 14.0

        # Sunken trough
        cr.set_source_rgb(0.84, 0.83, 0.79)
        cr.rectangle(bx, by, bw, bh)
        cr.fill()
        _draw_motif_bevel(cr, bx, by, bw, bh, sunken=True, thickness=1.5)

        fill_frac = max(0.0, min(1.0, tr.progress))
        if st == TorrentTransfer.STATE_METADATA and fill_frac < 0.06:
            fill_frac = 0.08
        fw = (bw - 4.0) * fill_frac
        if fw >= 2.0:
            bar_rgb = _state_bar_rgb(st)
            cr.set_source_rgb(*bar_rgb)
            cr.rectangle(bx + 2.0, by + 2.0, fw, bh - 4.0)
            cr.fill()
            # Top glossy Motif highlight strip inside progress bar
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.32)
            cr.rectangle(bx + 2.0, by + 2.0, fw, 2.5)
            cr.fill()
            cr.set_source_rgba(0.0, 0.0, 0.0, 0.28)
            cr.rectangle(bx + 2.0, by + bh - 4.0, fw, 2.0)
            cr.fill()

    @staticmethod
    def _draw_compact_row(
        cr: cairo.Context, tr: TorrentTransfer, y0: float, width: int, rh: int
    ) -> None:
        pad_x = 10
        st = tr.state
        pct = tr.progress * 100.0

        # Status dot
        cr.set_source_rgb(*_state_bar_rgb(st))
        cr.arc(pad_x + 5, y0 + rh / 2, 4.5, 0, math.tau)
        cr.fill()

        # Right metrics
        metrics = f"▼ {fmt_rate(tr.down_rate)}  ▲ {fmt_rate(tr.up_rate)}  {pct:5.1f}%"
        m_layout = PangoCairo.create_layout(cr)
        m_layout.set_font_description(Pango.FontDescription("DejaVu Sans Mono 8"))
        m_layout.set_text(metrics, -1)
        _, m_ext = m_layout.get_pixel_extents()
        cr.set_source_rgb(0.18, 0.20, 0.26)
        cr.move_to(width - pad_x - m_ext.width, y0 + 7)
        PangoCairo.show_layout(cr, m_layout)

        # Mini Motif bar before metrics
        bw = 96.0
        bx = float(width - pad_x - m_ext.width - bw - 12)
        by = float(y0 + 9)
        bh = 12.0
        if bx > 180:
            cr.set_source_rgb(0.84, 0.83, 0.79)
            cr.rectangle(bx, by, bw, bh)
            cr.fill()
            _draw_motif_bevel(cr, bx, by, bw, bh, sunken=True, thickness=1.0)
            fw = (bw - 2.0) * max(0.0, min(1.0, tr.progress))
            if fw >= 1.5:
                cr.set_source_rgb(*_state_bar_rgb(st))
                cr.rectangle(bx + 1.0, by + 1.0, fw, bh - 2.0)
                cr.fill()

        # Name
        nm_w = max(60, int(bx - pad_x - 24))
        nm_layout = PangoCairo.create_layout(cr)
        nm_layout.set_font_description(Pango.FontDescription("DejaVu Sans Bold 8.8"))
        nm_layout.set_width(nm_w * Pango.SCALE)
        nm_layout.set_ellipsize(Pango.EllipsizeMode.END)
        nm_layout.set_text(tr.meta.name, -1)
        cr.set_source_rgb(0.06, 0.08, 0.11)
        cr.move_to(pad_x + 16, y0 + 6)
        PangoCairo.show_layout(cr, nm_layout)

    def _on_draw(self, widget: Gtk.Widget, cr: cairo.Context) -> bool:
        alloc = widget.get_allocation()
        self.render_to_context(cr, alloc.width, alloc.height)
        return True


class PieceMapCanvas(Gtk.DrawingArea):
    """Live 2D Cairo piece-map grid for the 5th Inspector tab."""

    def __init__(self, well_hex: str) -> None:
        super().__init__()
        self.well_hex = well_hex
        self.transfer: Optional[TorrentTransfer] = None
        self.set_size_request(280, 180)
        self.connect("draw", self._on_draw)

    def set_transfer(self, tr: Optional[TorrentTransfer]) -> None:
        self.transfer = tr
        self.queue_draw()

    def render_to_context(self, cr: cairo.Context, width: int, height: int) -> None:
        self.draw_piece_map(cr, width, height, self.transfer, self.well_hex)

    @staticmethod
    def draw_piece_map(
        cr: cairo.Context,
        width: int,
        height: int,
        tr: Optional[TorrentTransfer],
        well_hex: str,
    ) -> None:
        well_rgb = _hex_to_rgb(well_hex)
        cr.set_source_rgb(*well_rgb)
        cr.rectangle(0, 0, width, height)
        cr.fill()
        if tr is None or not tr.meta.has_metadata or tr.meta.num_pieces == 0:
            layout = PangoCairo.create_layout(cr)
            layout.set_font_description(Pango.FontDescription("DejaVu Sans 9"))
            msg = (
                "Select a transfer to inspect its 2D piece map."
                if tr is None
                else "Waiting for magnet metadata to map pieces..."
            )
            layout.set_text(msg, -1)
            cr.set_source_rgb(0.32, 0.35, 0.42)
            cr.move_to(12, 14)
            PangoCairo.show_layout(cr, layout)
            return

        np = tr.meta.num_pieces
        have = list(tr.have_pieces)
        active_set = set(tr.active_assemblies.keys())
        wanted = list(tr.wanted_pieces)
        done_cnt = sum(1 for x in have if x)

        # Header legend
        hdr = (
            f"Pieces: {done_cnt}/{np} × {fmt_bytes(tr.meta.piece_length)}   "
            f"[■ Emerald: Verified   ■ Cyan: In-Flight   □ Cream: Missing]"
        )
        h_layout = PangoCairo.create_layout(cr)
        h_layout.set_font_description(Pango.FontDescription("DejaVu Sans Mono 8"))
        h_layout.set_width(max(80, width - 16) * Pango.SCALE)
        h_layout.set_ellipsize(Pango.EllipsizeMode.END)
        h_layout.set_text(hdr, -1)
        cr.set_source_rgb(0.12, 0.14, 0.18)
        cr.move_to(8, 6)
        PangoCairo.show_layout(cr, h_layout)

        gx, gy = 8.0, 26.0
        gw = max(40.0, width - 16.0)
        gh = max(40.0, height - 34.0)

        cr.set_source_rgb(0.86, 0.84, 0.79)
        cr.rectangle(gx, gy, gw, gh)
        cr.fill()
        _draw_motif_bevel(cr, gx, gy, gw, gh, sunken=True, thickness=1.5)

        ix, iy, iw, ih = gx + 3.0, gy + 3.0, gw - 6.0, gh - 6.0
        max_cells = min(np, 1200)
        aspect = max(1.0, iw / max(1.0, ih))
        cols = max(1, int(math.ceil(math.sqrt(max_cells * aspect))))
        rows = max(1, int(math.ceil(max_cells / cols)))
        total_cells = min(np, cols * rows)

        cell_w = iw / cols
        cell_h = ih / rows
        pad = 1.0 if min(cell_w, cell_h) >= 5.0 else 0.0

        for c_idx in range(total_cells):
            p_start = int(c_idx * np / total_cells)
            p_end = max(p_start + 1, int((c_idx + 1) * np / total_cells))
            r = c_idx // cols
            c = c_idx % cols
            cx = ix + c * cell_w + pad
            cy = iy + r * cell_h + pad
            cw = max(1.0, cell_w - pad * 2)
            ch = max(1.0, cell_h - pad * 2)

            any_active = any(pi in active_set for pi in range(p_start, min(np, p_end)))
            all_have = all(have[pi] for pi in range(p_start, min(np, p_end)))
            some_have = any(have[pi] for pi in range(p_start, min(np, p_end)))
            any_wanted = any(wanted[pi] for pi in range(p_start, min(np, p_end)))

            if all_have:
                cr.set_source_rgb(0.14, 0.58, 0.33)  # Emerald verified
            elif any_active:
                cr.set_source_rgb(0.12, 0.62, 0.78)  # Cyan active/in-flight
            elif some_have:
                cr.set_source_rgb(0.42, 0.74, 0.52)  # Partial bucket
            elif not any_wanted:
                cr.set_source_rgb(0.68, 0.70, 0.75)  # Skipped/unwanted
            else:
                cr.set_source_rgb(0.95, 0.92, 0.85)  # Missing sunken cream
            cr.rectangle(cx, cy, cw, ch)
            cr.fill()

    def _on_draw(self, widget: Gtk.Widget, cr: cairo.Context) -> bool:
        alloc = widget.get_allocation()
        self.render_to_context(cr, alloc.width, alloc.height)
        return True


class ThroughputSparkline(Gtk.DrawingArea):
    """Mini status-bar throughput graph (Down = Cobalt, Up = Emerald)."""

    def __init__(self) -> None:
        super().__init__()
        self.down_hist: collections.deque[float] = collections.deque([0.0] * 48, maxlen=48)
        self.up_hist: collections.deque[float] = collections.deque([0.0] * 48, maxlen=48)
        self.set_size_request(118, 20)
        self.connect("draw", self._on_draw)

    def push(self, down_bps: float, up_bps: float) -> None:
        self.down_hist.append(max(0.0, down_bps))
        self.up_hist.append(max(0.0, up_bps))
        self.queue_draw()

    def render_to_context(self, cr: cairo.Context, w: int, h: int) -> None:
        self.draw_sparkline(cr, w, h, self.down_hist, self.up_hist)

    @staticmethod
    def draw_sparkline(
        cr: cairo.Context,
        w: int,
        h: int,
        down_hist: collections.deque[float],
        up_hist: collections.deque[float],
    ) -> None:
        cr.set_source_rgb(0.11, 0.14, 0.18)
        cr.rectangle(0, 0, w, h)
        cr.fill()
        _draw_motif_bevel(cr, 0, 0, w, h, sunken=True, thickness=1.0)

        peak = max(10240.0, max(down_hist, default=0.0), max(up_hist, default=0.0))
        n = len(down_hist)
        if n < 2:
            return

        def _plot(series: collections.deque[float], rgb: tuple[float, float, float]) -> None:
            cr.set_source_rgb(*rgb)
            cr.set_line_width(1.3)
            for i, val in enumerate(series):
                x = 2.0 + (w - 4.0) * (i / (n - 1))
                y = (h - 2.0) - (h - 4.0) * min(1.0, val / peak)
                if i == 0:
                    cr.move_to(x, y)
                else:
                    cr.line_to(x, y)
            cr.stroke()

        _plot(up_hist, (0.25, 0.88, 0.52))
        _plot(down_hist, (0.36, 0.68, 0.98))

    def _on_draw(self, widget: Gtk.Widget, cr: cairo.Context) -> bool:
        alloc = widget.get_allocation()
        self.render_to_context(cr, alloc.width, alloc.height)
        return True


