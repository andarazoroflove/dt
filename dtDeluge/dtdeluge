class DtDelugeWindow(Gtk.Window):
    def __init__(self, engine: TorrentEngine, enable_ipc: bool = True) -> None:
        super().__init__(title="dtDeluge — CDE BitTorrent Client")
        self.engine = engine
        self.palette = load_cde_palette()
        self.chrome_hex, self.sel_hex, self.well_hex, self.well_alt_hex = self.palette

        # Apply CDE Motif CSS globally
        provider = Gtk.CssProvider()
        provider.load_from_data(build_cde_css(*self.palette))
        screen = Gdk.Screen.get_default()
        if screen is not None:
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        self.set_default_size(1020, 640)
        icon_png = Path(__file__).resolve().parent.parent / "assets" / "icons" / "dtdeluge.png"
        if icon_png.is_file():
            try:
                self.set_icon_from_file(str(icon_png))
