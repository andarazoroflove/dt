    def action_open_download_folder(self) -> None:
        tr = self.list_canvas.primary_selected()
        folder = tr.download_dir if tr is not None else Path(self.engine.settings["download_dir"])
        folder.mkdir(parents=True, exist_ok=True)
        for cmd in (["/usr/dt/bin/dtaction", "Dtfile", str(folder)], ["xdg-open", str(folder)]):
            if Path(cmd[0]).exists() or shutil.which(cmd[0]):
                try:
                    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    return
                except Exception:
                    continue

    def action_remove_selected(self, delete_data: bool = False) -> None:
        sel = self.list_canvas.selected_transfers()
        if not sel:
            return
        if delete_data:
            names = ", ".join(t.meta.name for t in sel[:3])
            dlg = Gtk.MessageDialog(
                transient_for=self,
                flags=0,
                message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.OK_CANCEL,
                text="Remove transfer(s) and permanently delete downloaded files?",
            )
            dlg.format_secondary_text(
                f"This will delete local data on disk for: {names}"
            )
            resp = dlg.run()
            dlg.destroy()
            if resp != Gtk.ResponseType.OK:
                return
        for tr in sel:
            self.engine.remove_transfer(tr.meta.info_hash_hex, delete_data=delete_data)
        self._refresh_ui()

