@dataclasses.dataclass
class TorrentFileEntry:
    index: int
    path_parts: list[str]
    rel_path: str
    length: int
    offset: int
    wanted: bool = True
    priority: str = "Normal"  # "High", "Normal", "Low"
    completed_bytes: int = 0


@dataclasses.dataclass
class TrackerState:
    tier: int
    url: str
    status: str = "Waiting to announce"
    last_announce: float = 0.0
    next_announce: float = 0.0
    interval: int = 900
    seeders: int = 0
    leechers: int = 0

    @property
    def host(self) -> str:
        try:
            u = urllib.parse.urlparse(self.url)
            return u.hostname or self.url
        except Exception:
            return self.url


@dataclasses.dataclass
class TorrentMeta:
    info_hash: bytes
    name: str
    piece_length: int = 0
    pieces_hashes: list[bytes] = dataclasses.field(default_factory=list)
    files: list[TorrentFileEntry] = dataclasses.field(default_factory=list)
    total_size: int = 0
    is_multi_file: bool = False
    trackers: list[tuple[int, str]] = dataclasses.field(default_factory=list)
    comment: str = ""
    created_by: str = ""
    creation_date: int = 0
    raw_info_bytes: bytes = b""
    has_metadata: bool = False
    peer_hints: list[tuple[str, int]] = dataclasses.field(default_factory=list)

    @property
    def info_hash_hex(self) -> str:
        return self.info_hash.hex()

    @property
    def num_pieces(self) -> int:
        return len(self.pieces_hashes)

    def piece_size(self, piece_idx: int) -> int:
        if not self.has_metadata or self.num_pieces == 0:
            return 0
        if piece_idx < 0 or piece_idx >= self.num_pieces:
            return 0
        if piece_idx == self.num_pieces - 1:
            rem = self.total_size - (self.num_pieces - 1) * self.piece_length
            return rem if rem > 0 else self.piece_length
        return self.piece_length

    def to_magnet_uri(self) -> str:
        q = [f"xt=urn:btih:{self.info_hash_hex}"]
        if self.name:
            q.append("dn=" + urllib.parse.quote(self.name))
        for _tier, tr in self.trackers:
            q.append("tr=" + urllib.parse.quote(tr, safe=""))
        return "magnet:?" + "&".join(q)


def _sanitize_part(part: str) -> str:
    p = part.strip().replace("/", "_").replace("\\", "_").replace("\x00", "")
    if p in ("", ".", ".."):
        return "_"
    return p


def populate_meta_from_info_dict(
    meta: TorrentMeta, info_dict: dict[bytes, Any], raw_info_bytes: bytes
) -> None:
    name = _sanitize_part(_bstr(info_dict.get(b"name"), meta.name or meta.info_hash_hex[:12]))
    piece_len = int(info_dict.get(b"piece length", 0))
    pieces_blob = info_dict.get(b"pieces", b"")
    if piece_len <= 0 or not isinstance(pieces_blob, bytes) or len(pieces_blob) % 20 != 0:
        raise BencodeError("Invalid piece length or pieces SHA-1 blob in info dict")
    hashes = [pieces_blob[i : i + 20] for i in range(0, len(pieces_blob), 20)]

    files: list[TorrentFileEntry] = []
    offset = 0
    is_multi = b"files" in info_dict
    if is_multi:
        raw_files = info_dict[b"files"]
        if not isinstance(raw_files, list) or not raw_files:
            raise BencodeError("Empty multi-file list in .torrent")
        for idx, rf in enumerate(raw_files):
            flen = max(0, int(rf.get(b"length", 0)))
            raw_parts = rf.get(b"path", [])
            parts = [_sanitize_part(_bstr(p)) for p in raw_parts if _bstr(p)]
            if not parts:
                parts = [f"file_{idx}"]
            rel = "/".join(parts)
            files.append(
                TorrentFileEntry(
                    index=idx,
                    path_parts=parts,
                    rel_path=rel,
                    length=flen,
                    offset=offset,
                )
            )
            offset += flen
    else:
        flen = max(0, int(info_dict.get(b"length", 0)))
        files.append(
            TorrentFileEntry(
                index=0,
                path_parts=[name],
                rel_path=name,
                length=flen,
                offset=0,
            )
        )
        offset = flen

    meta.name = name
    meta.piece_length = piece_len
    meta.pieces_hashes = hashes
    meta.files = files
    meta.total_size = offset
    meta.is_multi_file = is_multi
    meta.raw_info_bytes = raw_info_bytes
    meta.has_metadata = True


def parse_torrent_bytes(data: bytes) -> TorrentMeta:
    root, raw_info = extract_top_info_slice(data)
    info_hash = hashlib.sha1(raw_info).digest()
    trackers: list[tuple[int, str]] = []
    seen_tr: set[str] = set()

    ann_list = root.get(b"announce-list")
    if isinstance(ann_list, list):
        for tier_idx, tier_group in enumerate(ann_list):
            if isinstance(tier_group, list):
                for item in tier_group:
                    u = _bstr(item).strip()
                    if u and u not in seen_tr:
                        seen_tr.add(u)
                        trackers.append((tier_idx, u))
    ann = _bstr(root.get(b"announce")).strip()
    if ann and ann not in seen_tr:
        trackers.insert(0, (0, ann))

    meta = TorrentMeta(
        info_hash=info_hash,
        name=info_hash.hex()[:12],
        trackers=trackers,
        comment=_bstr(root.get(b"comment")),
        created_by=_bstr(root.get(b"created by")),
        creation_date=int(root.get(b"creation date", 0) or 0),
    )
    populate_meta_from_info_dict(meta, root[b"info"], raw_info)
    return meta


def parse_torrent_file(path: Path | str) -> TorrentMeta:
    return parse_torrent_bytes(Path(path).read_bytes())


def parse_magnet_uri(uri: str) -> TorrentMeta:
    s = uri.strip()
    if not s.lower().startswith("magnet:?"):
        raise ValueError("Not a valid magnet:? URI")
    qs = urllib.parse.parse_qs(s[8:], keep_blank_values=False)
    xts = qs.get("xt", [])
    info_hash: Optional[bytes] = None
    for xt in xts:
        m = re.match(r"(?i)^urn:btih:([A-Za-z0-9]+)$", xt.strip())
        if not m:
            continue
        tok = m.group(1)
        if len(tok) == 40:
            info_hash = bytes.fromhex(tok)
            break
        if len(tok) == 32:
            info_hash = base64.b32decode(tok.upper())
            break
    if not info_hash or len(info_hash) != 20:
        raise ValueError("Magnet URI missing 20-byte urn:btih infohash (hex or base32)")

    dn_list = qs.get("dn", [])
    name = dn_list[0].strip() if dn_list else f"Magnet {info_hash.hex()[:12]}"
    trackers: list[tuple[int, str]] = []
    seen: set[str] = set()
    for idx, tr in enumerate(qs.get("tr", [])):
        u = tr.strip()
        if u and u not in seen:
            seen.add(u)
            trackers.append((idx, u))

    peer_hints: list[tuple[str, int]] = []
    for pe in qs.get("x.pe", []):
        if ":" in pe:
            host, port_s = pe.rsplit(":", 1)
            try:
                peer_hints.append((host.strip("[]"), int(port_s)))
            except ValueError:
                pass

    return TorrentMeta(
        info_hash=info_hash,
        name=name,
        trackers=trackers,
        has_metadata=False,
        peer_hints=peer_hints,
    )


def choose_auto_piece_length(total_bytes: int) -> int:
    if total_bytes <= 2 * 1024 * 1024:
        return 16384  # 16 KiB
    if total_bytes <= 16 * 1024 * 1024:
        return 32768
    if total_bytes <= 128 * 1024 * 1024:
        return 65536
    if total_bytes <= 512 * 1024 * 1024:
        return 262144
    if total_bytes <= 2 * 1024 * 1024 * 1024:
        return 524288
    return 1048576


def create_torrent_file(
    source_path: Path | str,
    out_torrent_path: Path | str,
    trackers: list[str],
    comment: str = "",
    piece_length: int = 0,
    private: bool = False,
    progress_cb: Optional[Callable[[float], None]] = None,
) -> TorrentMeta:
    src = Path(source_path).resolve()
    if not src.exists():
        raise FileNotFoundError(f"Source path does not exist: {src}")

    file_records: list[tuple[Path, list[str], int]] = []
    is_dir = src.is_dir()
    if is_dir:
        for p in sorted(src.rglob("*")):
            if p.is_file() and not p.is_symlink():
                rel_parts = list(p.relative_to(src).parts)
                file_records.append((p, rel_parts, p.stat().st_size))
        if not file_records:
            raise ValueError("Selected directory contains no regular files")
    else:
        file_records.append((src, [src.name], src.stat().st_size))

    total_bytes = sum(sz for _, _, sz in file_records)
    plen = piece_length if piece_length > 0 else choose_auto_piece_length(total_bytes)

    pieces_out = bytearray()
    hasher = hashlib.sha1()
    buffered = 0
    processed = 0

    for fpath, _parts, _sz in file_records:
        with fpath.open("rb") as fp:
            while True:
                need = plen - buffered
                chunk = fp.read(min(need, 262144))
                if not chunk:
                    break
                hasher.update(chunk)
                buffered += len(chunk)
                processed += len(chunk)
                if buffered == plen:
                    pieces_out.extend(hasher.digest())
                    hasher = hashlib.sha1()
                    buffered = 0
                if progress_cb and total_bytes > 0:
                    progress_cb(processed / total_bytes)

    if buffered > 0 or total_bytes == 0:
        pieces_out.extend(hasher.digest())

    info: dict[bytes, Any] = {
        b"name": src.name.encode("utf-8"),
        b"piece length": plen,
        b"pieces": bytes(pieces_out),
    }
    if private:
        info[b"private"] = 1

    if is_dir:
        info[b"files"] = [
            {
                b"length": sz,
                b"path": [pt.encode("utf-8") for pt in parts],
            }
            for _fp, parts, sz in file_records
        ]
    else:
        info[b"length"] = total_bytes

    clean_tr = [t.strip() for t in trackers if t.strip()]
    root: dict[bytes, Any] = {
        b"created by": CLIENT_BANNER.encode("utf-8"),
        b"creation date": int(time.time()),
        b"info": info,
    }
    if clean_tr:
        root[b"announce"] = clean_tr[0].encode("utf-8")
        if len(clean_tr) > 1:
            root[b"announce-list"] = [[t.encode("utf-8")] for t in clean_tr]
    if comment.strip():
        root[b"comment"] = comment.strip().encode("utf-8")

    encoded = bencode(root)
    out_p = Path(out_torrent_path)
    out_p.parent.mkdir(parents=True, exist_ok=True)
    out_p.write_bytes(encoded)
    if progress_cb:
        progress_cb(1.0)
    return parse_torrent_bytes(encoded)


# ---------------------------------------------------------------------------
# Token-Bucket Bandwidth Rate Limiter
# ---------------------------------------------------------------------------
class TokenBucket:
    def __init__(self, rate_kbps: int = 0) -> None:
        self._lock = threading.Lock()
        self._rate_bps: float = max(0, rate_kbps) * 1024.0
        self._tokens: float = self._rate_bps
        self._last_ts: float = time.monotonic()

    def set_rate_kbps(self, rate_kbps: int) -> None:
        with self._lock:
            self._rate_bps = max(0, rate_kbps) * 1024.0
            self._tokens = min(self._tokens, max(self._rate_bps, float(BLOCK_SIZE * 2)))
            self._last_ts = time.monotonic()

    def throttle(self, nbytes: int, stop_event: Optional[threading.Event] = None) -> None:
        if nbytes <= 0:
            return
        while True:
            if stop_event is not None and stop_event.is_set():
                return
            with self._lock:
                if self._rate_bps <= 0:
                    return
                now = time.monotonic()
                dt = max(0.0, now - self._last_ts)
                self._last_ts = now
                burst = max(self._rate_bps * 1.5, float(BLOCK_SIZE * 2))
                self._tokens = min(burst, self._tokens + dt * self._rate_bps)
                if self._tokens >= nbytes:
                    self._tokens -= nbytes
                    return
                deficit = nbytes - self._tokens
                wait_s = min(0.25, deficit / max(1.0, self._rate_bps))
            if stop_event is not None:
                stop_event.wait(wait_s)
            else:
                time.sleep(wait_s)


# ---------------------------------------------------------------------------
# HTTP/HTTPS & BEP-15 UDP Tracker Announce Client
# ---------------------------------------------------------------------------
@dataclasses.dataclass
class AnnounceResult:
    ok: bool
    peers: list[tuple[str, int]] = dataclasses.field(default_factory=list)
    seeders: int = 0
    leechers: int = 0
    interval: int = 900
    message: str = "OK"


def _parse_compact_peers_v4(blob: bytes) -> list[tuple[str, int]]:
    peers: list[tuple[str, int]] = []
    for i in range(0, len(blob) - (len(blob) % 6), 6):
        ip = socket.inet_ntoa(blob[i : i + 4])
        (port,) = struct.unpack("!H", blob[i + 4 : i + 6])
        if port > 0 and ip != "0.0.0.0":
            peers.append((ip, port))
    return peers


def _parse_compact_peers_v6(blob: bytes) -> list[tuple[str, int]]:
    peers: list[tuple[str, int]] = []
    for i in range(0, len(blob) - (len(blob) % 18), 18):
        ip = socket.inet_ntop(socket.AF_INET6, blob[i : i + 16])
        (port,) = struct.unpack("!H", blob[i + 16 : i + 18])
        if port > 0:
            peers.append((ip, port))
    return peers


def announce_http_tracker(
    url: str,
    info_hash: bytes,
    peer_id: bytes,
    listen_port: int,
    uploaded: int,
    downloaded: int,
    left: int,
    event: str = "",
) -> AnnounceResult:
    sep = "&" if "?" in url else "?"
    ih_q = urllib.parse.quote_from_bytes(info_hash)
    pid_q = urllib.parse.quote_from_bytes(peer_id)
    params = [
        f"info_hash={ih_q}",
        f"peer_id={pid_q}",
        f"port={listen_port}",
        f"uploaded={max(0, uploaded)}",
        f"downloaded={max(0, downloaded)}",
        f"left={max(0, left)}",
        "compact=1",
        "numwant=80",
    ]
    if event:
        params.append(f"event={event}")
    full_url = url + sep + "&".join(params)
    req = urllib.request.Request(full_url, headers={"User-Agent": HTTP_UA})
    with urllib.request.urlopen(req, timeout=8.0) as resp:
        raw = resp.read(524288)
    data, _ = bdecode_at(raw, 0)
    if not isinstance(data, dict):
        return AnnounceResult(ok=False, message="Malformed tracker response")
    if b"failure reason" in data:
        return AnnounceResult(ok=False, message=_bstr(data[b"failure reason"], "Tracker error"))

    peers: list[tuple[str, int]] = []
    raw_peers = data.get(b"peers", b"")
    if isinstance(raw_peers, bytes):
        peers.extend(_parse_compact_peers_v4(raw_peers))
    elif isinstance(raw_peers, list):
        for p in raw_peers:
            if isinstance(p, dict):
                ip = _bstr(p.get(b"ip")).strip()
                port = int(p.get(b"port", 0) or 0)
                if ip and port > 0:
                    peers.append((ip, port))

    raw_peers6 = data.get(b"peers6", b"")
    if isinstance(raw_peers6, bytes):
        peers.extend(_parse_compact_peers_v6(raw_peers6))

    interval = max(60, int(data.get(b"interval", 900) or 900))
    seeders = max(0, int(data.get(b"complete", 0) or 0))
    leechers = max(0, int(data.get(b"incomplete", 0) or 0))
    return AnnounceResult(
        ok=True,
        peers=peers,
        seeders=seeders,
        leechers=leechers,
        interval=interval,
        message=f"OK ({len(peers)} peers)",
    )


def announce_udp_tracker(
    url: str,
    info_hash: bytes,
    peer_id: bytes,
    listen_port: int,
    uploaded: int,
    downloaded: int,
    left: int,
    event: str = "",
) -> AnnounceResult:
    """BEP-15 UDP Tracker Protocol client."""
    parsed = urllib.parse.urlparse(url)
    host = parsed.hostname
    port = parsed.port or 80
    if not host:
        return AnnounceResult(ok=False, message="Invalid UDP tracker host")

    ev_map = {"": 0, "completed": 1, "started": 2, "stopped": 3}
    ev_code = ev_map.get(event, 0)

    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.settimeout(4.5)
    try:
        addr_info = socket.getaddrinfo(host, port, socket.AF_INET, socket.SOCK_DGRAM)
        if not addr_info:
            return AnnounceResult(ok=False, message="DNS resolution failed")
        target = addr_info[0][4]

        # Step 1: Connect
        tx1 = random.randint(1, 0x7FFFFFFF)
        conn_req = struct.pack("!QII", 0x41727101980, 0, tx1)
        sock.sendto(conn_req, target)
        pkt1, _ = sock.recvfrom(2048)
        if len(pkt1) < 16:
            return AnnounceResult(ok=False, message="Short UDP connect reply")
        act1, rx_tx1, conn_id = struct.unpack("!IIQ", pkt1[:16])
        if act1 != 0 or rx_tx1 != tx1:
            return AnnounceResult(ok=False, message="UDP connect handshake mismatch")

        # Step 2: Announce (98 bytes)
        tx2 = random.randint(1, 0x7FFFFFFF)
        key = random.randint(1, 0x7FFFFFFF)
        ann_req = struct.pack(
            "!QII20s20sQQQIIIiH",
            conn_id,
            1,
            tx2,
            info_hash,
            peer_id,
            max(0, downloaded),
            max(0, left),
            max(0, uploaded),
            ev_code,
            0,
            key,
            80,
            listen_port & 0xFFFF,
        )
        sock.sendto(ann_req, target)
        pkt2, _ = sock.recvfrom(8192)
        if len(pkt2) < 20:
            if len(pkt2) >= 8:
                act_err, _ = struct.unpack("!II", pkt2[:8])
                if act_err == 3:
                    return AnnounceResult(ok=False, message=_bstr(pkt2[8:], "UDP tracker error"))
            return AnnounceResult(ok=False, message="Short UDP announce reply")
        act2, rx_tx2, interval, leechers, seeders = struct.unpack("!IIIII", pkt2[:20])
        if act2 != 1 or rx_tx2 != tx2:
            return AnnounceResult(ok=False, message="UDP announce tx mismatch")
        peers = _parse_compact_peers_v4(pkt2[20:])
        return AnnounceResult(
            ok=True,
            peers=peers,
            seeders=max(0, seeders),
            leechers=max(0, leechers),
            interval=max(60, interval),
            message=f"OK ({len(peers)} peers)",
        )
    finally:
        sock.close()


def announce_tracker(
    url: str,
    info_hash: bytes,
    peer_id: bytes,
    listen_port: int,
    uploaded: int,
    downloaded: int,
    left: int,
    event: str = "",
) -> AnnounceResult:
    low = url.lower()
    try:
        if low.startswith("udp://"):
            return announce_udp_tracker(
                url, info_hash, peer_id, listen_port, uploaded, downloaded, left, event
            )
        if low.startswith(("http://", "https://")):
            return announce_http_tracker(
                url, info_hash, peer_id, listen_port, uploaded, downloaded, left, event
            )
        return AnnounceResult(ok=False, message="Unsupported tracker scheme")
    except Exception as exc:
        msg = str(exc).strip() or exc.__class__.__name__
        if len(msg) > 64:
            msg = msg[:61] + "..."
        return AnnounceResult(ok=False, message=f"Error: {msg}")


# ---------------------------------------------------------------------------
# Disk Storage & Multi-File Piece Mapper
# ---------------------------------------------------------------------------
class DiskStorage:
    """Thread-safe random-access piece storage over single or multi-file layouts."""

    def __init__(self, download_dir: Path, meta: TorrentMeta) -> None:
        self.download_dir = Path(download_dir)
        self.meta = meta
        self._lock = threading.Lock()
        self._piece_cache: collections.OrderedDict[int, bytes] = collections.OrderedDict()
        self._max_cache_pieces = 24

    def root_target_path(self) -> Path:
        return self.download_dir / _sanitize_part(self.meta.name)

    def _file_disk_path(self, entry: TorrentFileEntry) -> Path:
        if self.meta.is_multi_file:
            base = self.download_dir / _sanitize_part(self.meta.name)
            p = base
            for pt in entry.path_parts:
                p = p / _sanitize_part(pt)
            return p
        return self.download_dir / _sanitize_part(entry.path_parts[0])

    def _piece_spans(self, piece_idx: int, length: int) -> list[tuple[TorrentFileEntry, int, int, int]]:
        """Return list of (entry, buf_offset, file_offset, span_len)."""
        p_start = piece_idx * self.meta.piece_length
        p_end = p_start + length
        spans: list[tuple[TorrentFileEntry, int, int, int]] = []
        for entry in self.meta.files:
            f_start = entry.offset
            f_end = f_start + entry.length
            if entry.length == 0:
                if f_start == p_start:
                    spans.append((entry, 0, 0, 0))
                continue
            ov_start = max(p_start, f_start)
            ov_end = min(p_end, f_end)
            if ov_start < ov_end:
                buf_off = ov_start - p_start
                file_off = ov_start - f_start
                spans.append((entry, buf_off, file_off, ov_end - ov_start))
        return spans

    def write_piece(self, piece_idx: int, data: bytes) -> None:
        with self._lock:
            self.download_dir.mkdir(parents=True, exist_ok=True)
            spans = self._piece_spans(piece_idx, len(data))
            for entry, buf_off, file_off, span_len in spans:
                fpath = self._file_disk_path(entry)
                fpath.parent.mkdir(parents=True, exist_ok=True)
                if span_len == 0:
                    if not fpath.exists():
                        fpath.touch()
                    continue
                mode = "r+b" if fpath.exists() else "w+b"
                with fpath.open(mode) as fp:
                    fp.seek(file_off)
                    fp.write(data[buf_off : buf_off + span_len])
            self._piece_cache[piece_idx] = data
            self._piece_cache.move_to_end(piece_idx)
            while len(self._piece_cache) > self._max_cache_pieces:
                self._piece_cache.popitem(last=False)

    def read_piece(self, piece_idx: int) -> Optional[bytes]:
        plen = self.meta.piece_size(piece_idx)
        if plen <= 0 and self.meta.total_size > 0:
            return None
        with self._lock:
            if piece_idx in self._piece_cache:
                self._piece_cache.move_to_end(piece_idx)
                return self._piece_cache[piece_idx]
            if plen == 0:
                return b""
            out = bytearray(plen)
            spans = self._piece_spans(piece_idx, plen)
            for entry, buf_off, file_off, span_len in spans:
                if span_len == 0:
                    continue
                fpath = self._file_disk_path(entry)
                if not fpath.is_file():
                    return None
                with fpath.open("rb") as fp:
                    fp.seek(file_off)
                    chunk = fp.read(span_len)
                    if len(chunk) != span_len:
                        return None
                    out[buf_off : buf_off + span_len] = chunk
            res = bytes(out)
            self._piece_cache[piece_idx] = res
            while len(self._piece_cache) > self._max_cache_pieces:
                self._piece_cache.popitem(last=False)
            return res

    def read_block(self, piece_idx: int, begin: int, length: int) -> Optional[bytes]:
        piece = self.read_piece(piece_idx)
        if piece is None or begin < 0 or begin + length > len(piece):
            return None
        return piece[begin : begin + length]

    def delete_data(self) -> None:
        with self._lock:
            self._piece_cache.clear()
            target = self.root_target_path()
            try:
                if target.is_dir():
                    shutil.rmtree(target, ignore_errors=True)
                elif target.exists():
                    target.unlink(missing_ok=True)
            except Exception:
                pass


