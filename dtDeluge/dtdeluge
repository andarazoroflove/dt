# ---------------------------------------------------------------------------
# Formatting Helpers
# ---------------------------------------------------------------------------
def fmt_bytes(num_bytes: float) -> str:
    n = float(max(0.0, num_bytes))
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024.0 or unit == "TB":
            if unit == "B":
                return f"{int(n)} B"
            return f"{n:.2f} {unit}" if n < 100 else f"{n:.1f} {unit}"
        n /= 1024.0
    return f"{n:.2f} TB"


def fmt_rate(bps: float) -> str:
    if bps <= 0.5:
        return "0.0 KB/s"
    kbps = bps / 1024.0
    if kbps < 1024.0:
        return f"{kbps:.1f} KB/s"
    mbps = kbps / 1024.0
    return f"{mbps:.2f} MB/s"


def fmt_eta(seconds: Optional[float]) -> str:
    if seconds is None or seconds < 0 or math.isinf(seconds):
        return "∞"
    s = int(round(seconds))
    if s < 60:
        return f"{s}s remaining"
    m, sec = divmod(s, 60)
    if m < 60:
        return f"{m}m {sec:02d}s remaining"
    h, m = divmod(m, 60)
    if h < 48:
        return f"{h}h {m:02d}m remaining"
    d, h = divmod(h, 24)
    return f"{d}d {h}h remaining"


def _bstr(val: Any, default: str = "") -> str:
    if isinstance(val, bytes):
        return val.decode("utf-8", errors="replace")
    if isinstance(val, str):
        return val
    return default


# ---------------------------------------------------------------------------
# Pure-Python Bencode Encoder & Decoder (with exact info-slice extraction)
# ---------------------------------------------------------------------------
class BencodeError(ValueError):
    pass


def bencode(obj: Any) -> bytes:
    if isinstance(obj, bool):
        return b"i1e" if obj else b"i0e"
    if isinstance(obj, int):
        return f"i{obj}e".encode("ascii")
    if isinstance(obj, (bytes, bytearray, memoryview)):
        b = bytes(obj)
        return f"{len(b)}:".encode("ascii") + b
    if isinstance(obj, str):
        b = obj.encode("utf-8")
        return f"{len(b)}:".encode("ascii") + b
    if isinstance(obj, (list, tuple)):
        return b"l" + b"".join(bencode(item) for item in obj) + b"e"
    if isinstance(obj, dict):
        norm_items: list[tuple[bytes, Any]] = []
        for k, v in obj.items():
            kb = k if isinstance(k, bytes) else str(k).encode("utf-8")
            norm_items.append((kb, v))
        norm_items.sort(key=lambda kv: kv[0])
        out = [b"d"]
        for kb, v in norm_items:
            out.append(bencode(kb))
            out.append(bencode(v))
        out.append(b"e")
        return b"".join(out)
    raise BencodeError(f"Unsupported type for bencode: {type(obj)!r}")


def bdecode_at(data: bytes, idx: int = 0) -> tuple[Any, int]:
    n = len(data)
    if idx >= n:
        raise BencodeError("Unexpected EOF in bencoded data")
    ch = data[idx : idx + 1]
    if ch == b"i":
        end = data.find(b"e", idx + 1)
        if end == -1:
            raise BencodeError("Unterminated integer")
        num_s = data[idx + 1 : end]
        if not num_s or (num_s.startswith(b"0") and len(num_s) > 1) or num_s == b"-0":
            raise BencodeError(f"Invalid bencode integer: {num_s!r}")
        return int(num_s), end + 1
    if ch == b"l":
        idx += 1
        arr: list[Any] = []
        while idx < n and data[idx : idx + 1] != b"e":
            val, idx = bdecode_at(data, idx)
            arr.append(val)
        if idx >= n:
            raise BencodeError("Unterminated list")
        return arr, idx + 1
    if ch == b"d":
        idx += 1
        dct: dict[bytes, Any] = {}
        while idx < n and data[idx : idx + 1] != b"e":
            key, idx = bdecode_at(data, idx)
            if not isinstance(key, bytes):
                raise BencodeError("Dictionary key must be byte string")
            val, idx = bdecode_at(data, idx)
            dct[key] = val
        if idx >= n:
            raise BencodeError("Unterminated dict")
        return dct, idx + 1
    if b"0" <= ch <= b"9":
        colon = data.find(b":", idx)
        if colon == -1:
            raise BencodeError("Missing colon in byte string")
        slen = int(data[idx:colon])
        start = colon + 1
        end = start + slen
        if end > n:
            raise BencodeError("Byte string truncated")
        return data[start:end], end
    raise BencodeError(f"Invalid token {ch!r} at offset {idx}")


def bdecode(data: bytes) -> Any:
    val, end = bdecode_at(data, 0)
    if end != len(data):
        # Some tracker/extension payloads have trailing bytes (e.g. BEP-9 data);
        # use bdecode_at when trailing payload is expected.
        raise BencodeError(f"Trailing {len(data) - end} bytes after bencoded value")
    return val


def extract_top_info_slice(torrent_bytes: bytes) -> tuple[dict[bytes, Any], bytes]:
    """Decode top-level .torrent dict and return (root_dict, exact_raw_info_bytes)."""
    if not torrent_bytes.startswith(b"d"):
        raise BencodeError("Not a bencoded .torrent dictionary")
    idx = 1
    n = len(torrent_bytes)
    root: dict[bytes, Any] = {}
    raw_info = b""
    while idx < n and torrent_bytes[idx : idx + 1] != b"e":
        key, idx = bdecode_at(torrent_bytes, idx)
        if not isinstance(key, bytes):
            raise BencodeError("Invalid key in .torrent")
        val_start = idx
        val, idx = bdecode_at(torrent_bytes, idx)
        if key == b"info":
            raw_info = torrent_bytes[val_start:idx]
        root[key] = val
    if not raw_info or b"info" not in root:
        raise BencodeError("Missing 'info' dictionary in .torrent")
    return root, raw_info


