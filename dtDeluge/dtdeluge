AZUREUS_CLIENTS: dict[str, str] = {
    "TR": "Transmission",
    "qB": "qBittorrent",
    "DE": "Deluge",
    "DD": "dtDeluge",
    "LT": "libtorrent",
    "lt": "rTorrent",
    "UT": "µTorrent",
    "UM": "µTorrent Mac",
    "BT": "BitTorrent",
    "AZ": "Vuze",
    "AR": "aria2",
    "KT": "KTorrent",
    "WW": "WebTorrent",
    "TL": "Tribler",
    "FD": "Free Download Mgr",
    "XF": "Xfplay",
    "PI": "PicoTorrent",
}


def decode_peer_client(peer_id: bytes, ext_v: str = "") -> str:
    if ext_v.strip():
        return ext_v.strip()[:32]
    if len(peer_id) == 20 and peer_id[0:1] == b"-" and peer_id[7:8] == b"-":
        code = peer_id[1:3].decode("ascii", errors="ignore")
        ver_raw = peer_id[3:7].decode("ascii", errors="ignore")
        cname = AZUREUS_CLIENTS.get(code, f"Client {code}")
        digits = [c for c in ver_raw if c.isalnum() and c != "0" or ver_raw.startswith(c)]
        ver = ".".join(ver_raw.rstrip("0")[:3]) if ver_raw.isdigit() else ver_raw
        return f"{cname} {ver}".strip()
    if peer_id.startswith(b"M"):
        return "BitTorrent Mainline"
    return "BitTorrent Peer"


class RateMeter:
    """Thread-safe rolling 3.5-second byte throughput meter."""

    def __init__(self, window_s: float = 3.5) -> None:
        self._window = window_s
        self._lock = threading.Lock()
        self._samples: collections.deque[tuple[float, int]] = collections.deque()

    def add(self, nbytes: int) -> None:
        if nbytes <= 0:
            return
        now = time.monotonic()
        with self._lock:
            self._samples.append((now, nbytes))
            cutoff = now - self._window
            while self._samples and self._samples[0][0] < cutoff:
                self._samples.popleft()

    def rate(self) -> float:
        now = time.monotonic()
        with self._lock:
            cutoff = now - self._window
            while self._samples and self._samples[0][0] < cutoff:
                self._samples.popleft()
            if not self._samples:
                return 0.0
            total = sum(b for _, b in self._samples)
            span = max(0.6, now - self._samples[0][0])
            return total / min(self._window, span + 0.25)


# ---------------------------------------------------------------------------
# Piece Assembly Buffer & BitTorrent Peer Wire + BEP-9/BEP-10 Engine
# ---------------------------------------------------------------------------
class PieceAssembly:
    def __init__(self, piece_idx: int, piece_size: int) -> None:
        self.piece_idx = piece_idx
        self.piece_size = piece_size
        self.num_blocks = max(1, math.ceil(piece_size / BLOCK_SIZE))
        self.buf = bytearray(piece_size)
        # 0 = missing, 1 = in-flight, 2 = received
        self.states = [0] * self.num_blocks
        self.req_ts = [0.0] * self.num_blocks

    def block_spec(self, blk_idx: int) -> tuple[int, int]:
        begin = blk_idx * BLOCK_SIZE
        length = min(BLOCK_SIZE, self.piece_size - begin)
        return begin, max(0, length)

    def next_requestable_block(self, now: float) -> Optional[tuple[int, int, int]]:
        for i in range(self.num_blocks):
            if self.states[i] == 0 or (self.states[i] == 1 and now - self.req_ts[i] > 10.0):
                self.states[i] = 1
                self.req_ts[i] = now
                begin, length = self.block_spec(i)
                return i, begin, length
        return None

    def put_block(self, begin: int, data: bytes) -> bool:
        if begin % BLOCK_SIZE != 0:
            return False
        blk_idx = begin // BLOCK_SIZE
        if blk_idx < 0 or blk_idx >= self.num_blocks:
            return False
        _, expected_len = self.block_spec(blk_idx)
        if len(data) != expected_len:
            return False
        self.buf[begin : begin + len(data)] = data
        self.states[blk_idx] = 2
        return all(st == 2 for st in self.states)


class PeerConnection:
    """Single TCP BitTorrent Peer Wire session (supports BEP-10 & BEP-9 ut_metadata)."""

    EXT_UT_METADATA_LOCAL_ID = 1

    def __init__(
        self,
        transfer: "TorrentTransfer",
        host: str,
        port: int,
        sock: Optional[socket.socket] = None,
        incoming: bool = False,
        remote_peer_id: bytes = b"",
        remote_reserved: bytes = b"\x00" * 8,
    ) -> None:
        self.transfer = transfer
        self.host = host
        self.port = port
        self.sock = sock
        self.incoming = incoming
        self.peer_id: bytes = remote_peer_id
        self.reserved: bytes = remote_reserved
        self.client_name: str = "Connecting..."
        self.ext_version: str = ""

        self.am_choking: bool = True
        self.am_interested: bool = False
        self.peer_choking: bool = True
        self.peer_interested: bool = False
        self.supports_extensions: bool = bool(
            len(remote_reserved) == 8 and (remote_reserved[5] & 0x10)
        )
        self.peer_ut_metadata_id: int = 0

        self.peer_bitfield: list[bool] = []
        self.peer_have_count: int = 0
        self.inflight: set[tuple[int, int, int]] = set()
        self.down_meter = RateMeter()
        self.up_meter = RateMeter()
        self.alive: bool = True

        self._send_lock = threading.Lock()
        self._stop = threading.Event()
        self._thread = threading.Thread(
            target=self._run, name=f"Peer-{host}:{port}", daemon=True
        )

    def start(self) -> None:
        self._thread.start()

    def stop(self) -> None:
        self._stop.set()
        self.alive = False
        s = self.sock
        if s is not None:
            try:
                s.shutdown(socket.SHUT_RDWR)
            except Exception:
                pass
            try:
                s.close()
            except Exception:
                pass

    @property
    def address_label(self) -> str:
        return f"[{self.host}]:{self.port}" if ":" in self.host else f"{self.host}:{self.port}"

    @property
    def progress_pct(self) -> float:
        np = self.transfer.meta.num_pieces
        if np <= 0 or not self.peer_bitfield:
            return 0.0
        return 100.0 * min(np, self.peer_have_count) / np

    @property
    def flags_str(self) -> str:
        fl = []
        if not self.peer_choking and self.am_interested:
            fl.append("D")
        elif self.am_interested:
            fl.append("d")
        if not self.am_choking and self.peer_interested:
            fl.append("U")
        elif self.peer_interested:
            fl.append("u")
        if self.supports_extensions:
            fl.append("E")
        if self.incoming:
            fl.append("I")
        return "".join(fl) or "-"

    def _recv_exact(self, n: int) -> bytes:
        assert self.sock is not None
        buf = bytearray()
        while len(buf) < n:
            if self._stop.is_set() or self.transfer.is_stopped_or_paused():
                raise ConnectionError("Peer stopped")
            try:
                chunk = self.sock.recv(n - len(buf))
            except socket.timeout:
                # Periodic housekeeping while idle
                self._tick_housekeeping()
                continue
            if not chunk:
                raise EOFError("Peer closed connection")
            buf.extend(chunk)
        return bytes(buf)

    def _send_raw(self, payload: bytes) -> None:
        s = self.sock
        if s is None or self._stop.is_set():
            return
        with self._send_lock:
            s.sendall(payload)

    def send_msg(self, msg_id: int, body: bytes = b"") -> None:
        pkt = struct.pack("!IB", 1 + len(body), msg_id) + body
        self._send_raw(pkt)

    def send_have(self, piece_idx: int) -> None:
        try:
            self.send_msg(4, struct.pack("!I", piece_idx))
        except Exception:
            pass

    def _send_bitfield(self) -> None:
        bf_bytes = self.transfer.pack_bitfield()
        if bf_bytes and any(bf_bytes):
            self.send_msg(5, bf_bytes)

    def _send_ext_handshake(self) -> None:
        d: dict[str, Any] = {
            "m": {"ut_metadata": self.EXT_UT_METADATA_LOCAL_ID},
            "p": self.transfer.engine.listen_port,
            "v": CLIENT_BANNER,
        }
        if self.transfer.meta.has_metadata and self.transfer.meta.raw_info_bytes:
            d["metadata_size"] = len(self.transfer.meta.raw_info_bytes)
        self.send_msg(20, bytes([0]) + bencode(d))

    def _unchoke_peer(self) -> None:
        if self.am_choking:
            self.am_choking = False
            self.send_msg(1)

    def _update_interest_and_pipeline(self) -> None:
        if not self.transfer.meta.has_metadata:
            self._request_next_metadata_piece()
            return
        np = self.transfer.meta.num_pieces
        if len(self.peer_bitfield) < np:
            self.peer_bitfield.extend([False] * (np - len(self.peer_bitfield)))

        wants = self.transfer.peer_has_wanted_piece(self.peer_bitfield)
        if wants and not self.am_interested:
            self.am_interested = True
            self.send_msg(2)  # interested
        elif not wants and self.am_interested and not self.inflight:
            self.am_interested = False
            self.send_msg(3)  # not interested

        if self.am_interested and not self.peer_choking:
            while len(self.inflight) < PIPELINE_DEPTH:
                req = self.transfer.checkout_block_for_peer(self.peer_bitfield, self.inflight)
                if req is None:
                    break
                p_idx, begin, length = req
                self.inflight.add(req)
                self.send_msg(6, struct.pack("!III", p_idx, begin, length))

    def _request_next_metadata_piece(self) -> None:
        if self.peer_ut_metadata_id <= 0 or self.transfer.meta.has_metadata:
            return
        mp = self.transfer.checkout_metadata_piece()
        if mp is not None:
            payload = bencode({"msg_type": 0, "piece": mp})
            self.send_msg(20, bytes([self.peer_ut_metadata_id]) + payload)

    def _handle_extended(self, body: bytes) -> None:
        if not body:
            return
        ext_id = body[0]
        rest = body[1:]
        if ext_id == 0:
            hdr, _ = bdecode_at(rest, 0)
            if isinstance(hdr, dict):
                m_dict = hdr.get(b"m")
                if isinstance(m_dict, dict):
                    self.peer_ut_metadata_id = int(m_dict.get(b"ut_metadata", 0) or 0)
                v_str = _bstr(hdr.get(b"v"))
                if v_str:
                    self.ext_version = v_str
                    self.client_name = decode_peer_client(self.peer_id, self.ext_version)
                meta_sz = int(hdr.get(b"metadata_size", 0) or 0)
                if meta_sz > 0 and not self.transfer.meta.has_metadata:
                    self.transfer.init_metadata_assembly(meta_sz)
                    self._request_next_metadata_piece()
        elif ext_id == self.EXT_UT_METADATA_LOCAL_ID:
            msg_dict, end_idx = bdecode_at(rest, 0)
            if not isinstance(msg_dict, dict):
                return
            msg_type = int(msg_dict.get(b"msg_type", -1))
            piece = int(msg_dict.get(b"piece", -1))
            if msg_type == 0:
                # Peer requested metadata slice from us (BEP-9)
                raw_info = self.transfer.meta.raw_info_bytes
                if (
                    self.peer_ut_metadata_id > 0
                    and self.transfer.meta.has_metadata
                    and raw_info
                    and piece >= 0
                ):
                    start = piece * METADATA_PIECE_SIZE
                    chunk = raw_info[start : start + METADATA_PIECE_SIZE]
                    if chunk:
                        resp = bencode(
                            {
                                "msg_type": 1,
                                "piece": piece,
                                "total_size": len(raw_info),
                            }
                        ) + chunk
                        self.send_msg(20, bytes([self.peer_ut_metadata_id]) + resp)
                    else:
                        rej = bencode({"msg_type": 2, "piece": piece})
                        self.send_msg(20, bytes([self.peer_ut_metadata_id]) + rej)
            elif msg_type == 1 and piece >= 0:
                # Received metadata slice!
                slice_bytes = rest[end_idx:]
                completed = self.transfer.put_metadata_piece(piece, slice_bytes)
                if completed:
                    self._update_interest_and_pipeline()
                else:
                    self._request_next_metadata_piece()

    def _tick_housekeeping(self) -> None:
        if not self.peer_choking and self.am_interested and len(self.inflight) < PIPELINE_DEPTH:
            self._update_interest_and_pipeline()

    def _run(self) -> None:
        last_keepalive = time.monotonic()
        try:
            if not self.incoming:
                fam = socket.AF_INET6 if ":" in self.host else socket.AF_INET
                s = socket.socket(fam, socket.SOCK_STREAM)
                s.settimeout(6.0)
                s.connect((self.host, self.port))
                self.sock = s

                reserved = bytearray(8)
                reserved[5] |= 0x10  # BEP-10 Extension Protocol
                hs = (
                    bytes([19])
                    + b"BitTorrent protocol"
                    + bytes(reserved)
                    + self.transfer.meta.info_hash
                    + self.transfer.engine.peer_id
                )
                self._send_raw(hs)
                rx_hs = self._recv_exact(68)
                if rx_hs[0] != 19 or rx_hs[1:20] != b"BitTorrent protocol":
                    raise ConnectionError("Invalid BitTorrent protocol header")
                if rx_hs[28:48] != self.transfer.meta.info_hash:
                    raise ConnectionError("Infohash mismatch in peer handshake")
                self.reserved = rx_hs[20:28]
                self.peer_id = rx_hs[48:68]
                self.supports_extensions = bool(self.reserved[5] & 0x10)

            assert self.sock is not None
            self.sock.settimeout(2.0)
            self.client_name = decode_peer_client(self.peer_id, self.ext_version)
            if self.peer_id == self.transfer.engine.peer_id:
                raise ConnectionError("Self-connection ignored")

            np = self.transfer.meta.num_pieces
            self.peer_bitfield = [False] * np

            if self.supports_extensions:
                self._send_ext_handshake()
            if self.transfer.meta.has_metadata:
                self._send_bitfield()
            self._unchoke_peer()
            self._update_interest_and_pipeline()

            while not self._stop.is_set() and not self.transfer.is_stopped_or_paused():
                now = time.monotonic()
                if now - last_keepalive > 90.0:
                    self._send_raw(b"\x00\x00\x00\x00")
                    last_keepalive = now

                len_hdr = self._recv_exact(4)
                (msg_len,) = struct.unpack("!I", len_hdr)
                if msg_len == 0:
                    continue
                if msg_len > 2 * 1024 * 1024:
                    raise ConnectionError("Oversized peer wire message")
                payload = self._recv_exact(msg_len)
                msg_id = payload[0]
                body = payload[1:]

                if msg_id == 0:  # choke
                    self.peer_choking = True
                    self.transfer.release_peer_inflight(self.inflight)
                    self.inflight.clear()
                elif msg_id == 1:  # unchoke
                    self.peer_choking = False
                    self._update_interest_and_pipeline()
                elif msg_id == 2:  # interested
                    self.peer_interested = True
                    self._unchoke_peer()
                elif msg_id == 3:  # not interested
                    self.peer_interested = False
                elif msg_id == 4 and len(body) == 4:  # have
                    (p_idx,) = struct.unpack("!I", body)
                    if p_idx < len(self.peer_bitfield) and not self.peer_bitfield[p_idx]:
                        self.peer_bitfield[p_idx] = True
                        self.peer_have_count += 1
                    elif p_idx >= len(self.peer_bitfield) and p_idx < 65536:
                        self.peer_bitfield.extend([False] * (p_idx + 1 - len(self.peer_bitfield)))
                        self.peer_bitfield[p_idx] = True
                        self.peer_have_count += 1
                    self._update_interest_and_pipeline()
                elif msg_id == 5:  # bitfield
                    total_p = max(self.transfer.meta.num_pieces, len(body) * 8)
                    bf = [False] * total_p
                    cnt = 0
                    for byte_i, bval in enumerate(body):
                        for bit_i in range(8):
                            pi = byte_i * 8 + bit_i
                            if pi < total_p and (bval & (0x80 >> bit_i)):
                                bf[pi] = True
                                if pi < self.transfer.meta.num_pieces or not self.transfer.meta.has_metadata:
                                    cnt += 1
                    self.peer_bitfield = bf
                    self.peer_have_count = cnt
                    self._update_interest_and_pipeline()
                elif msg_id == 6 and len(body) == 12:  # request (seeding!)
                    req_idx, req_begin, req_len = struct.unpack("!III", body)
                    if not self.am_choking and 0 < req_len <= 65536:
                        blk = self.transfer.read_verified_block_for_upload(
                            req_idx, req_begin, req_len, self._stop
                        )
                        if blk is not None:
                            self.send_msg(7, struct.pack("!II", req_idx, req_begin) + blk)
                            self.up_meter.add(len(blk))
                elif msg_id == 7 and len(body) >= 8:  # piece
                    p_idx, begin = struct.unpack("!II", body[:8])
                    block = body[8:]
                    self.inflight.discard((p_idx, begin, len(block)))
                    self.transfer.engine.down_bucket.throttle(len(block), self._stop)
                    self.down_meter.add(len(block))
                    self.transfer.on_block_received(p_idx, begin, block)
                    self._update_interest_and_pipeline()
                elif msg_id == 20:  # BEP-10 extended
                    self._handle_extended(body)
        except Exception:
            pass
        finally:
            self.alive = False
            self.transfer.release_peer_inflight(self.inflight)
            self.inflight.clear()
            self.stop()
            self.transfer.on_peer_disconnected(self)


# ---------------------------------------------------------------------------
# TorrentTransfer & Global TorrentEngine
# ---------------------------------------------------------------------------
class TorrentTransfer:
    """Manages state, pieces, trackers, and peers for a single torrent."""

    STATE_PAUSED = "Paused"
    STATE_VERIFYING = "Verifying"
    STATE_METADATA = "Metadata"
    STATE_DOWNLOADING = "Downloading"
    STATE_SEEDING = "Seeding"
    STATE_FINISHED = "Finished"
    STATE_ERROR = "Error"

    def __init__(
        self,
        engine: "TorrentEngine",
        meta: TorrentMeta,
        download_dir: Path,
        paused: bool = False,
        uploaded_bytes: int = 0,
        added_ts: Optional[float] = None,
    ) -> None:
        self.engine = engine
        self.meta = meta
        self.download_dir = Path(download_dir)
        self.storage = DiskStorage(self.download_dir, self.meta)
        self.added_ts = added_ts or time.time()

        self._lock = threading.RLock()
        self.paused: bool = paused
        self.error_msg: str = ""
        self.verify_progress: float = 0.0
        self.verifying: bool = False

        self.have_pieces: list[bool] = [False] * self.meta.num_pieces
        self.wanted_pieces: list[bool] = [True] * self.meta.num_pieces
        self.piece_priority: list[int] = [1] * self.meta.num_pieces  # 2=High, 1=Normal, 0=Low
        self.active_assemblies: dict[int, PieceAssembly] = {}

        # Magnet BEP-9 metadata assembly
        self._meta_total_size: int = 0
        self._meta_slices: dict[int, bytes] = {}
        self._meta_requested: dict[int, float] = {}

        self.downloaded_session: int = 0
        self.uploaded_bytes: int = max(0, uploaded_bytes)
        self.verified_bytes: int = 0
        self.down_meter = RateMeter()
        self.up_meter = RateMeter()

        self.trackers: list[TrackerState] = [
            TrackerState(tier=t, url=u) for t, u in self.meta.trackers
        ]
        self.known_peers: collections.OrderedDict[tuple[str, int], float] = (
            collections.OrderedDict()
        )
        for hp in self.meta.peer_hints:
            self.known_peers[hp] = 0.0
        self.peers: dict[tuple[str, int], PeerConnection] = {}

        self._stop_event = threading.Event()
        self._completed_announced = False

        if self.meta.has_metadata:
            self._recompute_file_priorities_locked()

    # ---- Lifecycle & State ----
    def is_stopped_or_paused(self) -> bool:
        return self._stop_event.is_set() or self.paused

    @property
    def state(self) -> str:
        if self.error_msg:
            return self.STATE_ERROR
        if self.verifying:
            return self.STATE_VERIFYING
        if self.paused:
            if self.meta.has_metadata and self.is_wanted_complete():
                return self.STATE_FINISHED
            return self.STATE_PAUSED
        if not self.meta.has_metadata:
            return self.STATE_METADATA
        if self.is_wanted_complete():
            return self.STATE_SEEDING
        return self.STATE_DOWNLOADING

    @property
    def progress(self) -> float:
        if self.verifying:
            return self.verify_progress
        if not self.meta.has_metadata:
            with self._lock:
                if self._meta_total_size > 0:
                    need = math.ceil(self._meta_total_size / METADATA_PIECE_SIZE)
                    return min(0.99, len(self._meta_slices) / max(1, need))
            return 0.0
        wanted_total = self.wanted_total_bytes()
        if wanted_total <= 0:
            return 1.0 if self.meta.total_size == 0 else 0.0
        return max(0.0, min(1.0, self.wanted_completed_bytes() / wanted_total))

    @property
    def ratio(self) -> float:
        denom = max(self.verified_bytes, self.downloaded_session)
        if denom <= 0:
            return 0.0
        return self.uploaded_bytes / denom

    @property
    def down_rate(self) -> float:
        return 0.0 if self.paused else self.down_meter.rate()

    @property
    def up_rate(self) -> float:
        return 0.0 if self.paused else self.up_meter.rate()

    @property
    def eta_seconds(self) -> Optional[float]:
        if self.state != self.STATE_DOWNLOADING:
            return None
        rem = max(0, self.wanted_total_bytes() - self.wanted_completed_bytes())
        if rem == 0:
            return 0.0
        r = self.down_rate
        if r < 64.0:
            return None
        return rem / r

    def wanted_total_bytes(self) -> int:
        with self._lock:
            return sum(f.length for f in self.meta.files if f.wanted)

    def wanted_completed_bytes(self) -> int:
        with self._lock:
            return sum(f.completed_bytes for f in self.meta.files if f.wanted)

    def is_wanted_complete(self) -> bool:
        with self._lock:
            if not self.meta.has_metadata:
                return False
            if self.meta.num_pieces == 0:
                return True
            for i, w in enumerate(self.wanted_pieces):
                if w and not self.have_pieces[i]:
                    return False
            return True

    def availability_pct(self) -> float:
        with self._lock:
            np = self.meta.num_pieces
            if np <= 0:
                return 0.0
            avail = 0
            for i in range(np):
                if self.have_pieces[i] or any(
                    i < len(p.peer_bitfield) and p.peer_bitfield[i]
                    for p in self.peers.values()
                ):
                    avail += 1
            return 100.0 * avail / np

    # ---- Actions ----
    def start(self) -> None:
        with self._lock:
            self.error_msg = ""
            self.paused = False
        if self.meta.has_metadata and not any(self.have_pieces) and self._files_exist_on_disk():
            self.verify_local_data(auto_resume=True)
        else:
            self.trigger_tracker_announce(event="started")

    def pause(self) -> None:
        with self._lock:
            self.paused = True
            peers_list = list(self.peers.values())
            self.peers.clear()
            self.active_assemblies.clear()
        for p in peers_list:
            p.stop()

    def shutdown(self) -> None:
        self._stop_event.set()
        self.pause()

    def _files_exist_on_disk(self) -> bool:
        return self.storage.root_target_path().exists()

    def verify_local_data(self, auto_resume: bool = False) -> None:
        if not self.meta.has_metadata or self.verifying:
            return

        def _worker() -> None:
            with self._lock:
                was_paused = self.paused and not auto_resume
                self.verifying = True
                self.verify_progress = 0.0
            # Disconnect peers while re-verifying
            for p in list(self.peers.values()):
                p.stop()
            np = self.meta.num_pieces
            new_have = [False] * np
            for idx in range(np):
                if self._stop_event.is_set():
                    break
                raw = self.storage.read_piece(idx)
                if raw is not None and hashlib.sha1(raw).digest() == self.meta.pieces_hashes[idx]:
                    new_have[idx] = True
                with self._lock:
                    self.verify_progress = (idx + 1) / max(1, np)
            with self._lock:
                self.have_pieces = new_have
                self.active_assemblies.clear()
                self._recompute_verified_bytes_locked()
                self.verifying = False
                self.paused = was_paused
            if not was_paused and not self._stop_event.is_set():
                self.trigger_tracker_announce(event="started")

        threading.Thread(target=_worker, name="VerifyData", daemon=True).start()

    def add_tracker(self, url: str) -> bool:
        u = url.strip()
        if not u.lower().startswith(("http://", "https://", "udp://")):
            return False
        with self._lock:
            if any(t.url == u for t in self.trackers):
                return False
            tier = len(self.trackers)
            self.trackers.append(TrackerState(tier=tier, url=u))
            self.meta.trackers.append((tier, u))
        if not self.paused:
            self.trigger_tracker_announce()
        return True

    def add_peer_manual(self, host: str, port: int) -> None:
        addr = (host.strip("[]"), int(port))
        with self._lock:
            self.known_peers[addr] = 0.0
        if not self.paused:
            self.connect_more_peers()

    def set_file_wanted(self, file_idx: int, wanted: bool) -> None:
        with self._lock:
            if 0 <= file_idx < len(self.meta.files):
                self.meta.files[file_idx].wanted = wanted
                self._recompute_file_priorities_locked()

    def set_file_priority(self, file_idx: int, priority: str) -> None:
        with self._lock:
            if 0 <= file_idx < len(self.meta.files) and priority in ("High", "Normal", "Low"):
                self.meta.files[file_idx].priority = priority
                self._recompute_file_priorities_locked()

    def _recompute_file_priorities_locked(self) -> None:
        np = self.meta.num_pieces
        if np <= 0:
            return
        wanted_p = [False] * np
        prio_p = [0] * np
        pmap = {"Low": 0, "Normal": 1, "High": 2}
        plen = max(1, self.meta.piece_length)

        for entry in self.meta.files:
            if not entry.wanted:
                continue
            p_start = entry.offset // plen
            p_end = max(p_start, (max(entry.offset, entry.offset + entry.length - 1)) // plen)
            ep = pmap.get(entry.priority, 1)
            for pi in range(min(np, p_start), min(np, p_end + 1)):
                wanted_p[pi] = True
                if ep > prio_p[pi]:
                    prio_p[pi] = ep
        self.wanted_pieces = wanted_p
        self.piece_priority = prio_p
        self._recompute_verified_bytes_locked()

    def _recompute_verified_bytes_locked(self) -> None:
        if not self.meta.has_metadata:
            return
        total_v = 0
        for f in self.meta.files:
            f.completed_bytes = 0
        for pi, ok in enumerate(self.have_pieces):
            if not ok:
                continue
            psz = self.meta.piece_size(pi)
            total_v += psz
            for entry, _bo, _fo, slen in self.storage._piece_spans(pi, psz):
                entry.completed_bytes += slen
        self.verified_bytes = total_v

    # ---- Bitfield & Piece Selection ----
    def pack_bitfield(self) -> bytes:
        with self._lock:
            np = self.meta.num_pieces
            if np <= 0:
                return b""
            out = bytearray(math.ceil(np / 8))
            for i, has in enumerate(self.have_pieces):
                if has:
                    out[i >> 3] |= 0x80 >> (i & 7)
            return bytes(out)

    def peer_has_wanted_piece(self, peer_bf: list[bool]) -> bool:
        with self._lock:
            limit = min(len(peer_bf), self.meta.num_pieces)
            for i in range(limit):
                if peer_bf[i] and self.wanted_pieces[i] and not self.have_pieces[i]:
                    return True
            return False

    def checkout_block_for_peer(
        self, peer_bf: list[bool], peer_inflight: set[tuple[int, int, int]]
    ) -> Optional[tuple[int, int, int]]:
        now = time.monotonic()
        with self._lock:
            np = self.meta.num_pieces
            limit = min(len(peer_bf), np)

            # 1. Try active partial assemblies first so pieces finish rapidly
            for p_idx, asm in list(self.active_assemblies.items()):
                if p_idx < limit and peer_bf[p_idx] and not self.have_pieces[p_idx]:
                    nxt = asm.next_requestable_block(now)
                    if nxt is not None:
                        _, begin, length = nxt
                        cand = (p_idx, begin, length)
                        if cand not in peer_inflight:
                            return cand

            # 2. Pick highest-priority, rarest missing piece available on this peer
            candidates: list[tuple[int, int, int]] = []  # (-prio, rarity, piece_idx)
            peers_vals = list(self.peers.values())
            for i in range(limit):
                if (
                    peer_bf[i]
                    and self.wanted_pieces[i]
                    and not self.have_pieces[i]
                    and i not in self.active_assemblies
                ):
                    rarity = sum(
                        1 for p in peers_vals if i < len(p.peer_bitfield) and p.peer_bitfield[i]
                    )
                    candidates.append((-self.piece_priority[i], rarity, i))

            if not candidates:
                return None
            candidates.sort()
            # Slight randomness among top-tied pieces to spread swarm requests
            top_tier = [c for c in candidates if c[:2] == candidates[0][:2]]
            _, _, chosen_idx = random.choice(top_tier[:6])
            asm = PieceAssembly(chosen_idx, self.meta.piece_size(chosen_idx))
            self.active_assemblies[chosen_idx] = asm
            nxt = asm.next_requestable_block(now)
            if nxt is None:
                return None
            _, begin, length = nxt
            return (chosen_idx, begin, length)

    def release_peer_inflight(self, inflight: set[tuple[int, int, int]]) -> None:
        with self._lock:
            for p_idx, begin, _length in inflight:
                asm = self.active_assemblies.get(p_idx)
                if asm is not None:
                    blk_i = begin // BLOCK_SIZE
                    if 0 <= blk_i < asm.num_blocks and asm.states[blk_i] == 1:
                        asm.states[blk_i] = 0
                        asm.req_ts[blk_i] = 0.0

    def on_block_received(self, piece_idx: int, begin: int, block: bytes) -> None:
        self.down_meter.add(len(block))
        self.engine.global_down_meter.add(len(block))
        piece_data: Optional[bytes] = None
        expected_hash: bytes = b""

        with self._lock:
            self.downloaded_session += len(block)
            if piece_idx < 0 or piece_idx >= self.meta.num_pieces or self.have_pieces[piece_idx]:
                return
            asm = self.active_assemblies.get(piece_idx)
            if asm is None:
                asm = PieceAssembly(piece_idx, self.meta.piece_size(piece_idx))
                self.active_assemblies[piece_idx] = asm
            if asm.put_block(begin, block):
                piece_data = bytes(asm.buf)
                expected_hash = self.meta.pieces_hashes[piece_idx]
                self.active_assemblies.pop(piece_idx, None)

        if piece_data is None:
            return

        # Verify SHA-1 outside lock!
        digest = hashlib.sha1(piece_data).digest()
        if digest != expected_hash:
            return

        try:
            self.storage.write_piece(piece_idx, piece_data)
        except Exception as exc:
            with self._lock:
                self.error_msg = f"Disk write error: {exc}"
            self.pause()
            return

        just_completed_all = False
        peers_snapshot: list[PeerConnection] = []
        with self._lock:
            if not self.have_pieces[piece_idx]:
                self.have_pieces[piece_idx] = True
                psz = len(piece_data)
                self.verified_bytes += psz
                for entry, _bo, _fo, slen in self.storage._piece_spans(piece_idx, psz):
                    entry.completed_bytes += slen
                peers_snapshot = list(self.peers.values())
                if self.is_wanted_complete() and not self._completed_announced:
                    self._completed_announced = True
                    just_completed_all = True

        for p in peers_snapshot:
            p.send_have(piece_idx)
        if just_completed_all:
            self.trigger_tracker_announce(event="completed")
            self.engine.save_session_state()

    def read_verified_block_for_upload(
        self, piece_idx: int, begin: int, length: int, stop_ev: threading.Event
    ) -> Optional[bytes]:
        with self._lock:
            if (
                not self.meta.has_metadata
                or piece_idx < 0
                or piece_idx >= self.meta.num_pieces
                or not self.have_pieces[piece_idx]
            ):
                return None
        self.engine.up_bucket.throttle(length, stop_ev)
        blk = self.storage.read_block(piece_idx, begin, length)
        if blk is not None:
            with self._lock:
                self.uploaded_bytes += len(blk)
            self.up_meter.add(len(blk))
            self.engine.global_up_meter.add(len(blk))
        return blk

    # ---- BEP-9 Magnet Metadata Assembly ----
    def init_metadata_assembly(self, total_size: int) -> None:
        if total_size <= 0 or total_size > 8 * 1024 * 1024:
            return
        with self._lock:
            if not self.meta.has_metadata and self._meta_total_size == 0:
                self._meta_total_size = total_size

    def checkout_metadata_piece(self) -> Optional[int]:
        now = time.monotonic()
        with self._lock:
            if self.meta.has_metadata or self._meta_total_size <= 0:
                return None
            num = math.ceil(self._meta_total_size / METADATA_PIECE_SIZE)
            for i in range(num):
                if i not in self._meta_slices:
                    last = self._meta_requested.get(i, 0.0)
                    if now - last > 4.0:
                        self._meta_requested[i] = now
                        return i
            return None

    def put_metadata_piece(self, piece: int, data: bytes) -> bool:
        with self._lock:
            if self.meta.has_metadata or self._meta_total_size <= 0:
                return True
            self._meta_slices[piece] = data
            num = math.ceil(self._meta_total_size / METADATA_PIECE_SIZE)
            if len(self._meta_slices) < num:
                return False
            raw_info = b"".join(self._meta_slices[i] for i in range(num))

        if hashlib.sha1(raw_info).digest() != self.meta.info_hash:
            with self._lock:
                self._meta_slices.clear()
                self._meta_requested.clear()
            return False

        try:
            info_dict, _ = bdecode_at(raw_info, 0)
            if not isinstance(info_dict, dict):
                return False
            with self._lock:
                populate_meta_from_info_dict(self.meta, info_dict, raw_info)
                self.have_pieces = [False] * self.meta.num_pieces
                self.wanted_pieces = [True] * self.meta.num_pieces
                self.piece_priority = [1] * self.meta.num_pieces
                self._recompute_file_priorities_locked()
            self.engine.cache_torrent_metadata(self.meta)
            self.engine.save_session_state()
            return True
        except Exception:
            return False

    # ---- Tracker & Peer Swarm Coordination ----
    def trigger_tracker_announce(self, event: str = "") -> None:
        with self._lock:
            tr_list = list(self.trackers)
            left = max(0, self.meta.total_size - self.verified_bytes)
            up = self.uploaded_bytes
            down = self.downloaded_session

        for tr in tr_list:
            def _ann(t: TrackerState = tr) -> None:
                t.status = "Announcing..."
                res = announce_tracker(
                    url=t.url,
                    info_hash=self.meta.info_hash,
                    peer_id=self.engine.peer_id,
                    listen_port=self.engine.listen_port,
                    uploaded=up,
                    downloaded=down,
                    left=left,
                    event=event,
                )
                now = time.time()
                with self._lock:
                    t.last_announce = now
                    t.interval = res.interval
                    t.next_announce = now + res.interval
                    t.status = res.message
                    if res.ok:
                        t.seeders = res.seeders
                        t.leechers = res.leechers
                        for addr in res.peers:
                            if addr not in self.known_peers and len(self.known_peers) < 400:
                                self.known_peers[addr] = 0.0
                if res.ok and not self.paused:
                    self.connect_more_peers()

            threading.Thread(target=_ann, name="TrackerAnnounce", daemon=True).start()

    def connect_more_peers(self) -> None:
        if self.is_stopped_or_paused() or self.verifying:
            return
        max_peers = int(self.engine.settings.get("max_peers_per_torrent", 40))
        now = time.monotonic()
        to_start: list[PeerConnection] = []
        with self._lock:
            if len(self.peers) >= max_peers:
                return
            for addr, last_try in list(self.known_peers.items()):
                if len(self.peers) + len(to_start) >= max_peers:
                    break
                if addr in self.peers or now - last_try < 15.0:
                    continue
                self.known_peers[addr] = now
                pc = PeerConnection(self, addr[0], addr[1], incoming=False)
                self.peers[addr] = pc
                to_start.append(pc)
        for pc in to_start:
            pc.start()

    def accept_incoming_peer(
        self, sock: socket.socket, addr: tuple[str, int], peer_id: bytes, reserved: bytes
    ) -> None:
        max_peers = int(self.engine.settings.get("max_peers_per_torrent", 40))
        with self._lock:
            if self.is_stopped_or_paused() or self.verifying or len(self.peers) >= max_peers:
                try:
                    sock.close()
                except Exception:
                    pass
                return
            key = (addr[0], addr[1])
            pc = PeerConnection(
                self,
                addr[0],
                addr[1],
                sock=sock,
                incoming=True,
                remote_peer_id=peer_id,
                remote_reserved=reserved,
            )
            self.peers[key] = pc
        pc.start()

    def on_peer_disconnected(self, pc: PeerConnection) -> None:
        with self._lock:
            for k, v in list(self.peers.items()):
                if v is pc:
                    self.peers.pop(k, None)

    def periodic_tick(self) -> None:
        if self.is_stopped_or_paused() or self.verifying:
            return
        now = time.time()
        due = [t for t in self.trackers if t.next_announce > 0 and now >= t.next_announce]
        if due:
            self.trigger_tracker_announce()
        self.connect_more_peers()


class TorrentEngine:
    """Top-level pure-Python BitTorrent session & incoming peer TCP listener."""

    def __init__(
        self,
        config_dir: Path = CONFIG_DIR,
        listen_port: Optional[int] = None,
        persist: bool = True,
    ) -> None:
        self.config_dir = Path(config_dir)
        self.cache_dir = self.config_dir / "torrents"
        self.settings_file = self.config_dir / "settings.json"
        self.session_file = self.config_dir / "torrents.json"
        self.persist = persist

        rand_tail = "".join(
            random.choices("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", k=12)
        ).encode("ascii")
        self.peer_id: bytes = b"-DD0100-" + rand_tail
        self.settings: dict[str, Any] = dict(DEFAULT_SETTINGS)
        if self.persist:
            self._load_settings()
        if listen_port is not None:
            self.settings["listen_port"] = int(listen_port)

        self.listen_port: int = int(self.settings["listen_port"])
        self.port_open: bool = False

        self.down_bucket = TokenBucket(0)
        self.up_bucket = TokenBucket(0)
        self.global_down_meter = RateMeter()
        self.global_up_meter = RateMeter()
        self._apply_speed_limits()

        self._lock = threading.RLock()
        self.transfers: collections.OrderedDict[str, TorrentTransfer] = collections.OrderedDict()
        self._stop_event = threading.Event()
        self._server_sock: Optional[socket.socket] = None

        self._start_listener()
        self._sched_thread = threading.Thread(
            target=self._scheduler_loop, name="EngineScheduler", daemon=True
        )
        self._sched_thread.start()

        if self.persist:
            self._load_session_state()

    # ---- Settings & Persistence ----
    def _load_settings(self) -> None:
        try:
            if self.settings_file.is_file():
                loaded = json.loads(self.settings_file.read_text(encoding="utf-8"))
                if isinstance(loaded, dict):
                    self.settings.update(loaded)
        except Exception:
            pass

    def save_settings(self) -> None:
        self._apply_speed_limits()
        if not self.persist:
            return
        try:
            self.config_dir.mkdir(parents=True, exist_ok=True)
            self.settings_file.write_text(
                json.dumps(self.settings, indent=2), encoding="utf-8"
            )
        except Exception:
            pass

    def _apply_speed_limits(self) -> None:
        if self.settings.get("alt_speed_enabled"):
            dk = int(self.settings.get("alt_speed_down_kbps", 250))
            uk = int(self.settings.get("alt_speed_up_kbps", 100))
        else:
            dk = (
                int(self.settings.get("speed_limit_down_kbps", 2048))
                if self.settings.get("speed_limit_down_enabled")
                else 0
            )
            uk = (
                int(self.settings.get("speed_limit_up_kbps", 512))
                if self.settings.get("speed_limit_up_enabled")
                else 0
            )
        self.down_bucket.set_rate_kbps(dk)
        self.up_bucket.set_rate_kbps(uk)

    def cache_torrent_metadata(self, meta: TorrentMeta) -> Optional[Path]:
        if not self.persist or not meta.has_metadata or not meta.raw_info_bytes:
            return None
        try:
            self.cache_dir.mkdir(parents=True, exist_ok=True)
            info_obj, _ = bdecode_at(meta.raw_info_bytes, 0)
            root: dict[bytes, Any] = {b"info": info_obj}
            if meta.trackers:
                root[b"announce"] = meta.trackers[0][1].encode("utf-8")
                root[b"announce-list"] = [[u.encode("utf-8")] for _, u in meta.trackers]
            p = self.cache_dir / f"{meta.info_hash_hex}.torrent"
            p.write_bytes(bencode(root))
            return p
        except Exception:
            return None

    def save_session_state(self) -> None:
        if not self.persist:
            return
        try:
            self.config_dir.mkdir(parents=True, exist_ok=True)
            items = []
            with self._lock:
                for ih, tr in self.transfers.items():
                    items.append(
                        {
                            "info_hash": ih,
                            "name": tr.meta.name,
                            "magnet": tr.meta.to_magnet_uri(),
                            "download_dir": str(tr.download_dir),
                            "paused": tr.paused,
                            "uploaded_bytes": tr.uploaded_bytes,
                            "added_ts": tr.added_ts,
                            "have_hex": tr.pack_bitfield().hex(),
                            "files_prefs": [
                                {"wanted": f.wanted, "priority": f.priority}
                                for f in tr.meta.files
                            ],
                        }
                    )
            self.session_file.write_text(json.dumps(items, indent=2), encoding="utf-8")
        except Exception:
            pass

    def _load_session_state(self) -> None:
        if not self.session_file.is_file():
            return
        try:
            items = json.loads(self.session_file.read_text(encoding="utf-8"))
            if not isinstance(items, list):
                return
            for entry in items:
                ih = str(entry.get("info_hash", ""))
                cached_t = self.cache_dir / f"{ih}.torrent"
                if cached_t.is_file():
                    meta = parse_torrent_file(cached_t)
                else:
                    meta = parse_magnet_uri(entry["magnet"])
                dl_dir = Path(entry.get("download_dir") or self.settings["download_dir"])
                paused = bool(entry.get("paused", False))
                tr = TorrentTransfer(
                    self,
                    meta,
                    dl_dir,
                    paused=True,
                    uploaded_bytes=int(entry.get("uploaded_bytes", 0)),
                    added_ts=float(entry.get("added_ts", time.time())),
                )
                fprefs = entry.get("files_prefs", [])
                for idx, fp in enumerate(fprefs):
                    if idx < len(tr.meta.files) and isinstance(fp, dict):
                        tr.meta.files[idx].wanted = bool(fp.get("wanted", True))
                        tr.meta.files[idx].priority = str(fp.get("priority", "Normal"))
                if tr.meta.has_metadata:
                    have_hex = entry.get("have_hex", "")
                    if have_hex:
                        bf = bytes.fromhex(have_hex)
                        for pi in range(tr.meta.num_pieces):
                            if (pi >> 3) < len(bf) and (bf[pi >> 3] & (0x80 >> (pi & 7))):
                                tr.have_pieces[pi] = True
                    tr._recompute_file_priorities_locked()
                with self._lock:
                    self.transfers[meta.info_hash_hex] = tr
                if not paused:
                    tr.start()
        except Exception:
            pass

    # ---- TCP Incoming Listener ----
    def _start_listener(self, new_port: Optional[int] = None) -> None:
        if self._server_sock is not None:
            try:
                self._server_sock.close()
            except Exception:
                pass
            self._server_sock = None
            self.port_open = False

        desired = new_port if new_port is not None else int(self.settings["listen_port"])
        ports_to_try = [desired] if desired == 0 else [desired, 0]
        for p in ports_to_try:
            try:
                srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                srv.bind(("0.0.0.0", p))
                srv.listen(32)
                srv.settimeout(1.0)
                self._server_sock = srv
                self.listen_port = srv.getsockname()[1]
                self.port_open = True
                threading.Thread(
                    target=self._accept_loop,
                    args=(srv,),
                    name="BTListener",
                    daemon=True,
                ).start()
                break
            except Exception:
                continue

    def rebind_port(self, port: int) -> None:
        self.settings["listen_port"] = int(port)
        self._start_listener(int(port))
        self.save_settings()

    def _accept_loop(self, srv: socket.socket) -> None:
        while not self._stop_event.is_set() and srv is self._server_sock:
            try:
                conn, addr = srv.accept()
            except socket.timeout:
                continue
            except Exception:
                break
            threading.Thread(
                target=self._handshake_incoming,
                args=(conn, addr),
                name="BTIncomingHS",
                daemon=True,
            ).start()

    def _handshake_incoming(self, conn: socket.socket, addr: tuple[str, int]) -> None:
        try:
            conn.settimeout(5.0)
            hdr = bytearray()
            while len(hdr) < 48:
                ch = conn.recv(48 - len(hdr))
                if not ch:
                    conn.close()
                    return
                hdr.extend(ch)
            if hdr[0] != 19 or hdr[1:20] != b"BitTorrent protocol":
                conn.close()
                return
            remote_reserved = bytes(hdr[20:28])
            info_hash = bytes(hdr[28:48])
            with self._lock:
                tr = self.transfers.get(info_hash.hex())
            if tr is None or tr.is_stopped_or_paused():
                conn.close()
                return

            our_res = bytearray(8)
            our_res[5] |= 0x10
            reply_hs = (
                bytes([19])
                + b"BitTorrent protocol"
                + bytes(our_res)
                + info_hash
                + self.peer_id
            )
            conn.sendall(reply_hs)

            pid_buf = bytearray()
            while len(pid_buf) < 20:
                ch = conn.recv(20 - len(pid_buf))
                if not ch:
                    conn.close()
                    return
                pid_buf.extend(ch)
            tr.accept_incoming_peer(conn, addr, bytes(pid_buf), remote_reserved)
        except Exception:
            try:
                conn.close()
            except Exception:
                pass

    def _scheduler_loop(self) -> None:
        ticks = 0
        while not self._stop_event.is_set():
            self._stop_event.wait(2.5)
            if self._stop_event.is_set():
                break
            ticks += 1
            with self._lock:
                trs = list(self.transfers.values())
            for tr in trs:
                tr.periodic_tick()
            if ticks % 12 == 0:
                self.save_session_state()

    # ---- High-Level Torrent Management ----
    def add_meta(
        self,
        meta: TorrentMeta,
        download_dir: Optional[Path] = None,
        start_immediately: Optional[bool] = None,
    ) -> TorrentTransfer:
        with self._lock:
            existing = self.transfers.get(meta.info_hash_hex)
            if existing is not None:
                for tier, u in meta.trackers:
                    existing.add_tracker(u)
                for h, p in meta.peer_hints:
                    existing.add_peer_manual(h, p)
                return existing

            dl_dir = Path(download_dir or self.settings["download_dir"])
            auto = (
                bool(self.settings.get("auto_start", True))
                if start_immediately is None
                else start_immediately
            )
            tr = TorrentTransfer(self, meta, dl_dir, paused=not auto)
            self.transfers[meta.info_hash_hex] = tr

        self.cache_torrent_metadata(meta)
        self.save_session_state()
        if auto:
            tr.start()
        return tr

    def add_torrent_file(
        self, path: Path | str, download_dir: Optional[Path] = None
    ) -> TorrentTransfer:
        meta = parse_torrent_file(path)
        return self.add_meta(meta, download_dir=download_dir)

    def add_magnet_or_url(
        self, target: str, download_dir: Optional[Path] = None
    ) -> TorrentTransfer:
        s = target.strip()
        if s.lower().startswith("magnet:?"):
            meta = parse_magnet_uri(s)
            return self.add_meta(meta, download_dir=download_dir)
        if s.lower().startswith(("http://", "https://")):
            req = urllib.request.Request(s, headers={"User-Agent": HTTP_UA})
            with urllib.request.urlopen(req, timeout=12.0) as resp:
                raw = resp.read(10 * 1024 * 1024)
            meta = parse_torrent_bytes(raw)
            return self.add_meta(meta, download_dir=download_dir)
        if s.startswith("file://"):
            p = Path(urllib.parse.unquote(urllib.parse.urlparse(s).path))
            return self.add_torrent_file(p, download_dir=download_dir)
        return self.add_torrent_file(Path(s), download_dir=download_dir)

    def remove_transfer(self, info_hash_hex: str, delete_data: bool = False) -> None:
        with self._lock:
            tr = self.transfers.pop(info_hash_hex, None)
        if tr is None:
            return
        tr.shutdown()
        if delete_data:
            tr.storage.delete_data()
        if self.persist:
            cached = self.cache_dir / f"{info_hash_hex}.torrent"
            cached.unlink(missing_ok=True)
            self.save_session_state()

    def shutdown(self) -> None:
        self._stop_event.set()
        if self._server_sock is not None:
            try:
                self._server_sock.close()
            except Exception:
                pass
        with self._lock:
            trs = list(self.transfers.values())
        for tr in trs:
            tr.shutdown()
        self.save_session_state()


