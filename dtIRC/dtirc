    def _build_mirc_popover(self) -> Gtk.Popover:
        pop = Gtk.Popover()
        vb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=8)
        hb_fmt = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        for lbl, code in [("Bold (^B)", "\x02"), ("Italic (^I)", "\x1d"), ("Underline (^U)", "\x1f"), ("Reset (^O)", "\x0f")]:
            b = Gtk.Button(label=lbl)
            b.connect("clicked", lambda _b, c=code: (self._insert_input_text(c), pop.popdown()))
            hb_fmt.pack_start(b, False, False, 0)
        vb.pack_start(hb_fmt, False, False, 0)

        vb.pack_start(Gtk.Label(label="Insert mIRC Color Code (00–15):", xalign=0), False, False, 0)
        grid = Gtk.Grid(column_spacing=3, row_spacing=3)
        for idx in range(16):
            fg_hex = MIRC_FG_CREAM[idx]
            b = Gtk.Button(label=f"{idx:02d}")
            p = Gtk.CssProvider()
            bg_c = "#334155" if idx == 0 else self.well_hex
            p.load_from_data(f"button {{ background-color: {bg_c}; color: {fg_hex}; font-weight: bold; min-width: 28px; }}".encode())
            b.get_style_context().add_provider(p, Gtk.STYLE_PROVIDER_PRIORITY_USER)
            b.connect("clicked", lambda _b, code=idx: (self._insert_input_text(f"\x03{code:02d}"), pop.popdown()))
            grid.attach(b, idx % 8, idx // 8, 1, 1)
        vb.pack_start(grid, False, False, 0)
        vb.show_all()
        pop.add(vb)
        return pop

