# ---------------------------------------------------------------------------
# mIRC Formatting Parser & Tokenizer
# ---------------------------------------------------------------------------
MIRC_COLOR_RE = re.compile(r"^\x03(\d{1,2})?(?:,(\d{1,2}))?")
URL_RE = re.compile(r"(https?://[^\s<>()\"']+)")


def strip_mirc_codes(text: str) -> str:
    s = re.sub(r"\x03\d{0,2}(?:,\d{1,2})?", "", text)
    return re.sub(r"[\x02\x1d\x1f\x16\x0f]", "", s)


def parse_mirc_spans(text: str) -> list[tuple[str, dict]]:
    """
    Parse mIRC control codes into [(substring, style_dict), ...].
    Handles \x02 (bold), \x1D (italic), \x1F (underline), \x16 (reverse),
    \x03FG,BG (colors 00-99), and \x0F (reset).
    """
    spans: list[tuple[str, dict]] = []
    cur_style = {"bold": False, "italic": False, "underline": False, "reverse": False, "fg": None, "bg": None}
    buf = []
    i = 0
    n = len(text)

    def _flush():
        if buf:
            spans.append(("".join(buf), dict(cur_style)))
            buf.clear()

    while i < n:
        ch = text[i]
        if ch == "\x02":
            _flush(); cur_style["bold"] = not cur_style["bold"]; i += 1
        elif ch == "\x1d":
            _flush(); cur_style["italic"] = not cur_style["italic"]; i += 1
        elif ch == "\x1f":
            _flush(); cur_style["underline"] = not cur_style["underline"]; i += 1
        elif ch == "\x16":
            _flush(); cur_style["reverse"] = not cur_style["reverse"]; i += 1
        elif ch == "\x0f":
            _flush()
            cur_style = {"bold": False, "italic": False, "underline": False, "reverse": False, "fg": None, "bg": None}
            i += 1
        elif ch == "\x03":
            _flush()
            m = MIRC_COLOR_RE.match(text[i:])
            if m:
                fg_s, bg_s = m.group(1), m.group(2)
                if fg_s is None and bg_s is None:
                    cur_style["fg"] = None
                    cur_style["bg"] = None
                else:
                    if fg_s is not None:
                        cur_style["fg"] = int(fg_s)
                    if bg_s is not None:
                        cur_style["bg"] = int(bg_s)
                i += m.end()
            else:
                i += 1
        else:
            buf.append(ch)
            i += 1

    _flush()
    return spans


# ---------------------------------------------------------------------------
# IRC Protocol Line Parser (RFC 1459 / IRCv3)
# ---------------------------------------------------------------------------
def parse_irc_line(line: str) -> tuple[str, str, list[str]]:
    """Return (prefix, command, params_list)."""
    s = line.rstrip("\r\n")
    if s.startswith("@"):
        # Strip IRCv3 message tags if any
        sp = s.find(" ")
        s = s[sp + 1:].lstrip() if sp != -1 else ""
    prefix = ""
    if s.startswith(":"):
        sp = s.find(" ")
        if sp != -1:
            prefix = s[1:sp]
            s = s[sp + 1:].lstrip()
        else:
            return s[1:], "", []

    trailing = None
    if " :" in s:
        idx = s.find(" :")
        trailing = s[idx + 2:]
        s = s[:idx]
    elif s.startswith(":"):
        trailing = s[1:]
        s = ""

    parts = s.split() if s else []
    cmd = parts.pop(0).upper() if parts else ""
    if trailing is not None:
        parts.append(trailing)
    return prefix, cmd, parts


def split_prefix(prefix: str) -> tuple[str, str, str]:
    """Split nick!user@host -> (nick, user, host)."""
    if "!" in prefix:
        nick, rest = prefix.split("!", 1)
        if "@" in rest:
            user, host = rest.split("@", 1)
            return nick, user, host
        return nick, rest, ""
    return prefix, "", ""


