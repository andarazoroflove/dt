    # ---------------- Buffer & Tab Management ----------------
    def _buf_key(self, name: str) -> str:
        return name.lower()

    def _ensure_buffer(self, name: str, kind: str, switch: bool = False) -> IrcBuffer:
        key = self._buf_key(name)
        if key not in self.buffers:
            buf = IrcBuffer(name, kind)
            buf.textview.connect("button-release-event", self._on_chat_click_url)
            self.buffers[key] = buf
            self.buffer_order.append(key)
            self.chat_stack.add_named(buf.scroll, key)
            buf.scroll.show_all()
            self._rebuild_tab_bar()
        buf = self.buffers[key]
        if switch:
            self.switch_buffer(key)
        return buf

    def switch_buffer(self, key: str):
        if key not in self.buffers:
            return
        self.active_buf_key = key
        buf = self.buffers[key]
        buf.unread = False
        buf.highlight = False
        self.chat_stack.set_visible_child_name(key)
        self.lbl_chan_badge.set_markup(f"<b>{GLib.markup_escape_text(buf.name)}</b>")

        is_chan = buf.kind == "channel"
        self.ent_topic.set_sensitive(is_chan)
        self.btn_set_topic.set_sensitive(is_chan)
        self.ent_topic.set_text(strip_mirc_codes(buf.topic) if is_chan else f"Connected to {self.cfg['host']}:{self.cfg['port']}")
        self.ent_topic.set_tooltip_text(buf.topic_meta or "Channel Topic")

        self._rebuild_user_list()
        self._rebuild_tab_bar()
        self._scroll_to_bottom(buf)
        self.ent_input.grab_focus()

    def close_active_buffer(self):
        if not self.active_buf_key or self.active_buf_key == "*libera.chat*":
            return
        buf = self.buffers[self.active_buf_key]
        if buf.kind == "channel" and self.connected:
            self.send_raw(f"PART {buf.name} :dtIRC — Common Desktop Environment")
        self._remove_buffer(self.active_buf_key)

    def _remove_buffer(self, key: str):
        if key not in self.buffers or key == "*libera.chat*":
            return
        buf = self.buffers.pop(key)
        if key in self.buffer_order:
            self.buffer_order.remove(key)
        self.chat_stack.remove(buf.scroll)
        if self.active_buf_key == key:
            self.switch_buffer(self.buffer_order[-1] if self.buffer_order else "*libera.chat*")
        else:
            self._rebuild_tab_bar()

    def _rebuild_tab_bar(self):
        for ch in self.tab_box.get_children():
            self.tab_box.remove(ch)
        for key in self.buffer_order:
            buf = self.buffers[key]
            prefix = "★ " if buf.highlight else ("• " if buf.unread else "")
            tb = Gtk.ToggleButton(label=f"{prefix}{buf.name}")
            tb.set_active(key == self.active_buf_key)
            ctx = tb.get_style_context()
            if buf.highlight and key != self.active_buf_key:
                ctx.add_class("cde-tab-ping")
            elif buf.unread and key != self.active_buf_key:
                ctx.add_class("cde-tab-unread")
            tb.connect("clicked", lambda _b, k=key: self.switch_buffer(k))
            self.tab_box.pack_start(tb, False, False, 0)
        self.tab_box.show_all()

    def clear_active_buffer(self):
        if self.active_buf_key in self.buffers:
            self.buffers[self.active_buf_key].textbuf.set_text("")

    # ---------------- Rendering mIRC Spans & Messages into Cream TextBuffer ----------------
    def _get_style_tag(self, buf: IrcBuffer, style: dict, extra_fg: str | None = None, url: str | None = None) -> Gtk.TextTag:
        fg_code = style.get("fg")
        bg_code = style.get("bg")
        rev = style.get("reverse", False)
        bold = style.get("bold", False)
        ital = style.get("italic", False)
        und = style.get("underline", False) or bool(url)

        fg_hex = extra_fg
        bg_hex = None
        if fg_code is not None:
            fg_hex = get_mirc_fg(fg_code)
            # If mIRC 00 (White) is used on cream with no explicit BG, give it a dark slate pill so it's readable!
            if fg_code == 0 and bg_code is None:
                bg_hex = "#334155"
        if bg_code is not None:
            bg_hex = get_mirc_bg(bg_code)

        if rev:
            fg_hex, bg_hex = (bg_hex or self.well_hex), (fg_hex or "#101218")

        if url and not fg_hex:
            fg_hex = "#1D4ED8"

        key = (fg_hex, bg_hex, bold, ital, und, url)
        if key in buf._tag_cache:
            return buf._tag_cache[key]

        tag = buf.textbuf.create_tag(None)
        if fg_hex:
            tag.set_property("foreground", fg_hex)
        if bg_hex:
            tag.set_property("background", bg_hex)
        if bold:
            tag.set_property("weight", Pango.Weight.BOLD)
        if ital:
            tag.set_property("style", Pango.Style.ITALIC)
        if und:
            tag.set_property("underline", Pango.Underline.SINGLE)
        if url:
            tag.url_target = url
        buf._tag_cache[key] = tag
        return tag

    def _insert_mirc_text(self, buf: IrcBuffer, text: str, default_fg: str | None = None, bold_all: bool = False):
        tb = buf.textbuf
        for chunk, style in parse_mirc_spans(text):
            if bold_all:
                style = dict(style, bold=True)
            # Detect clickable URLs inside chunk
            pos = 0
            for m in URL_RE.finditer(chunk):
                if m.start() > pos:
                    plain = chunk[pos:m.start()]
                    tag = self._get_style_tag(buf, style, extra_fg=default_fg)
                    tb.insert_with_tags(tb.get_end_iter(), plain, tag)
                u = m.group(1)
                utag = self._get_style_tag(buf, style, extra_fg=default_fg, url=u)
                tb.insert_with_tags(tb.get_end_iter(), u, utag)
                pos = m.end()
            if pos < len(chunk):
                rem = chunk[pos:]
                tag = self._get_style_tag(buf, style, extra_fg=default_fg)
                tb.insert_with_tags(tb.get_end_iter(), rem, tag)

    def _scroll_to_bottom(self, buf: IrcBuffer):
        adj = buf.scroll.get_vadjustment()
        GLib.idle_add(lambda: adj.set_value(max(0.0, adj.get_upper() - adj.get_page_size())) or False)

    def _append_line(self, buf: IrcBuffer, prefix_str: str, prefix_col: str, body: str,
                     body_fg: str | None = None, is_highlight: bool = False):
        tb = buf.textbuf
        if tb.get_char_count() > 0:
            tb.insert(tb.get_end_iter(), "\n")

        ts = datetime.datetime.now().strftime("%H:%M:%S")
        ts_tag = self._get_style_tag(buf, {"bold": False}, extra_fg="#64748B")
        tb.insert_with_tags(tb.get_end_iter(), f"[{ts}] ", ts_tag)

        if prefix_str:
            p_style = {"bold": True, "bg": 8 if is_highlight else None}
            p_tag = self._get_style_tag(buf, p_style, extra_fg=prefix_col)
            tb.insert_with_tags(tb.get_end_iter(), f"{prefix_str} ", p_tag)

        self._insert_mirc_text(buf, body, default_fg=body_fg, bold_all=is_highlight)

        if self._buf_key(buf.name) != self.active_buf_key:
            buf.unread = True
            if is_highlight:
                buf.highlight = True
            self._rebuild_tab_bar()
        else:
            self._scroll_to_bottom(buf)

    def _append_system(self, buf: IrcBuffer, msg: str, color: str = "#334155"):
        for ln in msg.splitlines():
            self._append_line(buf, "•••", "#2B5B84", ln, body_fg=color)

    def _on_chat_click_url(self, tv, ev):
        if ev.button != 1:
            return False
        bx, by = tv.window_to_buffer_coords(Gtk.TextWindowType.WIDGET, int(ev.x), int(ev.y))
        ok, it = tv.get_iter_at_location(bx, by)
        if ok:
            for tag in it.get_tags():
                u = getattr(tag, "url_target", None)
                if u:
                    webbrowser.open(u)
                    return True
        return False

    # ---------------- Left-Hand User List & Right-Click Op Context Menu ----------------
    def _rebuild_user_list(self):
        self.user_store.clear()
        buf = self.buffers.get(self.active_buf_key)
        if not buf or buf.kind != "channel":
            self.lbl_users_hdr.set_text("  Users (—)")
            return

        entries = []
        for lnick, dnick in buf.display_nicks.items():
            pref = buf.highest_prefix(lnick)
            entries.append((RANK_ORDER.get(pref, 5), dnick.lower(), pref, dnick))
        entries.sort(key=lambda t: (t[0], t[1]))

        self.lbl_users_hdr.set_text(f"  Users ({len(entries)})")
        for _rk, _low, pref, dnick in entries:
            if pref in ("~", "&", "@"):
                col = "#166534"  # Emerald Op badge
                wt = int(Pango.Weight.BOLD)
            elif pref == "%":
                col = "#0369A1"
                wt = int(Pango.Weight.BOLD)
            elif pref == "+":
                col = "#8A5A00"
                wt = int(Pango.Weight.NORMAL)
            else:
                col = "#101218"
                wt = int(Pango.Weight.NORMAL)
            self.user_store.append([pref, dnick, col, wt, dnick])

    def _on_user_row_activated(self, _view, path, _col):
        nick = self.user_store[path][4]
        self._ensure_buffer(nick, "query", switch=True)

    def _on_user_list_button_press(self, view, ev):
        if ev.button == 3:
            pth = view.get_path_at_pos(int(ev.x), int(ev.y))
            if pth:
                view.set_cursor(pth[0], None, False)
                nick = self.user_store[pth[0]][4]
                self._popup_user_op_menu(nick, ev)
                return True
        return False

    def _popup_user_op_menu(self, nick: str, ev):
        buf = self.buffers.get(self.active_buf_key)
        chan = buf.name if (buf and buf.kind == "channel") else ""
        uhost = self.user_hosts.get(nick.lower(), "")
        ban_mask = f"*!*@{uhost.split('@', 1)[1]}" if "@" in uhost else f"{nick}!*@*"

        menu = Gtk.Menu()

        hdr = Gtk.MenuItem(label=f"User: {nick}" + (f" ({uhost})" if uhost else ""))
        hdr.set_sensitive(False)
        menu.append(hdr)
        menu.append(Gtk.SeparatorMenuItem())

        for lbl, cb in [
            ("💬 Open Private Message (Query)", lambda *_: self._ensure_buffer(nick, "query", switch=True)),
            ("🔍 WHOIS Info",                   lambda *_: self.send_raw(f"WHOIS {nick} {nick}")),
            ("📡 CTCP VERSION",                 lambda *_: self.exec_command(f"/ctcp {nick} VERSION")),
            ("⏱ CTCP PING",                    lambda *_: self.exec_command(f"/ping {nick}")),
        ]:
            mi = Gtk.MenuItem(label=lbl); mi.connect("activate", cb); menu.append(mi)

        if chan:
            menu.append(Gtk.SeparatorMenuItem())
            op_hdr = Gtk.MenuItem(label=f"Channel Op Actions ({chan})")
            op_hdr.set_sensitive(False)
            menu.append(op_hdr)

            for lbl, cb in [
                ("★ Give Op (+o)",              lambda *_: self.send_raw(f"MODE {chan} +o {nick}")),
                ("☆ Take Op (-o)",              lambda *_: self.send_raw(f"MODE {chan} -o {nick}")),
                ("🔊 Give Voice (+v)",          lambda *_: self.send_raw(f"MODE {chan} +v {nick}")),
                ("🔇 Take Voice (-v)",          lambda *_: self.send_raw(f"MODE {chan} -v {nick}")),
                ("⚡ Give Half-Op (+h)",        lambda *_: self.send_raw(f"MODE {chan} +h {nick}")),
                ("▫ Take Half-Op (-h)",         lambda *_: self.send_raw(f"MODE {chan} -h {nick}")),
                ("-", None),
                ("🥾 Kick from Channel...",     lambda *_: self._prompt_kick(chan, nick, also_ban=False)),
                (f"🚫 Ban ({ban_mask})",        lambda *_: self.send_raw(f"MODE {chan} +b {ban_mask}")),
                ("💥 Kick + Ban!",              lambda *_: self._prompt_kick(chan, nick, also_ban=True, mask=ban_mask)),
                (f"🤐 Quiet (+q {ban_mask})",   lambda *_: self.send_raw(f"MODE {chan} +q {ban_mask}")),
                (f"🗣 Unquiet (-q {ban_mask})", lambda *_: self.send_raw(f"MODE {chan} -q {ban_mask}")),
            ]:
                if lbl == "-":
                    menu.append(Gtk.SeparatorMenuItem())
                else:
                    mi = Gtk.MenuItem(label=lbl); mi.connect("activate", cb); menu.append(mi)

        menu.append(Gtk.SeparatorMenuItem())
        is_ign = nick.lower() in self.ignored_nicks
        mi_ign = Gtk.MenuItem(label=("✔ Unignore User" if is_ign else "🚫 Ignore User"))
        mi_ign.connect("activate", lambda *_: self.exec_command(f"/{'unignore' if is_ign else 'ignore'} {nick}"))
        menu.append(mi_ign)

        mi_slap = Gtk.MenuItem(label="📘 Slap with UNIX System V Manual")
        mi_slap.connect("activate", lambda *_: self.exec_command(f"/me slaps {nick} around a bit with a hardcover CDE OSF/Motif Style Guide"))
        menu.append(mi_slap)

        menu.show_all()
        menu.popup_at_pointer(ev)

    def _prompt_kick(self, chan: str, nick: str, also_ban: bool = False, mask: str = ""):
        dlg = Gtk.Dialog(title=f"Kick {nick} from {chan} — dtIRC", transient_for=self, flags=0)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Kick", Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_spacing(8); box.set_margin_top(10); box.set_margin_bottom(10); box.set_margin_start(12); box.set_margin_end(12)
        box.pack_start(Gtk.Label(label=f"Reason for kicking {nick}:", xalign=0), False, False, 0)
        ent = Gtk.Entry(text="Requested", width_chars=38)
        ent.connect("activate", lambda *_: dlg.response(Gtk.ResponseType.OK))
        box.pack_start(ent, False, False, 0)
        dlg.show_all()
        if dlg.run() == Gtk.ResponseType.OK:
            reason = ent.get_text().strip() or nick
            dlg.destroy()
            if also_ban and mask:
                self.send_raw(f"MODE {chan} +b {mask}")
            self.send_raw(f"KICK {chan} {nick} :{reason}")
        else:
            dlg.destroy()

