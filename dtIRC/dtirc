    # ---------------- Configuration (0600 Protected) ----------------
    def _load_config(self) -> dict:
        user = getpass.getuser() or "cdeuser"
        defaults = {
            "host": DEFAULT_HOST,
            "port": DEFAULT_PORT,
            "tls": True,
            "nick": f"{user}_cde",
            "alt_nick": f"{user}_cde_",
            "username": user,
            "realname": "CDE Desktop User",
            "ns_account": "",
            "ns_password": "",
            "ns_command": "/msg NickServ IDENTIFY {account} {password}",
            "auto_identify": True,
            "auto_connect": True,
            "auto_channels": "#libera",
            "font_pt": 11,
            "ignored": [],
        }
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        if CONFIG_FILE.is_file():
            try:
                loaded = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
                defaults.update(loaded)
            except Exception:
                pass
        return defaults

    def _save_config(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        self.cfg["font_pt"] = self.font_pt
        self.cfg["ignored"] = sorted(list(self.ignored_nicks))
        tmp = CONFIG_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.cfg, indent=2), encoding="utf-8")
        os.chmod(tmp, 0o600)
        tmp.replace(CONFIG_FILE)

    def _apply_css(self):
        self.css_provider.load_from_data(
            build_cde_css(self.chrome_hex, self.sel_hex, self.well_hex, self.font_pt)
        )

