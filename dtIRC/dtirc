    # ---------------- IRC Socket, TLS, SASL PLAIN & NickServ Engine ----------------
    def _on_connect_btn(self, *_args):
        if self.connected:
            self.disconnect_irc("Reconnecting / Disconnected")
        else:
            self.connect_irc()

    def connect_irc(self, host: str | None = None, port: int | None = None, use_tls: bool | None = None):
        if self.connected:
            self.disconnect_irc("Switching server")

        h = host or self.cfg.get("host", DEFAULT_HOST)
        p = int(port or self.cfg.get("port", DEFAULT_PORT))
        tls = self.cfg.get("tls", True) if use_tls is None else use_tls

        self.current_nick = self.cfg["nick"]
        self.lbl_my_nick.set_text(f"[{self.current_nick}]")
        self._ident_sent_this_session = False
        self._sasl_in_progress = False

        srv_buf = self._ensure_buffer("*Libera.Chat*", "server")
        self._append_system(srv_buf, f"Connecting to {h}:{p} ({'TLS' if tls else 'Plain'})...")
        self.lbl_status.set_text(f"Connecting to {h}:{p}...")

        threading.Thread(target=self._irc_reader_thread, args=(h, p, tls), daemon=True).start()

    def disconnect_irc(self, quit_msg: str = "dtIRC — CDE Desktop"):
        with self.sock_lock:
            s = self.sock
            self.sock = None
            self.connected = False
            self.registered = False
        if s:
            try:
                s.sendall(f"QUIT :{quit_msg}\r\n".encode("utf-8"))
            except Exception:
                pass
            try:
                s.close()
            except Exception:
                pass
        GLib.idle_add(self._on_disconnected_ui, quit_msg)

    def send_raw(self, line: str):
        clean = line.replace("\r", "").replace("\n", "")
        with self.sock_lock:
            s = self.sock
            if not s:
                srv = self.buffers.get("*libera.chat*")
                if srv:
                    GLib.idle_add(self._append_system, srv, "Not connected to server. Click [⚡ Connect Libera.Chat] or type /connect.", "#C5221F")
                return
            try:
                s.sendall((clean + "\r\n").encode("utf-8"))
            except Exception as exc:
                GLib.idle_add(self._on_disconnected_ui, str(exc))

    def _irc_reader_thread(self, host: str, port: int, use_tls: bool):
        try:
            raw_sock = socket.create_connection((host, port), timeout=15)
            if use_tls:
                ctx = ssl.create_default_context()
                conn = ctx.wrap_socket(raw_sock, server_hostname=host)
            else:
                conn = raw_sock
            conn.settimeout(300)

            with self.sock_lock:
                self.sock = conn
                self.connected = True

            GLib.idle_add(self._on_connected_ui, host, port, use_tls)

            # Negotiate SASL PLAIN if auto_identify + password saved!
            want_sasl = bool(self.cfg.get("auto_identify") and self.cfg.get("ns_password"))
            if want_sasl:
                self._sasl_in_progress = True
                self.send_raw("CAP LS 302")

            self.send_raw(f"NICK {self.current_nick}")
            self.send_raw(f"USER {self.cfg['username']} 0 * :{self.cfg['realname']}")

            recv_buf = b""
            while True:
                chunk = conn.recv(4096)
                if not chunk:
                    break
                recv_buf += chunk
                while b"\n" in recv_buf:
                    raw_ln, recv_buf = recv_buf.split(b"\n", 1)
                    ln = raw_ln.rstrip(b"\r").decode("utf-8", errors="replace")
                    if ln.startswith("PING "):
                        token = ln[5:]
                        self.send_raw(f"PONG {token}")
                    else:
                        GLib.idle_add(self._handle_irc_line, ln)
        except Exception as exc:
            GLib.idle_add(self._on_disconnected_ui, f"Connection closed: {exc}")
        finally:
            with self.sock_lock:
                if self.sock is not None:
                    try:
                        self.sock.close()
                    except Exception:
                        pass
                    self.sock = None
                self.connected = False
                self.registered = False
            GLib.idle_add(self._on_disconnected_ui, "Disconnected.")

    def _on_connected_ui(self, host: str, port: int, use_tls: bool):
        self.btn_connect.set_label("🔌 Disconnect")
        self.lbl_status.set_text(f"Connected to {host}:{port} ({'TLS' if use_tls else 'Plain'}) as {self.current_nick}")
        self.lbl_lag.set_text(f"{'🔒 TLS' if use_tls else 'Plain'} {port}")

    def _on_disconnected_ui(self, reason: str):
        if not self.connected:
            self.btn_connect.set_label("⚡ Connect Libera.Chat")
            self.lbl_status.set_text(reason)
            srv = self.buffers.get("*libera.chat*")
            if srv and reason:
                self._append_system(srv, reason, "#7F1D1D")

    def send_nickserv_identify(self, manual: bool = False):
        pw = self.cfg.get("ns_password", "")
        if not pw:
            if manual:
                self.on_identity_dialog()
            return
        acct = self.cfg.get("ns_account", "").strip() or self.current_nick
        tmpl = self.cfg.get("ns_command", "/msg NickServ IDENTIFY {account} {password}").strip()
        rendered = (
            tmpl.replace("{account}", acct)
            .replace("{nick}", self.current_nick)
            .replace("{password}", pw)
        )
        if rendered.startswith("/"):
            self.exec_command(rendered, quiet_secret=True)
        else:
            self.send_raw(rendered)
        self._ident_sent_this_session = True
        srv = self.buffers.get(self.active_buf_key) or self.buffers["*libera.chat*"]
        self._append_system(srv, f"Sent saved NickServ IDENTIFY command for account '{acct}'.", "#166534")

    # ---------------- Incoming IRC Protocol Dispatcher ----------------
    def _handle_irc_line(self, raw_line: str):
        prefix, cmd, params = parse_irc_line(raw_line)
        nick, user, host = split_prefix(prefix)
        if nick and user and host:
            self.user_hosts[nick.lower()] = f"{user}@{host}"

        srv_buf = self.buffers["*libera.chat*"]

        # SASL PLAIN Handshake (IRCv3 CAP -> AUTHENTICATE -> 903 -> CAP END)
        if cmd == "CAP" and len(params) >= 2:
            subcmd = params[1].upper()
            caps = params[-1] if len(params) >= 3 else ""
            if subcmd == "LS" and self._sasl_in_progress:
                if "sasl" in caps.split():
                    self.send_raw("CAP REQ :sasl")
                else:
                    self._sasl_in_progress = False
                    self.send_raw("CAP END")
            elif subcmd == "ACK" and "sasl" in caps:
                self.send_raw("AUTHENTICATE PLAIN")
            elif subcmd == "NAK":
                self._sasl_in_progress = False
                self.send_raw("CAP END")
            return

        if cmd == "AUTHENTICATE" and params and params[0] == "+":
            acct = self.cfg.get("ns_account", "").strip() or self.current_nick
            pw = self.cfg.get("ns_password", "")
            payload = f"{acct}\x00{acct}\x00{pw}".encode("utf-8")
            b64 = base64.b64encode(payload).decode("ascii")
            self.send_raw(f"AUTHENTICATE {b64}")
            return

        if cmd in ("903", "904", "905", "906", "907"):
            msg = params[-1] if params else f"SASL ({cmd})"
            self._append_system(srv_buf, f"[SASL] {msg}", "#166534" if cmd == "903" else "#C5221F")
            if cmd == "903":
                self._ident_sent_this_session = True
            self._sasl_in_progress = False
            self.send_raw("CAP END")
            return

        # 001 Welcome!
        if cmd == "001":
            self.registered = True
            if params:
                self.current_nick = params[0]
                self.lbl_my_nick.set_text(f"[{self.current_nick}]")
            self._append_system(srv_buf, params[-1] if params else "Welcome to Libera.Chat!", "#166534")

            if self.cfg.get("auto_identify") and self.cfg.get("ns_password") and not self._ident_sent_this_session:
                self.send_nickserv_identify(manual=False)

            chans_raw = self.cfg.get("auto_channels", "")
            for tok in re.split(r"[,\s]+", chans_raw):
                ch = tok.strip()
                if ch:
                    if not ch.startswith(("#", "&")):
                        ch = "#" + ch
                    self.send_raw(f"JOIN {ch}")
            return

        # 433 Nickname in use
        if cmd == "433":
            alt = self.cfg.get("alt_nick") or (self.current_nick + "_")
            if self.current_nick == alt:
                alt = alt + "_"
            self.current_nick = alt
            self.lbl_my_nick.set_text(f"[{self.current_nick}]")
            self._append_system(srv_buf, f"Nickname in use — trying '{alt}'...", "#B45309")
            self.send_raw(f"NICK {alt}")
            return

        # JOIN
        if cmd == "JOIN" and params:
            chan = params[0]
            cbuf = self._ensure_buffer(chan, "channel", switch=(nick.lower() == self.current_nick.lower()))
            cbuf.display_nicks[nick.lower()] = nick
            cbuf.users.setdefault(nick.lower(), set())
            self._append_system(cbuf, f"→ {nick} ({user}@{host}) has joined {chan}", "#15803D")
            if self._buf_key(chan) == self.active_buf_key:
                self._rebuild_user_list()
            return

        # PART
        if cmd == "PART" and params:
            chan = params[0]
            reason = params[1] if len(params) > 1 else ""
            key = self._buf_key(chan)
            if key in self.buffers:
                cbuf = self.buffers[key]
                cbuf.users.pop(nick.lower(), None)
                cbuf.display_nicks.pop(nick.lower(), None)
                self._append_system(cbuf, f"← {nick} has left {chan}" + (f" ({reason})" if reason else ""), "#64748B")
                if key == self.active_buf_key:
                    self._rebuild_user_list()
            return

        # QUIT
        if cmd == "QUIT":
            reason = params[0] if params else ""
            for key, b in self.buffers.items():
                if b.kind == "channel" and nick.lower() in b.display_nicks:
                    b.users.pop(nick.lower(), None)
                    b.display_nicks.pop(nick.lower(), None)
                    self._append_system(b, f"⇐ {nick} has quit ({reason})", "#64748B")
                    if key == self.active_buf_key:
                        self._rebuild_user_list()
            return

        # KICK
        if cmd == "KICK" and len(params) >= 2:
            chan, kicked = params[0], params[1]
            reason = params[2] if len(params) > 2 else ""
            key = self._buf_key(chan)
            if key in self.buffers:
                cbuf = self.buffers[key]
                cbuf.users.pop(kicked.lower(), None)
                cbuf.display_nicks.pop(kicked.lower(), None)
                self._append_system(cbuf, f"🥾 {kicked} was kicked from {chan} by {nick} ({reason})", "#C5221F")
                if key == self.active_buf_key:
                    self._rebuild_user_list()
            return

        # NICK
        if cmd == "NICK" and params:
            new_nick = params[0]
            if nick.lower() == self.current_nick.lower():
                self.current_nick = new_nick
                self.lbl_my_nick.set_text(f"[{self.current_nick}]")
            for key, b in self.buffers.items():
                if b.kind == "channel" and nick.lower() in b.display_nicks:
                    prefs = b.users.pop(nick.lower(), set())
                    b.display_nicks.pop(nick.lower(), None)
                    b.users[new_nick.lower()] = prefs
                    b.display_nicks[new_nick.lower()] = new_nick
                    self._append_system(b, f"• {nick} is now known as {new_nick}", "#475569")
                    if key == self.active_buf_key:
                        self._rebuild_user_list()
            return

        # TOPIC & 332 / 333
        if cmd == "TOPIC" and len(params) >= 2:
            chan, new_t = params[0], params[1]
            cbuf = self._ensure_buffer(chan, "channel")
            cbuf.topic = new_t
            cbuf.topic_meta = f"Set by {nick}"
            self._append_system(cbuf, f"★ {nick} changed the topic of {chan} to: {new_t}", "#1D4ED8")
            if self._buf_key(chan) == self.active_buf_key:
                self.ent_topic.set_text(strip_mirc_codes(new_t))
                self.ent_topic.set_tooltip_text(cbuf.topic_meta)
            return

        if cmd == "332" and len(params) >= 3:
            chan, new_t = params[1], params[2]
            cbuf = self._ensure_buffer(chan, "channel")
            cbuf.topic = new_t
            self._append_system(cbuf, f"Topic for {chan}: {new_t}", "#1D4ED8")
            if self._buf_key(chan) == self.active_buf_key:
                self.ent_topic.set_text(strip_mirc_codes(new_t))
            return

        if cmd == "333" and len(params) >= 4:
            chan, setter, ts_s = params[1], params[2], params[3]
            key = self._buf_key(chan)
            if key in self.buffers:
                try:
                    dt_str = datetime.datetime.fromtimestamp(int(ts_s)).strftime("%Y-%m-%d %H:%M")
                except Exception:
                    dt_str = ts_s
                self.buffers[key].topic_meta = f"Topic set by {setter} on {dt_str}"
                if key == self.active_buf_key:
                    self.ent_topic.set_tooltip_text(self.buffers[key].topic_meta)
            return

        # 353 NAMES list & 366 End of NAMES
        if cmd == "353" and len(params) >= 4:
            chan = params[2]
            names_str = params[3]
            cbuf = self._ensure_buffer(chan, "channel")
            ckey = self._buf_key(chan)
            if ckey not in self._names_accum:
                self._names_accum.add(ckey)
                cbuf.users.clear()
                cbuf.display_nicks.clear()
            for tok in names_str.split():
                prefs = set()
                while tok and tok[0] in "~&@%+":
                    prefs.add(tok[0])
                    tok = tok[1:]
                if "!" in tok:
                    n_part, uh_part = tok.split("!", 1)
                    self.user_hosts[n_part.lower()] = uh_part
                    tok = n_part
                if tok:
                    cbuf.display_nicks[tok.lower()] = tok
                    cbuf.users[tok.lower()] = prefs
            return

        if cmd == "366" and len(params) >= 2:
            chan = params[1]
            ckey = self._buf_key(chan)
            self._names_accum.discard(ckey)
            if ckey == self.active_buf_key:
                self._rebuild_user_list()
            return

        # 352 WHO reply (caches user@host!)
        if cmd == "352" and len(params) >= 6:
            u_ident, u_host, u_nick = params[2], params[3], params[5]
            self.user_hosts[u_nick.lower()] = f"{u_ident}@{u_host}"

        # MODE changes (updates @ / + badges in left-hand user list live!)
        if cmd == "MODE" and len(params) >= 2:
            target = params[0]
            modes = params[1]
            m_args = params[2:]
            if target.startswith(("#", "&")):
                cbuf = self._ensure_buffer(target, "channel")
                self._append_system(cbuf, f"⚙ {nick or prefix} sets mode {modes} {' '.join(m_args)}".strip(), "#0F766E")
                adding = True
                arg_i = 0
                for mc in modes:
                    if mc == "+":
                        adding = True
                    elif mc == "-":
                        adding = False
                    elif mc in MODE_TO_PREFIX and arg_i < len(m_args):
                        tnick = m_args[arg_i].lower()
                        arg_i += 1
                        pchar = MODE_TO_PREFIX[mc]
                        if tnick in cbuf.users:
                            if adding:
                                cbuf.users[tnick].add(pchar)
                            else:
                                cbuf.users[tnick].discard(pchar)
                    elif mc in "beIqaohvk" and arg_i < len(m_args):
                        arg_i += 1
                if self._buf_key(target) == self.active_buf_key:
                    self._rebuild_user_list()
            else:
                self._append_system(srv_buf, f"Mode {target}: {modes} {' '.join(m_args)}")
            return

        # PRIVMSG & NOTICE (including CTCP ACTION /me, VERSION, PING, TIME & NickServ prompts!)
        if cmd in ("PRIVMSG", "NOTICE") and len(params) >= 2:
            if nick.lower() in self.ignored_nicks:
                return
            target, text = params[0], params[1]

            # Handle CTCP
            if text.startswith("\x01") and text.endswith("\x01") and len(text) > 1:
                ctcp_body = text[1:-1]
                ctcp_cmd, _, ctcp_arg = ctcp_body.partition(" ")
                ctcp_u = ctcp_cmd.upper()
                if ctcp_u == "ACTION":
                    dest_buf = self._ensure_buffer(target, "channel") if target.startswith(("#", "&")) else self._ensure_buffer(nick or "*Libera.Chat*", "query")
                    hl = self.current_nick.lower() in ctcp_arg.lower()
                    self._append_line(dest_buf, f"* {nick}", "#6B21A8", ctcp_arg, body_fg="#6B21A8", is_highlight=hl)
                    return
                if cmd == "PRIVMSG":
                    if ctcp_u == "VERSION":
                        self.send_raw(f"NOTICE {nick} :\x01VERSION dtIRC 1.0 — Common Desktop Environment (CDE / Linux)\x01")
                    elif ctcp_u == "TIME":
                        now_s = datetime.datetime.now().strftime("%a %b %d %H:%M:%S %Y")
                        self.send_raw(f"NOTICE {nick} :\x01TIME {now_s}\x01")
                    elif ctcp_u == "PING":
                        self.send_raw(f"NOTICE {nick} :\x01PING {ctcp_arg}\x01")
                    self._append_system(srv_buf, f"[CTCP {ctcp_u}] from {nick} {ctcp_arg}".strip(), "#B45309")
                else:
                    active = self.buffers.get(self.active_buf_key, srv_buf)
                    self._append_system(active, f"[CTCP {ctcp_u} reply from {nick}] {ctcp_arg}", "#0369A1")
                return

            # Auto-respond to NickServ "This nickname is registered" if password saved and not yet sent!
            if cmd == "NOTICE" and nick.lower() == "nickserv" and "identify" in text.lower():
                if self.cfg.get("auto_identify") and self.cfg.get("ns_password") and not self._ident_sent_this_session:
                    self.send_nickserv_identify(manual=False)

            if cmd == "NOTICE":
                dest = self.buffers.get(self._buf_key(target)) if target.startswith(("#", "&")) else self.buffers.get(self.active_buf_key, srv_buf)
                sender = nick or prefix or "Server"
                self._append_line(dest or srv_buf, f"-{sender}-", "#B45309", text)
                return

            # Normal PRIVMSG
            if target.startswith(("#", "&")):
                dest_buf = self._ensure_buffer(target, "channel")
            else:
                dest_buf = self._ensure_buffer(nick, "query")
            hl = (self.current_nick.lower() in text.lower()) or (dest_buf.kind == "query")
            self._append_line(dest_buf, f"<{nick}>", nick_color(nick), text, is_highlight=hl)
            return

        # WHOIS / Server Numerics / Channel LIST
        if cmd in ("311", "312", "317", "318", "319", "330", "671", "314", "369"):
            dest = self.buffers.get(self.active_buf_key, srv_buf)
            info = " ".join(params[1:])
            self._append_system(dest, f"[WHOIS] {info}", "#1A365D")
            return

        if cmd == "322" and len(params) >= 4:
            ch_n, ch_cnt, ch_top = params[1], params[2], params[3]
            self._append_system(srv_buf, f"{ch_n:22s} ({ch_cnt:>4s} users)  {strip_mirc_codes(ch_top)}", "#1E293B")
            return

        # Default server numeric / message output
        disp = " ".join(params[1:]) if (cmd.isdigit() and len(params) > 1) else " ".join(params)
        if disp:
            is_err = cmd.isdigit() and cmd.startswith(("4", "5"))
            dest = self.buffers.get(self.active_buf_key, srv_buf) if is_err else srv_buf
            self._append_system(dest, disp, "#C5221F" if is_err else "#334155")

    # ---------------- Full '/' Command Interpreter & Input Handling ----------------
    def on_input_submit(self, *_args):
        raw = self.ent_input.get_text()
        if not raw:
            return
        self.ent_input.set_text("")
        if not self.cmd_history or self.cmd_history[-1] != raw:
            self.cmd_history.append(raw)
        self.hist_idx = len(self.cmd_history)

        if raw.startswith("/") and not raw.startswith("//"):
            self.exec_command(raw)
        else:
            msg = raw[1:] if raw.startswith("//") else raw
            buf = self.buffers.get(self.active_buf_key)
            if not buf or buf.kind == "server":
                self._append_system(self.buffers["*libera.chat*"], "Join a #channel first (e.g. /join #libera) or use / commands!")
                return
            self.send_raw(f"PRIVMSG {buf.name} :{msg}")
            self._append_line(buf, f"<{self.current_nick}>", "#2B5B84", msg)

    def exec_command(self, line: str, quiet_secret: bool = False):
        s = line[1:].strip()
        if not s:
            return
        cmd, _, rest = s.partition(" ")
        c = cmd.lower()
        rest = rest.strip()
        active_buf = self.buffers.get(self.active_buf_key, self.buffers["*libera.chat*"])
        cur_chan = active_buf.name if active_buf.kind == "channel" else ""

        if c in ("j", "join"):
            if not rest:
                self.on_join_dialog(); return
            parts = rest.split(None, 1)
            ch = parts[0] if parts[0].startswith(("#", "&")) else "#" + parts[0]
            key_arg = f" {parts[1]}" if len(parts) > 1 else ""
            self.send_raw(f"JOIN {ch}{key_arg}")
        elif c in ("part", "leave"):
            parts = rest.split(None, 1) if rest else []
            ch = parts[0] if (parts and parts[0].startswith(("#", "&"))) else cur_chan
            reason = parts[1] if len(parts) > 1 else (rest if (parts and not parts[0].startswith("#")) else "Leaving")
            if ch:
                self.send_raw(f"PART {ch} :{reason}")
                self._remove_buffer(self._buf_key(ch))
        elif c in ("msg", "privmsg", "m"):
            target, _, body = rest.partition(" ")
            if target and body:
                self.send_raw(f"PRIVMSG {target} :{body}")
                if not quiet_secret:
                    dest = self._ensure_buffer(target, "channel" if target.startswith("#") else "query")
                    self._append_line(dest, f"→ <{target}>", "#2B5B84", body)
        elif c in ("query", "q"):
            if rest:
                target, _, body = rest.partition(" ")
                qbuf = self._ensure_buffer(target, "query", switch=True)
                if body:
                    self.send_raw(f"PRIVMSG {target} :{body}")
                    self._append_line(qbuf, f"<{self.current_nick}>", "#2B5B84", body)
        elif c == "notice":
            target, _, body = rest.partition(" ")
            if target and body:
                self.send_raw(f"NOTICE {target} :{body}")
                self._append_line(active_buf, f"→ -{target}-", "#B45309", body)
        elif c == "me":
            if active_buf.kind != "server" and rest:
                self.send_raw(f"PRIVMSG {active_buf.name} :\x01ACTION {rest}\x01")
                self._append_line(active_buf, f"* {self.current_nick}", "#6B21A8", rest, body_fg="#6B21A8")
        elif c == "nick":
            if rest:
                self.send_raw(f"NICK {rest.split()[0]}")
        elif c in ("ns", "nickserv"):
            if rest:
                self.send_raw(f"PRIVMSG NickServ :{rest}")
                self._append_system(active_buf, "Sent command to NickServ.")
        elif c in ("cs", "chanserv"):
            if rest:
                self.send_raw(f"PRIVMSG ChanServ :{rest}")
                self._append_system(active_buf, f"-> ChanServ: {rest}")
        elif c in ("id", "identify"):
            if rest:
                self.send_raw(f"PRIVMSG NickServ :IDENTIFY {rest}")
                self._append_system(active_buf, "Sent NickServ IDENTIFY.")
            else:
                self.send_nickserv_identify(manual=True)
        elif c in ("wi", "whois"):
            t = rest.split()[0] if rest else self.current_nick
            self.send_raw(f"WHOIS {t} {t}")
        elif c == "whowas":
            if rest:
                self.send_raw(f"WHOWAS {rest}")
        elif c == "who":
            self.send_raw(f"WHO {rest or cur_chan}")
        elif c in ("t", "topic"):
            if cur_chan:
                if rest:
                    self.send_raw(f"TOPIC {cur_chan} :{rest}")
                else:
                    self.send_raw(f"TOPIC {cur_chan}")
        elif c == "mode":
            if rest.startswith(("#", "&")) or not cur_chan:
                self.send_raw(f"MODE {rest}")
            else:
                self.send_raw(f"MODE {cur_chan} {rest}")
        elif c in ("op", "deop", "voice", "devoice", "halfop", "dehalfop"):
            m_map = {"op": "+o", "deop": "-o", "voice": "+v", "devoice": "-v", "halfop": "+h", "dehalfop": "-h"}
            if cur_chan and rest:
                for n in rest.split():
                    self.send_raw(f"MODE {cur_chan} {m_map[c]} {n}")
        elif c in ("k", "kick"):
            if cur_chan and rest:
                knick, _, reason = rest.partition(" ")
                self.send_raw(f"KICK {cur_chan} {knick} :{reason or knick}")
        elif c in ("b", "ban", "unban", "quiet", "unquiet"):
            m_map = {"b": "+b", "ban": "+b", "unban": "-b", "quiet": "+q", "unquiet": "-q"}
            if cur_chan and rest:
                mask = rest.split()[0]
                if "!" not in mask and "@" not in mask:
                    uh = self.user_hosts.get(mask.lower(), "")
                    mask = f"*!*@{uh.split('@', 1)[1]}" if "@" in uh else f"{mask}!*@*"
                self.send_raw(f"MODE {cur_chan} {m_map[c]} {mask}")
        elif c in ("kb", "kickban"):
            if cur_chan and rest:
                knick, _, reason = rest.partition(" ")
                uh = self.user_hosts.get(knick.lower(), "")
                mask = f"*!*@{uh.split('@', 1)[1]}" if "@" in uh else f"{knick}!*@*"
                self.send_raw(f"MODE {cur_chan} +b {mask}")
                self.send_raw(f"KICK {cur_chan} {knick} :{reason or knick}")
        elif c == "invite":
            parts = rest.split()
            if len(parts) == 1 and cur_chan:
                self.send_raw(f"INVITE {parts[0]} {cur_chan}")
            elif len(parts) >= 2:
                self.send_raw(f"INVITE {parts[0]} {parts[1]}")
        elif c == "names":
            self.send_raw(f"NAMES {rest or cur_chan}")
        elif c == "list":
            self.send_raw(f"LIST {rest or '>20'}")
        elif c == "away":
            self.send_raw(f"AWAY :{rest}" if rest else "AWAY")
        elif c == "back":
            self.send_raw("AWAY")
        elif c == "ctcp":
            target, _, sub = rest.partition(" ")
            if target and sub:
                self.send_raw(f"PRIVMSG {target} :\x01{sub}\x01")
                self._append_system(active_buf, f"Sent CTCP {sub} to {target}")
        elif c == "ping":
            target = rest.split()[0] if rest else ""
            if target:
                self.send_raw(f"PRIVMSG {target} :\x01PING {int(time.time())}\x01")
        elif c == "version":
            target = rest.split()[0] if rest else ""
            if target:
                self.send_raw(f"PRIVMSG {target} :\x01VERSION\x01")
        elif c == "ignore":
            if rest:
                n = rest.split()[0].lower()
                self.ignored_nicks.add(n); self._save_config()
                self._append_system(active_buf, f"Ignoring messages from {n}.")
        elif c == "unignore":
            if rest:
                n = rest.split()[0].lower()
                self.ignored_nicks.discard(n); self._save_config()
                self._append_system(active_buf, f"Removed {n} from ignore list.")
        elif c == "clear":
            self.clear_active_buffer()
        elif c in ("server", "connect"):
            parts = rest.split()
            h = parts[0] if parts else self.cfg["host"]
            p = DEFAULT_PORT
            tls = True
            if len(parts) > 1:
                ps = parts[1]
                if ps.startswith("+"):
                    tls = True; p = int(ps[1:] or 6697)
                else:
                    p = int(ps); tls = (p in (6697, 7000, 7070))
            self.connect_irc(h, p, tls)
        elif c == "reconnect":
            self.connect_irc()
        elif c == "disconnect":
            self.disconnect_irc(rest or "Disconnected")
        elif c in ("quit", "exit"):
            self.disconnect_irc(rest or "dtIRC — CDE Desktop")
            self.on_quit()
        elif c in ("raw", "quote"):
            if rest:
                self.send_raw(rest)
        else:
            # Pass any other IRC command directly to server!
            self.send_raw(f"{cmd.upper()} {rest}".strip())

    # ---------------- Input History, Nick Tab-Completion & Dialogs ----------------
    def _on_input_key_press(self, ent, ev):
        if ev.keyval == Gdk.KEY_Up:
            if self.cmd_history and self.hist_idx > 0:
                self.hist_idx -= 1
                ent.set_text(self.cmd_history[self.hist_idx])
                ent.set_position(-1)
            return True
        if ev.keyval == Gdk.KEY_Down:
            if self.hist_idx < len(self.cmd_history) - 1:
                self.hist_idx += 1
                ent.set_text(self.cmd_history[self.hist_idx])
                ent.set_position(-1)
            else:
                self.hist_idx = len(self.cmd_history)
                ent.set_text("")
            return True
        if ev.keyval == Gdk.KEY_Tab:
            self._tab_complete_input()
            return True
        return False

    def _tab_complete_input(self):
        txt = self.ent_input.get_text()
        pos = self.ent_input.get_position()
        left = txt[:pos]
        right = txt[pos:]
        m = re.search(r"(\S+)$", left)
        if not m:
            return
        prefix = m.group(1)
        start_idx = m.start(1)

        if prefix.startswith("/") and start_idx == 0:
            cmds = [
                "/join", "/part", "/msg", "/query", "/me", "/nick", "/nickserv", "/chanserv",
                "/identify", "/whois", "/whowas", "/topic", "/mode", "/op", "/deop", "/voice",
                "/devoice", "/kick", "/ban", "/unban", "/kickban", "/quiet", "/unquiet",
                "/invite", "/list", "/names", "/away", "/back", "/ctcp", "/ping", "/ignore",
                "/clear", "/connect", "/disconnect", "/quit", "/raw",
            ]
            matches = [x for x in cmds if x.startswith(prefix.lower())]
            if matches:
                rep = matches[0] + " "
                self.ent_input.set_text(left[:start_idx] + rep + right)
                self.ent_input.set_position(start_idx + len(rep))
            return

        buf = self.buffers.get(self.active_buf_key)
        if buf and buf.kind == "channel":
            nicks = sorted(buf.display_nicks.values(), key=str.lower)
            matches = [n for n in nicks if n.lower().startswith(prefix.lower())]
            if matches:
                suffix = ": " if start_idx == 0 else " "
                rep = matches[0] + suffix
                self.ent_input.set_text(left[:start_idx] + rep + right)
                self.ent_input.set_position(start_idx + len(rep))

    def _refresh_active_names(self):
        buf = self.buffers.get(self.active_buf_key)
        if buf and buf.kind == "channel":
            self.send_raw(f"NAMES {buf.name}")
            self.send_raw(f"WHO {buf.name}")

    def on_identity_dialog(self, *_args):
        dlg = IdentityDialog(self, self.cfg)
        if dlg.run() == Gtk.ResponseType.OK:
            old_nick = self.cfg.get("nick")
            self.cfg = dlg.get_updated_config(self.cfg)
            self._save_config()
            dlg.destroy()
            if self.connected and self.cfg["nick"] != old_nick:
                self.send_raw(f"NICK {self.cfg['nick']}")
            self.lbl_status.set_text("Saved Libera.Chat & NickServ credentials (0600 permissions).")
        else:
            dlg.destroy()

    def on_join_dialog(self, *_args):
        dlg = Gtk.Dialog(title="Join Channel — dtIRC", transient_for=self, flags=0)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Join", Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_spacing(8); box.set_margin_top(10); box.set_margin_bottom(10); box.set_margin_start(12); box.set_margin_end(12)
        box.pack_start(Gtk.Label(label="Channel Name (e.g. #libera, #linux, ##retro):", xalign=0), False, False, 0)
        ent = Gtk.Entry(text="#", width_chars=32)
        ent.connect("activate", lambda *_: dlg.response(Gtk.ResponseType.OK))
        box.pack_start(ent, False, False, 0)
        dlg.show_all()
        ent.set_position(-1)
        if dlg.run() == Gtk.ResponseType.OK:
            ch = ent.get_text().strip()
            dlg.destroy()
            if ch and ch != "#":
                self.exec_command(f"/join {ch}")
        else:
            dlg.destroy()

    def on_save_log(self, *_args):
        buf = self.buffers.get(self.active_buf_key)
        if not buf:
            return
        dlg = Gtk.FileChooserDialog(title="Save Chat Log — dtIRC", parent=self, action=Gtk.FileChooserAction.SAVE)
        dlg.set_do_overwrite_confirmation(True)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save", Gtk.ResponseType.OK)
        dlg.set_current_folder(str(LOG_DIR))
        safe = re.sub(r"[^A-Za-z0-9_#-]+", "_", buf.name)
        dlg.set_current_name(f"{safe}_{datetime.date.today().isoformat()}.log")
        if dlg.run() == Gtk.ResponseType.OK:
            out_p = Path(dlg.get_filename())
            dlg.destroy()
            start, end = buf.textbuf.get_bounds()
            out_p.write_text(buf.textbuf.get_text(start, end, True), encoding="utf-8")
            self.lbl_status.set_text(f"Saved chat transcript to {out_p}")
        else:
            dlg.destroy()

