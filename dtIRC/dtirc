# Extended mIRC 16-98 cube fallback helper
def get_mirc_fg(code: int) -> str:
    if code in MIRC_FG_CREAM:
        return MIRC_FG_CREAM[code]
    if 16 <= code <= 87:
        idx = code - 16
        r = (idx // 12) * 36
        g = ((idx // 2) % 6) * 36
        b = (idx % 2) * 140
        # Clamp overly bright luma on cream
        if 0.299 * r + 0.587 * g + 0.114 * b > 185:
            r, g, b = int(r * 0.55), int(g * 0.55), int(b * 0.55)
        return f"#{r:02X}{g:02X}{b:02X}"
    return "#1E293B"


def get_mirc_bg(code: int) -> str:
    return MIRC_BG_TRUE.get(code % 16, "#E2E8F0")


