# ---------------------------------------------------------------------------
# Per-Buffer Data Model (Server Tab, #Channel Tab, or Private Message Tab)
# ---------------------------------------------------------------------------
class IrcBuffer:
    def __init__(self, name: str, kind: str):
        self.name = name          # e.g. "*Libera.Chat*", "#cde", "Alice"
        self.kind = kind          # "server", "channel", "query"
        self.topic: str = ""
        self.topic_meta: str = ""
        self.users: dict[str, set[str]] = {}  # lower_nick -> set of prefix chars ('@', '+', etc.)
        self.display_nicks: dict[str, str] = {}  # lower_nick -> exact-case nick
        self.unread: bool = False
        self.highlight: bool = False

        self.textbuf = Gtk.TextBuffer()
        self.textview = Gtk.TextView(buffer=self.textbuf, editable=False, cursor_visible=False)
        self.textview.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.textview.set_left_margin(8)
        self.textview.set_right_margin(8)
        self.textview.set_top_margin(6)
        self.textview.set_bottom_margin(6)
        self.textview.get_style_context().add_class("irc-chat")

        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroll.add(self.textview)
        self._tag_cache: dict[tuple, Gtk.TextTag] = {}

    def highest_prefix(self, lnick: str) -> str:
        prefs = self.users.get(lnick, set())
        for p in ("~", "&", "@", "%", "+"):
            if p in prefs:
                return p
        return ""


