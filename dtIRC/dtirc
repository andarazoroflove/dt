    def _on_window_key_press(self, _w, ev):
        ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
        kv = ev.keyval
        if ctrl and kv in (Gdk.KEY_plus, Gdk.KEY_equal, Gdk.KEY_KP_Add):
            self.step_font_size(1); return True
        if ctrl and kv in (Gdk.KEY_minus, Gdk.KEY_underscore, Gdk.KEY_KP_Subtract):
            self.step_font_size(-1); return True
        if ctrl and kv in (Gdk.KEY_0, Gdk.KEY_KP_0):
            self.set_font_size(11); return True
        if ctrl and kv in (Gdk.KEY_j, Gdk.KEY_J):
            self.on_join_dialog(); return True
        if ctrl and kv in (Gdk.KEY_w, Gdk.KEY_W):
            self.close_active_buffer(); return True
        if ctrl and kv in (Gdk.KEY_t, Gdk.KEY_T):
            self.ent_topic.grab_focus(); return True
        if ctrl and kv in (Gdk.KEY_l, Gdk.KEY_L):
            self.clear_active_buffer(); return True
        if ctrl and kv in (Gdk.KEY_q, Gdk.KEY_Q):
            self.on_quit(); return True
        return False

    def on_quit(self):
        if self.connected:
            self.disconnect_irc("dtIRC — Common Desktop Environment")
        self._save_config()
        self.destroy()
        Gtk.main_quit()
        return False


