set DtDbVersion=1.0

ACTION dtLog
{
     LABEL         dtLog
     ARG_COUNT     0
     ICON          dtlog
     TYPE          COMMAND
     WINDOW_TYPE   NO_STDIO
     EXEC_STRING   __HOME__/.local/bin/dtlog
     DESCRIPTION   dtLog — Vintage Ham QSO & SWL Station Logbook with Great-Circle Azimuth Beam Compass.
}
