def run_self_test():
    with tempfile.TemporaryDirectory(prefix="dtlog_test_") as tmp:
        tdir = Path(tmp)
        cfg_p = tdir / "config.json"
        db_p = tdir / "logbook.sqlite"
        dtradio_p = tdir / "dtradio_state.json"
        adi_p = tdir / "roundtrip.adi"
        qsl_p = tdir / "qsl_w1aw.png"

        # 1. Verify FN31pr Maidenhead & Great-Circle Geodesic Math
        ll = grid_to_latlon("FN31pr")
        assert ll is not None, "FN31pr failed to parse"
        assert abs(ll[0] - 41.7292) < 0.01 and abs(ll[1] - (-72.7083)) < 0.01, f"Unexpected FN31pr latlon: {ll}"
        assert latlon_to_grid(41.7292, -72.7083, 6) == "FN31pr"

        # 2. Verify Offline DXCC Prefix & US/VE Call-Area Resolver + Azimuth Bearings from Newington, CT
        ja = resolve_call_or_station("JA1ABC", "", 41.7292, -72.7083)
        assert ja["matched"] and "Japan" in ja["entity"] and 325.0 <= ja["sp_deg"] <= 350.0 and ja["sp_km"] > 10000

        w6 = resolve_call_or_station("W6ABC", "CM87wk", 41.7292, -72.7083)
        assert w6["matched"] and "W6" in w6["entity"] and 275.0 <= w6["sp_deg"] <= 295.0 and 3800 <= w6["sp_km"] <= 4400

        vk = resolve_call_or_station("VK2XYZ", "", 41.7292, -72.7083)
        assert vk["matched"] and "Australia" in vk["entity"] and 250.0 <= vk["sp_deg"] <= 295.0 and vk["sp_km"] > 14500

        uk = resolve_call_or_station("G4ICD/P", "", 41.7292, -72.7083)
        assert uk["matched"] and uk["entity"] == "England" and 45.0 <= uk["sp_deg"] <= 62.0

        zl = resolve_call_or_station("ZL1AN", "", 41.7292, -72.7083)
        assert zl["matched"] and zl["entity"] == "New Zealand" and 235.0 <= zl["sp_deg"] <= 268.0

        py = resolve_call_or_station("PY2AA", "", 41.7292, -72.7083)
        assert py["matched"] and py["entity"] == "Brazil" and 140.0 <= py["sp_deg"] <= 168.0

        kh6 = resolve_call_or_station("KH6/W1AW", "", 41.7292, -72.7083)
        assert kh6["matched"] and kh6["entity"] == "Hawaii"

        # 3. Verify dtRadio state.json Bridge
        dtradio_p.write_text(
            json.dumps({"freq_khz": 14230.0, "mode": "USB", "source": "kiwi", "title": "20m International SSTV Calling"}),
            encoding="utf-8",
        )
        grab = parse_dtradio_state(dtradio_p)
        assert grab is not None and abs(grab["freq_mhz"] - 14.2300) < 1e-6 and grab["band"] == "20m" and grab["mode"] == "USB"

        # 4. Verify SQLite CRUD, Stats & Dupe Engine
        db = LogbookDB(db_p)
        id1 = db.insert_contact({
            "log_type": "QSO",
            "qso_date": "2026-11-27",
            "time_on": "01:15",
            "call": "JA1ABC",
            "freq_mhz": 14.2450,
            "band": "20m",
            "mode": "USB",
            "rst_sent": "59",
