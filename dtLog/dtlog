            "cq_zone": 4,
            "itu_zone": 7,
            "bearing_deg": 110.0,
            "distance_km": 650.0,
        })
        assert id1 > 0 and id2 > 0
        dupe_chk = db.check_dupe_and_history("JA1ABC", "20m", "SSB")
        assert dupe_chk["is_dupe"] is True
        non_dupe = db.check_dupe_and_history("JA1ABC", "15m", "FT8")
        assert non_dupe["is_dupe"] is False and len(non_dupe["prev_rows"]) == 1

        st = db.get_stats()
        assert st["total_qsos"] == 1 and st["swl_logs"] == 1 and st["unique_calls"] == 2

        # 5. Verify ADIF 3.1.4 Export & Import Roundtrip
        exported = format_adif_export(db.query_contacts(), DEFAULT_CONFIG)
        adi_p.write_text(exported, encoding="utf-8")
        parsed = parse_adif_text(adi_p.read_text(encoding="utf-8"))
        assert len(parsed) == 2

        db2 = LogbookDB(tdir / "roundtrip.sqlite")
        added, skipped = db2.import_adif_records(parsed, 41.7292, -72.7083)
        assert added == 2 and skipped == 0
        added_again, skipped_again = db2.import_adif_records(parsed, 41.7292, -72.7083)
        assert added_again == 0 and skipped_again == 2
        db2.close()

        # 6. Verify Vintage QSL Card PNG & ASCII Renderer
        row1 = db.get_contact(id1)
