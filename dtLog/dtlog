    def _set_btn_active(self, btn: Gtk.Button, active: bool):
        ctx = btn.get_style_context()
        if active:
            ctx.add_class("sw-active")
        else:
            ctx.remove_class("sw-active")

    def _sync_toggle_styles(self):
        self._set_btn_active(self.btn_type_qso, self.log_type == "QSO")
        self._set_btn_active(self.btn_type_swl, self.log_type == "SWL")
        self._set_btn_active(self.btn_live_utc, self.live_utc)

    def _flash(self, msg: str, dur: float = 2.8):
        self.flash_msg = msg
        import time as _t
        self.flash_until = _t.time() + dur
        self.console_deck.queue_draw()

    def _set_status(self, msg: str):
        self.status_lbl.set_text(msg)

    def _get_deck_state(self) -> dict:
        import time as _t
        fmsg = self.flash_msg if _t.time() < self.flash_until else ""
        return {
            "op": self.op_cfg,
            "stats": self.stats_cache,
            "resolved": self.resolved_cache,
            "dupe": self.dupe_cache,
            "flash_msg": fmsg,
            "call_nonempty": bool(self.ent_call.get_text().strip()),
            "is_new_dxcc": self.is_new_dxcc,
        }

    # ---- Timers & Live Entry Handlers ----
    def _on_anim_tick(self) -> bool:
        self.console_deck.tick_rotor()
        return True

    def _tick_utc_fields(self) -> bool:
        if self.live_utc and self.editing_id is None:
            now_u = datetime.datetime.now(datetime.timezone.utc)
            d_s = now_u.strftime("%Y-%m-%d")
            t_s = now_u.strftime("%H:%M")
            if self.ent_date.get_text() != d_s:
                self.ent_date.set_text(d_s)
            if self.ent_time.get_text() != t_s:
                self.ent_time.set_text(t_s)
        return True

    def _toggle_live_utc(self, _b):
        self.live_utc = not self.live_utc
        self._sync_toggle_styles()
        if self.live_utc:
            self._tick_utc_fields()

    def _set_log_type(self, ltype: str):
        self.log_type = ltype
        self._sync_toggle_styles()
        if ltype == "SWL":
            if self.ent_pwr.get_text().strip() == str(self.op_cfg.get("tx_pwr", "100")):
                self.ent_pwr.set_text("RX")
        else:
            if self.ent_pwr.get_text().strip() in ("RX", "--", ""):
                self.ent_pwr.set_text(str(self.op_cfg.get("tx_pwr", "100")))
        if not self._rst_dirty:
            s_def, r_def = default_rst_for_mode(self.cmb_mode.get_active_text() or "SSB", is_swl=(ltype == "SWL"))
            self._set_rst_clean(s_def, r_def)
        self._recompute_live_call()

    def _mark_rst_dirty(self, _e):
        if not self._suppress_freq_sync:
            self._rst_dirty = True

    def _set_rst_clean(self, s_val: str, r_val: str):
        self._suppress_freq_sync = True
        self.ent_rst_s.set_text(s_val)
        self.ent_rst_r.set_text(r_val)
        self._suppress_freq_sync = False
        self._rst_dirty = False

    def _on_freq_changed(self, _e):
        if self._suppress_freq_sync:
            return
        txt = self.ent_freq.get_text().strip()
        try:
            fmhz = float(txt)
        except ValueError:
            return
        band = freq_mhz_to_band(fmhz, is_swl=(self.log_type == "SWL"))
        if band in ALL_BANDS:
            self._suppress_freq_sync = True
            self.cmb_band.set_active(ALL_BANDS.index(band))
            self._suppress_freq_sync = False
        self._recompute_live_call()

    def _on_band_combo_changed(self, _c):
        if self._suppress_freq_sync:
            return
        band = self.cmb_band.get_active_text() or "20m"
        # If freq doesn't belong to selected band, populate band default center
        try:
            cur_f = float(self.ent_freq.get_text().strip() or 0.0)
        except ValueError:
            cur_f = 0.0
        for bname, flo, fhi, fdef in BAND_PLAN:
            if bname == band and not (flo <= cur_f <= fhi):
                self._suppress_freq_sync = True
                self.ent_freq.set_text(f"{fdef:.4f}")
                self._suppress_freq_sync = False
                break
        self._recompute_live_call()

    def _on_mode_combo_changed(self, _c):
        mode = self.cmb_mode.get_active_text() or "SSB"
        if mode == "SWL" and self.log_type != "SWL":
            self.log_type = "SWL"
            self._sync_toggle_styles()
        if not self._rst_dirty:
            s_def, r_def = default_rst_for_mode(mode, is_swl=(self.log_type == "SWL"))
            self._set_rst_clean(s_def, r_def)
        self._recompute_live_call()

    def _on_call_or_grid_changed(self, _e):
        self._recompute_live_call()

    def _recompute_live_call(self):
        call = self.ent_call.get_text().strip().upper()
        grid = self.ent_grid.get_text().strip()
        band = self.cmb_band.get_active_text() or "20m"
        mode = self.cmb_mode.get_active_text() or "SSB"

        self.resolved_cache = resolve_call_or_station(call, grid, self.op_cfg["lat"], self.op_cfg["lon"])
        self.dupe_cache = self.db.check_dupe_and_history(call, band, mode, exclude_id=self.editing_id)
        dxcc_code = self.resolved_cache.get("iso2") or self.resolved_cache.get("prefix") or ""
        self.is_new_dxcc = bool(dxcc_code and not self.db.is_dxcc_worked(dxcc_code))

        if self.resolved_cache["sp_deg"] is not None:
            self.console_deck.set_azimuth_target(self.resolved_cache["sp_deg"])
        elif not call and not grid:
            self.console_deck.set_azimuth_target(None)
        self.console_deck.queue_draw()

    # ---- [⚡ GRAB FROM dtRadio] Bridge ----
    def _on_grab_dtradio(self, _b):
        info = parse_dtradio_state(self.dtradio_state_path)
        if info is None:
            self._flash("⚠ dtRadio STATE NOT FOUND — LAUNCH dtRadio FIRST")
            self._set_status(f"NO dtRadio STATE FILE AT {self.dtradio_state_path}")
            return

        self._suppress_freq_sync = True
        self.ent_freq.set_text(f"{info['freq_mhz']:.4f}")
        if info["band"] in ALL_BANDS:
            self.cmb_band.set_active(ALL_BANDS.index(info["band"]))
        if info["mode"] in ALL_MODES:
            self.cmb_mode.set_active(ALL_MODES.index(info["mode"]))
        self._suppress_freq_sync = False

        if info["is_swl"]:
            self._set_log_type("SWL")
            if info["station_hint"] and not self.ent_call.get_text().strip():
                self.ent_call.set_text(info["station_hint"])
        else:
            self._set_log_type("QSO")

        if info["title"]:
            self.ent_notes.set_text(f"dtRadio: {info['title']}")

        if not self._rst_dirty:
            s_def, r_def = default_rst_for_mode(info["mode"], is_swl=info["is_swl"])
            self._set_rst_clean(s_def, r_def)

        self._recompute_live_call()
        self._flash(f"⚡ GRABBED {info['freq_mhz']:.4f} MHz {info['mode']} FROM dtRadio")
        self._set_status(f"SYNCED FROM dtRadio: {info['freq_mhz']:.4f} MHz [{info['mode']}] — {info['title']}")
        self.ent_call.grab_focus()

    # ---- CRUD Operations ----
    def _collect_form_dict(self) -> dict | None:
        call = self.ent_call.get_text().strip().upper()
        if not call:
            self._flash("⚠ ENTER CALLSIGN OR STATION IDENTIFIER")
            self.ent_call.grab_focus()
            return None
        try:
            freq_mhz = float(self.ent_freq.get_text().strip() or 0.0)
        except ValueError:
            freq_mhz = 0.0

        band = self.cmb_band.get_active_text() or freq_mhz_to_band(freq_mhz, is_swl=(self.log_type == "SWL"))
        mode = self.cmb_mode.get_active_text() or "SSB"
        grid = self.ent_grid.get_text().strip()
        info = resolve_call_or_station(call, grid, self.op_cfg["lat"], self.op_cfg["lon"])

        qdate = self.ent_date.get_text().strip() or datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d")
        qtime = self.ent_time.get_text().strip() or datetime.datetime.now(datetime.timezone.utc).strftime("%H:%M")

        return {
            "log_type": self.log_type,
            "qso_date": qdate,
            "time_on": qtime,
            "call": call,
            "freq_mhz": freq_mhz,
            "band": band,
            "mode": mode,
            "rst_sent": self.ent_rst_s.get_text().strip() or ("--" if self.log_type == "SWL" else "59"),
            "rst_rcvd": self.ent_rst_r.get_text().strip() or ("45444" if self.log_type == "SWL" else "59"),
            "grid": grid or info.get("grid", ""),
            "name": self.ent_name.get_text().strip(),
            "qth": self.ent_qth.get_text().strip(),
            "tx_pwr": self.ent_pwr.get_text().strip() or ("RX" if self.log_type == "SWL" else str(self.op_cfg.get("tx_pwr", "100"))),
            "notes": self.ent_notes.get_text().strip(),
            "dxcc_entity": info.get("entity", ""),
            "dxcc_code": info.get("iso2") or info.get("prefix", ""),
            "continent": info.get("cont", ""),
            "cq_zone": info.get("cq_zone", 0),
            "itu_zone": info.get("itu_zone", 0),
            "bearing_deg": info.get("sp_deg") or 0.0,
            "distance_km": info.get("sp_km") or 0.0,
            "qsl_sent": "N",
            "qsl_rcvd": "N",
        }

    def _on_log_clicked(self, _w):
        if self.editing_id is not None:
            self._on_update_clicked(_w)
            return
        d = self._collect_form_dict()
        if d is None:
            return
        row_id = self.db.insert_contact(d)
        self.stats_cache = self.db.get_stats()
        self._refresh_table()
        self._flash(f"✓ LOGGED #{row_id}: {d['call']} ON {d['band']} {d['mode']}")
        self._set_status(
            f"LOGGED {d['log_type']} #{row_id}: {d['call']} ({d['dxcc_entity'] or 'Local'}) — {d['freq_mhz']:.4f} MHz {d['mode']}"
        )
        self._clear_form(keep_rf=True)

    def _on_update_clicked(self, _w):
        if self.editing_id is None:
            return
        old = self.db.get_contact(self.editing_id) or {}
        d = self._collect_form_dict()
        if d is None:
            return
        d["qsl_sent"] = old.get("qsl_sent", "N")
        d["qsl_rcvd"] = old.get("qsl_rcvd", "N")
        self.db.update_contact(self.editing_id, d)
        upd_id = self.editing_id
        self.stats_cache = self.db.get_stats()
        self._refresh_table()
        self._flash(f"✎ UPDATED #{upd_id}: {d['call']}")
        self._set_status(f"UPDATED LOG ENTRY #{upd_id}: {d['call']}")
        self._clear_form(keep_rf=True)

    def _clear_form(self, keep_rf: bool = False):
        self.editing_id = None
        self.btn_update.set_sensitive(False)
        self.btn_log.set_label("✚ LOG CONTACT")
        self.live_utc = True
        self._sync_toggle_styles()
        self.ent_call.set_text("")
        self.ent_grid.set_text("")
        self.ent_name.set_text("")
        self.ent_qth.set_text("")
        self.ent_notes.set_text("")
        if not keep_rf:
            self._set_log_type("QSO")
            self._suppress_freq_sync = True
            self.ent_freq.set_text("14.2300")
            self.cmb_band.set_active(ALL_BANDS.index("20m"))
            self.cmb_mode.set_active(ALL_MODES.index("USB"))
            self._suppress_freq_sync = False
        s_def, r_def = default_rst_for_mode(self.cmb_mode.get_active_text() or "USB", is_swl=(self.log_type == "SWL"))
        self._set_rst_clean(s_def, r_def)
        self._tick_utc_fields()
        self._recompute_live_call()
        self.ent_call.grab_focus()

    def _on_dxcc_filter_changed(self, _c):
        if not self._updating_dxcc_flt:
            self._refresh_table(rebuild_dxcc=False)

    def _refresh_dxcc_combo(self):
        self._updating_dxcc_flt = True
        cur = self.cmb_flt_dxcc.get_active_text() or "ALL DXCC"
        self.cmb_flt_dxcc.remove_all()
        opts = ["ALL DXCC"] + self.db.get_distinct_dxcc()
        for o in opts:
            self.cmb_flt_dxcc.append_text(o)
        self.cmb_flt_dxcc.set_active(opts.index(cur) if cur in opts else 0)
        self._updating_dxcc_flt = False

    def _refresh_table(self, rebuild_dxcc: bool = True):
        if rebuild_dxcc:
            self._refresh_dxcc_combo()
        t_idx = self.cmb_flt_type.get_active()
        ltype = {0: "ALL", 1: "QSO", 2: "SWL"}.get(t_idx, "ALL")
        band = self.cmb_flt_band.get_active_text() or "ALL BANDS"
        if band == "ALL BANDS":
            band = "ALL"
        mode = self.cmb_flt_mode.get_active_text() or "ALL MODES"
        if mode == "ALL MODES":
            mode = "ALL"
        dxcc = self.cmb_flt_dxcc.get_active_text() or "ALL DXCC"
        if dxcc == "ALL DXCC":
            dxcc = "ALL"
        q = self.ent_search.get_text()

        rows = self.db.query_contacts(search=q, log_type=ltype, band=band, mode=mode, dxcc=dxcc)
        self.store.clear()
        for i, r in enumerate(rows):
            bg = "#fff7e9" if (i % 2 == 0) else "#e4f1e2"  # Authentic fanfold greenbar striping!
            az_s = f"{int(round(r['bearing_deg'])):03d}°" if r["distance_km"] > 0 else "--"
            dist_s = f"{int(round(r['distance_km'])):,d}" if r["distance_km"] > 0 else "--"
            qsl_s = f"{r.get('qsl_sent','N')}/{r.get('qsl_rcvd','N')}"
            dxcc_s = f"[{r['dxcc_code']}] {r['dxcc_entity']}" if r["dxcc_code"] else r["dxcc_entity"]
            self.store.append([
                int(r["id"]),
                r["qso_date"],
                r["time_on"],
                r["log_type"],
                r["call"],
                f"{float(r['freq_mhz']):.4f}",
                r["band"],
                r["mode"],
                r["rst_sent"],
                r["rst_rcvd"],
                r["grid"],
                dxcc_s,
                az_s,
                dist_s,
                r["name"],
                r["qth"],
                r["tx_pwr"],
                qsl_s,
                r["notes"],
                bg,
                float(r["freq_mhz"]),
                float(r["distance_km"]),
            ])
        self.count_lbl.set_text(f"{len(rows)} SHOWN")

    def _get_selected_row_id(self) -> int | None:
        sel = self.tree.get_selection()
        if not sel:
            return None
        model, it = sel.get_selected()
        if it is not None:
            return int(model.get_value(it, 0))
        return None

    def _on_tree_cursor_changed(self, _tv):
        # If call entry is currently blank, point the analog azimuth compass at the highlighted logged contact!
        if self.ent_call.get_text().strip():
            return
        rid = self._get_selected_row_id()
