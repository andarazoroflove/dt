class LogbookDB:
    def __init__(self, db_path: Path):
        self.db_path = db_path
        self.db_path.parent.mkdir(parents=True, exist_ok=True)
        self.conn = sqlite3.connect(str(self.db_path))
        self.conn.row_factory = sqlite3.Row
        self._init_schema()

    def _init_schema(self):
        self.conn.executescript(
            """
            CREATE TABLE IF NOT EXISTS contacts (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                log_type TEXT NOT NULL DEFAULT 'QSO',
                qso_date TEXT NOT NULL,
                time_on TEXT NOT NULL,
                call TEXT NOT NULL,
                freq_mhz REAL NOT NULL DEFAULT 14.2300,
                band TEXT NOT NULL,
                mode TEXT NOT NULL,
                rst_sent TEXT DEFAULT '59',
                rst_rcvd TEXT DEFAULT '59',
                grid TEXT DEFAULT '',
                name TEXT DEFAULT '',
                qth TEXT DEFAULT '',
                tx_pwr TEXT DEFAULT '100',
                notes TEXT DEFAULT '',
                dxcc_entity TEXT DEFAULT '',
                dxcc_code TEXT DEFAULT '',
                continent TEXT DEFAULT '',
                cq_zone INTEGER DEFAULT 0,
                itu_zone INTEGER DEFAULT 0,
                bearing_deg REAL DEFAULT 0.0,
                distance_km REAL DEFAULT 0.0,
                qsl_sent TEXT DEFAULT 'N',
                qsl_rcvd TEXT DEFAULT 'N'
            );
            CREATE INDEX IF NOT EXISTS idx_contacts_call ON contacts(call);
            CREATE INDEX IF NOT EXISTS idx_contacts_date ON contacts(qso_date DESC, time_on DESC);
            """
        )
        self.conn.commit()

    def close(self):
        try:
            self.conn.close()
        except Exception:
            pass

    def insert_contact(self, d: dict) -> int:
        cur = self.conn.execute(
            """
            INSERT INTO contacts (
                log_type, qso_date, time_on, call, freq_mhz, band, mode,
                rst_sent, rst_rcvd, grid, name, qth, tx_pwr, notes,
                dxcc_entity, dxcc_code, continent, cq_zone, itu_zone,
                bearing_deg, distance_km, qsl_sent, qsl_rcvd
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                d.get("log_type", "QSO"),
                d.get("qso_date", ""),
                d.get("time_on", ""),
                d.get("call", "").strip().upper(),
                float(d.get("freq_mhz") or 0.0),
                d.get("band", "20m"),
                d.get("mode", "SSB"),
                d.get("rst_sent", "59"),
                d.get("rst_rcvd", "59"),
                d.get("grid", ""),
                d.get("name", ""),
                d.get("qth", ""),
                d.get("tx_pwr", ""),
                d.get("notes", ""),
                d.get("dxcc_entity", ""),
