            "tx_pwr": "100",
            "notes": "FB DX over pole",
            "dxcc_entity": ja["entity"],
            "dxcc_code": ja["iso2"],
            "continent": ja["cont"],
            "cq_zone": ja["cq_zone"],
            "itu_zone": ja["itu_zone"],
