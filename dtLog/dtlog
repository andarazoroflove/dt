# ADIF 3.1.4 Parser & Formatter (.adi)
# ---------------------------------------------------------------------------
ADIF_TAG_RE = re.compile(r"<([A-Za-z0-9_]+)(?::(\d+)(?::[^>]*)?)?>", re.IGNORECASE)


def parse_adif_text(text: str) -> list[dict[str, str]]:
    """Parse ADIF 3.1 (.adi) content into a list of uppercase-keyed field dicts."""
    if not text:
        return []
    # Skip header up to <EOH> if present
    m_eoh = re.search(r"<EOH>", text, flags=re.IGNORECASE)
    pos = m_eoh.end() if m_eoh else 0
    records: list[dict[str, str]] = []
    cur: dict[str, str] = {}

    while pos < len(text):
        m = ADIF_TAG_RE.search(text, pos)
        if not m:
            break
        tag = m.group(1).upper()
        len_s = m.group(2)
        val_start = m.end()
        if tag == "EOR":
            if cur:
                records.append(cur)
                cur = {}
            pos = val_start
        elif tag == "EOH":
            cur = {}
            pos = val_start
        elif len_s is not None:
            n = int(len_s)
            val = text[val_start : val_start + n]
            cur[tag] = val.strip()
            pos = val_start + n
        else:
            pos = val_start
    if cur and "CALL" in cur:
        records.append(cur)
    return records


def adif_field(tag: str, val: str) -> str:
    s = str(val or "").strip()
    if not s:
        return ""
    return f"<{tag}:{len(s)}>{s} "


def format_adif_export(rows: list[dict], operator_cfg: dict) -> str:
    now_s = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d %H%M%S")
    lines = [
        "dtLog Vintage Station Logbook ADIF Export",
        f"<ADIF_VER:5>3.1.4",
        f"<PROGRAMID:5>dtLog",
        f"<PROGRAMVERSION:3>1.0",
        f"<CREATED_TIMESTAMP:{len(now_s)}>{now_s}",
        "<EOH>",
        "",
    ]
    op_call = operator_cfg.get("callsign", "W1AW")
    op_grid = operator_cfg.get("grid", "FN31pr")

    for r in rows:
        qdate = re.sub(r"[^0-9]", "", r.get("qso_date", ""))[:8]
        qtime = re.sub(r"[^0-9]", "", r.get("time_on", ""))
        if len(qtime) == 4:
            qtime += "00"
        qtime = qtime[:6]

        mode = (r.get("mode") or "SSB").upper()
        adif_mode = mode
        submode = ""
        if mode == "FT4":
            adif_mode, submode = "MFSK", "FT4"
        elif mode == "JS8":
            adif_mode, submode = "MFSK", "JS8"

        parts = [
            adif_field("CALL", r.get("call", "")),
            adif_field("QSO_DATE", qdate),
            adif_field("TIME_ON", qtime),
            adif_field("FREQ", f"{float(r.get('freq_mhz', 0.0)):.4f}" if r.get("freq_mhz") else ""),
            adif_field("BAND", r.get("band", "")),
            adif_field("MODE", adif_mode),
            adif_field("SUBMODE", submode),
            adif_field("RST_SENT", "" if r.get("rst_sent") == "--" else r.get("rst_sent", "")),
            adif_field("RST_RCVD", r.get("rst_rcvd", "")),
            adif_field("GRIDSQUARE", r.get("grid", "")),
            adif_field("NAME", r.get("name", "")),
            adif_field("QTH", r.get("qth", "")),
            adif_field("COUNTRY", r.get("dxcc_entity", "")),
            adif_field("CONT", r.get("continent", "")),
            adif_field("CQZ", str(r.get("cq_zone") or "") if r.get("cq_zone") else ""),
            adif_field("ITUZ", str(r.get("itu_zone") or "") if r.get("itu_zone") else ""),
            adif_field("TX_PWR", "" if r.get("tx_pwr") in ("--", "RX") else r.get("tx_pwr", "")),
            adif_field("COMMENT", r.get("notes", "")),
            adif_field("QSL_SENT", r.get("qsl_sent", "N")),
            adif_field("QSL_RCVD", r.get("qsl_rcvd", "N")),
            adif_field("STATION_CALLSIGN", op_call),
            adif_field("MY_GRIDSQUARE", op_grid),
        ]
        if r.get("log_type") == "SWL":
            parts.append(adif_field("SWL", "Y"))
        lines.append("".join(p for p in parts if p) + "<EOR>")
    return "\n".join(lines) + "\n"


