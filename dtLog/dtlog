# Offline ITU / ARRL DXCC Prefix & US/VE/VK/JA Call-Area Resolver (270+ Entities)
# ---------------------------------------------------------------------------
def iso_flag(iso2: str) -> str:
    if len(iso2) == 2 and iso2.isalpha():
        u = iso2.upper()
        return chr(0x1F1E6 + ord(u[0]) - 65) + chr(0x1F1E6 + ord(u[1]) - 65)
    return "🌐"


