# ---------------------------------------------------------------------------
# Maidenhead Grid Locator & Great-Circle Geodesic Math
# ---------------------------------------------------------------------------
GRID_RE = re.compile(r"^[A-Ra-r]{2}[0-9]{2}([A-Xa-x]{2}([0-9]{2})?)?$")


def is_valid_grid(grid: str) -> bool:
    return bool(GRID_RE.match((grid or "").strip()))


def grid_to_latlon(grid: str) -> tuple[float, float] | None:
    g = (grid or "").strip()
    if not is_valid_grid(g):
        return None
    g_up = g.upper()
    lon = (ord(g_up[0]) - ord("A")) * 20.0 - 180.0
    lat = (ord(g_up[1]) - ord("A")) * 10.0 - 90.0
    lon += int(g_up[2]) * 2.0
    lat += int(g_up[3]) * 1.0
    if len(g_up) >= 6:
        lon += (ord(g_up[4]) - ord("A")) * (2.0 / 24.0)
        lat += (ord(g_up[5]) - ord("A")) * (1.0 / 24.0)
        if len(g_up) >= 8:
            lon += int(g_up[6]) * (2.0 / 240.0) + (1.0 / 240.0)
            lat += int(g_up[7]) * (1.0 / 240.0) + (0.5 / 240.0)
        else:
            lon += 1.0 / 24.0
            lat += 0.5 / 24.0
    else:
        lon += 1.0
        lat += 0.5
    return round(lat, 4), round(lon, 4)


def latlon_to_grid(lat: float, lon: float, chars: int = 6) -> str:
    lon_adj = max(-179.9999, min(179.9999, lon)) + 180.0
    lat_adj = max(-89.9999, min(89.9999, lat)) + 90.0
    f_lon = int(lon_adj // 20.0)
    f_lat = int(lat_adj // 10.0)
    lon_rem = lon_adj - f_lon * 20.0
    lat_rem = lat_adj - f_lat * 10.0
    s_lon = int(lon_rem // 2.0)
    s_lat = int(lat_rem // 1.0)
    out = f"{chr(ord('A') + f_lon)}{chr(ord('A') + f_lat)}{s_lon}{s_lat}"
    if chars >= 6:
        sub_lon = int((lon_rem - s_lon * 2.0) * 12.0)
        sub_lat = int((lat_rem - s_lat * 1.0) * 24.0)
        sub_lon = max(0, min(23, sub_lon))
        sub_lat = max(0, min(23, sub_lat))
        out += f"{chr(ord('a') + sub_lon)}{chr(ord('a') + sub_lat)}"
    return out


def great_circle(lat1: float, lon1: float, lat2: float, lon2: float) -> dict:
    """Compute short-path & long-path azimuth bearings (deg) and distances (km/mi)."""
    if abs(lat1 - lat2) < 1e-6 and abs(lon1 - lon2) < 1e-6:
        return {
            "sp_deg": 0.0,
            "lp_deg": 180.0,
            "sp_km": 0.0,
            "sp_mi": 0.0,
            "lp_km": 40030.2,
            "lp_mi": 24873.6,
            "compass": "LOCAL",
        }
    p1 = math.radians(lat1)
    p2 = math.radians(lat2)
    dlon = math.radians(lon2 - lon1)
    dlat = p2 - p1

    a = math.sin(dlat * 0.5) ** 2 + math.cos(p1) * math.cos(p2) * (math.sin(dlon * 0.5) ** 2)
    a = max(0.0, min(1.0, a))
    c = 2.0 * math.atan2(math.sqrt(a), math.sqrt(max(0.0, 1.0 - a)))

    earth_r_km = 6371.0088
    circum_km = 2.0 * math.pi * earth_r_km
    sp_km = earth_r_km * c
    lp_km = max(0.0, circum_km - sp_km)

    y = math.sin(dlon) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dlon)
    sp_deg = (math.degrees(math.atan2(y, x)) + 360.0) % 360.0
    lp_deg = (sp_deg + 180.0) % 360.0

    dirs = ("N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW")
    compass = dirs[int(((sp_deg + 11.25) % 360.0) // 22.5)]
    return {
        "sp_deg": sp_deg,
        "lp_deg": lp_deg,
        "sp_km": sp_km,
        "sp_mi": sp_km * 0.6213712,
        "lp_km": lp_km,
        "lp_mi": lp_km * 0.6213712,
        "compass": compass,
    }


def freq_mhz_to_band(freq_mhz: float, is_swl: bool = False) -> str:
    if freq_mhz <= 0:
        return "SWL/HF" if is_swl else "20m"
    for bname, flo, fhi, _fdef in BAND_PLAN:
        if flo <= freq_mhz <= fhi:
            return bname
    if 0.52 <= freq_mhz <= 1.7999:
        return "MW"
    if freq_mhz < 30.0:
        return "SWL/HF"
    return "VHF/UHF"


def default_rst_for_mode(mode: str, is_swl: bool = False) -> tuple[str, str]:
    m = (mode or "SSB").upper()
    if is_swl or m == "SWL":
        return "--", "45444"
    if m in ("CW", "RTTY"):
        return "599", "599"
    if m in ("FT8", "FT4", "JS8"):
        return "-10", "-10"
    if m == "SSTV":
        return "595", "595"
    return "59", "59"


