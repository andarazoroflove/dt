    def delete_contact(self, row_id: int):
        self.conn.execute("DELETE FROM contacts WHERE id=?", (int(row_id),))
        self.conn.commit()

    def get_contact(self, row_id: int) -> dict | None:
        r = self.conn.execute("SELECT * FROM contacts WHERE id=?", (int(row_id),)).fetchone()
        return dict(r) if r else None

    def toggle_qsl(self, row_id: int, field: str):
        if field not in ("qsl_sent", "qsl_rcvd"):
            return
        r = self.get_contact(row_id)
        if not r:
            return
        nxt = "Y" if r.get(field) != "Y" else "N"
        self.conn.execute(f"UPDATE contacts SET {field}=? WHERE id=?", (nxt, int(row_id)))
        self.conn.commit()

    def query_contacts(
        self, search: str = "", log_type: str = "ALL", band: str = "ALL", mode: str = "ALL", dxcc: str = "ALL"
    ) -> list[dict]:
        clauses = []
        params: list = []
        if log_type in ("QSO", "SWL"):
            clauses.append("log_type = ?")
            params.append(log_type)
        if band and band != "ALL":
            clauses.append("LOWER(band) = LOWER(?)")
            params.append(band)
        if mode and mode != "ALL":
            clauses.append("UPPER(mode) = UPPER(?)")
            params.append(mode)
        if dxcc and dxcc != "ALL":
            clauses.append("(UPPER(dxcc_code) = UPPER(?) OR dxcc_entity = ?)")
            params.extend([dxcc, dxcc])
        if search.strip():
            q = f"%{search.strip()}%"
            clauses.append(
                "(call LIKE ? OR name LIKE ? OR qth LIKE ? OR grid LIKE ? OR dxcc_entity LIKE ? OR dxcc_code LIKE ? OR notes LIKE ?)"
            )
            params.extend([q, q, q, q, q, q, q])
        where_sql = ("WHERE " + " AND ".join(clauses)) if clauses else ""
        rows = self.conn.execute(
            f"SELECT * FROM contacts {where_sql} ORDER BY qso_date DESC, time_on DESC, id DESC",
            params,
        ).fetchall()
        return [dict(r) for r in rows]

    def get_distinct_dxcc(self) -> list[str]:
        rows = self.conn.execute(
            "SELECT DISTINCT dxcc_code FROM contacts WHERE dxcc_code != '' ORDER BY dxcc_code ASC"
        ).fetchall()
        return [r[0] for r in rows if r[0]]

    def check_dupe_and_history(self, call: str, band: str, mode: str, exclude_id: int | None = None) -> dict:
        c_up = (call or "").strip().upper()
        if not c_up:
            return {"is_dupe": False, "dupe_row": None, "prev_rows": [], "new_dxcc": False}
        rows = self.conn.execute(
            "SELECT * FROM contacts WHERE call = ? ORDER BY qso_date DESC, time_on DESC",
            (c_up,),
        ).fetchall()
        prev = [dict(r) for r in rows if exclude_id is None or r["id"] != exclude_id]
        # Normalize SSB/USB/LSB equivalence for voice dupe check
        voice_set = {"SSB", "USB", "LSB"}
        m_up = (mode or "").upper()
        b_lo = (band or "").lower()
        dupe_row = None
        for r in prev:
            rm = (r["mode"] or "").upper()
            same_mode = (rm == m_up) or (rm in voice_set and m_up in voice_set)
            if (r["band"] or "").lower() == b_lo and same_mode:
                dupe_row = r
                break
        return {"is_dupe": dupe_row is not None, "dupe_row": dupe_row, "prev_rows": prev}

    def is_dxcc_worked(self, dxcc_code: str) -> bool:
        if not dxcc_code:
            return False
        r = self.conn.execute(
            "SELECT 1 FROM contacts WHERE dxcc_code = ? LIMIT 1", (dxcc_code,)
        ).fetchone()
        return r is not None

    def get_stats(self) -> dict[str, int]:
        total_qsos = self.conn.execute("SELECT COUNT(*) FROM contacts WHERE log_type='QSO'").fetchone()[0]
        swl_logs = self.conn.execute("SELECT COUNT(*) FROM contacts WHERE log_type='SWL'").fetchone()[0]
        unique_calls = self.conn.execute("SELECT COUNT(DISTINCT call) FROM contacts WHERE call != ''").fetchone()[0]
        dxcc_cnt = self.conn.execute(
            "SELECT COUNT(DISTINCT dxcc_code) FROM contacts WHERE dxcc_code != ''"
        ).fetchone()[0]
        grids_cnt = self.conn.execute(
            "SELECT COUNT(DISTINCT UPPER(SUBSTR(grid, 1, 4))) FROM contacts WHERE LENGTH(grid) >= 4"
        ).fetchone()[0]
        bands_cnt = self.conn.execute("SELECT COUNT(DISTINCT LOWER(band)) FROM contacts WHERE band != ''").fetchone()[0]
        return {
            "total_qsos": int(total_qsos),
            "swl_logs": int(swl_logs),
            "unique_calls": int(unique_calls),
            "dxcc_entities": int(dxcc_cnt),
            "grids_worked": int(grids_cnt),
            "bands": int(bands_cnt),
        }

    def import_adif_records(self, adif_recs: list[dict[str, str]], home_lat: float, home_lon: float) -> tuple[int, int]:
        added = 0
        skipped = 0
        existing = set()
        for r in self.conn.execute("SELECT call, qso_date, SUBSTR(time_on,1,5), LOWER(band), UPPER(mode) FROM contacts"):
            existing.add((r[0], r[1], r[2], r[3], r[4]))

        for rec in adif_recs:
            call = rec.get("CALL", "").strip().upper()
            if not call:
                skipped += 1
                continue
            raw_d = re.sub(r"[^0-9]", "", rec.get("QSO_DATE", ""))
            if len(raw_d) == 8:
                qdate = f"{raw_d[0:4]}-{raw_d[4:6]}-{raw_d[6:8]}"
            else:
                qdate = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d")

            raw_t = re.sub(r"[^0-9]", "", rec.get("TIME_ON", "") or rec.get("TIME_OFF", ""))
            if len(raw_t) >= 4:
                qtime = f"{raw_t[0:2]}:{raw_t[2:4]}"
            else:
                qtime = "00:00"

            try:
                freq_mhz = float(rec.get("FREQ", "0") or 0.0)
            except ValueError:
                freq_mhz = 0.0

            is_swl = rec.get("SWL", "").upper() == "Y" or rec.get("MODE", "").upper() == "SWL"
            band = rec.get("BAND", "").strip()
            if not band:
                band = freq_mhz_to_band(freq_mhz, is_swl=is_swl)
            elif freq_mhz <= 0.0:
                for bn, _lo, _hi, fdef in BAND_PLAN:
                    if bn.lower() == band.lower():
                        freq_mhz = fdef
                        break

            mode = (rec.get("SUBMODE") or rec.get("MODE") or "SSB").strip().upper()
            if mode == "MFSK" and rec.get("SUBMODE"):
                mode = rec["SUBMODE"].strip().upper()

            key = (call, qdate, qtime[:5], band.lower(), mode.upper())
            if key in existing:
                skipped += 1
                continue
            existing.add(key)

            grid = rec.get("GRIDSQUARE", "").strip()
            info = resolve_call_or_station(call, grid, home_lat, home_lon)
            qth = rec.get("QTH", "").strip()
            state = rec.get("STATE", "").strip()
            if state and state not in qth:
                qth = f"{qth}, {state}".strip(", ")

            notes = rec.get("COMMENT", "") or rec.get("NOTES", "")
            d_ins = {
                "log_type": "SWL" if is_swl else "QSO",
                "qso_date": qdate,
                "time_on": qtime,
                "call": call,
                "freq_mhz": freq_mhz,
                "band": band,
                "mode": mode,
                "rst_sent": rec.get("RST_SENT") or ("--" if is_swl else "59"),
                "rst_rcvd": rec.get("RST_RCVD") or ("45444" if is_swl else "59"),
                "grid": grid or info.get("grid", ""),
                "name": rec.get("NAME", ""),
                "qth": qth,
                "tx_pwr": rec.get("TX_PWR", "RX" if is_swl else ""),
                "notes": notes,
                "dxcc_entity": rec.get("COUNTRY") or info.get("entity", ""),
                "dxcc_code": info.get("iso2") or info.get("prefix", ""),
                "continent": rec.get("CONT") or info.get("cont", ""),
                "cq_zone": int(rec["CQZ"]) if rec.get("CQZ", "").isdigit() else info.get("cq_zone", 0),
                "itu_zone": int(rec["ITUZ"]) if rec.get("ITUZ", "").isdigit() else info.get("itu_zone", 0),
                "bearing_deg": info.get("sp_deg") or 0.0,
                "distance_km": info.get("sp_km") or 0.0,
                "qsl_sent": rec.get("QSL_SENT", "N")[:1].upper() or "N",
                "qsl_rcvd": rec.get("QSL_RCVD", "N")[:1].upper() or "N",
            }
            self.insert_contact(d_ins)
            added += 1
        return added, skipped


# ---------------------------------------------------------------------------
# dtRadio Bridge Helper (Reads ~/.config/dtradio/state.json)
# ---------------------------------------------------------------------------
def parse_dtradio_state(state_path: Path = DTRADIO_STATE_FILE) -> dict | None:
    if not state_path.is_file():
        return None
    try:
        st = json.loads(state_path.read_text(encoding="utf-8"))
        freq_khz = float(st.get("freq_khz", 14230.0))
        freq_mhz = freq_khz / 1000.0
        raw_mode = str(st.get("mode", "USB")).upper()
        mode_map = {"NFM": "FM", "WFM": "FM"}
        mode = mode_map.get(raw_mode, raw_mode if raw_mode in ALL_MODES else "USB")
        title = str(st.get("title", "")).strip()
        source = str(st.get("source", "kiwi"))

        # Infer whether dtRadio is tuned to an Amateur band or a Broadcast/Utility/NOAA SWL station
        in_ham_band = any(flo <= freq_mhz <= fhi for _b, flo, fhi, _fd in BAND_PLAN)
        swl_keywords = ("WWV", "CHU", "NOAA", "WRMI", "WBCQ", "WINB", "WTWW", "WWCR", "RNZ", "BBC", "VOLMET", "HFGCS", "FEMA", "TOWER", "NASA", "UVB")
        title_up = title.upper()
        is_swl = (not in_ham_band) or any(k in title_up for k in swl_keywords) or source == "stream"

        # Extract station identifier if clearly present in title (e.g. "WWV", "NOAA KWO35", "WRMI", "CHU")
        extracted_station = ""
        m_noaa = re.search(r"\b(K[A-Z]{2}\d{2}|WWG\d{2}|WX[JK]\d{2}|WNG\d{3}|WZ\d{4})\b", title_up)
        if m_noaa:
            extracted_station = m_noaa.group(1)
        else:
            tok0 = re.split(r"[\s—\-/]+", title_up)[0] if title_up else ""
            if tok0 in SWL_STATIONS or re.match(r"^[A-Z]{3,5}$", tok0) and tok0 not in ("MANUAL", "VHF", "RTL", "MORSEOPS", "GLOBAL", "EAST"):
                extracted_station = tok0

        band = freq_mhz_to_band(freq_mhz, is_swl=is_swl)
        return {
            "freq_khz": freq_khz,
            "freq_mhz": freq_mhz,
            "mode": mode,
            "band": band,
            "title": title,
            "source": source,
            "is_swl": is_swl,
            "station_hint": extracted_station,
        }
    except Exception:
        return None


# ---------------------------------------------------------------------------
# Vintage Postcard QSL Card Renderer (Cairo Surface -> PNG + ASCII Slip)
# ---------------------------------------------------------------------------
def draw_qsl_card_cairo(cr: cairo.Context, W: float, H: float, row: dict, op_cfg: dict):
    op_call = op_cfg.get("callsign", "W1AW")
    op_grid = op_cfg.get("grid", "FN31pr")
    op_qth = op_cfg.get("qth", "Newington, CT").upper()
    op_itu = op_cfg.get("itu_zone", 6)
    op_cq = op_cfg.get("cq_zone", 3)
    is_swl = row.get("log_type") == "SWL"

    # Warm vintage cream postcard stock
    cr.rectangle(0, 0, W, H)
    cr.set_source_rgb(0.992, 0.968, 0.910)
    cr.fill()

    # Vintage airmail red & navy parallelogram border chevrons
    stripe_w = 10.0
    step = 34.0
    cr.save()
    # Top & bottom border bands
    for y_band in (0.0, H - stripe_w):
        cr.rectangle(0, y_band, W, stripe_w)
        cr.clip()
        for i in range(-2, int(W / step) + 3):
            x0 = i * step
            cr.set_source_rgb(0.76, 0.16, 0.16) if i % 2 == 0 else cr.set_source_rgb(0.12, 0.24, 0.44)
            cr.move_to(x0, y_band + stripe_w)
            cr.line_to(x0 + 10, y_band)
            cr.line_to(x0 + 26, y_band)
            cr.line_to(x0 + 16, y_band + stripe_w)
            cr.close_path()
            cr.fill()
        cr.reset_clip()
    # Left & right border bands
    for x_band in (0.0, W - stripe_w):
        cr.rectangle(x_band, stripe_w, stripe_w, H - 2 * stripe_w)
        cr.clip()
        for j in range(-2, int(H / step) + 3):
            y0 = j * step
            cr.set_source_rgb(0.76, 0.16, 0.16) if j % 2 == 0 else cr.set_source_rgb(0.12, 0.24, 0.44)
            cr.move_to(x_band, y0)
            cr.line_to(x_band + stripe_w, y0 + 10)
            cr.line_to(x_band + stripe_w, y0 + 26)
            cr.line_to(x_band, y0 + 16)
            cr.close_path()
            cr.fill()
        cr.reset_clip()
    cr.restore()

    # Inner double hairline frame
    pad = 18.0
    cr.set_line_width(2.0)
    cr.set_source_rgb(0.12, 0.24, 0.44)
    cr.rectangle(pad, pad, W - 2 * pad, H - 2 * pad)
    cr.stroke()
    cr.set_line_width(0.9)
    cr.rectangle(pad + 4, pad + 4, W - 2 * (pad + 4), H - 2 * (pad + 4))
    cr.stroke()

    # Subtle background Great-Circle globe watermark
    gx, gy, gr = W * 0.80, H * 0.30, H * 0.19
    cr.set_source_rgba(0.15, 0.32, 0.52, 0.11)
    cr.set_line_width(1.6)
    cr.arc(gx, gy, gr, 0, 2 * math.pi)
    cr.stroke()
    for lat_f in (-0.55, 0.0, 0.55):
        ry = gy + lat_f * gr
        rx_span = math.sqrt(max(0.0, gr * gr - (lat_f * gr) ** 2))
        cr.move_to(gx - rx_span, ry)
        cr.line_to(gx + rx_span, ry)
        cr.stroke()
    for lon_w in (0.35, 0.72):
        cr.save()
        cr.translate(gx, gy)
        cr.scale(lon_w, 1.0)
        cr.arc(0, 0, gr, 0, 2 * math.pi)
        cr.restore()
        cr.stroke()

    # Vintage radio tower + RF lightning bolts at top-left
    tx, ty = pad + 48.0, pad + 26.0
    cr.set_source_rgb(0.14, 0.26, 0.46)
    cr.set_line_width(2.2)
    cr.move_to(tx, ty)
    cr.line_to(tx - 18, ty + 88)
    cr.move_to(tx, ty)
    cr.line_to(tx + 18, ty + 88)
    for cross_y, span in ((26, 6), (48, 10), (70, 14)):
        cr.move_to(tx - span, ty + cross_y)
        cr.line_to(tx + span, ty + cross_y)
    cr.stroke()
    # Red RF bolts radiating from tower apex
    cr.set_source_rgb(0.80, 0.15, 0.14)
    cr.set_line_width(2.0)
    for side in (-1, 1):
        cr.move_to(tx + side * 8, ty + 6)
        cr.line_to(tx + side * 22, ty - 2)
        cr.line_to(tx + side * 17, ty + 9)
        cr.line_to(tx + side * 32, ty + 3)
        cr.stroke()

    # Giant Crimson Vintage Callsign Banner
    cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(H * 0.125)
    # Subtle drop shadow
    cr.set_source_rgba(0.10, 0.18, 0.34, 0.22)
    cr.move_to(pad + 96, pad + 68)
    cr.show_text(op_call)
    cr.set_source_rgb(0.77, 0.13, 0.13)
    cr.move_to(pad + 93, pad + 65)
    cr.show_text(op_call)

    # Station QTH & Zone Subtitle
    cr.set_font_size(H * 0.030)
    cr.set_source_rgb(0.12, 0.24, 0.44)
    cr.move_to(pad + 95, pad + 90)
    cr.show_text(f"AMATEUR RADIO & SWL STATION  •  {op_qth}, USA")
    cr.set_font_size(H * 0.026)
    cr.set_source_rgb(0.26, 0.32, 0.40)
    cr.move_to(pad + 95, pad + 111)
    cr.show_text(f"MAIDENHEAD GRID: {op_grid}   •   ITU ZONE: {op_itu:02d}   •   CQ ZONE: {op_cq:02d}")

    # Top-right QSL / SWL Badge Stamp
    badge_txt = "SWL REPORT" if is_swl else "QSL CARD"
    cr.set_font_size(H * 0.031)
    b_ext = cr.text_extents(badge_txt)
    bx0 = W - pad - b_ext.width - 34
    by0 = pad + 18
    cr.set_source_rgb(0.12, 0.24, 0.44)
    cr.rectangle(bx0, by0, b_ext.width + 20, 30)
    cr.fill()
    cr.set_source_rgb(1.0, 0.97, 0.90)
    cr.move_to(bx0 + 10, by0 + 20)
    cr.show_text(badge_txt)

    # Confirmation Banner Strip
    cy0 = H * 0.34
    cr.set_source_rgb(0.12, 0.24, 0.44)
    cr.rectangle(pad + 16, cy0, W - 2 * (pad + 16), 34)
    cr.fill()
    cr.set_font_size(H * 0.032)
    cr.set_source_rgb(1.0, 0.96, 0.86)
    conf_lbl = "CONFIRMING SWL RECEPTION OF:" if is_swl else "CONFIRMING TWO-WAY QSO WITH:"
    cr.move_to(pad + 28, cy0 + 23)
    cr.show_text(conf_lbl)

    cr.set_font_size(H * 0.042)
    cr.set_source_rgb(1.0, 0.80, 0.28)
    c_ext = cr.text_extents(conf_lbl)
    target_call = row.get("call", "UNKNOWN")
    cr.move_to(pad + 42 + c_ext.width, cy0 + 24)
    cr.show_text(target_call)

    # Structured QSO Data Ledger Box
    tx0 = pad + 16
    ty0 = cy0 + 44
    tw = W - 2 * (pad + 16)
    th = H * 0.26
    cr.set_source_rgb(1.0, 0.992, 0.965)
    cr.rectangle(tx0, ty0, tw, th)
    cr.fill()
    cr.set_source_rgb(0.12, 0.24, 0.44)
    cr.set_line_width(1.6)
    cr.rectangle(tx0, ty0, tw, th)
    cr.stroke()

    # Header bar inside ledger
    hh = th * 0.36
    cr.set_source_rgb(0.88, 0.92, 0.96)
    cr.rectangle(tx0 + 1, ty0 + 1, tw - 2, hh)
    cr.fill()
    cr.move_to(tx0, ty0 + hh)
    cr.line_to(tx0 + tw, ty0 + hh)
    cr.stroke()

    cols = [
        ("UTC DATE", row.get("qso_date", ""), 0.17),
        ("UTC", row.get("time_on", ""), 0.11),
        ("FREQ (MHz)", f"{float(row.get('freq_mhz', 0.0)):.4f}", 0.16),
        ("BAND", row.get("band", ""), 0.10),
        ("MODE", row.get("mode", ""), 0.11),
        ("SINPO" if is_swl else "RST S/R", row.get("rst_rcvd", "") if is_swl else f"{row.get('rst_sent','59')}/{row.get('rst_rcvd','59')}", 0.15),
        ("AZ / DIST", f"{int(round(row.get('bearing_deg', 0)))}° / {int(round(row.get('distance_km', 0)))}km" if row.get("distance_km") else "--", 0.20),
    ]

    cur_x = tx0
    for idx, (hdr, val, frac) in enumerate(cols):
        cw = tw * frac
        if idx > 0:
            cr.set_source_rgb(0.12, 0.24, 0.44)
            cr.set_line_width(1.1)
            cr.move_to(cur_x, ty0)
            cr.line_to(cur_x, ty0 + th)
            cr.stroke()
        cr.set_font_size(H * 0.023)
        cr.set_source_rgb(0.12, 0.24, 0.44)
        hext = cr.text_extents(hdr)
        cr.move_to(cur_x + (cw - hext.width) * 0.5, ty0 + hh * 0.66)
        cr.show_text(hdr)

        cr.set_font_size(H * 0.030)
        cr.set_source_rgb(0.08, 0.10, 0.14)
        v_str = str(val)[:14]
        vext = cr.text_extents(v_str)
        cr.move_to(cur_x + (cw - vext.width) * 0.5, ty0 + hh + (th - hh) * 0.62)
        cr.show_text(v_str)
        cur_x += cw

    # Station details & Remarks section below table
    ry0 = ty0 + th + 24
    cr.set_font_size(H * 0.026)
    cr.set_source_rgb(0.16, 0.22, 0.30)
    dxcc_line = f"TO STATION QTH: {row.get('name', '')}  {row.get('qth', '')}  ({row.get('dxcc_entity', '')})   •   GRID: {row.get('grid', '--')}".strip()
    cr.move_to(tx0 + 4, ry0)
    cr.show_text(dxcc_line[:74])

    pwr_s = f"RX MONITOR (dtRadio / SDR)" if is_swl else f"TX POWER: {row.get('tx_pwr', '100')} W"
    notes_s = row.get("notes", "") or "Solid copy into Eastern Idaho! Vy 73."
    cr.move_to(tx0 + 4, ry0 + 24)
    cr.show_text(f"{pwr_s}   •   REMARKS: {notes_s[:52]}")

    # Bottom QSL status checkboxes & Operator signature
    fy = H - pad - 18
    qsl_box = "[X] TNX QSL" if row.get("qsl_rcvd") == "Y" else "[X] PSE QSL   [ ] TNX QSL"
    cr.set_font_size(H * 0.027)
    cr.set_source_rgb(0.76, 0.14, 0.14)
    cr.move_to(tx0 + 4, fy)
    cr.show_text(qsl_box)

    sig = f"73 de {op_call} ({op_grid})"
    cr.select_font_face("DejaVu Sans", cairo.FONT_SLANT_ITALIC, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(H * 0.036)
    cr.set_source_rgb(0.10, 0.22, 0.46)
    sext = cr.text_extents(sig)
    cr.move_to(W - pad - 20 - sext.width, fy)
    cr.show_text(sig)


def render_qsl_png(out_path: Path, row: dict, op_cfg: dict, width: int = 1140, height: int = 720):
    out_path.parent.mkdir(parents=True, exist_ok=True)
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, width, height)
    cr = cairo.Context(surf)
    draw_qsl_card_cairo(cr, float(width), float(height), row, op_cfg)
    surf.write_to_png(str(out_path))


def format_ascii_qsl(row: dict, op_cfg: dict) -> str:
    op_call = op_cfg.get("callsign", "W1AW")
    op_grid = op_cfg.get("grid", "FN31pr")
    op_qth = op_cfg.get("qth", "Newington, CT").upper()
    is_swl = row.get("log_type") == "SWL"
    hdr_mode = "SWL RECEPTION REPORT" if is_swl else "TWO-WAY AMATEUR QSO"
    rst_str = f"SINPO {row.get('rst_rcvd', '45444')}" if is_swl else f"SENT {row.get('rst_sent', '59')} / RCVD {row.get('rst_rcvd', '59')}"
    az_str = (
        f"{int(round(row.get('bearing_deg', 0))):03d} deg ({int(round(row.get('distance_km', 0)))} km)"
        if row.get("distance_km")
        else "--"
    )
    lines = [
        "+========================================================================+",
        f"|  {op_call:<10}  •  {op_qth:<24}  •  GRID {op_grid:<8}  •  USA   |",
        "+========================================================================+",
        f"|  CONFIRMING {hdr_mode:<22} WITH:  {row.get('call', ''):<24} |",
        "+------------+--------+------------+--------+-------+--------------------+",
        "|  UTC DATE  |  TIME  | FREQ (MHz) |  BAND  | MODE  |    SIGNAL REPORT   |",
        "+------------+--------+------------+--------+-------+--------------------+",
        f"| {row.get('qso_date',''):<10} | {row.get('time_on',''):<6} | {float(row.get('freq_mhz',0.0)):>10.4f} | {row.get('band',''):<6} | {row.get('mode',''):<5} | {rst_str:<18} |",
        "+------------+--------+------------+--------+-------+--------------------+",
        f"|  DXCC / QTH : {(row.get('dxcc_entity','') + ' ' + row.get('qth','')).strip()[:55]:<56} |",
        f"|  PATH / PWR : {az_str:<26}  TX PWR: {str(row.get('tx_pwr','100')):<18} |",
        f"|  REMARKS    : {(row.get('notes','') or 'Vy 73 & thanks for the contact!')[:56]:<56} |",
        f"|  [{'X' if row.get('qsl_rcvd')!='Y' else ' '}] PSE QSL   [{'X' if row.get('qsl_rcvd')=='Y' else ' '}] TNX QSL                       73 de {op_call:<14} |",
        "+========================================================================+",
    ]
    return "\n".join(lines)


