    def _import_adif_path(self, p: Path, label: str = "ADIF"):
        try:
            raw = p.read_text(encoding="utf-8", errors="replace")
            recs = parse_adif_text(raw)
            added, skipped = self.db.import_adif_records(recs, self.op_cfg["lat"], self.op_cfg["lon"])
            self.stats_cache = self.db.get_stats()
            self._refresh_table()
            self._flash(f"⬆ {label}: IMPORTED {added} CONTACTS ({skipped} DUPES SKIPPED)")
            self._set_status(f"IMPORTED {added} RECORDS FROM {p} ({skipped} SKIPPED)")
        except Exception as e:
            self._set_status(f"ADIF IMPORT ERROR: {e}")

