            self._refresh_table()

    def _delete_selected(self):
        rid = self._get_selected_row_id()
        if rid is None:
            return
        r = self.db.get_contact(rid)
        if not r:
            return
        dlg = Gtk.MessageDialog(
            transient_for=self,
            flags=0,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.YES_NO,
            text=f"Delete log entry #{rid} ({r['call']} on {r['qso_date']})?",
        )
        resp = dlg.run()
        dlg.destroy()
        if resp == Gtk.ResponseType.YES:
            self.db.delete_contact(rid)
            if self.editing_id == rid:
                self._clear_form(keep_rf=True)
            self.stats_cache = self.db.get_stats()
            self._refresh_table()
            self._set_status(f"DELETED LOG ENTRY #{rid}")

