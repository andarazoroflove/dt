        btn_copy = Gtk.Button(label="📋 COPY ASCII QSL")
        btn_copy.connect("clicked", self._on_copy_ascii)
        btn_bar.pack_start(btn_copy, False, False, 0)

        btn_close = Gtk.Button(label="CLOSE")
        btn_close.connect("clicked", lambda _b: self.response(Gtk.ResponseType.CLOSE))
        btn_bar.pack_end(btn_close, False, False, 0)

        self.show_all()

    def _on_draw_card(self, w, cr: cairo.Context):
        alloc = w.get_allocation()
        draw_qsl_card_cairo(cr, float(alloc.width), float(alloc.height), self.row, self.op_cfg)
        return False

    def _on_copy_ascii(self, _b):
        cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        cb.set_text(format_ascii_qsl(self.row, self.op_cfg), -1)
        cb.store()
        if self.on_status_cb:
            self.on_status_cb(f"COPIED ASCII QSL CARD FOR {self.row.get('call', '')} TO CLIPBOARD")

    def _on_save_png(self, _b):
        safe_call = re.sub(r"[^A-Za-z0-9_-]", "_", self.row.get("call", "QSO"))
        safe_date = re.sub(r"[^0-9]", "", self.row.get("qso_date", ""))
        default_dir = HOME / "Pictures"
        if not default_dir.is_dir():
            default_dir = HOME

        dlg = Gtk.FileChooserDialog(
            title="Save Vintage QSL Card (.PNG)",
            parent=self,
            action=Gtk.FileChooserAction.SAVE,
        )
        dlg.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            Gtk.STOCK_SAVE, Gtk.ResponseType.OK,
        )
        dlg.set_do_overwrite_confirmation(True)
        dlg.set_current_folder(str(default_dir))
        dlg.set_current_name(f"QSL_{self.op_cfg.get('callsign', 'W1AW')}_{safe_call}_{safe_date}.png")

        resp = dlg.run()
        out_file = dlg.get_filename()
        dlg.destroy()
        if resp == Gtk.ResponseType.OK and out_file:
            out_p = Path(out_file)
            if out_p.suffix.lower() != ".png":
                out_p = out_p.with_suffix(".png")
            render_qsl_png(out_p, self.row, self.op_cfg)
            if self.on_status_cb:
                self.on_status_cb(f"SAVED VINTAGE QSL PNG -> {out_p}")


# ---------------------------------------------------------------------------
# Top Vintage Shack Console Deck (VFD Clock/Stats + Tactical DXCC + Analog Compass)
# ---------------------------------------------------------------------------
class ShackConsoleDeck(Gtk.DrawingArea):
    def __init__(self, get_state_fn):
        super().__init__()
        self.get_state_fn = get_state_fn
        self.set_size_request(1060, 174)
        self.needle_deg = 0.0
        self.target_deg = 0.0
        self.has_target = False
        self.connect("draw", self._on_draw)

    def set_azimuth_target(self, deg: float | None):
        if deg is None:
            self.has_target = False
        else:
            self.has_target = True
            self.target_deg = float(deg) % 360.0

    def tick_rotor(self) -> bool:
        if self.has_target:
            diff = (self.target_deg - self.needle_deg + 540.0) % 360.0 - 180.0
            if abs(diff) > 0.15:
                self.needle_deg = (self.needle_deg + diff * 0.22) % 360.0
            else:
                self.needle_deg = self.target_deg
        self.queue_draw()
        return True

    def _draw_recessed_vfd_box(self, cr: cairo.Context, x: float, y: float, w: float, h: float):
        cr.rectangle(x, y, w, h)
        cr.set_source_rgb(0.03, 0.07, 0.07)
        cr.fill()
        cr.set_line_width(2.0)
        cr.set_source_rgb(0.01, 0.03, 0.03)
        cr.move_to(x, y + h)
        cr.line_to(x, y)
        cr.line_to(x + w, y)
        cr.stroke()
        cr.set_source_rgb(0.32, 0.37, 0.46)
        cr.move_to(x, y + h)
        cr.line_to(x + w, y + h)
        cr.line_to(x + w, y)
        cr.stroke()

    def _on_draw(self, w, cr: cairo.Context):
        alloc = w.get_allocation()
        W, H = float(alloc.width), float(alloc.height)
        st = self.get_state_fn()
        op = st["op"]
        stats = st["stats"]
        res = st["resolved"]
        dupe_info = st["dupe"]
        flash_msg = st["flash_msg"]

        # Brushed dark shack instrument housing
        cr.rectangle(0, 0, W, H)
        cr.set_source_rgb(0.12, 0.14, 0.17)
        cr.fill()

        pad = 6.0
        comp_w = 194.0
        left_w = max(365.0, (W - comp_w - 4 * pad) * 0.50)
        mid_x = pad + left_w + pad
        mid_w = max(290.0, W - mid_x - comp_w - 2 * pad)
        comp_x = W - pad - comp_w
        vh = H - 2 * pad

        # ===================================================================
        # 1. LEFT PANEL: Glowing VFD UTC/Local Shack Clock + 6-Stat Matrix
        # ===================================================================
        self._draw_recessed_vfd_box(cr, pad, pad, left_w, vh)

        now_utc = datetime.datetime.now(datetime.timezone.utc)
        now_loc = datetime.datetime.now()
        utc_str = now_utc.strftime("%H:%M:%S")
        utc_date = now_utc.strftime("%Y-%m-%d")
        loc_str = now_loc.strftime("%H:%M:%S")

        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        # Operator shack header strip
        cr.set_font_size(10.0)
        cr.set_source_rgb(1.0, 0.75, 0.24)
        op_banner = f"DE {op['callsign']}  •  GRID {op['grid']}  •  {op['qth'].upper()}"
        cr.move_to(pad + 11, pad + 18)
        cr.show_text(op_banner[:46])

        # Glowing Cyan-Green VFD UTC Clock
        cr.set_font_size(27.0)
        cr.set_source_rgba(0.18, 0.98, 0.84, 0.18)
        cr.move_to(pad + 12.5, pad + 51.5)
        cr.show_text(utc_str)
        cr.set_source_rgb(0.26, 0.99, 0.86)
        cr.move_to(pad + 11.0, pad + 50.0)
        cr.show_text(utc_str)

        u_ext = cr.text_extents(utc_str)
        cr.set_font_size(10.5)
        cr.set_source_rgb(0.45, 0.92, 0.82)
        cr.move_to(pad + 18.0 + u_ext.width, pad + 38.0)
        cr.show_text("UTC")
        cr.set_font_size(9.5)
        cr.set_source_rgb(0.35, 0.78, 0.70)
        cr.move_to(pad + 18.0 + u_ext.width, pad + 51.0)
        cr.show_text(utc_date)

        # Warm Amber Local Shack Clock on right side of VFD
        cr.set_font_size(14.5)
        l_ext = cr.text_extents(loc_str)
        lx0 = pad + left_w - l_ext.width - 14.0
        cr.set_source_rgb(1.0, 0.74, 0.28)
        cr.move_to(lx0, pad + 49.0)
        cr.show_text(loc_str)
        cr.set_font_size(8.8)
        cr.set_source_rgb(0.84, 0.62, 0.24)
        cr.move_to(lx0, pad + 34.0)
        cr.show_text("LOCAL SHACK")

        # 6-Cell Illuminated Telemetry Matrix (2x3 grid)
        stat_cells = [
            ("TOTAL QSOs", stats["total_qsos"], (0.28, 0.98, 0.85)),
            ("SWL LOGS", stats["swl_logs"], (1.00, 0.76, 0.28)),
            ("UNIQUE CALLS", stats["unique_calls"], (0.45, 0.95, 0.75)),
            ("DXCC ENTITIES", stats["dxcc_entities"], (0.38, 0.88, 0.98)),
            ("GRIDS WORKED", stats["grids_worked"], (0.58, 0.96, 0.62)),
            ("BANDS", stats["bands"], (1.00, 0.66, 0.34)),
        ]
        gx0 = pad + 9.0
        gy0 = pad + 61.0
        gw = left_w - 18.0
        gh = vh - 69.0
        cw = (gw - 8.0) / 3.0
        ch = (gh - 5.0) / 2.0

        for idx, (slbl, sval, scol) in enumerate(stat_cells):
            col_i = idx % 3
            row_i = idx // 3
            cx0 = gx0 + col_i * (cw + 4.0)
            cy0 = gy0 + row_i * (ch + 5.0)
            cr.set_source_rgb(0.05, 0.12, 0.12)
            cr.rectangle(cx0, cy0, cw, ch)
            cr.fill()
            cr.set_line_width(1.0)
            cr.set_source_rgba(0.22, 0.48, 0.44, 0.55)
            cr.rectangle(cx0, cy0, cw, ch)
            cr.stroke()

            cr.set_font_size(8.0)
            cr.set_source_rgb(0.45, 0.78, 0.72)
            cr.move_to(cx0 + 6.0, cy0 + 12.5)
            cr.show_text(slbl)

            cr.set_font_size(16.0)
            cr.set_source_rgb(*scol)
            vtxt = f"{sval:,d}"
            vext = cr.text_extents(vtxt)
            cr.move_to(cx0 + cw - vext.width - 7.0, cy0 + ch - 7.0)
            cr.show_text(vtxt)

        # ===================================================================
        # 2. CENTER PANEL: Tactical DXCC Prefix, Bearing & Dupe VFD Readout
        # ===================================================================
        self._draw_recessed_vfd_box(cr, mid_x, pad, mid_w, vh)
        cr.save()
        cr.rectangle(mid_x + 4, pad + 4, mid_w - 8, vh - 8)
        cr.clip()

        cr.set_font_size(9.2)
        cr.set_source_rgb(0.42, 0.84, 0.78)
        cr.move_to(mid_x + 11, pad + 18)
        cr.show_text("GREAT-CIRCLE DXCC & DUPE COMPUTER")

        if flash_msg:
            cr.set_source_rgba(1.0, 0.68, 0.14, 0.22)
            cr.rectangle(mid_x + 10, pad + 24, mid_w - 20, 22)
            cr.fill()
            cr.set_font_size(10.5)
            cr.set_source_rgb(1.0, 0.80, 0.28)
            cr.move_to(mid_x + 15, pad + 39)
            cr.show_text(flash_msg[:46])
        elif res["matched"]:
            code_tag = f"[{res['iso2'] or res['prefix']}]"
            if PangoCairo is not None:
                p_lay = w.create_pango_layout(f"{res['flag']} {code_tag} {res['entity']}"[:38])
                p_lay.set_font_description(Pango.FontDescription("DejaVu Sans Mono Bold 10"))
                cr.set_source_rgb(0.28, 0.99, 0.86)
                cr.move_to(mid_x + 11, pad + 25)
                PangoCairo.show_layout(cr, p_lay)
            else:
                cr.set_font_size(13.0)
                cr.set_source_rgb(0.28, 0.99, 0.86)
                cr.move_to(mid_x + 11, pad + 41)
                cr.show_text(f"{code_tag} {res['entity']}"[:36])
        else:
            cr.set_font_size(12.0)
            cr.set_source_rgb(0.30, 0.66, 0.60)
            cr.move_to(mid_x + 11, pad + 41)
            cr.show_text("ENTER CALLSIGN OR GRID LOCATOR...")

        if res["matched"]:
            # Zone / Continent / Grid line
            z_parts = []
            if res["cont"]:
                z_parts.append(f"CONT: {res['cont']}")
            if res["cq_zone"]:
                z_parts.append(f"CQZ: {res['cq_zone']:02d}")
            if res["itu_zone"]:
                z_parts.append(f"ITUZ: {res['itu_zone']:02d}")
            if res["grid"]:
                z_parts.append(f"GRID: {res['grid']}")
            cr.set_font_size(9.8)
            cr.set_source_rgb(1.0, 0.76, 0.28)
            cr.move_to(mid_x + 11, pad + 62)
            cr.show_text("  •  ".join(z_parts)[:48])

            # Short-Path & Long-Path Bearings + Distances from Home Grid
            if res["sp_deg"] is not None:
                cr.set_font_size(11.0)
                cr.set_source_rgb(1.0, 0.44, 0.38)
                sp_line = (
                    f"SHORT PATH: {res['sp_deg']:05.1f}° ({res['compass']})  •  "
                    f"{res['sp_km']:,.0f} km / {res['sp_mi']:,.0f} mi"
                )
                cr.move_to(mid_x + 11, pad + 86)
                cr.show_text(sp_line[:52])

                cr.set_font_size(10.0)
                cr.set_source_rgb(0.36, 0.88, 0.96)
                lp_line = (
                    f"LONG PATH : {res['lp_deg']:05.1f}°       •  "
                    f"{res['lp_km']:,.0f} km / {res['lp_mi']:,.0f} mi"
                )
                cr.move_to(mid_x + 11, pad + 106)
                cr.show_text(lp_line[:52])
        else:
            cr.set_font_size(9.8)
            cr.set_source_rgb(0.26, 0.56, 0.52)
            cr.move_to(mid_x + 11, pad + 66)
            cr.show_text(f"HOME QTH: {op['callsign']} @ {op['grid']} ({op['lat']:.4f}°, {op['lon']:.4f}°)")
            cr.move_to(mid_x + 11, pad + 86)
            cr.show_text("SHORT PATH: ---.-°  •  --- km / --- mi")
            cr.move_to(mid_x + 11, pad + 105)
            cr.show_text("LONG PATH : ---.-°  •  --- km / --- mi")

        # Bottom Dupe / Worked-Before Status Bar
        dy0 = pad + vh - 36.0
        if dupe_info["is_dupe"]:
            dr = dupe_info["dupe_row"]
            cr.set_source_rgba(0.88, 0.16, 0.14, 0.30)
            cr.rectangle(mid_x + 10, dy0, mid_w - 20, 26)
            cr.fill()
            cr.set_source_rgb(1.0, 0.36, 0.32)
            cr.set_line_width(1.2)
            cr.rectangle(mid_x + 10, dy0, mid_w - 20, 26)
            cr.stroke()
            cr.set_font_size(10.2)
            d_txt = f"⚠ DUPE ON {dr['band']} {dr['mode']}! (WORKED {dr['qso_date']} {dr['time_on']}Z)"
            cr.move_to(mid_x + 16, dy0 + 17)
            cr.show_text(d_txt[:48])
        elif dupe_info["prev_rows"]:
            prevs = dupe_info["prev_rows"]
            b_summary = ", ".join(dict.fromkeys(f"{r['band']} {r['mode']}" for r in prevs[:3]))
            cr.set_source_rgba(0.16, 0.62, 0.52, 0.24)
            cr.rectangle(mid_x + 10, dy0, mid_w - 20, 26)
            cr.fill()
            cr.set_source_rgb(0.42, 0.98, 0.80)
            cr.set_font_size(10.0)
            cr.move_to(mid_x + 16, dy0 + 17)
            cr.show_text(f"✓ WORKED {len(prevs)}x PREV ({b_summary})"[:48])
        elif res["matched"] and st["call_nonempty"]:
            tag_new = "★ NEW DXCC ENTITY!" if st["is_new_dxcc"] else "★ NEW STATION / BAND SLOT"
            cr.set_source_rgba(0.20, 0.58, 0.30, 0.22)
            cr.rectangle(mid_x + 10, dy0, mid_w - 20, 26)
            cr.fill()
            cr.set_source_rgb(0.55, 0.98, 0.58)
            cr.set_font_size(10.0)
            cr.move_to(mid_x + 16, dy0 + 17)
            cr.show_text(tag_new)
        else:
            cr.set_source_rgba(0.08, 0.18, 0.18, 0.55)
            cr.rectangle(mid_x + 10, dy0, mid_w - 20, 26)
            cr.fill()
            cr.set_source_rgb(0.32, 0.68, 0.62)
            cr.set_font_size(9.5)
            cr.move_to(mid_x + 16, dy0 + 17)
            cr.show_text("READY — TYPE CALLSIGN OR CLICK [⚡ GRAB FROM dtRadio]")

        cr.restore()

        # ===================================================================
        # 3. RIGHT PANEL: Backlit 360° Analog Rotor / Azimuth Beam Compass
        # ===================================================================
        cr.rectangle(comp_x, pad, comp_w, vh)
        cr.set_source_rgb(0.07, 0.08, 0.10)
        cr.fill()

        # Compass geometry (upper 78% dial + lower 22% inset VFD distance readout)
        vfd_strip_h = 26.0
        dial_cx = comp_x + comp_w * 0.5
        dial_cy = pad + (vh - vfd_strip_h) * 0.50 + 1.0
        dial_r = min(comp_w * 0.44, (vh - vfd_strip_h) * 0.46)

        # Machined brass/dark bezel ring
        cr.arc(dial_cx, dial_cy, dial_r + 4.5, 0, 2 * math.pi)
        cr.set_source_rgb(0.28, 0.24, 0.16)
        cr.fill()

        # Warm incandescent amber radial backlight glow
        glow = cairo.RadialGradient(dial_cx, dial_cy - dial_r * 0.15, 4.0, dial_cx, dial_cy, dial_r * 1.05)
        glow.add_color_stop_rgb(0.0, 1.00, 0.95, 0.76)
        glow.add_color_stop_rgb(0.68, 0.96, 0.82, 0.49)
        glow.add_color_stop_rgb(1.0, 0.78, 0.60, 0.30)
        cr.arc(dial_cx, dial_cy, dial_r, 0, 2 * math.pi)
        cr.set_source(glow)
        cr.fill()

        # Concentric range rings & crosshair
        cr.set_line_width(0.8)
        cr.set_source_rgba(0.38, 0.28, 0.14, 0.40)
        cr.arc(dial_cx, dial_cy, dial_r * 0.56, 0, 2 * math.pi)
        cr.stroke()
        cr.move_to(dial_cx - dial_r * 0.75, dial_cy)
        cr.line_to(dial_cx + dial_r * 0.75, dial_cy)
        cr.move_to(dial_cx, dial_cy - dial_r * 0.75)
        cr.line_to(dial_cx, dial_cy + dial_r * 0.75)
        cr.stroke()

        # Degree ticks every 10 deg (major every 30 deg)
        for deg in range(0, 360, 10):
            ang = math.radians(deg - 90.0)
            is_card = deg % 90 == 0
            is_maj = deg % 30 == 0
            r_in = dial_r - (7.5 if is_card else (5.2 if is_maj else 3.0))
            cr.set_line_width(1.8 if is_card else (1.2 if is_maj else 0.8))
            cr.set_source_rgb(0.76, 0.14, 0.12) if deg == 0 else cr.set_source_rgb(0.20, 0.15, 0.09)
            cr.move_to(dial_cx + r_in * math.cos(ang), dial_cy + r_in * math.sin(ang))
            cr.line_to(dial_cx + dial_r * math.cos(ang), dial_cy + dial_r * math.sin(ang))
            cr.stroke()

        # Cardinal & Intercardinal Rose Labels (N, NE, E, SE, S, SW, W, NW)
        rose_pts = [
            (0, "N", True),
            (45, "NE", False),
            (90, "E", True),
            (135, "SE", False),
            (180, "S", True),
            (225, "SW", False),
            (270, "W", True),
            (315, "NW", False),
        ]
        for deg, rlbl, is_c in rose_pts:
            ang = math.radians(deg - 90.0)
            rr = dial_r - (15.5 if is_c else 14.0)
            tx = dial_cx + rr * math.cos(ang)
            ty = dial_cy + rr * math.sin(ang)
            cr.set_font_size(9.5 if is_c else 7.6)
            if deg == 0:
                cr.set_source_rgb(0.78, 0.12, 0.12)
            else:
                cr.set_source_rgb(0.18, 0.14, 0.08)
            ext = cr.text_extents(rlbl)
            cr.move_to(tx - ext.width * 0.5, ty + ext.height * 0.42)
            cr.show_text(rlbl)

        # Draw Needles (Secondary Cyan Long-Path + Primary Crimson Short-Path)
        sp_a = math.radians(self.needle_deg - 90.0)
        lp_a = sp_a + math.pi
        perp = sp_a + math.pi * 0.5

        if self.has_target:
            # Secondary Cyan Long-Path Pointer
            cr.set_source_rgba(0.05, 0.58, 0.68, 0.90)
            cr.set_line_width(2.2)
            cr.move_to(dial_cx, dial_cy)
            cr.line_to(dial_cx + (dial_r - 9.0) * math.cos(lp_a), dial_cy + (dial_r - 9.0) * math.sin(lp_a))
            cr.stroke()
            # Cyan diamond tip
            tip_lx = dial_cx + (dial_r - 7.0) * math.cos(lp_a)
            tip_ly = dial_cy + (dial_r - 7.0) * math.sin(lp_a)
            cr.arc(tip_lx, tip_ly, 3.0, 0, 2 * math.pi)
            cr.fill()

            # Subtle needle shadow
            cr.set_source_rgba(0.08, 0.06, 0.04, 0.35)
            cr.move_to(dial_cx + 2 + (dial_r - 4.0) * math.cos(sp_a), dial_cy + 2 + (dial_r - 4.0) * math.sin(sp_a))
            cr.line_to(dial_cx + 2 + 4.2 * math.cos(perp), dial_cy + 2 + 4.2 * math.sin(perp))
            cr.line_to(dial_cx + 2 - 4.2 * math.cos(perp), dial_cy + 2 - 4.2 * math.sin(perp))
            cr.close_path()
            cr.fill()

            # Primary Crimson-Red Short-Path Tapered Needle
            cr.set_source_rgb(0.84, 0.12, 0.12)
            cr.move_to(dial_cx + (dial_r - 4.0) * math.cos(sp_a), dial_cy + (dial_r - 4.0) * math.sin(sp_a))
            cr.line_to(dial_cx + 4.2 * math.cos(perp), dial_cy + 4.2 * math.sin(perp))
            cr.line_to(dial_cx - 4.2 * math.cos(perp), dial_cy - 4.2 * math.sin(perp))
            cr.close_path()
            cr.fill()
        else:
            # Parked North hairline needle when idle
            cr.set_source_rgba(0.55, 0.22, 0.16, 0.55)
            cr.set_line_width(1.8)
            cr.move_to(dial_cx, dial_cy)
            cr.line_to(dial_cx, dial_cy - dial_r + 10.0)
            cr.stroke()

        # Center machined rotor hub cap
        cr.arc(dial_cx, dial_cy, 5.5, 0, 2 * math.pi)
        cr.set_source_rgb(0.18, 0.19, 0.23)
        cr.fill()
        cr.arc(dial_cx, dial_cy, 2.4, 0, 2 * math.pi)
        cr.set_source_rgb(0.86, 0.72, 0.36)
        cr.fill()

        # Inset bottom VFD Azimuth & Distance Strip
        vx = comp_x + 6.0
        vy = pad + vh - vfd_strip_h - 3.0
        vw = comp_w - 12.0
        cr.set_source_rgb(0.03, 0.08, 0.08)
        cr.rectangle(vx, vy, vw, vfd_strip_h)
        cr.fill()
        cr.set_font_size(9.2)
        if self.has_target and res["sp_km"] is not None:
            cr.set_source_rgb(0.30, 0.99, 0.86)
            v_txt = f"{res['sp_deg']:03.0f}°  {res['sp_km']:,.0f}km / {res['sp_mi']:,.0f}mi"
        else:
            cr.set_source_rgb(0.32, 0.72, 0.66)
            v_txt = f"ROTOR IDLE • {op['grid']}"
        vext = cr.text_extents(v_txt)
        cr.move_to(vx + (vw - vext.width) * 0.5, vy + 16.5)
        cr.show_text(v_txt)
        return False


# ---------------------------------------------------------------------------
# Main dtLog Vintage Shack Logbook Window
# ---------------------------------------------------------------------------
class DtLogWindow(Gtk.Window):
    def __init__(
        self,
        config_path: Path = CONFIG_FILE,
        db_path: Path = DB_FILE,
        dtradio_state_path: Path = DTRADIO_STATE_FILE,
        self_test: bool = False,
    ):
