        grid.set_margin_top(10)
        grid.set_margin_bottom(10)
        grid.set_margin_start(12)
        grid.set_margin_end(12)
        dlg.get_content_area().add(grid)

        e_call = Gtk.Entry(text=str(self.op_cfg.get("callsign", "W1AW")))
        e_grid = Gtk.Entry(text=str(self.op_cfg.get("grid", "FN31pr")))
        e_qth = Gtk.Entry(text=str(self.op_cfg.get("qth", "Newington, CT")))
        e_lat = Gtk.Entry(text=f"{float(self.op_cfg.get('lat', 41.7292)):.4f}")
        e_lon = Gtk.Entry(text=f"{float(self.op_cfg.get('lon', -72.7083)):.4f}")
        e_itu = Gtk.Entry(text=str(self.op_cfg.get("itu_zone", 6)))
        e_cq = Gtk.Entry(text=str(self.op_cfg.get("cq_zone", 3)))
        e_pwr = Gtk.Entry(text=str(self.op_cfg.get("tx_pwr", "100")))

        def _sync_grid_ll(_e):
            ll = grid_to_latlon(e_grid.get_text().strip())
            if ll is not None:
                e_lat.set_text(f"{ll[0]:.4f}")
                e_lon.set_text(f"{ll[1]:.4f}")

        e_grid.connect("changed", _sync_grid_ll)

        fields = [
            ("Operator Callsign:", e_call),
            ("Maidenhead Home Grid:", e_grid),
            ("Home QTH / City, State:", e_qth),
            ("Latitude (°N):", e_lat),
            ("Longitude (°E):", e_lon),
            ("ITU Zone:", e_itu),
            ("CQ Zone:", e_cq),
            ("Default TX Power (W):", e_pwr),
        ]
        for idx, (lbl_t, wid) in enumerate(fields):
            l = Gtk.Label(label=lbl_t)
            l.set_xalign(1.0)
            grid.attach(l, 0, idx, 1, 1)
            grid.attach(wid, 1, idx, 1, 1)

        dlg.show_all()
        resp = dlg.run()
        if resp == Gtk.ResponseType.OK:
            self.op_cfg["callsign"] = e_call.get_text().strip().upper() or "W1AW"
            g_txt = e_grid.get_text().strip() or "FN31pr"
            self.op_cfg["grid"] = g_txt[:4].upper() + g_txt[4:].lower()
            self.op_cfg["qth"] = e_qth.get_text().strip() or "Newington, CT"
            try:
                self.op_cfg["lat"] = float(e_lat.get_text().strip())
                self.op_cfg["lon"] = float(e_lon.get_text().strip())
            except ValueError:
                ll = grid_to_latlon(self.op_cfg["grid"])
                if ll:
                    self.op_cfg["lat"], self.op_cfg["lon"] = ll
            self.op_cfg["itu_zone"] = int(e_itu.get_text().strip() or 6) if e_itu.get_text().strip().isdigit() else 6
            self.op_cfg["cq_zone"] = int(e_cq.get_text().strip() or 3) if e_cq.get_text().strip().isdigit() else 3
            self.op_cfg["tx_pwr"] = e_pwr.get_text().strip() or "100"
            self._save_config()
            self._recompute_live_call()
            self._set_status(
                f"SAVED STATION CONFIG: {self.op_cfg['callsign']} @ {self.op_cfg['grid']} ({self.op_cfg['qth']})"
            )
        dlg.destroy()

