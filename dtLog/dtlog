    def _on_station_setup(self, _b):
        dlg = Gtk.Dialog(title="Station Setup — Operator & Home QTH", transient_for=self, flags=0)
        dlg.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_SAVE, Gtk.ResponseType.OK)
