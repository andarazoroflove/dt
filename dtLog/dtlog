        if r.get("band") in ALL_BANDS:
            self.cmb_band.set_active(ALL_BANDS.index(r["band"]))
        if r.get("mode") in ALL_MODES:
            self.cmb_mode.set_active(ALL_MODES.index(r["mode"]))
        self.ent_rst_s.set_text(r.get("rst_sent", "59"))
        self.ent_rst_r.set_text(r.get("rst_rcvd", "59"))
        self.ent_grid.set_text(r.get("grid", ""))
        self.ent_date.set_text(r.get("qso_date", ""))
        self.ent_time.set_text(r.get("time_on", ""))
