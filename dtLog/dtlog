PREFIX_INDEX: list[tuple[str, str, str, str, int, int, float, float, int]] = []
for pfxs, ename, iso2, cont, cqz, ituz, elat, elon, dxcc_id in DXCC_RAW:
    for p in pfxs.split(","):
        p_clean = p.strip().upper()
        if p_clean:
            PREFIX_INDEX.append((p_clean, ename, iso2, cont, cqz, ituz, elat, elon, dxcc_id))
PREFIX_INDEX.sort(key=lambda item: len(item[0]), reverse=True)


def resolve_call_or_station(raw_call: str, raw_grid: str, home_lat: float, home_lon: float) -> dict:
    """Resolve callsign or SWL station + optional Maidenhead Grid to DXCC, zones, lat/lon & azimuth."""
    call = (raw_call or "").strip().upper()
    grid = (raw_grid or "").strip()

    res = {
        "matched": False,
        "prefix": "",
        "entity": "",
        "iso2": "",
        "flag": "🌐",
        "cont": "",
        "cq_zone": 0,
        "itu_zone": 0,
        "dxcc_id": 0,
        "lat": None,
        "lon": None,
        "grid": grid if is_valid_grid(grid) else "",
        "sp_deg": None,
        "lp_deg": None,
        "sp_km": None,
        "sp_mi": None,
        "lp_km": None,
        "lp_mi": None,
        "compass": "",
    }

    if not call and not is_valid_grid(grid):
        return res

    # 1. Check exact or leading SWL / Time / Broadcast station tokens first
    first_tok = re.split(r"[\s/—\-]+", call)[0] if call else ""
    for swl_key, (sname, siso, scont, scq, situ, slat, slon, sgrid) in SWL_STATIONS.items():
        if first_tok == swl_key or call.startswith(swl_key + " "):
            res.update({
                "matched": True,
                "prefix": swl_key,
                "entity": sname,
                "iso2": siso,
                "flag": iso_flag(siso),
                "cont": scont,
                "cq_zone": scq,
                "itu_zone": situ,
                "dxcc_id": 291 if siso == "US" else 0,
                "lat": slat,
                "lon": slon,
                "grid": res["grid"] or sgrid,
            })
            break

    # 2. Standard ITU / ARRL Callsign Prefix Resolution (handling portable prefixes/suffixes)
    if not res["matched"] and call:
        # Strip trailing portable indicators (/P, /M, /MM, /AM, /QRP, /B)
        parts = [p for p in call.split("/") if p]
        eff = parts[0]
        us_area_override = None
        if len(parts) >= 2:
            suffix_mods = {"P", "M", "MM", "AM", "QRP", "QRPP", "B", "LH", "R", "T", "AG", "AE", "KT"}
            if parts[-1] in suffix_mods:
                parts = parts[:-1]
            if len(parts) >= 2:
                # e.g. KH6/W1AW -> KH6; W1AW/7 -> W1AW with call area 7; W1AW/KH6 -> KH6
                p0, p1 = parts[0], parts[1]
                if len(p1) == 1 and p1.isdigit():
                    eff = p0
                    us_area_override = p1
                elif len(p0) <= len(p1) and not p0.isdigit():
                    eff = p0
                elif len(p1) < len(p0) and not p1.isdigit():
                    eff = p1
                else:
                    eff = p0
            elif parts:
                eff = parts[0]

        eff_alnum = re.sub(r"[^A-Z0-9]", "", eff)
        for pfx, ename, iso2, cont, cqz, ituz, elat, elon, dxcc_id in PREFIX_INDEX:
            if eff_alnum.startswith(pfx):
                # Require valid callsign structure or >=2 char prefix so random words don't false-match single letters
                if len(pfx) == 1 and not re.match(r"^[A-Z]{1,2}[0-9]", eff_alnum):
                    continue
                res.update({
                    "matched": True,
                    "prefix": pfx,
                    "entity": ename,
                    "iso2": iso2,
                    "flag": iso_flag(iso2),
                    "cont": cont,
                    "cq_zone": cqz,
                    "itu_zone": ituz,
                    "dxcc_id": dxcc_id,
                    "lat": elat,
                    "lon": elon,
                })
                # Refine continental US call area (0..9) if entity is mainland US (dxcc 291)
                if dxcc_id == 291:
                    m_num = re.match(r"^[A-Z]{1,2}([0-9])", eff_alnum)
                    digit = us_area_override or (m_num.group(1) if m_num else None)
                    if digit and digit in US_CALL_AREAS:
                        uname, ucq, uitu, ulat, ulon = US_CALL_AREAS[digit]
                        res["entity"] = uname
                        res["cq_zone"] = ucq
                        res["itu_zone"] = uitu
                        res["lat"] = ulat
                        res["lon"] = ulon
                break

    # 3. Override coordinates if explicit valid Maidenhead Grid is supplied
    if is_valid_grid(grid):
        g_ll = grid_to_latlon(grid)
        if g_ll is not None:
            res["lat"], res["lon"] = g_ll
            res["grid"] = grid[:4].upper() + grid[4:].lower()
            if not res["matched"]:
                res["matched"] = True
                res["entity"] = f"Grid {res['grid']}"
    elif res["lat"] is not None and res["lon"] is not None and not res["grid"]:
        res["grid"] = latlon_to_grid(res["lat"], res["lon"], chars=4)

    # 4. Compute Great-Circle Short-Path & Long-Path from Operator Home QTH
    if res["lat"] is not None and res["lon"] is not None:
        gc = great_circle(home_lat, home_lon, res["lat"], res["lon"])
        res.update(gc)

    return res


