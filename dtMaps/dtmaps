class Spot:
    __slots__ = (
        "key", "tx_call", "tx_grid", "tx_lat", "tx_lon",
        "rx_call", "rx_grid", "rx_lat", "rx_lon",
        "freq_hz", "band", "mode", "snr", "ts", "dist_km",
        "source", "is_home_call", "is_home_grid", "arc_pts",
    )

    def __init__(
        self,
        tx_call: str,
        tx_grid: str,
        tx_lat: float,
        tx_lon: float,
        rx_call: str,
        rx_grid: str,
        rx_lat: float,
        rx_lon: float,
        freq_hz: float,
        band: str,
        mode: str,
        snr: int | None,
        ts: int,
        source: str,
        home_call: str,
        home_grid4: str,
    ):
        self.tx_call = tx_call.upper().strip()
        self.tx_grid = tx_grid.strip()
        self.tx_lat = tx_lat
        self.tx_lon = tx_lon
        self.rx_call = rx_call.upper().strip()
        self.rx_grid = rx_grid.strip()
        self.rx_lat = rx_lat
        self.rx_lon = rx_lon
        self.freq_hz = freq_hz
        self.band = band
        self.mode = (mode or "FT8").upper().strip()
        self.snr = snr
        self.ts = ts
        self.source = source
        hc = home_call.upper().strip()
        hg = home_grid4.upper()[:4]
        base_tx = self.tx_call.split("/")[0]
        base_rx = self.rx_call.split("/")[0]
        self.is_home_call = bool(hc and (self.tx_call == hc or self.rx_call == hc or base_tx == hc or base_rx == hc))
        self.is_home_grid = bool(hg and (self.tx_grid[:4].upper() == hg or self.rx_grid[:4].upper() == hg))
        self.dist_km, _, _ = geodesic_distance_bearing(tx_lat, tx_lon, rx_lat, rx_lon)
        self.key = f"{self.tx_call}>{self.rx_call}:{self.band}:{self.mode}"
        self.arc_pts: list[tuple[float, float]] | None = None

    def get_arc(self) -> list[tuple[float, float]]:
        if self.arc_pts is None:
            self.arc_pts = great_circle_unwrapped(self.tx_lat, self.tx_lon, self.rx_lat, self.rx_lon, steps=40)
        return self.arc_pts


def parse_pskreporter_xml(xml_text: str, home_call: str, home_grid4: str) -> list[Spot]:
    """Parse PSKReporter retrieve XML <receptionReport> entries into Spot objects."""
    spots: list[Spot] = []
    if not xml_text or "<receptionReport" not in xml_text:
        return spots
    try:
        root = ET.fromstring(xml_text)
        elems = root.iter("receptionReport")
    except ET.ParseError:
        # Resilient fallback regex if XML stream was truncated
        elems = []
        for m in re.finditer(r"<receptionReport\b([^>]*)/?>", xml_text):
            attrs = dict(re.findall(r'(\w+)="([^"]*)"', m.group(1)))
            elems.append(type("Elem", (), {"attrib": attrs})())

    now_ts = int(time.time())
    for el in elems:
        a = el.attrib
        sc = a.get("senderCallsign", "").strip()
        sl = a.get("senderLocator", "").strip()
        rc = a.get("receiverCallsign", "").strip()
        rl = a.get("receiverLocator", "").strip()
        if not sc or not rc or not sl or not rl:
            continue
        p_tx = maidenhead_to_latlon(sl)
        p_rx = maidenhead_to_latlon(rl)
        if not p_tx or not p_rx:
            continue
        try:
            f_hz = float(a.get("frequency", "0") or 0)
        except ValueError:
            f_hz = 0.0
        mode = a.get("mode", "FT8") or "FT8"
        snr_raw = a.get("sNR")
        try:
            snr = int(float(snr_raw)) if snr_raw not in (None, "") else None
        except ValueError:
            snr = None
        try:
            ts = int(a.get("flowStartSeconds", str(now_ts)) or now_ts)
        except ValueError:
            ts = now_ts
        band = freq_to_band(f_hz)
        spots.append(
            Spot(
                sc, sl, p_tx[0], p_tx[1],
                rc, rl, p_rx[0], p_rx[1],
                f_hz, band, mode, snr, ts,
                "PSK24H", home_call, home_grid4,
            )
        )
    spots.sort(key=lambda s: s.ts, reverse=True)
    return spots


def parse_mqtt_spot_json(payload: bytes, home_call: str, home_grid4: str) -> Spot | None:
    """Parse PSKReporter MQTT JSON payload into a Spot."""
    try:
        d = json.loads(payload.decode("utf-8", errors="ignore"))
    except Exception:
        return None
    if not isinstance(d, dict):
        return None
    sc = str(d.get("sc") or "").strip()
    sl = str(d.get("sl") or "").strip()
    rc = str(d.get("rc") or "").strip()
    rl = str(d.get("rl") or "").strip()
    if not sc or not rc or not sl or not rl:
        return None
    p_tx = maidenhead_to_latlon(sl)
    p_rx = maidenhead_to_latlon(rl)
    if not p_tx or not p_rx:
        return None
    try:
        f_hz = float(d.get("f") or 0.0)
    except (ValueError, TypeError):
        f_hz = 0.0
    band = freq_to_band(f_hz, str(d.get("b") or ""))
    mode = str(d.get("md") or "FT8")
    rp = d.get("rp")
    try:
        snr = int(rp) if rp is not None else None
    except (ValueError, TypeError):
        snr = None
    try:
        ts = int(d.get("t") or time.time())
    except (ValueError, TypeError):
        ts = int(time.time())

    return Spot(
        sc, sl, p_tx[0], p_tx[1],
        rc, rl, p_rx[0], p_rx[1],
        f_hz, band, mode, snr, ts,
        "MQTT", home_call, home_grid4,
    )


# ---------------------------------------------------------------------------
# Pure-Stdlib MQTT v3.1.1 Packet Builder & Streaming Client (mqtt.pskreporter.info:1883)
# ---------------------------------------------------------------------------
def mqtt_encode_varlen(length: int) -> bytes:
    out = bytearray()
    while True:
        digit = length % 128
        length //= 128
        if length > 0:
            digit |= 0x80
        out.append(digit)
        if length == 0:
            break
    return bytes(out)


def mqtt_encode_utf8(s: str) -> bytes:
    b = s.encode("utf-8")
    return struct.pack("!H", len(b)) + b


def mqtt_build_connect(client_id: str, keepalive: int = 60) -> bytes:
    var_hdr = mqtt_encode_utf8("MQTT") + struct.pack("!BBH", 4, 0x02, keepalive)
    payload = mqtt_encode_utf8(client_id)
    rem = var_hdr + payload
    return b"\x10" + mqtt_encode_varlen(len(rem)) + rem


def mqtt_build_subscribe(pkt_id: int, topics: list[str]) -> bytes:
    var_hdr = struct.pack("!H", pkt_id)
    payload = b"".join(mqtt_encode_utf8(t) + b"\x00" for t in topics)
    rem = var_hdr + payload
    return b"\x82" + mqtt_encode_varlen(len(rem)) + rem


def mqtt_build_pingreq() -> bytes:
    return b"\xc0\x00"


def mqtt_try_decode_packet(buf: bytearray) -> tuple[int, str, bytes, int] | None:
    """
    Attempt to decode one complete MQTT packet from `buf`.
    Returns (packet_type_nib, topic, payload_bytes, total_consumed_len) or None if incomplete.
    """
    if len(buf) < 2:
        return None
    first = buf[0]
    pkt_type = (first >> 4) & 0x0F
    flags = first & 0x0F

    mult = 1
    rem_len = 0
    idx = 1
    while True:
        if idx >= len(buf):
            return None
        b = buf[idx]
        idx += 1
        rem_len += (b & 0x7F) * mult
        mult *= 128
        if mult > 128 * 128 * 128:
            raise ValueError("Malformed MQTT variable length")
        if (b & 0x80) == 0:
            break

    total_len = idx + rem_len
    if len(buf) < total_len:
        return None

    body = bytes(buf[idx:total_len])
    topic = ""
    payload = body
    if pkt_type == 3:  # PUBLISH
        if len(body) < 2:
            return (pkt_type, "", b"", total_len)
        tlen = struct.unpack("!H", body[:2])[0]
        pos = 2 + tlen
        topic = body[2:pos].decode("utf-8", errors="replace")
        qos = (flags >> 1) & 0x03
        if qos > 0:
            pos += 2
        payload = body[pos:]
    return (pkt_type, topic, payload, total_len)


class PSKReporterMQTTClient:
    """Resilient non-blocking MQTT v3.1.1 live spot stream from mqtt.pskreporter.info:1883."""

    HOST = "mqtt.pskreporter.info"
    PORT = 1883

    def __init__(self, get_qth_fn, on_spot_batch_fn, on_state_fn):
        self._get_qth = get_qth_fn
        self._on_spot_batch = on_spot_batch_fn
        self._on_state = on_state_fn
        self._stop = threading.Event()
        self._reconnect = threading.Event()
        self._thread = threading.Thread(target=self._run, name="dtmaps-mqtt", daemon=True)

    def start(self) -> None:
        self._thread.start()

    def trigger_resubscribe(self) -> None:
        self._reconnect.set()

    def stop(self) -> None:
        self._stop.set()
        self._reconnect.set()

    def _build_topics(self, call: str, grid4: str) -> list[str]:
        c = call.upper().strip() or DEFAULT_CALLSIGN
        g = grid4.upper()[:4] or "FN31"
        return [
            f"pskr/filter/v2/+/+/{c}/#",
            f"pskr/filter/v2/+/+/+/{c}/#",
            f"pskr/filter/v2/+/+/+/+/{g}/#",
            f"pskr/filter/v2/+/+/+/+/+/{g}/#",
            "pskr/filter/v2/+/FT8/#",
            "pskr/filter/v2/+/FT4/#",
            "pskr/filter/v2/+/JS8/#",
            "pskr/filter/v2/+/CW/#",
            "pskr/filter/v2/+/WSPR/#",
        ]

    def _run(self) -> None:
        backoff = 3.0
        while not self._stop.is_set():
            self._reconnect.clear()
            call, grid = self._get_qth()
            grid4 = grid[:4].upper() if len(grid) >= 4 else "FN31"
            cid = f"dtmaps_{call.lower()}_{random.randint(10000, 99999)}"
            sock = None
            try:
                self._on_state("CONNECTING")
                sock = socket.create_connection((self.HOST, self.PORT), timeout=6.0)
                sock.settimeout(1.0)
                sock.sendall(mqtt_build_connect(cid, keepalive=60))

                buf = bytearray()
                # Wait for CONNACK (packet type 2)
                deadline = time.monotonic() + 6.0
                conn_ok = False
                while time.monotonic() < deadline and not self._stop.is_set():
                    try:
                        chunk = sock.recv(4096)
                        if not chunk:
                            break
                        buf.extend(chunk)
                        pkt = mqtt_try_decode_packet(buf)
                        if pkt:
                            ptype, _, pl, consumed = pkt
                            del buf[:consumed]
                            if ptype == 2 and len(pl) >= 2 and pl[1] == 0:
                                conn_ok = True
                                break
                    except socket.timeout:
                        continue

                if not conn_ok:
                    raise OSError("MQTT CONNACK failed")

                topics = self._build_topics(call, grid4)
                sock.sendall(mqtt_build_subscribe(1, topics))
                self._on_state("LIVE MQTT")
                backoff = 3.0

                last_ping = time.monotonic()
                last_flush = time.monotonic()
                last_global_emit = 0.0
                batch: list[Spot] = []

                while not self._stop.is_set() and not self._reconnect.is_set():
                    now = time.monotonic()
                    if now - last_ping >= 28.0:
                        sock.sendall(mqtt_build_pingreq())
                        last_ping = now

                    try:
                        chunk = sock.recv(65536)
                        if not chunk:
                            raise OSError("MQTT EOF")
                        buf.extend(chunk)
                        if len(buf) > 524288:
                            # Prevent unbounded buffer growth on bursty global FT8 streams
                            buf.clear()
                    except socket.timeout:
                        pass

                    while True:
                        pkt = mqtt_try_decode_packet(buf)
                        if pkt is None:
                            break
                        ptype, topic, pl, consumed = pkt
                        del buf[:consumed]
                        if ptype == 3 and pl:
                            is_priority = (call.upper() in topic.upper()) or (grid4 in topic.upper()) or ("/FT8/" not in topic)
                            t_now = time.monotonic()
                            # Keep 100% of W1AW, FN31, FT4, JS8, CW, WSPR; smoothly pace global FT8 flood (~35 spots/sec)
                            if is_priority or (t_now - last_global_emit >= 0.028):
                                sp = parse_mqtt_spot_json(pl, call, grid4)
                                if sp is not None:
                                    if not sp.is_home_call and not sp.is_home_grid and sp.mode == "FT8":
                                        last_global_emit = t_now
                                    batch.append(sp)

                    now = time.monotonic()
                    if batch and (now - last_flush >= 0.25 or len(batch) >= 24):
                        self._on_spot_batch(batch)
                        batch = []
                        last_flush = now

            except Exception:
                self._on_state("OFFLINE / STANDBY")
            finally:
                if sock is not None:
                    try:
                        sock.close()
                    except Exception:
                        pass

            if not self._stop.is_set() and not self._reconnect.is_set():
                self._stop.wait(timeout=backoff)
                backoff = min(30.0, backoff * 1.6)


