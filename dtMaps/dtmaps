# Maidenhead Locator, Geodesic & Solar Greyline Astronomical Math
# ---------------------------------------------------------------------------
GRID_RE = re.compile(r"^[A-Ra-r]{2}[0-9]{2}([A-Xa-x]{2}([0-9]{2})?)?$")


def is_valid_maidenhead(grid: str) -> bool:
    return bool(grid and GRID_RE.match(grid.strip()))


def maidenhead_to_latlon(grid: str) -> tuple[float, float] | None:
    """Convert 4, 6, or 8-char Maidenhead locator to center (lat, lon)."""
    g = (grid or "").strip()
    if len(g) >= 8 and GRID_RE.match(g[:8]):
        g = g[:8]
    elif len(g) >= 6 and GRID_RE.match(g[:6]):
        g = g[:6]
    elif len(g) >= 4 and GRID_RE.match(g[:4]):
        g = g[:4]
    else:
        return None

    u = g.upper()
    lon = (ord(u[0]) - ord("A")) * 20.0 - 180.0
    lat = (ord(u[1]) - ord("A")) * 10.0 - 90.0
    lon += (ord(u[2]) - ord("0")) * 2.0
    lat += (ord(u[3]) - ord("0")) * 1.0

    if len(u) == 4:
        return (lat + 0.5, lon + 1.0)

    lon += (ord(u[4]) - ord("A")) * (2.0 / 24.0)
    lat += (ord(u[5]) - ord("A")) * (1.0 / 24.0)
    if len(u) == 6:
        return (lat + 0.5 / 24.0, lon + 1.0 / 24.0)

    lon += (ord(u[6]) - ord("0")) * (2.0 / 240.0)
    lat += (ord(u[7]) - ord("0")) * (1.0 / 240.0)
    return (lat + 0.5 / 240.0, lon + 1.0 / 240.0)


def latlon_to_maidenhead(lat: float, lon: float, chars: int = 6) -> str:
    """Convert (lat, lon) to 2, 4, 6, or 8-char Maidenhead locator."""
    lon_w = ((lon + 180.0) % 360.0)
    lat_c = max(-89.9999, min(89.9999, lat)) + 90.0

    f_lon = int(lon_w // 20.0)
    f_lat = int(lat_c // 10.0)
    out = chr(ord("A") + f_lon) + chr(ord("A") + f_lat)
    if chars <= 2:
        return out

    r_lon = lon_w - f_lon * 20.0
    r_lat = lat_c - f_lat * 10.0
    s_lon = int(r_lon // 2.0)
    s_lat = int(r_lat // 1.0)
    out += f"{s_lon}{s_lat}"
    if chars <= 4:
        return out

    r_lon -= s_lon * 2.0
    r_lat -= s_lat * 1.0
    sub_lon = min(23, int(r_lon * 12.0))
    sub_lat = min(23, int(r_lat * 24.0))
    out += chr(ord("a") + sub_lon) + chr(ord("a") + sub_lat)
    if chars <= 6:
        return out

    r_lon -= sub_lon / 12.0
    r_lat -= sub_lat / 24.0
    ext_lon = min(9, int(r_lon * 120.0))
    ext_lat = min(9, int(r_lat * 240.0))
    return out + f"{ext_lon}{ext_lat}"


def grid4_bounds(g4: str) -> tuple[float, float, float, float] | None:
    """Return (lat0, lon0, lat1, lon1) bounds of a 4-char Maidenhead grid square."""
    if not g4 or len(g4) < 4:
        return None
    u = g4[:4].upper()
    if not ("A" <= u[0] <= "R" and "A" <= u[1] <= "R" and u[2].isdigit() and u[3].isdigit()):
        return None
    lon0 = (ord(u[0]) - ord("A")) * 20.0 - 180.0 + int(u[2]) * 2.0
    lat0 = (ord(u[1]) - ord("A")) * 10.0 - 90.0 + int(u[3]) * 1.0
    return (lat0, lon0, lat0 + 1.0, lon0 + 2.0)


def geodesic_distance_bearing(
    lat1: float, lon1: float, lat2: float, lon2: float
) -> tuple[float, float, float]:
    """Return (distance_km, short_path_deg, long_path_deg) from (lat1, lon1) to (lat2, lon2)."""
    p1 = math.radians(lat1)
    p2 = math.radians(lat2)
    dp = math.radians(lat2 - lat1)
    dl = math.radians(((lon2 - lon1 + 180.0) % 360.0) - 180.0)

    a = math.sin(dp * 0.5) ** 2 + math.cos(p1) * math.cos(p2) * (math.sin(dl * 0.5) ** 2)
    c = 2.0 * math.atan2(math.sqrt(min(1.0, a)), math.sqrt(max(0.0, 1.0 - a)))
    dist_km = EARTH_RADIUS_KM * c

    if c < 1e-9:
        return (0.0, 0.0, 180.0)

    y = math.sin(dl) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
    sp_deg = (math.degrees(math.atan2(y, x)) + 360.0) % 360.0
    lp_deg = (sp_deg + 180.0) % 360.0
    return (dist_km, sp_deg, lp_deg)


def great_circle_unwrapped(
    lat1: float, lon1: float, lat2: float, lon2: float, steps: int = 44
) -> list[tuple[float, float]]:
    """
    Compute spherical-linear-interpolated great-circle points (lat, lon_unwrapped)
    with continuous unwrapped longitudes so Pacific/antimeridian paths never streak!
    """
    p1, l1 = math.radians(lat1), math.radians(lon1)
    p2, l2 = math.radians(lat2), math.radians(lon2)

    x1, y1, z1 = math.cos(p1) * math.cos(l1), math.cos(p1) * math.sin(l1), math.sin(p1)
    x2, y2, z2 = math.cos(p2) * math.cos(l2), math.cos(p2) * math.sin(l2), math.sin(p2)

    dot = max(-1.0, min(1.0, x1 * x2 + y1 * y2 + z1 * z2))
    omega = math.acos(dot)
    if omega < 1e-6:
        return [(lat1, lon1), (lat2, lon2)]

    sin_om = math.sin(omega)
    pts: list[tuple[float, float]] = []
    prev_lon = lon1
    for i in range(steps + 1):
        t = i / steps
        if sin_om < 1e-5:
            # Nearly antipodal fallback via polar arc
            a = 1.0 - t
            b = t
            x = a * x1 + b * x2
            y = a * y1 + b * y2
            z = a * z1 + b * z2 + 0.25 * math.sin(t * math.pi)
            nm = math.sqrt(x * x + y * y + z * z) or 1.0
            x, y, z = x / nm, y / nm, z / nm
        else:
            a = math.sin((1.0 - t) * omega) / sin_om
            b = math.sin(t * omega) / sin_om
            x = a * x1 + b * x2
            y = a * y1 + b * y2
            z = a * z1 + b * z2

        lat = max(-84.8, min(84.8, math.degrees(math.asin(max(-1.0, min(1.0, z))))))
        lon = math.degrees(math.atan2(y, x))
        while lon - prev_lon > 180.0:
            lon -= 360.0
        while lon - prev_lon < -180.0:
            lon += 360.0
        prev_lon = lon
        pts.append((lat, lon))
    return pts


def freq_to_band(freq_hz_or_mhz: float, band_hint: str = "") -> str:
    if band_hint:
        bh = band_hint.strip()
        if bh in BAND_COLOR_MAP:
            return bh
    mhz = freq_hz_or_mhz / 1_000_000.0 if freq_hz_or_mhz > 2000.0 else freq_hz_or_mhz
    for name, lo, hi, _, _ in BAND_DEFS:
        if (lo - 0.08) <= mhz <= (hi + 0.08):
            return name
    if 0.13 <= mhz <= 0.14:
        return "2200m"
    if 0.47 <= mhz <= 0.48:
        return "630m"
    if 420.0 <= mhz <= 450.0:
        return "70cm"
    return "20m" if mhz <= 0 else f"{mhz:.1f}M"


def compute_solar_subsolar(utc_dt: datetime.datetime | None = None) -> tuple[float, float]:
    """Return (subsolar_lat_deg, subsolar_lon_deg) for given UTC datetime."""
    if utc_dt is None:
        utc_dt = datetime.datetime.now(datetime.timezone.utc)
    # Days since J2000.0 (2000-01-01 12:00:00 UTC)
    j2000 = datetime.datetime(2000, 1, 1, 12, 0, 0, tzinfo=datetime.timezone.utc)
    d = (utc_dt - j2000).total_seconds() / 86400.0

    # Mean longitude & mean anomaly of the Sun
    L = (280.460 + 0.9856474 * d) % 360.0
    g = math.radians((357.528 + 0.9856003 * d) % 360.0)
    lam = math.radians(L + 1.915 * math.sin(g) + 0.020 * math.sin(2.0 * g))
    eps = math.radians(23.439 - 0.0000004 * d)

    decl = math.degrees(math.asin(math.sin(eps) * math.sin(lam)))
    ra = math.degrees(math.atan2(math.cos(eps) * math.sin(lam), math.cos(lam))) % 360.0
    eot_deg = ((L - ra + 180.0) % 360.0) - 180.0

    utc_hours = utc_dt.hour + utc_dt.minute / 60.0 + utc_dt.second / 3600.0
    sub_lon = ((12.0 - utc_hours) * 15.0 - eot_deg + 180.0) % 360.0 - 180.0
    return (decl, sub_lon)


def compute_terminator_curve(
    sub_lat: float, sub_lon: float, step_deg: int = 3
) -> list[tuple[float, float]]:
    """Return list of (lat, lon) points along the solar day/night terminator from -180..+180."""
    dec_r = math.radians(sub_lat)
    tan_dec = math.tan(dec_r)
    if abs(tan_dec) < 1e-5:
        tan_dec = 1e-5 if tan_dec >= 0 else -1e-5

    pts: list[tuple[float, float]] = []
    for lon_i in range(-180, 181, step_deg):
        ha = math.radians(lon_i - sub_lon)
        lat = math.degrees(math.atan(-math.cos(ha) / tan_dec))
        pts.append((max(-85.0, min(85.0, lat)), float(lon_i)))
    return pts


