# Engine C: Local ADIF (.adi) Parser & WSJT-X UDP (127.0.0.1:2237) Listener
# ---------------------------------------------------------------------------
ADIF_FIELD_RE = re.compile(r"<([A-Za-z0-9_]+):(\d+)(?::[^>]+)?>(.*?)(?=<[A-Za-z0-9_]+|\Z)", re.DOTALL)


def parse_adif_worked_grids(adif_text: str) -> tuple[set[str], set[str], int]:
    """
    Parse ADIF log content and return (worked_grids4, confirmed_grids4, qso_count).
    """
    worked: set[str] = set()
    confirmed: set[str] = set()
    qsos = 0
    # Split past header if <EOH> present
    idx = adif_text.upper().find("<EOH>")
    body = adif_text[idx + 5:] if idx >= 0 else adif_text

    for rec in re.split(r"<EOR>", body, flags=re.IGNORECASE):
        if "<" not in rec:
            continue
        fields: dict[str, str] = {}
        pos = 0
        while True:
            m = re.search(r"<([A-Za-z0-9_]+):(\d+)(?::[^>]*)?>", rec[pos:])
            if not m:
                break
            fname = m.group(1).upper()
            flen = int(m.group(2))
            vstart = pos + m.end()
            val = rec[vstart:vstart + flen].strip()
            fields[fname] = val
            pos = vstart + flen

        if not fields:
            continue
        if "CALL" in fields or "GRIDSQUARE" in fields:
            qsos += 1
        gs = fields.get("GRIDSQUARE", "").strip()
        if len(gs) >= 4 and is_valid_maidenhead(gs[:4]):
            g4 = gs[:4].upper()
            worked.add(g4)
            is_cfm = any(
                fields.get(k, "").upper().startswith("Y")
                for k in ("QSL_RCVD", "LOTW_QSL_RCVD", "EQSL_QSL_RCVD")
            )
            if is_cfm:
                confirmed.add(g4)
    return (worked, confirmed, qsos)


class WSJTXUdpListener:
    """Non-blocking WSJT-X UDP listener on 127.0.0.1:2237 for live local rig decodes."""

    MAGIC = 0xADBCCBDA

    def __init__(self, get_qth_fn, on_spot_fn):
        self._get_qth = get_qth_fn
        self._on_spot = on_spot_fn
        self._stop = threading.Event()
        self.dial_freq_hz = 14_074_000.0
        self.wsjtx_mode = "FT8"
        self._thread = threading.Thread(target=self._run, name="dtmaps-wsjtx", daemon=True)

    def start(self) -> None:
        self._thread.start()

    def stop(self) -> None:
        self._stop.set()

    @staticmethod
    def _read_utf8(data: bytes, off: int) -> tuple[str, int]:
        if off + 4 > len(data):
            return ("", len(data))
        (slen,) = struct.unpack_from("!I", data, off)
        off += 4
        if slen == 0xFFFFFFFF or slen == 0:
            return ("", off)
        s = data[off:off + slen].decode("utf-8", errors="replace")
        return (s, off + slen)

    def _run(self) -> None:
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            sock.bind(("127.0.0.1", 2237))
            sock.settimeout(1.0)
        except Exception:
            try:
                sock.close()
            except Exception:
                pass
            return

        while not self._stop.is_set():
            try:
                pkt, _ = sock.recvfrom(4096)
            except socket.timeout:
                continue
            except Exception:
                break

            if len(pkt) < 12:
                continue
            magic, _schema, mtype = struct.unpack_from("!III", pkt, 0)
            if magic != self.MAGIC:
                continue
            off = 12
            _client_id, off = self._read_utf8(pkt, off)

            if mtype == 1 and off + 8 <= len(pkt):
                # Status packet: uint64 dial frequency + utf8 mode
                (dfreq,) = struct.unpack_from("!Q", pkt, off)
                off += 8
                md, _ = self._read_utf8(pkt, off)
                if dfreq > 0:
                    self.dial_freq_hz = float(dfreq)
                if md:
                    self.wsjtx_mode = md
            elif mtype == 2 and off + 21 <= len(pkt):
                # Decode packet: bool new, uint32 ms, int32 snr, float64 dt, uint32 df, utf8 mode, utf8 message
                _is_new = pkt[off]
                off += 1
                _ms, snr, _dt, df = struct.unpack_from("!IidI", pkt, off)
                off += 20
                _md_ch, off = self._read_utf8(pkt, off)
                msg, off = self._read_utf8(pkt, off)
                self._parse_wsjtx_message(msg.strip(), snr, float(df))

        try:
            sock.close()
        except Exception:
            pass

    def _parse_wsjtx_message(self, msg: str, snr: int, df: float) -> None:
        # e.g. "CQ W7ABC CN87" or "CQ DX JA1XYZ PM95" or "W1AW K1ABC FN42"
        parts = msg.split()
        if len(parts) < 3:
            return
        grid_tok = parts[-1]
        if len(grid_tok) != 4 or grid_tok in ("RR73", "RRR", "73") or not is_valid_maidenhead(grid_tok):
            return
        tx_call = parts[-2]
        if not re.match(r"^[A-Z0-9/]{3,12}$", tx_call):
            return
        p_tx = maidenhead_to_latlon(grid_tok)
        home_call, home_grid = self._get_qth()
        p_rx = maidenhead_to_latlon(home_grid)
        if not p_tx or not p_rx:
            return
        f_hz = self.dial_freq_hz + df
        sp = Spot(
            tx_call, grid_tok, p_tx[0], p_tx[1],
            home_call, home_grid, p_rx[0], p_rx[1],
            f_hz, freq_to_band(f_hz), self.wsjtx_mode, snr, int(time.time()),
            "WSJTX", home_call, home_grid[:4],
        )
        self._on_spot([sp])


