        bx = hx + 9.0
        by = hy - 8.0
        cr.set_source_rgba(0.14, 0.11, 0.03, 0.90)
        cr.rectangle(bx, by, ext.width + 10.0, 16.0)
        cr.fill_preserve()
        cr.set_source_rgb(1.0, 0.82, 0.24)
        cr.set_line_width(1.2)
        cr.stroke()

        cr.set_source_rgb(1.0, 0.92, 0.56)
        cr.move_to(bx + 5.0, by + 12.0)
        cr.show_text(tag)
        cr.restore()

    def _draw_ruler_overlay(
        self, cr: cairo.Context, w: int, h: int, cwx: float, cwy: float, world_w: float
    ) -> None:
        a_lat, a_lon = self.ruler_anchor if self.ruler_anchor else (self.home_lat, self.home_lon)
        b_lat, b_lon = self.ruler_target if self.ruler_target else (self.cursor_lat, self.cursor_lon)
        pts = great_circle_unwrapped(a_lat, a_lon, b_lat, b_lon, steps=40)
        x0 = cwx - w * 0.5
        y0 = cwy - h * 0.5
        mid_lat, mid_lon = pts[len(pts) // 2]
        mwx, _ = latlon_to_world_px(mid_lat, mid_lon, self.zoom)
        shift_k = round((cwx - mwx) / world_w)
        x_shift = shift_k * world_w - x0

        s_pts: list[tuple[float, float]] = []
        for lat, lon_u in pts:
            wx = ((lon_u + 180.0) / 360.0) * world_w
            lat_c = max(-85.05112878, min(85.05112878, lat))
            sin_l = math.sin(math.radians(lat_c))
            wy = (0.5 - math.log((1.0 + sin_l) / (1.0 - sin_l)) / (4.0 * math.pi)) * world_w
            s_pts.append((wx + x_shift, wy - y0))

        cr.save()
        cr.set_dash([7.0, 5.0])
        self._stroke_polyline(cr, s_pts, (0.38, 1.0, 0.90, 0.95), 2.2)
        cr.set_dash([])

        dist_km, sp_deg, lp_deg = geodesic_distance_bearing(a_lat, a_lon, b_lat, b_lon)
        g_a = latlon_to_maidenhead(a_lat, a_lon, 6)
        g_b = latlon_to_maidenhead(b_lat, b_lon, 6)
        ex, ey = s_pts[-1]
        label = f"RULER {g_a} -> {g_b}: {dist_km:.1f} km ({dist_km * KM_TO_MI:.1f} mi) | SP {sp_deg:.1f}° LP {lp_deg:.1f}°"

        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(10.0)
        ext = cr.text_extents(label)
        px = min(w - ext.width - 18, max(8.0, ex + 10.0))
        py = min(h - 28.0, max(8.0, ey + 10.0))

        cr.set_source_rgba(0.04, 0.16, 0.16, 0.92)
        cr.rectangle(px, py, ext.width + 12.0, 18.0)
        cr.fill_preserve()
        cr.set_source_rgb(0.38, 1.0, 0.90)
        cr.set_line_width(1.2)
        cr.stroke()
        cr.move_to(px + 6.0, py + 13.0)
        cr.show_text(label)
        cr.restore()

