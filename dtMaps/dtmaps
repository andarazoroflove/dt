def latlon_to_world_px(lat: float, lon: float, zoom: float) -> tuple[float, float]:
    scale = TILE_SIZE * (2.0 ** zoom)
    x = ((lon + 180.0) / 360.0) * scale
    lat_c = max(-85.05112878, min(85.05112878, lat))
    sin_lat = math.sin(math.radians(lat_c))
    y = (0.5 - math.log((1.0 + sin_lat) / (1.0 - sin_lat)) / (4.0 * math.pi)) * scale
    return (x, y)


def world_px_to_latlon(wx: float, wy: float, zoom: float) -> tuple[float, float]:
    scale = TILE_SIZE * (2.0 ** zoom)
    lon = ((wx / scale) * 360.0 - 180.0 + 180.0) % 360.0 - 180.0
    n = math.pi - 2.0 * math.pi * max(0.0, min(1.0, wy / scale))
    lat = math.degrees(math.atan(math.sinh(n)))
    return (lat, lon)


