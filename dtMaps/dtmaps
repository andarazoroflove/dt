# Multi-Mode Tile Color Transform & SQLite Persistent Cache
# ---------------------------------------------------------------------------
def apply_map_mode_to_rgb(rgb_arr: np.ndarray, mode: str) -> np.ndarray:
    """
    Transform an HxWx3 uint8 RGB tile array into one of the 5 tactical visual modes:
      dark, topo, day, amber, red
    """
    if mode in ("day", "topo"):
        return rgb_arr

    f = rgb_arr.astype(np.float32)
    r, g, b = f[:, :, 0], f[:, :, 1], f[:, :, 2]
    lum = 0.299 * r + 0.587 * g + 0.114 * b

    if mode == "dark":
        # Detect OSM blue water bodies (oceans, rivers, lakes) vs land/roads/labels
        is_water = (b > r + 14.0) & (b > g - 6.0) & (b > 110.0)
        # Invert bright OSM land into charcoal #1b2432 while preserving crisp road/border contrast
        inv = 255.0 - lum
        nr = np.clip(20.0 + inv * 0.26, 14.0, 92.0)
        ng = np.clip(28.0 + inv * 0.34, 20.0, 118.0)
        nb = np.clip(40.0 + inv * 0.46, 28.0, 152.0)
        # Subtle green park tint preservation
        is_park = (g > r + 12.0) & (g > b + 8.0) & ~is_water
        ng = np.where(is_park, ng + 10.0, ng)
        # Crisp midnight navy ocean #0b1524
        nr = np.where(is_water, 11.0 + (255.0 - b) * 0.04, nr)
        ng = np.where(is_water, 21.0 + (255.0 - b) * 0.06, ng)
        nb = np.where(is_water, 36.0 + (255.0 - b) * 0.10, nb)
        return np.stack([nr, ng, nb], axis=-1).astype(np.uint8)

    if mode == "amber":
        is_water = (b > r + 14.0) & (b > g - 6.0) & (b > 110.0)
        v = np.where(is_water, 0.10, np.clip((260.0 - lum) / 220.0, 0.16, 1.0))
        nr = np.clip(14.0 + v * 238.0, 0.0, 255.0)
        ng = np.clip(8.0 + (v ** 1.18) * 166.0, 0.0, 255.0)
        nb = np.clip(2.0 + (v ** 2.2) * 36.0, 0.0, 255.0)
        return np.stack([nr, ng, nb], axis=-1).astype(np.uint8)

    if mode == "red":
        is_water = (b > r + 14.0) & (b > g - 6.0) & (b > 110.0)
        v = np.where(is_water, 0.08, np.clip((260.0 - lum) / 220.0, 0.14, 1.0))
        nr = np.clip(12.0 + v * 224.0, 0.0, 255.0)
        ng = np.clip(2.0 + (v ** 2.4) * 34.0, 0.0, 255.0)
        nb = np.clip(2.0 + (v ** 2.6) * 28.0, 0.0, 255.0)
        return np.stack([nr, ng, nb], axis=-1).astype(np.uint8)

    return rgb_arr


def rgb_to_cairo_surface(rgb_arr: np.ndarray) -> cairo.ImageSurface:
    h, w, _ = rgb_arr.shape
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
    bgra = np.empty((h, w, 4), dtype=np.uint8)
    bgra[:, :, 0] = rgb_arr[:, :, 2]
    bgra[:, :, 1] = rgb_arr[:, :, 1]
    bgra[:, :, 2] = rgb_arr[:, :, 0]
    bgra[:, :, 3] = 255
    buf = surf.get_data()
    raw = bgra.tobytes()
    buf[:len(raw)] = raw
    surf.mark_dirty()
    return surf


class TileCacheEngine:
    """Persistent SQLite Slippy-Tile Cache + Polite Multi-Threaded HTTP Downloader."""

    TILE_URLS = {
        "osm": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        "topo": "https://a.tile.opentopomap.org/{z}/{x}/{y}.png",
    }

    def __init__(self, db_path: Path, on_tile_ready=None, max_workers: int = 3):
        self.db_path = db_path
        self.db_path.parent.mkdir(parents=True, exist_ok=True)
        self.on_tile_ready = on_tile_ready
        self._db_lock = threading.Lock()
        self._mem_lock = threading.Lock()
        self._raw_cache: collections.OrderedDict[tuple[str, int, int, int], np.ndarray] = collections.OrderedDict()
        self._surf_cache: collections.OrderedDict[tuple[str, int, int, int], cairo.ImageSurface] = collections.OrderedDict()
        self._inflight: set[tuple[str, int, int, int]] = set()
        self._failed_until: dict[tuple[str, int, int, int], float] = {}
        self._stack: list[tuple[str, int, int, int]] = []
        self._cond = threading.Condition()
        self._stop = False
        self.online_ok = False
        self.tiles_cached_count = 0

        self._conn = sqlite3.connect(str(self.db_path), check_same_thread=False)
        with self._db_lock:
            self._conn.execute(
                "CREATE TABLE IF NOT EXISTS tiles ("
                "source TEXT, z INTEGER, x INTEGER, y INTEGER, png BLOB, ts INTEGER, "
                "PRIMARY KEY (source, z, x, y))"
            )
            self._conn.commit()
            cur = self._conn.execute("SELECT COUNT(*) FROM tiles")
            row = cur.fetchone()
            self.tiles_cached_count = int(row[0]) if row else 0

        self._workers: list[threading.Thread] = []
        for i in range(max_workers):
            t = threading.Thread(target=self._worker_loop, name=f"dtmaps-tile-{i}", daemon=True)
            t.start()
            self._workers.append(t)

    def shutdown(self) -> None:
        with self._cond:
            self._stop = True
            self._cond.notify_all()

    @staticmethod
    def source_for_mode(mode: str) -> str:
        return "topo" if mode == "topo" else "osm"

    def get_surface(self, mode: str, z: int, x: int, y: int) -> tuple[cairo.ImageSurface | None, int]:
        """
        Return (surface, overzoom_shift). If exact tile is ready, overzoom_shift=0.
        Otherwise queues download and attempts parent overzoom fallback (or returns None for vector base).
        """
        n = 1 << z
        if y < 0 or y >= n:
            return (None, 0)
        x = x % n
        sk = (mode, z, x, y)
        with self._mem_lock:
            surf = self._surf_cache.get(sk)
            if surf is not None:
                self._surf_cache.move_to_end(sk)
                return (surf, 0)

        src = self.source_for_mode(mode)
        rk = (src, z, x, y)
        rgb = self._get_or_load_raw(rk)
        if rgb is not None:
            styled = apply_map_mode_to_rgb(rgb, mode)
            surf = rgb_to_cairo_surface(styled)
            with self._mem_lock:
                self._surf_cache[sk] = surf
                while len(self._surf_cache) > 520:
                    self._surf_cache.popitem(last=False)
            return (surf, 0)

        # Queue async download
        self._enqueue(rk)

        # Check up to 2 parent zoom levels in memory/SQLite for smooth zoom transitions
        for dz in (1, 2):
            pz = z - dz
            if pz < MIN_ZOOM:
                break
            px, py = x >> dz, y >> dz
            psk = (mode, pz, px, py)
            with self._mem_lock:
                psurf = self._surf_cache.get(psk)
            if psurf is not None:
                return (psurf, dz)
        return (None, 0)

    def _get_or_load_raw(self, rk: tuple[str, int, int, int]) -> np.ndarray | None:
        with self._mem_lock:
            arr = self._raw_cache.get(rk)
            if arr is not None:
                self._raw_cache.move_to_end(rk)
                return arr

        src, z, x, y = rk
        blob = None
        try:
            with self._db_lock:
                cur = self._conn.execute(
                    "SELECT png FROM tiles WHERE source=? AND z=? AND x=? AND y=?",
                    (src, z, x, y),
                )
                row = cur.fetchone()
                if row:
                    blob = row[0]
        except Exception:
            blob = None

        if not blob:
            return None

        try:
            im = Image.open(io.BytesIO(blob)).convert("RGB")
            if im.size != (TILE_SIZE, TILE_SIZE):
                im = im.resize((TILE_SIZE, TILE_SIZE), Image.Resampling.BILINEAR)
            arr = np.array(im, dtype=np.uint8)
            with self._mem_lock:
                self._raw_cache[rk] = arr
                while len(self._raw_cache) > 360:
                    self._raw_cache.popitem(last=False)
            return arr
        except Exception:
            return None

    def _enqueue(self, rk: tuple[str, int, int, int]) -> None:
        now = time.monotonic()
        with self._cond:
            if rk in self._inflight:
                return
            until = self._failed_until.get(rk, 0.0)
            if now < until:
                return
            if rk in self._stack:
                self._stack.remove(rk)
            self._stack.append(rk)
            while len(self._stack) > 64:
                self._stack.pop(0)
            self._cond.notify()

    def _worker_loop(self) -> None:
        sess = requests.Session()
        sess.headers.update({"User-Agent": UA})
        while True:
            with self._cond:
                while not self._stop and not self._stack:
                    self._cond.wait(timeout=2.0)
                if self._stop:
                    return
                rk = self._stack.pop()
                self._inflight.add(rk)

            src, z, x, y = rk
            url = self.TILE_URLS[src].format(z=z, x=x, y=y)
            ok = False
            try:
                resp = sess.get(url, timeout=(3.5, 6.0))
                if resp.status_code == 200 and resp.content:
                    im = Image.open(io.BytesIO(resp.content)).convert("RGB")
                    if im.size != (TILE_SIZE, TILE_SIZE):
                        im = im.resize((TILE_SIZE, TILE_SIZE), Image.Resampling.BILINEAR)
                    arr = np.array(im, dtype=np.uint8)
                    with self._db_lock:
                        self._conn.execute(
                            "INSERT OR REPLACE INTO tiles (source, z, x, y, png, ts) VALUES (?, ?, ?, ?, ?, ?)",
                            (src, z, x, y, sqlite3.Binary(resp.content), int(time.time())),
                        )
                        self._conn.commit()
                        self.tiles_cached_count += 1
                    with self._mem_lock:
                        self._raw_cache[rk] = arr
                        while len(self._raw_cache) > 360:
                            self._raw_cache.popitem(last=False)
                    self.online_ok = True
                    ok = True
            except Exception:
                ok = False

            with self._cond:
                self._inflight.discard(rk)
                if not ok:
                    self._failed_until[rk] = time.monotonic() + 25.0

            if ok and self.on_tile_ready is not None:
                GLib.idle_add(self.on_tile_ready)


