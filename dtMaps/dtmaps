    # -----------------------------------------------------------------------
    # PSKReporter 24h Dedicated Query Engine (Engine A)
    # -----------------------------------------------------------------------
    def _psk_cache_path(self, call: str) -> Path:
        safe = re.sub(r"[^A-Z0-9_-]", "_", call.upper()) or "W1AW"
        return CACHE_DIR / f"psk_{safe}.xml"

    def _start_psk24h_poll(self, force_network: bool = False) -> None:
        call = self.home_call
        grid4 = self.home_grid[:4].upper()
        cpath = self._psk_cache_path(call)

        def worker():
            now = time.time()
            xml_text = ""
            used_cache = False

            if cpath.is_file():
                try:
                    age = now - cpath.stat().st_mtime
                    # Always respect PSKReporter's >=300s (5-minute) minimum query interval!
                    if age < 300.0:
                        xml_text = cpath.read_text(encoding="utf-8", errors="ignore")
                        used_cache = True
                except Exception:
                    pass

            if not used_cache:
                url = f"https://retrieve.pskreporter.info/query?callsign={call}&flowStartSeconds=-86400"
                try:
                    resp = requests.get(url, headers={"User-Agent": UA}, timeout=(4.5, 9.0))
                    if resp.status_code == 200 and (
                        "<receptionReport" in resp.text or "<pskReporter" in resp.text or "<?xml" in resp.text
                    ):
                        xml_text = resp.text
                        cpath.write_text(xml_text, encoding="utf-8")
                        self.psk24h_last_poll = time.time()
                except Exception:
                    # Fallback to stale cache if offline
                    if cpath.is_file():
                        try:
                            xml_text = cpath.read_text(encoding="utf-8", errors="ignore")
                            used_cache = True
                        except Exception:
                            pass

            spots = parse_pskreporter_xml(xml_text, call, grid4) if xml_text else []
            GLib.idle_add(self._on_psk24h_done, call, spots, bool(xml_text), used_cache)

        threading.Thread(target=worker, name="dtmaps-psk24h", daemon=True).start()

    def _on_psk24h_done(self, call: str, spots: list[Spot], got_xml: bool, used_cache: bool) -> bool:
        if call != self.home_call:
            return False
        with self._spots_lock:
            self.psk24h_spots = spots
        n = len(spots)
        if n > 0:
            self.psk24h_status = f"{call} (24h): {n} spots"
        elif got_xml:
            self.psk24h_status = f"{call}: 0 in 24h (Rig Standby)"
        else:
            self.psk24h_status = f"{call}: 0 in 24h (Rig Standby)"

        src_note = "cached <5m" if used_cache else ("live XML" if got_xml else "offline standby")
        self._set_status(f"PSKReporter 24h query for {call} [{src_note}]: {n} reception reports loaded.")
        self._roster_dirty = True
        self._queue_map_redraw()
        self.vfd_area.queue_draw()
        return False

    def _on_periodic_psk_check(self) -> bool:
        cpath = self._psk_cache_path(self.home_call)
        age = (time.time() - cpath.stat().st_mtime) if cpath.is_file() else 9999.0
        if age >= 305.0 and (time.time() - self.psk24h_last_poll) >= 305.0:
            self.psk24h_last_poll = time.time()
            self._start_psk24h_poll(force_network=True)
        return True

    # -----------------------------------------------------------------------
    # Live MQTT & WSJT-X Spot Ingestion
    # -----------------------------------------------------------------------
    def _on_mqtt_state_threadsafe(self, st: str) -> None:
        def apply():
            self.mqtt_state = st
            self.vfd_area.queue_draw()
            return False
        GLib.idle_add(apply)

    def _on_incoming_spots_threadsafe(self, batch: list[Spot]) -> None:
        with self._spots_lock:
            for sp in batch:
                if sp.key in self.live_spots:
                    del self.live_spots[sp.key]
                self.live_spots[sp.key] = sp
            # Ring-buffer cap of freshest 500 live spots (preserving home callsign/grid spots longer)
            while len(self.live_spots) > 500:
                oldest_k = next(iter(self.live_spots))
                self.live_spots.pop(oldest_k, None)
        self._roster_dirty = True
        GLib.idle_add(self._queue_map_redraw)

    # -----------------------------------------------------------------------
    # Filtered Spots Snapshot & Roster Sync
    # -----------------------------------------------------------------------
    def _get_filtered_spots(self) -> list[Spot]:
        with self._spots_lock:
            combined: dict[str, Spot] = {}
            for sp in self.psk24h_spots:
                combined[sp.key] = sp
            for k, sp in self.live_spots.items():
                combined[k] = sp
            all_spots = list(combined.values())

        mf = self.mode_filter
        out: list[Spot] = []
        for sp in all_spots:
            if sp.band in BAND_COLOR_MAP and sp.band not in self.enabled_bands:
                continue
            if mf == "FT8 ONLY" and sp.mode != "FT8":
                continue
            elif mf in ("FT4", "JS8", "CW", "WSPR") and sp.mode != mf:
                continue
            elif mf == "HOME CALL ONLY" and not sp.is_home_call:
                continue
            elif mf == "HOME GRID ONLY" and not (sp.is_home_grid or sp.is_home_call):
                continue
            out.append(sp)

        # Sort: home callsign spots first/top in roster, then newest timestamp
        out.sort(key=lambda s: (1 if s.is_home_call else 0, s.ts), reverse=True)
        return out

    def _sync_roster_and_band_counts(self) -> None:
        with self._spots_lock:
            band_counts: dict[str, int] = {b: 0 for b in BAND_ORDER}
            for sp in self.psk24h_spots:
                if sp.band in band_counts:
                    band_counts[sp.band] += 1
            for sp in self.live_spots.values():
                if sp.band in band_counts:
                    band_counts[sp.band] += 1

        for bname, _, _, _, bhex in BAND_DEFS:
            cnt = band_counts.get(bname, 0)
            lbl = self.band_labels[bname]
            if cnt > 0:
                lbl.set_markup(f'<span foreground="{bhex}">●</span> {bname}({cnt})')
            else:
                lbl.set_markup(f'<span foreground="{bhex}">●</span> {bname}')

        spots = self._get_filtered_spots()
        self.lbl_roster_title.set_text(f"LIVE SPOT ROSTER ({len(spots)})")

        now_ts = int(time.time())
        self.roster_store.clear()
        for idx, sp in enumerate(spots[:220]):
            age_s = max(0, now_ts - sp.ts)
            if age_s < 60:
                age_str = f"{age_s}s"
            elif age_s < 3600:
                age_str = f"{age_s // 60}m"
            else:
                age_str = f"{age_s // 3600}h"
            snr_str = f"{sp.snr:+d}" if sp.snr is not None else "--"
            km_str = f"{int(round(sp.dist_km))}"

            if sp.is_home_call:
                bg = "#2b240b"
                fg = "#ffe47a"
            elif sp.is_home_grid:
                bg = "#102826"
                fg = "#68fce2"
            else:
                # Vintage greenbar alternating rows
                bg = "#0d171c" if (idx % 2 == 0) else "#132128"
                fg = "#d6f5ec"

            self.roster_store.append([
                sp.key, age_str, sp.band, sp.mode,
                sp.tx_call, sp.tx_grid[:6], sp.rx_call, sp.rx_grid[:6],
                snr_str, km_str, bg, fg,
            ])

