    def _latlon_to_screen(self, lat: float, lon: float, w: int, h: int, cwx: float, cwy: float) -> tuple[float, float]:
        wx, wy = latlon_to_world_px(lat, lon, self.zoom)
        world_w = TILE_SIZE * (1 << self.zoom)
        dx = wx - cwx
        # Wrap horizontally to closest copy relative to viewport center
        dx = ((dx + world_w * 0.5) % world_w) - world_w * 0.5
        return (w * 0.5 + dx, h * 0.5 + (wy - cwy))

    def _screen_to_latlon(self, sx: float, sy: float, w: int, h: int) -> tuple[float, float]:
        cwx, cwy = latlon_to_world_px(self.center_lat, self.center_lon, self.zoom)
        return world_px_to_latlon(cwx + (sx - w * 0.5), cwy + (sy - h * 0.5), self.zoom)

    def _on_draw_map(self, widget: Gtk.Widget, cr: cairo.Context) -> bool:
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        if w <= 4 or h <= 4:
            return True

        pal = self._map_palette()
        cwx, cwy = latlon_to_world_px(self.center_lat, self.center_lon, self.zoom)
        world_w = TILE_SIZE * (1 << self.zoom)
        ntiles = 1 << self.zoom

        # 1. Ocean background
        cr.set_source_rgb(*pal["ocean"])
        cr.rectangle(0, 0, w, h)
        cr.fill()

        # 2. Render Built-in Vector World Geography Base First (guarantees instant crisp land/ocean even offline!)
        self._draw_vector_geography(cr, w, h, cwx, cwy, world_w, pal)

        # 3. Render Cached / Downloaded Slippy Tiles on top where available
        x0_world = cwx - w * 0.5
        y0_world = cwy - h * 0.5
        tx_start = int(math.floor(x0_world / TILE_SIZE))
        tx_end = int(math.floor((x0_world + w) / TILE_SIZE))
        ty_start = max(0, int(math.floor(y0_world / TILE_SIZE)))
        ty_end = min(ntiles - 1, int(math.floor((y0_world + h) / TILE_SIZE)))

        for ty in range(ty_start, ty_end + 1):
            sy = round(ty * TILE_SIZE - y0_world)
            for tx in range(tx_start, tx_end + 1):
                sx = round(tx * TILE_SIZE - x0_world)
                surf, dz = self.tile_engine.get_surface(self.map_mode, self.zoom, tx % ntiles, ty)
                if surf is not None:
                    if dz == 0:
                        cr.set_source_surface(surf, sx, sy)
                        cr.rectangle(sx, sy, TILE_SIZE, TILE_SIZE)
                        cr.fill()
                    else:
                        # Smooth parent-tile overzoom while sharp child tile downloads
                        scale_f = 1 << dz
                        sub_x = (tx % scale_f) * (TILE_SIZE // scale_f)
                        sub_y = (ty % scale_f) * (TILE_SIZE // scale_f)
                        cr.save()
                        cr.rectangle(sx, sy, TILE_SIZE, TILE_SIZE)
                        cr.clip()
                        cr.translate(sx, sy)
                        cr.scale(scale_f, scale_f)
                        cr.set_source_surface(surf, -sub_x, -sub_y)
                        cr.paint()
                        cr.restore()

        # 4. Solar Greyline Day/Night Terminator Overlay
        if self.show_greyline:
            self._draw_solar_greyline(cr, w, h, cwx, cwy, world_w)

        # 5. Adaptive Maidenhead Grid Overlay (2-char / 4-char / 6-char)
        if self.show_grid:
            self._draw_maidenhead_grid(cr, w, h, cwx, cwy, world_w, pal)

        # 6. Worked/Confirmed ADIF Squares + Live Active PSKReporter 4-char Grid Squares
        spots = self._get_filtered_spots()
        if self.show_squares:
            self._draw_active_and_worked_squares(cr, w, h, cwx, cwy, world_w, spots)

        # 7. Great-Circle Geodesic Propagation Arcs + Station Beacons + W1AW SNR Pills
        if self.show_arcs:
            self._draw_propagation_arcs(cr, w, h, cwx, cwy, world_w, spots)

        # 8. Home Station Marker (W1AW FN31pr)
        self._draw_home_qth_marker(cr, w, h, cwx, cwy)

        # 9. Interactive Range & Bearing Geodesic Ruler
        if self.ruler_active:
            self._draw_ruler_overlay(cr, w, h, cwx, cwy, world_w)

        # 10. Subtle Corner HUD Attribution & Scale Badge
        self._draw_map_hud(cr, w, h)
        return True

    def _draw_vector_geography(
        self,
        cr: cairo.Context,
        w: int,
        h: int,
        cwx: float,
        cwy: float,
        world_w: float,
        pal: dict[str, tuple[float, float, float]],
    ) -> None:
        x0 = cwx - w * 0.5
        y0 = cwy - h * 0.5
        k_min = int(math.floor(x0 / world_w))
        k_max = int(math.floor((x0 + w) / world_w))

        cr.set_line_width(1.0)
        for k in range(k_min, k_max + 1):
            x_off = k * world_w - x0
            for is_hole, pts in WORLD_POLYGONS:
                # Fast bounding check in longitude
                first = True
                for lon, lat in pts:
                    px, py = latlon_to_world_px(lat, lon, self.zoom)
                    sx = px - k * 0.0 + x_off
                    sy = py - y0
                    if first:
                        cr.move_to(sx, sy)
                        first = False
                    else:
                        cr.line_to(sx, sy)
                cr.close_path()
                if is_hole:
                    cr.set_source_rgb(*pal["ocean"])
                else:
                    cr.set_source_rgb(*pal["land"])
                cr.fill_preserve()
                cr.set_source_rgb(*pal["coast"])
                cr.stroke()

            # US State & International Borders
            cr.set_source_rgba(pal["border"][0], pal["border"][1], pal["border"][2], 0.85)
            cr.set_line_width(1.0 if self.zoom < 5 else 1.3)
            for bline in BORDER_POLYLINES:
                first = True
                for lon, lat in bline:
                    px, py = latlon_to_world_px(lat, lon, self.zoom)
                    sx = px + x_off
                    sy = py - y0
                    if first:
                        cr.move_to(sx, sy)
                        first = False
                    else:
                        cr.line_to(sx, sy)
                cr.stroke()

    def _draw_solar_greyline(
        self, cr: cairo.Context, w: int, h: int, cwx: float, cwy: float, world_w: float
    ) -> None:
        sub_lat, sub_lon = compute_solar_subsolar()
        curve = compute_terminator_curve(sub_lat, sub_lon, step_deg=3)
        x0 = cwx - w * 0.5
        y0 = cwy - h * 0.5
        k_min = int(math.floor(x0 / world_w))
        k_max = int(math.floor((x0 + w) / world_w))

        # Night pole: if sub_lat >= 0 (northern summer), South Pole is in night (bottom of Mercator y=world_w)
        night_y_edge = (world_w - y0) if sub_lat >= 0.0 else (0.0 - y0)

        cr.save()
        for k in range(k_min, k_max + 1):
            x_off = k * world_w - x0
            screen_pts: list[tuple[float, float]] = []
            for lat, lon in curve:
                px, py = latlon_to_world_px(lat, lon, self.zoom)
                screen_pts.append((px + x_off, py - y0))

            # Shade Night Hemisphere
            cr.move_to(screen_pts[0][0], night_y_edge)
            for sx, sy in screen_pts:
                cr.line_to(sx, sy)
            cr.line_to(screen_pts[-1][0], night_y_edge)
            cr.close_path()
            cr.set_source_rgba(0.01, 0.03, 0.08, 0.34)
            cr.fill()

            # Glowing Greyline Twilight Propagation Band (~12px halo + crisp amber-cyan line)
            for sx_i, (sx, sy) in enumerate(screen_pts):
                if sx_i == 0:
                    cr.move_to(sx, sy)
                else:
                    cr.line_to(sx, sy)
            cr.set_source_rgba(1.0, 0.74, 0.24, 0.18)
            cr.set_line_width(11.0)
            cr.stroke_preserve()

            cr.set_source_rgba(1.0, 0.82, 0.36, 0.65)
            cr.set_line_width(1.4)
            cr.set_dash([6.0, 4.0])
            cr.stroke()
            cr.set_dash([])

        # Subsolar Sun Marker (☉)
        sun_x, sun_y = self._latlon_to_screen(sub_lat, sub_lon, w, h, cwx, cwy)
        if -20 <= sun_x <= w + 20 and -20 <= sun_y <= h + 20:
            cr.set_source_rgba(1.0, 0.86, 0.20, 0.32)
            cr.arc(sun_x, sun_y, 11.0, 0, 2 * math.pi)
            cr.fill()
            cr.set_source_rgb(1.0, 0.90, 0.28)
            cr.arc(sun_x, sun_y, 5.2, 0, 2 * math.pi)
            cr.fill()
            cr.set_source_rgb(0.25, 0.16, 0.0)
            cr.set_line_width(1.0)
            cr.arc(sun_x, sun_y, 5.2, 0, 2 * math.pi)
            cr.stroke()
        cr.restore()

    def _draw_maidenhead_grid(
        self,
        cr: cairo.Context,
        w: int,
        h: int,
        cwx: float,
        cwy: float,
        world_w: float,
        pal: dict[str, tuple[float, float, float]],
    ) -> None:
        # Adaptive grid resolution:
        # z <= 4: 2-char Fields (20° x 10°)
        # 5 <= z <= 9: 4-char Grid Squares (2° x 1°)
        # z >= 10: 6-char Subsquares (5' x 2.5' = 1/12° x 1/24°)
        if self.zoom <= 4:
            dlon, dlat, chars = 20.0, 10.0, 2
        elif self.zoom <= 9:
            dlon, dlat, chars = 2.0, 1.0, 4
        else:
            dlon, dlat, chars = 2.0 / 24.0, 1.0 / 24.0, 6

        top_lat, left_lon = self._screen_to_latlon(0, 0, w, h)
        bot_lat, _ = self._screen_to_latlon(0, h, w, h)
        lat_min = max(-84.0, math.floor(min(top_lat, bot_lat) / dlat) * dlat)
        lat_max = min(84.0, math.ceil(max(top_lat, bot_lat) / dlat) * dlat)

        x0 = cwx - w * 0.5
        y0 = cwy - h * 0.5
        gc = pal["grid"]

        cr.save()
        cr.set_source_rgba(gc[0], gc[1], gc[2], 0.34)
        cr.set_line_width(0.85)

        # Horizontal parallels
        lat = lat_min
        while lat <= lat_max + 1e-7:
            _, wy = latlon_to_world_px(lat, 0.0, self.zoom)
            sy = wy - y0
            if -2 <= sy <= h + 2:
                cr.move_to(0, sy)
                cr.line_to(w, sy)
            lat += dlat
        cr.stroke()

        # Vertical meridians across visible world X range
        px_per_lon = world_w / 360.0
        step_px = dlon * px_per_lon
        if step_px >= 14.0:
            first_i = int(math.floor(x0 / step_px))
            last_i = int(math.ceil((x0 + w) / step_px))
            for i in range(first_i, last_i + 1):
                sx = i * step_px - x0
                cr.move_to(sx, 0)
                cr.line_to(sx, h)
            cr.stroke()

            # Labels when cells are roomy enough
            if step_px >= 46.0:
                cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
                cr.set_font_size(9.5 if chars >= 4 else 10.5)
                cr.set_source_rgba(gc[0], gc[1], gc[2], 0.72)
                lat = lat_min
                while lat < lat_max - 1e-7:
                    _, wy_top = latlon_to_world_px(lat + dlat, 0.0, self.zoom)
                    _, wy_bot = latlon_to_world_px(lat, 0.0, self.zoom)
                    cell_h = wy_bot - wy_top
                    if cell_h >= 22.0:
                        sy_lbl = wy_top - y0 + 12.0
                        if 8 <= sy_lbl <= h - 4:
                            for i in range(first_i, last_i + 1):
                                sx_lbl = i * step_px - x0 + 4.0
                                if -30 <= sx_lbl <= w - 10:
                                    lon_c = ((i + 0.5) * dlon - 180.0 + 180.0) % 360.0 - 180.0
                                    gname = latlon_to_maidenhead(lat + dlat * 0.5, lon_c, chars=chars)
                                    cr.move_to(sx_lbl, sy_lbl)
                                    cr.show_text(gname)
                    lat += dlat
        cr.restore()

    def _draw_active_and_worked_squares(
        self,
        cr: cairo.Context,
        w: int,
        h: int,
        cwx: float,
        cwy: float,
        world_w: float,
        spots: list[Spot],
    ) -> None:
        if self.zoom < 3:
            # At z=2 still draw squares cleanly!
            pass

        def draw_g4_box(g4: str, fill_rgba: tuple[float, float, float, float], stroke_rgba: tuple[float, float, float, float], lw: float = 1.1):
            b = grid4_bounds(g4)
            if not b:
                return
            lat0, lon0, lat1, lon1 = b
            sx0, sy1 = self._latlon_to_screen(lat0, lon0, w, h, cwx, cwy)
            _, sy0 = self._latlon_to_screen(lat1, lon0, w, h, cwx, cwy)
            bw_px = (2.0 / 360.0) * world_w
            bh_px = abs(sy1 - sy0)
            if sx0 + bw_px < -10 or sx0 > w + 10 or sy0 + bh_px < -10 or sy0 > h + 10:
                return
            cr.set_source_rgba(*fill_rgba)
            cr.rectangle(sx0, sy0, max(2.0, bw_px), max(2.0, bh_px))
            cr.fill_preserve()
            cr.set_source_rgba(*stroke_rgba)
            cr.set_line_width(lw)
            cr.stroke()

        cr.save()
        # 1. Worked & Confirmed ADIF Squares
        for g4 in self.worked_grids:
            if g4 in self.confirmed_grids:
                draw_g4_box(g4, (0.16, 0.85, 0.44, 0.26), (0.28, 0.96, 0.56, 0.72), 1.2)
            else:
                draw_g4_box(g4, (0.24, 0.66, 0.96, 0.20), (0.36, 0.78, 1.0, 0.60), 1.0)

        # 2. Live Active Spot Grid Squares (colored by band or gold for W1AW!)
        grid_color: dict[str, tuple[tuple[float, float, float], bool]] = {}
        for sp in reversed(spots):
            col = (1.0, 0.82, 0.22) if sp.is_home_call else BAND_COLOR_MAP.get(sp.band, (0.24, 0.92, 0.84))
            for g in (sp.tx_grid, sp.rx_grid):
                if len(g) >= 4:
                    g4 = g[:4].upper()
                    prev = grid_color.get(g4)
                    if prev is None or sp.is_home_call:
                        grid_color[g4] = (col, sp.is_home_call)

        for g4, (col, is_hc) in grid_color.items():
            alpha_f = 0.34 if is_hc else 0.22
            alpha_s = 0.92 if is_hc else 0.68
            draw_g4_box(
                g4,
                (col[0], col[1], col[2], alpha_f),
                (col[0], col[1], col[2], alpha_s),
                1.6 if is_hc else 1.0,
            )
        cr.restore()

    def _draw_propagation_arcs(
        self,
        cr: cairo.Context,
        w: int,
        h: int,
        cwx: float,
        cwy: float,
        world_w: float,
        spots: list[Spot],
    ) -> None:
        x0 = cwx - w * 0.5
        y0 = cwy - h * 0.5
        pulse = 0.5 + 0.5 * math.sin(self.anim_phase * 2.0 * math.pi)
        now_ts = time.time()

        cr.save()
        # Draw global background spots first, then home-grid spots, then W1AW spots & selected spot on very top!
        ordered = sorted(
            spots,
            key=lambda s: (
                2 if s.key == self.selected_spot_key else (1 if s.is_home_call else (0.5 if s.is_home_grid else 0)),
                s.ts,
            ),
        )

        home_Call_labels: list[tuple[float, float, str, tuple[float, float, float]]] = []

        for sp in ordered:
            is_sel = sp.key == self.selected_spot_key
            pts = sp.get_arc()
            if len(pts) < 2:
                continue

            # Convert unwrapped geodesic points to world pixels, shifting whole path to nearest viewport copy
            mid_lat, mid_lon = pts[len(pts) // 2]
            mwx, _ = latlon_to_world_px(mid_lat, mid_lon, self.zoom)
            shift_k = round((cwx - mwx) / world_w)
            x_shift = shift_k * world_w - x0

            s_pts: list[tuple[float, float]] = []
            vis_any = False
            for lat, lon_u in pts:
                # Note: latlon_to_world_px does NOT modulo lon_u, preserving continuous unwrapped X!
                scale = world_w
                wx = ((lon_u + 180.0) / 360.0) * scale
                lat_c = max(-85.05112878, min(85.05112878, lat))
                sin_l = math.sin(math.radians(lat_c))
                wy = (0.5 - math.log((1.0 + sin_l) / (1.0 - sin_l)) / (4.0 * math.pi)) * scale
                sx = wx + x_shift
                sy = wy - y0
                if -80 <= sx <= w + 80 and -80 <= sy <= h + 80:
                    vis_any = True
                s_pts.append((sx, sy))

            if not vis_any:
                continue

            bcol = BAND_COLOR_MAP.get(sp.band, (0.35, 0.96, 0.86))
            age = max(0.0, now_ts - sp.ts)
            freshness = max(0.32, 1.0 - min(1.0, age / 3600.0) * 0.55)

            if is_sel:
                # Selected spot bright white-cyan spotlight
                self._stroke_polyline(cr, s_pts, (0.35, 1.0, 0.95, 0.38), 6.5)
                self._stroke_polyline(cr, s_pts, (1.0, 1.0, 1.0, 0.98), 2.4)
            elif sp.is_home_call:
                # Bold pulsing Gold/Cyan W1AW Great-Circle Arc!
                glow_a = 0.22 + 0.20 * pulse
                self._stroke_polyline(cr, s_pts, (1.0, 0.80, 0.18, glow_a), 5.5)
                self._stroke_polyline(cr, s_pts, (1.0, 0.88, 0.34, 0.95), 2.1)

                # Directional animated beacon traveling TX -> RX along W1AW arc!
                b_idx = int((self.anim_phase * (len(s_pts) - 1))) % len(s_pts)
                bx, by = s_pts[b_idx]
                cr.set_source_rgba(0.38, 1.0, 0.92, 0.95)
                cr.arc(bx, by, 3.3, 0, 2 * math.pi)
                cr.fill()

                # Queue remote station callsign + SNR dB pill label
                is_tx_home = sp.tx_call.split("/")[0] == self.home_call
                rem_pt = s_pts[-1] if is_tx_home else s_pts[0]
                rem_call = sp.rx_call if is_tx_home else sp.tx_call
                snr_txt = f" {sp.snr:+d}dB" if sp.snr is not None else ""
                home_Call_labels.append((rem_pt[0], rem_pt[1], f"{rem_call}{snr_txt} [{sp.band}]", bcol))
            else:
                lw = 1.55 if sp.is_home_grid else 1.15
                al = 0.85 if sp.is_home_grid else (0.58 * freshness)
                self._stroke_polyline(cr, s_pts, (bcol[0], bcol[1], bcol[2], al), lw)

            # Endpoints (TX dot + RX ring)
            tx_x, tx_y = s_pts[0]
            rx_x, rx_y = s_pts[-1]
            r_dot = 3.4 if (sp.is_home_call or is_sel) else 2.2
            cr.set_source_rgba(bcol[0], bcol[1], bcol[2], 0.92)
            cr.arc(tx_x, tx_y, r_dot, 0, 2 * math.pi)
            cr.fill()
            cr.arc(rx_x, rx_y, r_dot + 0.6, 0, 2 * math.pi)
            cr.set_line_width(1.2)
            cr.stroke()

            if is_sel and not sp.is_home_call:
                snr_txt = f" {sp.snr:+d}dB" if sp.snr is not None else ""
                home_Call_labels.append(
                    (rx_x, rx_y, f"{sp.tx_call}->{sp.rx_call}{snr_txt} ({int(sp.dist_km)}km)", (1.0, 1.0, 1.0))
                )

        # Render crisp Callsign + SNR (dB) Pill Badges (de-cluttered up to 28 badges)
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(9.5)
        placed_boxes: list[tuple[float, float, float, float]] = []
        for lx, ly, text, col in home_Call_labels[:36]:
            if not (4 <= lx <= w - 4 and 4 <= ly <= h - 4):
                continue
            ext = cr.text_extents(text)
            pw = ext.width + 10.0
            ph = 15.0
            px = min(w - pw - 4, max(4.0, lx + 6.0))
            py = min(h - ph - 4, max(4.0, ly - ph - 3.0))
            # Simple overlap check
            if any(abs(px - bx) < (pw * 0.75) and abs(py - by) < ph for bx, by, _, _ in placed_boxes):
                continue
            placed_boxes.append((px, py, pw, ph))

            cr.set_source_rgba(0.05, 0.09, 0.14, 0.88)
            cr.rectangle(px, py, pw, ph)
            cr.fill_preserve()
            cr.set_source_rgba(col[0], col[1], col[2], 0.92)
            cr.set_line_width(1.1)
            cr.stroke()

            cr.set_source_rgb(0.98, 0.96, 0.86)
            cr.move_to(px + 5.0, py + 11.2)
            cr.show_text(text)

        cr.restore()

    @staticmethod
    def _stroke_polyline(
        cr: cairo.Context, pts: list[tuple[float, float]], rgba: tuple[float, float, float, float], lw: float
    ) -> None:
        cr.set_source_rgba(*rgba)
        cr.set_line_width(lw)
        first = True
        for sx, sy in pts:
            if first:
                cr.move_to(sx, sy)
                first = False
            else:
                cr.line_to(sx, sy)
        cr.stroke()

    def _draw_home_qth_marker(self, cr: cairo.Context, w: int, h: int, cwx: float, cwy: float) -> None:
        hx, hy = self._latlon_to_screen(self.home_lat, self.home_lon, w, h, cwx, cwy)
        if not (-30 <= hx <= w + 30 and -30 <= hy <= h + 30):
            return

        pulse_r = 9.0 + 5.5 * (0.5 + 0.5 * math.sin(self.anim_phase * 2.0 * math.pi))
        cr.save()
        # Pulsing radar ring around W1AW FN31pr
        cr.set_source_rgba(1.0, 0.82, 0.22, 0.35)
        cr.set_line_width(1.6)
        cr.arc(hx, hy, pulse_r, 0, 2 * math.pi)
        cr.stroke()

        # Tactical crosshair + gold diamond QTH beacon
        cr.set_source_rgb(1.0, 0.86, 0.26)
        cr.move_to(hx, hy - 7.0)
        cr.line_to(hx + 6.5, hy)
        cr.line_to(hx, hy + 7.0)
        cr.line_to(hx - 6.5, hy)
        cr.close_path()
        cr.fill_preserve()
        cr.set_source_rgb(0.10, 0.12, 0.16)
        cr.set_line_width(1.3)
