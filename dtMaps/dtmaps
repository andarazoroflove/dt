    # -----------------------------------------------------------------------
    # Interactive Mouse, Scroll-Wheel & Control Callbacks
    # -----------------------------------------------------------------------
    def _on_map_button_press(self, widget: Gtk.Widget, event: Gdk.EventButton) -> bool:
        widget.grab_focus()
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        lat, lon = self._screen_to_latlon(event.x, event.y, w, h)

        if event.button == 1:
            if event.type == Gdk.EventType._2BUTTON_PRESS:
                self._zoom_at_screen_pt(self.zoom + 1, event.x, event.y)
                return True
            self._dragging = True
            self._drag_moved = False
            self._drag_last_xy = (event.x, event.y)
            return True

        if event.button == 3:
            # Right-click sets or toggles interactive Geodesic Ruler anchor!
            self.ruler_active = True
            self.ruler_anchor = (lat, lon)
            self.ruler_target = (lat, lon)
            self._sync_switch_style(self.btn_ruler, True)
            g6 = latlon_to_maidenhead(lat, lon, 6)
            self._set_status(f"Ruler anchor set to {g6} ({lat:.3f}°, {lon:.3f}°). Move cursor or click to measure.")
            self._queue_map_redraw()
            return True
        return False

    def _on_map_button_release(self, widget: Gtk.Widget, event: Gdk.EventButton) -> bool:
        if event.button == 1 and self._dragging:
            self._dragging = False
            if not self._drag_moved:
                w = widget.get_allocated_width()
                h = widget.get_allocated_height()
                lat, lon = self._screen_to_latlon(event.x, event.y, w, h)
                if self.ruler_active:
                    if self.ruler_anchor is None:
                        self.ruler_anchor = (lat, lon)
                        self.ruler_target = None
                    else:
                        self.ruler_anchor = (lat, lon)
                    self._queue_map_redraw()
                else:
                    self._select_nearest_spot(event.x, event.y, w, h)
            else:
                self._save_config()
            return True
        return False

    def _on_map_motion(self, widget: Gtk.Widget, event: Gdk.EventMotion) -> bool:
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        if self._dragging:
            dx = event.x - self._drag_last_xy[0]
            dy = event.y - self._drag_last_xy[1]
            if abs(dx) > 2.0 or abs(dy) > 2.0:
                self._drag_moved = True
            self._drag_last_xy = (event.x, event.y)
            cwx, cwy = latlon_to_world_px(self.center_lat, self.center_lon, self.zoom)
            world_w = TILE_SIZE * (1 << self.zoom)
            new_wx = (cwx - dx) % world_w
            new_wy = max(20.0, min(world_w - 20.0, cwy - dy))
            self.center_lat, self.center_lon = world_px_to_latlon(new_wx, new_wy, self.zoom)
            self._queue_map_redraw()

        self.cursor_lat, self.cursor_lon = self._screen_to_latlon(event.x, event.y, w, h)
        self.cursor_in_map = True
        if self.ruler_active:
            self.ruler_target = (self.cursor_lat, self.cursor_lon)
            self._queue_map_redraw()
        self.vfd_area.queue_draw()
        return True

    def _on_map_leave(self, _widget: Gtk.Widget, _event: Gdk.EventCrossing) -> bool:
        self.cursor_in_map = False
        return False

    def _on_map_scroll(self, widget: Gtk.Widget, event: Gdk.EventScroll) -> bool:
        step = 0
        if event.direction == Gdk.ScrollDirection.UP:
            step = 1
        elif event.direction == Gdk.ScrollDirection.DOWN:
            step = -1
        elif event.direction == Gdk.ScrollDirection.SMOOTH:
            _, _, dy = event.get_scroll_deltas()
            if dy < -0.1:
                step = 1
            elif dy > 0.1:
                step = -1
        if step != 0:
            self._zoom_at_screen_pt(self.zoom + step, event.x, event.y)
            return True
        return False

    def _zoom_at_screen_pt(self, new_zoom: int, sx: float, sy: float) -> None:
        nz = max(MIN_ZOOM, min(MAX_ZOOM, new_zoom))
        if nz == self.zoom:
            return
        w = self.map_area.get_allocated_width()
        h = self.map_area.get_allocated_height()
        anchor_lat, anchor_lon = self._screen_to_latlon(sx, sy, w, h)
        self.zoom = nz
        awx, awy = latlon_to_world_px(anchor_lat, anchor_lon, self.zoom)
        cwx = awx - (sx - w * 0.5)
        cwy = awy - (sy - h * 0.5)
        self.center_lat, self.center_lon = world_px_to_latlon(cwx, cwy, self.zoom)
        self._save_config()
        self._queue_map_redraw()
        self.vfd_area.queue_draw()

    def _set_zoom(self, new_zoom: int) -> None:
        w = self.map_area.get_allocated_width()
        h = self.map_area.get_allocated_height()
        self._zoom_at_screen_pt(new_zoom, w * 0.5, h * 0.5)

    def _jump_to(self, lat: float, lon: float, z: int) -> None:
        self.center_lat = lat
        self.center_lon = lon
        self.zoom = max(MIN_ZOOM, min(MAX_ZOOM, z))
        self._save_config()
        self._queue_map_redraw()
        self.vfd_area.queue_draw()

    def _on_jump_home(self, *_args) -> None:
        self._jump_to(self.home_lat, self.home_lon, 7)
        self._set_status(
            f"Centered on Home QTH {self.home_call} [{self.home_grid}] ({self.home_lat:.4f}°, {self.home_lon:.4f}°)"
        )

    def _select_nearest_spot(self, sx: float, sy: float, w: int, h: int) -> None:
        cwx, cwy = latlon_to_world_px(self.center_lat, self.center_lon, self.zoom)
        spots = self._get_filtered_spots()
        best_sp: Spot | None = None
        best_d = 18.0
        for sp in spots:
            for plat, plon in ((sp.tx_lat, sp.tx_lon), (sp.rx_lat, sp.rx_lon)):
                px, py = self._latlon_to_screen(plat, plon, w, h, cwx, cwy)
                d = math.hypot(px - sx, py - sy)
                if d < best_d:
                    best_d = d
                    best_sp = sp
        if best_sp is not None:
            self.selected_spot_key = best_sp.key
            snr_s = f"{best_sp.snr:+d} dB" if best_sp.snr is not None else "n/a"
            self._set_status(
                f"SPOT: {best_sp.tx_call} [{best_sp.tx_grid}] -> {best_sp.rx_call} [{best_sp.rx_grid}]  |  "
                f"{best_sp.band} {best_sp.mode}  |  SNR {snr_s}  |  {best_sp.dist_km:.1f} km ({best_sp.dist_km * KM_TO_MI:.1f} mi)"
            )
        else:
            self.selected_spot_key = None
        self._queue_map_redraw()

    # -----------------------------------------------------------------------
    # Toolbar & Roster Actions
    # -----------------------------------------------------------------------
    def _on_apply_qth(self, *_args) -> None:
        new_call = self.ent_call.get_text().strip().upper() or DEFAULT_CALLSIGN
        new_grid = self.ent_grid.get_text().strip() or DEFAULT_GRID
        pt = maidenhead_to_latlon(new_grid)
        if pt is None:
            self._set_status(f"Invalid Maidenhead locator '{new_grid}' — enter 4, 6, or 8 chars (e.g. FN31pr).")
            return
        if len(new_grid) == 6:
            new_grid = new_grid[:4].upper() + new_grid[4:6].lower()
        else:
            new_grid = new_grid.upper()

        self.home_call = new_call
        self.home_grid = new_grid
        self.home_lat, self.home_lon = pt
        self.ent_call.set_text(self.home_call)
        self.ent_grid.set_text(self.home_grid)
        self.btn_home.set_label(f"HOME {self.home_grid}")
        self._save_config()

        # Re-tag existing live spots for new home QTH, re-query 24h XML, and resubscribe MQTT
        hg4 = self.home_grid[:4].upper()
        with self._spots_lock:
            for sp in self.live_spots.values():
                sp.is_home_call = (sp.tx_call.split("/")[0] == self.home_call or sp.rx_call.split("/")[0] == self.home_call)
                sp.is_home_grid = (sp.tx_grid[:4].upper() == hg4 or sp.rx_grid[:4].upper() == hg4)
        self._start_psk24h_poll(force_network=False)
        self.mqtt_client.trigger_resubscribe()
        self._roster_dirty = True
        self._queue_map_redraw()
        self.vfd_area.queue_draw()
        self._set_status(f"Updated Home QTH -> {self.home_call} [{self.home_grid}] ({self.home_lat:.4f}°, {self.home_lon:.4f}°)")

    def _on_map_mode_changed(self, combo: Gtk.ComboBoxText) -> None:
        mkey = combo.get_active_id()
        if mkey:
            self.map_mode = mkey
            self._save_config()
            self._queue_map_redraw()

    def _on_mode_filter_changed(self, combo: Gtk.ComboBoxText) -> None:
        txt = combo.get_active_text()
        if txt:
            self.mode_filter = txt
            self._roster_dirty = True
            self._queue_map_redraw()

    def _on_toggle_grid(self, *_args) -> None:
        self.show_grid = not self.show_grid
        self._sync_switch_style(self.btn_grid, self.show_grid)
        self._save_config()
        self._queue_map_redraw()

    def _on_toggle_greyline(self, *_args) -> None:
        self.show_greyline = not self.show_greyline
        self._sync_switch_style(self.btn_grey, self.show_greyline)
        self._save_config()
        self._queue_map_redraw()

    def _on_toggle_arcs(self, *_args) -> None:
        self.show_arcs = not self.show_arcs
        self._sync_switch_style(self.btn_arcs, self.show_arcs)
        self._save_config()
        self._queue_map_redraw()

    def _on_toggle_ruler(self, *_args) -> None:
        self.ruler_active = not self.ruler_active
        if self.ruler_active:
            self.ruler_anchor = (self.home_lat, self.home_lon)
            self.ruler_target = (self.cursor_lat, self.cursor_lon)
            self._set_status(f"Range & Bearing Ruler ON (anchored at {self.home_grid}; click or right-click map to move anchor).")
        else:
            self._set_status("Range & Bearing Ruler OFF.")
        self._sync_switch_style(self.btn_ruler, self.ruler_active)
        self._queue_map_redraw()

    def _on_toggle_roster(self, *_args) -> None:
        vis = not self.roster_box.get_visible()
        self.roster_box.set_visible(vis)
        self._sync_switch_style(self.btn_roster, vis)

    def _on_bands_all(self, *_args) -> None:
        self.enabled_bands = set(BAND_ORDER)
        for bname, btn in self.band_buttons.items():
            btn.get_style_context().remove_class("band-off")
        self._roster_dirty = True
        self._queue_map_redraw()

    def _on_band_clicked(self, btn: Gtk.Button, bname: str) -> None:
        if bname in self.enabled_bands:
            if len(self.enabled_bands) > 1:
                self.enabled_bands.remove(bname)
                btn.get_style_context().add_class("band-off")
        else:
            self.enabled_bands.add(bname)
            btn.get_style_context().remove_class("band-off")
        self._roster_dirty = True
        self._queue_map_redraw()

    def _on_band_press(self, _btn: Gtk.Button, event: Gdk.EventButton, bname: str) -> bool:
        if event.button == 3:
            # Right-click solos this single band!
            self.enabled_bands = {bname}
            for k, b in self.band_buttons.items():
                if k == bname:
                    b.get_style_context().remove_class("band-off")
                else:
                    b.get_style_context().add_class("band-off")
            self._roster_dirty = True
            self._queue_map_redraw()
            self._set_status(f"Soloed {bname} band (click ALL to restore all bands).")
            return True
        return False

    def _on_clear_live_spots(self, *_args) -> None:
        with self._spots_lock:
            self.live_spots.clear()
        self._roster_dirty = True
        self._queue_map_redraw()

    def _on_roster_row_selected(self, view: Gtk.TreeView) -> None:
        sel = view.get_selection()
        if not sel:
            return
        model, it = sel.get_selected()
        if it is None:
            return
        key = model.get_value(it, 0)
        self.selected_spot_key = key
        self._queue_map_redraw()

    def _on_roster_row_activated(self, view: Gtk.TreeView, path: Gtk.TreePath, _col) -> None:
        it = self.roster_store.get_iter(path)
        if it is None:
            return
        key = self.roster_store.get_value(it, 0)
        self.selected_spot_key = key
        with self._spots_lock:
            sp = self.live_spots.get(key)
            if sp is None:
                for s in self.psk24h_spots:
                    if s.key == key:
                        sp = s
                        break
        if sp is not None:
            pts = sp.get_arc()
            mid_lat, mid_lon = pts[len(pts) // 2]
            mid_lon_norm = ((mid_lon + 180.0) % 360.0) - 180.0
            z_fit = 5 if sp.dist_km < 2500 else (4 if sp.dist_km < 6000 else 3)
            self._jump_to(mid_lat, mid_lon_norm, z_fit)
            self._set_status(
                f"Centered on {sp.tx_call} [{sp.tx_grid}] -> {sp.rx_call} [{sp.rx_grid}] ({sp.dist_km:.0f} km, {sp.band} {sp.mode})"
            )

    def _on_click_import_adif(self, *_args) -> None:
        dlg = Gtk.FileChooserDialog(
            title="Import Amateur Radio ADIF Log (.adi / .adif)",
            parent=self,
            action=Gtk.FileChooserAction.OPEN,
        )
        dlg.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OPEN, Gtk.ResponseType.OK,
        )
        flt = Gtk.FileFilter()
        flt.set_name("ADIF Logs (*.adi, *.adif)")
        flt.add_pattern("*.adi")
        flt.add_pattern("*.ADI")
        flt.add_pattern("*.adif")
        flt.add_pattern("*.ADIF")
        dlg.add_filter(flt)
        if WSJTX_DEFAULT_ADI.parent.is_dir():
            dlg.set_current_folder(str(WSJTX_DEFAULT_ADI.parent))

        if dlg.run() == Gtk.ResponseType.OK:
            fpath = Path(dlg.get_filename())
            self._import_adif_file(fpath, save_copy=True, quiet=False)
        dlg.destroy()

    def _import_adif_file(self, fpath: Path, save_copy: bool = True, quiet: bool = False) -> None:
        try:
            txt = fpath.read_text(encoding="utf-8", errors="ignore")
            w_set, c_set, qsos = parse_adif_worked_grids(txt)
            self.worked_grids |= w_set
            self.confirmed_grids |= c_set
            self.adif_qso_count += qsos
            if save_copy:
                self._save_worked_grids()
            self._queue_map_redraw()
            self.vfd_area.queue_draw()
            if not quiet:
                self._set_status(
                    f"Imported {fpath.name}: {qsos} QSOs, {len(self.worked_grids)} Worked grids ({len(self.confirmed_grids)} Confirmed)."
                )
        except Exception as exc:
            if not quiet:
                self._set_status(f"ADIF import failed: {exc}")

    # -----------------------------------------------------------------------
    # Timers & Shutdown
    # -----------------------------------------------------------------------
    def _on_anim_tick(self) -> bool:
        self.anim_phase = (self.anim_phase + 0.035) % 1.0
        now = time.monotonic()
        if self._roster_dirty and (now - self._last_roster_sync >= 0.45):
            self._roster_dirty = False
            self._last_roster_sync = now
            self._sync_roster_and_band_counts()
        # Pulse home beacon & any active W1AW arcs + UTC second clock
        self.vfd_area.queue_draw()
        self.map_area.queue_draw()
        return True

    def _queue_map_redraw(self) -> bool:
        self.map_area.queue_draw()
        return False

    def _set_status(self, msg: str) -> None:
        self.status_lbl.set_text(msg)

    def _on_destroy(self, *_args) -> None:
        self._save_config()
        self.mqtt_client.stop()
        self.wsjtx_listener.stop()
        self.tile_engine.shutdown()
        Gtk.main_quit()


# ---------------------------------------------------------------------------
# Comprehensive Self-Test Mode (`--self-test`)
# ---------------------------------------------------------------------------
def run_self_test() -> int:
    # 1. Verify Maidenhead <-> Lat/Lon (W1AW FN31pr = Newington, CT)
    pt = maidenhead_to_latlon("FN31pr")
    assert pt is not None, "FN31pr conversion failed"
    lat, lon = pt
    assert abs(lat - 41.729167) < 0.02 and abs(lon - (-72.708333)) < 0.03, f"Unexpected FN31pr: {pt}"
    g6 = latlon_to_maidenhead(lat, lon, chars=6)
    assert g6 == "FN31pr", f"Round-trip Maidenhead mismatch: {g6}"
    g8 = latlon_to_maidenhead(lat, lon, chars=8)
    assert len(g8) == 8 and maidenhead_to_latlon(g8) is not None

    # 2. Verify Geodesic Distance, Short/Long Path Azimuth & Pacific Antimeridian Slerp
    dkm, sp, lp = geodesic_distance_bearing(lat, lon, 35.68, 139.76)  # FN31pr -> Tokyo PM95
    assert 10500.0 < dkm < 11200.0, f"Unexpected Newington-Tokyo distance: {dkm}"
    assert 330.0 < sp < 350.0 and abs(((sp + 180.0) % 360.0) - lp) < 0.01
    arc = great_circle_unwrapped(lat, lon, 35.68, 139.76, steps=32)
    assert len(arc) == 33
    for i in range(1, len(arc)):
        assert abs(arc[i][1] - arc[i - 1][1]) < 35.0, "Antimeridian longitude jump detected!"

    # 3. Verify Solar Greyline Astronomical Terminator Math
    ts_fixed = datetime.datetime(2026, 6, 21, 18, 0, 0, tzinfo=datetime.timezone.utc)
    slat, slon = compute_solar_subsolar(ts_fixed)
    assert 22.5 < slat < 24.0, f"Solstice declination out of range: {slat}"
    term = compute_terminator_curve(slat, slon)
    assert len(term) > 100

    # 4. Verify PSKReporter XML Parser & ADIF Parser
    sample_xml = """<?xml version="1.0"?>
    <receptionReports>
      <receptionReport senderCallsign="W1AW" senderLocator="FN31pr"
        receiverCallsign="JH1ABC" receiverLocator="PM95vq"
        frequency="14074850" mode="FT8" sNR="-08" flowStartSeconds="1732660000" />
    </receptionReports>"""
    spots = parse_pskreporter_xml(sample_xml, "W1AW", "FN31")
    assert len(spots) == 1 and spots[0].is_home_call and spots[0].band == "20m" and spots[0].snr == -8

    sample_adif = "Header <EOH><CALL:6>JH1ABC<GRIDSQUARE:6>PM95vq<BAND:3>20m<LOTW_QSL_RCVD:1>Y<EOR>"
    w_g, c_g, q_n = parse_adif_worked_grids(sample_adif)
    assert "PM95" in w_g and "PM95" in c_g and q_n == 1

    # 5. Verify Pure-Stdlib MQTT v3.1.1 Packet Builder & Variable-LengthPUBLISH Decoder
    conn_pkt = mqtt_build_connect("dtmaps_w1aw_test", 60)
    assert conn_pkt[0] == 0x10 and b"MQTT" in conn_pkt
    sub_pkt = mqtt_build_subscribe(1, ["pskr/filter/v2/+/+/W1AW/#", "pskr/filter/v2/+/FT8/#"])
    assert sub_pkt[0] == 0x82
    assert mqtt_build_pingreq() == b"\xc0\x00"

    topic_b = mqtt_encode_utf8("pskr/filter/v2/20m/FT8/W1AW/K6ARK/FN31/CM87/1/1")
    json_b = json.dumps({
        "sc": "W1AW", "sl": "FN31pr", "rc": "K6ARK", "rl": "CM87wk",
        "f": 14074500, "md": "FT8", "rp": 4, "t": 1732660100, "b": "20m",
    }).encode("utf-8")
    body = topic_b + json_b
    pub_pkt = bytearray(b"\x30" + mqtt_encode_varlen(len(body)) + body)
    dec = mqtt_try_decode_packet(pub_pkt)
    assert dec is not None and dec[0] == 3
    msp = parse_mqtt_spot_json(dec[2], "W1AW", "FN31")
    assert msp is not None and msp.is_home_call and msp.rx_call == "K6ARK"

    # 6. Verify Embedded Vector World Geography + 5 Map Mode LUTs + Cairo Surface Init
    assert len(WORLD_POLYGONS) >= 60
    test_tile = np.full((64, 64, 3), 180, dtype=np.uint8)
    for mkey, _ in MAP_MODES:
        out_rgb = apply_map_mode_to_rgb(test_tile, mkey)
        surf = rgb_to_cairo_surface(out_rgb)
        cr = cairo.Context(surf)
        cr.set_source_rgb(0.2, 0.9, 0.8)
        cr.arc(32, 32, 8, 0, 2 * math.pi)
        cr.stroke()

    # Check Gtk bindings import & init_check cleanly (works headless or with DISPLAY)
    Gtk.init_check(sys.argv)

    print("DTMAPS_SELF_TEST_OK")
    return 0


def main() -> int:
    if "--self-test" in sys.argv:
        return run_self_test()

    ok, _ = Gtk.init_check(sys.argv)
    if not ok:
        sys.stderr.write("dtMaps: Cannot open X11/GTK display.\n")
        return 1

    win = DtMapsWindow()
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
