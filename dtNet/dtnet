    # -----------------------------------------------------------------------
    # Ambient & Continuous Ping Threads (Non-Blocking)
    # -----------------------------------------------------------------------
    def _start_ambient_rtt_thread(self):
        def worker():
            last_rtt: float | None = None
            while not self._bg_ping_stop.is_set():
                if not self._cping_running:
                    tgt = self.sampler.rtt_target or "1.1.1.1"
                    rtt = self._single_ping_ms(tgt)
                    if rtt is not None:
                        jit = abs(rtt - last_rtt) if last_rtt is not None else 0.0
                        last_rtt = rtt
                        self.sampler.rtt_ms = rtt
                        self.sampler.rtt_peak_ms = max(self.sampler.rtt_peak_ms * 0.98, rtt)
                        self.sampler.rtt_jitter_ms = 0.7 * self.sampler.rtt_jitter_ms + 0.3 * jit
                    else:
                        self.sampler.rtt_ms = None
                self._bg_ping_stop.wait(2.5)

        threading.Thread(target=worker, daemon=True).start()

    @staticmethod
    def _single_ping_ms(target: str) -> float | None:
        if not shutil.which("ping"):
            return None
        try:
            proc = subprocess.run(
                ["ping", "-n", "-c", "1", "-W", "1", target],
                capture_output=True, text=True, timeout=1.8,
            )
            m = PING_REPLY_RE.search(proc.stdout)
            if m:
                return float(m.group(2))
        except Exception:
            pass
        return None

    def _on_toggle_continuous_ping(self, btn: Gtk.ToggleButton):
        if btn.get_active():
            target = self.ent_target.get_text().strip() or "1.1.1.1"
            self.sampler.rtt_target = target
            self._cping_stop.clear()
            self._cping_running = True
            btn.set_label("■ STOP PING")
            btn.get_style_context().add_class("btn-stop")
            threading.Thread(target=self._continuous_ping_worker, args=(target,), daemon=True).start()
        else:
            self._cping_stop.set()
            self._cping_running = False
            btn.set_label("▶ CONTINUOUS PING")
            btn.get_style_context().remove_class("btn-stop")

    def _continuous_ping_worker(self, target: str):
        sent = 0
        rcvd = 0
        rtts: list[float] = []
        while not self._cping_stop.is_set():
            sent += 1
            rtt = self._single_ping_ms(target)
            if rtt is not None:
                rcvd += 1
                if rtts:
                    jit = abs(rtt - rtts[-1])
                    self.sampler.rtt_jitter_ms = 0.65 * self.sampler.rtt_jitter_ms + 0.35 * jit
                rtts.append(rtt)
                if len(rtts) > 60:
                    rtts.pop(0)
                self.sampler.rtt_ms = rtt
                self.sampler.rtt_peak_ms = max(self.sampler.rtt_peak_ms, rtt)
                loss = 100.0 * (sent - rcvd) / sent
                mn, av, mx = min(rtts), sum(rtts) / len(rtts), max(rtts)
                summary = f"PING {target}: {rtt:.1f}ms (min/avg/max {mn:.1f}/{av:.1f}/{mx:.1f}ms | jit ±{self.sampler.rtt_jitter_ms:.1f}ms | loss {loss:.0f}%)"
            else:
                self.sampler.rtt_ms = None
                loss = 100.0 * (sent - rcvd) / sent
                summary = f"PING {target}: TIMEOUT / OFFLINE (sent {sent}, loss {loss:.0f}%)"

            GLib.idle_add(self._update_ping_hud, summary)
            self._cping_stop.wait(1.0)

    def _update_ping_hud(self, summary: str):
        self._cping_stats = summary
        self.lbl_status.set_text(summary)
        self.radar_area.queue_draw()
        return False

