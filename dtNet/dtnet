    def _run_bench_tool(self, mode: str):
        raw_target = self.ent_bench_host.get_text().strip()
        if not raw_target:
            return
        try:
            port = int(self.ent_bench_port.get_text().strip())
        except ValueError:
            port = 443

        parsed = urllib.parse.urlparse(raw_target if "://" in raw_target else f"https://{raw_target}")
        host = parsed.hostname or raw_target
        if parsed.port:
            port = parsed.port

        ts = datetime.datetime.now().strftime("%H:%M:%S")
        GLib.idle_add(self._append_bench_text, f"\n[{ts}] >>> BENCH {mode} :: {host}:{port} <<<\n")
        threading.Thread(target=self._bench_worker, args=(mode, raw_target, host, port), daemon=True).start()

    def _bench_worker(self, mode: str, raw_target: str, host: str, port: int):
        sections: list[str] = []

        if mode in ("DNS", "ALL"):
            lines = ["[DNS RESOLVER]"]
            lines.append(f"  System Nameservers : {', '.join(get_system_nameservers())}")
            t0 = time.monotonic()
            try:
                infos = socket.getaddrinfo(host, None, proto=socket.IPPROTO_TCP)
                ms = (time.monotonic() - t0) * 1000.0
                addrs = sorted({info[4][0] for info in infos})
                lines.append(f"  Lookup Latency     : {ms:.1f} ms")
                for a in addrs:
                    fam = "AAAA" if ":" in a else "A   "
                    ptr = ""
                    try:
                        ptr = f"  (PTR: {socket.gethostbyaddr(a)[0]})"
                    except OSError:
                        pass
                    lines.append(f"  {fam} Record        : {a}{ptr}")
            except OSError as exc:
                lines.append(f"  DNS Error / Offline: {exc}")
            sections.append("\n".join(lines) + "\n")

        if mode in ("TCP", "ALL"):
            lines = ["[TCP PORT & BANNER PROBE]"]
            ports_to_test = [port] if mode == "TCP" else list(dict.fromkeys([port, 22, 80, 443, 8073, 8080]))
            for p in ports_to_test:
                t0 = time.monotonic()
                try:
                    with socket.create_connection((host, p), timeout=2.0) as sock:
                        ms = (time.monotonic() - t0) * 1000.0
                        sock.settimeout(0.6)
                        banner = ""
                        if p in (21, 22, 25, 110, 143, 587, 6667):
                            try:
                                raw_b = sock.recv(128)
                                banner = raw_b.decode("utf-8", errors="replace").strip().splitlines()[0][:60]
                            except OSError:
                                pass
                        svc = port_service_name(p, "tcp")
                        b_note = f" | Banner: {banner}" if banner else ""
                        lines.append(f"  TCP {p:<5} ({svc:<10}): OPEN  ({ms:.1f} ms SYN/ACK){b_note}")
                except OSError as exc:
                    lines.append(f"  TCP {p:<5} ({port_service_name(p, 'tcp'):<10}): CLOSED/UNREACHABLE ({exc})")
            sections.append("\n".join(lines) + "\n")

        if mode in ("TLS", "ALL"):
            lines = ["[TLS / X.509 CERTIFICATE]"]
            tls_port = port if port not in (80, 22, 53) else 443
            ctx = ssl.create_default_context()
            t0 = time.monotonic()
            try:
                with socket.create_connection((host, tls_port), timeout=2.8) as raw_sock:
                    with ctx.wrap_socket(raw_sock, server_hostname=host) as ssock:
                        ms = (time.monotonic() - t0) * 1000.0
                        cert = ssock.getpeercert() or {}
                        cipher = ssock.cipher()
                        subj = dict(x[0] for x in cert.get("subject", ()))
                        issr = dict(x[0] for x in cert.get("issuer", ()))
                        not_after = cert.get("notAfter", "")
                        sans = [v for k, v in cert.get("subjectAltName", ()) if k == "DNS"]
                        days_str = ""
                        if not_after:
                            try:
                                exp_ts = ssl.cert_time_to_seconds(not_after)
                                days_left = int((exp_ts - time.time()) / 86400)
                                days_str = f" ({days_left} days remaining)"
                            except Exception:
                                pass
                        lines.append(f"  Protocol & Cipher  : {ssock.version()} / {cipher[0] if cipher else '?'} ({ms:.1f} ms)")
                        lines.append(f"  Subject CN         : {subj.get('commonName', '-')}")
                        lines.append(f"  Issuer             : {issr.get('organizationName', issr.get('commonName', '-'))}")
                        lines.append(f"  Expires (notAfter) : {not_after}{days_str}")
                        if sans:
                            lines.append(f"  SANs ({len(sans):>2})          : {', '.join(sans[:5])}")
            except Exception as exc:
                lines.append(f"  TLS Handshake Info : {exc}")
            sections.append("\n".join(lines) + "\n")

        if mode in ("HTTP", "ALL"):
            lines = ["[HTTP / HTTPS RESPONSE HEADERS]"]
            url = raw_target if "://" in raw_target else (f"http://{host}:{port}" if port == 80 else f"https://{host}:{port}")
            req = urllib.request.Request(url, headers={"User-Agent": UA}, method="HEAD")
            t0 = time.monotonic()
            try:
                with urllib.request.urlopen(req, timeout=3.2) as resp:
                    ms = (time.monotonic() - t0) * 1000.0
                    lines.append(f"  URL                : {resp.geturl()}")
                    lines.append(f"  Status             : HTTP {resp.status} {resp.reason} ({ms:.1f} ms)")
                    for hk, hv in list(resp.headers.items())[:14]:
                        lines.append(f"  {hk:<19}: {hv[:72]}")
            except urllib.error.HTTPError as hexc:
                ms = (time.monotonic() - t0) * 1000.0
                lines.append(f"  Status             : HTTP {hexc.code} {hexc.reason} ({ms:.1f} ms)")
                for hk, hv in list(hexc.headers.items())[:10]:
                    lines.append(f"  {hk:<19}: {hv[:72]}")
            except Exception as exc:
                lines.append(f"  HTTP Fetch Offline : {exc}")
            sections.append("\n".join(lines) + "\n")

        GLib.idle_add(self._append_bench_text, "\n".join(sections))


# ---------------------------------------------------------------------------
# Headless Self-Test Suite (`./dtnet --self-test`)
# ---------------------------------------------------------------------------
def run_self_test() -> int:
    # 1. Verify /proc/net/dev live + synthetic parser & auto-scaling scale selection
    live_dev = Path("/proc/net/dev").read_text(encoding="utf-8", errors="replace")
    live_parsed = parse_proc_net_dev_text(live_dev)
    assert "lo" in live_parsed, "Expected lo interface in /proc/net/dev"

    synth_dev = (
        "Inter-|   Receive                                                |  Transmit\n"
        " face |bytes    packets errs drop fifo frame compressed multicast|bytes    packets errs drop fifo colls carrier compressed\n"
        "  eth0: 104857600   82000    1    2    0     0          0       120 52428800   41000    0    1    0     0       0          0\n"
        " wlan0:  20971520   19400    0    0    0     0          0        40  8388608    9100    0    0    0     0       0          0\n"
    )
    sdev = parse_proc_net_dev_text(synth_dev)
    assert sdev["eth0"]["rx_bytes"] == 104857600 and sdev["wlan0"]["tx_packets"] == 9100
    ceil_bps, ulbl, marks = choose_throughput_scale(14_500_000.0)
    assert ceil_bps == 100_000_000.0 and "Mbps" in ulbl and len(marks) == 6

    # 2. Verify /proc/net/tcp & /proc/net/tcp6 hex IPv4/IPv6 + port + state parser
    synth_tcp = (
        "  sl  local_address rem_address   st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode\n"
        "   0: 0100007F:0035 00000000:0000 0A 00000000:00000000 00:00000000 00000000   101        0 20481 1 0000000000000000 100 0 0 10 0\n"
        "   1: 0A01A8C0:9C40 01010101:01BB 01 00000000:00000000 02:00000520 00000000  1000        0 38912 1 0000000000000000 20 4 30 10 -1\n"
    )
    tcp_rows = parse_proc_net_sockets_text(synth_tcp, "TCP", is_ipv6=False)
    assert len(tcp_rows) == 2
    assert tcp_rows[0]["local"] == "127.0.0.1:53" and tcp_rows[0]["state"] == "LISTEN" and tcp_rows[0]["service"] == "domain"
    assert tcp_rows[1]["local"] == "192.168.1.10:40000" and tcp_rows[1]["remote"] == "1.1.1.1:443" and tcp_rows[1]["state"] == "ESTABLISHED"

    synth_tcp6 = (
        "  sl  local_address                         remote_address                        st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode\n"
        "   0: 00000000000000000000000001000000:0016 00000000000000000000000000000000:0000 0A 00000000:00000000 00:00000000 00000000     0        0 19991 1 0000000000000000 100 0 0 10 0\n"
    )
    tcp6_rows = parse_proc_net_sockets_text(synth_tcp6, "TCP6", is_ipv6=True)
    assert len(tcp6_rows) == 1 and tcp6_rows[0]["local"] == "[::1]:22" and tcp6_rows[0]["service"] == "ssh"

    _ = scan_inode_to_process_map()

    # 3. Verify /proc/net/arp & /proc/net/wireless parsers
    synth_arp = (
        "IP address       HW type     Flags       HW address            Mask     Device\n"
        "192.168.1.1      0x1         0x2         f0:9f:c2:11:22:33     *        eth0\n"
        "192.168.1.42     0x1         0x2         dc:a6:32:aa:bb:cc     *        eth0\n"
    )
    arp_rows = parse_proc_net_arp_text(synth_arp)
    assert len(arp_rows) == 2 and arp_rows[0]["vendor"] == "Ubiquiti" and arp_rows[1]["vendor"] == "RaspberryPi"

    synth_wifi = (
        "Inter-| sta-|   Quality        |   Discarded packets               | Missed | WE\n"
        " face | tus | link level noise |  nwid  crypt   frag  retry   misc | beacon | 22\n"
        " wlan0: 0000   58.  -52.  -93.       0      0      0      2      0        0\n"
    )
    wmap = parse_proc_net_wireless_text(synth_wifi)
    assert "wlan0" in wmap and wmap["wlan0"]["level_dbm"] == -52.0 and 80.0 < wmap["wlan0"]["qual_pct"] < 85.0

    # 4. Verify Traceroute / Tracepath / `ping -t <ttl>` TTL parsers
    h1 = parse_traceroute_line(" 2  67.59.224.1  8.842 ms  9.110 ms")
    assert h1 is not None and h1[0] == 2 and h1[1] == "67.59.224.1" and abs((h1[2] or 0) - 8.976) < 0.05
    h_star = parse_traceroute_line(" 4  * * *")
    assert h_star == (4, "*", None)
    p_ttl = parse_ping_ttl_output("From 129.250.3.42 icmp_seq=1 Time to live exceeded\n", 24.3)
    assert p_ttl == ("129.250.3.42", 24.3, False)
    p_fin = parse_ping_ttl_output("64 bytes from 1.1.1.1: icmp_seq=1 ttl=57 time=21.4 ms\n", 22.0)
    assert p_fin == ("1.1.1.1", 21.4, True)

    # 5. Verify Great-Circle Haversine & Antimeridian Arc Splitting (Newington CT -> Auckland NZ)
    assert len(WORLD_POLYGONS) >= 60
    dist_nz = haversine_km(HOME_QTH_LAT, HOME_QTH_LON, -36.8485, 174.7633)
    assert 13500.0 < dist_nz < 15000.0
    segs_nz = great_circle_segments(HOME_QTH_LAT, HOME_QTH_LON, -36.8485, 174.7633, steps=48)
    assert len(segs_nz) == 2, "Expected trans-Pacific great-circle path to split cleanly across ±180° dateline"

    # 6. Verify Offscreen Cairo Rendering (Analog Dials + Strip-Chart + World Radar Map)
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1100, 650)
    cr = cairo.Context(surf)
    _, _, dmarks = choose_throughput_scale(12_000_000.0)
    NetCairoRenderer.draw_analog_dial(
        cr, 0, 0, 230, 184, "RX THROUGHPUT", "Mbps (0-100M)", 0.42, 0.68,
        dmarks, (0.8, 1.0), False, "42.00 Mbps", "PK 68.0M | 3800 pkt/s",
        [("RX ACT", (0.2, 0.95, 0.6), True), ("PEAK", (0.95, 0.2, 0.2), False)], 1,
    )
    NetCairoRenderer.draw_analog_dial(
        cr, 236, 0, 230, 184, "TX THROUGHPUT", "Mbps (0-10M)", 0.28, 0.50,
        dmarks, (0.8, 1.0), True, "2.80 Mbps", "PK 5.0M | 410 pkt/s",
        [("TX ACT", (1.0, 0.7, 0.2), True), ("ERR", (0.95, 0.2, 0.2), False)], 2,
    )
    rx_dq = collections.deque([1_000_000.0 * ((i % 9) + 1) for i in range(60)], maxlen=120)
    tx_dq = collections.deque([400_000.0 * ((i % 5) + 1) for i in range(60)], maxlen=120)
    NetCairoRenderer.draw_phosphor_stripchart(cr, 480, 0, 380, 96, rx_dq, tx_dq, 6_400_000.0, 1_200_000.0)

    surf_map = cairo.ImageSurface(cairo.FORMAT_ARGB32, 680, 360)
    cr_map = cairo.Context(surf_map)
    demo_hops = build_demo_hops("kiwisdr.com")
    hits = NetCairoRenderer.draw_world_radar(
        cr_map, 680, 360, demo_hops, 3, False, 0.35, "kiwisdr.com", "PING kiwisdr.com: 158.2ms"
    )
    assert len(hits) >= 5
    buf = surf.get_data()
    assert sum(buf[:4096]) > 0 and sum(surf_map.get_data()[:4096]) > 0

    print("DTNET_SELF_TEST_OK")
    return 0


def main() -> int:
    if "--self-test" in sys.argv:
        return run_self_test()
    ok, _ = Gtk.init_check(sys.argv)
    if not ok:
        sys.stderr.write("dtNet: Unable to initialize X11/GTK display (use --self-test for headless check).\n")
        return 1
    win = DtNetWindow()
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
