def fmt_bits_rate(bps_bits: float) -> str:
    if bps_bits >= 1_000_000_000.0:
        return f"{bps_bits / 1_000_000_000.0:5.2f} Gbps"
    if bps_bits >= 1_000_000.0:
        return f"{bps_bits / 1_000_000.0:5.2f} Mbps"
    if bps_bits >= 1_000.0:
        return f"{bps_bits / 1_000.0:5.1f} Kbps"
    return f"{bps_bits:5.0f} bps"


def fmt_bits_short(bps_bits: float) -> str:
    if bps_bits >= 1_000_000.0:
        return f"{bps_bits / 1_000_000.0:.2f}M"
    if bps_bits >= 1_000.0:
        return f"{bps_bits / 1_000.0:.1f}K"
    return f"{int(bps_bits)}b"


def fmt_bytes_gib(nbytes: float) -> str:
    if nbytes >= 1024.0 ** 3:
        return f"{nbytes / (1024.0 ** 3):.2f} GiB"
    if nbytes >= 1024.0 ** 2:
        return f"{nbytes / (1024.0 ** 2):.1f} MiB"
    if nbytes >= 1024.0:
        return f"{nbytes / 1024.0:.0f} KiB"
    return f"{int(nbytes)} B"


def choose_throughput_scale(max_bits_per_sec: float) -> tuple[float, str, list[tuple[float, str, bool]]]:
    """Return (ceiling_bps, unit_label, dial_marks) for auto-ranging Kbps / Mbps dials."""
    tiers = [
        (100_000.0, "Kbps (0-100K)", [(0.0, "0", False), (0.2, "20", False), (0.4, "40", False), (0.6, "60", False), (0.8, "80", True), (1.0, "100", True)]),
        (1_000_000.0, "Kbps (0-1000K)", [(0.0, "0", False), (0.2, "200", False), (0.4, "400", False), (0.6, "600", False), (0.8, "800", True), (1.0, "1M", True)]),
        (10_000_000.0, "Mbps (0-10M)", [(0.0, "0", False), (0.2, "2", False), (0.4, "4", False), (0.6, "6", False), (0.8, "8", True), (1.0, "10", True)]),
        (100_000_000.0, "Mbps (0-100M)", [(0.0, "0", False), (0.2, "20", False), (0.4, "40", False), (0.6, "60", False), (0.8, "80", True), (1.0, "100", True)]),
        (1_000_000_000.0, "Mbps (0-1G)", [(0.0, "0", False), (0.2, "200", False), (0.4, "400", False), (0.6, "600", False), (0.8, "800", True), (1.0, "1G", True)]),
    ]
    for ceil_bps, ulbl, marks in tiers:
        if max_bits_per_sec <= ceil_bps * 0.92:
            return ceil_bps, ulbl, marks
    return tiers[-1]


def haversine_km(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    r_earth = 6371.0
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dp = math.radians(lat2 - lat1)
    dl = math.radians(lon2 - lon1)
    a = math.sin(dp * 0.5) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl * 0.5) ** 2
    return 2.0 * r_earth * math.asin(min(1.0, math.sqrt(max(0.0, a))))


def great_circle_segments(
    lat1: float, lon1: float, lat2: float, lon2: float, steps: int = 48
) -> list[list[tuple[float, float]]]:
    """
    Compute spherical great-circle path from (lat1, lon1) to (lat2, lon2) as a list
    of (lon, lat) polyline segments split cleanly across the ±180° antimeridian.
    """
    phi1, lam1 = math.radians(lat1), math.radians(lon1)
    phi2, lam2 = math.radians(lat2), math.radians(lon2)

    def to_xyz(p: float, l: float) -> tuple[float, float, float]:
        cp = math.cos(p)
        return cp * math.cos(l), cp * math.sin(l), math.sin(p)

    v1 = to_xyz(phi1, lam1)
    v2 = to_xyz(phi2, lam2)
    dot = max(-1.0, min(1.0, v1[0] * v2[0] + v1[1] * v2[1] + v1[2] * v2[2]))
    omega = math.acos(dot)

    raw_pts: list[tuple[float, float]] = []
    if omega < 1e-5:
        return [[(lon1, lat1), (lon2, lat2)]]

    sin_om = math.sin(omega)
    for i in range(steps + 1):
        f = i / float(steps)
        if abs(sin_om) < 1e-6:
            x = (1.0 - f) * v1[0] + f * v2[0]
            y = (1.0 - f) * v1[1] + f * v2[1]
            z = (1.0 - f) * v1[2] + f * v2[2]
            norm = math.hypot(math.hypot(x, y), z) or 1.0
            x, y, z = x / norm, y / norm, z / norm
        else:
            a = math.sin((1.0 - f) * omega) / sin_om
            b = math.sin(f * omega) / sin_om
            x = a * v1[0] + b * v2[0]
            y = a * v1[1] + b * v2[1]
            z = a * v1[2] + b * v2[2]
        lat = math.degrees(math.atan2(z, math.hypot(x, y)))
        lon = math.degrees(math.atan2(y, x))
        raw_pts.append((lon, lat))

    # Split polyline cleanly whenever longitude jumps across ±180° dateline
    segments: list[list[tuple[float, float]]] = []
    cur: list[tuple[float, float]] = [raw_pts[0]]
    for prev, nxt in zip(raw_pts, raw_pts[1:]):
        dlon = nxt[0] - prev[0]
        if abs(dlon) > 180.0:
            if prev[0] > 0 and nxt[0] < 0:
                rem = 180.0 - prev[0]
                span = rem + (nxt[0] + 180.0)
                t = rem / span if span > 1e-6 else 0.5
                mid_lat = prev[1] + t * (nxt[1] - prev[1])
                cur.append((180.0, mid_lat))
                segments.append(cur)
                cur = [(-180.0, mid_lat), nxt]
            else:
                rem = prev[0] + 180.0
                span = rem + (180.0 - nxt[0])
                t = rem / span if span > 1e-6 else 0.5
                mid_lat = prev[1] + t * (nxt[1] - prev[1])
                cur.append((-180.0, mid_lat))
                segments.append(cur)
                cur = [(180.0, mid_lat), nxt]
        else:
            cur.append(nxt)
    if len(cur) >= 2:
        segments.append(cur)
    return segments


def is_private_or_local_ip(ip: str) -> bool:
    try:
        packed = socket.inet_aton(ip)
        b0, b1, _, _ = packed
        if b0 in (0, 10, 127):
            return True
        if b0 == 169 and b1 == 254:
            return True
        if b0 == 172 and 16 <= b1 <= 31:
            return True
        if b0 == 192 and b1 == 168:
            return True
        if b0 == 100 and 64 <= b1 <= 127:
            return True
    except OSError:
        if ip.startswith(("fe80:", "fc", "fd", "::1")):
            return True
    return False


