    def _refresh_sockets(self):
        inode_map = scan_inode_to_process_map()
        rows: list[dict] = []
        for path_s, proto_lbl, v6 in [
            ("/proc/net/tcp", "TCP", False),
            ("/proc/net/tcp6", "TCP6", True),
            ("/proc/net/udp", "UDP", False),
            ("/proc/net/udp6", "UDP6", True),
        ]:
            p = Path(path_s)
            if p.is_file():
                try:
                    txt = p.read_text(encoding="utf-8", errors="replace")
                    rows.extend(parse_proc_net_sockets_text(txt, proto_lbl, is_ipv6=v6))
                except OSError:
                    continue

        for r in rows:
            r["proc"] = inode_map.get(r["inode"], f"uid:{r['uid']}" if r["inode"] != "0" else "-")

        state_rank = {"LISTEN": 0, "ESTABLISHED": 1, "SYN_SENT": 2, "CLOSE_WAIT": 3, "TIME_WAIT": 4}
        rows.sort(key=lambda r: (state_rank.get(r["state"], 5), r["proto"], r["lport"]))
        self._all_sockets = rows

        n_listen = sum(1 for r in rows if r["state"] == "LISTEN")
        n_estab = sum(1 for r in rows if r["state"] == "ESTABLISHED")
        n_udp = sum(1 for r in rows if r["proto"].startswith("UDP"))
        self.lbl_sock_counts.set_text(f"TOTAL: {len(rows)}  |  LISTEN: {n_listen}  |  ESTAB: {n_estab}  |  UDP: {n_udp}")
        self._populate_socket_tree()

    def _populate_socket_tree(self):
        self.sock_store.clear()
        q = self.ent_sock_search.get_text().strip().lower()
        flt = self._sock_filter
        idx = 0
        for r in self._all_sockets:
            if flt == "LISTEN" and r["state"] != "LISTEN":
                continue
            if flt == "ESTABLISHED" and r["state"] != "ESTABLISHED":
                continue
            if flt == "TCP" and not r["proto"].startswith("TCP"):
                continue
            if flt == "UDP" and not r["proto"].startswith("UDP"):
                continue
            if q:
                blob = f"{r['proto']} {r['state']} {r['local']} {r['remote']} {r['service']} {r['proc']}".lower()
                if q not in blob:
                    continue
            bg = "#eaf4ea" if idx % 2 == 1 else "#f7fbf6"
            idx += 1
            self.sock_store.append([r["proto"], r["state"], r["local"], r["remote"], r["service"], r["queue"], r["proc"], bg])

