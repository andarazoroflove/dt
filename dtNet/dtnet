def parse_proc_net_dev_text(text: str) -> dict[str, dict[str, int]]:
    """Parse /proc/net/dev contents into per-interface counter dicts."""
    out: dict[str, dict[str, int]] = {}
    for ln in text.splitlines()[2:]:
        if ":" not in ln:
            continue
        iface_part, stats_part = ln.split(":", 1)
        iface = iface_part.strip()
        cols = stats_part.split()
        if len(cols) < 16:
            continue
        out[iface] = {
            "rx_bytes": int(cols[0]),
            "rx_packets": int(cols[1]),
            "rx_errs": int(cols[2]),
            "rx_drop": int(cols[3]),
            "tx_bytes": int(cols[8]),
            "tx_packets": int(cols[9]),
            "tx_errs": int(cols[10]),
            "tx_drop": int(cols[11]),
            "tx_colls": int(cols[13]),
        }
    return out


def parse_proc_net_wireless_text(text: str) -> dict[str, dict[str, float]]:
    """Parse /proc/net/wireless for link quality (0..70 -> %) and signal level (dBm)."""
    out: dict[str, dict[str, float]] = {}
    for ln in text.splitlines()[2:]:
        if ":" not in ln:
            continue
        iface_part, rest = ln.split(":", 1)
        iface = iface_part.strip()
        cols = rest.split()
        if len(cols) < 4:
            continue
        try:
            link_raw = float(cols[1].rstrip("."))
            level_dbm = float(cols[2].rstrip("."))
            noise_dbm = float(cols[3].rstrip("."))
            if level_dbm > 0:
                level_dbm -= 256.0
            if noise_dbm > 0:
                noise_dbm -= 256.0
            qual_pct = max(0.0, min(100.0, (link_raw / 70.0) * 100.0 if link_raw <= 70.0 else link_raw))
            out[iface] = {
                "link_raw": link_raw,
                "qual_pct": qual_pct,
                "level_dbm": level_dbm,
                "noise_dbm": noise_dbm,
            }
        except ValueError:
            continue
    return out


def decode_hex_addr_port(hex_pair: str, is_ipv6: bool = False) -> tuple[str, int]:
    """Decode /proc/net/tcp or tcp6 'HEXADDR:HEXPORT' into human-readable (ip_str, port)."""
    addr_hex, port_hex = hex_pair.strip().split(":")
    port = int(port_hex, 16)
    if not is_ipv6:
        val = int(addr_hex, 16)
        raw4 = struct.pack("<I", val)
        return socket.inet_ntoa(raw4), port
    # Linux /proc/net/tcp6 stores 4 x 32-bit words in host (little-endian) byte order
    words = [int(addr_hex[i : i + 8], 16) for i in range(0, 32, 8)]
    raw16 = struct.pack("<4I", *words)
    ip6 = socket.inet_ntop(socket.AF_INET6, raw16)
    return ip6, port


def format_endpoint(ip: str, port: int, is_ipv6: bool) -> str:
    p_str = "*" if port == 0 else str(port)
    if is_ipv6:
        return f"[{ip}]:{p_str}"
    return f"{ip}:{p_str}"


def port_service_name(port: int, proto: str = "tcp") -> str:
    if port == 0:
        return "-"
    if port in WELL_KNOWN_PORTS:
        return WELL_KNOWN_PORTS[port]
    try:
        return socket.getservbyport(port, "udp" if "udp" in proto.lower() else "tcp")
    except OSError:
        return "-"


def parse_proc_net_sockets_text(text: str, proto_label: str, is_ipv6: bool = False) -> list[dict]:
    """Parse /proc/net/{tcp,tcp6,udp,udp6} text into structured socket rows."""
    rows: list[dict] = []
    is_udp = proto_label.upper().startswith("UDP")
    for ln in text.splitlines()[1:]:
        cols = ln.split()
        if len(cols) < 10 or ":" not in cols[1] or ":" not in cols[2]:
            continue
        try:
            lip, lport = decode_hex_addr_port(cols[1], is_ipv6=is_ipv6)
            rip, rport = decode_hex_addr_port(cols[2], is_ipv6=is_ipv6)
            st_hex = cols[3].upper()
            if is_udp:
                if st_hex == "01":
                    state = "ESTABLISHED"
                elif st_hex == "07":
                    state = "LISTEN" if lport > 0 else "UNCONN"
                else:
                    state = TCP_STATES.get(st_hex, f"0x{st_hex}")
            else:
                state = TCP_STATES.get(st_hex, f"0x{st_hex}")

            q_parts = cols[4].split(":")
            tx_q = int(q_parts[0], 16) if len(q_parts) == 2 else 0
            rx_q = int(q_parts[1], 16) if len(q_parts) == 2 else 0
            uid = int(cols[7])
            inode = cols[9]
            svc = port_service_name(lport if state == "LISTEN" or rport == 0 else rport, proto_label)
            if svc == "-" and lport > 0:
                svc = port_service_name(lport, proto_label)

            rows.append({
                "proto": proto_label,
                "state": state,
                "lip": lip,
                "lport": lport,
                "rip": rip,
                "rport": rport,
                "local": format_endpoint(lip, lport, is_ipv6),
                "remote": format_endpoint(rip, rport, is_ipv6),
                "service": svc,
                "queue": f"{tx_q}:{rx_q}",
                "uid": uid,
                "inode": inode,
                "proc": "-",
            })
        except Exception:
            continue
    return rows


def scan_inode_to_process_map() -> dict[str, str]:
    """Pure-Python /proc/[pid]/fd symlink scanner mapping socket inodes -> 'PID/comm'."""
    inode_map: dict[str, str] = {}
    try:
        for entry in os.scandir("/proc"):
            if not entry.name.isdigit():
                continue
            pid = entry.name
            fd_dir = f"/proc/{pid}/fd"
            try:
                fd_entries = os.scandir(fd_dir)
            except OSError:
                continue
            comm = ""
            with fd_entries:
                for fde in fd_entries:
                    try:
                        target = os.readlink(fde.path)
                    except OSError:
                        continue
                    if target.startswith("socket:[") and target.endswith("]"):
                        ino = target[8:-1]
                        if not comm:
                            try:
                                comm = Path(f"/proc/{pid}/comm").read_text(encoding="utf-8", errors="replace").strip()
                            except OSError:
                                comm = "proc"
                        inode_map[ino] = f"{pid}/{comm}"
    except OSError:
        pass
    return inode_map


def parse_proc_net_arp_text(text: str) -> list[dict[str, str]]:
    """Parse /proc/net/arp into neighbor dicts."""
    out: list[dict[str, str]] = []
    for ln in text.splitlines()[1:]:
        cols = ln.split()
        if len(cols) < 6:
            continue
        ip_addr, _hw_type, flags, mac, _mask, dev = cols[:6]
        mac_up = mac.upper()
        if mac_up == "00:00:00:00:00:00" and flags == "0x0":
            continue
        oui = mac_up[:8]
        vendor = OUI_HINTS.get(oui, "")
        out.append({
            "ip": ip_addr,
            "flags": flags,
            "mac": mac_up,
            "dev": dev,
            "vendor": vendor,
        })
    return out


# ---------------------------------------------------------------------------
# Traceroute / Tracepath / Rootless `ping -t <ttl>` Parser Helpers
# ---------------------------------------------------------------------------
IP4_RE = re.compile(r"\b((?:\d{1,3}\.){3}\d{1,3})\b")
RTT_MS_RE = re.compile(r"(\d+(?:\.\d+)?)\s*ms", re.IGNORECASE)
PING_TTL_FROM_RE = re.compile(r"[Ff]rom\s+((?:\d{1,3}\.){3}\d{1,3}).*?(?:exceeded|ttl)", re.IGNORECASE)
PING_REPLY_RE = re.compile(r"bytes\s+from\s+((?:\d{1,3}\.){3}\d{1,3}).*?time[=<](\d+(?:\.\d+)?)\s*ms", re.IGNORECASE)


def parse_traceroute_line(line: str) -> tuple[int, str, float | None] | None:
    """
    Parse a single output line from `traceroute -n` or `tracepath -n`.
    Returns (hop_num, ip_or_star, avg_rtt_ms_or_None) or None if header/noise.
    """
    s = line.strip()
    if not s or s.lower().startswith(("traceroute to", "resume:", "too many hops")):
        return None
    m_hop = re.match(r"^(\d+)\s*:?\s+(.*)$", s)
    if not m_hop:
        return None
    hop_num = int(m_hop.group(1))
    rest = m_hop.group(2).strip()
    if rest.startswith("no reply") or re.fullmatch(r"[\*\s!NHXP]+", rest):
        return hop_num, "*", None
    m_ip = IP4_RE.search(rest)
    if not m_ip:
        return None
    ip_addr = m_ip.group(1)
    rtts = [float(x) for x in RTT_MS_RE.findall(rest)]
    avg_rtt = sum(rtts) / len(rtts) if rtts else None
    return hop_num, ip_addr, avg_rtt


def parse_ping_ttl_output(output: str, elapsed_ms: float) -> tuple[str, float | None, bool]:
    """
    Parse output from `ping -n -t <ttl> -c 1 -W 1 <target>`.
    Returns (hop_ip_or_star, rtt_ms, reached_destination).
    """
    m_rep = PING_REPLY_RE.search(output)
    if m_rep:
        return m_rep.group(1), float(m_rep.group(2)), True
    m_ttl = PING_TTL_FROM_RE.search(output)
    if m_ttl:
        m_ms = RTT_MS_RE.search(output)
        rtt = float(m_ms.group(1)) if m_ms else max(0.2, elapsed_ms)
        return m_ttl.group(1), rtt, False
    return "*", None, False


