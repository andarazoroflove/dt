class IpGeoResolver:
    """Thread-safe IP geolocation resolver backed by ~/.cache/dtnet/ipgeo.json + ip-api.com/batch."""

    def __init__(self):
        self._lock = threading.Lock()
        self._cache: dict[str, dict] = dict(SEED_GEO_DB)
        self._load_disk_cache()

    def _load_disk_cache(self):
        try:
            if IPGEO_CACHE_FILE.is_file():
                data = json.loads(IPGEO_CACHE_FILE.read_text(encoding="utf-8"))
                if isinstance(data, dict):
                    self._cache.update(data)
        except Exception:
            pass

    def _save_disk_cache(self):
        try:
            CACHE_DIR.mkdir(parents=True, exist_ok=True)
            IPGEO_CACHE_FILE.write_text(json.dumps(self._cache, indent=2), encoding="utf-8")
        except Exception:
            pass

    def resolve_many(self, ips: list[str]) -> dict[str, dict]:
        out: dict[str, dict] = {}
        to_query: list[str] = []

        with self._lock:
            for ip in ips:
                if not ip or ip == "*":
                    continue
                if is_private_or_local_ip(ip):
                    out[ip] = {
                        "lat": HOME_QTH_LAT + 0.04,
                        "lon": HOME_QTH_LON + 0.05,
                        "city": "Local LAN / Gateway",
                        "cc": "LAN",
                        "isp": "RFC1918 Local Hop",
                        "asn": "LOCAL",
                    }
                elif ip in self._cache:
                    out[ip] = self._cache[ip]
                else:
                    to_query.append(ip)

        if to_query:
            unique_q = list(dict.fromkeys(to_query))[:90]
            payload = json.dumps(
                [{"query": q, "fields": "status,query,lat,lon,city,region,countryCode,isp,as"} for q in unique_q]
            ).encode("utf-8")
            req = urllib.request.Request(
                "http://ip-api.com/batch",
                data=payload,
                headers={"Content-Type": "application/json", "User-Agent": UA},
                method="POST",
            )
            fetched: dict[str, dict] = {}
            try:
                with urllib.request.urlopen(req, timeout=3.2) as resp:
                    arr = json.loads(resp.read().decode("utf-8", errors="replace"))
                    if isinstance(arr, list):
                        for item in arr:
                            if isinstance(item, dict) and item.get("status") == "success":
                                qip = str(item.get("query", ""))
                                city = item.get("city") or item.get("region") or "Transit"
                                cc = item.get("countryCode") or ""
                                asn = item.get("as") or item.get("isp") or "ISP"
                                fetched[qip] = {
                                    "lat": float(item.get("lat", HOME_QTH_LAT)),
                                    "lon": float(item.get("lon", HOME_QTH_LON)),
                                    "city": str(city),
                                    "cc": str(cc),
                                    "isp": str(item.get("isp", "")),
                                    "asn": str(asn)[:34],
                                }
            except Exception:
                pass

            if fetched:
                with self._lock:
                    self._cache.update(fetched)
                    self._save_disk_cache()
                out.update(fetched)

            # Heuristic fallback if offline / rate-limited so hops still plot cleanly
            for qip in unique_q:
                if qip not in out:
                    try:
                        b0 = int(qip.split(".")[0])
                    except Exception:
                        b0 = sum(ord(c) for c in qip)
                    anchor = OFFLINE_IXP_ANCHORS[b0 % len(OFFLINE_IXP_ANCHORS)]
                    out[qip] = {
                        "lat": anchor[0],
                        "lon": anchor[1],
                        "city": f"{anchor[2]} (est.)",
                        "cc": anchor[3],
                        "isp": anchor[4],
                        "asn": "Offline Geo Est.",
                    }
        return out


