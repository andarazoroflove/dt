    def _trace_worker(self, target: str, mode: str):
        try:
            dest_ip = socket.gethostbyname(target)
        except OSError as exc:
            GLib.idle_add(
                self._finish_trace,
                f"DNS / NETWORK OFFLINE ({exc}) — click [DEMO ARC] to preview world radar offline.",
            )
            return

        collected: list[tuple[int, str, float | None]] = []

        def push_hop(hnum: int, hip: str, rtt: float | None):
            collected.append((hnum, hip, rtt))
            if hip != "*":
                gmap = self.geo.resolve_many([hip])
                g = gmap.get(hip, {"lat": HOME_QTH_LAT, "lon": HOME_QTH_LON, "city": "Unknown", "cc": "", "asn": "-"})
                dkm = haversine_km(HOME_QTH_LAT, HOME_QTH_LON, g["lat"], g["lon"])
                hop_obj = TraceHop(hnum, hip, rtt, g["lat"], g["lon"], g["city"], g["cc"], g["asn"], dkm, True)
            else:
                hop_obj = TraceHop(hnum, "*", None, HOME_QTH_LAT, HOME_QTH_LON, "", "", "-", 0.0, False)
            GLib.idle_add(self._append_live_hop, hop_obj)

        used_external = False
        if mode in ("AUTO", "TRACEROUTE") and shutil.which("traceroute"):
            used_external = self._run_cmd_traceroute(["traceroute", "-n", "-q", "2", "-w", "1", "-m", "24", dest_ip], push_hop)
        if not used_external and not collected and mode in ("AUTO", "TRACEPATH") and shutil.which("tracepath"):
            used_external = self._run_cmd_traceroute(["tracepath", "-n", "-m", "24", dest_ip], push_hop)

        # Universal zero-privilege Linux fallback: `ping -n -t <ttl> -c 1 -W 1`
        if not collected and not self._trace_stop.is_set() and shutil.which("ping"):
            consecutive_stars = 0
            for ttl in range(1, 25):
                if self._trace_stop.is_set():
                    break
                t0 = time.monotonic()
                try:
                    proc = subprocess.run(
                        ["ping", "-n", "-t", str(ttl), "-c", "1", "-W", "1", dest_ip],
                        capture_output=True, text=True, timeout=1.6,
                    )
                    out = (proc.stdout or "") + "\n" + (proc.stderr or "")
                except Exception as exc:
                    out = str(exc)
                elapsed_ms = (time.monotonic() - t0) * 1000.0
                if "Network is unreachable" in out or "Invalid argument" in out and ttl == 1:
                    break
                hip, rtt, reached = parse_ping_ttl_output(out, elapsed_ms)
                push_hop(ttl, hip, rtt)
                if reached or hip == dest_ip:
                    break
                consecutive_stars = consecutive_stars + 1 if hip == "*" else 0
                if consecutive_stars >= 6 and ttl >= 12:
                    break

        if not collected:
            GLib.idle_add(
                self._finish_trace,
                f"NETWORK UNREACHABLE TO {dest_ip} — click [DEMO ARC] to preview world traceroute arcs.",
            )
        else:
            GLib.idle_add(
                self._finish_trace,
                f"TRACE COMPLETE: {target} ({dest_ip}) — {len(collected)} hops mapped from {HOME_QTH_NAME}",
            )

    def _run_cmd_traceroute(self, cmd: list[str], push_hop) -> bool:
        got_any_ip = False
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            assert proc.stdout is not None
            for ln in proc.stdout:
                if self._trace_stop.is_set():
                    proc.terminate()
                    break
                parsed = parse_traceroute_line(ln)
                if parsed:
                    hnum, hip, rtt = parsed
                    if hip != "*":
                        got_any_ip = True
                    push_hop(hnum, hip, rtt)
            proc.wait(timeout=1.5)
        except Exception:
            return False
        return got_any_ip

    def _append_live_hop(self, hop_obj: TraceHop):
        self.trace_hops = [h for h in self.trace_hops if h.hop != hop_obj.hop] + [hop_obj]
        self.trace_hops.sort(key=lambda x: x.hop)
        if hop_obj.rtt_ms is not None:
