@dataclass
class TraceHop:
    hop: int
    ip: str
    rtt_ms: float | None
    lat: float
    lon: float
    city: str
    cc: str
    asn: str
    dist_km: float
    has_geo: bool = True


class NetCairoRenderer:
    """Shared Cairo renderer for Top Analog Dials, Strip-Chart, World Radar & Self-Test."""

    @staticmethod
    def draw_screw(cr: cairo.Context, cx: float, cy: float, r: float, angle: float, brass: bool = True):
        cr.new_sub_path()
        cr.arc(cx + 0.6, cy + 0.6, r + 0.7, 0, 2 * math.pi)
        cr.set_source_rgba(0.03, 0.04, 0.05, 0.75)
        cr.fill()
        pat = cairo.LinearGradient(cx - r, cy - r, cx + r, cy + r)
        if brass:
            pat.add_color_stop_rgb(0.0, 0.88, 0.74, 0.44)
            pat.add_color_stop_rgb(1.0, 0.42, 0.32, 0.14)
        else:
            pat.add_color_stop_rgb(0.0, 0.76, 0.80, 0.86)
            pat.add_color_stop_rgb(1.0, 0.28, 0.31, 0.38)
        cr.new_sub_path()
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.set_source(pat)
        cr.fill()
        cr.set_line_width(max(1.0, r * 0.42))
        cr.set_source_rgb(0.14, 0.15, 0.18)
        cr.move_to(cx - (r * 0.72) * math.cos(angle), cy - (r * 0.72) * math.sin(angle))
        cr.line_to(cx + (r * 0.72) * math.cos(angle), cy + (r * 0.72) * math.sin(angle))
        cr.stroke()

    @staticmethod
    def draw_jewel_lamp(
        cr: cairo.Context,
        cx: float,
        cy: float,
        r: float,
        rgb: tuple[float, float, float],
        lit: bool,
        label: str = "",
        dark_face: bool = False,
    ):
        cr.new_sub_path()
        cr.arc(cx, cy, r + 1.6, 0, 2 * math.pi)
        cr.set_source_rgb(0.20, 0.22, 0.26)
        cr.fill()
        cr.new_sub_path()
        cr.arc(cx, cy, r + 0.8, 0, 2 * math.pi)
        cr.set_source_rgb(0.66, 0.70, 0.76)
        cr.fill()

        if lit:
            glow = cairo.RadialGradient(cx, cy, r * 0.2, cx, cy, r * 2.3)
            glow.add_color_stop_rgba(0.0, rgb[0], rgb[1], rgb[2], 0.48)
            glow.add_color_stop_rgba(1.0, rgb[0], rgb[1], rgb[2], 0.0)
            cr.arc(cx, cy, r * 2.3, 0, 2 * math.pi)
            cr.set_source(glow)
            cr.fill()

            gem = cairo.RadialGradient(cx - r * 0.3, cy - r * 0.3, r * 0.1, cx, cy, r)
            gem.add_color_stop_rgb(0.0, min(1.0, rgb[0] + 0.35), min(1.0, rgb[1] + 0.35), min(1.0, rgb[2] + 0.35))
            gem.add_color_stop_rgb(0.7, rgb[0], rgb[1], rgb[2])
            gem.add_color_stop_rgb(1.0, rgb[0] * 0.42, rgb[1] * 0.42, rgb[2] * 0.42)
            cr.arc(cx, cy, r, 0, 2 * math.pi)
            cr.set_source(gem)
            cr.fill()
            cr.arc(cx - r * 0.3, cy - r * 0.3, r * 0.26, 0, 2 * math.pi)
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.75)
            cr.fill()
        else:
            cr.arc(cx, cy, r, 0, 2 * math.pi)
            cr.set_source_rgb(rgb[0] * 0.22, rgb[1] * 0.22, rgb[2] * 0.22)
            cr.fill()

        if label:
            cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(7.2)
            if dark_face:
                cr.set_source_rgb(0.72, 0.92, 0.80) if lit else cr.set_source_rgb(0.42, 0.54, 0.48)
            else:
                cr.set_source_rgb(0.16, 0.12, 0.08) if lit else cr.set_source_rgb(0.38, 0.32, 0.24)
            cr.move_to(cx + r + 3.2, cy + 2.6)
            cr.show_text(label)

    @staticmethod
    def draw_vfd_inset(
        cr: cairo.Context, x: float, y: float, w: float, h: float, line1: str, line2: str, amber_vfd: bool = False
    ):
        cr.rectangle(x, y, w, h)
        cr.set_source_rgb(0.09, 0.06, 0.03) if amber_vfd else cr.set_source_rgb(0.04, 0.08, 0.08)
        cr.fill()

        cr.set_line_width(1.2)
        cr.set_source_rgb(0.01, 0.02, 0.02)
        cr.move_to(x, y + h)
        cr.line_to(x, y)
        cr.line_to(x + w, y)
        cr.stroke()
        cr.set_source_rgb(0.36, 0.40, 0.48)
        cr.move_to(x, y + h)
        cr.line_to(x + w, y + h)
        cr.line_to(x + w, y)
        cr.stroke()

        c_main = (1.00, 0.74, 0.24) if amber_vfd else (0.28, 0.98, 0.85)
        c_sub = (0.88, 0.62, 0.22) if amber_vfd else (0.48, 0.88, 0.78)

        cr.save()
        cr.rectangle(x + 2, y + 1, w - 4, h - 2)
        cr.clip()
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(9.6)
        ext1 = cr.text_extents(line1)
        tx1 = x + max(3.0, (w - ext1.width) * 0.5)
        cr.set_source_rgba(c_main[0], c_main[1], c_main[2], 0.22)
        cr.move_to(tx1 + 0.7, y + 11.8)
        cr.show_text(line1)
        cr.set_source_rgb(*c_main)
        cr.move_to(tx1, y + 11.2)
        cr.show_text(line1)

        cr.set_font_size(7.7)
        ext2 = cr.text_extents(line2)
        tx2 = x + max(3.0, (w - ext2.width) * 0.5)
        cr.set_source_rgb(*c_sub)
        cr.move_to(tx2, y + h - 3.8)
        cr.show_text(line2)
        cr.restore()

    @classmethod
    def draw_analog_dial(
        cls,
        cr: cairo.Context,
        x: float,
        y: float,
        w: float,
        h: float,
        title: str,
        unit_lbl: str,
        norm_val: float,
        peak_norm: float | None,
        marks: list[tuple[float, str, bool]],
        red_span: tuple[float, float] | None,
        dark_phosphor: bool,
        vfd_l1: str,
        vfd_l2: str,
        lamps: list[tuple[str, tuple[float, float, float], bool]],
        screw_seed: int = 0,
    ):
        bezel_pat = cairo.LinearGradient(x, y, x, y + h)
        if dark_phosphor:
            bezel_pat.add_color_stop_rgb(0.0, 0.29, 0.33, 0.39)
            bezel_pat.add_color_stop_rgb(0.5, 0.19, 0.22, 0.27)
            bezel_pat.add_color_stop_rgb(1.0, 0.12, 0.14, 0.18)
        else:
            bezel_pat.add_color_stop_rgb(0.0, 0.52, 0.46, 0.35)
            bezel_pat.add_color_stop_rgb(0.5, 0.36, 0.32, 0.25)
            bezel_pat.add_color_stop_rgb(1.0, 0.21, 0.19, 0.15)
        cr.rectangle(x, y, w, h)
        cr.set_source(bezel_pat)
        cr.fill()

        # Outer 3D Motif bevel
        cr.set_line_width(1.5)
        cr.set_source_rgb(0.50, 0.56, 0.65) if dark_phosphor else cr.set_source_rgb(0.68, 0.64, 0.52)
        cr.move_to(x + 0.8, y + h - 0.8)
        cr.line_to(x + 0.8, y + 0.8)
        cr.line_to(x + w - 0.8, y + 0.8)
        cr.stroke()
        cr.set_source_rgb(0.08, 0.09, 0.11)
        cr.move_to(x + 0.8, y + h - 0.8)
        cr.line_to(x + w - 0.8, y + h - 0.8)
        cr.line_to(x + w - 0.8, y + 0.8)
        cr.stroke()

        # 4 Corner Screws
        for (sx, sy), ang in zip(
            [(x + 7.0, y + 7.0), (x + w - 7.0, y + 7.0), (x + 7.0, y + h - 7.0), (x + w - 7.0, y + h - 7.0)],
            (0.4 + screw_seed * 0.3, -0.6 + screw_seed * 0.2, 1.1 - screw_seed * 0.25, -0.2 + screw_seed * 0.35),
        ):
            cls.draw_screw(cr, sx, sy, 3.2, ang, brass=not dark_phosphor)

        # Top Engraved Nameplate
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.2)
        ext_t = cr.text_extents(title)
        cr.set_source_rgb(0.74, 0.96, 0.86) if dark_phosphor else cr.set_source_rgb(0.96, 0.92, 0.78)
        cr.move_to(x + (w - ext_t.width) * 0.5, y + 11.2)
        cr.show_text(title)

        # Dial Face
        mx, my = x + 8.0, y + 15.0
        mw, mh = w - 16.0, h - 22.0
        if dark_phosphor:
            fpat = cairo.RadialGradient(mx + mw * 0.5, my + mh * 0.45, 5.0, mx + mw * 0.5, my + mh * 0.5, mw * 0.72)
            fpat.add_color_stop_rgb(0.0, 0.07, 0.15, 0.13)
            fpat.add_color_stop_rgb(0.65, 0.04, 0.08, 0.08)
            fpat.add_color_stop_rgb(1.0, 0.02, 0.04, 0.05)
        else:
            fpat = cairo.RadialGradient(mx + mw * 0.5, my + 5.0, 6.0, mx + mw * 0.5, my + mh * 0.55, mw * 0.76)
            fpat.add_color_stop_rgb(0.0, 1.00, 0.96, 0.82)
            fpat.add_color_stop_rgb(0.58, 0.98, 0.89, 0.66)
            fpat.add_color_stop_rgb(1.0, 0.86, 0.73, 0.48)
        cr.rectangle(mx, my, mw, mh)
        cr.set_source(fpat)
        cr.fill()

        # Inner Glass Shadow
        cr.set_line_width(1.4)
        cr.set_source_rgba(0.04, 0.03, 0.02, 0.65)
        cr.move_to(mx, my + mh)
        cr.line_to(mx, my)
        cr.line_to(mx + mw, my)
        cr.stroke()

        # Jewel Pilot Lamps
        if lamps:
            spacing = (mw - 14.0) / max(1, len(lamps))
            for idx, (lbl, col, lit) in enumerate(lamps):
                cls.draw_jewel_lamp(cr, mx + 11.0 + idx * spacing, my + 9.5, 3.2, col, lit, lbl, dark_face=dark_phosphor)

        # Radial Scale Geometry
        vfd_h = 26.0
        vfd_y = my + mh - vfd_h - 3.5
        piv_x = mx + mw * 0.5
        piv_y = vfd_y + 6.5
        arc_r = min(mw * 0.42, max(34.0, piv_y - (my + 24.0)))
        a0 = -math.pi * 0.81
        a1 = -math.pi * 0.19

        if red_span is not None:
            ra0 = a0 + red_span[0] * (a1 - a0)
            ra1 = a0 + red_span[1] * (a1 - a0)
            cr.new_sub_path()
            cr.set_line_width(3.6)
            cr.set_source_rgb(0.96, 0.26, 0.22) if dark_phosphor else cr.set_source_rgb(0.80, 0.14, 0.12)
            cr.arc(piv_x, piv_y, arc_r + 1.6, ra0, ra1)
            cr.stroke()

        # Scale baseline arc
        cr.new_sub_path()
        cr.set_line_width(1.3)
        cr.set_source_rgb(0.32, 0.94, 0.66) if dark_phosphor else cr.set_source_rgb(0.18, 0.14, 0.09)
        cr.arc(piv_x, piv_y, arc_r, a0, a1)
        cr.stroke()

        # Minor 20 subdivisions
        cr.set_line_width(0.85)
        cr.set_source_rgba(0.32, 0.86, 0.60, 0.70) if dark_phosphor else cr.set_source_rgba(0.24, 0.19, 0.12, 0.72)
        for i in range(21):
            ang = a0 + (i / 20.0) * (a1 - a0)
            cr.move_to(piv_x + (arc_r - 2.5) * math.cos(ang), piv_y + (arc_r - 2.5) * math.sin(ang))
            cr.line_to(piv_x + (arc_r + 2.2) * math.cos(ang), piv_y + (arc_r + 2.2) * math.sin(ang))
            cr.stroke()

        # Major ticks & labels
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(7.8)
        for frac, lbl, is_red in marks:
            ang = a0 + frac * (a1 - a0)
            if is_red:
                cr.set_source_rgb(1.00, 0.35, 0.30) if dark_phosphor else cr.set_source_rgb(0.78, 0.12, 0.10)
            else:
                cr.set_source_rgb(0.46, 0.98, 0.74) if dark_phosphor else cr.set_source_rgb(0.14, 0.11, 0.08)
            cr.set_line_width(1.5)
            cr.move_to(piv_x + (arc_r - 4.2) * math.cos(ang), piv_y + (arc_r - 4.2) * math.sin(ang))
            cr.line_to(piv_x + (arc_r + 4.4) * math.cos(ang), piv_y + (arc_r + 4.4) * math.sin(ang))
            cr.stroke()
            tx = piv_x + (arc_r + 11.6) * math.cos(ang)
            ty = piv_y + (arc_r + 11.6) * math.sin(ang)
            ext = cr.text_extents(lbl)
            cr.move_to(tx - ext.width * 0.5, ty + ext.height * 0.38)
            cr.show_text(lbl)

        # Peak-Hold Tick Triangle on Scale Arc
        if peak_norm is not None and peak_norm > 0.015:
            pk = max(0.0, min(1.0, peak_norm))
            pang = a0 + pk * (a1 - a0)
            px0 = piv_x + (arc_r - 1.0) * math.cos(pang)
            py0 = piv_y + (arc_r - 1.0) * math.sin(pang)
            px1 = piv_x + (arc_r + 6.8) * math.cos(pang - 0.045)
            py1 = piv_y + (arc_r + 6.8) * math.sin(pang - 0.045)
            px2 = piv_x + (arc_r + 6.8) * math.cos(pang + 0.045)
            py2 = piv_y + (arc_r + 6.8) * math.sin(pang + 0.045)
            cr.move_to(px0, py0)
            cr.line_to(px1, py1)
            cr.line_to(px2, py2)
            cr.close_path()
            cr.set_source_rgb(1.00, 0.72, 0.18) if dark_phosphor else cr.set_source_rgb(0.88, 0.24, 0.08)
            cr.fill()

        # Center Unit Legend
        cr.set_font_size(7.6)
        cr.set_source_rgba(0.45, 0.90, 0.70, 0.86) if dark_phosphor else cr.set_source_rgba(0.28, 0.22, 0.14, 0.86)
        u_ext = cr.text_extents(unit_lbl)
        cr.move_to(piv_x - u_ext.width * 0.5, piv_y - arc_r * 0.44)
        cr.show_text(unit_lbl)

        # Ballistic Needle
        cr.save()
        cr.rectangle(mx + 1, my + 1, mw - 2, mh - 2)
        cr.clip()
        n_ang = a0 + max(0.0, min(1.0, norm_val)) * (a1 - a0)
        tip_r = arc_r + 6.8

        cr.set_line_width(2.1)
        cr.set_source_rgba(0.05, 0.04, 0.02, 0.36)
        cr.move_to(piv_x + 1.8, piv_y + 1.8)
        cr.line_to(piv_x + 1.8 + tip_r * math.cos(n_ang), piv_y + 1.8 + tip_r * math.sin(n_ang))
        cr.stroke()

        if dark_phosphor:
            cr.set_line_width(2.0)
            cr.set_source_rgb(0.74, 0.98, 0.84)
            cr.move_to(piv_x - 6.0 * math.cos(n_ang), piv_y - 6.0 * math.sin(n_ang))
            cr.line_to(piv_x + (tip_r * 0.65) * math.cos(n_ang), piv_y + (tip_r * 0.65) * math.sin(n_ang))
            cr.stroke()
            cr.set_line_width(2.2)
            cr.set_source_rgb(1.00, 0.46, 0.16)
            cr.move_to(piv_x + (tip_r * 0.60) * math.cos(n_ang), piv_y + (tip_r * 0.60) * math.sin(n_ang))
            cr.line_to(piv_x + tip_r * math.cos(n_ang), piv_y + tip_r * math.sin(n_ang))
            cr.stroke()
        else:
            cr.set_line_width(1.9)
            cr.set_source_rgb(0.16, 0.15, 0.15)
            cr.move_to(piv_x - 6.0 * math.cos(n_ang), piv_y - 6.0 * math.sin(n_ang))
            cr.line_to(piv_x + (tip_r * 0.55) * math.cos(n_ang), piv_y + (tip_r * 0.55) * math.sin(n_ang))
            cr.stroke()
            cr.set_line_width(2.0)
            cr.set_source_rgb(0.80, 0.12, 0.10)
            cr.move_to(piv_x + (tip_r * 0.50) * math.cos(n_ang), piv_y + (tip_r * 0.50) * math.sin(n_ang))
            cr.line_to(piv_x + tip_r * math.cos(n_ang), piv_y + tip_r * math.sin(n_ang))
            cr.stroke()

        cr.new_sub_path()
        cr.arc(piv_x, piv_y, 6.8, 0, 2 * math.pi)
        cr.set_source_rgb(0.18, 0.19, 0.22)
        cr.fill()
        cr.new_sub_path()
        cr.arc(piv_x, piv_y, 3.2, 0, 2 * math.pi)
        cr.set_source_rgb(0.56, 0.62, 0.70) if dark_phosphor else cr.set_source_rgb(0.74, 0.68, 0.52)
        cr.fill()
        cr.restore()

        # Bottom Digital VFD Readout
        cls.draw_vfd_inset(cr, mx + 5.0, vfd_y, mw - 10.0, vfd_h, vfd_l1, vfd_l2, amber_vfd=not dark_phosphor)

    @staticmethod
    def draw_phosphor_stripchart(
        cr: cairo.Context,
        x: float,
        y: float,
        w: float,
        h: float,
        rx_hist: collections.deque[float],
        tx_hist: collections.deque[float],
        rx_now: float,
        tx_now: float,
    ):
        # Sunken Tektronix Phosphor CRT Screen
        cr.rectangle(x, y, w, h)
        bg = cairo.LinearGradient(x, y, x, y + h)
        bg.add_color_stop_rgb(0.0, 0.03, 0.08, 0.08)
        bg.add_color_stop_rgb(1.0, 0.02, 0.05, 0.06)
        cr.set_source(bg)
        cr.fill()

        # Graticule Grid
        cr.set_line_width(0.75)
        cr.set_source_rgba(0.18, 0.55, 0.48, 0.35)
        for i in range(1, 4):
            gy = y + (h * i) / 4.0
            cr.move_to(x + 2, gy)
            cr.line_to(x + w - 2, gy)
            cr.stroke()
        for i in range(1, 8):
            gx = x + (w * i) / 8.0
            cr.move_to(gx, y + 2)
            cr.line_to(gx, y + h - 2)
            cr.stroke()

        peak_val = max(max(rx_hist, default=0.0), max(tx_hist, default=0.0), 64_000.0)
        ceil_bps, _, _ = choose_throughput_scale(peak_val)

        pad_t, pad_b = 15.0, 5.0
        plot_h = max(12.0, h - pad_t - pad_b)
        n = len(rx_hist)

        def draw_trace(samples: collections.deque[float], rgb: tuple[float, float, float], fill_alpha: float):
            if n < 2:
                return
            pts: list[tuple[float, float]] = []
            for idx, val in enumerate(samples):
                px = x + 3.0 + (idx / float(n - 1)) * (w - 6.0)
                frac = max(0.0, min(1.0, val / ceil_bps))
                py = y + pad_t + plot_h * (1.0 - frac)
                pts.append((px, py))

            if fill_alpha > 0.0:
                cr.move_to(pts[0][0], y + pad_t + plot_h)
                for px, py in pts:
                    cr.line_to(px, py)
                cr.line_to(pts[-1][0], y + pad_t + plot_h)
                cr.close_path()
                cr.set_source_rgba(rgb[0], rgb[1], rgb[2], fill_alpha)
                cr.fill()

            # Soft outer phosphor glow
            cr.set_line_width(3.0)
            cr.set_source_rgba(rgb[0], rgb[1], rgb[2], 0.24)
            cr.move_to(*pts[0])
            for px, py in pts[1:]:
                cr.line_to(px, py)
            cr.stroke()

            # Crisp core beam
            cr.set_line_width(1.4)
            cr.set_source_rgb(*rgb)
            cr.move_to(*pts[0])
            for px, py in pts[1:]:
                cr.line_to(px, py)
            cr.stroke()

        draw_trace(tx_hist, (1.00, 0.72, 0.22), 0.10)
        draw_trace(rx_hist, (0.26, 0.98, 0.80), 0.16)

        # Legend Overlay
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(7.6)
        cr.set_source_rgb(0.28, 0.98, 0.82)
        cr.move_to(x + 6.0, y + 10.8)
        cr.show_text(f"RX {fmt_bits_short(rx_now)}/s")
        cr.set_source_rgb(1.00, 0.74, 0.24)
        cr.move_to(x + 98.0, y + 10.8)
        cr.show_text(f"TX {fmt_bits_short(tx_now)}/s")
        cr.set_source_rgba(0.68, 0.88, 0.82, 0.85)
        ceil_txt = f"FS {fmt_bits_short(ceil_bps)}"
        ext = cr.text_extents(ceil_txt)
        cr.move_to(x + w - ext.width - 6.0, y + 10.8)
        cr.show_text(ceil_txt)

        # Sunken Bevel Frame
        cr.set_line_width(1.4)
        cr.set_source_rgb(0.02, 0.04, 0.04)
        cr.move_to(x, y + h)
        cr.line_to(x, y)
        cr.line_to(x + w, y)
        cr.stroke()
        cr.set_source_rgb(0.36, 0.42, 0.50)
        cr.move_to(x, y + h)
        cr.line_to(x + w, y + h)
        cr.line_to(x + w, y)
        cr.stroke()

    @staticmethod
    def draw_world_radar(
        cr: cairo.Context,
        w: float,
        h: float,
        hops: list[TraceHop],
        selected_hop: int | None,
        auto_fit: bool,
        pulse_phase: float,
        target_label: str,
        ping_summary: str,
    ) -> list[tuple[int, float, float]]:
        """
        Render Dark Vector World Map + Glowing Great-Circle Hop Arcs + Hop Beacons.
        Returns [(hop_num, screen_x, screen_y), ...] for mouse hit-testing.
        """
        # 1. Deep Ocean Radar Background
        bg = cairo.LinearGradient(0, 0, 0, h)
        bg.add_color_stop_rgb(0.0, 0.03, 0.07, 0.10)
        bg.add_color_stop_rgb(0.5, 0.02, 0.05, 0.08)
        bg.add_color_stop_rgb(1.0, 0.02, 0.04, 0.06)
        cr.rectangle(0, 0, w, h)
        cr.set_source(bg)
        cr.fill()

        # Viewport Lon/Lat Bounds (WORLD vs AUTO-FIT)
        lon_min, lon_max = -180.0, 180.0
        lat_min, lat_max = -66.0, 82.0
        geo_hops = [hp for hp in hops if hp.has_geo]
        if auto_fit and len(geo_hops) >= 2:
            lons = [HOME_QTH_LON] + [hp.lon for hp in geo_hops]
            lats = [HOME_QTH_LAT] + [hp.lat for hp in geo_hops]
            span_lon = max(lons) - min(lons)
            if span_lon < 190.0:
                pad_x = max(18.0, span_lon * 0.25)
                pad_y = max(12.0, (max(lats) - min(lats)) * 0.30)
                lon_min = max(-180.0, min(lons) - pad_x)
                lon_max = min(180.0, max(lons) + pad_x)
                lat_min = max(-70.0, min(lats) - pad_y)
                lat_max = min(84.0, max(lats) + pad_y)
                # Preserve ~2:1 aspect ratio so continents never look stretched
                cur_ar = (lon_max - lon_min) / max(10.0, lat_max - lat_min)
                win_ar = max(1.2, w / max(80.0, h))
                if cur_ar < win_ar:
                    extra = ((lat_max - lat_min) * win_ar - (lon_max - lon_min)) * 0.5
                    lon_min = max(-180.0, lon_min - extra)
                    lon_max = min(180.0, lon_max + extra)
                else:
                    extra = ((lon_max - lon_min) / win_ar - (lat_max - lat_min)) * 0.5
                    lat_min = max(-72.0, lat_min - extra)
                    lat_max = min(84.0, lat_max + extra)

        def proj(lon: float, lat: float) -> tuple[float, float]:
            px = ((lon - lon_min) / max(1e-3, lon_max - lon_min)) * w
            py = ((lat_max - lat) / max(1e-3, lat_max - lat_min)) * h
            return px, py

        cr.save()
        cr.rectangle(1, 1, w - 2, h - 2)
        cr.clip()

        # 2. Phosphor Latitude / Longitude Graticule
        cr.set_line_width(0.65)
        cr.set_source_rgba(0.14, 0.44, 0.44, 0.32)
        for glon in range(-180, 181, 30):
            if lon_min <= glon <= lon_max:
                gx, _ = proj(glon, 0.0)
                cr.move_to(gx, 0)
                cr.line_to(gx, h)
                cr.stroke()
        for glat in range(-60, 81, 30):
            if lat_min <= glat <= lat_max:
                _, gy = proj(0.0, glat)
                cr.move_to(0, gy)
                cr.line_to(w, gy)
                cr.stroke()

        # Equator & Tropics subtle dashed lines
        cr.set_dash([4.0, 4.0])
        cr.set_source_rgba(0.24, 0.68, 0.62, 0.35)
        for sl in (0.0, 23.44, -23.44):
            if lat_min <= sl <= lat_max:
                _, sy = proj(0.0, sl)
                cr.move_to(0, sy)
                cr.line_to(w, sy)
                cr.stroke()
        cr.set_dash([])

        # 3. Embedded Vector World Continents & Lakes
        for is_hole, pts in WORLD_POLYGONS:
            if len(pts) < 3:
                continue
            p0x, p0y = proj(pts[0][0], pts[0][1])
            cr.move_to(p0x, p0y)
            for plon, plat in pts[1:]:
                px, py = proj(plon, plat)
                cr.line_to(px, py)
            cr.close_path()
            if is_hole:
                cr.set_source_rgb(0.03, 0.06, 0.09)
                cr.fill_preserve()
                cr.set_line_width(0.6)
                cr.set_source_rgba(0.18, 0.56, 0.52, 0.55)
                cr.stroke()
            else:
                cr.set_source_rgb(0.07, 0.16, 0.16)
                cr.fill_preserve()
                cr.set_line_width(0.85)
                cr.set_source_rgba(0.26, 0.78, 0.68, 0.78)
                cr.stroke()

        # Geopolitical & US/Idaho State Borders
        cr.set_line_width(0.65)
        cr.set_source_rgba(0.24, 0.66, 0.58, 0.42)
        for bline in BORDER_POLYLINES:
            if len(bline) < 2:
                continue
            bx0, by0 = proj(bline[0][0], bline[0][1])
            cr.move_to(bx0, by0)
            for blon, blat in bline[1:]:
                bx, by = proj(blon, blat)
                cr.line_to(bx, by)
            cr.stroke()

        # 4. Glowing Neon Hop-by-Hop Great-Circle Arcs from Home QTH
        prev_lat, prev_lon = HOME_QTH_LAT, HOME_QTH_LON
        all_arc_screen_pts: list[tuple[float, float]] = []

        for hp in hops:
            if not hp.has_geo or hp.ip == "*":
                continue
            segs = great_circle_segments(prev_lat, prev_lon, hp.lat, hp.lon, steps=44)
            is_sel = selected_hop == hp.hop
            rtt = hp.rtt_ms if hp.rtt_ms is not None else 45.0
            if is_sel:
                col = (1.00, 0.92, 0.34)
            elif rtt < 45.0:
                col = (0.28, 0.98, 0.84)
            elif rtt < 120.0:
                col = (1.00, 0.72, 0.22)
            else:
                col = (1.00, 0.40, 0.56)

            for seg in segs:
                spts = [proj(lon, lat) for lon, lat in seg]
                all_arc_screen_pts.extend(spts)
                if len(spts) < 2:
                    continue
                # Outer wide neon halo
                cr.set_line_width(6.2 if is_sel else 4.6)
                cr.set_source_rgba(col[0], col[1], col[2], 0.18 if not is_sel else 0.32)
                cr.move_to(*spts[0])
                for sx, sy in spts[1:]:
                    cr.line_to(sx, sy)
                cr.stroke()

                # Mid glow
                cr.set_line_width(2.8 if is_sel else 2.2)
                cr.set_source_rgba(col[0], col[1], col[2], 0.48)
                cr.move_to(*spts[0])
                for sx, sy in spts[1:]:
                    cr.line_to(sx, sy)
                cr.stroke()

                # Crisp white-hot core beam
                cr.set_line_width(1.35 if not is_sel else 1.8)
                cr.set_source_rgb(min(1.0, col[0] + 0.22), min(1.0, col[1] + 0.22), min(1.0, col[2] + 0.22))
                cr.move_to(*spts[0])
                for sx, sy in spts[1:]:
                    cr.line_to(sx, sy)
                cr.stroke()

            prev_lat, prev_lon = hp.lat, hp.lon

        # Animated Packet Tracer Pulse along Active Great-Circle Path
        if len(all_arc_screen_pts) >= 2:
            idx_f = (pulse_phase % 1.0) * (len(all_arc_screen_pts) - 1)
            idx0 = int(idx_f)
            px, py = all_arc_screen_pts[idx0]
            pg = cairo.RadialGradient(px, py, 1.0, px, py, 9.0)
            pg.add_color_stop_rgba(0.0, 1.0, 1.0, 0.95, 0.95)
            pg.add_color_stop_rgba(0.4, 0.35, 1.0, 0.88, 0.65)
            pg.add_color_stop_rgba(1.0, 0.20, 0.95, 0.80, 0.0)
            cr.arc(px, py, 9.0, 0, 2 * math.pi)
            cr.set_source(pg)
            cr.fill()

        # 5. Home QTH Diamond Reticle + Numbered Hop Beacons
        hit_targets: list[tuple[int, float, float]] = []
        hx, hy = proj(HOME_QTH_LON, HOME_QTH_LAT)
        hit_targets.append((0, hx, hy))

        # Expanding radar ring around Home QTH / Final Hop
        ring_r = 6.0 + 13.0 * (pulse_phase % 1.0)
        ring_a = 0.55 * (1.0 - (pulse_phase % 1.0))
        cr.new_sub_path()
        cr.arc(hx, hy, ring_r, 0, 2 * math.pi)
        cr.set_line_width(1.2)
        cr.set_source_rgba(1.00, 0.80, 0.26, ring_a)
        cr.stroke()

        # Home QTH Gold Diamond
        cr.move_to(hx, hy - 6.0)
        cr.line_to(hx + 6.0, hy)
        cr.line_to(hx, hy + 6.0)
        cr.line_to(hx - 6.0, hy)
        cr.close_path()
        cr.set_source_rgb(1.00, 0.78, 0.20)
        cr.fill_preserve()
        cr.set_line_width(1.2)
        cr.set_source_rgb(0.10, 0.08, 0.04)
        cr.stroke()

        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(7.6)
        cr.set_source_rgb(1.00, 0.86, 0.42)
        cr.move_to(hx + 8.0, hy - 4.0)
        cr.show_text("HOME QTH")

        placed_boxes: list[tuple[float, float, float, float]] = [(hx + 6, hy - 13, 86, 12)]
        for idx, hp in enumerate(hops):
            if not hp.has_geo or hp.ip == "*":
                continue
            bx, by = proj(hp.lon, hp.lat)
            hit_targets.append((hp.hop, bx, by))
            is_last = idx == len(hops) - 1
            is_sel = selected_hop == hp.hop

            if is_last:
                cr.new_sub_path()
                cr.arc(bx, by, ring_r, 0, 2 * math.pi)
                cr.set_line_width(1.3)
                cr.set_source_rgba(0.32, 1.00, 0.86, ring_a)
                cr.stroke()

            rad = 7.4 if (is_sel or is_last) else 6.2
            glow = cairo.RadialGradient(bx, by, 1.0, bx, by, rad * 2.1)
            bcol = (1.00, 0.90, 0.30) if is_sel else ((1.00, 0.46, 0.34) if is_last else (0.26, 0.96, 0.82))
            glow.add_color_stop_rgba(0.0, bcol[0], bcol[1], bcol[2], 0.55)
            glow.add_color_stop_rgba(1.0, bcol[0], bcol[1], bcol[2], 0.0)
            cr.arc(bx, by, rad * 2.1, 0, 2 * math.pi)
            cr.set_source(glow)
            cr.fill()

            cr.arc(bx, by, rad, 0, 2 * math.pi)
            cr.set_source_rgb(0.06, 0.14, 0.15)
            cr.fill_preserve()
            cr.set_line_width(1.6)
            cr.set_source_rgb(*bcol)
            cr.stroke()

            num_s = str(hp.hop)
            cr.set_font_size(7.4)
            ext_n = cr.text_extents(num_s)
            cr.set_source_rgb(0.96, 1.00, 0.98)
            cr.move_to(bx - ext_n.width * 0.5, by + ext_n.height * 0.38)
            cr.show_text(num_s)

            # Callout City Label (with non-overlap offset check)
            if hp.city and (is_sel or is_last or len(placed_boxes) < 12):
                tag = f"{hp.city[:14]}" + (f" {hp.rtt_ms:.0f}ms" if hp.rtt_ms is not None else "")
                ext_c = cr.text_extents(tag)
                tw, th = ext_c.width + 6.0, 12.0
                for dx, dy in ((9.0, 3.0), (9.0, -11.0), (-tw - 8.0, 3.0), (-tw - 8.0, -11.0)):
                    tx, ty = bx + dx, by + dy
                    if tx < 4 or tx + tw > w - 4 or ty < 18 or ty + th > h - 18:
                        continue
                    overlap = any(
                        not (tx + tw < ox or tx > ox + ow or ty + th < oy or ty > oy + oh)
                        for ox, oy, ow, oh in placed_boxes
                    )
                    if not overlap or is_sel or is_last:
                        placed_boxes.append((tx, ty, tw, th))
                        cr.rectangle(tx, ty - 9.0, tw, th)
                        cr.set_source_rgba(0.03, 0.08, 0.10, 0.82)
                        cr.fill()
                        cr.set_source_rgb(*bcol)
                        cr.move_to(tx + 3.0, ty)
                        cr.show_text(tag)
                        break

        # 6. Tactical Radar HUD Overlay Banner
        cr.rectangle(6.0, 6.0, min(w - 12.0, 350.0), 20.0)
        cr.set_source_rgba(0.03, 0.09, 0.11, 0.84)
        cr.fill()
        cr.set_font_size(8.0)
        cr.set_source_rgb(0.42, 0.98, 0.86)
        cr.move_to(11.0, 19.0)
        tot_km = hops[-1].dist_km if hops else 0.0
        hud = f"TGT: {target_label}  |  HOPS: {len(hops)}  |  GC: {tot_km:,.0f} km"
        cr.show_text(hud[:54])

        if ping_summary:
            ext_p = cr.text_extents(ping_summary)
            pw = min(w - 12.0, ext_p.width + 14.0)
            cr.rectangle(6.0, h - 24.0, pw, 18.0)
            cr.set_source_rgba(0.03, 0.09, 0.11, 0.84)
            cr.fill()
            cr.set_source_rgb(1.00, 0.80, 0.30)
            cr.move_to(12.0, h - 12.0)
            cr.show_text(ping_summary)

        cr.restore()

        # Sunken Motif Bevel Frame
        cr.set_line_width(1.6)
        cr.set_source_rgb(0.02, 0.04, 0.05)
        cr.move_to(0.8, h - 0.8)
        cr.line_to(0.8, 0.8)
        cr.line_to(w - 0.8, 0.8)
        cr.stroke()
        cr.set_source_rgb(0.36, 0.42, 0.50)
        cr.move_to(0.8, h - 0.8)
        cr.line_to(w - 0.8, h - 0.8)
        cr.line_to(w - 0.8, 0.8)
        cr.stroke()
        return hit_targets


