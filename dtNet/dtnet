def build_demo_hops(target: str) -> list[TraceHop]:
    key = target if target in DEMO_ROUTES else ("kiwisdr.com" if "kiwi" in target else "default")
    spec = DEMO_ROUTES[key]
    out: list[TraceHop] = []
    for idx, (ip, rtt, lat, lon, city, cc, asn) in enumerate(spec, start=1):
        dkm = haversine_km(HOME_QTH_LAT, HOME_QTH_LON, lat, lon)
        out.append(TraceHop(idx, ip, rtt, lat, lon, city, cc, asn, dkm, True))
    return out


# ---------------------------------------------------------------------------
# Pure-Python UDP DNS Packet Builder (Zero-Dependency MX/TXT/NS/A Inspector)
# ---------------------------------------------------------------------------
def get_system_nameservers() -> list[str]:
    ns: list[str] = []
    try:
        for ln in Path("/etc/resolv.conf").read_text(encoding="utf-8", errors="replace").splitlines():
            s = ln.strip()
            if s.startswith("nameserver"):
                parts = s.split()
                if len(parts) >= 2:
                    ns.append(parts[1])
    except OSError:
        pass
    return ns or ["1.1.1.1", "8.8.8.8"]


