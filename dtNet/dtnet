    def _set_dial_face(self, dark: bool):
        self.dark_phosphor = dark
        self._sync_face_buttons()
        self._save_state()
        self.dials_area.queue_draw()

    def _sync_face_buttons(self):
        for btn, active, cls_name in [
            (self.btn_face_dark, self.dark_phosphor, "sw-active"),
            (self.btn_face_warm, not self.dark_phosphor, "btn-amber"),
        ]:
            ctx = btn.get_style_context()
            if active:
                ctx.add_class(cls_name)
            else:
                ctx.remove_class(cls_name)

    def _on_cycle_dial3_mode(self, *_args):
        modes = ["AUTO", "RTT", "RF"]
        idx = (modes.index(self.dial3_mode) + 1) % len(modes) if self.dial3_mode in modes else 0
        self.dial3_mode = modes[idx]
        self.btn_d3_mode.set_label(f"DIAL 3: {self.dial3_mode}")
        self._save_state()
        self.dials_area.queue_draw()

    def _on_dials_clicked(self, widget: Gtk.Widget, ev: Gdk.EventButton):
        w = widget.get_allocated_width()
        if w > 0 and ev.x > (w * 2.0 / 3.0):
            self._on_cycle_dial3_mode()

    def _refresh_nic_combo(self):
        cur = self.sampler.selected_iface
        self.cmb_nic.remove_all()
        self.cmb_nic.append("ALL", "ALL (NON-LO AGGREGATE)")
        for nic in self.sampler.nic_names:
            self.cmb_nic.append(nic, nic)
        self.cmb_nic.set_active_id(cur if (cur == "ALL" or cur in self.sampler.nic_names) else "ALL")

    def _on_nic_changed(self, combo: Gtk.ComboBoxText):
        nid = combo.get_active_id()
        if nid:
            self.sampler.selected_iface = nid
            self.sampler.sample()
            self._update_nic_vfd()
            self.strip_area.queue_draw()

    def _update_nic_vfd(self):
        s = self.sampler
        if s.link_up:
            self.lbl_link_badge.set_markup('<span foreground="#58fcb8" weight="bold">● LINK UP</span>')
        else:
            self.lbl_link_badge.set_markup('<span foreground="#ff6b6b" weight="bold">○ LINK DOWN</span>')

        v6_short = s.ipv6_addr if len(s.ipv6_addr) <= 22 else s.ipv6_addr[:21] + "…"
        txt = (
            f"IPv4: {s.ipv4_addr:<18} SPD: {s.speed_str:<9} MTU: {s.mtu}\n"
            f"IPv6: {v6_short:<18} MAC: {s.mac_addr}\n"
            f"TOT RX: {fmt_bytes_gib(s.tot_rx_bytes):<10} TX: {fmt_bytes_gib(s.tot_tx_bytes):<10} ERR/DRP: {s.tot_errs}/{s.tot_drops}"
        )
        self.lbl_nic_vfd.set_text(txt)

    @staticmethod
    def _step_needle(state: list[float], target: float):
        # Damped spring-mass analog meter ballistics (18 fps)
        force = (target - state[0]) * 0.28
        state[1] = (state[1] + force) * 0.64
        state[0] = max(0.0, min(1.0, state[0] + state[1]))

    def _use_rf_on_dial3(self) -> bool:
        if self.dial3_mode == "RF":
            return True
        if self.dial3_mode == "RTT":
            return False
        return self.sampler.wifi_present

    def _on_anim_tick(self) -> bool:
        s = self.sampler
        rx_ceil, _, _ = choose_throughput_scale(max(s.rx_bps, s.rx_peak_bps))
        tx_ceil, _, _ = choose_throughput_scale(max(s.tx_bps, s.tx_peak_bps))

        self._step_needle(self._needle_rx, min(1.0, s.rx_bps / rx_ceil))
        self._step_needle(self._needle_tx, min(1.0, s.tx_bps / tx_ceil))

        if self._use_rf_on_dial3():
            d3_target = max(0.0, min(1.0, (s.wifi_dbm + 100.0) / 70.0)) if s.wifi_present else 0.0
        else:
            d3_target = max(0.0, min(1.0, (s.rtt_ms or 0.0) / 250.0))
        self._step_needle(self._needle_d3, d3_target)

        self._pulse_phase = (self._pulse_phase + 0.022) % 1.0
        self.dials_area.queue_draw()
        if self.notebook.get_current_page() == 0:
            self.radar_area.queue_draw()
        return True

    def _on_sample_tick(self) -> bool:
        prev_nics = list(self.sampler.nic_names)
        self.sampler.sample()
        if self.sampler.nic_names != prev_nics:
            self._refresh_nic_combo()
        self._update_nic_vfd()
        self.strip_area.queue_draw()
        return True

    def _on_draw_dials(self, widget: Gtk.Widget, cr: cairo.Context):
        w = float(widget.get_allocated_width())
        h = float(widget.get_allocated_height())
        s = self.sampler
        gap = 6.0
        gw = (w - 2.0 * gap) / 3.0

        # Dial 1: RX THROUGHPUT
        rx_ceil, rx_unit, rx_marks = choose_throughput_scale(max(s.rx_bps, s.rx_peak_bps))
        NetCairoRenderer.draw_analog_dial(
            cr, 0.0, 0.0, gw, h,
            "RX THROUGHPUT", rx_unit,
            self._needle_rx[0],
            min(1.0, s.rx_peak_bps / rx_ceil),
            rx_marks, (0.80, 1.0),
            self.dark_phosphor,
            fmt_bits_rate(s.rx_bps),
            f"PK {fmt_bits_short(s.rx_peak_bps)} | {s.rx_pps:.0f} pkt/s",
            [("RX ACT", (0.22, 0.96, 0.58), s.rx_pps > 0.2), ("PEAK", (0.96, 0.24, 0.22), s.rx_bps > rx_ceil * 0.8)],
            screw_seed=1,
        )

        # Dial 2: TX THROUGHPUT
        tx_ceil, tx_unit, tx_marks = choose_throughput_scale(max(s.tx_bps, s.tx_peak_bps))
        NetCairoRenderer.draw_analog_dial(
            cr, gw + gap, 0.0, gw, h,
            "TX THROUGHPUT", tx_unit,
            self._needle_tx[0],
            min(1.0, s.tx_peak_bps / tx_ceil),
            tx_marks, (0.80, 1.0),
            self.dark_phosphor,
            fmt_bits_rate(s.tx_bps),
            f"PK {fmt_bits_short(s.tx_peak_bps)} | {s.tx_pps:.0f} pkt/s",
            [("TX ACT", (1.00, 0.72, 0.20), s.tx_pps > 0.2), ("ERR/DRP", (0.96, 0.24, 0.22), s.err_delta > 0)],
            screw_seed=2,
        )

        # Dial 3: RTT LATENCY or WI-FI RF LINK
        x3 = 2.0 * (gw + gap)
        if self._use_rf_on_dial3():
            rf_marks = [
                (0.0, "-100", True), (0.214, "-85", True), (0.428, "-70", False),
                (0.643, "-55", False), (0.857, "-40", False), (1.0, "-30", False),
            ]
            l1 = f"{s.wifi_dbm:.0f} dBm ({s.wifi_qual_pct:.0f}%)" if s.wifi_present else "NO WIRELESS NIC"
            l2 = f"{s.wifi_iface} | NF {s.wifi_noise_dbm:.0f}dBm" if s.wifi_present else "CLICK DIAL -> RTT"
            NetCairoRenderer.draw_analog_dial(
                cr, x3, 0.0, gw, h,
                "RF LINK QUALITY", "Signal Level (dBm)",
                self._needle_d3[0], None,
                rf_marks, (0.0, 0.25),
                self.dark_phosphor, l1, l2,
                [("802.11", (0.24, 0.96, 0.62), s.wifi_present), ("LOW RF", (1.0, 0.62, 0.18), s.wifi_present and s.wifi_dbm < -78)],
                screw_seed=3,
            )
        else:
            rtt_marks = [
                (0.0, "0", False), (0.2, "50", False), (0.4, "100", False),
                (0.6, "150", True), (0.8, "200", True), (1.0, "250", True),
            ]
            l1 = f"{s.rtt_ms:5.1f} ms" if s.rtt_ms is not None else "--- ms (OFFLINE)"
            l2 = f"JIT ±{s.rtt_jitter_ms:.1f}ms | {s.rtt_target[:12]}"
            NetCairoRenderer.draw_analog_dial(
                cr, x3, 0.0, gw, h,
                "RTT LATENCY", "ICMP RTT (0-250 ms)",
                self._needle_d3[0],
                min(1.0, s.rtt_peak_ms / 250.0) if s.rtt_peak_ms > 0 else None,
                rtt_marks, (0.60, 1.0),
                self.dark_phosphor, l1, l2,
                [("ECHO OK", (0.24, 0.96, 0.62), s.rtt_ms is not None), ("JITTER", (1.0, 0.70, 0.20), s.rtt_jitter_ms > 15.0)],
                screw_seed=3,
            )

    def _on_draw_stripchart(self, widget: Gtk.Widget, cr: cairo.Context):
        w = float(widget.get_allocated_width())
        h = float(widget.get_allocated_height())
        NetCairoRenderer.draw_phosphor_stripchart(
