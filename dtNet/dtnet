        threading.Thread(target=self._lan_sweep_worker, args=(prefix,), daemon=True).start()

    def _lan_sweep_worker(self, prefix: str):
        hosts = [f"{prefix}.{i}" for i in range(1, 255)]
        found = 0

        def probe_host(ip_a: str) -> dict | None:
            if self._sweep_stop.is_set():
                return None
            open_p: list[int] = []
            best_ms: float | None = None
            for port in SWEEP_PORTS:
                if self._sweep_stop.is_set():
                    return None
                t0 = time.monotonic()
                try:
                    with socket.create_connection((ip_a, port), timeout=0.22):
                        ms = (time.monotonic() - t0) * 1000.0
                        open_p.append(port)
                        best_ms = ms if best_ms is None else min(best_ms, ms)
                except ConnectionRefusedError:
                    ms = (time.monotonic() - t0) * 1000.0
                    best_ms = ms if best_ms is None else min(best_ms, ms)
                except OSError:
                    continue

            if best_ms is None and not open_p:
                rtt_p = self._single_ping_ms(ip_a)
                if rtt_p is not None:
                    best_ms = rtt_p

            arp_map = self._read_arp_map()
            arp_entry = arp_map.get(ip_a)
            if best_ms is None and not open_p and not arp_entry:
                return None

            hname = ""
            try:
                hname = socket.gethostbyaddr(ip_a)[0]
            except OSError:
                pass

            mac = arp_entry["mac"] if arp_entry else "-"
            vendor = arp_entry["vendor"] if arp_entry else ""
            hv = hname or vendor or "-"
            p_str = ",".join(str(p) for p in open_p) if open_p else "-"
            rtt_s = f"{best_ms:.1f}ms" if best_ms is not None else "ARP"
            return {"ip": ip_a, "rtt": rtt_s, "mac": mac, "hv": hv[:26], "ports": p_str}

        with concurrent.futures.ThreadPoolExecutor(max_workers=32) as pool:
            futs = [pool.submit(probe_host, h) for h in hosts]
            for fut in concurrent.futures.as_completed(futs):
                if self._sweep_stop.is_set():
                    break
                res = fut.result()
                if res:
                    found += 1
                    GLib.idle_add(self._append_sweep_row, res, found)

        GLib.idle_add(self._finish_sweep, prefix, found)

    def _append_sweep_row(self, res: dict, idx: int):
        bg = "#eaf4ea" if idx % 2 == 1 else "#f7fbf6"
        self.sweep_store.append([res["ip"], res["rtt"], res["mac"], res["hv"], res["ports"], bg])
        return False

    def _finish_sweep(self, prefix: str, found: int):
        self._sweep_running = False
        self.btn_sweep.set_label("▶ SWEEP /24")
        self.btn_sweep.get_style_context().remove_class("btn-stop")
        self.btn_sweep.get_style_context().add_class("btn-trace")
        if found == 0:
            self._load_arp_into_sweep_table()
        self.lbl_status.set_text(f"LAN SWEEP COMPLETE: {prefix}.0/24 — {found} active host(s) responded.")
        return False

