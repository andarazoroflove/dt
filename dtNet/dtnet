# Live Workstation Network Telemetry Sampler
# ---------------------------------------------------------------------------
class NetTelemetrySampler:
    def __init__(self):
        self.selected_iface = "ALL"
        self._prev_dev: dict[str, dict[str, int]] = {}
        self._prev_ts = 0.0
        self._addr_cache_ts = 0.0
        self._iface_addrs: dict[str, tuple[str, str]] = {}

        # Instantaneous rates (bits/sec & packets/sec)
        self.rx_bps = 0.0
        self.tx_bps = 0.0
        self.rx_pps = 0.0
        self.tx_pps = 0.0
        self.rx_peak_bps = 0.0
        self.tx_peak_bps = 0.0
        self.err_delta = 0

        # History deques (bits/sec)
        self.rx_hist: collections.deque[float] = collections.deque([0.0] * HISTORY_LEN, maxlen=HISTORY_LEN)
        self.tx_hist: collections.deque[float] = collections.deque([0.0] * HISTORY_LEN, maxlen=HISTORY_LEN)

        # Active interface metadata
        self.nic_names: list[str] = ["lo"]
        self.link_up = True
        self.mac_addr = "00:00:00:00:00:00"
        self.ipv4_addr = "127.0.0.1"
        self.ipv6_addr = "::1"
        self.speed_str = "LOOPBACK"
        self.mtu = 65536
        self.tot_rx_bytes = 0
        self.tot_tx_bytes = 0
        self.tot_errs = 0
        self.tot_drops = 0

        # Wi-Fi RF telemetry (/proc/net/wireless)
        self.wifi_present = False
        self.wifi_iface = ""
        self.wifi_dbm = -100.0
        self.wifi_qual_pct = 0.0
        self.wifi_noise_dbm = -95.0

        # Live RTT telemetry (updated by background ping probe)
        self.rtt_ms: float | None = None
        self.rtt_peak_ms = 0.0
        self.rtt_jitter_ms = 0.0
        self.rtt_loss_pct = 0.0
        self.rtt_target = "1.1.1.1"

    def reset_peaks(self):
        self.rx_peak_bps = self.rx_bps
        self.tx_peak_bps = self.tx_bps
        self.rtt_peak_ms = self.rtt_ms or 0.0

    def _refresh_ip_addrs(self):
        now = time.monotonic()
        if now - self._addr_cache_ts < 4.0:
            return
        self._addr_cache_ts = now
        addrs: dict[str, tuple[str, str]] = {}

        # Pure-Python IPv4 ioctl SIOCGIFADDR fallback + /proc/net/if_inet6
        v4_map: dict[str, str] = {}
        v6_map: dict[str, str] = {}
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            for nic in self.nic_names:
                try:
                    ifreq = struct.pack("256s", nic[:15].encode("utf-8"))
                    res = fcntl.ioctl(s.fileno(), 0x8915, ifreq)  # SIOCGIFADDR
                    v4_map[nic] = socket.inet_ntoa(res[20:24])
                except OSError:
                    continue
            s.close()
        except OSError:
            pass

        try:
            if6 = Path("/proc/net/if_inet6")
            if if6.is_file():
                for ln in if6.read_text(encoding="utf-8", errors="replace").splitlines():
                    parts = ln.split()
                    if len(parts) >= 6:
                        raw_hex, nic = parts[0], parts[5]
                        if len(raw_hex) == 32 and nic not in v6_map:
                            b16 = bytes.fromhex(raw_hex)
                            v6_map[nic] = socket.inet_ntop(socket.AF_INET6, b16)
        except Exception:
            pass

        # Enrich with `ip -o addr` if present (adds CIDR prefix)
        if shutil.which("ip"):
            try:
                out = subprocess.check_output(["ip", "-o", "addr", "show"], text=True, stderr=subprocess.DEVNULL, timeout=0.8)
                for ln in out.splitlines():
                    parts = ln.split()
                    if len(parts) >= 4:
                        nic = parts[1]
                        fam = parts[2]
                        cidr = parts[3]
                        if fam == "inet" and nic not in v4_map:
                            v4_map[nic] = cidr.split("/")[0]
                        elif fam == "inet":
                            v4_map[nic] = cidr
                        elif fam == "inet6" and nic not in v6_map:
                            v6_map[nic] = cidr.split("/")[0]
            except Exception:
                pass

        for nic in self.nic_names:
            addrs[nic] = (v4_map.get(nic, "-"), v6_map.get(nic, "-"))
        self._iface_addrs = addrs

    def sample(self):
        now = time.monotonic()
        try:
            dev_txt = Path("/proc/net/dev").read_text(encoding="utf-8", errors="replace")
            cur_dev = parse_proc_net_dev_text(dev_txt)
        except OSError:
            cur_dev = {}

        try:
            sys_nics = sorted(p.name for p in Path("/sys/class/net").iterdir())
        except OSError:
            sys_nics = sorted(cur_dev.keys()) or ["lo"]
        if sys_nics:
            self.nic_names = sys_nics

        self._refresh_ip_addrs()

        # Choose target NICs for throughput aggregation
        if self.selected_iface == "ALL":
            non_lo = [n for n in cur_dev if n != "lo"]
            active_set = non_lo if non_lo else list(cur_dev.keys())
        elif self.selected_iface in cur_dev:
            active_set = [self.selected_iface]
        else:
            active_set = list(cur_dev.keys())

        dt = now - self._prev_ts if self._prev_ts > 0 else 0.0
        if dt > 0.05 and self._prev_dev:
            d_rxb = sum(max(0, cur_dev[n]["rx_bytes"] - self._prev_dev.get(n, cur_dev[n])["rx_bytes"]) for n in active_set)
            d_txb = sum(max(0, cur_dev[n]["tx_bytes"] - self._prev_dev.get(n, cur_dev[n])["tx_bytes"]) for n in active_set)
            d_rxp = sum(max(0, cur_dev[n]["rx_packets"] - self._prev_dev.get(n, cur_dev[n])["rx_packets"]) for n in active_set)
            d_txp = sum(max(0, cur_dev[n]["tx_packets"] - self._prev_dev.get(n, cur_dev[n])["tx_packets"]) for n in active_set)
            d_err = sum(
                max(0, (cur_dev[n]["rx_errs"] + cur_dev[n]["tx_errs"] + cur_dev[n]["rx_drop"] + cur_dev[n]["tx_drop"])
                    - (self._prev_dev.get(n, cur_dev[n])["rx_errs"] + self._prev_dev.get(n, cur_dev[n])["tx_errs"]
                       + self._prev_dev.get(n, cur_dev[n])["rx_drop"] + self._prev_dev.get(n, cur_dev[n])["tx_drop"]))
                for n in active_set
            )
            self.rx_bps = (d_rxb * 8.0) / dt
            self.tx_bps = (d_txb * 8.0) / dt
            self.rx_pps = d_rxp / dt
            self.tx_pps = d_txp / dt
            self.err_delta = d_err
            self.rx_peak_bps = max(self.rx_peak_bps * 0.996, self.rx_bps)
            self.tx_peak_bps = max(self.tx_peak_bps * 0.996, self.tx_bps)
            self.rx_hist.append(self.rx_bps)
            self.tx_hist.append(self.tx_bps)

        self._prev_dev = cur_dev
        self._prev_ts = now

        # Totals & NIC hardware properties
        self.tot_rx_bytes = sum(cur_dev[n]["rx_bytes"] for n in active_set)
        self.tot_tx_bytes = sum(cur_dev[n]["tx_bytes"] for n in active_set)
        self.tot_errs = sum(cur_dev[n]["rx_errs"] + cur_dev[n]["tx_errs"] for n in active_set)
        self.tot_drops = sum(cur_dev[n]["rx_drop"] + cur_dev[n]["tx_drop"] for n in active_set)

        primary_nic = self.selected_iface if self.selected_iface != "ALL" else self._pick_primary_nic()
        self._read_nic_sysfs(primary_nic)

        # Read /proc/net/wireless
        self.wifi_present = False
        try:
            w_txt = Path("/proc/net/wireless").read_text(encoding="utf-8", errors="replace")
            w_map = parse_proc_net_wireless_text(w_txt)
            if w_map:
                wnic = primary_nic if primary_nic in w_map else next(iter(w_map))
                winfo = w_map[wnic]
                self.wifi_present = True
                self.wifi_iface = wnic
                self.wifi_dbm = winfo["level_dbm"]
                self.wifi_qual_pct = winfo["qual_pct"]
                self.wifi_noise_dbm = winfo["noise_dbm"]
        except OSError:
            pass

    def _pick_primary_nic(self) -> str:
        for n in self.nic_names:
            if n == "lo":
                continue
            try:
                st = Path(f"/sys/class/net/{n}/operstate").read_text().strip().lower()
                if st == "up":
                    return n
            except OSError:
                continue
        for n in self.nic_names:
            if n != "lo":
                return n
        return self.nic_names[0] if self.nic_names else "lo"

    def _read_nic_sysfs(self, nic: str):
        base = Path(f"/sys/class/net/{nic}")
        try:
            oper = (base / "operstate").read_text().strip().lower()
            flags_hex = (base / "flags").read_text().strip()
            flags = int(flags_hex, 16)
            self.link_up = oper in ("up", "unknown") and bool(flags & 0x1)
        except Exception:
            self.link_up = True

        try:
            self.mac_addr = (base / "address").read_text().strip().upper()
        except OSError:
            self.mac_addr = "00:00:00:00:00:00"

        try:
            self.mtu = int((base / "mtu").read_text().strip())
        except Exception:
            self.mtu = 1500

        if nic == "lo":
            self.speed_str = "LOOPBACK"
        elif (base / "wireless").exists():
            self.speed_str = "802.11 RF"
        else:
            try:
                spd = int((base / "speed").read_text().strip())
                self.speed_str = f"{spd} Mb/s" if spd > 0 else "AUTO"
            except Exception:
                self.speed_str = "VIRTUAL" if not self.link_up else "LINK UP"

        v4, v6 = self._iface_addrs.get(nic, ("-", "-"))
        if os.environ.get("DT_SCREENSHOT_DEMO") == "1":
            self.mac_addr = "02:00:5E:10:00:01"
            self.ipv4_addr = "192.0.2.42/24"
            self.ipv6_addr = "2001:db8::42"
        else:
            self.ipv4_addr = v4
            self.ipv6_addr = v6

    def detect_local_subnet(self) -> str:
        for nic in self.nic_names:
            if nic == "lo":
                continue
            v4, _ = self._iface_addrs.get(nic, ("-", "-"))
            ip_only = v4.split("/")[0]
            if re.match(r"^\d+\.\d+\.\d+\.\d+$", ip_only) and not ip_only.startswith("127."):
                octs = ip_only.split(".")
                return f"{octs[0]}.{octs[1]}.{octs[2]}.0/24"
        return "192.168.1.0/24"


