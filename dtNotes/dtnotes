                it = Gtk.MenuItem(label=lbl)
                it.connect("activate", cb)
                if key:
                    it.add_accelerator("activate", accel, key, mod, Gtk.AccelFlags.VISIBLE)
                m_file.append(it)
        mbar.append(mi_file)

        m_edit = Gtk.Menu()
        mi_edit = Gtk.MenuItem(label="Edit")
        mi_edit.set_submenu(m_edit)
        for lbl, key, mod, cb in [
            ("Undo", Gdk.KEY_z, Gdk.ModifierType.CONTROL_MASK, self.on_undo),
            ("Redo", Gdk.KEY_y, Gdk.ModifierType.CONTROL_MASK, self.on_redo),
            ("-", None, 0, None),
            ("Find & Replace...", Gdk.KEY_f, Gdk.ModifierType.CONTROL_MASK, self.on_toggle_find),
        ]:
            if lbl == "-":
                m_edit.append(Gtk.SeparatorMenuItem())
            else:
                it = Gtk.MenuItem(label=lbl)
                it.connect("activate", cb)
                if key:
                    it.add_accelerator("activate", accel, key, mod, Gtk.AccelFlags.VISIBLE)
                m_edit.append(it)
        mbar.append(mi_edit)

        m_view = Gtk.Menu()
        mi_view = Gtk.MenuItem(label="View")
        mi_view.set_submenu(m_view)
        for lbl, key, mod, cb in [
            ("Toggle Markdown Preview", Gdk.KEY_p, Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK, self.on_toggle_md_preview),
            ("Toggle Line Numbers", Gdk.KEY_l, Gdk.ModifierType.CONTROL_MASK, self.on_toggle_lines),
            ("Toggle Word Wrap", None, 0, self.on_toggle_wrap),
            ("-", None, 0, None),
            ("Zoom In", Gdk.KEY_plus, Gdk.ModifierType.CONTROL_MASK, lambda *_: self._zoom(1)),
            ("Zoom Out", Gdk.KEY_minus, Gdk.ModifierType.CONTROL_MASK, lambda *_: self._zoom(-1)),
        ]:
            if lbl == "-":
                m_view.append(Gtk.SeparatorMenuItem())
            else:
                it = Gtk.MenuItem(label=lbl)
                it.connect("activate", cb)
                if key:
                    it.add_accelerator("activate", accel, key, mod, Gtk.AccelFlags.VISIBLE)
                m_view.append(it)
        mbar.append(mi_view)

        m_help = Gtk.Menu()
        mi_help = Gtk.MenuItem(label="Help")
        mi_help.set_submenu(m_help)
        it_ab = Gtk.MenuItem(label="About dtNotes...")
        it_ab.connect("activate", self.on_about)
        m_help.append(it_ab)
        mbar.append(mi_help)
        vbox.pack_start(mbar, False, False, 0)

        # 2. CDE Formatting & File Toolbar
        tbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        tbar.get_style_context().add_class("cde-toolbar")
        for lbl, tip, cb in [
            ("New", "New document tab (Ctrl+T)", self.on_new_tab),
            ("Open...", "Open .txt, .md, or .rtf (Ctrl+O)", self.on_open),
            ("Save", "Save current document (Ctrl+S)", self.on_save),
            ("Save As...", "Save as .txt, .md, or .rtf", self.on_save_as),
        ]:
            b = Gtk.Button(label=lbl)
            b.set_tooltip_text(tip)
            b.connect("clicked", cb)
            tbar.pack_start(b, False, False, 0)

        tbar.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 3)

        # Rich / Markdown Formatting Buttons
        for lbl, tag, tip in [
            ("B", "bold", "Bold (.rtf rich tag / .md **bold**)"),
            ("I", "italic", "Italic (.rtf rich tag / .md *italic*)"),
            ("U", "underline", "Underline (.rtf rich tag)"),
            ("H1", "h1", "Heading 1"),
            ("H2", "h2", "Heading 2"),
            ("Mono", "mono", "Monospace / Code"),
        ]:
            b = Gtk.Button(label=lbl)
            b.set_tooltip_text(tip)
            b.connect("clicked", lambda _b, tg=tag: self.apply_format(tg))
            tbar.pack_start(b, False, False, 0)

        tbar.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 3)

        b_md = Gtk.Button(label="MD Preview")
        b_md.set_tooltip_text("Toggle live side-by-side Markdown preview")
        b_md.connect("clicked", self.on_toggle_md_preview)
        tbar.pack_start(b_md, False, False, 0)

        b_ln = Gtk.Button(label="Line #")
        b_ln.connect("clicked", self.on_toggle_lines)
        tbar.pack_start(b_ln, False, False, 0)

        b_fnd = Gtk.Button(label="Find / Replace")
        b_fnd.connect("clicked", self.on_toggle_find)
        tbar.pack_end(b_fnd, False, False, 0)
        vbox.pack_start(tbar, False, False, 0)

        # 3. Collapsible Find & Replace Bar
        self.find_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5, margin=4)
        self.find_bar.pack_start(Gtk.Label(label="Find:"), False, False, 2)
        self.ent_find = Gtk.Entry(width_chars=18)
        self.ent_find.connect("activate", self.on_find_next)
        self.find_bar.pack_start(self.ent_find, False, False, 0)
        b_fn = Gtk.Button(label="Find Next")
        b_fn.connect("clicked", self.on_find_next)
        self.find_bar.pack_start(b_fn, False, False, 0)

        self.find_bar.pack_start(Gtk.Label(label="Replace:"), False, False, 4)
        self.ent_repl = Gtk.Entry(width_chars=18)
        self.find_bar.pack_start(self.ent_repl, False, False, 0)
        b_rp = Gtk.Button(label="Replace")
        b_rp.connect("clicked", self.on_replace_one)
        b_ra = Gtk.Button(label="Replace All")
        b_ra.connect("clicked", self.on_replace_all)
        b_fx = Gtk.Button(label="✕")
        b_fx.connect("clicked", self.on_toggle_find)
        self.find_bar.pack_start(b_rp, False, False, 0)
        self.find_bar.pack_start(b_ra, False, False, 0)
        self.find_bar.pack_end(b_fx, False, False, 0)
        vbox.pack_start(self.find_bar, False, False, 0)

        # 4. Multi-Tab Notebook
        self.nb = Gtk.Notebook(scrollable=True)
        self.nb.connect("switch-page", lambda *_: self._refresh_status())
        vbox.pack_start(self.nb, True, True, 0)

        # 5. Status Bar
        st = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        st.get_style_context().add_class("cde-status")
        self.lbl_status = Gtk.Label(label="Ready", xalign=0)
        self.lbl_mode = Gtk.Label(label="Format: TXT", xalign=1)
        st.pack_start(self.lbl_status, True, True, 0)
        st.pack_end(self.lbl_mode, False, False, 0)
        vbox.pack_start(st, False, False, 0)

        # Drag-and-drop file opening
        targets = [
            Gtk.TargetEntry.new("text/uri-list", 0, 0),
            Gtk.TargetEntry.new("text/plain", 0, 1),
            Gtk.TargetEntry.new("STRING", 0, 2),
        ]
        self.drag_dest_set(Gtk.DestDefaults.ALL, targets, Gdk.DragAction.COPY)
        self.connect("drag-data-received", self._on_drop)

        self.show_all()
        self.find_bar.hide()

        if initial_files:
            for fp in initial_files:
                self.add_tab(fp)
        else:
            self.add_tab(None)

    def _on_drop(self, _w, context, _x, _y, data, _info, time_):
        opened = False
        for u in (data.get_uris() or []):
            if u.startswith("file://"):
                p = Path(urllib.parse.unquote(urllib.parse.urlparse(u).path))
                if p.is_file():
                    self.add_tab(p)
                    opened = True
        if not opened:
            for ln in (data.get_text() or "").splitlines():
                ln = ln.strip()
                if not ln:
                    continue
                p = Path(urllib.parse.unquote(urllib.parse.urlparse(ln).path)) if ln.startswith("file://") else Path(ln)
                if p.is_file():
                    self.add_tab(p)
                    opened = True
        Gtk.drag_finish(context, opened, False, time_)

    def add_tab(self, file_path: Path | None):
        tab = NoteTab(self.paper_hex, file_path)
        lbl = Gtk.Label(label=tab.title_label())
        idx = self.nb.append_page(tab, lbl)
        self.nb.show_all()
        if tab.doc_mode != "md":
            tab.fr_prev.hide()
        self.nb.set_current_page(idx)
        tab.buf.connect("changed", lambda _b, t=tab, l=lbl: (l.set_text(t.title_label()), self._refresh_status()))
        tab.buf.connect("mark-set", lambda *_: self._refresh_status())
        self._apply_editor_font(tab)
        self._refresh_status()

    def cur_tab(self) -> NoteTab | None:
        idx = self.nb.get_current_page()
        return self.nb.get_nth_page(idx) if idx >= 0 else None

    def _refresh_status(self):
        t = self.cur_tab()
        if not t:
            return
        lines = t.buf.get_line_count()
        chars = t.buf.get_char_count()
        it = t.buf.get_iter_at_mark(t.buf.get_insert())
        ln = it.get_line() + 1
        col = it.get_line_offset() + 1
        p_str = str(t.file_path) if t.file_path else "Unsaved Document"
        self.lbl_status.set_text(f"Ln {ln}, Col {col}  |  {lines} lines, {chars} chars  |  {p_str}")
        self.lbl_mode.set_text(f"Mode: {t.doc_mode.upper()}")
        self.set_title(f"{t.title_label()} — dtNotes")

    def on_new_tab(self, *_args):
        self.add_tab(None)

    def on_open(self, *_args):
        dlg = Gtk.FileChooserDialog(title="Open Document — dtNotes", parent=self, action=Gtk.FileChooserAction.OPEN)
        dlg.set_select_multiple(True)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Open", Gtk.ResponseType.OK)
        flt = Gtk.FileFilter()
        flt.set_name("Documents & Text (*.rtf, *.md, *.txt, *.*)")
        for p in ("*.rtf", "*.RTF", "*.md", "*.MD", "*.markdown", "*.txt", "*.TXT", "*.log", "*.conf", "*.ini", "*.csv"):
            flt.add_pattern(p)
        dlg.add_filter(flt)
        flt_all = Gtk.FileFilter()
        flt_all.set_name("All Files")
        flt_all.add_pattern("*")
        dlg.add_filter(flt_all)
        if dlg.run() == Gtk.ResponseType.OK:
            for fn in dlg.get_filenames():
                p = Path(fn)
                # Reuse single empty untitled tab if unmodified
                cur = self.cur_tab()
                if cur and not cur.file_path and not cur.modified and cur.buf.get_char_count() == 0:
                    cur.load_from_disk(p)
                    self.nb.set_tab_label_text(cur, cur.title_label())
                    self._refresh_status()
                else:
                    self.add_tab(p)
        dlg.destroy()

    def on_save(self, *_args):
        t = self.cur_tab()
        if not t:
            return
        if not t.file_path:
            self.on_save_as()
            return
        try:
            t.save_to_disk(t.file_path)
            self.nb.set_tab_label_text(t, t.title_label())
            self._refresh_status()
        except Exception as exc:
            self._error(f"Failed to save '{t.file_path}':\n{exc}")

    def on_save_as(self, *_args):
        t = self.cur_tab()
        if not t:
            return
        dlg = Gtk.FileChooserDialog(title="Save Document As (.txt, .md, or .rtf) — dtNotes", parent=self, action=Gtk.FileChooserAction.SAVE)
        dlg.set_do_overwrite_confirmation(True)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save", Gtk.ResponseType.OK)
        if t.file_path:
            dlg.set_current_folder(str(t.file_path.parent))
            dlg.set_current_name(t.file_path.name)
        else:
            ext = ".rtf" if t.doc_mode == "rtf" else (".md" if t.doc_mode == "md" else ".txt")
            dlg.set_current_name(f"notes{ext}")
        if dlg.run() == Gtk.ResponseType.OK:
            dest = Path(dlg.get_filename())
            dlg.destroy()
            try:
                t.save_to_disk(dest)
                self.nb.set_tab_label_text(t, t.title_label())
                self._refresh_status()
            except Exception as exc:
                self._error(f"Save As failed:\n{exc}")
        else:
            dlg.destroy()

    def on_close_tab(self, *_args):
        if self.nb.get_n_pages() <= 1:
            self.destroy()
        else:
            self.nb.remove_page(self.nb.get_current_page())

    def on_undo(self, *_args):
        t = self.cur_tab()
        if t and t.buf.can_undo():
            t.buf.undo()

    def on_redo(self, *_args):
        t = self.cur_tab()
        if t and t.buf.can_redo():
            t.buf.redo()

    def apply_format(self, tag_name: str):
        t = self.cur_tab()
        if not t:
            return
        bounds = t.buf.get_selection_bounds()
        if t.doc_mode == "md":
            # Insert clean Markdown syntax around selection
            md_map = {
                "bold": ("**", "**"),
                "italic": ("*", "*"),
                "underline": ("<u>", "</u>"),
                "mono": ("`", "`"),
                "h1": ("# ", ""),
                "h2": ("## ", ""),
            }
            pre, suf = md_map.get(tag_name, ("", ""))
            if bounds:
                s, e = bounds
                sel_txt = t.buf.get_text(s, e, True)
                t.buf.delete(s, e)
                t.buf.insert(s, f"{pre}{sel_txt}{suf}")
            else:
                t.buf.insert_at_cursor(f"{pre}{suf}")
            return

        # Rich tag mode (auto-switches untitled plain buffer to RTF-capable formatting)
        if not t.file_path and t.doc_mode == "txt":
            t.doc_mode = "rtf"
        if bounds:
            s, e = bounds
            tag = t.buf.get_tag_table().lookup(tag_name)
            if tag:
                if s.has_tag(tag):
                    t.buf.remove_tag(tag, s, e)
                else:
                    t.buf.apply_tag(tag, s, e)
        self._refresh_status()

    def on_toggle_md_preview(self, *_args):
        t = self.cur_tab()
        if not t:
            return
        if t.fr_prev.get_visible():
            t.fr_prev.hide()
        else:
            t.fr_prev.show()
            t.paned.set_position(max(320, self.get_allocated_width() // 2))
            t.refresh_md_preview()

    def on_toggle_lines(self, *_args):
        t = self.cur_tab()
        if t:
            t.view.set_show_line_numbers(not t.view.get_show_line_numbers())

    def on_toggle_wrap(self, *_args):
        t = self.cur_tab()
        if t:
            cur = t.view.get_wrap_mode()
            t.view.set_wrap_mode(Gtk.WrapMode.NONE if cur != Gtk.WrapMode.NONE else Gtk.WrapMode.WORD_CHAR)

    def _zoom(self, delta: int):
        self.font_pt = max(8, min(26, self.font_pt + delta))
        for i in range(self.nb.get_n_pages()):
            self._apply_editor_font(self.nb.get_nth_page(i))

    def _apply_editor_font(self, tab: NoteTab):
        desc = Pango.FontDescription(f"DejaVu Sans {self.font_pt}")
        tab.view.override_font(desc)

    def on_toggle_find(self, *_args):
        if self.find_bar.get_visible():
            self.find_bar.hide()
        else:
            self.find_bar.show()
            self.ent_find.grab_focus()

    def on_find_next(self, *_args):
        t = self.cur_tab()
        q = self.ent_find.get_text()
        if not t or not q:
            return
        bounds = t.buf.get_selection_bounds()
        start = bounds[1] if bounds else t.buf.get_iter_at_mark(t.buf.get_insert())
        res = start.forward_search(q, Gtk.TextSearchFlags.CASE_INSENSITIVE, None)
        if not res:
            res = t.buf.get_start_iter().forward_search(q, Gtk.TextSearchFlags.CASE_INSENSITIVE, None)
        if res:
            ms, me = res
            t.buf.select_range(ms, me)
            t.view.scroll_to_iter(ms, 0.15, False, 0.0, 0.0)

    def on_replace_one(self, *_args):
        t = self.cur_tab()
        q = self.ent_find.get_text()
        rep = self.ent_repl.get_text()
        if not t or not q:
            return
        bounds = t.buf.get_selection_bounds()
        if bounds and t.buf.get_text(bounds[0], bounds[1], True).lower() == q.lower():
            t.buf.delete(bounds[0], bounds[1])
            t.buf.insert(bounds[0], rep)
        self.on_find_next()

    def on_replace_all(self, *_args):
        t = self.cur_tab()
        q = self.ent_find.get_text()
        rep = self.ent_repl.get_text()
        if not t or not q:
            return
        it = t.buf.get_start_iter()
        while True:
            res = it.forward_search(q, Gtk.TextSearchFlags.CASE_INSENSITIVE, None)
            if not res:
                break
            ms, me = res
            t.buf.delete(ms, me)
            t.buf.insert(ms, rep)
            it = ms

    def on_about(self, *_args):
        md = Gtk.MessageDialog(
            transient_for=self, flags=0, message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK, text="dtNotes — CDE Rich Text, Markdown & Text Editor",
        )
        md.format_secondary_text(
            "Native CDE replacement for dtpad supporting .rtf (Rich Text), .md (Markdown + Live Preview), and .txt / code files."
        )
        md.run()
        md.destroy()

    def _error(self, msg: str):
        md = Gtk.MessageDialog(transient_for=self, flags=0, message_type=Gtk.MessageType.ERROR,
                               buttons=Gtk.ButtonsType.OK, text=msg)
        md.run()
        md.destroy()


def main():
    chrome, sel, well = load_cde_palette()
    provider = Gtk.CssProvider()
    provider.load_from_data(build_cde_css(chrome, sel, well))
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    init_files = [Path(a).expanduser().resolve() for a in sys.argv[1:] if Path(a).expanduser().is_file()]
    win = DtNotesWindow(init_files, well)
    win.connect("destroy", Gtk.main_quit)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
