# ---------------------------------------------------------------------------
# Pure-Python RTF Parser & Writer (Supports Bold, Italic, Underline, Strike,
# Headings/Sizes, Unicode \uN?, Windows-1252 \'hh escapes, Paragraphs)
# ---------------------------------------------------------------------------
SKIP_RTF_DESTS = {
    "fonttbl", "colortbl", "stylesheet", "info", "pict", "object",
    "header", "footer", "headerl", "headerr", "footerl", "footerr",
    " listtable", "listtable", "listoverridetable", "rsidtbl", "generator",
}


def parse_rtf_to_runs(rtf_text: str) -> list[tuple[str, set[str]]]:
    """Parse an RTF document into [(text_chunk, {tag_names}), ...]."""
    runs: list[tuple[str, set[str]]] = []
    buf: list[str] = []

    state = {"b": False, "i": False, "ul": False, "strike": False, "fs": 24, "uc": 1, "skip": False}
    stack: list[dict] = []

    def current_tags() -> set[str]:
        t = set()
        if state["b"]:
            t.add("bold")
        if state["i"]:
            t.add("italic")
        if state["ul"]:
            t.add("underline")
        if state["strike"]:
            t.add("strike")
        fs = state["fs"]
        if fs >= 38:
            t.add("h1")
        elif fs >= 30:
            t.add("h2")
        elif fs >= 26:
            t.add("h3")
        return t

    cur_tags = current_tags()

    def flush():
        nonlocal cur_tags
        if buf:
            runs.append(("".join(buf), set(cur_tags)))
            buf.clear()
        cur_tags = current_tags()

    n = len(rtf_text)
    i = 0
    star_pending = False

    while i < n:
        ch = rtf_text[i]
        if ch == "{":
            flush()
            stack.append(dict(state))
            i += 1
            star_pending = False
        elif ch == "}":
            flush()
            if stack:
                state = stack.pop()
            cur_tags = current_tags()
            i += 1
            star_pending = False
        elif ch == "\\":
            i += 1
            if i >= n:
                break
            nxt = rtf_text[i]
            if nxt in ("\\", "{", "}"):
                if not state["skip"]:
                    buf.append(nxt)
                i += 1
            elif nxt == "*":
                star_pending = True
                i += 1
            elif nxt in ("\r", "\n"):
                if not state["skip"]:
                    buf.append("\n")
                i += 1
            elif nxt == "~":
                if not state["skip"]:
                    buf.append("\u00A0")
                i += 1
            elif nxt == "_":
                if not state["skip"]:
                    buf.append("-")
                i += 1
            elif nxt == "'" and i + 2 < n:
                hex_s = rtf_text[i + 1 : i + 3]
                i += 3
                if not state["skip"]:
                    try:
                        bval = bytes([int(hex_s, 16)])
                        buf.append(bval.decode("cp1252", errors="replace"))
                    except ValueError:
                        pass
            elif nxt.isalpha():
                m = re.match(r"([a-zA-Z]+)(-?\d+)? ?", rtf_text[i:])
                if not m:
                    i += 1
                    continue
                word = m.group(1)
                num_s = m.group(2)
                val = int(num_s) if num_s is not None else None
                i += m.end()

                if star_pending or word in SKIP_RTF_DESTS:
                    state["skip"] = True
                    star_pending = False
                    continue
                star_pending = False
                if state["skip"]:
                    continue

                if word in ("par", "line", "sect", "page"):
                    buf.append("\n")
                elif word == "tab":
                    buf.append("\t")
                elif word in ("bullet",):
                    buf.append("•")
                elif word in ("endash",):
                    buf.append("–")
                elif word in ("emdash",):
                    buf.append("—")
                elif word in ("lquote",):
                    buf.append("‘")
                elif word in ("rquote",):
                    buf.append("’")
                elif word in ("ldblquote",):
                    buf.append("“")
                elif word in ("rdblquote",):
                    buf.append("”")
                elif word == "uc" and val is not None:
                    state["uc"] = max(0, val)
                elif word == "u" and val is not None:
                    cp = val if val >= 0 else (val + 65536)
                    try:
                        buf.append(chr(cp))
                    except ValueError:
                        buf.append("?")
                    # Skip uc fallback replacement chars in RTF
                    skip_left = state["uc"]
                    while skip_left > 0 and i < n:
                        if rtf_text[i : i + 2] == "\\'" and i + 4 <= n:
                            i += 4
                        elif rtf_text[i] not in ("{", "}"):
                            i += 1
                        else:
                            break
                        skip_left -= 1
                elif word == "plain":
                    flush()
                    state["b"] = state["i"] = state["ul"] = state["strike"] = False
                    state["fs"] = 24
                    cur_tags = current_tags()
                elif word == "b":
                    flush()
                    state["b"] = (val != 0)
                    cur_tags = current_tags()
                elif word == "i":
                    flush()
                    state["i"] = (val != 0)
                    cur_tags = current_tags()
                elif word == "ul":
                    flush()
                    state["ul"] = (val != 0)
                    cur_tags = current_tags()
                elif word in ("ulnone", "ul0"):
                    flush()
                    state["ul"] = False
                    cur_tags = current_tags()
                elif word == "strike":
                    flush()
                    state["strike"] = (val != 0)
                    cur_tags = current_tags()
                elif word == "fs" and val is not None:
                    flush()
                    state["fs"] = val
                    cur_tags = current_tags()
            else:
                i += 1
        elif ch in ("\r", "\n"):
            i += 1
        else:
            if not state["skip"]:
                buf.append(ch)
            i += 1

    flush()
    return runs


def serialize_buffer_to_rtf(buf: Gtk.TextBuffer) -> str:
    """Serialize Gtk.TextBuffer with formatting tags into standards-compliant RTF."""
    out = [r"{\rtf1\ansi\deff0{\fonttbl{\f0 DejaVu Sans;}{\f1 DejaVu Sans Mono;}}\uc1\pard\f0\fs22 "]
    it = buf.get_start_iter()
    active: set[str] = set()

    def tag_names_at(itr: Gtk.TextIter) -> set[str]:
        return {t.get_property("name") for t in itr.get_tags() if t.get_property("name")}

    while not it.is_end():
        tags = tag_names_at(it)
        if tags != active:
            # Emit transitions cleanly
            parts = [r"\plain\f0\fs22"]
            if "mono" in tags:
                parts.append(r"\f1")
            if "h1" in tags:
                parts.append(r"\b\fs38")
            elif "h2" in tags:
                parts.append(r"\b\fs30")
            elif "h3" in tags:
                parts.append(r"\b\fs26")
            if "bold" in tags and "h1" not in tags and "h2" not in tags and "h3" not in tags:
                parts.append(r"\b")
            if "italic" in tags:
                parts.append(r"\i")
            if "underline" in tags:
                parts.append(r"\ul")
            if "strike" in tags:
                parts.append(r"\strike")
            out.append("".join(parts) + " ")
            active = tags

        ch = it.get_char()
        if ch == "\n":
            out.append("\\par\n")
        elif ch == "\t":
            out.append("\\tab ")
        elif ch in ("\\", "{", "}"):
            out.append("\\" + ch)
        elif ord(ch) < 128:
            out.append(ch)
        else:
            cp = ord(ch)
            if cp <= 0xFFFF:
                signed = cp if cp < 32768 else (cp - 65536)
                out.append(f"\\u{signed}?")
            else:
                out.append("?")
        it.forward_char()

    out.append("}\n")
    return "".join(out)


# ---------------------------------------------------------------------------
# Lightweight Built-in Markdown -> HTML Renderer (for Live .md Preview)
# ---------------------------------------------------------------------------
def markdown_to_html(md_text: str, paper_hex: str = "#fff7e9") -> str:
    lines = md_text.splitlines()
    html_out = []
    in_code = False
    in_ul = False
    in_ol = False

    def inline_fmt(s: str) -> str:
        s = html.escape(s)
        s = re.sub(r"`([^`]+)`", r"<code>\1</code>", s)
        s = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", s)
        s = re.sub(r"__([^_]+)__", r"<strong>\1</strong>", s)
        s = re.sub(r"\*([^*]+)\*", r"<em>\1</em>", s)
        s = re.sub(r"~~([^~]+)~~", r"<del>\1</del>", s)
        s = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r'<a href="\2">\1</a>', s)
        return s

    def close_lists():
        nonlocal in_ul, in_ol
        if in_ul:
            html_out.append("</ul>")
            in_ul = False
        if in_ol:
            html_out.append("</ol>")
            in_ol = False

    for ln in lines:
        if ln.strip().startswith("```"):
            close_lists()
            if not in_code:
                html_out.append("<pre><code>")
                in_code = True
            else:
                html_out.append("</code></pre>")
                in_code = False
            continue
        if in_code:
            html_out.append(html.escape(ln))
            continue

        stripped = ln.strip()
        if not stripped:
            close_lists()
            continue

        m_h = re.match(r"^(#{1,6})\s+(.*)$", stripped)
        if m_h:
            close_lists()
            lvl = len(m_h.group(1))
            html_out.append(f"<h{lvl}>{inline_fmt(m_h.group(2))}</h{lvl}>")
            continue

        if re.match(r"^(\-{3,}|\*{3,}|_{3,})$", stripped):
            close_lists()
            html_out.append("<hr/>")
            continue

        if stripped.startswith(">"):
            close_lists()
            html_out.append(f"<blockquote>{inline_fmt(stripped.lstrip('> '))}</blockquote>")
            continue

        m_ul = re.match(r"^[\-\*\+]\s+(.*)$", stripped)
        if m_ul:
            if in_ol:
                html_out.append("</ol>"); in_ol = False
            if not in_ul:
                html_out.append("<ul>"); in_ul = True
            item_txt = m_ul.group(1)
            if item_txt.startswith("[x] ") or item_txt.startswith("[X] "):
                html_out.append(f"<li>☑ {inline_fmt(item_txt[4:])}</li>")
            elif item_txt.startswith("[ ] "):
                html_out.append(f"<li>☐ {inline_fmt(item_txt[4:])}</li>")
            else:
                html_out.append(f"<li>{inline_fmt(item_txt)}</li>")
            continue

        m_ol = re.match(r"^\d+\.\s+(.*)$", stripped)
        if m_ol:
            if in_ul:
                html_out.append("</ul>"); in_ul = False
            if not in_ol:
                html_out.append("<ol>"); in_ol = True
            html_out.append(f"<li>{inline_fmt(m_ol.group(1))}</li>")
            continue

        close_lists()
        html_out.append(f"<p>{inline_fmt(stripped)}</p>")

    close_lists()
    if in_code:
        html_out.append("</code></pre>")

    body = "\n".join(html_out)
    return f"""<!DOCTYPE html><html><head><meta charset="utf-8"/>
    <style>
      body {{ background: {paper_hex}; color: #141418; font-family: "DejaVu Sans", sans-serif;
              font-size: 11pt; line-height: 1.5; margin: 14px 18px; }}
      h1, h2, h3 {{ color: #1e3d5c; border-bottom: 1px solid #b5bac9; padding-bottom: 3px; }}
      code {{ background: #e6e4d8; padding: 1px 4px; font-family: "DejaVu Sans Mono", monospace; font-size: 10pt; }}
      pre {{ background: #e6e4d8; padding: 10px; border: 1px solid #9aa0b2; overflow-x: auto; }}
      pre code {{ background: none; padding: 0; }}
      blockquote {{ border-left: 4px solid #2c567e; margin: 8px 0; padding: 2px 12px; color: #353a47; }}
      a {{ color: #185abd; }}
    </style></head><body>{body}</body></html>"""


