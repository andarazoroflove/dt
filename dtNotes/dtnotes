class NoteTab(Gtk.Box):
    def __init__(self, paper_hex: str, file_path: Path | None = None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.paper_hex = paper_hex
        self.file_path: Path | None = file_path
        self.doc_mode: str = "txt"  # "txt", "md", "rtf"
        self.modified: bool = False
        self._loading: bool = False

        self.lang_mgr = GtkSource.LanguageManager.get_default()
        self.buf = GtkSource.Buffer()
        self._init_rich_tags()

        self.view = GtkSource.View.new_with_buffer(self.buf)
        self.view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.view.set_show_line_numbers(False)
        self.view.set_tab_width(4)
        self.view.set_left_margin(8)
        self.view.set_right_margin(8)
        self.view.set_top_margin(6)
        self.view.set_bottom_margin(6)

        self.paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL, wide_handle=True)
        fr_ed = Gtk.Frame(margin=2)
        sc_ed = Gtk.ScrolledWindow(hexpand=True, vexpand=True)
        sc_ed.add(self.view)
        fr_ed.add(sc_ed)
        self.paned.pack1(fr_ed, resize=True, shrink=False)

        self.fr_prev = Gtk.Frame(label=" Markdown Preview ", margin=2)
        self.webview = WebKit2.WebView()
        self.webview.get_settings().set_enable_javascript(False)
        self.fr_prev.add(self.webview)
        self.paned.pack2(self.fr_prev, resize=True, shrink=False)

        self.pack_start(self.paned, True, True, 0)
        self.show_all()
        self.fr_prev.hide()

        self.buf.connect("changed", self._on_buf_changed)

        if file_path and file_path.is_file():
            self.load_from_disk(file_path)

    def _init_rich_tags(self):
        tt = self.buf.get_tag_table()
        tt.add(Gtk.TextTag(name="bold", weight=Pango.Weight.BOLD))
        tt.add(Gtk.TextTag(name="italic", style=Pango.Style.ITALIC))
        tt.add(Gtk.TextTag(name="underline", underline=Pango.Underline.SINGLE))
        tt.add(Gtk.TextTag(name="strike", strikethrough=True))
        tt.add(Gtk.TextTag(name="mono", family="DejaVu Sans Mono"))
        tt.add(Gtk.TextTag(name="h1", weight=Pango.Weight.BOLD, scale=1.65))
        tt.add(Gtk.TextTag(name="h2", weight=Pango.Weight.BOLD, scale=1.35))
        tt.add(Gtk.TextTag(name="h3", weight=Pango.Weight.BOLD, scale=1.15))

    def load_from_disk(self, path: Path):
        self._loading = True
        try:
            self.file_path = path.resolve()
            ext = path.suffix.lower()
            raw = path.read_bytes()
            text = raw.decode("utf-8", errors="replace")

            self.buf.set_text("")
            if ext == ".rtf" or text.lstrip().startswith(r"{\rtf"):
                self.doc_mode = "rtf"
                self.buf.set_language(None)
                self.buf.set_highlight_syntax(False)
                # RTF files use cp1252/ascii container
                rtf_s = raw.decode("latin-1", errors="replace")
                runs = parse_rtf_to_runs(rtf_s)
                end_it = self.buf.get_end_iter()
                for chunk, tags in runs:
                    if not chunk:
                        continue
                    if tags:
                        self.buf.insert_with_tags_by_name(end_it, chunk, *tags)
                    else:
                        self.buf.insert(end_it, chunk)
                    end_it = self.buf.get_end_iter()
                self.fr_prev.hide()
            elif ext in (".md", ".markdown"):
                self.doc_mode = "md"
                lang = self.lang_mgr.get_language("markdown")
                self.buf.set_language(lang)
                self.buf.set_highlight_syntax(bool(lang))
                self.buf.set_text(text)
                self.fr_prev.show()
                self.paned.set_position(460)
                self.refresh_md_preview()
            else:
                self.doc_mode = "txt"
                lang = self.lang_mgr.guess_language(str(path), None)
                self.buf.set_language(lang)
                self.buf.set_highlight_syntax(bool(lang))
                self.buf.set_text(text)
                self.fr_prev.hide()

            self.buf.place_cursor(self.buf.get_start_iter())
            self.modified = False
        finally:
            self._loading = False

    def save_to_disk(self, path: Path):
        self.file_path = path.resolve()
        ext = path.suffix.lower()
        if ext == ".rtf":
            self.doc_mode = "rtf"
            rtf_out = serialize_buffer_to_rtf(self.buf)
            path.write_text(rtf_out, encoding="ascii", errors="replace")
        else:
            if ext in (".md", ".markdown"):
                self.doc_mode = "md"
                lang = self.lang_mgr.get_language("markdown")
                self.buf.set_language(lang)
                self.buf.set_highlight_syntax(bool(lang))
            else:
                self.doc_mode = "txt"
            start, end = self.buf.get_bounds()
            txt = self.buf.get_text(start, end, True)
            path.write_text(txt, encoding="utf-8")
        self.modified = False

    def refresh_md_preview(self):
        if not self.fr_prev.get_visible():
            return
        start, end = self.buf.get_bounds()
        md_txt = self.buf.get_text(start, end, True)
        self.webview.load_html(markdown_to_html(md_txt, self.paper_hex), "file:///")

    def _on_buf_changed(self, *_args):
        if self._loading:
            return
        self.modified = True
        if self.fr_prev.get_visible():
            self.refresh_md_preview()

    def title_label(self) -> str:
        name = self.file_path.name if self.file_path else "Untitled.txt"
        return ("* " + name) if self.modified else name


