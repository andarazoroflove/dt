        self.btn_col2 = Gtk.ToggleButton(active=False)
        self.btn_col2.set_tooltip_text("Color 2 (Background / Fill / Eraser — Right Mouse Button)")
        self.da_col2 = Gtk.DrawingArea(); self.da_col2.set_size_request(26, 22)
        self.da_col2.connect("draw", lambda _w, cr: self._draw_swatch(cr, self.color2))
        v2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
