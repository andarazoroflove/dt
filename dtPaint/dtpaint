        self.da_col1 = Gtk.DrawingArea(); self.da_col1.set_size_request(26, 22)
        self.da_col1.connect("draw", lambda _w, cr: self._draw_swatch(cr, self.color1))
        v1 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
