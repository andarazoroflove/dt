# ---------------------------------------------------------------------------
# Universal Image Decoder & Encoder (100% compatible with dtPics)
# ---------------------------------------------------------------------------
def hex_to_rgba(h: str, alpha: int = 255) -> tuple[int, int, int, int]:
    s = h.lstrip("#")
    if len(s) != 6:
        return (0, 0, 0, alpha)
    return (int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16), alpha)


def pixbuf_to_pil(pb: GdkPixbuf.Pixbuf) -> Image.Image:
    pb_o = pb.apply_embedded_orientation() or pb
    w, h = pb_o.get_width(), pb_o.get_height()
    rs = pb_o.get_rowstride()
    mode = "RGBA" if pb_o.get_has_alpha() else "RGB"
    im = Image.frombytes(mode, (w, h), pb_o.get_pixels(), "raw", mode, rs)
    return im.convert("RGBA")


def pil_to_pixbuf(im: Image.Image) -> GdkPixbuf.Pixbuf:
    rgba = im.convert("RGBA")
    data = GLib.Bytes.new(rgba.tobytes())
    return GdkPixbuf.Pixbuf.new_from_bytes(
        data, GdkPixbuf.Colorspace.RGB, True, 8, rgba.width, rgba.height, rgba.width * 4
    )


def pil_to_cairo_surface(im: Image.Image) -> cairo.ImageSurface:
    rgba = im.convert("RGBA")
    r, g, b, a = rgba.split()
    if a.getextrema()[0] < 255:
        pb = pil_to_pixbuf(rgba)
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, rgba.width, rgba.height)
        cr = cairo.Context(surf)
        Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
        cr.paint()
        return surf
    bgra = Image.merge("RGBA", (b, g, r, a))
    buf = bytearray(bgra.tobytes("raw", "RGBA"))
    return cairo.ImageSurface.create_for_data(buf, cairo.FORMAT_ARGB32, rgba.width, rgba.height, rgba.width * 4)


def load_image_universal(path: Path) -> tuple[Image.Image, str]:
    ext = path.suffix.lower()
    if ext not in (".heic", ".heif", ".avif", ".jxl", ".svg", ".svgz", ".xpm"):
        try:
            with Image.open(path) as src:
                fmt = src.format or ext.lstrip(".").upper() or "IMAGE"
                oriented = ImageOps.exif_transpose(src)
                return oriented.convert("RGBA"), fmt
        except Exception:
            pass
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file(str(path))
        if pb is not None:
            return pixbuf_to_pil(pb), ext.lstrip(".").upper() or "PIXBUF"
    except Exception:
        pass
    if MAGICK_BIN:
        res = subprocess.run([MAGICK_BIN, f"{path}[0]", "-auto-orient", "png:-"], capture_output=True)
        if res.returncode == 0 and res.stdout:
            with Image.open(io.BytesIO(res.stdout)) as im:
                return im.convert("RGBA"), ext.lstrip(".").upper() or "IMAGE"
    raise RuntimeError(f"Unsupported or corrupted image file: {path.name}")


def save_image_universal(im: Image.Image, out_path: Path):
    ext = out_path.suffix.lower()
    out_path.parent.mkdir(parents=True, exist_ok=True)

    if ext in (".jpg", ".jpeg", ".jpe", ".jfif", ".bmp", ".ppm"):
        bg = Image.new("RGB", im.size, (255, 255, 255))
        rgba = im.convert("RGBA")
        bg.paste(rgba, mask=rgba.split()[3])
        if ext in (".jpg", ".jpeg", ".jpe", ".jfif"):
            bg.save(out_path, format="JPEG", quality=94, optimize=True)
        elif ext == ".bmp":
            bg.save(out_path, format="BMP")
        else:
            bg.save(out_path, format="PPM")
        return

    if ext == ".webp":
        im.convert("RGBA").save(out_path, format="WEBP", quality=92)
        return
    if ext in (".tif", ".tiff"):
        im.convert("RGBA").save(out_path, format="TIFF", compression="tiff_adobe_deflate")
        return
    if ext == ".gif":
        im.convert("RGBA").save(out_path, format="GIF")
        return
    if ext == ".ico":
        sz = min(256, max(im.width, im.height))
        im.convert("RGBA").resize((sz, sz), Image.Resampling.LANCZOS).save(out_path, format="ICO")
        return
    if ext in (".heic", ".heif", ".avif", ".xpm") and MAGICK_BIN:
        with tempfile.NamedTemporaryFile(suffix=".png", delete=False) as tf:
            tmp_png = Path(tf.name)
        try:
            im.convert("RGBA").save(tmp_png, format="PNG")
            res = subprocess.run([MAGICK_BIN, str(tmp_png), str(out_path)], capture_output=True, text=True)
            if res.returncode != 0:
                raise RuntimeError(res.stderr.strip() or f"Could not encode {ext}")
        finally:
            tmp_png.unlink(missing_ok=True)
        return

    im.convert("RGBA").save(out_path, format="PNG")


# ---------------------------------------------------------------------------
# Vector Geometry & Shape Path Builder (Cairo)
# ---------------------------------------------------------------------------
def build_shape_path(cr: cairo.Context, kind: str, x0: float, y0: float, x1: float, y1: float,
                     ctrl_pt: tuple[float, float] | None = None):
    lx, rx = min(x0, x1), max(x0, x1)
    ty, by = min(y0, y1), max(y0, y1)
    w = max(1.0, rx - lx)
    h = max(1.0, by - ty)
    cx, cy = lx + w * 0.5, ty + h * 0.5

    if kind == "line":
        cr.move_to(x0, y0)
        cr.line_to(x1, y1)
        return False  # open path (not fillable)

    if kind == "curve":
        cr.move_to(x0, y0)
        if ctrl_pt is not None:
            mx, my = ctrl_pt
            # Quadratic to cubic Bezier
            c1x = x0 + (2.0 / 3.0) * (mx - x0)
            c1y = y0 + (2.0 / 3.0) * (my - y0)
            c2x = x1 + (2.0 / 3.0) * (mx - x1)
            c2y = y1 + (2.0 / 3.0) * (my - y1)
            cr.curve_to(c1x, c1y, c2x, c2y, x1, y1)
        else:
            cr.line_to(x1, y1)
        return False

    if kind == "rect":
        cr.rectangle(lx, ty, w, h)
        return True

    if kind == "rrect":
        rad = min(w, h) * 0.22
        cr.new_sub_path()
        cr.arc(rx - rad, ty + rad, rad, -math.pi / 2, 0)
        cr.arc(rx - rad, by - rad, rad, 0, math.pi / 2)
        cr.arc(lx + rad, by - rad, rad, math.pi / 2, math.pi)
        cr.arc(lx + rad, ty + rad, rad, math.pi, 3 * math.pi / 2)
        cr.close_path()
        return True

    if kind == "oval":
        cr.save()
        cr.translate(cx, cy)
        cr.scale(w * 0.5, h * 0.5)
        cr.arc(0, 0, 1.0, 0, 2 * math.pi)
        cr.restore()
        cr.close_path()
        return True

    pts: list[tuple[float, float]] = []
    if kind == "tri":
        pts = [(cx, ty), (rx, by), (lx, by)]
    elif kind == "rtri":
        pts = [(lx, ty), (rx, by), (lx, by)]
    elif kind == "diamond":
        pts = [(cx, ty), (rx, cy), (cx, by), (lx, cy)]
    elif kind == "pentagon":
        for i in range(5):
            a = -math.pi / 2 + i * 2 * math.pi / 5
            pts.append((cx + w * 0.5 * math.cos(a), cy + h * 0.5 * math.sin(a)))
    elif kind == "hexagon":
        for i in range(6):
            a = -math.pi / 2 + i * 2 * math.pi / 6
            pts.append((cx + w * 0.5 * math.cos(a), cy + h * 0.5 * math.sin(a)))
    elif kind == "arrow_r":
        pts = [
            (lx, ty + h * 0.28), (lx + w * 0.55, ty + h * 0.28), (lx + w * 0.55, ty),
            (rx, cy),
            (lx + w * 0.55, by), (lx + w * 0.55, ty + h * 0.72), (lx, ty + h * 0.72),
        ]
    elif kind == "arrow_l":
        pts = [
            (rx, ty + h * 0.28), (lx + w * 0.45, ty + h * 0.28), (lx + w * 0.45, ty),
            (lx, cy),
            (lx + w * 0.45, by), (lx + w * 0.45, ty + h * 0.72), (rx, ty + h * 0.72),
        ]
    elif kind == "arrow_u":
        pts = [
            (cx, ty), (rx, ty + h * 0.45), (lx + w * 0.72, ty + h * 0.45),
            (lx + w * 0.72, by), (lx + w * 0.28, by),
            (lx + w * 0.28, ty + h * 0.45), (lx, ty + h * 0.45),
        ]
    elif kind == "arrow_d":
        pts = [
            (lx + w * 0.28, ty), (lx + w * 0.72, ty), (lx + w * 0.72, ty + h * 0.55),
            (rx, ty + h * 0.55), (cx, by),
            (lx, ty + h * 0.55), (lx + w * 0.28, ty + h * 0.55),
        ]
    elif kind in ("star4", "star5", "star6"):
        n = int(kind[-1])
        inner = 0.38 if n != 6 else 0.52
        for i in range(n * 2):
            r_f = 0.5 if (i % 2 == 0) else (0.5 * inner)
            a = -math.pi / 2 + i * math.pi / n
            pts.append((cx + w * r_f * math.cos(a), cy + h * r_f * math.sin(a)))
    elif kind == "callout":
        bh = h * 0.75
        pts = [
            (lx, ty), (rx, ty), (rx, ty + bh),
            (lx + w * 0.42, ty + bh), (lx + w * 0.20, by),
            (lx + w * 0.24, ty + bh), (lx, ty + bh),
        ]
    elif kind == "bolt":
        pts = [
            (lx + w * 0.45, ty), (rx * 0.92 + lx * 0.08, ty),
            (lx + w * 0.56, ty + h * 0.44), (rx, ty + h * 0.44),
            (lx + w * 0.22, by), (lx + w * 0.40, ty + h * 0.55),
            (lx + w * 0.12, ty + h * 0.55),
        ]
    elif kind == "heart":
        cr.move_to(cx, by)
        cr.curve_to(lx - w * 0.12, ty + h * 0.55, lx, ty - h * 0.05, cx, ty + h * 0.28)
        cr.curve_to(rx, ty - h * 0.05, rx + w * 0.12, ty + h * 0.55, cx, by)
        cr.close_path()
        return True

    if pts:
        cr.move_to(*pts[0])
        for px, py in pts[1:]:
            cr.line_to(px, py)
        cr.close_path()
    return True


def make_shape_icon_pixbuf(kind: str, sz: int = 18) -> GdkPixbuf.Pixbuf:
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, sz, sz)
    cr = cairo.Context(surf)
    cr.set_line_width(1.5)
    closed = build_shape_path(cr, kind, 2.5, 2.5, sz - 2.5, sz - 2.5, (sz * 0.5, 1.0) if kind == "curve" else None)
    if closed:
        cr.set_source_rgba(0.88, 0.91, 0.97, 0.85)
        cr.fill_preserve()
    cr.set_source_rgb(0.12, 0.16, 0.24)
    cr.stroke()
    surf.flush()
    return Gdk.pixbuf_get_from_surface(surf, 0, 0, sz, sz)


def make_tool_icon_pixbuf(kind: str, sz: int = 20) -> GdkPixbuf.Pixbuf:
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, sz, sz)
    cr = cairo.Context(surf)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)

    if kind == "select":
        cr.set_source_rgb(0.12, 0.22, 0.45)
        cr.set_dash([2.5, 2.0])
        cr.set_line_width(1.5)
        cr.rectangle(2.5, 3.5, sz - 5, sz - 7)
        cr.stroke()
    elif kind == "lasso":
        cr.set_source_rgb(0.12, 0.22, 0.45)
        cr.set_dash([2.5, 2.0])
        cr.set_line_width(1.5)
        cr.arc(sz * 0.5, sz * 0.48, sz * 0.34, 0, 2 * math.pi)
        cr.stroke()
    elif kind == "pencil":
        cr.set_source_rgb(0.90, 0.68, 0.15)
        cr.move_to(4, sz - 4); cr.line_to(7, sz - 9); cr.line_to(sz - 4, 3); cr.line_to(sz - 2, 6); cr.line_to(8, sz - 6); cr.close_path()
        cr.fill_preserve()
        cr.set_source_rgb(0.15, 0.15, 0.20); cr.set_line_width(1.2); cr.stroke()
    elif kind == "fill":
        cr.set_source_rgb(0.20, 0.45, 0.78)
        cr.move_to(5, 9); cr.line_to(11, 3); cr.line_to(16, 8); cr.line_to(10, 14); cr.close_path()
        cr.fill_preserve()
        cr.set_source_rgb(0.12, 0.12, 0.16); cr.set_line_width(1.2); cr.stroke()
        cr.set_source_rgb(0.85, 0.18, 0.22)
        cr.arc(15.5, 14.5, 2.5, 0, 2 * math.pi); cr.fill()
    elif kind == "text":
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(Pango.FontDescription("DejaVu Serif Bold 13"))
        layout.set_text("A", -1)
        cr.set_source_rgb(0.10, 0.12, 0.18)
        cr.move_to(4, 1)
        PangoCairo.show_layout(cr, layout)
    elif kind == "eraser":
        cr.set_source_rgb(0.96, 0.62, 0.68)
        cr.move_to(4, 13); cr.line_to(10, 5); cr.line_to(16, 9); cr.line_to(10, 17); cr.close_path()
        cr.fill_preserve()
        cr.set_source_rgb(0.20, 0.15, 0.18); cr.set_line_width(1.2); cr.stroke()
    elif kind == "picker":
        cr.set_source_rgb(0.22, 0.58, 0.68)
        cr.set_line_width(2.5)
        cr.move_to(4, sz - 4); cr.line_to(13, 7); cr.stroke()
        cr.set_source_rgb(0.15, 0.15, 0.20)
        cr.arc(14.5, 5.5, 3.0, 0, 2 * math.pi); cr.fill()
    elif kind == "zoom":
        cr.set_source_rgba(0.75, 0.88, 0.98, 0.8)
        cr.arc(8.5, 8.5, 5.2, 0, 2 * math.pi); cr.fill_preserve()
        cr.set_source_rgb(0.15, 0.18, 0.25); cr.set_line_width(1.6); cr.stroke()
        cr.set_line_width(2.4)
        cr.move_to(12.5, 12.5); cr.line_to(17, 17); cr.stroke()
    elif kind == "brush":
        cr.set_source_rgb(0.55, 0.34, 0.16)
        cr.set_line_width(2.6)
        cr.move_to(16, 3); cr.line_to(8, 11); cr.stroke()
        cr.set_source_rgb(0.18, 0.42, 0.78)
        cr.arc(6.5, 13.5, 3.5, 0, 2 * math.pi); cr.fill()

    surf.flush()
    return Gdk.pixbuf_get_from_surface(surf, 0, 0, sz, sz)


