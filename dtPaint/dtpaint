    def _draw_swatch(self, cr: cairo.Context, hex_c: str):
        alloc = cr.get_target()
        r, g, b, _ = hex_to_rgba(hex_c)
        cr.set_source_rgb(r / 255.0, g / 255.0, b / 255.0)
        cr.paint()
        cr.set_source_rgba(0, 0, 0, 0.55)
        cr.set_line_width(1.0)
        cr.rectangle(0.5, 0.5, 200, 200)
        cr.stroke()
        return False

    # ---------------- State, Colors & Tool Switching ----------------
    def set_status(self, msg: str):
        self.lbl_status.set_text(msg)

    def _update_status_meta(self):
        name = self.current_path.name if self.current_path else "Untitled"
        star = "* " if self.modified else ""
        self.set_title(f"{star}{name} — dtPaint")
        sel_txt = ""
        if self.sel_rect:
            sel_txt = f"Sel: {int(abs(self.sel_rect[2]))} × {int(abs(self.sel_rect[3]))} px   |   "
        self.lbl_dims.set_text(f"{sel_txt}Canvas: {self.img.width} × {self.img.height} px ({self.fmt_name})")
        self.lbl_zoom.set_text(f"{int(round(self.zoom * 100))}%")

    def _refresh_canvas_size(self):
        pad = 48
        w = int(self.img.width * self.zoom) + pad
        h = int(self.img.height * self.zoom) + pad
        self.canvas.set_size_request(w, h)
        self.canvas.queue_draw()

    def set_zoom(self, z: float):
        self.zoom = max(0.10, min(16.0, z))
        self._refresh_canvas_size()
        self._update_status_meta()

    def zoom_to_fit(self, *_args):
        alloc = self.scroll.get_allocation()
        zw = (alloc.width - 48) / float(max(1, self.img.width))
        zh = (alloc.height - 48) / float(max(1, self.img.height))
        self.set_zoom(max(0.10, min(8.0, min(zw, zh))))

    def _push_undo(self):
        self.undo_stack.append(self.img.copy())
        if len(self.undo_stack) > 30:
            self.undo_stack.pop(0)
        self.redo_stack.clear()

    def _set_img(self, new_im: Image.Image, mark_mod: bool = True):
        self.img = new_im.convert("RGBA")
        self.cairo_surf = pil_to_cairo_surface(self.img)
        if mark_mod:
            self.modified = True
        self._refresh_canvas_size()
        self._update_status_meta()

    def _on_slot_toggled(self, btn: Gtk.ToggleButton, slot: int):
        if self._updating_btns:
            return
        self._updating_btns = True
        if slot == 1:
            self.active_color_slot = 1
            self.btn_col1.set_active(True)
            self.btn_col2.set_active(False)
        else:
            self.active_color_slot = 2
            self.btn_col1.set_active(False)
            self.btn_col2.set_active(True)
        self._updating_btns = False

    def _on_palette_swatch_press(self, _w, ev, hex_c: str):
        if ev.button == 3:
            self.color2 = hex_c
        else:
            if self.active_color_slot == 1:
                self.color1 = hex_c
            else:
                self.color2 = hex_c
        self.da_col1.queue_draw()
        self.da_col2.queue_draw()
        self.canvas.queue_draw()
        return True

