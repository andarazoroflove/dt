    def _on_tool_toggled(self, btn: Gtk.ToggleButton, tid: str):
        if self._updating_btns:
            return
        if btn.get_active():
            self.set_tool(tid)
        elif self.tool == tid:
            self._updating_btns = True
            btn.set_active(True)
            self._updating_btns = False

    def set_tool(self, tid: str):
        # Commit any active floating selection or curve or text before switching
        if tid != self.tool:
            self.commit_floating_selection()
            self._commit_pending_curve()
            if self.tool == "text":
                self.commit_text_box()

        if self.tool not in ("picker", "zoom", "select", "lasso"):
            self.prev_draw_tool = self.tool

        self.tool = tid
        self._updating_btns = True
        for k, b in self.tool_toggles.items():
            b.set_active(k == tid)
        self._updating_btns = False

        if tid == "text":
            self.text_bar.show_all()
            if self.text_anchor is None:
                self.text_anchor = (40, 40)
            self.ent_text.grab_focus()
            self.set_status("Text Tool — Click anywhere on canvas to move text anchor, type above, click Stamp Text.")
        else:
            self.text_bar.hide()
            self.text_anchor = None
            label = tid.split(":", 1)[1].upper() if tid.startswith("shape:") else tid.capitalize()
            self.set_status(f"Tool: {label} — Left-click uses Color 1, Right-click uses Color 2 (Hold Shift to constrain).")
        self.canvas.queue_draw()

    # ---------------- Floating Selection Engine ----------------
    def commit_floating_selection(self):
        if self.sel_img is not None and self.sel_rect is not None:
            x, y, w, h = [int(round(v)) for v in self.sel_rect]
            if w > 0 and h > 0:
                scaled = self.sel_img.resize((w, h), Image.Resampling.NEAREST if self.zoom >= 3 else Image.Resampling.BILINEAR)
                stamped = self._prepare_sel_image(scaled)
                out = self.img.copy()
                out.paste(stamped, (x, y), stamped)
                self._set_img(out, mark_mod=True)
        self.sel_img = None
        self.sel_rect = None
        self._sel_dragging_new = False
        self._sel_moving = False
        self._lasso_pts.clear()
        self._update_status_meta()

    def _prepare_sel_image(self, im: Image.Image) -> Image.Image:
        rgba = im.convert("RGBA")
        if not self.transparent_sel:
            return rgba
        # Key out Color 2 pixels within small tolerance (classic MS Paint transparent selection!)
        c2r, c2g, c2b, _ = hex_to_rgba(self.color2)
        px = bytearray(rgba.tobytes())
        for i in range(0, len(px), 4):
            if abs(px[i] - c2r) <= 6 and abs(px[i + 1] - c2g) <= 6 and abs(px[i + 2] - c2b) <= 6:
                px[i + 3] = 0
        return Image.frombytes("RGBA", rgba.size, bytes(px))

    def _lift_rect_selection(self, x0: int, y0: int, x1: int, y1: int):
        lx = max(0, min(self.img.width - 1, min(x0, x1)))
        ty = max(0, min(self.img.height - 1, min(y0, y1)))
        rx = max(lx + 1, min(self.img.width, max(x0, x1)))
        by = max(ty + 1, min(self.img.height, max(y0, y1)))
        if rx - lx < 2 or by - ty < 2:
            self.sel_rect = None
            return
        self._push_undo()
        self.sel_img = self.img.crop((lx, ty, rx, by)).copy()
        # Fill underlying hole with Color 2 (true MS Paint behavior when lifting selection!)
        hole = self.img.copy()
        draw = ImageDraw.Draw(hole)
        draw.rectangle([lx, ty, rx - 1, by - 1], fill=hex_to_rgba(self.color2))
        self._set_img(hole, mark_mod=True)
        self.sel_rect = [float(lx), float(ty), float(rx - lx), float(by - ty)]
        self._update_status_meta()

    def _lift_lasso_selection(self, pts: list[tuple[float, float]]):
        if len(pts) < 3:
            return
        xs = [p[0] for p in pts]
        ys = [p[1] for p in pts]
        lx = max(0, int(math.floor(min(xs))))
        ty = max(0, int(math.floor(min(ys))))
        rx = min(self.img.width, int(math.ceil(max(xs))) + 1)
        by = min(self.img.height, int(math.ceil(max(ys))) + 1)
        if rx - lx < 3 or by - ty < 3:
            return
        mask = Image.new("L", (rx - lx, by - ty), 0)
        rel_pts = [(p[0] - lx, p[1] - ty) for p in pts]
        ImageDraw.Draw(mask).polygon(rel_pts, fill=255)

        self._push_undo()
        crop = self.img.crop((lx, ty, rx, by)).convert("RGBA")
        lifted = Image.new("RGBA", crop.size, (0, 0, 0, 0))
        lifted.paste(crop, (0, 0), mask)
        self.sel_img = lifted

        hole = self.img.copy()
        bg_patch = Image.new("RGBA", crop.size, hex_to_rgba(self.color2))
        hole.paste(bg_patch, (lx, ty), mask)
        self._set_img(hole, mark_mod=True)
        self.sel_rect = [float(lx), float(ty), float(rx - lx), float(by - ty)]
        self._update_status_meta()

    # ---------------- Clipboard & Image Commands ----------------
    def on_select_all(self, *_args):
        self.set_tool("select")
        self._lift_rect_selection(0, 0, self.img.width, self.img.height)
        self.set_status("Selected entire canvas.")

    def on_copy(self, *_args):
        src = self.sel_img if self.sel_img is not None else self.img
        cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        cb.set_image(pil_to_pixbuf(src))
        cb.store()
        self.set_status("Copied to clipboard.")

    def on_cut(self, *_args):
        if self.sel_img is None:
            self.on_select_all()
        if self.sel_img is not None:
            self.on_copy()
            self.sel_img = None
            self.sel_rect = None
            self.canvas.queue_draw()
            self._update_status_meta()
            self.set_status("Cut selection to clipboard.")

    def on_delete_selection(self, *_args):
        if self.sel_img is not None:
            self.sel_img = None
            self.sel_rect = None
            self.canvas.queue_draw()
            self._update_status_meta()
            self.set_status("Deleted selection.")

    def on_paste(self, *_args):
        cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        pb = cb.wait_for_image()
        if pb is None:
            self.set_status("Clipboard does not contain an image.")
            return
        self.commit_floating_selection()
        self.set_tool("select")
        pasted = pixbuf_to_pil(pb)
        # Expand canvas if pasted image is larger than canvas
        if pasted.width > self.img.width or pasted.height > self.img.height:
            self._push_undo()
            nw = max(self.img.width, pasted.width)
            nh = max(self.img.height, pasted.height)
            expanded = Image.new("RGBA", (nw, nh), hex_to_rgba(self.color2))
            expanded.paste(self.img, (0, 0))
            self._set_img(expanded, mark_mod=True)
        else:
            self._push_undo()
        self.sel_img = pasted
        self.sel_rect = [0.0, 0.0, float(pasted.width), float(pasted.height)]
        self.canvas.queue_draw()
        self._update_status_meta()
        self.set_status("Pasted image as floating selection — drag to position, click outside to stamp.")

    def on_crop(self, *_args):
        if self.sel_img is not None and self.sel_rect is not None:
            w = max(1, int(round(self.sel_rect[2])))
            h = max(1, int(round(self.sel_rect[3])))
            cropped = self.sel_img.resize((w, h), Image.Resampling.LANCZOS)
            self.sel_img = None
            self.sel_rect = None
            self._set_img(cropped, mark_mod=True)
            self.set_status(f"Cropped canvas to {w} × {h} px.")
        else:
            self.set_status("Use Select first to choose a region to crop.")

    def on_resize_skew_dialog(self, *_args):
        self.commit_floating_selection()
        dlg = ResizeSkewDialog(self, self.img.width, self.img.height)
        if dlg.run() == Gtk.ResponseType.OK:
            nw, nh, sx, sy = dlg.get_params()
            dlg.destroy()
            self._push_undo()
            out = self.img.resize((nw, nh), Image.Resampling.LANCZOS)
            if abs(sx) > 0.1 or abs(sy) > 0.1:
                tx = math.tan(math.radians(sx))
                ty = math.tan(math.radians(sy))
                w, h = out.size
                cs = [(0, 0), (w, ty * w), (tx * h, h), (w + tx * h, ty * w + h)]
                min_x, max_x = min(c[0] for c in cs), max(c[0] for c in cs)
                min_y, max_y = min(c[1] for c in cs), max(c[1] for c in cs)
                sw = max(1, int(math.ceil(max_x - min_x)))
                sh = max(1, int(math.ceil(max_y - min_y)))
                det = 1.0 - tx * ty
                if abs(det) > 1e-4:
                    aff = (1 / det, -tx / det, (min_x - tx * min_y) / det,
                           -ty / det, 1 / det, (min_y - ty * min_x) / det)
                    out = out.transform((sw, sh), Image.Transform.AFFINE, aff,
                                        resample=Image.Resampling.BICUBIC, fillcolor=hex_to_rgba(self.color2))
            self._set_img(out, mark_mod=True)
            self.set_status(f"Resized/skewed canvas to {out.width} × {out.height} px.")
        else:
            dlg.destroy()

    def on_rotate_flip(self, op: str):
        target = self.sel_img if self.sel_img is not None else self.img
        if op == "rot_cw":
            res = target.transpose(Image.Transpose.ROTATE_270)
        elif op == "rot_ccw":
            res = target.transpose(Image.Transpose.ROTATE_90)
        elif op == "rot_180":
            res = target.transpose(Image.Transpose.ROTATE_180)
        elif op == "flip_h":
            res = target.transpose(Image.Transpose.FLIP_LEFT_RIGHT)
        else:
            res = target.transpose(Image.Transpose.FLIP_TOP_BOTTOM)

        if self.sel_img is not None and self.sel_rect is not None:
            self.sel_img = res
            if op in ("rot_cw", "rot_ccw"):
                self.sel_rect[2], self.sel_rect[3] = self.sel_rect[3], self.sel_rect[2]
            self.canvas.queue_draw()
        else:
            self._push_undo()
            self._set_img(res, mark_mod=True)

    def on_invert_colors(self, *_args):
        target = self.sel_img if self.sel_img is not None else self.img
        r, g, b, a = target.convert("RGBA").split()
        inv = ImageOps.invert(Image.merge("RGB", (r, g, b)))
        ir, ig, ib = inv.split()
        out = Image.merge("RGBA", (ir, ig, ib, a))
        if self.sel_img is not None:
            self.sel_img = out
            self.canvas.queue_draw()
        else:
            self._push_undo()
            self._set_img(out, mark_mod=True)
        self.set_status("Inverted image colors.")

    def on_clear_canvas(self, *_args):
        self.commit_floating_selection()
        self._push_undo()
        self._set_img(Image.new("RGBA", self.img.size, hex_to_rgba(self.color2)), mark_mod=True)
        self.set_status("Cleared canvas with Color 2.")

    def on_undo(self, *_args):
        self.commit_floating_selection()
        self._commit_pending_curve()
        if not self.undo_stack:
            self.set_status("Nothing to undo.")
            return
        self.redo_stack.append(self.img.copy())
        prev = self.undo_stack.pop()
        self._set_img(prev, mark_mod=bool(self.undo_stack))
        self.set_status("Undid last action.")

    def on_redo(self, *_args):
        if not self.redo_stack:
            self.set_status("Nothing to redo.")
            return
        self.undo_stack.append(self.img.copy())
        nxt = self.redo_stack.pop()
        self._set_img(nxt, mark_mod=True)
        self.set_status("Redid action.")

    # ---------------- File Operations ----------------
    def on_new_canvas(self, *_args):
        self.commit_floating_selection()
        dlg = Gtk.Dialog(title="New Canvas — dtPaint", transient_for=self, flags=0)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Create", Gtk.ResponseType.OK)
        g = Gtk.Grid(column_spacing=8, row_spacing=8, margin=12)
        dlg.get_content_area().add(g)
        sp_w = Gtk.SpinButton.new_with_range(16, 8000, 10); sp_w.set_value(840)
