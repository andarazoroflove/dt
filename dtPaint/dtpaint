# Resize & Skew Dialog (MS Paint Style)
# ---------------------------------------------------------------------------
class ResizeSkewDialog(Gtk.Dialog):
    def __init__(self, parent, cur_w: int, cur_h: int):
        super().__init__(title="Resize and Skew — dtPaint", transient_for=parent, flags=0)
        self.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "OK", Gtk.ResponseType.OK)
        box = self.get_content_area()
        box.set_spacing(10)
        box.set_margin_top(10); box.set_margin_bottom(10); box.set_margin_start(12); box.set_margin_end(12)

        self.orig_w = cur_w
        self.orig_h = cur_h
        self.aspect = cur_w / float(max(1, cur_h))

        fr_r = Gtk.Frame(label=" Resize ")
        gr = Gtk.Grid(column_spacing=8, row_spacing=6, margin=8)
        fr_r.add(gr)

        self.rb_pct = Gtk.RadioButton.new_with_label_from_widget(None, "Percentage (%)")
        self.rb_px = Gtk.RadioButton.new_with_label_from_widget(self.rb_pct, "Pixels (px)")
        self.rb_px.set_active(True)
        gr.attach(self.rb_pct, 0, 0, 1, 1)
        gr.attach(self.rb_px, 1, 0, 1, 1)

        self.sp_w = Gtk.SpinButton.new_with_range(1, 12000, 1); self.sp_w.set_value(cur_w)
        self.sp_h = Gtk.SpinButton.new_with_range(1, 12000, 1); self.sp_h.set_value(cur_h)
        self.chk_aspect = Gtk.CheckButton(label="Maintain aspect ratio", active=True)

        gr.attach(Gtk.Label(label="Horizontal:", xalign=0), 0, 1, 1, 1); gr.attach(self.sp_w, 1, 1, 1, 1)
        gr.attach(Gtk.Label(label="Vertical:", xalign=0), 0, 2, 1, 1);   gr.attach(self.sp_h, 1, 2, 1, 1)
        gr.attach(self.chk_aspect, 0, 3, 2, 1)
        box.pack_start(fr_r, False, False, 0)

        fr_s = Gtk.Frame(label=" Skew (Degrees) ")
        gs = Gtk.Grid(column_spacing=8, row_spacing=6, margin=8)
        fr_s.add(gs)
        self.sp_sx = Gtk.SpinButton.new_with_range(-80, 80, 1); self.sp_sx.set_value(0)
        self.sp_sy = Gtk.SpinButton.new_with_range(-80, 80, 1); self.sp_sy.set_value(0)
        gs.attach(Gtk.Label(label="Horizontal (°):", xalign=0), 0, 0, 1, 1); gs.attach(self.sp_sx, 1, 0, 1, 1)
        gs.attach(Gtk.Label(label="Vertical (°):", xalign=0), 0, 1, 1, 1);   gs.attach(self.sp_sy, 1, 1, 1, 1)
        box.pack_start(fr_s, False, False, 0)

        self._updating = False
        self.rb_pct.connect("toggled", self._on_mode_toggle)
        self.sp_w.connect("value-changed", self._on_w_chg)
        self.sp_h.connect("value-changed", self._on_h_chg)
        self.show_all()

    def _on_mode_toggle(self, *_args):
        self._updating = True
        if self.rb_pct.get_active():
            self.sp_w.set_range(1, 500); self.sp_h.set_range(1, 500)
            self.sp_w.set_value(100); self.sp_h.set_value(100)
        else:
            self.sp_w.set_range(1, 12000); self.sp_h.set_range(1, 12000)
            self.sp_w.set_value(self.orig_w); self.sp_h.set_value(self.orig_h)
        self._updating = False

    def _on_w_chg(self, *_args):
        if self._updating or not self.chk_aspect.get_active():
            return
        self._updating = True
        if self.rb_pct.get_active():
            self.sp_h.set_value(self.sp_w.get_value())
        else:
            self.sp_h.set_value(max(1, round(self.sp_w.get_value() / self.aspect)))
        self._updating = False

    def _on_h_chg(self, *_args):
        if self._updating or not self.chk_aspect.get_active():
            return
        self._updating = True
        if self.rb_pct.get_active():
            self.sp_w.set_value(self.sp_h.get_value())
        else:
            self.sp_w.set_value(max(1, round(self.sp_h.get_value() * self.aspect)))
        self._updating = False

    def get_params(self) -> tuple[int, int, float, float]:
        if self.rb_pct.get_active():
            nw = max(1, int(round(self.orig_w * self.sp_w.get_value() / 100.0)))
            nh = max(1, int(round(self.orig_h * self.sp_h.get_value() / 100.0)))
        else:
            nw = int(self.sp_w.get_value())
            nh = int(self.sp_h.get_value())
        return nw, nh, float(self.sp_sx.get_value()), float(self.sp_sy.get_value())


