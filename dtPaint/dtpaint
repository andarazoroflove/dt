    def open_file(self, path: Path):
        rp = path.expanduser().resolve()
        if not rp.is_file():
            return
        try:
            self.commit_floating_selection()
            im, fmt = load_image_universal(rp)
            self.current_path = rp
            self.fmt_name = fmt
            self.undo_stack.clear()
            self.redo_stack.clear()
            self.modified = False
            self.zoom = 1.0
            self._set_img(im, mark_mod=False)
            self.set_status(f"Opened {rp.name} ({im.width} × {im.height} px, {fmt}).")
        except Exception as exc:
            md = Gtk.MessageDialog(transient_for=self, flags=0, message_type=Gtk.MessageType.ERROR,
                                   buttons=Gtk.ButtonsType.OK, text=f"Could not open {rp.name}:\n{exc}")
            md.run(); md.destroy()

