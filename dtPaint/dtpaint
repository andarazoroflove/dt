    # ---------------- Stroke, Shape & Text Rendering ----------------
    def _stroke_colors(self, mouse_btn: int) -> tuple[str, str]:
        return (self.color2, self.color1) if mouse_btn == 3 else (self.color1, self.color2)

    def _draw_freehand_on_cr(self, cr: cairo.Context, pts: list[tuple[float, float]], mouse_btn: int):
        if not pts:
            return
        fg_hex, bg_hex = self._stroke_colors(mouse_btn)
        if self.tool == "eraser":
            r, g, b, _ = hex_to_rgba(self.color2)
            cr.set_source_rgb(r / 255.0, g / 255.0, b / 255.0)
            sz = max(4.0, self.line_size * 2.2)
            cr.set_line_width(sz)
            cr.set_line_cap(cairo.LINE_CAP_SQUARE)
            cr.set_line_join(cairo.LINE_JOIN_BEVEL)
            cr.move_to(*pts[0])
            for px, py in pts[1:]:
                cr.line_to(px, py)
            if len(pts) == 1:
                cr.line_to(pts[0][0] + 0.01, pts[0][1] + 0.01)
            cr.stroke()
            return

        r, g, b, _ = hex_to_rgba(fg_hex)
        if self.tool == "pencil":
            cr.set_antialias(cairo.ANTIALIAS_NONE)
            cr.set_source_rgb(r / 255.0, g / 255.0, b / 255.0)
            cr.set_line_width(1.0)
            cr.move_to(math.floor(pts[0][0]) + 0.5, math.floor(pts[0][1]) + 0.5)
            for px, py in pts[1:]:
                cr.line_to(math.floor(px) + 0.5, math.floor(py) + 0.5)
            if len(pts) == 1:
                cr.rectangle(math.floor(pts[0][0]), math.floor(pts[0][1]), 1, 1)
                cr.fill()
            else:
                cr.stroke()
            cr.set_antialias(cairo.ANTIALIAS_DEFAULT)
            return

        # Brushes
        alpha = 0.38 if self.brush_style == "marker" else 1.0
        cr.set_source_rgba(r / 255.0, g / 255.0, b / 255.0, alpha)
        lw = max(1.0, self.line_size * (2.2 if self.brush_style == "marker" else 1.0))

        if self.brush_style in ("callig1", "callig2"):
            dx = lw * 0.65
            dy = -lw * 0.65 if self.brush_style == "callig1" else lw * 0.65
            cr.set_line_width(max(1.5, lw * 0.35))
            for i in range(len(pts)):
                x0, y0 = pts[i]
                cr.move_to(x0 - dx, y0 - dy)
                cr.line_to(x0 + dx, y0 + dy)
                if i > 0:
                    px, py = pts[i - 1]
                    cr.move_to(px - dx, py - dy); cr.line_to(x0 - dx, y0 - dy)
                    cr.move_to(px + dx, py + dy); cr.line_to(x0 + dx, y0 + dy)
            cr.stroke()
            return

        cr.set_line_width(lw)
        cr.set_line_cap(cairo.LINE_CAP_SQUARE if self.brush_style == "square" else cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_BEVEL if self.brush_style == "square" else cairo.LINE_JOIN_ROUND)
        cr.move_to(*pts[0])
        for px, py in pts[1:]:
            cr.line_to(px, py)
        if len(pts) == 1:
            cr.line_to(pts[0][0] + 0.01, pts[0][1] + 0.01)
        cr.stroke()

    def _spray_airbrush_tick(self) -> bool:
        if not self._drawing or self.tool != "brush" or self.brush_style != "airbrush":
            self._airbrush_timer = 0
            return False
        cx, cy = self._last_mouse_img
        fg_hex, _ = self._stroke_colors(self._draw_btn)
        rgba_col = hex_to_rgba(fg_hex)
        rad = max(4.0, self.line_size * 2.0)
        dots = max(10, int(rad * 2.2))
        draw = ImageDraw.Draw(self.img)
        for _ in range(dots):
            ang = random.uniform(0, 2 * math.pi)
            dist = rad * math.sqrt(random.uniform(0, 1))
            px = int(round(cx + dist * math.cos(ang)))
            py = int(round(cy + dist * math.sin(ang)))
            if 0 <= px < self.img.width and 0 <= py < self.img.height:
                draw.point((px, py), fill=rgba_col)
        self.cairo_surf = pil_to_cairo_surface(self.img)
        self.modified = True
        self.canvas.queue_draw()
        return True

    def _constrain_endpoints(self, kind: str, x0: float, y0: float, x1: float, y1: float) -> tuple[float, float]:
        if not self._shift_held:
            return x1, y1
        dx, dy = x1 - x0, y1 - y0
        if kind == "line":
            ang = round(math.atan2(dy, dx) / (math.pi / 4)) * (math.pi / 4)
            ln = math.hypot(dx, dy)
            return x0 + ln * math.cos(ang), y0 + ln * math.sin(ang)
        m = max(abs(dx), abs(dy))
        return x0 + math.copysign(m, dx or 1), y0 + math.copysign(m, dy or 1)

    def _draw_shape_on_cr(self, cr: cairo.Context, kind: str, x0: float, y0: float, x1: float, y1: float,
                          mouse_btn: int, ctrl_pt: tuple[float, float] | None = None):
        fg_hex, bg_hex = self._stroke_colors(mouse_btn)
        cr.set_line_width(max(1.0, self.line_size))
        cr.set_line_join(cairo.LINE_JOIN_MITER if kind in ("rect", "tri", "rtri", "diamond") else cairo.LINE_JOIN_ROUND)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)

        closed = build_shape_path(cr, kind, x0, y0, x1, y1, ctrl_pt)
        if closed and self.fill_mode != "none":
            fill_hex = bg_hex if self.fill_mode == "color2" else fg_hex
            fr, fg, fb, _ = hex_to_rgba(fill_hex)
            cr.set_source_rgb(fr / 255.0, fg / 255.0, fb / 255.0)
            if self.outline_mode != "none":
                cr.fill_preserve()
            else:
                cr.fill()
                return

        if self.outline_mode != "none" or not closed:
            sr, sg, sb, _ = hex_to_rgba(fg_hex)
            cr.set_source_rgb(sr / 255.0, sg / 255.0, sb / 255.0)
            cr.stroke()
        else:
            cr.new_path()

    def _commit_cairo_overlay(self, draw_fn):
        self._push_undo()
        surf = pil_to_cairo_surface(self.img)
        cr = cairo.Context(surf)
        draw_fn(cr)
        surf.flush()
        pb = Gdk.pixbuf_get_from_surface(surf, 0, 0, surf.get_width(), surf.get_height())
        self._set_img(pixbuf_to_pil(pb), mark_mod=True)

    def _commit_pending_curve(self):
        if self._curve_pending is not None:
            _, x0, y0, x1, y1, btn, ctrl = self._curve_pending
            self._curve_pending = None
            self._commit_cairo_overlay(lambda cr: self._draw_shape_on_cr(cr, "curve", x0, y0, x1, y1, btn, ctrl))

    def _draw_text_on_cr(self, cr: cairo.Context, txt: str, x: float, y: float):
        if not txt:
            return
        weight = "Bold" if self.font_bold else "Normal"
        style = "Italic" if self.font_italic else "Normal"
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(Pango.FontDescription(f"{self.font_family} {weight} {style} {self.font_size}px"))
        layout.set_text(txt, -1)
        _, ext = layout.get_pixel_extents()
        if self.text_opaque_bg:
            br, bg, bb, _ = hex_to_rgba(self.color2)
            cr.set_source_rgb(br / 255.0, bg / 255.0, bb / 255.0)
            cr.rectangle(x - 3, y - 2, ext.width + 8, ext.height + 6)
            cr.fill()
        fr, fg, fb, _ = hex_to_rgba(self.color1)
        cr.set_source_rgb(fr / 255.0, fg / 255.0, fb / 255.0)
        cr.move_to(x, y)
        PangoCairo.show_layout(cr, layout)

    def commit_text_box(self):
        txt = self.ent_text.get_text()
        if txt.strip() and self.text_anchor is not None:
            ax, ay = self.text_anchor
            self._commit_cairo_overlay(lambda cr: self._draw_text_on_cr(cr, txt, ax, ay))
            self.ent_text.set_text("")
            self.set_status("Stamped text onto canvas.")

    # ---------------- Canvas Rendering & Mouse Interaction ----------------
    def _canvas_origin(self) -> tuple[float, float]:
        return 12.0, 12.0

    def _to_img_xy(self, cx: float, cy: float) -> tuple[float, float]:
        ox, oy = self._canvas_origin()
        return (cx - ox) / self.zoom, (cy - oy) / self.zoom

    def _hit_resize_handle(self, cx: float, cy: float) -> str | None:
        ox, oy = self._canvas_origin()
        dw = self.img.width * self.zoom
        dh = self.img.height * self.zoom
        hs = 9.0
        # Bottom-Right handle
        if abs(cx - (ox + dw + 4)) <= hs and abs(cy - (oy + dh + 4)) <= hs:
            return "br"
        # Right-middle handle
        if abs(cx - (ox + dw + 4)) <= hs and abs(cy - (oy + dh * 0.5)) <= hs:
            return "r"
        # Bottom-middle handle
        if abs(cx - (ox + dw * 0.5)) <= hs and abs(cy - (oy + dh + 4)) <= hs:
            return "b"
        return None

    def on_canvas_draw(self, _widget, cr: cairo.Context):
        # Dark slate MS Paint workspace backdrop
        cr.set_source_rgb(0.46, 0.49, 0.56)
        cr.paint()

        ox, oy = self._canvas_origin()
        dw = self.img.width * self.zoom
        dh = self.img.height * self.zoom

        # Crisp drop shadow
        cr.set_source_rgba(0, 0, 0, 0.40)
        cr.rectangle(ox + 4, oy + 4, dw, dh)
        cr.fill()

        # Checkerboard behind transparent regions
        cr.save()
        cr.rectangle(ox, oy, dw, dh)
        cr.clip()
        cr.set_source_rgb(1.0, 1.0, 1.0)
        cr.paint()
        if self.img.getChannel if False else True:
            cell = 10
            cr.set_source_rgb(0.88, 0.88, 0.90)
            for ry in range(int(oy), int(oy + dh) + cell, cell):
                r_idx = (ry - int(oy)) // cell
                for rx in range(int(ox) + (cell if (r_idx & 1) else 0), int(ox + dw) + cell, cell * 2):
                    cr.rectangle(rx, ry, cell, cell)
            cr.fill()

        # Paint base image
        cr.save()
        cr.translate(ox, oy)
        cr.scale(self.zoom, self.zoom)
        cr.set_source_surface(self.cairo_surf, 0, 0)
        if self.zoom >= 2.5:
            cr.get_source().set_filter(cairo.FILTER_NEAREST)
        cr.paint()

        # Live freehand / shape / curve / text preview in image space
        if self._drawing and self.tool in ("pencil", "brush", "eraser") and self.brush_style != "airbrush":
            self._draw_freehand_on_cr(cr, self._pts, self._draw_btn)
        elif self._drawing and self.tool.startswith("shape:") and len(self._pts) >= 2:
            kind = self.tool.split(":", 1)[1]
            x0, y0 = self._pts[0]
            x1, y1 = self._constrain_endpoints(kind, x0, y0, self._pts[-1][0], self._pts[-1][1])
            self._draw_shape_on_cr(cr, kind, x0, y0, x1, y1, self._draw_btn)
        elif self._curve_pending is not None:
            _, x0, y0, x1, y1, btn, ctrl = self._curve_pending
            self._draw_shape_on_cr(cr, "curve", x0, y0, x1, y1, btn, ctrl)

        if self.tool == "text" and self.text_anchor is not None:
            ax, ay = self.text_anchor
            self._draw_text_on_cr(cr, self.ent_text.get_text(), ax, ay)

        # Floating selection image preview
        if self.sel_img is not None and self.sel_rect is not None:
            sx, sy, sw, sh = self.sel_rect
            if sw >= 1 and sh >= 1:
                disp = self._prepare_sel_image(self.sel_img)
                s_surf = pil_to_cairo_surface(disp)
                cr.save()
                cr.translate(sx, sy)
                cr.scale(sw / float(max(1, disp.width)), sh / float(max(1, disp.height)))
                cr.set_source_surface(s_surf, 0, 0)
                if self.zoom >= 2.0:
                    cr.get_source().set_filter(cairo.FILTER_NEAREST)
                cr.paint()
                cr.restore()

        cr.restore()  # end image space
        cr.restore()  # end canvas clip

        # Pixel grid at >= 600% zoom
        if self.zoom >= 6.0:
            cr.set_source_rgba(0.5, 0.5, 0.55, 0.35)
            cr.set_line_width(1.0)
            for gx in range(1, self.img.width):
                px = ox + gx * self.zoom
                cr.move_to(px, oy); cr.line_to(px, oy + dh)
            for gy in range(1, self.img.height):
                py = oy + gy * self.zoom
                cr.move_to(ox, py); cr.line_to(ox + dw, py)
            cr.stroke()

        # Selection marching-ants border (screen space)
        if self.sel_rect is not None:
            sx, sy, sw, sh = self.sel_rect
            rx = ox + min(sx, sx + sw) * self.zoom
            ry = oy + min(sy, sy + sh) * self.zoom
            rw = abs(sw) * self.zoom
            rh = abs(sh) * self.zoom
            cr.set_line_width(1.5)
            cr.set_source_rgb(1, 1, 1)
            cr.rectangle(rx, ry, rw, rh); cr.stroke()
            cr.set_dash([4.0, 4.0])
            cr.set_source_rgb(0.10, 0.32, 0.78)
            cr.rectangle(rx, ry, rw, rh); cr.stroke()
            cr.set_dash([])

        if self._lasso_pts and len(self._lasso_pts) >= 2:
            cr.set_line_width(1.5)
            cr.set_dash([4.0, 3.0])
            cr.set_source_rgb(0.10, 0.32, 0.78)
            cr.move_to(ox + self._lasso_pts[0][0] * self.zoom, oy + self._lasso_pts[0][1] * self.zoom)
            for lx, ly in self._lasso_pts[1:]:
                cr.line_to(ox + lx * self.zoom, oy + ly * self.zoom)
            cr.stroke()
            cr.set_dash([])

        if self.tool == "text" and self.text_anchor is not None:
            ax, ay = self.text_anchor
            cr.set_line_width(1.0)
            cr.set_dash([3.0, 3.0])
            cr.set_source_rgb(0.15, 0.35, 0.75)
            cr.rectangle(ox + ax * self.zoom - 3, oy + ay * self.zoom - 3, 180, max(26, self.font_size * self.zoom + 8))
            cr.stroke()
            cr.set_dash([])

        # Classic MS Paint 3 Blue Canvas Resize Handles (Right, Bottom, Bottom-Right)
        cr.set_source_rgb(0.16, 0.36, 0.68)
        for hx, hy in [
            (ox + dw + 1, oy + dh * 0.5 - 3),
            (ox + dw * 0.5 - 3, oy + dh + 1),
            (ox + dw + 1, oy + dh + 1),
        ]:
            cr.rectangle(hx, hy, 6, 6)
            cr.fill()
            cr.set_source_rgb(1, 1, 1)
            cr.set_line_width(1.0)
            cr.rectangle(hx, hy, 6, 6)
            cr.stroke()
            cr.set_source_rgb(0.16, 0.36, 0.68)

        # Live canvas resize dashed outline
        if self._resize_preview_wh is not None:
            pw, ph = self._resize_preview_wh
            cr.set_dash([5.0, 4.0])
            cr.set_source_rgb(1.0, 0.95, 0.35)
            cr.set_line_width(1.5)
            cr.rectangle(ox, oy, pw * self.zoom, ph * self.zoom)
            cr.stroke()
            cr.set_dash([])

        return False

    def on_canvas_press(self, _w, ev):
        if not isinstance(self.get_focus(), Gtk.Entry):
            self.canvas.grab_focus()

        if ev.button not in (1, 3):
            return False

        # 1. Check canvas resize handles first
        h_hit = self._hit_resize_handle(ev.x, ev.y)
        if h_hit and ev.button == 1:
            self.commit_floating_selection()
            self._resizing_canvas = h_hit
            self._resize_preview_wh = (self.img.width, self.img.height)
            return True

        ix, iy = self._to_img_xy(ev.x, ev.y)
        self._last_mouse_img = (ix, iy)
        self._shift_held = bool(ev.state & Gdk.ModifierType.SHIFT_MASK)

        # 2. Curve bend step
        if self._curve_pending is not None:
            _, x0, y0, x1, y1, btn, _ = self._curve_pending
            self._curve_pending = ("bending", x0, y0, x1, y1, btn, (ix, iy))
            self.canvas.queue_draw()
            return True

        # 3. Selection / Lasso Tools
        if self.tool in ("select", "lasso"):
            if self.sel_img is not None and self.sel_rect is not None:
                sx, sy, sw, sh = self.sel_rect
                if sx <= ix <= sx + sw and sy <= iy <= sy + sh:
                    self._sel_moving = True
                    self._sel_move_offset = (ix - sx, iy - sy)
                    return True
                else:
                    self.commit_floating_selection()

            if self.tool == "select":
                self._sel_dragging_new = True
                self.sel_rect = [ix, iy, 0.0, 0.0]
            else:
                self._sel_dragging_new = True
                self._lasso_pts = [(ix, iy)]
            self.canvas.queue_draw()
            return True

        # 4. Text Tool anchor placement
        if self.tool == "text":
            self.text_anchor = (int(round(ix)), int(round(iy)))
            self.ent_text.grab_focus()
            self.canvas.queue_draw()
            return True

        # 5. Flood Fill Bucket
        if self.tool == "fill":
            px, py = int(math.floor(ix)), int(math.floor(iy))
            if 0 <= px < self.img.width and 0 <= py < self.img.height:
                self._push_undo()
                fg_hex, _ = self._stroke_colors(ev.button)
                filled = self.img.copy()
                ImageDraw.floodfill(filled, (px, py), hex_to_rgba(fg_hex), thresh=12)
                self._set_img(filled, mark_mod=True)
            return True

        # 6. Eyedropper / Color Picker
        if self.tool == "picker":
            px, py = int(math.floor(ix)), int(math.floor(iy))
            if 0 <= px < self.img.width and 0 <= py < self.img.height:
                r, g, b, _ = self.img.getpixel((px, py))
                hx = f"#{r:02X}{g:02X}{b:02X}"
                if ev.button == 3:
                    self.color2 = hx
                else:
                    self.color1 = hx
                self.da_col1.queue_draw()
                self.da_col2.queue_draw()
                self.set_tool(self.prev_draw_tool)
                self.set_status(f"Picked color {hx}.")
            return True

        # 7. Magnifier
        if self.tool == "zoom":
            self.set_zoom(self.zoom * 1.5 if ev.button == 1 else self.zoom / 1.5)
            return True

        # 8. Pencil, Brushes, Eraser, Shapes
        self._drawing = True
        self._draw_btn = ev.button
        self._pts = [(ix, iy)]
        if self.tool == "brush" and self.brush_style == "airbrush":
            self._push_undo()
            self._spray_airbrush_tick()
            self._airbrush_timer = GLib.timeout_add(35, self._spray_airbrush_tick)
        self.canvas.queue_draw()
        return True

    def on_canvas_motion(self, _w, ev):
        ix, iy = self._to_img_xy(ev.x, ev.y)
        self._last_mouse_img = (ix, iy)
        self._shift_held = bool(ev.state & Gdk.ModifierType.SHIFT_MASK)
        self.lbl_coords.set_text(f"{int(math.floor(ix))}, {int(math.floor(iy))} px")

        if self._resizing_canvas:
            nw = self.img.width if self._resizing_canvas == "b" else max(8, int(round(ix)))
            nh = self.img.height if self._resizing_canvas == "r" else max(8, int(round(iy)))
            self._resize_preview_wh = (nw, nh)
            self.lbl_dims.set_text(f"New Canvas: {nw} × {nh} px")
            self.canvas.queue_draw()
            return True

        if self._curve_pending is not None and self._curve_pending[0] == "bending":
            _, x0, y0, x1, y1, btn, _ = self._curve_pending
            self._curve_pending = ("bending", x0, y0, x1, y1, btn, (ix, iy))
            self.canvas.queue_draw()
            return True

        if self._sel_moving and self.sel_rect is not None:
            ox_off, oy_off = self._sel_move_offset
            self.sel_rect[0] = ix - ox_off
            self.sel_rect[1] = iy - oy_off
            self.canvas.queue_draw()
            return True

        if self._sel_dragging_new:
            if self.tool == "select" and self.sel_rect is not None:
                self.sel_rect[2] = ix - self.sel_rect[0]
                self.sel_rect[3] = iy - self.sel_rect[1]
                self._update_status_meta()
            elif self.tool == "lasso":
                self._lasso_pts.append((ix, iy))
            self.canvas.queue_draw()
            return True

        if self._drawing:
            if self.tool.startswith("shape:"):
                if len(self._pts) >= 2:
                    self._pts[-1] = (ix, iy)
                else:
                    self._pts.append((ix, iy))
            else:
                self._pts.append((ix, iy))
            self.canvas.queue_draw()
            return True

        return False

    def on_canvas_release(self, _w, ev):
        ix, iy = self._to_img_xy(ev.x, ev.y)
        self._shift_held = bool(ev.state & Gdk.ModifierType.SHIFT_MASK)

        if self._resizing_canvas:
            pw, ph = self._resize_preview_wh or self.img.size
            self._resizing_canvas = None
            self._resize_preview_wh = None
            if (pw, ph) != self.img.size:
                self._push_undo()
                resized = Image.new("RGBA", (pw, ph), hex_to_rgba(self.color2))
                resized.paste(self.img, (0, 0))
                self._set_img(resized, mark_mod=True)
                self.set_status(f"Resized canvas to {pw} × {ph} px.")
            else:
                self.canvas.queue_draw()
            return True

        if self._curve_pending is not None and self._curve_pending[0] == "bending":
            self._commit_pending_curve()
            return True

        if self._sel_moving:
            self._sel_moving = False
            return True

        if self._sel_dragging_new:
            self._sel_dragging_new = False
            if self.tool == "select" and self.sel_rect is not None:
                x0, y0, w, h = self.sel_rect
                self._lift_rect_selection(int(round(x0)), int(round(y0)), int(round(x0 + w)), int(round(y0 + h)))
            elif self.tool == "lasso":
                pts = list(self._lasso_pts)
                self._lasso_pts.clear()
                self._lift_lasso_selection(pts)
            self.canvas.queue_draw()
            return True

        if self._drawing:
            self._drawing = False
            if self.tool == "brush" and self.brush_style == "airbrush":
                self._pts.clear()
                self._update_status_meta()
                return True

            pts = list(self._pts)
            btn = self._draw_btn
            self._pts.clear()

            if self.tool in ("pencil", "brush", "eraser") and pts:
                self._commit_cairo_overlay(lambda cr: self._draw_freehand_on_cr(cr, pts, btn))
            elif self.tool.startswith("shape:") and len(pts) >= 2:
                kind = self.tool.split(":", 1)[1]
                x0, y0 = pts[0]
                x1, y1 = self._constrain_endpoints(kind, x0, y0, pts[-1][0], pts[-1][1])
                if kind == "curve":
                    mx, my = (x0 + x1) * 0.5, (y0 + y1) * 0.5
                    self._curve_pending = ("await_bend", x0, y0, x1, y1, btn, (mx, my))
                    self.set_status("Curve: Now click & drag anywhere on the canvas to bend the curve!")
                    self.canvas.queue_draw()
                else:
                    self._commit_cairo_overlay(lambda cr: self._draw_shape_on_cr(cr, kind, x0, y0, x1, y1, btn))
            return True

        return False

    def on_canvas_scroll(self, _w, ev):
        if ev.state & Gdk.ModifierType.CONTROL_MASK:
            if ev.direction == Gdk.ScrollDirection.UP:
                self.set_zoom(self.zoom * 1.25)
                return True
            if ev.direction == Gdk.ScrollDirection.DOWN:
                self.set_zoom(self.zoom / 1.25)
                return True
        return False

    # ---------------- Keyboard Shortcuts, DnD, About & Close ----------------
    def on_key_press(self, _w, ev):
        if ev.keyval in (Gdk.KEY_Shift_L, Gdk.KEY_Shift_R):
            self._shift_held = True

        foc = self.get_focus()
        if isinstance(foc, Gtk.Entry):
            if ev.keyval == Gdk.KEY_Escape:
                self.ent_text.set_text("")
                self.canvas.grab_focus()
                return True
            return False

        ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
        shift = bool(ev.state & Gdk.ModifierType.SHIFT_MASK)
        kv = ev.keyval

        if ctrl and kv in (Gdk.KEY_n, Gdk.KEY_N):
            self.on_new_canvas(); return True
        if ctrl and kv in (Gdk.KEY_o, Gdk.KEY_O):
            self.on_open_dialog(); return True
        if ctrl and shift and kv in (Gdk.KEY_s, Gdk.KEY_S):
            self.on_save_as(); return True
        if ctrl and kv in (Gdk.KEY_s, Gdk.KEY_S):
            self.on_save(); return True
        if ctrl and kv in (Gdk.KEY_z, Gdk.KEY_Z):
            self.on_undo(); return True
        if ctrl and kv in (Gdk.KEY_y, Gdk.KEY_Y):
            self.on_redo(); return True
        if ctrl and kv in (Gdk.KEY_c, Gdk.KEY_C):
            self.on_copy(); return True
        if ctrl and kv in (Gdk.KEY_x, Gdk.KEY_X):
            self.on_cut(); return True
        if ctrl and kv in (Gdk.KEY_v, Gdk.KEY_V):
            self.on_paste(); return True
        if ctrl and kv in (Gdk.KEY_a, Gdk.KEY_A):
            self.on_select_all(); return True
        if ctrl and kv in (Gdk.KEY_q, Gdk.KEY_Q):
            self.on_close_request(); return True
        if kv == Gdk.KEY_Delete:
            self.on_delete_selection(); return True
        if kv == Gdk.KEY_Escape:
            self.commit_floating_selection()
            self._commit_pending_curve()
            self.canvas.queue_draw()
            return True
        if kv in (Gdk.KEY_plus, Gdk.KEY_equal, Gdk.KEY_KP_Add):
            self.set_zoom(self.zoom * 1.25); return True
        if kv in (Gdk.KEY_minus, Gdk.KEY_underscore, Gdk.KEY_KP_Subtract):
            self.set_zoom(self.zoom / 1.25); return True
        if kv in (Gdk.KEY_1, Gdk.KEY_KP_1):
            self.set_zoom(1.0); return True
        if kv in (Gdk.KEY_0, Gdk.KEY_KP_0):
            self.zoom_to_fit(); return True
        return False

    def on_key_release(self, _w, ev):
        if ev.keyval in (Gdk.KEY_Shift_L, Gdk.KEY_Shift_R):
            self._shift_held = False
        return False

    def on_drag_drop(self, _w, context, _x, _y, data, _info, time_):
        chosen = None
        for u in (data.get_uris() or []):
            if u.startswith("file://"):
                p = Path(urllib.parse.unquote(urllib.parse.urlparse(u).path))
                if p.is_file():
                    chosen = p; break
        if chosen is None:
            for tok in re.split(r"[\r\n\x00]+", (data.get_text() or "").strip()):
                if not tok:
                    continue
                p = Path(urllib.parse.unquote(urllib.parse.urlparse(tok).path)) if tok.startswith("file://") else Path(tok)
                if p.is_file():
                    chosen = p; break
        Gtk.drag_finish(context, chosen is not None, False, time_)
        if chosen:
            self.open_file(chosen)

    def on_about(self, *_args):
        md = Gtk.MessageDialog(
            transient_for=self, flags=0, message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK, text="dtPaint — CDE MS Paint Clone & Universal Image Editor",
        )
        md.format_secondary_text(
            "Classic MS Paint Ribbon workflow styled natively for CDE OSF/Motif.\n\n"
            "• Opens & saves all dtPics formats: PNG, JPG, BMP, GIF, HEIC, WebP, AVIF, SVG, TIFF, ICO, XPM, PSD\n"
            "• Full MS Paint toolkit: Select, Lasso, Cut/Copy/Paste, Flood Fill, Text, Eraser, Eyedropper,\n"
            "  6 Brushes (including Airbrush & Calligraphy), 20 Geometry Shapes, Color 1/2, & Canvas Handles."
        )
        md.run(); md.destroy()

    def on_close_request(self):
        self.commit_floating_selection()
        if self.modified:
            md = Gtk.MessageDialog(
                transient_for=self, flags=0, message_type=Gtk.MessageType.QUESTION,
                buttons=Gtk.ButtonsType.NONE, text="Save changes to image before closing dtPaint?",
            )
            md.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                           "Don't Save", Gtk.ResponseType.NO,
                           "Save", Gtk.ResponseType.YES)
            resp = md.run()
            md.destroy()
            if resp in (Gtk.ResponseType.CANCEL, Gtk.ResponseType.DELETE_EVENT):
                return True
            if resp == Gtk.ResponseType.YES:
                self.on_save()
                if self.modified:
                    return True
        self.destroy()
        Gtk.main_quit()
        return False


def main():
    chrome, sel, well = load_cde_palette()
    prov = Gtk.CssProvider()
    prov.load_from_data(build_cde_css(chrome, sel, well))
    scr = Gdk.Screen.get_default()
    if scr is not None:
        Gtk.StyleContext.add_provider_for_screen(scr, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    init_file = None
    for arg in sys.argv[1:]:
        a = arg.strip()
        if a and not a.startswith("-") and Path(a).expanduser().is_file():
            init_file = Path(a).expanduser().resolve()
            break

    win = DtPaintWindow(init_file)
    win.connect("destroy", Gtk.main_quit)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
