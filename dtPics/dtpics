        )
        self.lbl_status.set_ellipsize(Pango.EllipsizeMode.END)
        self.lbl_meta = Gtk.Label(label="", xalign=1.0)
        st.pack_start(self.lbl_status, True, True, 0)
        st.pack_end(self.lbl_meta, False, False, 0)
        vbox.pack_start(st, False, False, 0)

        # Drag-and-drop image support
        targets = [
            Gtk.TargetEntry.new("text/uri-list", 0, 0),
            Gtk.TargetEntry.new("text/plain", 0, 1),
            Gtk.TargetEntry.new("STRING", 0, 2),
        ]
        self.drag_dest_set(Gtk.DestDefaults.ALL, targets, Gdk.DragAction.COPY)
        self.connect("drag-data-received", self.on_drag_drop)
        self.connect("delete-event", lambda *_: self.on_close_request())

        self.show_all()

    def _bind_shortcuts(self):
        self.connect("key-press-event", self.on_key_press)

    # ---------------- State & History Management ----------------
    def _stop_anim(self):
        if self.anim_timer_id:
            GLib.source_remove(self.anim_timer_id)
            self.anim_timer_id = 0
        self.anim_frames = None

    def _start_anim_if_needed(self):
        if not self.anim_frames or len(self.anim_frames) <= 1:
            return
        delay = self.anim_frames[self.anim_idx][1]
        self.anim_timer_id = GLib.timeout_add(delay, self._on_anim_tick)

    def _on_anim_tick(self):
        if not self.anim_frames or self.modified or self.tool != "view":
            self.anim_timer_id = 0
            return False
        self.anim_idx = (self.anim_idx + 1) % len(self.anim_frames)
        self.img = self.anim_frames[self.anim_idx][0]
        self.cairo_surf = pil_to_cairo_surface(self.img)
        self.canvas.queue_draw()
        delay = self.anim_frames[self.anim_idx][1]
        self.anim_timer_id = GLib.timeout_add(delay, self._on_anim_tick)
        return False

    def _push_undo(self):
        if self.img is None:
            return
        self._stop_anim()
        self.undo_stack.append(self.img.copy())
        if len(self.undo_stack) > 25:
            self.undo_stack.pop(0)
        self.redo_stack.clear()

    def _set_working_image(self, new_img: Image.Image, mark_modified: bool = True):
        self.img = new_img.convert("RGBA")
        self.preview_override = None
        self.cairo_surf = pil_to_cairo_surface(self.img)
        if mark_modified:
            self.modified = True
        self._update_title_and_meta()
        self.canvas.queue_draw()

    def _set_preview_override(self, prev_img: Image.Image | None):
        self.preview_override = prev_img
        if prev_img is not None:
            self.cairo_surf = pil_to_cairo_surface(prev_img)
        elif self.img is not None:
            self.cairo_surf = pil_to_cairo_surface(self.img)
        self.canvas.queue_draw()

    def _update_title_and_meta(self):
        name = self.current_path.name if self.current_path else "Untitled"
        star = "* " if self.modified else ""
        self.set_title(f"{star}{name} — dtPics")
        if self.img:
            idx_s = ""
            if self.current_path and self.current_path in self.folder_images:
                i = self.folder_images.index(self.current_path) + 1
                idx_s = f"  [{i}/{len(self.folder_images)}]"
            self.lbl_meta.set_text(f"{self.img.width} × {self.img.height} px  •  {self.fmt_name}{idx_s}")
        else:
            self.lbl_meta.set_text("")

    def set_status(self, msg: str):
        self.lbl_status.set_text(msg)

    # ---------------- File Open / Save / Folder Navigation ----------------
    def _scan_folder(self, file_path: Path):
        folder = file_path.parent
        try:
            imgs = [
                p.resolve() for p in sorted(folder.iterdir(), key=lambda x: x.name.lower())
                if p.is_file() and p.suffix.lower() in IMAGE_EXTS
            ]
        except OSError:
            imgs = [file_path.resolve()]
        self.folder_images = imgs

    def open_file(self, path: Path):
        rp = path.expanduser().resolve()
        if not rp.is_file():
            self._error(f"File not found:\n{rp}")
            return
        try:
            self._stop_anim()
            im, anim_frames, fmt = load_image_universal(rp)
            self.current_path = rp
            self._scan_folder(rp)
            self.undo_stack.clear()
            self.redo_stack.clear()
            self.modified = False
            self.fmt_name = fmt
            self.fit_mode = True
            self.pan_x = self.pan_y = 0.0
            self.crop_rect = None
            self.set_tool("view")
            self._set_working_image(im, mark_modified=False)
            if anim_frames:
                self.anim_frames = anim_frames
                self.anim_idx = 0
                self._start_anim_if_needed()
            sz_kb = rp.stat().st_size / 1024.0
            sz_s = f"{sz_kb:.1f} KB" if sz_kb < 1024 else f"{sz_kb / 1024.0:.2f} MB"
            self.set_status(f"Loaded {rp.name} ({sz_s})")
        except Exception as exc:
            self._error(f"Could not open '{rp.name}':\n{exc}")

    def step_folder(self, delta: int):
        if not self.folder_images or not self.current_path:
            return
        try:
            idx = self.folder_images.index(self.current_path)
        except ValueError:
            idx = 0
        nxt = (idx + delta) % len(self.folder_images)
        if nxt != idx:
            self.open_file(self.folder_images[nxt])

    def on_reload_original(self, *_args):
        if self.current_path and self.current_path.is_file():
            self.open_file(self.current_path)

    def on_open_with_dtpaint(self, *_args):
        dtpaint_bin = str(HOME / ".local" / "bin" / "dtpaint")
        if self.img is None:
            subprocess.Popen([dtpaint_bin])
            return
        if self.current_path and self.current_path.is_file() and not self.modified:
            subprocess.Popen([dtpaint_bin, str(self.current_path)])
            self.set_status(f"Opened {self.current_path.name} in dtPaint.")
            return
        try:
            tmp_p = Path(tempfile.gettempdir()) / (self.current_path.name if self.current_path else "dtpics_to_dtpaint.png")
            if tmp_p.suffix.lower() not in (".png", ".jpg", ".jpeg", ".bmp", ".webp", ".tiff"):
                tmp_p = tmp_p.with_suffix(".png")
            save_image_universal(self.img, tmp_p)
            subprocess.Popen([dtpaint_bin, str(tmp_p)])
            self.set_status(f"Opened working image in dtPaint ({tmp_p.name}).")
        except Exception as exc:
            self._error(f"Could not launch dtPaint:\n{exc}")

    def on_open_dialog(self, *_args):
        dlg = Gtk.FileChooserDialog(title="Open Image — dtPics", parent=self, action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Open", Gtk.ResponseType.OK)
        if self.current_path:
            dlg.set_current_folder(str(self.current_path.parent))
        elif (HOME / "Pictures").is_dir():
            dlg.set_current_folder(str(HOME / "Pictures"))

        flt = Gtk.FileFilter()
        flt.set_name("All Supported Images (PNG, JPG, BMP, GIF, HEIC, WebP, AVIF, SVG, TIFF...)")
        for ext in sorted(IMAGE_EXTS):
            flt.add_pattern(f"*{ext}")
            flt.add_pattern(f"*{ext.upper()}")
        dlg.add_filter(flt)
        flt_all = Gtk.FileFilter(); flt_all.set_name("All Files"); flt_all.add_pattern("*")
        dlg.add_filter(flt_all)

        if dlg.run() == Gtk.ResponseType.OK:
            fn = dlg.get_filename()
            dlg.destroy()
            if fn:
                self.open_file(Path(fn))
        else:
            dlg.destroy()

    def on_save(self, *_args):
        if self.img is None:
            return
        if self.current_path is None or self.current_path.suffix.lower() in (".svg", ".svgz", ".xpm", ".xbm"):
            self.on_save_as()
            return
        try:
            save_image_universal(self.img, self.current_path)
            self.modified = False
            self._update_title_and_meta()
            self.set_status(f"Saved {self.current_path}")
        except Exception as exc:
            self._error(f"Save failed:\n{exc}")

    def on_save_as(self, *_args):
        if self.img is None:
            return
        dlg = Gtk.FileChooserDialog(title="Save Image As — dtPics", parent=self, action=Gtk.FileChooserAction.SAVE)
        dlg.set_do_overwrite_confirmation(True)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save", Gtk.ResponseType.OK)

        hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, margin=6)
        hb.pack_start(Gtk.Label(label="Format:"), False, False, 0)
        cmb = Gtk.ComboBoxText()
        for ext, desc in SAVE_FORMATS:
            cmb.append(ext, desc)
        cur_ext = self.current_path.suffix.lower() if self.current_path else ".png"
        if cur_ext == ".jpeg":
            cur_ext = ".jpg"
        cmb.set_active_id(cur_ext if any(cur_ext == e for e, _ in SAVE_FORMATS) else ".png")
        hb.pack_start(cmb, False, False, 0)
        hb.show_all()
        dlg.set_extra_widget(hb)

        base_dir = self.current_path.parent if self.current_path else (HOME / "Pictures")
        if base_dir.is_dir():
            dlg.set_current_folder(str(base_dir))
        stem = self.current_path.stem if self.current_path else "edited_image"
        dlg.set_current_name(f"{stem}{cmb.get_active_id() or '.png'}")

        def _on_fmt_chg(_c):
            cur_n = dlg.get_current_name() or stem
            s = Path(cur_n).stem or stem
            dlg.set_current_name(s + (cmb.get_active_id() or ".png"))
        cmb.connect("changed", _on_fmt_chg)

        if dlg.run() == Gtk.ResponseType.OK:
            out_p = Path(dlg.get_filename())
            dlg.destroy()
            if not out_p.suffix:
                out_p = out_p.with_suffix(cmb.get_active_id() or ".png")
            try:
                save_image_universal(self.img, out_p)
                self.current_path = out_p.resolve()
                self._scan_folder(self.current_path)
                self.modified = False
                self.fmt_name = out_p.suffix.lstrip(".").upper()
                self._update_title_and_meta()
                self.set_status(f"Saved as {self.current_path}")
            except Exception as exc:
                self._error(f"Save As failed:\n{exc}")
        else:
            dlg.destroy()

    def on_copy_clipboard(self, *_args):
        if not self.img:
            return
        cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        cb.set_image(pil_to_pixbuf(self.img))
        cb.store()
        self.set_status("Copied image to clipboard.")

    def on_paste_clipboard(self, *_args):
        cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        pb = cb.wait_for_image()
        if pb is None:
            self.set_status("No image found on clipboard.")
            return
        self._stop_anim()
        if self.img is not None:
            self._push_undo()
        self.current_path = None
        self.fmt_name = "CLIPBOARD"
        self.fit_mode = True
        self._set_working_image(pixbuf_to_pil(pb), mark_modified=True)
        self.set_status("Pasted image from clipboard.")

    # ---------------- Tool & Editing Operations ----------------
    def _on_tool_btn_toggled(self, btn: Gtk.ToggleButton, tid: str):
        if self._updating_tool_btns:
            return
        if btn.get_active():
            self.set_tool(tid)
        elif self.tool == tid:
            self.set_tool("view")

    def set_tool(self, tid: str):
        self.tool = tid
        self._updating_tool_btns = True
        for k, b in self.tool_btns.items():
            b.set_active(k == tid)
        self._updating_tool_btns = False

        self.crop_rect = None
        self.stroke_pts.clear()
        self._drawing = False

        # Show appropriate contextual sub-bar controls
        for w in (self.box_crop_opts, self.box_color_opts, self.box_pen_opts, self.box_text_opts):
            w.hide()

        if tid == "view":
            self.sub_bar.hide()
            self.set_status("View / Pan mode — Use mouse wheel or +/- to zoom; drag to pan.")
        elif tid == "crop":
            self.sub_bar.show()
            self.box_crop_opts.show_all()
            self.lbl_crop_info.set_text("Drag on the image to select crop region (Enter = Apply, Esc = Cancel).")
            self.set_status("Crop Tool — Drag a rectangle over the area to keep, then click Apply Crop.")
        elif tid in ("pen", "highlight", "arrow", "box"):
            self.sub_bar.show()
            self.box_color_opts.show_all()
            self.box_pen_opts.show_all()
            self.set_status(f"Drawing Tool ({tid.capitalize()}) — Choose color & thickness above, then draw on image.")
        elif tid == "text":
            self.sub_bar.show()
            self.box_color_opts.show_all()
            self.box_text_opts.show_all()
            self.ent_text.grab_focus()
            self.set_status("Text Overlay Tool — Type text above, hover image to preview, click to stamp!")

        self.canvas.queue_draw()

    def _on_swatch_clicked(self, _btn, hex_c: str):
        self.pen_color = hex_c
        rgba = Gdk.RGBA(); rgba.parse(hex_c)
        self.color_btn.set_rgba(rgba)
        self.canvas.queue_draw()

    def _on_custom_color_set(self, cbtn: Gtk.ColorButton):
        c = cbtn.get_rgba()
        self.pen_color = f"#{int(c.red*255):02X}{int(c.green*255):02X}{int(c.blue*255):02X}"
        self.canvas.queue_draw()

    def on_undo(self, *_args):
        if not self.undo_stack or self.img is None:
            self.set_status("Nothing to undo.")
            return
        self.redo_stack.append(self.img.copy())
        prev = self.undo_stack.pop()
        self._set_working_image(prev, mark_modified=bool(self.undo_stack))
        self.set_status("Undid last edit.")

    def on_redo(self, *_args):
        if not self.redo_stack or self.img is None:
            self.set_status("Nothing to redo.")
            return
        self.undo_stack.append(self.img.copy())
        nxt = self.redo_stack.pop()
        self._set_working_image(nxt, mark_modified=True)
        self.set_status("Redid edit.")

    def on_rotate(self, deg_cw: int):
        if self.img is None:
            return
        self._push_undo()
        if deg_cw == 90:
            res = self.img.transpose(Image.Transpose.ROTATE_270)
        elif deg_cw == -90:
            res = self.img.transpose(Image.Transpose.ROTATE_90)
        else:
            res = self.img.transpose(Image.Transpose.ROTATE_180)
        self._set_working_image(res)
        self.set_status(f"Rotated image {abs(deg_cw)}° {'right' if deg_cw > 0 else 'left'}.")

    def on_flip(self, horizontal: bool):
        if self.img is None:
            return
        self._push_undo()
        op = Image.Transpose.FLIP_LEFT_RIGHT if horizontal else Image.Transpose.FLIP_TOP_BOTTOM
        self._set_working_image(self.img.transpose(op))
        self.set_status(f"Flipped image {'horizontally' if horizontal else 'vertically'}.")

    def on_magic_color(self, *_args):
        if self.img is None:
