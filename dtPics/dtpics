class SkewDialog(Gtk.Dialog):
    def __init__(self, parent, base_img: Image.Image, on_preview_cb):
        super().__init__(title="Skew & Straighten — dtPics", transient_for=parent, flags=0)
        self.set_default_size(430, 280)
        self.base_img = base_img
        self.on_preview_cb = on_preview_cb
        # Make small preview proxy for instant 60fps dragging
        max_dim = 700
        if max(base_img.width, base_img.height) > max_dim:
            sc = max_dim / float(max(base_img.width, base_img.height))
            self.proxy_img = base_img.resize((max(1, int(base_img.width * sc)), max(1, int(base_img.height * sc))), Image.Resampling.BILINEAR)
        else:
            self.proxy_img = base_img

        box = self.get_content_area()
        box.set_spacing(8)
        box.set_margin_start(12); box.set_margin_end(12); box.set_margin_top(10); box.set_margin_bottom(8)

        fr = Gtk.Frame(label=" Perspective Skew & Fine Straighten ")
        g = Gtk.Grid(column_spacing=10, row_spacing=8, margin=10)
        fr.add(g)

        self.sl_sx = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, -35.0, 35.0, 0.5)
        self.sl_sy = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, -35.0, 35.0, 0.5)
        self.sl_rot = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, -45.0, 45.0, 0.25)
        for sl in (self.sl_sx, self.sl_sy, self.sl_rot):
            sl.set_hexpand(True)
            sl.set_value(0.0)
            sl.connect("value-changed", self._emit_preview)

        g.attach(Gtk.Label(label="Horizontal Skew (°):", xalign=0), 0, 0, 1, 1)
        g.attach(self.sl_sx, 1, 0, 1, 1)
        g.attach(Gtk.Label(label="Vertical Skew (°):", xalign=0), 0, 1, 1, 1)
        g.attach(self.sl_sy, 1, 1, 1, 1)
        g.attach(Gtk.Label(label="Fine Straighten (°):", xalign=0), 0, 2, 1, 1)
        g.attach(self.sl_rot, 1, 2, 1, 1)

        g.attach(Gtk.Label(label="Corner Fill:", xalign=0), 0, 3, 1, 1)
        self.cmb_bg = Gtk.ComboBoxText()
        self.cmb_bg.append("white", "White (#FFFFFF)")
        self.cmb_bg.append("trans", "Transparent")
        self.cmb_bg.append("black", "Black (#000000)")
        self.cmb_bg.set_active_id("white")
        self.cmb_bg.connect("changed", self._emit_preview)
        g.attach(self.cmb_bg, 1, 3, 1, 1)

        box.pack_start(fr, True, True, 0)

        b_rst = Gtk.Button(label="Reset 0°")
        b_rst.connect("clicked", lambda _b: (self.sl_sx.set_value(0), self.sl_sy.set_value(0), self.sl_rot.set_value(0)))
        self.get_action_area().pack_start(b_rst, False, False, 0)

        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        ok_b = self.add_button("Apply Skew", Gtk.ResponseType.OK)
        ok_b.get_style_context().add_class("cde-apply")
        self.show_all()

    def get_bg_rgba(self):
        cid = self.cmb_bg.get_active_id()
        if cid == "trans":
            return (0, 0, 0, 0)
        if cid == "black":
            return (0, 0, 0, 255)
        return (255, 255, 255, 255)

    def _emit_preview(self, *_args):
        prev = apply_skew_and_rotate(
            self.proxy_img,
            self.sl_sx.get_value(),
            self.sl_sy.get_value(),
            self.sl_rot.get_value(),
            self.get_bg_rgba(),
        )
        self.on_preview_cb(prev)

    def build_full_result(self) -> Image.Image:
        return apply_skew_and_rotate(
            self.base_img,
            self.sl_sx.get_value(),
            self.sl_sy.get_value(),
            self.sl_rot.get_value(),
            self.get_bg_rgba(),
        )


class ColorAdjustDialog(Gtk.Dialog):
    def __init__(self, parent, base_img: Image.Image, on_preview_cb):
        super().__init__(title="Adjust Color, Brightness & Sharpness — dtPics", transient_for=parent, flags=0)
        self.set_default_size(430, 280)
        self.base_img = base_img
        self.on_preview_cb = on_preview_cb
        max_dim = 750
        if max(base_img.width, base_img.height) > max_dim:
            sc = max_dim / float(max(base_img.width, base_img.height))
            self.proxy_img = base_img.resize((max(1, int(base_img.width * sc)), max(1, int(base_img.height * sc))), Image.Resampling.BILINEAR)
        else:
            self.proxy_img = base_img

        box = self.get_content_area()
        box.set_spacing(8)
        box.set_margin_start(12); box.set_margin_end(12); box.set_margin_top(10); box.set_margin_bottom(8)

        fr = Gtk.Frame(label=" Manual Image Adjustments ")
        g = Gtk.Grid(column_spacing=10, row_spacing=8, margin=10)
        fr.add(g)

        self.sl_bri = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.3, 2.0, 0.02)
        self.sl_con = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.3, 2.0, 0.02)
        self.sl_sat = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.0, 2.2, 0.02)
        self.sl_shp = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.0, 2.5, 0.05)
        for sl in (self.sl_bri, self.sl_con, self.sl_sat, self.sl_shp):
            sl.set_hexpand(True)
            sl.set_value(1.0)
            sl.connect("value-changed", self._emit_preview)

        g.attach(Gtk.Label(label="Brightness:", xalign=0), 0, 0, 1, 1); g.attach(self.sl_bri, 1, 0, 1, 1)
        g.attach(Gtk.Label(label="Contrast:", xalign=0), 0, 1, 1, 1);   g.attach(self.sl_con, 1, 1, 1, 1)
        g.attach(Gtk.Label(label="Saturation:", xalign=0), 0, 2, 1, 1); g.attach(self.sl_sat, 1, 2, 1, 1)
        g.attach(Gtk.Label(label="Sharpness:", xalign=0), 0, 3, 1, 1);  g.attach(self.sl_shp, 1, 3, 1, 1)
        box.pack_start(fr, True, True, 0)

        b_rst = Gtk.Button(label="Reset 1.0")
        b_rst.connect("clicked", lambda _b: [s.set_value(1.0) for s in (self.sl_bri, self.sl_con, self.sl_sat, self.sl_shp)])
        self.get_action_area().pack_start(b_rst, False, False, 0)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        ok_b = self.add_button("Apply Adjustments", Gtk.ResponseType.OK)
        ok_b.get_style_context().add_class("cde-apply")
        self.show_all()

    def _apply_to(self, src: Image.Image) -> Image.Image:
        rgba = src.convert("RGBA")
        r, g, b, a = rgba.split()
        rgb = Image.merge("RGB", (r, g, b))
        if abs(self.sl_bri.get_value() - 1.0) > 0.01:
            rgb = ImageEnhance.Brightness(rgb).enhance(self.sl_bri.get_value())
        if abs(self.sl_con.get_value() - 1.0) > 0.01:
            rgb = ImageEnhance.Contrast(rgb).enhance(self.sl_con.get_value())
        if abs(self.sl_sat.get_value() - 1.0) > 0.01:
            rgb = ImageEnhance.Color(rgb).enhance(self.sl_sat.get_value())
        if abs(self.sl_shp.get_value() - 1.0) > 0.01:
            rgb = ImageEnhance.Sharpness(rgb).enhance(self.sl_shp.get_value())
        cr, cg, cb = rgb.split()
        return Image.merge("RGBA", (cr, cg, cb, a))

    def _emit_preview(self, *_args):
        self.on_preview_cb(self._apply_to(self.proxy_img))

    def build_full_result(self) -> Image.Image:
        return self._apply_to(self.base_img)


