# ---------------------------------------------------------------------------
# Universal Image Decoder & Encoder (Pillow + GdkPixbuf HEIC/AVIF/SVG + Magick)
# ---------------------------------------------------------------------------
def pixbuf_to_pil(pb: GdkPixbuf.Pixbuf) -> Image.Image:
    pb_oriented = pb.apply_embedded_orientation() or pb
    w = pb_oriented.get_width()
    h = pb_oriented.get_height()
    rowstride = pb_oriented.get_rowstride()
    has_alpha = pb_oriented.get_has_alpha()
    data = pb_oriented.get_pixels()
    mode = "RGBA" if has_alpha else "RGB"
    im = Image.frombytes(mode, (w, h), data, "raw", mode, rowstride)
    return im.convert("RGBA")


def pil_to_cairo_surface(im: Image.Image) -> cairo.ImageSurface:
    rgba = im.convert("RGBA")
    r, g, b, a = rgba.split()
    # Cairo FORMAT_ARGB32 on little-endian x86_64 stores BGRA premultiplied
    # Composite cleanly via Gdk.cairo_set_source_pixbuf or premultiply
    bgra = Image.merge("RGBA", (b, g, r, a))
    # Premultiply RGB by alpha for exact Cairo rendering
    if a.getextrema()[0] < 255:
        pb = pil_to_pixbuf(rgba)
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, rgba.width, rgba.height)
        cr = cairo.Context(surf)
        Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
        cr.paint()
        return surf
    buf = bytearray(bgra.tobytes("raw", "RGBA"))
    return cairo.ImageSurface.create_for_data(buf, cairo.FORMAT_ARGB32, rgba.width, rgba.height, rgba.width * 4)


def pil_to_pixbuf(im: Image.Image) -> GdkPixbuf.Pixbuf:
    rgba = im.convert("RGBA")
    data = GLib.Bytes.new(rgba.tobytes())
    return GdkPixbuf.Pixbuf.new_from_bytes(
        data, GdkPixbuf.Colorspace.RGB, True, 8, rgba.width, rgba.height, rgba.width * 4
    )


def load_image_universal(path: Path) -> tuple[Image.Image, list[tuple[Image.Image, int]] | None, str]:
    """
    Returns (primary_rgba_image, anim_frames_or_None, format_name).
    anim_frames is [(rgba_img, delay_ms), ...] when animated GIF/WebP.
    """
    ext = path.suffix.lower()

    # 1. Try Pillow first for standard formats & animated GIF/WebP
    if ext not in (".heic", ".heif", ".avif", ".jxl", ".svg", ".svgz", ".xpm"):
        try:
            with Image.open(path) as src:
                fmt = src.format or ext.lstrip(".").upper() or "IMAGE"
                if getattr(src, "is_animated", False) and getattr(src, "n_frames", 1) > 1:
                    frames = []
                    max_f = min(getattr(src, "n_frames", 1), 160)
                    for idx in range(max_f):
                        src.seek(idx)
                        dur = int(src.info.get("duration", 80) or 80)
                        frames.append((src.convert("RGBA").copy(), max(20, dur)))
                    return frames[0][0].copy(), frames, f"{fmt} (Animated, {len(frames)} frames)"
                oriented = ImageOps.exif_transpose(src)
                return oriented.convert("RGBA"), None, fmt
        except Exception:
            pass

    # 2. Try GdkPixbuf (natively decodes HEIC, HEIF, AVIF, JXL, SVG, XPM, XBM, ICNS, etc.!)
    try:
        if ext in (".gif", ".webp"):
            anim = GdkPixbuf.PixbufAnimation.new_from_file(str(path))
            if anim and not anim.is_static_image():
                pb = anim.get_static_image()
                if pb:
                    return pixbuf_to_pil(pb), None, ext.lstrip(".").upper()
        pb = GdkPixbuf.Pixbuf.new_from_file(str(path))
        if pb is not None:
            return pixbuf_to_pil(pb), None, ext.lstrip(".").upper() or "PIXBUF"
    except Exception:
        pass

    # 3. Fallback to ImageMagick (handles PSD, RAW, exotic TIFF/HEIC variants)
    if MAGICK_BIN:
        res = subprocess.run(
            [MAGICK_BIN, f"{path}[0]", "-auto-orient", "png:-"],
            capture_output=True,
        )
        if res.returncode == 0 and res.stdout:
            with Image.open(io.BytesIO(res.stdout)) as im:
                return im.convert("RGBA"), None, ext.lstrip(".").upper() or "IMAGE"

    raise RuntimeError(f"Unsupported or corrupted image file: {path.name}")


def save_image_universal(im: Image.Image, out_path: Path):
    ext = out_path.suffix.lower()
    out_path.parent.mkdir(parents=True, exist_ok=True)

    if ext in (".jpg", ".jpeg", ".jpe", ".jfif", ".bmp", ".ppm"):
        # Flatten alpha onto white background for non-alpha formats
        bg = Image.new("RGB", im.size, (255, 255, 255))
        rgba = im.convert("RGBA")
        bg.paste(rgba, mask=rgba.split()[3])
        if ext in (".jpg", ".jpeg", ".jpe", ".jfif"):
            bg.save(out_path, format="JPEG", quality=94, optimize=True)
        elif ext == ".bmp":
            bg.save(out_path, format="BMP")
        else:
            bg.save(out_path, format="PPM")
        return

    if ext == ".webp":
        im.convert("RGBA").save(out_path, format="WEBP", quality=92)
        return

    if ext in (".tif", ".tiff"):
        im.convert("RGBA").save(out_path, format="TIFF", compression="tiff_adobe_deflate")
        return

    if ext == ".gif":
        im.convert("RGBA").save(out_path, format="GIF")
        return

    if ext == ".ico":
        sz = min(256, max(im.width, im.height))
        im.convert("RGBA").resize((sz, sz), Image.Resampling.LANCZOS).save(out_path, format="ICO")
        return

    if ext in (".heic", ".heif", ".avif") and MAGICK_BIN:
        with tempfile.NamedTemporaryFile(suffix=".png", delete=False) as tf:
            tmp_png = Path(tf.name)
        try:
            im.convert("RGBA").save(tmp_png, format="PNG")
            res = subprocess.run([MAGICK_BIN, str(tmp_png), str(out_path)], capture_output=True, text=True)
            if res.returncode != 0:
                raise RuntimeError(res.stderr.strip() or f"Could not encode {ext}")
        finally:
            tmp_png.unlink(missing_ok=True)
        return

    # Default: lossless PNG
    im.convert("RGBA").save(out_path, format="PNG")


# ---------------------------------------------------------------------------
# Image Processing: Magic Color Correction, Skew/Shear, Text & Vector Drawing
# ---------------------------------------------------------------------------
def apply_magic_color(im: Image.Image) -> Image.Image:
    """
    1-Click Magic Color Correction:
      1. Outlier-safe per-channel percentile levels + gentle gray-world white balance
      2. Adaptive shadow/midtone gamma lift for dark/underexposed shots
      3. Subtle S-curve contrast + natural saturation vibrancy + crisp unsharp mask
    """
    rgba = im.convert("RGBA")
    r_ch, g_ch, b_ch, a_ch = rgba.split()
    rgb = Image.merge("RGB", (r_ch, g_ch, b_ch))
    total_px = max(1, rgb.width * rgb.height)

    hist = rgb.histogram()
    hr, hg, hb = hist[0:256], hist[256:512], hist[512:768]

    def percentiles_and_mean(h):
        lo_cut = total_px * 0.004
        hi_cut = total_px * 0.996
        acc = 0
        lo_v = 0
        for i, c in enumerate(h):
            acc += c
            if acc >= lo_cut:
                lo_v = i
                break
        acc = 0
        hi_v = 255
        for i in range(255, -1, -1):
            acc += h[i]
            if total_px - acc <= hi_cut:
                hi_v = i
                break
        mean_v = sum(i * c for i, c in enumerate(h)) / float(total_px)
        return lo_v, max(lo_v + 12, hi_v), mean_v

    r_lo, r_hi, r_mean = percentiles_and_mean(hr)
    g_lo, g_hi, g_mean = percentiles_and_mean(hg)
    b_lo, b_hi, b_mean = percentiles_and_mean(hb)

    # Blend 50% between global luminance levels (preserves intentional warmth) and per-channel WB
    g_min = min(r_lo, g_lo, b_lo)
    g_max = max(r_hi, g_hi, b_hi)

    avg_luma = 0.299 * r_mean + 0.587 * g_mean + 0.114 * b_mean
    # Adaptive gamma: lift shadows if photo is dark, slight richness if washed out
    if avg_luma < 95:
        gamma = 0.84
    elif avg_luma < 118:
        gamma = 0.92
    elif avg_luma > 180:
        gamma = 1.06
    else:
        gamma = 0.98

    def make_lut(ch_lo, ch_hi, ch_mean):
        eff_lo = 0.55 * g_min + 0.45 * ch_lo
        eff_hi = 0.55 * g_max + 0.45 * ch_hi
        span = max(16.0, eff_hi - eff_lo)
        wb_gain = 1.0
        if ch_mean > 12.0 and avg_luma > 12.0:
            raw_gain = avg_luma / ch_mean
            # Clamp WB gain gently to [0.90, 1.12] so sunsets/graphics never shift weirdly
            wb_gain = max(0.90, min(1.12, 1.0 + (raw_gain - 1.0) * 0.45))

        lut = []
        for x in range(256):
            v = (x - eff_lo) / span
            v = max(0.0, min(1.0, v)) * wb_gain
            v = max(0.0, min(1.0, v))
            # Gamma + gentle S-curve contrast
            v = pow(v, gamma)
            v = v - 0.035 * math.sin(2.0 * math.pi * v)
            lut.append(max(0, min(255, int(round(v * 255.0)))))
        return lut

    lut_all = make_lut(r_lo, r_hi, r_mean) + make_lut(g_lo, g_hi, g_mean) + make_lut(b_lo, b_hi, b_mean)
    balanced = rgb.point(lut_all)
    vibrant = ImageEnhance.Color(balanced).enhance(1.14)
    crisp = vibrant.filter(ImageFilter.UnsharpMask(radius=1.3, percent=110, threshold=3))
    cr, cg, cb = crisp.split()
    return Image.merge("RGBA", (cr, cg, cb, a_ch))


def apply_skew_and_rotate(im: Image.Image, skew_x_deg: float, skew_y_deg: float,
                          rot_deg: float, bg_rgba: tuple[int, int, int, int]) -> Image.Image:
    out = im.convert("RGBA")
    if abs(rot_deg) > 0.05:
        out = out.rotate(-rot_deg, resample=Image.Resampling.BICUBIC, expand=True, fillcolor=bg_rgba)

    tx = math.tan(math.radians(max(-60.0, min(60.0, skew_x_deg))))
    ty = math.tan(math.radians(max(-60.0, min(60.0, skew_y_deg))))
    if abs(tx) < 1e-4 and abs(ty) < 1e-4:
        return out

    w, h = out.size
    corners = [
        (0.0, 0.0),
        (w + tx * 0.0, ty * w + 0.0),
        (tx * h, h),
        (w + tx * h, ty * w + h),
    ]
    min_x = min(c[0] for c in corners)
    max_x = max(c[0] for c in corners)
    min_y = min(c[1] for c in corners)
    max_y = max(c[1] for c in corners)
    nw = max(1, int(math.ceil(max_x - min_x)))
    nh = max(1, int(math.ceil(max_y - min_y)))

    # Forward map: x' = x + tx*y - min_x ; y' = ty*x + y - min_y
    # Inverse matrix for PIL Image.Transform.AFFINE:
    det = 1.0 - tx * ty
    if abs(det) < 1e-5:
        return out
    a = 1.0 / det
    b = -tx / det
    c = (min_x - tx * min_y) / det
    d = -ty / det
    e = 1.0 / det
    f = (min_y - ty * min_x) / det
    return out.transform(
        (nw, nh),
        Image.Transform.AFFINE,
        (a, b, c, d, e, f),
        resample=Image.Resampling.BICUBIC,
        fillcolor=bg_rgba,
    )


def render_text_stamp_onto(im: Image.Image, text: str, x: float, y: float,
                           font_pt: int, bold: bool, hex_col: str, outline: bool) -> Image.Image:
    if not text.strip():
        return im
    surf = pil_to_cairo_surface(im)
    cr = cairo.Context(surf)
    layout = PangoCairo.create_layout(cr)
    weight = "Bold" if bold else "Regular"
    desc = Pango.FontDescription(f"DejaVu Sans {weight} {max(8, font_pt)}px")
    layout.set_font_description(desc)
    layout.set_text(text, -1)

    h = hex_col.lstrip("#")
    rf = int(h[0:2], 16) / 255.0
    gf = int(h[2:4], 16) / 255.0
    bf = int(h[4:6], 16) / 255.0

    cr.save()
    cr.move_to(x, y)
    if outline:
        PangoCairo.layout_path(cr, layout)
        luma = 0.299 * rf + 0.587 * gf + 0.114 * bf
        if luma > 0.35:
            cr.set_source_rgba(0.05, 0.06, 0.09, 0.92)
        else:
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.92)
        cr.set_line_width(max(2.5, font_pt * 0.14))
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        cr.stroke_preserve()
        cr.set_source_rgba(rf, gf, bf, 1.0)
        cr.fill()
    else:
        cr.set_source_rgba(rf, gf, bf, 1.0)
        PangoCairo.show_layout(cr, layout)
    cr.restore()
    surf.flush()

    # Convert ARGB32 Cairo surface back to PIL RGBA via Gdk.pixbuf_get_from_surface
    pb = Gdk.pixbuf_get_from_surface(surf, 0, 0, surf.get_width(), surf.get_height())
    return pixbuf_to_pil(pb)


def render_stroke_onto(im: Image.Image, tool: str, points: list[tuple[float, float]],
                       hex_col: str, width_px: float) -> Image.Image:
    if len(points) < 1:
        return im
    surf = pil_to_cairo_surface(im)
    cr = cairo.Context(surf)
    h = hex_col.lstrip("#")
    rf = int(h[0:2], 16) / 255.0
    gf = int(h[2:4], 16) / 255.0
    bf = int(h[4:6], 16) / 255.0

    alpha = 0.38 if tool == "highlight" else 1.0
    lw = width_px * (2.6 if tool == "highlight" else 1.0)
    cr.set_source_rgba(rf, gf, bf, alpha)
    cr.set_line_width(max(1.0, lw))
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)

    if tool in ("pen", "highlight"):
        x0, y0 = points[0]
        cr.move_to(x0, y0)
        if len(points) == 1:
            cr.line_to(x0 + 0.1, y0 + 0.1)
        else:
            for px, py in points[1:]:
                cr.line_to(px, py)
        cr.stroke()
    elif tool == "box" and len(points) >= 2:
        x0, y0 = points[0]
        x1, y1 = points[-1]
        rx, ry = min(x0, x1), min(y0, y1)
        cr.set_line_join(cairo.LINE_JOIN_MITER)
        cr.rectangle(rx, ry, abs(x1 - x0), abs(y1 - y0))
        cr.stroke()
    elif tool == "arrow" and len(points) >= 2:
        x0, y0 = points[0]
        x1, y1 = points[-1]
        cr.move_to(x0, y0)
        cr.line_to(x1, y1)
        cr.stroke()
        ang = math.atan2(y1 - y0, x1 - x0)
        head = max(12.0, lw * 3.8)
        cr.move_to(x1, y1)
        cr.line_to(x1 - head * math.cos(ang - 0.45), y1 - head * math.sin(ang - 0.45))
        cr.move_to(x1, y1)
        cr.line_to(x1 - head * math.cos(ang + 0.45), y1 - head * math.sin(ang + 0.45))
        cr.stroke()

    surf.flush()
    pb = Gdk.pixbuf_get_from_surface(surf, 0, 0, surf.get_width(), surf.get_height())
    return pixbuf_to_pil(pb)


