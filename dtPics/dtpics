    def on_resize_dialog(self, *_args):
        if self.img is None:
            return
        dlg = Gtk.Dialog(title="Resize Image — dtPics", transient_for=self, flags=0)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Resize", Gtk.ResponseType.OK)
        g = Gtk.Grid(column_spacing=8, row_spacing=8, margin=12)
        dlg.get_content_area().add(g)
        aspect = self.img.width / float(max(1, self.img.height))
        sp_w = Gtk.SpinButton.new_with_range(8, 12000, 1); sp_w.set_value(self.img.width)
        sp_h = Gtk.SpinButton.new_with_range(8, 12000, 1); sp_h.set_value(self.img.height)
        chk_lock = Gtk.CheckButton(label="Keep aspect ratio", active=True)
        updating = [False]

        def _w_chg(_s):
            if not updating[0] and chk_lock.get_active():
                updating[0] = True
                sp_h.set_value(max(8, round(sp_w.get_value() / aspect)))
                updating[0] = False

        def _h_chg(_s):
            if not updating[0] and chk_lock.get_active():
                updating[0] = True
                sp_w.set_value(max(8, round(sp_h.get_value() * aspect)))
                updating[0] = False

        sp_w.connect("value-changed", _w_chg)
        sp_h.connect("value-changed", _h_chg)
        g.attach(Gtk.Label(label="Width (px):", xalign=0), 0, 0, 1, 1);  g.attach(sp_w, 1, 0, 1, 1)
        g.attach(Gtk.Label(label="Height (px):", xalign=0), 0, 1, 1, 1); g.attach(sp_h, 1, 1, 1, 1)
        g.attach(chk_lock, 0, 2, 2, 1)
        dlg.show_all()
        if dlg.run() == Gtk.ResponseType.OK:
            nw, nh = int(sp_w.get_value()), int(sp_h.get_value())
            dlg.destroy()
            if (nw, nh) != self.img.size:
                self._push_undo()
                self._set_working_image(self.img.resize((nw, nh), Image.Resampling.LANCZOS))
                self.set_status(f"Resized image to {nw} × {nh} px.")
        else:
            dlg.destroy()

    def apply_crop(self, *_args):
        if self.img is None or not self.crop_rect:
            return
        x0, y0, x1, y1 = self.crop_rect
        lx = max(0, min(self.img.width - 1, int(round(min(x0, x1)))))
        ty = max(0, min(self.img.height - 1, int(round(min(y0, y1)))))
        rx = max(lx + 1, min(self.img.width, int(round(max(x0, x1)))))
        by = max(ty + 1, min(self.img.height, int(round(max(y0, y1)))))
        if rx - lx < 4 or by - ty < 4:
            self.set_status("Crop selection too small.")
            return
        self._push_undo()
        cropped = self.img.crop((lx, ty, rx, by))
        self.crop_rect = None
        self.set_tool("view")
        self.fit_mode = True
        self._set_working_image(cropped)
        self.set_status(f"Cropped to {cropped.width} × {cropped.height} px.")

    # ---------------- Viewport Transform & Canvas Rendering ----------------
    def _compute_viewport(self) -> tuple[float, float, float]:
        """Return (scale, offset_x, offset_y) for active displayed image."""
        disp_im = self.preview_override or self.img
        if disp_im is None:
            return 1.0, 0.0, 0.0
        alloc = self.canvas.get_allocation()
        cw, ch = max(40, alloc.width), max(40, alloc.height)
        iw, ih = disp_im.width, disp_im.height
        if self.fit_mode:
            sc = min((cw - 24) / float(iw), (ch - 24) / float(ih), 1.0 if (iw < cw and ih < ch) else 99.0)
            sc = max(0.02, sc)
            self.zoom = sc
            ox = (cw - iw * sc) / 2.0
            oy = (ch - ih * sc) / 2.0
            return sc, ox, oy
        sc = max(0.05, min(32.0, self.zoom))
        ox = (cw - iw * sc) / 2.0 + self.pan_x
        oy = (ch - ih * sc) / 2.0 + self.pan_y
        return sc, ox, oy

    def _canvas_to_img(self, cx: float, cy: float) -> tuple[float, float]:
        sc, ox, oy = self._compute_viewport()
        return (cx - ox) / sc, (cy - oy) / sc

    def set_fit_mode(self, fit: bool):
        self.fit_mode = fit
        if fit:
            self.pan_x = self.pan_y = 0.0
        self.canvas.queue_draw()

    def set_zoom_exact(self, z: float):
        self.fit_mode = False
        self.zoom = max(0.05, min(24.0, z))
        self.pan_x = self.pan_y = 0.0
        self.canvas.queue_draw()

    def step_zoom(self, factor: float):
        sc, _, _ = self._compute_viewport()
        self.fit_mode = False
        self.zoom = max(0.05, min(24.0, sc * factor))
        self.canvas.queue_draw()

    def toggle_fullscreen(self):
        if self.is_fullscreen:
            self.unfullscreen()
            self.is_fullscreen = False
        else:
            self.fullscreen()
            self.is_fullscreen = True

    def on_canvas_draw(self, _widget, cr: cairo.Context):
        alloc = self.canvas.get_allocation()
        cw, ch = alloc.width, alloc.height

        # Sunken dark slate CDE studio backdrop
        cr.set_source_rgb(0.17, 0.185, 0.22)
        cr.paint()

        disp_im = self.preview_override or self.img
        if disp_im is None or self.cairo_surf is None:
            cr.set_source_rgb(0.82, 0.84, 0.90)
            layout = PangoCairo.create_layout(cr)
            layout.set_font_description(Pango.FontDescription("DejaVu Sans 11"))
            layout.set_text("Drop any image here or click Open...\n(.png, .jpg, .bmp, .gif, .heic, .webp, .avif, .svg, .tiff)", -1)
            layout.set_alignment(Pango.Alignment.CENTER)
            _, ext = layout.get_pixel_extents()
            cr.move_to((cw - ext.width) / 2, (ch - ext.height) / 2)
            PangoCairo.show_layout(cr, layout)
            return False

        sc, ox, oy = self._compute_viewport()
        self.lbl_zoom.set_text(f"{int(round(sc * 100))}%")
        dw, dh = disp_im.width * sc, disp_im.height * sc

        # Subtle drop shadow + checkerboard under transparent images
        cr.set_source_rgba(0.0, 0.0, 0.0, 0.45)
        cr.rectangle(ox + 4, oy + 4, dw, dh)
        cr.fill()

        # Subtle neutral checkerboard for alpha transparency
        cr.save()
        cr.rectangle(ox, oy, dw, dh)
        cr.clip()
        cr.set_source_rgb(0.92, 0.92, 0.94)
        cr.paint()
        cell = 12
        cr.set_source_rgb(0.78, 0.79, 0.82)
        for cy_i in range(int(oy), int(oy + dh) + cell, cell):
            row_idx = (cy_i - int(oy)) // cell
            for cx_i in range(int(ox) + (cell if (row_idx & 1) else 0), int(ox + dw) + cell, cell * 2):
                cr.rectangle(cx_i, cy_i, cell, cell)
        cr.fill()

        # Draw actual image
        cr.translate(ox, oy)
        cr.scale(sc, sc)
        cr.set_source_surface(self.cairo_surf, 0, 0)
        if sc >= 3.0:
            cr.get_source().set_filter(cairo.FILTER_NEAREST)
        cr.paint()

        # Live in-progress Pen / Highlight / Arrow / Box stroke preview
        if self._drawing and self.stroke_pts:
            h = self.pen_color.lstrip("#")
            rf, gf, bf = int(h[0:2], 16) / 255.0, int(h[2:4], 16) / 255.0, int(h[4:6], 16) / 255.0
            alpha = 0.38 if self.tool == "highlight" else 1.0
            lw = self.pen_width * (2.6 if self.tool == "highlight" else 1.0)
            cr.set_source_rgba(rf, gf, bf, alpha)
            cr.set_line_width(max(1.0, lw))
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.set_line_join(cairo.LINE_JOIN_ROUND)
            if self.tool in ("pen", "highlight"):
                cr.move_to(*self.stroke_pts[0])
                for px, py in self.stroke_pts[1:]:
                    cr.line_to(px, py)
                cr.stroke()
            elif self.tool == "box" and len(self.stroke_pts) >= 2:
                x0, y0 = self.stroke_pts[0]; x1, y1 = self.stroke_pts[-1]
                cr.rectangle(min(x0, x1), min(y0, y1), abs(x1 - x0), abs(y1 - y0))
                cr.stroke()
            elif self.tool == "arrow" and len(self.stroke_pts) >= 2:
                x0, y0 = self.stroke_pts[0]; x1, y1 = self.stroke_pts[-1]
                cr.move_to(x0, y0); cr.line_to(x1, y1); cr.stroke()
                ang = math.atan2(y1 - y0, x1 - x0)
                head = max(12.0, lw * 3.8)
                cr.move_to(x1, y1); cr.line_to(x1 - head * math.cos(ang - 0.45), y1 - head * math.sin(ang - 0.45))
                cr.move_to(x1, y1); cr.line_to(x1 - head * math.cos(ang + 0.45), y1 - head * math.sin(ang + 0.45))
                cr.stroke()

        # Live Text Overlay cursor preview
        if self.tool == "text" and self.hover_img_xy is not None:
            txt = self.ent_text.get_text()
            if txt.strip():
                tx, ty = self.hover_img_xy
                fpt = int(self.spn_tfont.get_value())
                weight = "Bold" if self.chk_tbold.get_active() else "Regular"
                layout = PangoCairo.create_layout(cr)
                layout.set_font_description(Pango.FontDescription(f"DejaVu Sans {weight} {fpt}px"))
                layout.set_text(txt, -1)
                h = self.pen_color.lstrip("#")
                rf, gf, bf = int(h[0:2], 16) / 255.0, int(h[2:4], 16) / 255.0, int(h[4:6], 16) / 255.0
                cr.move_to(tx, ty)
                if self.chk_toutline.get_active():
                    PangoCairo.layout_path(cr, layout)
                    luma = 0.299 * rf + 0.587 * gf + 0.114 * bf
                    cr.set_source_rgba(0.05, 0.06, 0.09, 0.85) if luma > 0.35 else cr.set_source_rgba(1, 1, 1, 0.85)
                    cr.set_line_width(max(2.5, fpt * 0.14))
                    cr.stroke_preserve()
                    cr.set_source_rgba(rf, gf, bf, 0.90)
                    cr.fill()
                else:
                    cr.set_source_rgba(rf, gf, bf, 0.90)
                    PangoCairo.show_layout(cr, layout)

        cr.restore()

        # Crop selection overlay + rule-of-thirds grid (in screen coordinates for crisp 1px lines)
        if self.tool == "crop" and self.crop_rect:
            x0, y0, x1, y1 = self.crop_rect
            sx0, sy0 = ox + min(x0, x1) * sc, oy + min(y0, y1) * sc
            sx1, sy1 = ox + max(x0, x1) * sc, oy + max(y0, y1) * sc
            sw, sh = sx1 - sx0, sy1 - sy0
            if sw > 2 and sh > 2:
                cr.set_source_rgba(0.0, 0.0, 0.0, 0.50)
                cr.rectangle(ox, oy, dw, sy0 - oy); cr.fill()
                cr.rectangle(ox, sy1, dw, (oy + dh) - sy1); cr.fill()
                cr.rectangle(ox, sy0, sx0 - ox, sh); cr.fill()
                cr.rectangle(sx1, sy0, (ox + dw) - sx1, sh); cr.fill()

                cr.set_source_rgba(1.0, 0.92, 0.35, 0.95)
                cr.set_line_width(2.0)
                cr.rectangle(sx0, sy0, sw, sh)
                cr.stroke()

                # Rule of thirds guides
                cr.set_source_rgba(1.0, 1.0, 1.0, 0.45)
                cr.set_line_width(1.0)
                for k in (1, 2):
                    cr.move_to(sx0 + sw * k / 3.0, sy0); cr.line_to(sx0 + sw * k / 3.0, sy1)
                    cr.move_to(sx0, sy0 + sh * k / 3.0); cr.line_to(sx1, sy0 + sh * k / 3.0)
                cr.stroke()

        return False

    # ---------------- Mouse, Stylus & Keyboard Events ----------------
    def _on_canvas_leave(self, *_args):
        if self.hover_img_xy is not None:
            self.hover_img_xy = None
            self.canvas.queue_draw()
        return False

    def on_canvas_press(self, _w, ev):
        self.canvas.grab_focus()
        if self.img is None:
            return False

        # Middle mouse button always pans
        if ev.button == 2 or (ev.button == 1 and self.tool == "view"):
            self._panning = True
            self._pan_start_mouse = (ev.x, ev.y)
            self._pan_start_off = (self.pan_x, self.pan_y)
            return True

        if ev.button != 1:
            return False

        ix, iy = self._canvas_to_img(ev.x, ev.y)
        if self.tool == "crop":
            ix_c = max(0.0, min(float(self.img.width), ix))
            iy_c = max(0.0, min(float(self.img.height), iy))
            self.crop_rect = [ix_c, iy_c, ix_c, iy_c]
            self._crop_dragging = True
            self.canvas.queue_draw()
            return True

        if self.tool in ("pen", "highlight", "arrow", "box"):
            self._drawing = True
            self.stroke_pts = [(ix, iy)]
            self.canvas.queue_draw()
            return True

        if self.tool == "text":
            txt = self.ent_text.get_text()
            if txt.strip():
                self._push_undo()
                stamped = render_text_stamp_onto(
                    self.img,
                    txt,
                    ix,
                    iy,
                    int(self.spn_tfont.get_value()),
                    self.chk_tbold.get_active(),
                    self.pen_color,
                    self.chk_toutline.get_active(),
                )
                self._set_working_image(stamped)
                self.set_status(f"Stamped text '{txt}' onto image (Ctrl+Z to undo).")
            return True

        return False

    def on_canvas_motion(self, _w, ev):
        if self.img is None:
            return False

        if self._panning:
            if self.fit_mode:
                self.fit_mode = False
            dx = ev.x - self._pan_start_mouse[0]
            dy = ev.y - self._pan_start_mouse[1]
            self.pan_x = self._pan_start_off[0] + dx
            self.pan_y = self._pan_start_off[1] + dy
            self.canvas.queue_draw()
            return True

        ix, iy = self._canvas_to_img(ev.x, ev.y)
        if self.tool == "crop" and self._crop_dragging and self.crop_rect:
            self.crop_rect[2] = max(0.0, min(float(self.img.width), ix))
            self.crop_rect[3] = max(0.0, min(float(self.img.height), iy))
            w_px = int(abs(self.crop_rect[2] - self.crop_rect[0]))
            h_px = int(abs(self.crop_rect[3] - self.crop_rect[1]))
            self.lbl_crop_info.set_text(f"Crop Selection: {w_px} × {h_px} px")
            self.canvas.queue_draw()
            return True

        if self._drawing and self.tool in ("pen", "highlight", "arrow", "box"):
            if self.tool in ("arrow", "box") and len(self.stroke_pts) >= 2:
                self.stroke_pts[-1] = (ix, iy)
            else:
                self.stroke_pts.append((ix, iy))
            self.canvas.queue_draw()
            return True

        if self.tool == "text":
            self.hover_img_xy = (ix, iy)
            self.canvas.queue_draw()
            return True

        return False

    def on_canvas_release(self, _w, ev):
        if self._panning:
            self._panning = False
            return True
        if self._crop_dragging:
            self._crop_dragging = False
            return True
        if self._drawing:
            self._drawing = False
            if self.img is not None and self.stroke_pts:
                self._push_undo()
                drawn = render_stroke_onto(self.img, self.tool, self.stroke_pts, self.pen_color, self.pen_width)
                self.stroke_pts.clear()
                self._set_working_image(drawn)
            return True
        return False

    def on_canvas_scroll(self, _w, ev):
        if self.img is None:
            return False
        if ev.direction == Gdk.ScrollDirection.UP:
            self.step_zoom(1.15)
            return True
        if ev.direction == Gdk.ScrollDirection.DOWN:
            self.step_zoom(1.0 / 1.15)
            return True
        return False

    def on_key_press(self, _w, ev):
        # Allow normal typing when focused in text entry / spinbutton
        foc = self.get_focus()
        if isinstance(foc, Gtk.Entry):
            if ev.keyval == Gdk.KEY_Escape:
                self.set_tool("view")
                return True
            return False

        ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
        shift = bool(ev.state & Gdk.ModifierType.SHIFT_MASK)
        kv = ev.keyval

        if ctrl and kv in (Gdk.KEY_o, Gdk.KEY_O):
            self.on_open_dialog(); return True
        if ctrl and shift and kv in (Gdk.KEY_s, Gdk.KEY_S):
            self.on_save_as(); return True
        if ctrl and kv in (Gdk.KEY_s, Gdk.KEY_S):
            self.on_save(); return True
        if ctrl and kv in (Gdk.KEY_z, Gdk.KEY_Z):
            self.on_undo(); return True
        if ctrl and kv in (Gdk.KEY_y, Gdk.KEY_Y):
            self.on_redo(); return True
        if ctrl and kv in (Gdk.KEY_c, Gdk.KEY_C):
            self.on_copy_clipboard(); return True
        if ctrl and kv in (Gdk.KEY_v, Gdk.KEY_V):
            self.on_paste_clipboard(); return True
        if ctrl and kv in (Gdk.KEY_q, Gdk.KEY_Q):
            self.on_close_request(); return True

        if kv == Gdk.KEY_F11:
            self.toggle_fullscreen(); return True
        if kv == Gdk.KEY_Escape:
            if self.is_fullscreen:
                self.toggle_fullscreen()
            else:
                self.set_tool("view")
            return True
        if kv in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and self.tool == "crop" and self.crop_rect:
            self.apply_crop(); return True
        if kv == Gdk.KEY_Left and self.tool == "view":
            self.step_folder(-1); return True
        if kv == Gdk.KEY_Right and self.tool == "view":
            self.step_folder(1); return True
        if kv in (Gdk.KEY_plus, Gdk.KEY_equal, Gdk.KEY_KP_Add):
            self.step_zoom(1.25); return True
        if kv in (Gdk.KEY_minus, Gdk.KEY_underscore, Gdk.KEY_KP_Subtract):
            self.step_zoom(0.8); return True
        if kv in (Gdk.KEY_0, Gdk.KEY_KP_0):
            self.set_fit_mode(True); return True
        if kv in (Gdk.KEY_1, Gdk.KEY_KP_1):
            self.set_zoom_exact(1.0); return True
        return False

    def on_drag_drop(self, _w, context, _x, _y, data, _info, time_):
        uris = data.get_uris() or []
        chosen = None
        for u in uris:
            if u.startswith("file://"):
                p = Path(urllib.parse.unquote(urllib.parse.urlparse(u).path))
                if p.is_file():
                    chosen = p
                    break
        if chosen is None:
            raw = (data.get_text() or "").strip()
            for tok in re.split(r"[\r\n\x00]+", raw):
                tok = tok.strip()
                if not tok:
                    continue
                p = Path(urllib.parse.unquote(urllib.parse.urlparse(tok).path)) if tok.startswith("file://") else Path(tok)
                if p.is_file():
                    chosen = p
                    break
        Gtk.drag_finish(context, chosen is not None, False, time_)
        if chosen is not None:
            self.open_file(chosen)

    def on_about(self, *_args):
        md = Gtk.MessageDialog(
            transient_for=self, flags=0, message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK, text="dtPics — CDE Image Viewer & Photo Editor",
        )
        md.format_secondary_text(
            "Native Common Desktop Environment image viewer & quick editor.\n\n"
            "• Formats: PNG, JPG, BMP, GIF (animated), HEIC/HEIF, WebP, AVIF, JXL, SVG, TIFF, ICO, XPM\n"
            "• Tools: Crop, Rotate, Flip, Skew/Straighten, 1-Click Magic Color, Text Overlay, and Pen/Callouts."
        )
        md.run()
        md.destroy()

    def on_close_request(self):
        if self.modified and self.img is not None:
            md = Gtk.MessageDialog(
                transient_for=self, flags=0, message_type=Gtk.MessageType.QUESTION,
                buttons=Gtk.ButtonsType.NONE,
                text="Save changes to image before closing dtPics?",
            )
            md.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                           "Discard Changes", Gtk.ResponseType.NO,
                           "Save", Gtk.ResponseType.YES)
            resp = md.run()
            md.destroy()
            if resp == Gtk.ResponseType.CANCEL or resp == Gtk.ResponseType.DELETE_EVENT:
                return True
            if resp == Gtk.ResponseType.YES:
                self.on_save()
                if self.modified:
                    return True
        self._stop_anim()
        self.destroy()
        Gtk.main_quit()
        return False

    def _error(self, msg: str):
        md = Gtk.MessageDialog(transient_for=self, flags=0, message_type=Gtk.MessageType.ERROR,
                               buttons=Gtk.ButtonsType.OK, text=msg)
        md.run()
        md.destroy()


def main():
    chrome, sel, well = load_cde_palette()
    provider = Gtk.CssProvider()
    provider.load_from_data(build_cde_css(chrome, sel, well))
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    init_file = None
    for arg in sys.argv[1:]:
        a = arg.strip()
        if a and not a.startswith("-") and Path(a).expanduser().is_file():
            init_file = Path(a).expanduser().resolve()
            break

    win = DtPicsWindow(init_file)
    win.connect("destroy", Gtk.main_quit)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
