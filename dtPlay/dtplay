def format_time(sec: float) -> str:
    if sec < 0 or math.isnan(sec):
        sec = 0.0
    tot = int(round(sec))
    h, rem = divmod(tot, 3600)
    m, s = divmod(rem, 60)
    return f"{h}:{m:02d}:{s:02d}" if h > 0 else f"{m:02d}:{s:02d}"


def human_size(num: int) -> str:
    if num < 1024:
        return f"{num} B"
    f = float(num)
    for u in ("KB", "MB", "GB"):
        f /= 1024.0
        if f < 1024.0 or u == "GB":
            return f"{f:.1f} {u}"
    return ""


# ---------------------------------------------------------------------------
# Fast Non-Realtime GStreamer Segment Clip Extractor (Audio & Video)
# ---------------------------------------------------------------------------
def extract_media_clip_gst(src_path: Path, out_path: Path, start_sec: float, duration_sec: float,
                           expect_video: bool) -> None:
    """
    Extract [start_sec, start_sec + duration_sec] from src_path into out_path
    using GStreamer uridecodebin + encoders at maximum non-realtime speed.
    """
    ext = out_path.suffix.lower()
    uri = src_path.resolve().as_uri()
    start_ns = max(0, int(round(start_sec * Gst.SECOND)))
    stop_ns = start_ns + max(int(0.25 * Gst.SECOND), int(round(duration_sec * Gst.SECOND)))

    pipe = Gst.Pipeline.new("clip_pipeline")
    dec = Gst.ElementFactory.make("uridecodebin", "dec")
    dec.set_property("uri", uri)
    pipe.add(dec)

    sink = Gst.ElementFactory.make("filesink", "sink")
    sink.set_property("location", str(out_path))
    sink.set_property("sync", False)
    pipe.add(sink)

    mux = None
    v_Entry = None
    a_Entry = None

    if expect_video or ext in (".mp4", ".m4v", ".mov"):
        mux = Gst.ElementFactory.make("mp4mux", "mux")
        pipe.add(mux)
        mux.link(sink)

        # Video branch
        vq = Gst.ElementFactory.make("queue", "vq")
        vconv = Gst.ElementFactory.make("videoconvert", "vconv")
        x264 = Gst.ElementFactory.make("x264enc", "venc")
        if x264:
            x264.set_property("speed-preset", 1)  # ultrafast
            x264.set_property("quantizer", 21)
        else:
            x264 = Gst.ElementFactory.make("openh264enc", "venc")
        vparse = Gst.ElementFactory.make("h264parse", "vparse")
        for el in (vq, vconv, x264, vparse):
            pipe.add(el)
        vq.link(vconv)
        vconv.link(x264)
        x264.link(vparse)
        vparse.link(mux)
        v_Entry = vq

        # Audio branch (optional if video is silent!)
        aq = Gst.ElementFactory.make("queue", "aq")
        aconv = Gst.ElementFactory.make("audioconvert", "aconv")
        ares = Gst.ElementFactory.make("audioresample", "ares")
        aenc = Gst.ElementFactory.make("avenc_aac", "aenc") or Gst.ElementFactory.make("voaacenc", "aenc")
        for el in (aq, aconv, ares, aenc):
            pipe.add(el)
        aq.link(aconv)
        aconv.link(ares)
        ares.link(aenc)
        a_Entry = (aq, aenc)
    else:
        # Pure audio output (.mp3, .wav, .flac, .m4a, .ogg)
        aq = Gst.ElementFactory.make("queue", "aq")
        aconv = Gst.ElementFactory.make("audioconvert", "aconv")
        ares = Gst.ElementFactory.make("audioresample", "ares")
        for el in (aq, aconv, ares):
            pipe.add(el)
        aq.link(aconv)
        aconv.link(ares)

        if ext == ".wav":
            enc = Gst.ElementFactory.make("wavenc", "aenc")
            pipe.add(enc); ares.link(enc); enc.link(sink)
        elif ext == ".flac":
            enc = Gst.ElementFactory.make("flacenc", "aenc")
            pipe.add(enc); ares.link(enc); enc.link(sink)
        elif ext in (".m4a", ".aac"):
            enc = Gst.ElementFactory.make("avenc_aac", "aenc")
            mux = Gst.ElementFactory.make("mp4mux", "mux")
            pipe.add(enc); pipe.add(mux)
            ares.link(enc); enc.link(mux); mux.link(sink)
        elif ext in (".ogg", ".opus"):
            enc = Gst.ElementFactory.make("vorbisenc", "aenc")
            mux = Gst.ElementFactory.make("oggmux", "mux")
            pipe.add(enc); pipe.add(mux)
            ares.link(enc); enc.link(mux); mux.link(sink)
        else:
            enc = Gst.ElementFactory.make("lamemp3enc", "aenc")
            pipe.add(enc); ares.link(enc); enc.link(sink)
        a_Entry = (aq, None)

    linked_v = [False]
    linked_a = [False]

    def _on_pad_added(_element, pad):
        caps = pad.get_current_caps() or pad.query_caps(None)
        if not caps or caps.get_size() == 0:
            return
        name = caps.get_structure(0).get_name()
        if name.startswith("video/") and v_Entry is not None and not linked_v[0]:
            sp = v_Entry.get_static_pad("sink")
            if sp and not sp.is_linked():
                if pad.link(sp) == Gst.PadLinkReturn.OK:
                    linked_v[0] = True
        elif name.startswith("audio/") and a_Entry is not None and not linked_a[0]:
            aq_el, aenc_el = a_Entry
            sp = aq_el.get_static_pad("sink")
            if sp and not sp.is_linked():
                if pad.link(sp) == Gst.PadLinkReturn.OK:
                    linked_a[0] = True
                    if aenc_el is not None and mux is not None:
                        aenc_el.link(mux)

    dec.connect("pad-added", _on_pad_added)

    # Preroll in PAUSED so pads link cleanly, then perform segment seek on uridecodebin!
    pipe.set_state(Gst.State.PAUSED)
    st_ret, _st, _pend = pipe.get_state(8 * Gst.SECOND)
    if st_ret == Gst.StateChangeReturn.FAILURE:
        pipe.set_state(Gst.State.NULL)
        raise RuntimeError("Could not decode source media file for clipping.")

    # Seek uridecodebin to [start_ns, stop_ns] so downstream encoders see running_time starting at 0
    dec.seek(
        1.0,
        Gst.Format.TIME,
        Gst.SeekFlags.FLUSH | Gst.SeekFlags.ACCURATE,
        Gst.SeekType.SET,
        start_ns,
        Gst.SeekType.SET,
        stop_ns,
    )
    pipe.get_state(5 * Gst.SECOND)
    pipe.set_state(Gst.State.PLAYING)

    bus = pipe.get_bus()
    err_msg = None
    deadline = time.monotonic() + 90.0
    while time.monotonic() < deadline:
        msg = bus.timed_pop_filtered(
            int(0.25 * Gst.SECOND),
            Gst.MessageType.EOS | Gst.MessageType.ERROR,
        )
        if msg is None:
            continue
        if msg.type == Gst.MessageType.EOS:
            break
        if msg.type == Gst.MessageType.ERROR:
            err, _dbg = msg.parse_error()
            err_msg = err.message
            break

    pipe.set_state(Gst.State.NULL)
    if err_msg:
        raise RuntimeError(err_msg)
    if not out_path.is_file() or out_path.stat().st_size < 64:
        raise RuntimeError("Extracted clip was empty (check playback position).")


# ---------------------------------------------------------------------------
# Main dtPlay Window
# ---------------------------------------------------------------------------
class DtPlayWindow(Gtk.Window):
    def __init__(self, initial_media: Path | None = None, clip_mode: bool = False, orig_stem: str = ""):
        title = "dtPlay Clip Studio — Trim & Save Snippet" if clip_mode else "dtPlay — CDE Media Player"
        super().__init__(title=title)
        self.set_wmclass("dtplay", "DtPlay")
        self.set_default_size(980, 640)
        self.set_position(Gtk.WindowPosition.CENTER)

        ic = DT_ICONS / "dtplay.l.pm"
        if ic.is_file():
            try:
                self.set_icon_from_file(str(ic))
            except Exception:
                pass

        MUSIC_DIR.mkdir(parents=True, exist_ok=True)
        self.chrome_hex, self.sel_hex, self.well_hex, self.well_alt_hex = load_cde_palette()

        # Clip Studio state (for the second dtPlay window spawned by Make a Clip)
        self.clip_mode = clip_mode
        self.orig_stem = orig_stem or "Clip"
        self.master_clip_backup: Path | None = initial_media if clip_mode else None

        # Browser & Playlist state
        self.current_dir: Path = (initial_media.parent if initial_media and initial_media.is_file() else MUSIC_DIR).resolve()
        self.folder_media: list[Path] = []
        self.current_media: Path | None = None
        self.is_video_media: bool = False
        self.is_playing: bool = False
        self.is_fullscreen: bool = False
        self.playback_rate: float = 1.0
        self._seeking_slider: bool = False
        self._clipping_busy: bool = False

        # Audio metadata & visualizer state
        self.tag_title: str = ""
        self.tag_artist: str = ""
        self.tag_album: str = ""
        self.cover_pixbuf: GdkPixbuf.Pixbuf | None = None
        self._viz_bars: list[float] = [0.15] * 20
        self._fs_hide_timer: int = 0

        # Build GStreamer Playbin + Native gtksink
        self.player = Gst.ElementFactory.make("playbin", "dtplay_playbin")
        self.gtksink = Gst.ElementFactory.make("gtksink", "dtplay_gtksink")
        self.video_widget: Gtk.Widget | None = None
        if self.player and self.gtksink:
            self.gtksink.set_property("force-aspect-ratio", True)
            self.player.set_property("video-sink", self.gtksink)
            self.video_widget = self.gtksink.props.widget

        if self.player:
            bus = self.player.get_bus()
            bus.add_signal_watch()
            bus.connect("message::eos", self._on_gst_eos)
            bus.connect("message::error", self._on_gst_error)
            bus.connect("message::tag", self._on_gst_tag)

        self._build_ui()
        self.populate_browser(self.current_dir)

        GLib.timeout_add(250, self._tick_timeline)
        GLib.timeout_add(90, self._tick_visualizer)

        if initial_media and initial_media.is_file():
            GLib.idle_add(self.play_file, initial_media.resolve())

    # ---------------- UI Construction ----------------
    def _build_ui(self):
        self.root_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(self.root_vbox)

        # 1. Top Menu Bar
        self.menubar = Gtk.MenuBar()

        m_media = Gtk.Menu()
        mi_media = Gtk.MenuItem(label="Media"); mi_media.set_submenu(m_media)
        for lbl, cb in [
            ("Open File...  (Ctrl+O)",       self.on_open_file_dialog),
            ("Browse Folder...  (Ctrl+D)",   self.on_open_folder_dialog),
            ("-", None),
            ("Make a 60s Clip  (Ctrl+K)",    self.on_make_clip),
            ("-", None),
            ("Quit  (Ctrl+Q)",               lambda *_: self.on_quit()),
