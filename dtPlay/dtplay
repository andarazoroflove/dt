        it_ab.connect("activate", self.on_about)
        m_help.append(it_ab)
        self.menubar.append(mi_help)
        self.root_vbox.pack_start(self.menubar, False, False, 0)

        # 2. Central Stack: Page "browser" (Greenbar ~/Music Browser) vs Page "player" (Video / Audio Stage)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.NONE)
        self.root_vbox.pack_start(self.stack, True, True, 0)

        # --- Page 1: Greenbar Folder Browser (dtMail Style) ---
        br_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

