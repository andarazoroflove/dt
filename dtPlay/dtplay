            it = Gtk.MenuItem(label=lbl); it.connect("activate", cb); m_video.append(it)
        self.menubar.append(mi_video)

        m_help = Gtk.Menu()
        mi_help = Gtk.MenuItem(label="Help"); mi_help.set_submenu(m_help)
