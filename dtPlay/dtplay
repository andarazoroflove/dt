    # ---------------- Greenbar Folder Browser ----------------
    def populate_browser(self, folder: Path):
        try:
            target = folder.expanduser().resolve()
            if not target.is_dir():
                target = HOME
        except Exception:
            target = HOME

        self.current_dir = target
        self.ent_path.set_text(str(target))
        self.br_store.clear()
        self.folder_media.clear()

        row_idx = 0
        # Always place '..' at the top so user can browse up to any folder!
        if target.parent != target:
            bg = self.well_hex
            self.br_store.append([
                "📁", "..", "Parent Folder", "", "", str(target.parent), True, bg, int(Pango.Weight.BOLD)
            ])
            row_idx += 1

        try:
            entries = list(target.iterdir())
        except PermissionError:
            self.lbl_status.set_text(f"Permission denied: {target}")
            return

        dirs = sorted([p for p in entries if p.is_dir() and not p.name.startswith(".")], key=lambda x: x.name.lower())
        files = sorted(
            [p for p in entries if p.is_file() and p.suffix.lower() in MEDIA_EXTS],
            key=lambda x: x.name.lower(),
        )
        self.folder_media = files

        for d in dirs:
            bg = self.well_alt_hex if (row_idx % 2 == 1) else self.well_hex
            try:
                mt = datetime.datetime.fromtimestamp(d.stat().st_mtime).strftime("%Y-%m-%d %H:%M")
            except OSError:
                mt = ""
            self.br_store.append([
                "📁", d.name, "Folder", "—", mt, str(d), True, bg, int(Pango.Weight.BOLD)
            ])
            row_idx += 1

        for f in files:
            bg = self.well_alt_hex if (row_idx % 2 == 1) else self.well_hex
            ext = f.suffix.lower()
            is_vid = ext in VIDEO_EXTS
            icon = "🎬" if is_vid else "🎵"
            kind = f"{ext.lstrip('.').upper()} {'Video' if is_vid else 'Audio'}"
            try:
                st = f.stat()
                sz = human_size(st.st_size)
                mt = datetime.datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d %H:%M")
            except OSError:
                sz, mt = "", ""
            self.br_store.append([
                icon, f.name, kind, sz, mt, str(f), False, bg, int(Pango.Weight.NORMAL)
            ])
            row_idx += 1

        self.lbl_status.set_text(f"{target} — {len(dirs)} folder(s), {len(files)} playable media file(s).")

    def _on_path_entry_activate(self, ent):
        p = Path(ent.get_text().strip()).expanduser()
        if p.is_dir():
            self.populate_browser(p)
        elif p.is_file() and p.suffix.lower() in MEDIA_EXTS:
            self.populate_browser(p.parent)
            self.play_file(p)

    def _on_browser_row_activated(self, _view, path, _col):
        row = self.br_store[path]
        full_p = Path(row[5])
        is_dir = row[6]
        if is_dir:
            self.populate_browser(full_p)
        else:
            self.play_file(full_p)

    def show_browser_view(self):
        if self.is_fullscreen:
            self.toggle_fullscreen()
        self.stack.set_visible_child_name("browser")
        if self.current_media is not None:
            self.btn_return_stage.show()

    # ---------------- Media Playback Engine ----------------
    def play_file(self, path: Path):
        if not self.player or not path.is_file():
            return
        rp = path.resolve()
        if rp.parent != self.current_dir:
            self.populate_browser(rp.parent)

        self.player.set_state(Gst.State.NULL)
        self.current_media = rp
        self.tag_title = rp.stem
        self.tag_artist = ""
        self.tag_album = ""
        self.cover_pixbuf = None

        self.is_video_media = rp.suffix.lower() in VIDEO_EXTS
        self.stage_stack.set_visible_child_name("video" if self.is_video_media else "audio")
        self.stack.set_visible_child_name("player")
        self.btn_return_stage.show()

        self.player.set_property("uri", rp.as_uri())
        self.player.set_state(Gst.State.PLAYING)
        self.is_playing = True
        self.btn_play.set_label("⏸ Pause")

        prefix = "Clip Studio: " if self.clip_mode else ""
        self.set_title(f"{prefix}{rp.name} — dtPlay")
        self.lbl_status.set_text(f"Playing: {rp.name}")

        # Inspect actual decoded video streams once playing starts (in case .mp4 is audio-only or .ogg has video)
        GLib.timeout_add(450, self._check_stream_tracks)

    def _check_stream_tracks(self) -> bool:
        if not self.player or not self.current_media:
            return False
        n_vid = self.player.get_property("n-video") or 0
        if n_vid > 0 and not self.is_video_media:
            self.is_video_media = True
            self.stage_stack.set_visible_child_name("video")
        elif n_vid == 0 and self.is_video_media and self.current_media.suffix.lower() in (".ogg", ".mp4", ".webm"):
            self.is_video_media = False
            self.stage_stack.set_visible_child_name("audio")

        if self.clip_mode:
            ok_d, dur_ns = self.player.query_duration(Gst.Format.TIME)
            if ok_d and dur_ns > 0:
                dur_s = round(dur_ns / float(Gst.SECOND), 1)
                self.sp_trim_in.set_range(0.0, max(0.1, dur_s - 0.2))
                self.sp_trim_out.set_range(0.2, max(0.2, dur_s))
                self.sp_trim_out.set_value(dur_s)
        return False

    def on_play_pause(self, *_args):
        if not self.player:
            return
        if self.current_media is None:
            model, it = self.br_view.get_selection().get_selected()
            if it is not None and not model[it][6]:
                self.play_file(Path(model[it][5]))
                return
            if self.folder_media:
                self.play_file(self.folder_media[0])
            return

        if self.is_playing:
            self.player.set_state(Gst.State.PAUSED)
            self.is_playing = False
            self.btn_play.set_label("▶ Play")
        else:
            self.player.set_state(Gst.State.PLAYING)
            self.is_playing = True
            self.btn_play.set_label("⏸ Pause")

    def on_stop(self, *_args):
        if self.player:
            self.player.set_state(Gst.State.NULL)
        self.is_playing = False
        self.btn_play.set_label("▶ Play")
        self.sl_seek.set_value(0.0)
        self.lbl_pos.set_text("00:00")

    def step_folder(self, delta: int):
        if not self.folder_media:
            return
        if self.current_media in self.folder_media:
            idx = (self.folder_media.index(self.current_media) + delta) % len(self.folder_media)
        else:
            idx = 0
        self.play_file(self.folder_media[idx])

    def seek_relative(self, delta_s: float):
        if not self.player or not self.current_media:
            return
        ok_p, pos_ns = self.player.query_position(Gst.Format.TIME)
        ok_d, dur_ns = self.player.query_duration(Gst.Format.TIME)
        if not ok_p:
            return
        target = max(0, pos_ns + int(delta_s * Gst.SECOND))
        if ok_d and dur_ns > 0:
            target = min(dur_ns, target)
        self._seek_ns(target)

    def _seek_ns(self, target_ns: int):
        if not self.player:
            return
        flags = Gst.SeekFlags.FLUSH | Gst.SeekFlags.KEY_UNIT
        if abs(self.playback_rate - 1.0) < 0.01:
            self.player.seek_simple(Gst.Format.TIME, flags, target_ns)
        else:
            self.player.seek(
                self.playback_rate, Gst.Format.TIME, flags,
                Gst.SeekType.SET, target_ns, Gst.SeekType.NONE, 0
            )

    def set_rate(self, rate: float):
        self.playback_rate = rate
        if self.player and self.current_media:
            ok_p, pos_ns = self.player.query_position(Gst.Format.TIME)
            if ok_p:
                self._seek_ns(pos_ns)
        self.lbl_status.set_text(f"Playback speed: {rate}×")

    def on_toggle_mute(self, *_args):
        if not self.player:
            return
        m = not self.player.get_property("mute")
        self.player.set_property("mute", m)
        self.btn_mute.set_label("🔇" if m else "🔊")

    def adjust_volume(self, delta: float):
        v = max(0.0, min(1.25, self.sl_vol.get_value() + delta))
        self.sl_vol.set_value(v)

    def _on_vol_changed(self, sl):
        if self.player:
            self.player.set_property("volume", sl.get_value())

    def _on_seek_press(self, *_args):
        self._seeking_slider = True
        return False

    def _on_seek_release(self, sl, _ev):
        self._seeking_slider = False
        if self.player and self.current_media:
            ok_d, dur_ns = self.player.query_duration(Gst.Format.TIME)
            if ok_d and dur_ns > 0:
                frac = sl.get_value() / 1000.0
                self._seek_ns(int(dur_ns * frac))
        return False

    def _tick_timeline(self) -> bool:
        if self.player and self.current_media and not self._seeking_slider:
            ok_p, pos_ns = self.player.query_position(Gst.Format.TIME)
            ok_d, dur_ns = self.player.query_duration(Gst.Format.TIME)
            if ok_p and pos_ns >= 0:
                ps = pos_ns / float(Gst.SECOND)
                self.lbl_pos.set_text(format_time(ps))
                if ok_d and dur_ns > 0:
                    ds = dur_ns / float(Gst.SECOND)
                    self.lbl_dur.set_text(format_time(ds))
                    self.sl_seek.set_value(min(1000.0, (ps / ds) * 1000.0))
        return True

    # ---------------- Retro CDE Audio Stage & Visualizer ----------------
    def _tick_visualizer(self) -> bool:
        if self.stack.get_visible_child_name() == "player" and not self.is_video_media:
            if self.is_playing:
                t = time.monotonic()
                for i in range(len(self._viz_bars)):
                    wave = 0.42 + 0.32 * math.sin(t * 5.2 + i * 0.55) + 0.22 * math.cos(t * 8.7 - i * 0.9)
                    jitter = random.uniform(-0.08, 0.12)
                    self._viz_bars[i] = max(0.08, min(0.98, 0.55 * self._viz_bars[i] + 0.45 * (wave + jitter)))
                self.audio_canvas.queue_draw()
            elif any(b > 0.10 for b in self._viz_bars):
                self._viz_bars = [max(0.08, b * 0.80) for b in self._viz_bars]
                self.audio_canvas.queue_draw()
        return True

    def _on_draw_audio_stage(self, widget, cr: cairo.Context):
        alloc = widget.get_allocation()
        w, h = alloc.width, alloc.height

        # Deep CDE midnight studio backdrop
        pat = cairo.LinearGradient(0, 0, 0, h)
        pat.add_color_stop_rgb(0.0, 0.08, 0.10, 0.15)
        pat.add_color_stop_rgb(1.0, 0.04, 0.05, 0.08)
        cr.set_source(pat)
        cr.paint()

        cx = w * 0.5
        top_y = max(24.0, h * 0.12)

        # Album Art or Retro Traffic-Cone / Note Badge
        art_sz = min(180, max(96, int(h * 0.34)))
        ax = cx - art_sz * 0.5
        cr.set_source_rgba(0, 0, 0, 0.55)
        cr.rectangle(ax + 4, top_y + 4, art_sz, art_sz); cr.fill()

        if self.cover_pixbuf is not None:
            scaled = self.cover_pixbuf.scale_simple(art_sz, art_sz, GdkPixbuf.InterpType.BILINEAR)
            Gdk.cairo_set_source_pixbuf(cr, scaled, ax, top_y)
            cr.paint()
        else:
            cr.set_source_rgb(0.16, 0.20, 0.28)
            cr.rectangle(ax, top_y, art_sz, art_sz); cr.fill()
            # Iconic VLC-inspired retro CDE cone/play emblem
            cr.set_source_rgb(0.92, 0.48, 0.14)
            cr.move_to(cx, top_y + art_sz * 0.18)
            cr.line_to(ax + art_sz * 0.76, top_y + art_sz * 0.80)
            cr.line_to(ax + art_sz * 0.24, top_y + art_sz * 0.80)
            cr.close_path(); cr.fill()
            cr.set_source_rgba(1, 1, 1, 0.90)
            cr.move_to(cx - art_sz * 0.10, top_y + art_sz * 0.44)
            cr.line_to(cx + art_sz * 0.10, top_y + art_sz * 0.44)
            cr.line_to(cx + art_sz * 0.15, top_y + art_sz * 0.56)
            cr.line_to(cx - art_sz * 0.15, top_y + art_sz * 0.56)
            cr.close_path(); cr.fill()

        cr.set_source_rgba(1, 1, 1, 0.35)
        cr.set_line_width(1.5)
        cr.rectangle(ax, top_y, art_sz, art_sz); cr.stroke()

        # Track Title & Artist
        layout = PangoCairo.create_layout(cr)
        layout.set_width(max(200, w - 80) * Pango.SCALE)
        layout.set_alignment(Pango.Alignment.CENTER)
        t_esc = GLib.markup_escape_text(self.tag_title or (self.current_media.name if self.current_media else "dtPlay"))
        sub_parts = [p for p in (self.tag_artist, self.tag_album) if p]
        s_esc = GLib.markup_escape_text("  •  ".join(sub_parts)) if sub_parts else ""
        mk = f"<span size='14000' weight='bold' foreground='#FFF7E9'>{t_esc}</span>"
        if s_esc:
            mk += f"\n<span size='10500' foreground='#9CB3C9'>{s_esc}</span>"
        layout.set_markup(mk, -1)
        cr.move_to(40, top_y + art_sz + 16)
        PangoCairo.show_layout(cr, layout)

        # 20-Band Segmented CDE Spectrum Analyzer
        n_bars = len(self._viz_bars)
        tot_w = min(460.0, w * 0.68)
        bar_w = (tot_w / n_bars) * 0.72
        gap = (tot_w / n_bars) * 0.28
        bx0 = cx - tot_w * 0.5
        by_base = h - 28.0
        max_bh = max(36.0, min(110.0, h * 0.22))

        for i, val in enumerate(self._viz_bars):
            bx = bx0 + i * (bar_w + gap)
            bh = val * max_bh
            segs = max(1, int(bh / 6.0))
            for s in range(segs):
                sy = by_base - (s + 1) * 6.0
                frac = s / max(1.0, max_bh / 6.0)
                if frac > 0.80:
                    cr.set_source_rgb(0.94, 0.36, 0.34)
                elif frac > 0.55:
                    cr.set_source_rgb(0.95, 0.78, 0.28)
                else:
                    cr.set_source_rgb(0.28, 0.78, 0.58)
                cr.rectangle(bx, sy, bar_w, 4.2)
                cr.fill()
        return False

    # ---------------- Borderless Full Screen ----------------
    def toggle_fullscreen(self):
        if self.is_fullscreen:
            self.is_fullscreen = False
            if self._fs_hide_timer:
                GLib.source_remove(self._fs_hide_timer)
                self._fs_hide_timer = 0
            self.unfullscreen()
            self.set_decorated(True)
            self.menubar.show()
            self.bottom_bar.show()
            if self.clip_mode:
                self.clip_bar.show()
            self.btn_fs.set_label("⛶ Full Screen")
        else:
            self.stack.set_visible_child_name("player")
            self.is_fullscreen = True
            self.menubar.hide()
            self.clip_bar.hide()
            self.bottom_bar.hide()
            self.set_decorated(False)
            self.fullscreen()
            self.btn_fs.set_label("⛶ Exit Full Screen")

    def _on_stage_click(self, _w, ev):
        if ev.type == Gdk.EventType._2BUTTON_PRESS and ev.button == 1:
            self.toggle_fullscreen()
            return True
        return False

    def _on_stage_motion(self, _w, ev):
        if not self.is_fullscreen:
            return False
        alloc = self.get_allocation()
        # Reveal bottom playback bar temporarily when cursor moves near bottom or moves in fullscreen
        if ev.y >= alloc.height - 110:
            self.bottom_bar.show()
            if self._fs_hide_timer:
                GLib.source_remove(self._fs_hide_timer)
            self._fs_hide_timer = GLib.timeout_add(2600, self._auto_hide_fs_bar)
        return False

    def _auto_hide_fs_bar(self) -> bool:
        self._fs_hide_timer = 0
        if self.is_fullscreen:
            self.bottom_bar.hide()
        return False

    # ---------------- 60-Second "Make a Clip" & Clip Studio ----------------
    def on_make_clip(self, *_args):
        if self._clipping_busy:
            self.lbl_status.set_text("Clip extraction already running...")
            return
        if self.current_media is None or not self.current_media.is_file():
            self.lbl_status.set_text("Play or select a song or movie first, then click Make a Clip!")
            return

        ok_p, pos_ns = self.player.query_position(Gst.Format.TIME) if self.player else (False, 0)
        ok_d, dur_ns = self.player.query_duration(Gst.Format.TIME) if self.player else (False, 0)
        start_s = (pos_ns / float(Gst.SECOND)) if (ok_p and pos_ns > 0) else 0.0

        if ok_d and dur_ns > 0:
            rem_s = max(0.5, (dur_ns / float(Gst.SECOND)) - start_s)
            clip_dur = min(60.0, rem_s)
        else:
            clip_dur = 60.0

        src_p = self.current_media
        is_vid = self.is_video_media
        out_ext = ".mp4" if is_vid else (src_p.suffix.lower() if src_p.suffix.lower() in (".wav", ".flac", ".m4a", ".ogg") else ".mp3")
        ts = int(time.time() * 1000)
        tmp_clip = Path(tempfile.gettempdir()) / f"dtplay_clip_{src_p.stem}_{ts}{out_ext}"

        self._clipping_busy = True
        self.btn_make_clip.set_sensitive(False)
        self.lbl_status.set_text(f"Making {clip_dur:.1f}s clip from {format_time(start_s)} — please wait...")

        def _worker():
            try:
                extract_media_clip_gst(src_p, tmp_clip, start_s, clip_dur, is_vid)
                GLib.idle_add(self._on_clip_ready, tmp_clip, src_p.stem, None)
            except Exception as exc:
                GLib.idle_add(self._on_clip_ready, tmp_clip, src_p.stem, str(exc))

        threading.Thread(target=_worker, daemon=True).start()

    def _on_clip_ready(self, tmp_clip: Path, stem: str, err: str | None):
        self._clipping_busy = False
        self.btn_make_clip.set_sensitive(True)
        if err:
            self.lbl_status.set_text(f"Clip failed: {err}")
            return

        # Pause main player so audio doesn't overlap with the new Clip Studio window!
        if self.is_playing and self.player:
            self.player.set_state(Gst.State.PAUSED)
            self.is_playing = False
            self.btn_play.set_label("▶ Play")

        self.lbl_status.set_text(f"Created 60s clip ({tmp_clip.name}) — opened in Clip Studio window!")
        subprocess.Popen([
            sys.executable,
            str(Path(__file__).resolve()),
            "--clip-window",
            "--orig-stem", stem,
            str(tmp_clip),
        ])

    def _on_set_trim_in(self, *_args):
        if self.player:
            ok, pos_ns = self.player.query_position(Gst.Format.TIME)
            if ok:
                self.sp_trim_in.set_value(round(pos_ns / float(Gst.SECOND), 1))

    def _on_set_trim_out(self, *_args):
        if self.player:
            ok, pos_ns = self.player.query_position(Gst.Format.TIME)
            if ok:
                self.sp_trim_out.set_value(max(self.sp_trim_in.get_value() + 0.2, round(pos_ns / float(Gst.SECOND), 1)))

    def on_trim_further(self, *_args):
        if self._clipping_busy or not self.current_media:
            return
        t_in = float(self.sp_trim_in.get_value())
        t_out = float(self.sp_trim_out.get_value())
        if t_out <= t_in + 0.15:
            self.lbl_status.set_text("Trim End must be greater than Trim Start.")
            return

        src_p = self.current_media
        dur = min(60.0, t_out - t_in)
        out_p = Path(tempfile.gettempdir()) / f"dtplay_trimmed_{int(time.time() * 1000)}{src_p.suffix}"
        is_vid = self.is_video_media

        self.on_stop()
        self._clipping_busy = True
        self.lbl_status.set_text(f"Trimming snippet to {t_in:.1f}s – {t_out:.1f}s ({dur:.1f}s)...")

        def _worker():
            try:
                extract_media_clip_gst(src_p, out_p, t_in, dur, is_vid)
                GLib.idle_add(self._on_subtrim_done, out_p, None)
            except Exception as exc:
                GLib.idle_add(self._on_subtrim_done, out_p, str(exc))

        threading.Thread(target=_worker, daemon=True).start()

    def _on_subtrim_done(self, out_p: Path, err: str | None):
        self._clipping_busy = False
        if err:
            self.lbl_status.set_text(f"Trim error: {err}")
            return
        self.sp_trim_in.set_value(0.0)
        self.play_file(out_p)
        self.lbl_status.set_text(f"Trimmed snippet ready ({out_p.name}) — click Save Clip As to keep!")

    def on_reset_clip(self, *_args):
        if self.master_clip_backup and self.master_clip_backup.is_file():
            self.sp_trim_in.set_value(0.0)
            self.play_file(self.master_clip_backup)
            self.lbl_status.set_text("Restored initial 60-second snippet.")

    def on_save_clip_as(self, *_args):
        if not self.current_media or not self.current_media.is_file():
            return
        dlg = Gtk.FileChooserDialog(title="Save Media Clip As — dtPlay", parent=self, action=Gtk.FileChooserAction.SAVE)
        dlg.set_do_overwrite_confirmation(True)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save Clip", Gtk.ResponseType.OK)
        default_dir = (HOME / "Videos") if (self.is_video_media and (HOME / "Videos").is_dir()) else MUSIC_DIR
        dlg.set_current_folder(str(default_dir))
        ext = self.current_media.suffix or (".mp4" if self.is_video_media else ".mp3")
        dlg.set_current_name(f"{self.orig_stem}_clip{ext}")

        if dlg.run() == Gtk.ResponseType.OK:
            dest = Path(dlg.get_filename())
            dlg.destroy()
            if not dest.suffix:
                dest = dest.with_suffix(ext)
            try:
                shutil.copy2(self.current_media, dest)
                self.lbl_status.set_text(f"Saved clip to {dest}")
            except Exception as exc:
                self.lbl_status.set_text(f"Could not save clip: {exc}")
        else:
            dlg.destroy()

    # ---------------- GStreamer Bus, Dialogs & Shortcuts ----------------
    def _on_gst_eos(self, _bus, _msg):
        if self.clip_mode:
            # Loop or reset to beginning cleanly in Clip Studio
            self._seek_ns(0)
            self.player.set_state(Gst.State.PAUSED)
            self.is_playing = False
            self.btn_play.set_label("▶ Play")
            return
        self.on_stop()
        self.lbl_status.set_text("Playback finished.")

    def _on_gst_error(self, _bus, msg):
        err, _dbg = msg.parse_error()
        self.on_stop()
        self.lbl_status.set_text(f"Playback error: {err.message}")

    def _on_gst_tag(self, _bus, msg):
        taglist = msg.parse_tag()
        ok_t, val_t = taglist.get_string(Gst.TAG_TITLE)
        if ok_t and val_t:
            self.tag_title = val_t
        ok_a, val_a = taglist.get_string(Gst.TAG_ARTIST)
        if ok_a and val_a:
            self.tag_artist = val_a
        ok_al, val_al = taglist.get_string(Gst.TAG_ALBUM)
        if ok_al and val_al:
            self.tag_album = val_al

        for img_tag in (Gst.TAG_IMAGE, Gst.TAG_PREVIEW_IMAGE):
            ok_s, sample = taglist.get_sample(img_tag)
            if ok_s and sample:
                buf = sample.get_buffer()
                if buf:
                    ok_m, mapinfo = buf.map(Gst.MapFlags.READ)
                    if ok_m:
                        try:
                            loader = GdkPixbuf.PixbufLoader()
                            loader.write(mapinfo.data)
                            loader.close()
                            pb = loader.get_pixbuf()
                            if pb:
                                self.cover_pixbuf = pb
                        except Exception:
                            pass
                        finally:
                            buf.unmap(mapinfo)
                        break

    def on_open_file_dialog(self, *_args):
        dlg = Gtk.FileChooserDialog(title="Open Media File — dtPlay", parent=self, action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Play", Gtk.ResponseType.OK)
        dlg.set_current_folder(str(self.current_dir))
        flt = Gtk.FileFilter()
        flt.set_name("Supported Music & Video Files")
        for ext in sorted(MEDIA_EXTS):
            flt.add_pattern(f"*{ext}")
            flt.add_pattern(f"*{ext.upper()}")
        dlg.add_filter(flt)
        fa = Gtk.FileFilter(); fa.set_name("All Files"); fa.add_pattern("*"); dlg.add_filter(fa)

        if dlg.run() == Gtk.ResponseType.OK:
            fn = dlg.get_filename()
            dlg.destroy()
            if fn:
                self.play_file(Path(fn))
        else:
            dlg.destroy()

    def on_open_folder_dialog(self, *_args):
        dlg = Gtk.FileChooserDialog(title="Browse Media Folder — dtPlay", parent=self, action=Gtk.FileChooserAction.SELECT_FOLDER)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Open Folder", Gtk.ResponseType.OK)
        dlg.set_current_folder(str(self.current_dir))
        if dlg.run() == Gtk.ResponseType.OK:
            fn = dlg.get_filename()
            dlg.destroy()
            if fn:
                self.populate_browser(Path(fn))
                self.show_browser_view()
        else:
            dlg.destroy()

    def _on_key_press(self, _w, ev):
        foc = self.get_focus()
        if isinstance(foc, Gtk.Entry) or isinstance(foc, Gtk.SpinButton):
            if ev.keyval == Gdk.KEY_Escape and self.is_fullscreen:
                self.toggle_fullscreen()
                return True
            return False

        ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
        kv = ev.keyval

        if kv == Gdk.KEY_Escape and self.is_fullscreen:
            self.toggle_fullscreen(); return True
        if kv in (Gdk.KEY_F11, Gdk.KEY_f, Gdk.KEY_F) and not ctrl:
            self.toggle_fullscreen(); return True
        if kv == Gdk.KEY_BackSpace:
            self.show_browser_view(); return True
        if kv == Gdk.KEY_space:
            self.on_play_pause(); return True
        if ctrl and kv in (Gdk.KEY_o, Gdk.KEY_O):
            self.on_open_file_dialog(); return True
        if ctrl and kv in (Gdk.KEY_d, Gdk.KEY_D):
            self.on_open_folder_dialog(); return True
        if ctrl and kv in (Gdk.KEY_k, Gdk.KEY_K):
            self.on_make_clip(); return True
        if ctrl and kv in (Gdk.KEY_q, Gdk.KEY_Q):
            self.on_quit(); return True
        if kv in (Gdk.KEY_m, Gdk.KEY_M):
            self.on_toggle_mute(); return True
        if kv == Gdk.KEY_Left and self.stack.get_visible_child_name() == "player":
            self.seek_relative(-10.0); return True
        if kv == Gdk.KEY_Right and self.stack.get_visible_child_name() == "player":
            self.seek_relative(10.0); return True
        if kv == Gdk.KEY_Up and self.stack.get_visible_child_name() == "player":
            self.adjust_volume(0.06); return True
        if kv == Gdk.KEY_Down and self.stack.get_visible_child_name() == "player":
            self.adjust_volume(-0.06); return True
        return False

    def on_about(self, *_args):
        md = Gtk.MessageDialog(
            transient_for=self, flags=0, message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK, text="dtPlay — CDE Media Player & 60s Clip Studio",
        )
        md.format_secondary_text(
            "Simple, fast Common Desktop Environment audio & movie player.\n\n"
            "• Formats: WAV, MP3, M4A, FLAC, OGG, OPUS, MP4, M4V, MOV, AVI, MPEG, MKV, WebM\n"
            "• Greenbar ~/Music folder browser with '..' navigation & instant playback\n"
            "• Borderless Full Screen mode (F11 / F) & 1-click 60-second 'Make a Clip' trimmer!"
        )
        md.run(); md.destroy()

    def on_quit(self):
        if self.player:
            self.player.set_state(Gst.State.NULL)
        self.destroy()
        Gtk.main_quit()
        return False


def main():
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--clip-window", action="store_true")
    parser.add_argument("--orig-stem", default="Clip")
    parser.add_argument("files", nargs="*")
    args, _unknown = parser.parse_known_args()

    chrome, sel, well, _well_alt = load_cde_palette()
    prov = Gtk.CssProvider()
    prov.load_from_data(build_cde_css(chrome, sel, well))
    scr = Gdk.Screen.get_default()
    if scr is not None:
        Gtk.StyleContext.add_provider_for_screen(scr, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    init_media = None
    for f in args.files:
        s = f.strip()
        if not s:
            continue
        if s.startswith("file://"):
            p = Path(urllib.parse.unquote(urllib.parse.urlparse(s).path))
        else:
            p = Path(s).expanduser()
        if p.is_file():
            init_media = p.resolve()
            break

    win = DtPlayWindow(init_media, clip_mode=args.clip_window, orig_stem=args.orig_stem)
    win.connect("destroy", Gtk.main_quit)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
