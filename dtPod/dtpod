def search_apple_podcasts(query: str, mode: str = "all") -> list[dict]:
    """
    Query Apple's public iTunes Search API (no auth needed).
    mode: 'all' (Shows & Artists), 'artist' (Artist/Creator priority), 'title' (Show Title).
    """
    q = query.strip()
    if not q:
        return []

    results_by_feed: dict[str, dict] = {}
    calls = []
    if mode == "artist":
        calls.append({"media": "podcast", "entity": "podcast", "attribute": "artistTerm", "term": q, "limit": "40"})
        calls.append({"media": "podcast", "entity": "podcast", "term": q, "limit": "25"})
    elif mode == "title":
        calls.append({"media": "podcast", "entity": "podcast", "attribute": "titleTerm", "term": q, "limit": "40"})
    else:
        calls.append({"media": "podcast", "entity": "podcast", "term": q, "limit": "45"})

    for params in calls:
        try:
            resp = requests.get("https://itunes.apple.com/search", params=params,
                                headers={"User-Agent": USER_AGENT}, timeout=12)
            resp.raise_for_status()
            data = resp.json()
            for item in data.get("results", []):
                feed = (item.get("feedUrl") or "").strip()
                cid = str(item.get("collectionId") or "")
                key = feed or cid
                if not key or key in results_by_feed:
                    continue
                results_by_feed[key] = {
                    "id": cid or hashlib.md5(feed.encode()).hexdigest()[:12],
                    "title": (item.get("collectionName") or item.get("trackName") or "Untitled Podcast").strip(),
                    "artist": (item.get("artistName") or "Unknown Artist").strip(),
                    "feedUrl": feed,
                    "artworkUrl": (item.get("artworkUrl600") or item.get("artworkUrl100") or "").strip(),
                    "genre": (item.get("primaryGenreName") or "Podcast").strip(),
                    "trackCount": int(item.get("trackCount") or 0),
                }
        except Exception as exc:
            if not results_by_feed:
                raise exc
    return list(results_by_feed.values())


def fetch_top_apple_podcasts() -> list[dict]:
    """Fetch Apple Top Podcasts chart via public RSS/Lookup API."""
    ids = []
    try:
        r = requests.get(
            "https://itunes.apple.com/us/rss/toppodcasts/limit=25/json",
            headers={"User-Agent": USER_AGENT},
            timeout=12,
        )
        r.raise_for_status()
        entries = r.json().get("feed", {}).get("entry", [])
        if isinstance(entries, dict):
            entries = [entries]
        for e in entries:
            cid = e.get("id", {}).get("attributes", {}).get("im:id")
            if cid:
                ids.append(str(cid))
    except Exception:
        pass

    if ids:
        try:
            r2 = requests.get(
                "https://itunes.apple.com/lookup",
                params={"id": ",".join(ids)},
                headers={"User-Agent": USER_AGENT},
                timeout=12,
            )
            r2.raise_for_status()
            shows = []
            for item in r2.json().get("results", []):
                feed = (item.get("feedUrl") or "").strip()
                if not feed:
                    continue
                shows.append({
                    "id": str(item.get("collectionId") or ""),
                    "title": (item.get("collectionName") or item.get("trackName") or "Podcast").strip(),
                    "artist": (item.get("artistName") or "").strip(),
                    "feedUrl": feed,
                    "artworkUrl": (item.get("artworkUrl600") or item.get("artworkUrl100") or "").strip(),
                    "genre": (item.get("primaryGenreName") or "Podcast").strip(),
                    "trackCount": int(item.get("trackCount") or 0),
                })
            if shows:
                return shows
        except Exception:
            pass

    return search_apple_podcasts("technology science history news", "all")


def _local_tag(tag: str) -> str:
    return tag.split("}", 1)[1].lower() if "}" in tag else tag.lower()


def parse_podcast_rss(xml_bytes: bytes, fallback_show: dict | None = None) -> tuple[dict, list[dict]]:
    """Parse an RSS/Atom podcast XML feed into (show_meta, episodes_list)."""
    # Strip leading BOM/whitespace
    text = xml_bytes.decode("utf-8", errors="replace").lstrip("\ufeff \t\r\n")
    root = ET.fromstring(text)

    channel = None
    if _local_tag(root.tag) == "rss":
        for ch in root:
            if _local_tag(ch.tag) == "channel":
                channel = ch
                break
    elif _local_tag(root.tag) in ("feed", "channel"):
        channel = root

    if channel is None:
        raise RuntimeError("Invalid podcast RSS feed (missing <channel>).")

    show = dict(fallback_show or {})
    ch_title = ""
    ch_author = ""
    ch_desc = ""
    ch_art = ""

    items = []
    for elem in channel:
        lt = _local_tag(elem.tag)
        if lt == "title" and not ch_title and elem.text:
            ch_title = elem.text.strip()
        elif lt == "author" and elem.text:
            ch_author = elem.text.strip()
        elif lt in ("description", "summary", "subtitle") and elem.text and len(elem.text.strip()) > len(ch_desc):
            ch_desc = strip_html(elem.text)
        elif lt == "image":
            href = elem.attrib.get("href", "").strip()
            if href:
                ch_art = href
            else:
                for sub in elem:
                    if _local_tag(sub.tag) == "url" and sub.text:
                        ch_art = sub.text.strip()
        elif lt in ("item", "entry"):
            items.append(elem)

    if ch_title and not show.get("title"):
        show["title"] = ch_title
    if ch_author and not show.get("artist"):
        show["artist"] = ch_author
    if ch_desc:
        show["description"] = ch_desc
    if ch_art and not show.get("artworkUrl"):
        show["artworkUrl"] = ch_art

    episodes = []
    for idx, it in enumerate(items):
        ep_title = ""
        ep_guid = ""
        ep_pub = ""
        ep_dur = ""
        ep_url = ""
        ep_mime = ""
        ep_len = 0
        ep_art = ""
        ep_desc_candidates = []

        for sub in it:
            st = _local_tag(sub.tag)
            if st == "title" and sub.text:
                ep_title = sub.text.strip()
            elif st in ("guid", "id") and sub.text:
                ep_guid = sub.text.strip()
            elif st in ("pubdate", "published", "updated") and sub.text and not ep_pub:
                ep_pub = sub.text.strip()
            elif st == "duration" and sub.text:
                ep_dur = format_duration(sub.text)
            elif st == "enclosure":
                u = (sub.attrib.get("url") or "").strip()
                if u:
                    ep_url = u
                    ep_mime = (sub.attrib.get("type") or "").strip()
                    try:
                        ep_len = int(sub.attrib.get("length") or 0)
                    except ValueError:
                        ep_len = 0
            elif st == "link" and not ep_url:
                rel = sub.attrib.get("rel", "")
                href = sub.attrib.get("href", "")
                if rel == "enclosure" and href:
                    ep_url = href.strip()
            elif st in ("image", "thumbnail"):
                href = (sub.attrib.get("href") or sub.attrib.get("url") or "").strip()
                if href:
                    ep_art = href
            elif st in ("encoded", "description", "summary", "content", "subtitle") and sub.text:
                ep_desc_candidates.append(sub.text)

        if not ep_url:
            continue

        best_raw_desc = max(ep_desc_candidates, key=len) if ep_desc_candidates else ""
        date_str, ts = parse_pubdate(ep_pub)
        episodes.append({
            "guid": ep_guid or ep_url or f"ep-{idx}",
            "title": html.unescape(ep_title) or f"Episode {idx + 1}",
            "date": date_str,
            "timestamp": ts,
            "duration": ep_dur,
            "audioUrl": ep_url,
            "mimeType": ep_mime,
            "sizeBytes": ep_len,
            "sizeHuman": format_bytes(ep_len),
            "artworkUrl": ep_art or show.get("artworkUrl") or "",
            "description": strip_html(best_raw_desc),
            "showTitle": show.get("title") or "Podcast",
            "showArtist": show.get("artist") or "",
            "_feed_order": idx,
        })

    # Always sort episodes newest-to-oldest (descending by publication date/timestamp)
    episodes.sort(
        key=lambda e: (1 if e["timestamp"] > 0 else 0, e["timestamp"], e["date"], -e["_feed_order"]),
        reverse=True,
    )
    return show, episodes


