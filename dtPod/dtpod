        else:
            self.left_nb.set_current_page(1)
            GLib.idle_add(self.on_load_top_shows)

    # ---------------- Persistence ----------------
    def _load_state(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        if SUBS_FILE.is_file():
            try:
                data = json.loads(SUBS_FILE.read_text(encoding="utf-8"))
                self.subscriptions = data.get("subscriptions", [])
                self.played_guids = set(data.get("played_guids", []))
                self.saved_files = dict(data.get("saved_files", {}))
                if data.get("last_save_dir"):
                    self.last_save_dir = data["last_save_dir"]
            except Exception:
                pass

    def _save_state(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        data = {
            "subscriptions": self.subscriptions,
            "played_guids": sorted(list(self.played_guids))[-2000:],
            "saved_files": self.saved_files,
            "last_save_dir": self.last_save_dir,
        }
        tmp = SUBS_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(data, indent=2), encoding="utf-8")
        tmp.replace(SUBS_FILE)

    def is_subscribed(self, show: dict | None) -> bool:
        if not show:
            return False
        feed = (show.get("feedUrl") or "").strip().lower()
        sid = str(show.get("id") or "")
        for s in self.subscriptions:
            if feed and (s.get("feedUrl") or "").strip().lower() == feed:
                return True
            if sid and str(s.get("id") or "") == sid:
                return True
        return False

