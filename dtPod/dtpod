def strip_html(raw: str) -> str:
    if not raw:
        return ""
    s = re.sub(r"(?i)<\s*br\s*/?\s*>", "\n", raw)
    s = re.sub(r"(?i)</\s*(p|div|li|h[1-6])\s*>", "\n\n", s)
    s = re.sub(r"(?i)<\s*li[^>]*>", "  • ", s)
    s = re.sub(r"<[^>]+>", "", s)
    s = html.unescape(s)
    s = re.sub(r"[ \t]+\n", "\n", s)
    s = re.sub(r"\n{3,}", "\n\n", s)
    return s.strip()


def format_duration(val) -> str:
    if not val:
        return ""
    s = str(val).strip()
    if ":" in s:
        parts = s.split(":")
        if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit():
            return f"{int(parts[0]):02d}:{int(parts[1]):02d}"
        if len(parts) == 3 and all(p.isdigit() for p in parts):
            h, m, sec = int(parts[0]), int(parts[1]), int(parts[2])
            return f"{h}:{m:02d}:{sec:02d}" if h > 0 else f"{m:02d}:{sec:02d}"
        return s
    try:
        tot = int(float(s))
        if tot <= 0:
            return ""
        h, rem = divmod(tot, 3600)
        m, sec = divmod(rem, 60)
        return f"{h}:{m:02d}:{sec:02d}" if h > 0 else f"{m:02d}:{sec:02d}"
    except Exception:
        return s


def format_seconds(sec: float) -> str:
    if sec < 0 or not sec:
        sec = 0.0
    tot = int(round(sec))
    h, rem = divmod(tot, 3600)
    m, s = divmod(rem, 60)
    return f"{h}:{m:02d}:{s:02d}" if h > 0 else f"{m:02d}:{s:02d}"


def format_bytes(num: int) -> str:
    if not num or num <= 0:
        return ""
    f = float(num)
    for u in ("B", "KB", "MB", "GB"):
        if f < 1024.0 or u == "GB":
            return f"{f:.1f} {u}" if u != "B" else f"{int(f)} B"
        f /= 1024.0
    return ""


def parse_pubdate(raw: str) -> tuple[str, float]:
    if not raw:
        return "", 0.0
    s = raw.strip()
    try:
        dt = email.utils.parsedate_to_datetime(s)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=datetime.timezone.utc)
        return dt.strftime("%Y-%m-%d"), dt.timestamp()
    except Exception:
        pass
    try:
        iso = s.replace("Z", "+00:00")
        dt = datetime.datetime.fromisoformat(iso)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=datetime.timezone.utc)
        return dt.strftime("%Y-%m-%d"), dt.timestamp()
    except Exception:
        pass
    m = re.search(r"(\d{4})-(\d{2})-(\d{2})", s)
    if m:
        try:
            dt = datetime.datetime(int(m.group(1)), int(m.group(2)), int(m.group(3)), tzinfo=datetime.timezone.utc)
            return m.group(0), dt.timestamp()
        except Exception:
            return m.group(0), 0.0
    return s[:16], 0.0


def sanitize_filename(name: str) -> str:
    cleaned = re.sub(r'[\\/*?:"<>|\r\n\t]+', "_", name).strip(" ._")
    return cleaned[:140] or "podcast_episode"


def make_placeholder_pixbuf(size: int, label_char: str = "🎙") -> GdkPixbuf.Pixbuf:
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    cr = cairo.Context(surf)
    # Vintage CDE purple-indigo podcast tile
    pat = cairo.LinearGradient(0, 0, size, size)
    pat.add_color_stop_rgb(0.0, 0.36, 0.24, 0.56)
    pat.add_color_stop_rgb(1.0, 0.19, 0.12, 0.34)
    cr.set_source(pat)
    cr.rectangle(0, 0, size, size)
    cr.fill()

    # Radio waves + mic glyph in Cairo vector art
    cx, cy = size * 0.5, size * 0.46
    cr.set_source_rgba(1.0, 0.96, 0.90, 0.35)
    cr.set_line_width(max(1.2, size * 0.045))
    for r_f in (0.28, 0.39):
        cr.arc(cx, cy, size * r_f, -0.75, 0.75)
        cr.stroke()
        cr.arc(cx, cy, size * r_f, math.pi - 0.75, math.pi + 0.75)
        cr.stroke()

    cr.set_source_rgb(0.98, 0.95, 0.88)
    mw, mh = size * 0.18, size * 0.28
    cr.arc(cx, cy - mh * 0.2, mw * 0.5, 0, 2 * 3.14159)
    cr.fill()
    cr.rectangle(cx - mw * 0.5, cy - mh * 0.2, mw, mh * 0.65)
    cr.fill()
    cr.set_line_width(max(1.5, size * 0.055))
    cr.arc(cx, cy + mh * 0.15, mw * 0.85, 0.15, 3.14159 - 0.15)
    cr.stroke()
    cr.move_to(cx, cy + mh * 0.15 + mw * 0.85)
    cr.line_to(cx, size * 0.84)
    cr.stroke()
    cr.move_to(cx - mw * 0.65, size * 0.84)
    cr.line_to(cx + mw * 0.65, size * 0.84)
    cr.stroke()

    # Beveled border
    cr.set_line_width(1.0)
    cr.set_source_rgba(1, 1, 1, 0.4)
    cr.move_to(0.5, size - 0.5); cr.line_to(0.5, 0.5); cr.line_to(size - 0.5, 0.5); cr.stroke()
    cr.set_source_rgba(0, 0, 0, 0.5)
    cr.move_to(size - 0.5, 0.5); cr.line_to(size - 0.5, size - 0.5); cr.line_to(0.5, size - 0.5); cr.stroke()
    surf.flush()
    return Gdk.pixbuf_get_from_surface(surf, 0, 0, size, size)


import math


class ArtworkCache:
    """Thread-safe disk & memory artwork loader with automatic scaling."""
    def __init__(self):
        CACHE_ART_DIR.mkdir(parents=True, exist_ok=True)
        self._mem: dict[tuple[str, int], GdkPixbuf.Pixbuf] = {}
        self._inflight: set[str] = set()
        self._lock = threading.Lock()

    def get_cached(self, url: str, size: int) -> GdkPixbuf.Pixbuf | None:
        if not url:
            return None
        key = (url, size)
        with self._lock:
            if key in self._mem:
                return self._mem[key]
        h = hashlib.sha1(url.encode("utf-8")).hexdigest()
        disk_p = CACHE_ART_DIR / f"{h}.png"
        if disk_p.is_file():
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(disk_p), size, size, True)
                with self._lock:
                    self._mem[key] = pb
                return pb
            except Exception:
                pass
        return None

    def fetch_async(self, url: str, size: int, callback):
        if not url:
            return
        cached = self.get_cached(url, size)
        if cached is not None:
            GLib.idle_add(callback, url, cached)
            return

        with self._lock:
            already = url in self._inflight
            self._inflight.add(url)

        def _worker():
            try:
                h = hashlib.sha1(url.encode("utf-8")).hexdigest()
                disk_p = CACHE_ART_DIR / f"{h}.png"
                if not disk_p.is_file():
                    r = requests.get(url, headers={"User-Agent": USER_AGENT}, timeout=12)
                    r.raise_for_status()
                    with Image.open(io.BytesIO(r.content)) as im:
                        im.thumbnail((400, 400), Image.Resampling.LANCZOS)
                        im.convert("RGBA").save(disk_p, format="PNG")
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(disk_p), size, size, True)
                with self._lock:
                    self._mem[(url, size)] = pb
                GLib.idle_add(callback, url, pb)
            except Exception:
                pass
            finally:
                with self._lock:
                    self._inflight.discard(url)

        if not already:
            threading.Thread(target=_worker, daemon=True).start()
        else:
            # Wait briefly for inflight download then resolve from disk
            def _waiter():
                for _ in range(30):
                    time.sleep(0.25)
                    pb = self.get_cached(url, size)
                    if pb is not None:
                        GLib.idle_add(callback, url, pb)
                        return
            threading.Thread(target=_waiter, daemon=True).start()


