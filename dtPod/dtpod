    def play_episode(self, ep: dict, prefer_local: bool = True):
        if not self.player:
            self.set_status("GStreamer playbin unavailable.")
            return
        self.player.set_state(Gst.State.NULL)

        local_p = self.saved_files.get(ep["guid"])
        if prefer_local and local_p and Path(local_p).is_file():
            uri = Path(local_p).resolve().as_uri()
            src_note = f"local file ({Path(local_p).name})"
        else:
            uri = ep["audioUrl"]
            src_note = "Apple Podcast stream"

        self.playing_episode = ep
        self.played_guids.add(ep["guid"])
        self._save_state()
        self._populate_episodes_store()

        self.lbl_np_title.set_markup(f"<b>{GLib.markup_escape_text(ep['title'])}</b>")
        self.lbl_np_show.set_text(ep.get("showTitle") or "")

        art_url = ep.get("artworkUrl") or (self.current_show.get("artworkUrl") if self.current_show else "")
        pb = self.art_cache.get_cached(art_url, 48)
        self.img_np_art.set_from_pixbuf(pb or self.placeholder_48)
        if art_url and not pb:
            self.art_cache.fetch_async(art_url, 48, lambda _u, p: self.img_np_art.set_from_pixbuf(p))

        self.player.set_property("uri", uri)
        self.player.set_state(Gst.State.PLAYING)
        self.is_playing = True
        self.btn_play_pause.set_label("⏸ Pause")
        self.set_status(f"Playing '{ep['title']}' via {src_note}...")

    def save_selected_episode_as(self):
        ep = self._get_selected_episode()
        if ep:
            self.save_episode_as(ep)

    def save_episode_as(self, ep: dict):
        if self._dl_active:
            self.set_status("A podcast download is already in progress.")
            return

        # Guess extension from enclosure URL or MIME type
        parsed_u = urllib.parse.urlparse(ep["audioUrl"])
        ext = Path(parsed_u.path).suffix.lower()
        if ext not in (".mp3", ".m4a", ".aac", ".ogg", ".opus", ".wav", ".flac", ".mp4"):
            mt = (ep.get("mimeType") or "").lower()
            if "mp4" in mt or "m4a" in mt:
                ext = ".m4a"
            elif "ogg" in mt:
                ext = ".ogg"
            else:
                ext = ".mp3"

        show_part = sanitize_filename(ep.get("showTitle") or "Podcast")[:50]
        ep_part = sanitize_filename(ep.get("title") or "Episode")[:85]
        default_name = f"{show_part} - {ep_part}{ext}"

        dlg = Gtk.FileChooserDialog(
            title="Save Podcast Episode As — dtPod",
            parent=self,
            action=Gtk.FileChooserAction.SAVE,
        )
        dlg.set_do_overwrite_confirmation(True)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save Episode", Gtk.ResponseType.OK)
        if Path(self.last_save_dir).is_dir():
            dlg.set_current_folder(self.last_save_dir)
        dlg.set_current_name(default_name)

        if dlg.run() != Gtk.ResponseType.OK:
            dlg.destroy()
            return
        dest_path = Path(dlg.get_filename())
        dlg.destroy()

        self.last_save_dir = str(dest_path.parent)
        self._save_state()

        self._dl_active = True
        self._dl_cancel.clear()
        self.dl_prog.set_fraction(0.0)
        self.dl_prog.set_text("Starting...")
        self.dl_prog.show()
        self.btn_cancel_dl.show()
        self.set_status(f"Downloading '{ep['title']}' -> {dest_path.name}...")

        def _dl_worker():
            part_path = dest_path.with_suffix(dest_path.suffix + ".part")
            try:
                with requests.get(ep["audioUrl"], headers={"User-Agent": USER_AGENT}, stream=True, timeout=25) as r:
                    r.raise_for_status()
                    total = int(r.headers.get("Content-Length") or ep.get("sizeBytes") or 0)
                    done = 0
                    last_ui = 0.0
                    with open(part_path, "wb") as fh:
                        for chunk in r.iter_content(chunk_size=65536):
                            if self._dl_cancel.is_set():
                                raise InterruptedError("Download cancelled by user.")
                            if not chunk:
                                continue
                            fh.write(chunk)
                            done += len(chunk)
                            now = time.monotonic()
                            if now - last_ui >= 0.12:
                                last_ui = now
                                frac = min(1.0, done / float(total)) if total > 0 else 0.0
                                txt = f"{int(frac * 100)}% ({format_bytes(done)})" if total > 0 else format_bytes(done)
                                GLib.idle_add(self._on_dl_progress, frac, txt)
                part_path.replace(dest_path)
                GLib.idle_add(self._on_dl_finished, ep, dest_path, None)
            except Exception as exc:
                part_path.unlink(missing_ok=True)
                GLib.idle_add(self._on_dl_finished, ep, dest_path, str(exc))

        threading.Thread(target=_dl_worker, daemon=True).start()

    def _on_dl_progress(self, frac: float, txt: str):
        if frac > 0:
            self.dl_prog.set_fraction(frac)
        else:
            self.dl_prog.pulse()
        self.dl_prog.set_text(txt)

    def _on_dl_finished(self, ep: dict, dest_path: Path, err: str | None):
        self._dl_active = False
        self.dl_prog.hide()
        self.btn_cancel_dl.hide()
        if err:
            self.set_status(f"Download stopped: {err}")
        else:
            self.saved_files[ep["guid"]] = str(dest_path)
            self._save_state()
            self._populate_episodes_store()
            self.set_status(f"Saved episode to {dest_path}")

    def toggle_selected_played(self):
        ep = self._get_selected_episode()
        if not ep:
            return
        g = ep["guid"]
        if g in self.played_guids:
            self.played_guids.discard(g)
        else:
            self.played_guids.add(g)
        self._save_state()
        self._populate_episodes_store()

    def copy_selected_url(self):
        ep = self._get_selected_episode()
        if not ep:
            return
        cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        cb.set_text(ep["audioUrl"], -1)
        cb.store()
        self.set_status("Copied episode audio URL to clipboard.")

    # ---------------- Player Controls & GStreamer Bus ----------------
    def on_play_pause_clicked(self, *_args):
        if not self.player:
            return
        if self.playing_episode is None:
            self.play_selected_episode()
            return
        if self.is_playing:
            self.player.set_state(Gst.State.PAUSED)
            self.is_playing = False
            self.btn_play_pause.set_label("▶ Play")
        else:
            self.player.set_state(Gst.State.PLAYING)
            self.is_playing = True
            self.btn_play_pause.set_label("⏸ Pause")
            if abs(self.playback_rate - 1.0) > 0.01:
                GLib.timeout_add(250, lambda: self._apply_playback_rate() or False)

    def on_stop_clicked(self, *_args):
        if self.player:
            self.player.set_state(Gst.State.NULL)
        self.is_playing = False
        self.btn_play_pause.set_label("▶ Play")
        self.sl_seek.set_value(0.0)
        self.lbl_pos.set_text("00:00")

    def seek_relative(self, delta_sec: float):
        if not self.player or not self.playing_episode:
            return
        ok_p, pos_ns = self.player.query_position(Gst.Format.TIME)
        ok_d, dur_ns = self.player.query_duration(Gst.Format.TIME)
        if not ok_p:
            return
        target_ns = max(0, pos_ns + int(delta_sec * Gst.SECOND))
        if ok_d and dur_ns > 0:
            target_ns = min(dur_ns, target_ns)
        self._seek_to_ns(target_ns)

    def _seek_to_ns(self, target_ns: int):
        if not self.player:
            return
        flags = Gst.SeekFlags.FLUSH | Gst.SeekFlags.KEY_UNIT
        if abs(self.playback_rate - 1.0) < 0.01:
            self.player.seek_simple(Gst.Format.TIME, flags, target_ns)
        else:
            self.player.seek(
                self.playback_rate,
                Gst.Format.TIME,
                flags,
                Gst.SeekType.SET,
                target_ns,
                Gst.SeekType.NONE,
                0,
            )

    def _apply_playback_rate(self):
        if not self.player or not self.playing_episode:
            return
        ok_p, pos_ns = self.player.query_position(Gst.Format.TIME)
        if ok_p:
            self._seek_to_ns(pos_ns)

    def _on_speed_changed(self, cmb):
        try:
            self.playback_rate = float(cmb.get_active_id() or "1.0")
        except ValueError:
            self.playback_rate = 1.0
        self._apply_playback_rate()

    def _on_seek_press(self, *_args):
        self._seeking_slider = True
        return False

    def _on_seek_release(self, scale, _ev):
        self._seeking_slider = False
        if self.player and self.playing_episode:
            ok_d, dur_ns = self.player.query_duration(Gst.Format.TIME)
            if ok_d and dur_ns > 0:
                frac = scale.get_value() / 100.0
                self._seek_to_ns(int(dur_ns * frac))
        return False

    def _tick_timeline(self) -> bool:
        if self.player and self.playing_episode and not self._seeking_slider:
            ok_p, pos_ns = self.player.query_position(Gst.Format.TIME)
            ok_d, dur_ns = self.player.query_duration(Gst.Format.TIME)
            if ok_p and pos_ns >= 0:
                pos_s = pos_ns / float(Gst.SECOND)
                self.lbl_pos.set_text(format_seconds(pos_s))
                if ok_d and dur_ns > 0:
                    dur_s = dur_ns / float(Gst.SECOND)
                    self.lbl_dur.set_text(format_seconds(dur_s))
                    self.sl_seek.set_value(min(100.0, (pos_s / dur_s) * 100.0))
        return True

    def _on_gst_eos(self, _bus, _msg):
        self.on_stop_clicked()
        self.set_status("Finished playing episode.")

    def _on_gst_error(self, _bus, msg):
        err, _dbg = msg.parse_error()
        self.on_stop_clicked()
        self.set_status(f"Playback error: {err.message}")

    def _on_gst_state(self, _bus, msg):
        if msg.src == self.player:
            _old, new_st, _pend = msg.parse_state_changed()
            if new_st == Gst.State.PLAYING and abs(self.playback_rate - 1.0) > 0.01:
                # Ensure chosen rate stays active
                pass

    # ---------------- Shortcuts, About & Quit ----------------
    def _on_key_press(self, _w, ev):
        ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
        if ctrl and ev.keyval in (Gdk.KEY_q, Gdk.KEY_Q):
            self.on_quit()
            return True
        if ctrl and ev.keyval in (Gdk.KEY_f, Gdk.KEY_F):
            self.ent_search.grab_focus()
            return True
        if ev.keyval == Gdk.KEY_F5:
            self.on_refresh_current(force=True)
            return True
        foc = self.get_focus()
        if not isinstance(foc, Gtk.Entry) and ev.keyval == Gdk.KEY_space:
            self.on_play_pause_clicked()
            return True
        return False

    def on_about(self, *_args):
        md = Gtk.MessageDialog(
            transient_for=self,
            flags=0,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text="dtPod — CDE Apple Podcast Browser & Player",
        )
        md.format_secondary_text(
            "Native Common Desktop Environment podcast directory, subscriber & audio player.\n\n"
            "• Powered by the public Apple Podcasts API & RSS feeds (no login required)\n"
            "• Search by show title, artist/creator, or browse Apple Top Charts\n"
            "• Subscribe to favorite shows, view high-res cover art & show notes\n"
            "• Right-click any episode -> 'Save Episode As...' to download for offline listening"
        )
        md.run()
        md.destroy()

    def on_quit(self):
        if self.player:
            self.player.set_state(Gst.State.NULL)
        self._dl_cancel.set()
        self._save_state()
        self.destroy()
        Gtk.main_quit()
        return False


def main():
    chrome, sel, well, well_alt = load_cde_palette()
    prov = Gtk.CssProvider()
    prov.load_from_data(build_cde_css(chrome, sel, well, well_alt))
    scr = Gdk.Screen.get_default()
    if scr is not None:
        Gtk.StyleContext.add_provider_for_screen(scr, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    win = DtPodWindow()
    win.connect("destroy", Gtk.main_quit)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
