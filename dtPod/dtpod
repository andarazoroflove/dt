    # ---------------- Show Loading & RSS Fetching ----------------
    def load_show(self, show: dict, force_refresh: bool = False):
        feed_url = (show.get("feedUrl") or "").strip()
        if not feed_url:
            self.set_status("This podcast entry does not expose a public RSS feed URL.")
            return

        self.current_show = dict(show)
        self._update_header_ui(self.current_show, None)

        if not force_refresh and feed_url in self.feed_cache:
            merged_show, eps = self.feed_cache[feed_url]
            self.current_show.update(merged_show)
            self.current_episodes = eps
            self._update_header_ui(self.current_show, None)
            self._populate_episodes_store()
            self.set_status(f"Loaded {len(eps)} episodes for '{self.current_show.get('title')}'.")
            return

        self.ep_store.clear()
        self.set_status(f"Fetching episodes from RSS feed for '{show.get('title')}'...")

        def _worker():
            try:
                r = requests.get(feed_url, headers={"User-Agent": USER_AGENT}, timeout=18)
                r.raise_for_status()
                merged_show, eps = parse_podcast_rss(r.content, show)
                GLib.idle_add(self._on_feed_loaded, feed_url, merged_show, eps, None)
            except Exception as exc:
                GLib.idle_add(self._on_feed_loaded, feed_url, show, [], str(exc))

        threading.Thread(target=_worker, daemon=True).start()

    def _on_feed_loaded(self, feed_url: str, merged_show: dict, eps: list[dict], err: str | None):
        if err:
            self.set_status(f"Failed to load podcast feed: {err}")
            return
        self.feed_cache[feed_url] = (merged_show, eps)
        # Update subscription metadata if subscribed
        for s in self.subscriptions:
            if (s.get("feedUrl") or "").strip() == feed_url:
                for k in ("title", "artist", "artworkUrl", "description"):
                    if merged_show.get(k) and not s.get(k):
                        s[k] = merged_show[k]
                self._save_state()
                self._refresh_subs_list()
                break

        if self.current_show and (self.current_show.get("feedUrl") or "").strip() == feed_url:
            self.current_show.update(merged_show)
            self.current_episodes = eps
            self._update_header_ui(self.current_show, None)
            self._populate_episodes_store()
            self.set_status(f"Loaded {len(eps)} episodes for '{self.current_show.get('title')}'. Right-click any episode to Save As.")

    def _update_header_ui(self, show: dict, art_override_url: str | None):
        t = GLib.markup_escape_text(show.get("title") or "Untitled Podcast")
        a = GLib.markup_escape_text(show.get("artist") or "")
        g = GLib.markup_escape_text(show.get("genre") or "")
        self.lbl_show_title.set_markup(f"<span size='13500' weight='bold'>{t}</span>")
        subline = f"<b>{a}</b>" + (f"   •   <span>{g}</span>" if g else "")
        self.lbl_show_artist.set_markup(subline)
        self.lbl_show_desc.set_text(show.get("description") or "")

        self.btn_subscribe.set_sensitive(True)
        self.btn_refresh.set_sensitive(True)
        ctx = self.btn_subscribe.get_style_context()
        if self.is_subscribed(show):
            self.btn_subscribe.set_label("✔ Subscribed (Unsubscribe)")
            ctx.add_class("cde-sub-active")
        else:
            self.btn_subscribe.set_label("★ Subscribe")
            ctx.remove_class("cde-sub-active")

        art_url = art_override_url or show.get("artworkUrl") or ""
        self._active_header_art_url = art_url
        pb = self.art_cache.get_cached(art_url, 136)
        if pb:
            self.img_header_art.set_from_pixbuf(pb)
        else:
            self.img_header_art.set_from_pixbuf(self.placeholder_136)
            if art_url:
                self.art_cache.fetch_async(art_url, 136, self._on_header_art_ready)

