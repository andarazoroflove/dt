    def on_toggle_subscribe(self, *_args):
        if self.current_show:
            self._toggle_sub_for(self.current_show)

    def _toggle_sub_for(self, show: dict):
        if self.is_subscribed(show):
            self._unsubscribe_show(show)
        else:
            entry = {
                "id": show.get("id") or hashlib.md5((show.get("feedUrl") or "").encode()).hexdigest()[:12],
                "title": show.get("title") or "Podcast",
                "artist": show.get("artist") or "",
                "feedUrl": show.get("feedUrl") or "",
                "artworkUrl": show.get("artworkUrl") or "",
                "genre": show.get("genre") or "Podcast",
                "description": show.get("description") or "",
            }
            self.subscriptions.insert(0, entry)
            self._save_state()
            self._refresh_subs_list()
            if self.current_show and self.current_show.get("feedUrl") == entry["feedUrl"]:
                self._update_header_ui(self.current_show, None)
            self.set_status(f"Subscribed to '{entry['title']}'!")

    def _unsubscribe_show(self, show: dict):
        feed = (show.get("feedUrl") or "").strip().lower()
        sid = str(show.get("id") or "")
        self.subscriptions = [
            s for s in self.subscriptions
            if not ((feed and (s.get("feedUrl") or "").strip().lower() == feed) or (sid and str(s.get("id") or "") == sid))
        ]
        self._save_state()
        self._refresh_subs_list()
        if self.current_show:
            self._update_header_ui(self.current_show, None)
        self.set_status(f"Unsubscribed from '{show.get('title')}'.")

