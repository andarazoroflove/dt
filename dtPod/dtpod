    def on_export_opml(self, *_args):
        dlg = Gtk.FileChooserDialog(title="Export Subscriptions as OPML — dtPod", parent=self, action=Gtk.FileChooserAction.SAVE)
        dlg.set_do_overwrite_confirmation(True)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Export", Gtk.ResponseType.OK)
        dlg.set_current_name("dtPod_Subscriptions.opml")
        if dlg.run() == Gtk.ResponseType.OK:
            out_p = Path(dlg.get_filename())
            dlg.destroy()
            lines = ['<?xml version="1.0" encoding="UTF-8"?>', '<opml version="2.0">', '  <head><title>dtPod Subscriptions</title></head>', '  <body>']
            for s in self.subscriptions:
                t = html.escape(s.get("title") or "Podcast", quote=True)
                u = html.escape(s.get("feedUrl") or "", quote=True)
                lines.append(f'    <outline type="rss" text="{t}" title="{t}" xmlUrl="{u}" />')
            lines += ['  </body>', '</opml>']
            out_p.write_text("\n".join(lines), encoding="utf-8")
            self.set_status(f"Exported {len(self.subscriptions)} subscriptions to {out_p}")
        else:
            dlg.destroy()

    def on_import_opml(self, *_args):
        dlg = Gtk.FileChooserDialog(title="Import OPML Subscriptions — dtPod", parent=self, action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Import", Gtk.ResponseType.OK)
        if dlg.run() == Gtk.ResponseType.OK:
            in_p = Path(dlg.get_filename())
            dlg.destroy()
            try:
                root = ET.fromstring(in_p.read_text(encoding="utf-8", errors="replace"))
                added = 0
                for el in root.iter():
                    xml_url = (el.attrib.get("xmlUrl") or el.attrib.get("xmlurl") or "").strip()
                    if xml_url:
                        title = (el.attrib.get("title") or el.attrib.get("text") or xml_url).strip()
                        sh = {"id": hashlib.md5(xml_url.encode()).hexdigest()[:12], "title": title, "artist": "", "feedUrl": xml_url, "artworkUrl": ""}
                        if not self.is_subscribed(sh):
                            self.subscriptions.append(sh)
                            added += 1
                self._save_state()
                self._refresh_subs_list()
                self.set_status(f"Imported {added} new subscription(s) from {in_p.name}.")
            except Exception as exc:
                self.set_status(f"OPML import failed: {exc}")
        else:
            dlg.destroy()

