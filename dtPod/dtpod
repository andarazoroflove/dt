    def _populate_episodes_store(self):
        self.ep_store.clear()
        filt = self.ent_ep_filter.get_text().strip().lower()
        vis_row = 0
        for idx, ep in enumerate(self.current_episodes):
            if filt and filt not in ep["title"].lower() and filt not in ep["description"].lower():
                continue
            guid = ep["guid"]
            playing_now = bool(self.playing_episode and self.playing_episode.get("guid") == guid)
            saved_p = self.saved_files.get(guid)
            has_local = bool(saved_p and Path(saved_p).is_file())
            played = guid in self.played_guids

            if playing_now:
                icon = "🔊"
            elif has_local:
                icon = "💾"
            elif not played:
                icon = "●"
            else:
                icon = ""

            bg = self.well_alt_hex if (vis_row % 2 == 1) else self.well_hex
            weight = Pango.Weight.BOLD if (playing_now or not played) else Pango.Weight.NORMAL
            self.ep_store.append([
                icon,
                ep["title"],
                ep["date"],
                ep["duration"],
                ep["sizeHuman"],
                idx,
                bg,
                int(weight),
            ])
            vis_row += 1

        has_eps = len(self.ep_store) > 0
        self.btn_play_latest.set_sensitive(has_eps)
        self.btn_save_ep.set_sensitive(has_eps)
        if has_eps:
            self.ep_view.get_selection().select_path(Gtk.TreePath.new_first())
            self._on_ep_cursor_changed(self.ep_view)

