# NOAA SWPC HF Amateur Band Condition Physics Calculator
# ---------------------------------------------------------------------------
KP_TO_AP_TABLE = [
    (0.0, 0), (0.33, 2), (0.67, 3), (1.0, 4), (1.33, 5), (1.67, 6),
    (2.0, 7), (2.33, 9), (2.67, 12), (3.0, 15), (3.33, 18), (3.67, 22),
    (4.0, 27), (4.33, 32), (4.67, 39), (5.0, 48), (5.33, 56), (5.67, 67),
    (6.0, 80), (6.33, 94), (6.67, 111), (7.0, 132), (7.33, 154), (7.67, 179),
    (8.0, 207), (8.33, 236), (8.67, 300), (9.0, 400),
]


def kp_to_ap(kp: float) -> int:
    best = 4
    best_d = 99.0
    for kv, av in KP_TO_AP_TABLE:
        d = abs(kp - kv)
        if d < best_d:
            best_d = d
            best = av
    return best


def format_xray_class(flux_wm2: float) -> str:
    f = max(1e-9, float(flux_wm2))
    if f < 1e-7:
        return f"A{min(9.9, f / 1e-8):.1f}"
    if f < 1e-6:
        return f"B{min(9.9, f / 1e-7):.1f}"
    if f < 1e-5:
        return f"C{min(9.9, f / 1e-6):.1f}"
    if f < 1e-4:
        return f"M{min(9.9, f / 1e-5):.1f}"
    return f"X{min(99.0, f / 1e-4):.1f}"


def calculate_hf_band_conditions(
    sfi: float, kp: float, a_idx: float, xray_flux: float, bz_nt: float = 0.0
) -> dict[str, Any]:
    """
    Calculate Day & Night Amateur HF Band Conditions (80m..6m) + VHF propagation
    from Solar Flux Index (10.7cm SFI), Planetary Kp, A-index, GOES X-ray Flux (W/m²), and IMF Bz.
    """
    # NOAA R-Scale (Radio Blackout on sunlit hemisphere)
    if xray_flux >= 2e-3:
        r_scale = ("R5", "EXTREME")
    elif xray_flux >= 1e-3:
        r_scale = ("R4", "SEVERE")
    elif xray_flux >= 1e-4:
        r_scale = ("R3", "STRONG")
    elif xray_flux >= 5e-5:
        r_scale = ("R2", "MODERATE")
    elif xray_flux >= 1e-5:
        r_scale = ("R1", "MINOR")
    else:
        r_scale = ("R0", "NONE")

    # NOAA G-Scale (Geomagnetic Storm)
    if kp >= 9.0:
        g_scale = ("G5", "EXTREME")
    elif kp >= 8.0:
        g_scale = ("G4", "SEVERE")
    elif kp >= 7.0:
        g_scale = ("G3", "STRONG")
    elif kp >= 6.0:
        g_scale = ("G2", "MODERATE")
    elif kp >= 5.0:
        g_scale = ("G1", "MINOR")
    else:
        g_scale = ("G0", "QUIET" if kp < 4.0 else "UNSETTLED")

    eff_storm = kp + (0.5 if a_idx >= 35 else 0.0) + (0.4 if bz_nt <= -7.0 else 0.0)
    r_lvl = int(r_scale[0][1])

    def degrade(cond: str, steps: int) -> str:
        order = ["GOOD", "FAIR", "POOR"]
        i = order.index(cond)
        return order[min(2, i + max(0, steps))]

    bands_out: list[dict[str, str]] = []

    # 80m (3.5 MHz): Heavy D-layer absorption by day; premier regional/DX by night
    d_80 = "POOR" if sfi >= 85 or r_lvl >= 1 else "FAIR"
    n_80 = "GOOD" if eff_storm < 5.0 else ("FAIR" if eff_storm < 6.5 else "POOR")
    bands_out.append({"band": "80m", "day": d_80, "night": n_80, "freq": "3.5 MHz"})

    # 40m (7.0 MHz): NVIS/regional by day, worldwide DX by night
    d_40 = "FAIR" if eff_storm < 6.0 else "POOR"
    if r_lvl >= 1:
        d_40 = degrade(d_40, r_lvl)
    n_40 = "GOOD" if eff_storm < 5.3 else ("FAIR" if eff_storm < 6.8 else "POOR")
    bands_out.append({"band": "40m", "day": d_40, "night": n_40, "freq": "7.0 MHz"})

    # 30m (10.1 MHz): Transition greyline/digital workhorse
    d_30 = "GOOD" if (eff_storm < 4.8 and r_lvl == 0) else ("FAIR" if eff_storm < 6.2 and r_lvl <= 1 else "POOR")
    n_30 = "GOOD" if (sfi >= 90 and eff_storm < 5.0) else ("FAIR" if eff_storm < 6.5 else "POOR")
    bands_out.append({"band": "30m", "day": d_30, "night": n_30, "freq": "10.1 MHz"})

    # 20m (14.0 MHz): Primary daytime DX band, stays open well into night at high SFI
    d_20 = "GOOD" if (sfi >= 82 and eff_storm < 5.0) else ("FAIR" if eff_storm < 6.5 else "POOR")
    if r_lvl >= 2:
        d_20 = degrade(d_20, r_lvl - 1)
    n_20 = "GOOD" if (sfi >= 125 and eff_storm < 4.5) else ("FAIR" if sfi >= 85 and eff_storm < 6.0 else "POOR")
    bands_out.append({"band": "20m", "day": d_20, "night": n_20, "freq": "14.0 MHz"})

    # 17m (18.1 MHz)
    d_17 = "GOOD" if (sfi >= 105 and eff_storm < 4.6) else ("FAIR" if sfi >= 80 and eff_storm < 6.0 else "POOR")
    if r_lvl >= 2:
        d_17 = degrade(d_17, r_lvl - 1)
    n_17 = "FAIR" if (sfi >= 140 and eff_storm < 4.5) else "POOR"
    bands_out.append({"band": "17m", "day": d_17, "night": n_17, "freq": "18.1 MHz"})

    # 15m (21.0 MHz)
    d_15 = "GOOD" if (sfi >= 120 and eff_storm < 4.5) else ("FAIR" if sfi >= 90 and eff_storm < 5.8 else "POOR")
    if r_lvl >= 3:
        d_15 = degrade(d_15, r_lvl - 2)
    n_15 = "FAIR" if (sfi >= 165 and eff_storm < 4.2) else "POOR"
    bands_out.append({"band": "15m", "day": d_15, "night": n_15, "freq": "21.0 MHz"})

    # 12m (24.9 MHz)
    d_12 = "GOOD" if (sfi >= 138 and eff_storm < 4.4) else ("FAIR" if sfi >= 105 and eff_storm < 5.5 else "POOR")
    if r_lvl >= 3:
        d_12 = degrade(d_12, 1)
    n_12 = "FAIR" if (sfi >= 190 and eff_storm < 3.8) else "POOR"
    bands_out.append({"band": "12m", "day": d_12, "night": n_12, "freq": "24.9 MHz"})

    # 10m (28.0 MHz)
    d_10 = "GOOD" if (sfi >= 150 and eff_storm < 4.2) else ("FAIR" if sfi >= 112 and eff_storm < 5.2 else "POOR")
    if r_lvl >= 3:
        d_10 = degrade(d_10, 1)
    n_10 = "FAIR" if (sfi >= 205 and eff_storm < 3.5) else "POOR"
    bands_out.append({"band": "10m", "day": d_10, "night": n_10, "freq": "28.0 MHz"})

    # 6m (50.1 MHz Magic Band: F2 at extreme SFI, Sporadic-E, or Auroral E)
    d_6 = "GOOD" if (sfi >= 220 and eff_storm < 4.0) else ("FAIR" if sfi >= 160 or kp >= 5.0 else "POOR")
    n_6 = "FAIR" if kp >= 5.0 else "POOR"
    bands_out.append({"band": "6m", "day": d_6, "night": n_6, "freq": "50.1 MHz"})

    # VHF Indicators
    if kp >= 6.0 or (kp >= 5.0 and bz_nt <= -5.0):
        aurora_st = "STRONG AU (6m/2m)"
    elif kp >= 4.67:
        aurora_st = "ACTIVE NORTH AU"
    elif kp >= 4.0:
        aurora_st = "HIGH-LAT WATCH"
    else:
        aurora_st = "QUIET"

    now_m = datetime.datetime.now(datetime.timezone.utc).month
    if now_m in (5, 6, 7, 8):
        eskip_st = "HIGH (SUMMER Es)"
    elif now_m in (12, 1):
        eskip_st = "MOD (WINTER Es)"
    elif sfi >= 155:
        eskip_st = "FAIR / TEP"
    else:
        eskip_st = "LOW / SPORADIC"

    return {
        "xray_class": format_xray_class(xray_flux),
        "r_scale": r_scale,
        "g_scale": g_scale,
        "bands": bands_out,
        "vhf_aurora": aurora_st,
        "vhf_eskip": eskip_st,
    }


