    # ---- Button State Sync ----
    def _set_btn_class(self, btn: Gtk.Button, cls: str, enabled: bool):
        ctx = btn.get_style_context()
        if enabled:
            ctx.add_class(cls)
        else:
            ctx.remove_class(cls)

    def _sync_view_buttons(self):
        for i, b in enumerate(self.view_btns):
            self._set_btn_class(b, "sw-active", i == self.view_mode)
        self._set_btn_class(self.btn_loop, "sw-active", self.loop_playing)
        self.btn_loop.set_label("⏸ LOOP" if self.loop_playing else "▶ LOOP")
        self._set_btn_class(self.btn_ppi, "sw-active", bool(self.cfg.get("ppi_sweep", True)))
        self._set_btn_class(self.btn_rings, "sw-active", bool(self.cfg.get("show_rings", True)))
        ridge_lp = bool(self.cfg.get("ridge_loop", True))
        self._set_btn_class(self.btn_ridge_mode, "sw-amber", ridge_lp)
        self.btn_ridge_mode.set_label("GIF LOOP" if ridge_lp else "STILL _0")
        self._update_scrubber_bounds()

    def _apply_tty_style(self):
        ctx = self.tty_view.get_style_context()
        is_amber = bool(self.cfg.get("teletype_amber", False))
        if is_amber:
            ctx.remove_class("tty-paper")
            ctx.add_class("tty-amber")
            self.tag_alert.set_property("foreground", "#ff5e3a")
            self.btn_tty_mode.set_label("PAPER #FFF")
            self._set_btn_class(self.btn_tty_mode, "sw-amber", True)
        else:
            ctx.remove_class("tty-amber")
            ctx.add_class("tty-paper")
            self.tag_alert.set_property("foreground", "#b81d13")
            self.btn_tty_mode.set_label("AMBER CRT")
            self._set_btn_class(self.btn_tty_mode, "sw-amber", False)

    def _frame_count_for_current_view(self) -> int:
        if self.view_mode == 1:
            site = str(self.cfg.get("nexrad_site", DEFAULT_NEXRAD)).upper()
            r_frames = self.engine.ridge_frames.get((site, bool(self.cfg.get("ridge_loop", True))), [])
            return max(1, len(r_frames)) if r_frames else 6
        return 6

    def _update_scrubber_bounds(self):
        n = self._frame_count_for_current_view()
        self._updating_scrubber = True
        self.scrubber.set_range(0, max(1, n - 1))
        self.frame_idx = max(0, min(n - 1, self.frame_idx))
        self.scrubber.set_value(self.frame_idx)
        self._updating_scrubber = False
        self._update_frame_label()

    def _update_frame_label(self):
        n = self._frame_count_for_current_view()
        idx = max(0, min(n - 1, self.frame_idx))
        if self.view_mode == 0 and n == 6:
            lbl = f"F{idx+1}/6 {NEXRAD_LAGS[idx][1]}"
        else:
            lbl = f"F{idx+1}/{n}"
        self.lbl_frame.set_text(lbl)

    # ---- Teletype Formatter ----
    def _refresh_teletype(self):
        m = self.engine.metar_data
        alerts = self.engine.alerts
        self.tty_buf.set_text("")
        it = self.tty_buf.get_end_iter()

        if alerts:
            for al in alerts[:4]:
                line = f"⚠ NWS ACTIVE ALERT [{al['severity'].upper()}]: {al['event']} — {al['headline']}\n"
                self.tty_buf.insert_with_tags(it, line, self.tag_alert)
        else:
            ok_ln = (
                f"NWS CAP ALERTS ({self.cfg['grid']} / {self.cfg['lat']:.2f}N, {self.cfg['lon']:.2f}W): "
                f"NO ACTIVE SEVERE WEATHER WARNINGS OR WATCHES.\n"
            )
            self.tty_buf.insert_with_tags(it, ok_ln, self.tag_hdr)

        dec_ln = (
            f"DECODED {m['station']} ({m['obs_time']}) [{m['flight_cat']}]: "
            f"Wind {m['wind_card']} {m['wind_kt']:.0f}kt"
            f"{(' G' + str(int(round(m['gust_kt']))) + 'kt') if m['gust_kt'] > 0.5 else ''} | "
            f"Vis {m['vis_sm']:g}SM | Sky {', '.join(m['clouds'][:3])} | "
            f"Temp {m['temp_f']:.1f}°F ({m['temp_c']:.1f}°C) Dew {m['dew_f']:.1f}°F RH {m['rh_pct']:.0f}% | "
            f"Altim {m['altim_inhg']:.2f}\" ({m['altim_hpa']:.1f} hPa, {m['tendency']})\n"
        )
        self.tty_buf.insert_with_tags(it, dec_ln, self.tag_hdr)
        self.tty_buf.insert(it, f"METAR : {m['raw_metar']}\n")
        if m.get("raw_taf"):
            self.tty_buf.insert(it, f"TAF   : {m['raw_taf']}")

        sol = self.engine.solar_data
        self.lbl_right_status.set_text(
            f"WX:{m['source'][:14]} | SFI:{sol['sfi']:.0f} Kp:{sol['kp']:.1f} {sol['cond']['xray_class']}"
        )

    # ---- Live Data Fetch Triggers ----
    def _trigger_live_fetches(self, force: bool = False):
        if force:
            self.engine.clear_nexrad_cache_for_refresh()
        self.lbl_status.set_text(
            f"SYNCING NOAA/NWS/SWPC — QTH {self.cfg['callsign']} {self.cfg['grid']} "
            f"| NEXRAD {self.cfg['nexrad_site']} | METAR {self.cfg['metar_id']}..."
        )
        self.engine.fetch_all_telemetry_async(
            str(self.cfg["metar_id"]), float(self.cfg["lat"]), float(self.cfg["lon"])
        )
        self.engine.fetch_ridge_async(
            str(self.cfg["nexrad_site"]), bool(self.cfg.get("ridge_loop", True)), force=force
        )
        self.engine.fetch_satellite_async(str(self.cfg["goes_key"]), force=force)
        self.crt_area.queue_draw()
        return False

    def _on_periodic_refresh(self) -> bool:
        self._trigger_live_fetches(force=True)
        return True

    def _on_engine_updated(self) -> bool:
        self._update_scrubber_bounds()
        self._refresh_teletype()
        m = self.engine.metar_data
        self.lbl_status.set_text(
            f"QTH {self.cfg['callsign']} ({self.cfg['grid']})  |  "
            f"{m['station']} {m['flight_cat']} {m['temp_f']:.0f}°F {m['altim_inhg']:.2f}\"  |  "
            f"ALERTS: {len(self.engine.alerts)}"
        )
        self.crt_area.queue_draw()
        self.dials_area.queue_draw()
        return False

    # ---- 30 FPS Animation & Ballistic Damping Loop ----
    def _on_tick_30fps(self) -> bool:
        now_utc = datetime.datetime.now(datetime.timezone.utc)
        now_loc = datetime.datetime.now()
        self.lbl_clock.set_text(f"{now_utc.strftime('%H:%M:%SZ')} / {now_loc.strftime('%H:%M')}L")

        # Advance phosphor PPI sweep arm smoothly (48 deg/sec)
        if self.cfg.get("ppi_sweep", True):
            self.sweep_deg = (self.sweep_deg + 1.6) % 360.0

        # Advance animated radar loop every 0.58s
        mono = time.monotonic()
        if self.loop_playing and self.view_mode in (0, 1) and (mono - self._last_loop_step) >= 0.58:
            self._last_loop_step = mono
            n = self._frame_count_for_current_view()
            self.frame_idx = (self.frame_idx + 1) % max(1, n)
            self._updating_scrubber = True
            self.scrubber.set_value(self.frame_idx)
            self._updating_scrubber = False
            self._update_frame_label()

        # Ballistic analog weather needles
        m = self.engine.metar_data
        self.anim_baro += (float(m["altim_inhg"]) - self.anim_baro) * 0.14
        self.anim_temp_f += (float(m["temp_f"]) - self.anim_temp_f) * 0.14
        self.anim_dew_f += (float(m["dew_f"]) - self.anim_dew_f) * 0.14

        tgt_w = float(m["wind_dir"]) if m["wind_dir"] is not None else (self.anim_wind_deg + 1.8) % 360.0
        diff_w = ((tgt_w - self.anim_wind_deg + 180.0) % 360.0) - 180.0
        self.anim_wind_deg = (self.anim_wind_deg + diff_w * 0.14) % 360.0

        self.crt_area.queue_draw()
        self.dials_area.queue_draw()
        return True

    # ---- Event Handlers ----
    def _on_apply_qth(self, *_args):
        call = self.ent_call.get_text().strip().upper() or DEFAULT_CALLSIGN
        raw_loc = self.ent_grid.get_text().strip()
        metar_id = self.ent_metar.get_text().strip().upper() or DEFAULT_METAR

        lat, lon = float(self.cfg["lat"]), float(self.cfg["lon"])
        grid = str(self.cfg["grid"])

        # Parse either "41.73,-72.71" or "FN31pr ..."
        m_ll = re.search(r"([+-]?\d+\.\d+)\s*,\s*([+-]?\d+\.\d+)", raw_loc)
        token0 = raw_loc.split()[0].strip(",") if raw_loc else ""
        g_parsed = grid_to_latlon(token0)
        if g_parsed is not None and not re.match(r"^[+-]?\d", token0):
            lat, lon = g_parsed
            grid = token0[:2].upper() + token0[2:4] + (token0[4:6].lower() if len(token0) >= 6 else "")
        elif m_ll:
            lat = max(-84.0, min(84.0, float(m_ll.group(1))))
            lon = max(-180.0, min(180.0, float(m_ll.group(2))))
            grid = latlon_to_grid(lat, lon)

        self.cfg["callsign"] = call
        self.cfg["grid"] = grid
        self.cfg["lat"] = round(lat, 5)
        self.cfg["lon"] = round(lon, 5)
        self.cfg["metar_id"] = metar_id
        self.map_lat = lat
        self.map_lon = lon
        self.ent_call.set_text(call)
        self.ent_grid.set_text(f"{grid} ({lat:.2f},{lon:.2f})")
        self.ent_metar.set_text(metar_id)

        self._save_config()
        self._trigger_live_fetches(force=True)

    def _on_ridge_combo_changed(self, combo: Gtk.ComboBoxText):
        sid = combo.get_active_id() or DEFAULT_NEXRAD
        self.cfg["nexrad_site"] = sid
        self._save_config()
        self.engine.fetch_ridge_async(sid, bool(self.cfg.get("ridge_loop", True)), force=False)
        self._update_scrubber_bounds()
        self.crt_area.queue_draw()

    def _on_goes_combo_changed(self, combo: Gtk.ComboBoxText):
        gkey = combo.get_active_id() or DEFAULT_GOES_KEY
        self.cfg["goes_key"] = gkey
        self.sat_zoom = 1.0
        self.sat_pan = (0.0, 0.0)
        self._save_config()
        self.engine.fetch_satellite_async(gkey, force=False)
        self.crt_area.queue_draw()

    def _on_view_clicked(self, _btn: Gtk.Button, v_id: int):
        self.view_mode = v_id
        self._sync_view_buttons()
        self._save_config()
        if v_id == 1:
            self.engine.fetch_ridge_async(
                str(self.cfg["nexrad_site"]), bool(self.cfg.get("ridge_loop", True))
            )
        elif v_id == 2:
            self.engine.fetch_satellite_async(str(self.cfg["goes_key"]))
        self.crt_area.queue_draw()

    def _on_toggle_loop(self, _btn: Gtk.Button):
        self.loop_playing = not self.loop_playing
        self._sync_view_buttons()
        self._save_config()

    def _step_frame(self, delta: int):
        self.loop_playing = False
        n = self._frame_count_for_current_view()
        self.frame_idx = (self.frame_idx + delta) % max(1, n)
        self._sync_view_buttons()

    def _on_scrubber_changed(self, scale: Gtk.Scale):
        if self._updating_scrubber:
            return
        self.loop_playing = False
        self.frame_idx = int(round(scale.get_value()))
        self._sync_view_buttons()
        self.crt_area.queue_draw()

    def _on_toggle_ppi(self, _btn: Gtk.Button):
        self.cfg["ppi_sweep"] = not bool(self.cfg.get("ppi_sweep", True))
        self._sync_view_buttons()
        self._save_config()

    def _on_toggle_rings(self, _btn: Gtk.Button):
        self.cfg["show_rings"] = not bool(self.cfg.get("show_rings", True))
        self._sync_view_buttons()
        self._save_config()

    def _on_toggle_ridge_loop(self, _btn: Gtk.Button):
        self.cfg["ridge_loop"] = not bool(self.cfg.get("ridge_loop", True))
        self._sync_view_buttons()
        self._save_config()
        self.engine.fetch_ridge_async(
            str(self.cfg["nexrad_site"]), bool(self.cfg["ridge_loop"]), force=False
        )

    def _on_toggle_tty_style(self, _btn: Gtk.Button):
        self.cfg["teletype_amber"] = not bool(self.cfg.get("teletype_amber", False))
        self._apply_tty_style()
        self._save_config()

    def _zoom_step(self, delta: int):
        if self.view_mode == 0:
            self.map_zoom = max(MIN_ZOOM, min(MAX_ZOOM, self.map_zoom + delta))
            self._save_config()
        elif self.view_mode == 1:
            self.ridge_zoom = max(0.8, min(5.0, self.ridge_zoom * (1.25 if delta > 0 else 0.8)))
        elif self.view_mode == 2:
            self.sat_zoom = max(0.8, min(6.0, self.sat_zoom * (1.25 if delta > 0 else 0.8)))
        self.crt_area.queue_draw()

    def _on_reset_view(self, *_args):
        self.map_lat = float(self.cfg["lat"])
        self.map_lon = float(self.cfg["lon"])
        self.map_zoom = 7
        self.ridge_zoom = 1.0
        self.ridge_pan = (0.0, 0.0)
        self.sat_zoom = 1.0
        self.sat_pan = (0.0, 0.0)
        self._save_config()
        self.crt_area.queue_draw()

    # ---- CRT Mouse Pan / Scroll Zoom / Cursor Range Readout ----
    def _on_crt_press(self, _w, ev: Gdk.EventButton) -> bool:
        if ev.button == 1:
            self._dragging = True
            self._drag_last = (ev.x, ev.y)
        return True

    def _on_crt_release(self, _w, ev: Gdk.EventButton) -> bool:
        if ev.button == 1:
            self._dragging = False
        return True

    def _on_crt_leave(self, *_args) -> bool:
        self._hover_latlon = None
        return False

    def _on_crt_motion(self, w: Gtk.Widget, ev: Gdk.EventMotion) -> bool:
        alloc = w.get_allocation()
        W, H = float(alloc.width), float(alloc.height)
        if self.view_mode == 0:
            c_wx, c_wy = latlon_to_world_px(self.map_lat, self.map_lon, float(self.map_zoom))
            self._hover_latlon = world_px_to_latlon(
                c_wx + (ev.x - W * 0.5), c_wy + (ev.y - H * 0.5), float(self.map_zoom)
            )

        if self._dragging:
            dx = ev.x - self._drag_last[0]
            dy = ev.y - self._drag_last[1]
            self._drag_last = (ev.x, ev.y)
            if self.view_mode == 0:
                c_wx, c_wy = latlon_to_world_px(self.map_lat, self.map_lon, float(self.map_zoom))
                self.map_lat, self.map_lon = world_px_to_latlon(
                    c_wx - dx, c_wy - dy, float(self.map_zoom)
                )
            elif self.view_mode == 1:
                self.ridge_pan = (self.ridge_pan[0] + dx, self.ridge_pan[1] + dy)
            elif self.view_mode == 2:
                self.sat_pan = (self.sat_pan[0] + dx, self.sat_pan[1] + dy)
            self.crt_area.queue_draw()
        return True

    def _on_crt_scroll(self, w: Gtk.Widget, ev: Gdk.EventScroll) -> bool:
        step = 0
        if ev.direction == Gdk.ScrollDirection.UP:
            step = 1
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            step = -1
        elif ev.direction == Gdk.ScrollDirection.SMOOTH:
            ok, _dx, dy = ev.get_scroll_deltas()
            if ok and abs(dy) > 0.05:
                step = 1 if dy < 0 else -1
        if step == 0:
            return False

        if self.view_mode == 0:
            alloc = w.get_allocation()
            W, H = float(alloc.width), float(alloc.height)
            old_z = self.map_zoom
            new_z = max(MIN_ZOOM, min(MAX_ZOOM, old_z + step))
            if new_z != old_z:
                # Anchor zoom around mouse cursor
                c_wx, c_wy = latlon_to_world_px(self.map_lat, self.map_lon, float(old_z))
                cur_lat, cur_lon = world_px_to_latlon(
                    c_wx + (ev.x - W * 0.5), c_wy + (ev.y - H * 0.5), float(old_z)
                )
                n_wx, n_wy = latlon_to_world_px(cur_lat, cur_lon, float(new_z))
                self.map_lat, self.map_lon = world_px_to_latlon(
                    n_wx - (ev.x - W * 0.5), n_wy - (ev.y - H * 0.5), float(new_z)
                )
                self.map_zoom = new_z
                self._save_config()
        else:
            self._zoom_step(step)
        self.crt_area.queue_draw()
        return True

    # ---- Cairo Draw Callbacks ----
    def _on_draw_crt(self, w: Gtk.Widget, cr: cairo.Context) -> bool:
        alloc = w.get_allocation()
        W, H = float(alloc.width), float(alloc.height)
        if self.view_mode == 0:
            render_view_nexrad_map(
                cr,
                W,
                H,
                self.engine,
                self.cfg,
                self.map_lat,
                self.map_lon,
                self.map_zoom,
                self.frame_idx,
                self.sweep_deg,
                self._hover_latlon,
            )
        elif self.view_mode == 1:
            render_view_nws_ridge(
                cr,
                W,
                H,
                self.engine,
                str(self.cfg.get("nexrad_site", DEFAULT_NEXRAD)),
                bool(self.cfg.get("ridge_loop", True)),
                self.frame_idx,
                self.ridge_zoom,
                self.ridge_pan,
                self.sweep_deg,
                bool(self.cfg.get("ppi_sweep", True)),
            )
        elif self.view_mode == 2:
            render_view_goes_satellite(
                cr,
                W,
                H,
                self.engine,
                str(self.cfg.get("goes_key", DEFAULT_GOES_KEY)),
                self.sat_zoom,
                self.sat_pan,
                self.cfg,
            )
        else:
            render_view_hf_solar_desk(cr, W, H, self.engine.solar_data)
        return False

    def _on_draw_dials(self, w: Gtk.Widget, cr: cairo.Context) -> bool:
        alloc = w.get_allocation()
        render_weather_instrument_cluster(
            cr,
            float(alloc.width),
            float(alloc.height),
            self.engine.metar_data,
            self.anim_baro,
            self.anim_wind_deg,
            self.anim_temp_f,
            self.anim_dew_f,
        )
        return False

    def _step_gtk_self_test(self, step: int) -> bool:
        if step < 4:
            self._on_view_clicked(self.view_btns[step], step)
            GLib.timeout_add(110, self._step_gtk_self_test, step + 1)
            return False
        print("DTRADAR_SELF_TEST_OK", flush=True)
        self.destroy()
        Gtk.main_quit()
        return False

    def _on_destroy(self, *_args):
        self._save_config()
        self.engine.shutdown()
        if Gtk.main_level() > 0:
            Gtk.main_quit()


# ---------------------------------------------------------------------------
# Comprehensive Deterministic `--self-test` Suite
# ---------------------------------------------------------------------------
def run_self_test_suite() -> int:
    # 1. Verify Maidenhead Grid <-> Lat/Lon & Geodesic / Slippy-Tile Math
    ll = grid_to_latlon("FN31pr")
    assert ll is not None, "Failed to parse FN31pr"
    assert abs(ll[0] - 41.729167) < 0.01 and abs(ll[1] - (-72.708333)) < 0.01, f"Bad FN31pr: {ll}"
    assert latlon_to_grid(ll[0], ll[1]) == "FN31pr"

    tx, ty = latlon_to_tile_xy(DEFAULT_LAT, DEFAULT_LON, 7)
    assert tx == 38 and ty == 47, f"Unexpected Web Mercator tile for Newington z=7: {(tx, ty)}"
    dlat, dlon = dest_latlon_km(DEFAULT_LAT, DEFAULT_LON, 0.0, 100.0)
    dkm, brg = haversine_bearing_km(DEFAULT_LAT, DEFAULT_LON, dlat, dlon)
    assert abs(dkm - 100.0) < 0.25 and (brg < 1.0 or brg > 359.0), f"Range ring math error: {dkm}, {brg}"

    # 2. Verify Embedded World & US State Vector Geography
    assert len(WORLD_POLYGONS) >= 50, f"Expected >=50 world polygons, got {len(WORLD_POLYGONS)}"
    assert len(US_BORDER_POLYLINES) >= 20

    # 3. Verify Aviation METAR Parser (VFR + Gusts + Negative Dewpoint + IFR edge case)
    m1 = parse_metar_raw(
        "KBDL 270053Z 23014G22KT 10SM FEW065 SCT120 09/M02 A3004 RMK AO2 SLP173 T00891022 52012",
        "KBDL",
    )
    assert m1["station"] == "KBDL"
    assert m1["wind_dir"] == 230.0 and m1["wind_kt"] == 14.0 and m1["gust_kt"] == 22.0
    assert abs(m1["temp_c"] - 8.9) < 0.05 and abs(m1["dew_c"] - (-2.2)) < 0.05
    assert abs(m1["altim_inhg"] - 30.04) < 0.01 and abs(m1["altim_hpa"] - 1017.3) < 0.3
    assert m1["flight_cat"] == "VFR"

    m2 = parse_metar_raw("KBOI 270115Z VRB04KT 1 1/2SM -SN BR OVC006 M03/M04 A2968", "KBOI")
    assert m2["wind_vrb"] is True and abs(m2["vis_sm"] - 1.5) < 0.01
    assert m2["ceiling_ft"] == 600 and m2["flight_cat"] == "IFR"

    # 4. Verify SWPC HF Band Condition Matrix Math
    c_good = calculate_hf_band_conditions(sfi=168.0, kp=2.0, a_idx=7.0, xray_flux=1.2e-6, bz_nt=1.5)
    bmap_good = {b["band"]: b for b in c_good["bands"]}
    assert bmap_good["20m"]["day"] == "GOOD" and bmap_good["10m"]["day"] == "GOOD"
    assert bmap_good["80m"]["night"] == "GOOD" and c_good["r_scale"][0] == "R0"

    c_storm = calculate_hf_band_conditions(sfi=95.0, kp=7.3, a_idx=130.0, xray_flux=6.5e-5, bz_nt=-11.0)
    bmap_storm = {b["band"]: b for b in c_storm["bands"]}
    assert c_storm["r_scale"][0] == "R2" and c_storm["g_scale"][0] == "G3"
    assert bmap_storm["40m"]["day"] == "POOR" and bmap_storm["10m"]["day"] == "POOR"

    # 5. Verify Multi-Frame GIF Unpacker + Offscreen Cairo Rendering of All 4 Views & 3 Analog Dials
    eng = RadarDataEngine()
    try:
        # Build a 3-frame test animated GIF in memory and verify PIL->Cairo unpacker
        gif_buf = io.BytesIO()
        g_frames = []
        for gi_idx in range(3):
            im = Image.new("RGBA", (64, 64), (10, 20 + gi_idx * 30, 40, 255))
            g_frames.append(im)
        g_frames[0].save(gif_buf, format="GIF", save_all=True, append_images=g_frames[1:], loop=0)
        unpacked = eng._unpack_gif_bytes(gif_buf.getvalue())
        assert len(unpacked) == 3, f"GIF unpacker expected 3 frames, got {len(unpacked)}"

        cfg_test = {
            "callsign": DEFAULT_CALLSIGN,
            "grid": DEFAULT_GRID,
            "lat": DEFAULT_LAT,
            "lon": DEFAULT_LON,
            "nexrad_site": DEFAULT_NEXRAD,
            "metar_id": DEFAULT_METAR,
            "goes_key": DEFAULT_GOES_KEY,
            "ppi_sweep": True,
            "show_rings": True,
            "show_alerts": True,
        }

        crt_surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 750, 445)
        cr = cairo.Context(crt_surf)

        render_view_nexrad_map(cr, 750, 445, eng, cfg_test, DEFAULT_LAT, DEFAULT_LON, 7, 5, 42.0, (43.1, -112.2))
        arr0 = np.frombuffer(crt_surf.get_data(), dtype=np.uint8)
        assert float(arr0.std()) > 8.0, "NEXRAD map surface failed to render detail"

        render_view_nws_ridge(cr, 750, 445, eng, "KBOX", True, 2, 1.0, (0.0, 0.0), 85.0, True)
        arr1 = np.frombuffer(crt_surf.get_data(), dtype=np.uint8)
        assert float(arr1.std()) > 8.0, "NWS RIDGE surface failed to render detail"

        for gk in ("nr_geocolor", "aurora_north"):
            render_view_goes_satellite(cr, 750, 445, eng, gk, 1.0, (0.0, 0.0), cfg_test)
            arr2 = np.frombuffer(crt_surf.get_data(), dtype=np.uint8)
            assert float(arr2.std()) > 8.0, f"GOES view {gk} failed to render"

        render_view_hf_solar_desk(cr, 750, 445, eng.solar_data)
        arr3 = np.frombuffer(crt_surf.get_data(), dtype=np.uint8)
        assert float(arr3.std()) > 8.0, "HF Solar desk surface failed to render"

        dial_surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 356, 445)
        cr_d = cairo.Context(dial_surf)
        render_weather_instrument_cluster(cr_d, 356, 445, m1, 30.04, 230.0, 48.0, 28.0)
        arr_d = np.frombuffer(dial_surf.get_data(), dtype=np.uint8)
        assert float(arr_d.std()) > 12.0, "Analog weather dials failed to render"
    finally:
        eng.shutdown()

    # If an X11/Wayland display is accessible, also exercise full GTK window & view-tab lifecycle
    ok_gtk, _ = Gtk.init_check(sys.argv)
    if ok_gtk and os.environ.get("DISPLAY"):
        win = DtRadarWindow(self_test=True)
        win.show_all()
        Gtk.main()
    else:
        print("DTRADAR_SELF_TEST_OK", flush=True)
    return 0


def main() -> int:
    if "--self-test" in sys.argv:
        return run_self_test_suite()
    ok, _ = Gtk.init_check(sys.argv)
    if not ok:
        sys.stderr.write("dtRadar: unable to open X11/GTK display.\n")
        return 1
    win = DtRadarWindow(self_test=False)
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
