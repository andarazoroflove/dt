            "show_rings": True,
            "show_alerts": True,
            "loop_playing": True,
            "teletype_amber": False,
            "ridge_loop": True,
        }
        if CONFIG_FILE.is_file():
            try:
                saved = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
                if isinstance(saved, dict):
                    cfg.update(saved)
            except Exception:
