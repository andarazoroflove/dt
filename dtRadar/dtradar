def decode_embedded_world_polygons() -> list[tuple[bool, list[tuple[float, float]]]]:
    try:
        raw = zlib.decompress(base64.b64decode(WORLD_VEC_B64))
        off = 0
        (npolys,) = struct.unpack_from("<H", raw, off)
        off += 2
        out: list[tuple[bool, list[tuple[float, float]]]] = []
        for _ in range(npolys):
            is_hole, npts = struct.unpack_from("<BH", raw, off)
            off += 3
            px, py = 0, 0
            pts: list[tuple[float, float]] = []
            for _ in range(npts):
                dx, dy = struct.unpack_from("<hh", raw, off)
                off += 4
                px += dx
                py += dy
                pts.append((px / 50.0, py / 50.0))
            out.append((bool(is_hole), pts))
        return out
    except Exception:
        return []


