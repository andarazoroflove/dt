def render_synthetic_nexrad_echoes(
    cr: cairo.Context,
    cx_px: float,
    cy_px: float,
    px_per_km: float,
    frame_idx: int,
    n_frames: int,
):
    """
    Offline tactical Doppler reflectivity echo cells (light green -> yellow -> orange -> red/magenta)
    drifting ENE across the Snake River Plain / Teton Valley across animation frames 0..5.
    """
    t = frame_idx / max(1, n_frames - 1)
    cells = [
        # (dx_km_start, dy_km_start, vx_km, vy_km, rx_km, ry_km, rot_deg, peak_tier)
        (-42.0, 18.0, 28.0, -14.0, 38.0, 22.0, -24.0, 4),   # Primary convective squall SW -> NE
        (24.0, -34.0, 24.0, -12.0, 48.0, 28.0, -32.0, 3),   # Upper Snake / Teton precipitation band
        (-95.0, 56.0, 26.0, -10.0, 30.0, 18.0, -18.0, 2),   # Trailing shower cell
        (78.0, 42.0, 20.0, -11.0, 26.0, 16.0, -15.0, 2),    # Bear River / Wyoming border showers
    ]
    tiers = [
        (1.00, (0.08, 0.72, 0.24, 0.44)),  # 20 dBZ green
        (0.72, (0.06, 0.88, 0.20, 0.56)),  # 30 dBZ bright green
        (0.50, (0.96, 0.86, 0.12, 0.68)),  # 38 dBZ yellow
        (0.32, (0.96, 0.42, 0.10, 0.78)),  # 46 dBZ orange-red
        (0.16, (0.88, 0.12, 0.62, 0.85)),  # 54 dBZ severe crimson-magenta
    ]
    for dx0, dy0, vx, vy, rx_km, ry_km, rot_d, max_tier in cells:
        x_km = dx0 + vx * t
        y_km = dy0 + vy * t
        px = cx_px + x_km * px_per_km
        py = cy_px + y_km * px_per_km
        rx = max(3.0, rx_km * px_per_km)
        ry = max(2.5, ry_km * px_per_km)
        for ti in range(max_tier + 1):
            scale_f, rgba = tiers[ti]
            cr.save()
            cr.translate(px + ti * 1.5, py - ti * 0.8)
            cr.rotate(math.radians(rot_d))
            cr.scale(rx * scale_f, ry * scale_f)
            cr.arc(0.0, 0.0, 1.0, 0.0, 2.0 * math.pi)
            cr.restore()
            cr.set_source_rgba(*rgba)
            cr.fill()


def render_ppi_sweep_overlay(
    cr: cairo.Context, cx: float, cy: float, radius_px: float, sweep_deg: float
):
    """Render glowing P1/P7 phosphor rotating radar beam + persistence wedge."""
    cr.save()
    cr.arc(cx, cy, radius_px, 0.0, 2.0 * math.pi)
    cr.clip()

    trail_deg = 48.0
    steps = 18
    for i in range(steps):
        f0 = i / steps
        f1 = (i + 1) / steps
        a0 = math.radians(sweep_deg - trail_deg * (1.0 - f0))
        a1 = math.radians(sweep_deg - trail_deg * (1.0 - f1))
        alpha = 0.015 + 0.19 * (f1 ** 2.1)
        cr.move_to(cx, cy)
        cr.arc(cx, cy, radius_px, a0, a1)
        cr.close_path()
        cr.set_source_rgba(0.18, 0.98, 0.48, alpha)
        cr.fill()

    rad = math.radians(sweep_deg)
    ex = cx + radius_px * math.cos(rad)
    ey = cy + radius_px * math.sin(rad)
    cr.set_line_width(3.4)
    cr.set_source_rgba(0.25, 1.0, 0.56, 0.35)
    cr.move_to(cx, cy)
    cr.line_to(ex, ey)
    cr.stroke()

    cr.set_line_width(1.6)
    cr.set_source_rgba(0.68, 1.0, 0.80, 0.92)
    cr.move_to(cx, cy)
    cr.line_to(ex, ey)
    cr.stroke()
    cr.restore()


def draw_dbz_legend_bar(cr: cairo.Context, x: float, y: float, w: float, h: float):
    cr.save()
    cr.rectangle(x - 4, y - 14, w + 8, h + 18)
    cr.set_source_rgba(0.03, 0.06, 0.09, 0.84)
    cr.fill()
    cr.set_line_width(1.0)
    cr.set_source_rgba(0.32, 0.52, 0.62, 0.7)
    cr.rectangle(x - 4, y - 14, w + 8, h + 18)
    cr.stroke()

    cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(8.0)
    cr.set_source_rgb(0.68, 0.96, 0.88)
    cr.move_to(x, y - 4)
    cr.show_text("NEXRAD REFLECTIVITY (dBZ):")

    seg_w = w / len(DBZ_SCALE)
    for i, (dbz_v, col) in enumerate(DBZ_SCALE):
        sx = x + i * seg_w
        cr.rectangle(sx, y, seg_w - 1.0, h)
        cr.set_source_rgb(*col)
        cr.fill()
        if i % 2 == 0 or i == len(DBZ_SCALE) - 1:
            cr.set_source_rgb(0.92, 0.96, 0.98)
            cr.set_font_size(7.5)
            cr.move_to(sx + 1.0, y + h - 2.0)
            cr.show_text(f"{dbz_v}")
    cr.restore()


def render_view_nexrad_map(
    cr: cairo.Context,
    W: float,
    H: float,
    engine: RadarDataEngine,
    cfg: dict[str, Any],
    center_lat: float,
    center_lon: float,
    zoom: int,
    frame_idx: int,
    sweep_deg: float,
    hover_latlon: tuple[float, float] | None = None,
):
    draw_crt_bezel_frame(cr, W, H)
    z = max(MIN_ZOOM, min(MAX_ZOOM, int(zoom)))
    c_wx, c_wy = latlon_to_world_px(center_lat, center_lon, float(z))
    world_px_span = TILE_SIZE * (2 ** z)

    def ll_to_screen(lat: float, lon: float) -> tuple[float, float]:
        wx, wy = latlon_to_world_px(lat, lon, float(z))
        dx = wx - c_wx
        if dx > world_px_span * 0.5:
            dx -= world_px_span
        elif dx < -world_px_span * 0.5:
            dx += world_px_span
        return (W * 0.5 + dx, H * 0.5 + (wy - c_wy))

    # 1. Embedded Vector Landmass Fallback (always drawn cleanly beneath tiles)
    for is_hole, pts in WORLD_POLYGONS:
        if len(pts) < 3:
            continue
        cr.new_path()
        started = False
        prev_sx = 0.0
        for lon_p, lat_p in pts:
            sx, sy = ll_to_screen(lat_p, lon_p)
            if not started:
                cr.move_to(sx, sy)
                started = True
            else:
                if abs(sx - prev_sx) > W * 0.7:
                    cr.move_to(sx, sy)
                else:
                    cr.line_to(sx, sy)
            prev_sx = sx
        cr.close_path()
        if is_hole:
            cr.set_source_rgb(0.04, 0.08, 0.13)
        else:
            cr.set_source_rgb(0.10, 0.14, 0.20)
        cr.fill_preserve()
        cr.set_line_width(0.8)
        cr.set_source_rgba(0.24, 0.36, 0.48, 0.7)
        cr.stroke()

    # 2. Slippy OSM Dark-LUT Base Tiles (when cached or online)
    x0_tile = int(math.floor((c_wx - W * 0.5) / TILE_SIZE))
    x1_tile = int(math.floor((c_wx + W * 0.5) / TILE_SIZE))
    y0_tile = int(math.floor((c_wy - H * 0.5) / TILE_SIZE))
    y1_tile = int(math.floor((c_wy + H * 0.5) / TILE_SIZE))
    n_tiles = 1 << z

    osm_drawn = 0
    for ty in range(max(0, y0_tile), min(n_tiles - 1, y1_tile) + 1):
        for tx_raw in range(x0_tile, x1_tile + 1):
            tx = tx_raw % n_tiles
            surf = engine.get_osm_tile(z, tx, ty)
            if surf is not None:
                sx = W * 0.5 + (tx_raw * TILE_SIZE - c_wx)
                sy = H * 0.5 + (ty * TILE_SIZE - c_wy)
                cr.set_source_surface(surf, sx, sy)
                cr.paint()
                osm_drawn += 1

    # 3. Crisp Geopolitical US State Borders, Rivers & Lat/Lon Tactical Graticule
    if osm_drawn == 0:
        cr.set_line_width(0.7)
        cr.set_source_rgba(0.16, 0.30, 0.38, 0.45)
        step_deg = 2 if z >= 6 else (5 if z >= 5 else 10)
        for lat_g in range(-60, 75, step_deg):
            _, sy = ll_to_screen(float(lat_g), center_lon)
            if 0 <= sy <= H:
                cr.move_to(0, sy)
                cr.line_to(W, sy)
                cr.stroke()
        for lon_g in range(-170, 175, step_deg):
            sx, _ = ll_to_screen(center_lat, float(lon_g))
            if 0 <= sx <= W:
                cr.move_to(sx, 0)
                cr.line_to(sx, H)
                cr.stroke()

        # Snake River & Great Salt Lake regional hydrography
        cr.set_line_width(1.4)
        cr.set_source_rgba(0.12, 0.34, 0.52, 0.72)
        for hline in IDAHO_HYDRO_LINES:
            for i, (lo, la) in enumerate(hline):
                sx, sy = ll_to_screen(la, lo)
                if i == 0:
                    cr.move_to(sx, sy)
                else:
                    cr.line_to(sx, sy)
            cr.stroke()

    # Always draw crisp US state boundaries so NEXRAD echoes have sharp geographical context
    cr.set_line_width(1.25)
    cr.set_source_rgba(0.38, 0.56, 0.72, 0.72 if osm_drawn == 0 else 0.42)
    for poly in US_BORDER_POLYLINES:
        for i, (lo, la) in enumerate(poly):
            sx, sy = ll_to_screen(la, lo)
            if i == 0:
                cr.move_to(sx, sy)
            else:
                cr.line_to(sx, sy)
        cr.stroke()

    qth_lat = float(cfg.get("lat", DEFAULT_LAT))
    qth_lon = float(cfg.get("lon", DEFAULT_LON))
    qth_sx, qth_sy = ll_to_screen(qth_lat, qth_lon)

    if osm_drawn == 0 and z >= 5:
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(8.2)
        for cname, clat, clon in REGIONAL_CITIES:
            sx, sy = ll_to_screen(clat, clon)
            if math.hypot(sx - qth_sx, sy - qth_sy) < 18.0:
                continue
            if 10 <= sx <= W - 40 and 15 <= sy <= H - 20:
                cr.set_source_rgba(0.55, 0.74, 0.86, 0.78)
                cr.new_sub_path()
                cr.arc(sx, sy, 2.0, 0, 2 * math.pi)
                cr.fill()
                cr.move_to(sx + 4.5, sy + 3.0)
                cr.show_text(cname)

    # 4. Live Multi-Frame Iowa Mesonet NEXRAD N0Q Reflectivity Tiles
    lag_idx = max(0, min(len(NEXRAD_LAGS) - 1, frame_idx))
    lag_id, lag_lbl, _ = NEXRAD_LAGS[lag_idx]
    nex_drawn = 0
    for ty in range(max(0, y0_tile), min(n_tiles - 1, y1_tile) + 1):
        for tx_raw in range(x0_tile, x1_tile + 1):
            tx = tx_raw % n_tiles
            nsurf = engine.get_nexrad_tile(lag_id, z, tx, ty)
            if nsurf is not None:
                sx = W * 0.5 + (tx_raw * TILE_SIZE - c_wx)
                sy = H * 0.5 + (ty * TILE_SIZE - c_wy)
                cr.set_source_surface(nsurf, sx, sy)
                cr.paint()
                nex_drawn += 1

    # Determine radar PPI center (selected NEXRAD station if in region, else QTH)
    qth_lat = float(cfg.get("lat", DEFAULT_LAT))
    qth_lon = float(cfg.get("lon", DEFAULT_LON))
    nex_site = str(cfg.get("nexrad_site", DEFAULT_NEXRAD)).upper()
    if nex_site in RIDGE_MAP and nex_site != "CONUS":
        _, r_lat, r_lon = RIDGE_MAP[nex_site]
    else:
        r_lat, r_lon = qth_lat, qth_lon

    qth_sx, qth_sy = ll_to_screen(qth_lat, qth_lon)
    rad_sx, rad_sy = ll_to_screen(r_lat, r_lon)
    p100_lat, p100_lon = dest_latlon_km(qth_lat, qth_lon, 90.0, 100.0)
    p100_sx, _ = ll_to_screen(p100_lat, p100_lon)
    px_per_km = max(0.05, abs(p100_sx - qth_sx) / 100.0)

    # Offline Synthetic Doppler Storm Echoes when live IEM NEXRAD tiles aren't yet available
    if nex_drawn == 0 and not engine.online_nexrad:
        render_synthetic_nexrad_echoes(cr, rad_sx, rad_sy, px_per_km, lag_idx, len(NEXRAD_LAGS))

    # 5. Active NWS CAP Warning Polygons
    if cfg.get("show_alerts", True):
        for al in engine.alerts:
            ev = al.get("event", "").upper()
            if "TORNADO" in ev:
                col = (1.0, 0.16, 0.16)
            elif "SEVERE THUNDERSTORM" in ev:
                col = (1.0, 0.68, 0.08)
            elif "FLOOD" in ev:
                col = (0.18, 0.96, 0.38)
            elif "WINTER" in ev or "BLIZZARD" in ev or "SNOW" in ev:
                col = (1.0, 0.42, 0.78)
            else:
                col = (1.0, 0.86, 0.22)
            for ring in al.get("polygons", []):
                if len(ring) < 3:
                    continue
                for i, (plat, plon) in enumerate(ring):
                    sx, sy = ll_to_screen(plat, plon)
                    if i == 0:
                        cr.move_to(sx, sy)
                    else:
                        cr.line_to(sx, sy)
                cr.close_path()
                cr.set_source_rgba(col[0], col[1], col[2], 0.22)
                cr.fill_preserve()
                cr.set_line_width(2.2)
                cr.set_source_rgba(col[0], col[1], col[2], 0.95)
                cr.stroke()

    # 6. Geodesic Range Rings (50 / 100 / 150 / 200 km) & Azimuth Crosshairs around QTH
    if cfg.get("show_rings", True):
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.2)
        for rk in (50, 100, 150, 200):
            cr.new_path()
            for b_deg in range(0, 364, 6):
                dlat, dlon = dest_latlon_km(qth_lat, qth_lon, float(b_deg), float(rk))
                sx, sy = ll_to_screen(dlat, dlon)
                if b_deg == 0:
                    cr.move_to(sx, sy)
                else:
                    cr.line_to(sx, sy)
            cr.set_line_width(1.1 if rk != 200 else 1.5)
            cr.set_source_rgba(0.22, 0.88, 0.56, 0.48 if rk != 200 else 0.70)
            cr.stroke()

            n_lat, n_lon = dest_latlon_km(qth_lat, qth_lon, 0.0, float(rk))
            nsx, nsy = ll_to_screen(n_lat, n_lon)
            if 18 <= nsy <= H - 28:
                cr.set_source_rgba(0.46, 0.98, 0.72, 0.86)
                cr.move_to(nsx + 4, nsy - 2)
                cr.show_text(f"{rk}km")

        # 30-degree radials out to 200 km
        cr.set_line_width(0.8)
        cr.set_source_rgba(0.20, 0.78, 0.50, 0.26)
        for b_deg in range(0, 360, 30):
            elat, elon = dest_latlon_km(qth_lat, qth_lon, float(b_deg), 200.0)
            esx, esy = ll_to_screen(elat, elon)
            cr.move_to(qth_sx, qth_sy)
            cr.line_to(esx, esy)
            cr.stroke()

    # 7. Optional Rotating Green Phosphor PPI Radar Sweep Arm
    if cfg.get("ppi_sweep", True):
        sweep_r_px = max(85.0, min(max(W, H) * 0.72, 200.0 * px_per_km))
        render_ppi_sweep_overlay(cr, qth_sx, qth_sy, sweep_r_px, sweep_deg)

    # 8. Regional NEXRAD WSR-88D Site Markers + Home QTH Reticle
    cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(8.2)
    for sid, _slbl, slat, slon in RIDGE_STATIONS:
        if sid == "CONUS":
            continue
        sx, sy = ll_to_screen(slat, slon)
        if 8 <= sx <= W - 30 and 12 <= sy <= H - 24:
            is_sel = sid == nex_site
            cr.set_source_rgb(0.36, 0.98, 0.88) if is_sel else cr.set_source_rgba(0.45, 0.82, 0.95, 0.75)
            cr.set_line_width(1.4 if is_sel else 1.0)
            cr.new_sub_path()
            cr.arc(sx, sy, 4.0 if is_sel else 2.8, 0, 2 * math.pi)
            cr.stroke()
            cr.move_to(sx + 6.0, sy - 3.0)
            cr.show_text(sid)

    # Home QTH W1AW / FN31pr amber-cyan diamond reticle
    if -20 <= qth_sx <= W + 20 and -20 <= qth_sy <= H + 20:
        cr.set_line_width(1.8)
        cr.set_source_rgb(1.0, 0.76, 0.22)
        cr.move_to(qth_sx, qth_sy - 7)
        cr.line_to(qth_sx + 7, qth_sy)
        cr.line_to(qth_sx, qth_sy + 7)
        cr.line_to(qth_sx - 7, qth_sy)
        cr.close_path()
        cr.stroke()
        cr.set_font_size(9.0)
        cr.move_to(qth_sx + 9, qth_sy + 3)
        cr.show_text(f"{cfg.get('callsign', DEFAULT_CALLSIGN)} ({cfg.get('grid', DEFAULT_GRID)})")

    # 9. Top CRT VFD Telemetry HUD + Bottom dBZ Legend Bar
    cr.rectangle(8, 8, W - 16, 24)
    cr.set_source_rgba(0.02, 0.07, 0.08, 0.84)
    cr.fill()
    cr.set_line_width(1.0)
    cr.set_source_rgba(0.25, 0.62, 0.58, 0.75)
    cr.rectangle(8, 8, W - 16, 24)
    cr.stroke()

    cr.set_font_size(9.2)
    cr.set_source_rgb(0.32, 0.98, 0.84)
    src_str = "LIVE IEM NEXRAD N0Q" if engine.online_nexrad else "OFFLINE DOPPLER SIMULATOR"
    hud_left = f"NEXRAD DOPPLER  |  Z={z}  |  FRAME [{lag_idx+1}/6: {lag_lbl}]  |  {src_str}"
    cr.move_to(15, 23)
    cr.show_text(hud_left)

    if hover_latlon is not None:
        hlat, hlon = hover_latlon
        dkm, brg = haversine_bearing_km(qth_lat, qth_lon, hlat, hlon)
        hgrid = latlon_to_grid(hlat, hlon)
        hud_r = f"{hlat:+.3f},{hlon:+.3f} [{hgrid}] {dkm:.0f}km @{brg:03.0f}°"
        ext = cr.text_extents(hud_r)
        cr.set_source_rgb(1.0, 0.78, 0.28)
        cr.move_to(W - ext.width - 15, 23)
        cr.show_text(hud_r)

    draw_dbz_legend_bar(cr, 14, H - 22, min(330.0, W - 28.0), 13.0)


def render_view_nws_ridge(
    cr: cairo.Context,
    W: float,
    H: float,
    engine: RadarDataEngine,
    site: str,
    is_loop: bool,
    frame_idx: int,
    zoom_f: float,
    pan_xy: tuple[float, float],
    sweep_deg: float,
    ppi_on: bool,
):
    draw_crt_bezel_frame(cr, W, H)
    site_u = site.strip().upper() or DEFAULT_NEXRAD
    frames = engine.ridge_frames.get((site_u, is_loop), [])

    if frames:
        idx = frame_idx % len(frames)
        surf = frames[idx]
        sw, sh = float(surf.get_width()), float(surf.get_height())
        fit_s = min((W - 20.0) / max(1.0, sw), (H - 48.0) / max(1.0, sh)) * zoom_f
        tx = W * 0.5 - (sw * fit_s) * 0.5 + pan_xy[0]
        ty = (H + 26.0) * 0.5 - (sh * fit_s) * 0.5 + pan_xy[1]

        cr.save()
        cr.rectangle(4, 34, W - 8, H - 38)
        cr.clip()
        cr.translate(tx, ty)
        cr.scale(fit_s, fit_s)
        cr.set_source_surface(surf, 0, 0)
        cr.paint()
        cr.restore()

        if ppi_on:
            render_ppi_sweep_overlay(cr, W * 0.5 + pan_xy[0], (H + 26.0) * 0.5 + pan_xy[1], min(W, H) * 0.39 * zoom_f, sweep_deg)
        frame_txt = f"FRAME {idx + 1}/{len(frames)}"
    else:
        # Crisp Offline NWS WSR-88D Station PPI Scope Fallback
        cx, cy = W * 0.5 + pan_xy[0], (H + 24.0) * 0.5 + pan_xy[1]
        r_max = min(W - 40.0, H - 68.0) * 0.46 * zoom_f

        cr.save()
        cr.arc(cx, cy, r_max, 0, 2 * math.pi)
        cr.set_source_rgb(0.02, 0.08, 0.05)
        cr.fill_preserve()
        cr.clip()

        # Range rings & radials
        for rf, km_lbl in ((0.25, "60km"), (0.50, "120km"), (0.75, "180km"), (1.0, "240km")):
            cr.new_sub_path()
            cr.arc(cx, cy, r_max * rf, 0, 2 * math.pi)
            cr.set_line_width(1.1)
            cr.set_source_rgba(0.20, 0.78, 0.42, 0.52)
            cr.stroke()
            cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(8.0)
            cr.set_source_rgba(0.45, 0.95, 0.65, 0.8)
            cr.move_to(cx + 4, cy - r_max * rf + 10)
            cr.show_text(km_lbl)

        for ang_d in range(0, 360, 30):
            ra = math.radians(ang_d)
            cr.move_to(cx, cy)
            cr.line_to(cx + r_max * math.cos(ra), cy + r_max * math.sin(ra))
            cr.set_line_width(0.8)
            cr.set_source_rgba(0.18, 0.66, 0.38, 0.34)
            cr.stroke()

        render_synthetic_nexrad_echoes(cr, cx, cy, r_max / 180.0, frame_idx % 6, 6)
        if ppi_on:
            render_ppi_sweep_overlay(cr, cx, cy, r_max, sweep_deg)
        cr.restore()

        cr.arc(cx, cy, r_max, 0, 2 * math.pi)
        cr.set_line_width(2.2)
        cr.set_source_rgb(0.32, 0.78, 0.52)
        cr.stroke()
        draw_dbz_legend_bar(cr, 14, H - 22, min(330.0, W - 28.0), 13.0)
        frame_txt = f"SIM FRAME {(frame_idx % 6) + 1}/6"

    # Top VFD Header
    cr.rectangle(8, 8, W - 16, 24)
    cr.set_source_rgba(0.02, 0.07, 0.08, 0.88)
    cr.fill()
    cr.set_line_width(1.0)
    cr.set_source_rgba(0.26, 0.64, 0.58, 0.75)
    cr.rectangle(8, 8, W - 16, 24)
    cr.stroke()

    site_desc = RIDGE_MAP.get(site_u, (site_u, 0.0, 0.0))[0]
    cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(9.2)
    cr.set_source_rgb(0.32, 0.98, 0.84)
    cr.move_to(15, 23)
    cr.show_text(f"NWS RIDGE II  |  {site_desc}  |  {frame_txt}")

    ext = cr.text_extents(engine.ridge_status)
    cr.set_source_rgb(1.0, 0.76, 0.26)
    cr.move_to(W - ext.width - 15, 23)
    cr.show_text(engine.ridge_status)


def render_view_goes_satellite(
    cr: cairo.Context,
    W: float,
    H: float,
    engine: RadarDataEngine,
    goes_key: str,
    zoom_f: float,
    pan_xy: tuple[float, float],
    cfg: dict[str, Any],
):
    draw_crt_bezel_frame(cr, W, H)
    lbl, _url = GOES_MAP.get(goes_key, GOES_MAP[DEFAULT_GOES_KEY])
    surf = engine.sat_surfaces.get(goes_key)

    if surf is not None:
        sw, sh = float(surf.get_width()), float(surf.get_height())
        fit_s = min((W - 16.0) / max(1.0, sw), (H - 44.0) / max(1.0, sh)) * zoom_f
        tx = W * 0.5 - (sw * fit_s) * 0.5 + pan_xy[0]
        ty = (H + 28.0) * 0.5 - (sh * fit_s) * 0.5 + pan_xy[1]

        cr.save()
        cr.rectangle(4, 34, W - 8, H - 38)
        cr.clip()
        cr.translate(tx, ty)
        cr.scale(fit_s, fit_s)
        cr.set_source_surface(surf, 0, 0)
        cr.paint()
        cr.restore()
        src_badge = engine.sat_timestamps.get(goes_key, "LIVE NESDIS STAR")
    else:
        # Procedural Geostationary / Polar Satellite Offline Visualization
        cx, cy = W * 0.5 + pan_xy[0], (H + 26.0) * 0.5 + pan_xy[1]
        cr.save()
        cr.rectangle(4, 34, W - 8, H - 38)
        cr.clip()

        # Deep space backdrop
        cr.rectangle(4, 34, W - 8, H - 38)
        cr.set_source_rgb(0.02, 0.03, 0.06)
        cr.fill()

        if "aurora" in goes_key or "fd" in goes_key:
            rad = min(W, H - 44.0) * 0.43 * zoom_f
            globe = cairo.RadialGradient(cx - rad * 0.25, cy - rad * 0.25, rad * 0.1, cx, cy, rad)
            if "aurora" in goes_key:
                globe.add_color_stop_rgb(0.0, 0.08, 0.14, 0.24)
                globe.add_color_stop_rgb(1.0, 0.03, 0.06, 0.12)
            else:
                globe.add_color_stop_rgb(0.0, 0.10, 0.26, 0.46)
                globe.add_color_stop_rgb(0.85, 0.05, 0.14, 0.28)
                globe.add_color_stop_rgb(1.0, 0.18, 0.48, 0.78)
            cr.arc(cx, cy, rad, 0, 2 * math.pi)
            cr.set_source(globe)
            cr.fill()

            # Orthographic continents
            c_lat0 = 72.0 if "aurora" in goes_key else 22.0
            c_lon0 = -105.0 if "aurora" in goes_key else -135.0
            lat0_r, lon0_r = math.radians(c_lat0), math.radians(c_lon0)
            for is_hole, pts in WORLD_POLYGONS:
                if is_hole:
                    continue
                started = False
                cr.new_path()
                for lo, la in pts[::2]:
                    la_r, lo_r = math.radians(la), math.radians(lo)
                    cos_c = math.sin(lat0_r) * math.sin(la_r) + math.cos(lat0_r) * math.cos(la_r) * math.cos(lo_r - lon0_r)
                    if cos_c <= 0.0:
                        started = False
                        continue
                    px = cx + rad * math.cos(la_r) * math.sin(lo_r - lon0_r)
                    py = cy - rad * (math.cos(lat0_r) * math.sin(la_r) - math.sin(lat0_r) * math.cos(la_r) * math.cos(lo_r - lon0_r))
                    if not started:
                        cr.move_to(px, py)
                        started = True
                    else:
                        cr.line_to(px, py)
                cr.set_source_rgba(0.18, 0.34, 0.24, 0.85)
                cr.fill()

            if "aurora" in goes_key:
                # Glowing green/red geomagnetic auroral oval around ~66°N magnetic pole
                ax, ay = cx, cy + rad * 0.08
                for rw_f, al_f, col in (
                    (0.46, 0.22, (0.12, 0.95, 0.46)),
                    (0.39, 0.48, (0.24, 1.00, 0.52)),
                    (0.34, 0.30, (0.85, 0.98, 0.26)),
                ):
                    cr.set_line_width(rad * 0.11)
                    cr.set_source_rgba(col[0], col[1], col[2], al_f)
                    cr.arc(ax, ay, rad * rw_f, 0, 2 * math.pi)
                    cr.stroke()
            else:
                # Frontal cloud swirl bands
                for dy_f, rot_f in ((-0.35, -0.2), (0.08, 0.12), (0.38, 0.25)):
                    cr.save()
                    cr.translate(cx, cy + rad * dy_f)
                    cr.rotate(rot_f)
                    cr.scale(rad * 0.78, rad * 0.14)
                    cr.arc(0, 0, 1.0, 0, 2 * math.pi)
                    cr.restore()
                    cr.set_source_rgba(0.92, 0.96, 1.0, 0.34)
                    cr.fill()
        else:
            # Regional Northern Rockies / CONUS Sector Synthetic IR / WV / GeoColor
            lat_span = 16.0 if "nr" in goes_key or "pnw" in goes_key else 28.0
            lon_span = 24.0 if "nr" in goes_key or "pnw" in goes_key else 56.0
            lat_mid = 44.0 if "nr" in goes_key else (46.0 if "pnw" in goes_key else 38.5)
            lon_mid = -112.5 if "nr" in goes_key else (-120.5 if "pnw" in goes_key else -97.0)

            def sec_xy(la: float, lo: float) -> tuple[float, float]:
                sx = cx + ((lo - lon_mid) / lon_span) * (W * 0.88 * zoom_f)
                sy = cy - ((la - lat_mid) / lat_span) * ((H - 54.0) * 0.88 * zoom_f)
                return sx, sy

            # Base terrain / radiative background
            cr.rectangle(10, 38, W - 20, H - 46)
            if "ir13" in goes_key:
                cr.set_source_rgb(0.14, 0.15, 0.17)
            elif "wv09" in goes_key:
                cr.set_source_rgb(0.06, 0.14, 0.24)
            else:
                cr.set_source_rgb(0.11, 0.18, 0.15)
            cr.fill()

            # Synthetic comma-head frontal cloud deck
            for i_c in range(6):
                clat = lat_mid - 2.5 + i_c * 1.3
                clon = lon_mid - 6.0 + i_c * 2.1
                csx, csy = sec_xy(clat, clon)
                cr.save()
                cr.translate(csx, csy)
                cr.rotate(-0.42)
                cr.scale(95.0 * zoom_f, 34.0 * zoom_f)
                cr.arc(0, 0, 1.0, 0, 2 * math.pi)
                cr.restore()
                if "ir13" in goes_key:
                    cr.set_source_rgba(0.22, 0.82, 0.96, 0.30)
                elif "wv09" in goes_key:
                    cr.set_source_rgba(0.36, 0.96, 0.82, 0.28)
                else:
                    cr.set_source_rgba(0.90, 0.95, 1.0, 0.32)
                cr.fill()

            # Crisp NOAA Cyan/Gold Geopolitical State Outlines (classic NESDIS sector map overlay)
            cr.set_line_width(1.3)
            cr.set_source_rgba(0.96, 0.82, 0.34, 0.80)
            for poly in US_BORDER_POLYLINES:
                for i, (lo, la) in enumerate(poly):
                    sx, sy = sec_xy(la, lo)
                    if i == 0:
                        cr.move_to(sx, sy)
                    else:
                        cr.line_to(sx, sy)
                cr.stroke()

            qx, qy = sec_xy(float(cfg.get("lat", DEFAULT_LAT)), float(cfg.get("lon", DEFAULT_LON)))
            cr.set_source_rgb(0.32, 0.98, 0.84)
            cr.arc(qx, qy, 4.0, 0, 2 * math.pi)
            cr.fill()
            cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(8.8)
            cr.move_to(qx + 7, qy + 3)
            cr.show_text(f"{cfg.get('callsign', DEFAULT_CALLSIGN)} ({cfg.get('grid', DEFAULT_GRID)})")

        cr.restore()
        src_badge = "OFFLINE SECTOR SYNTHESIS"

    # Top VFD Header
    cr.rectangle(8, 8, W - 16, 24)
    cr.set_source_rgba(0.02, 0.07, 0.08, 0.88)
    cr.fill()
    cr.set_line_width(1.0)
    cr.set_source_rgba(0.26, 0.64, 0.58, 0.75)
    cr.rectangle(8, 8, W - 16, 24)
    cr.stroke()

    cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(9.0)
    cr.set_source_rgb(0.32, 0.98, 0.84)
    cr.move_to(15, 23)
    cr.show_text(f"{lbl}  |  ZOOM {zoom_f:.1f}x")

    ext = cr.text_extents(src_badge)
    cr.set_source_rgb(1.0, 0.76, 0.26)
    cr.move_to(W - ext.width - 15, 23)
    cr.show_text(src_badge)


def render_view_hf_solar_desk(
    cr: cairo.Context, W: float, H: float, solar: dict[str, Any]
):
    """Render NOAA SWPC 6h GOES X-Ray Flux chart, Planetary Kp bars, Telemetry & HF Band Matrix."""
    cr.rectangle(0, 0, W, H)
    cr.set_source_rgb(0.03, 0.06, 0.08)
    cr.fill()

    cond = solar["cond"]
    cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)

    # 1. Top VFD Telemetry Strip
    cr.rectangle(8, 7, W - 16, 42)
    cr.set_source_rgb(0.02, 0.08, 0.08)
    cr.fill()
    cr.set_line_width(1.2)
    cr.set_source_rgb(0.24, 0.58, 0.54)
    cr.rectangle(8, 7, W - 16, 42)
    cr.stroke()

    metrics = [
        ("10.7cm SFI", f"{solar['sfi']:.0f}", (0.34, 0.99, 0.84)),
        ("SUNSPOTS", f"{int(solar['ssn'])}", (0.52, 0.96, 0.74)),
        ("A-INDEX", f"{solar['a_index']:.0f}", (0.98, 0.84, 0.32)),
        ("PLANETARY Kp", f"{solar['kp']:.2f}", (0.36, 0.96, 0.52) if solar["kp"] < 4.0 else (1.0, 0.52, 0.24)),
        ("GOES X-RAY", f"{cond['xray_class']}", (1.0, 0.76, 0.24)),
        ("SOLAR WIND", f"{solar['solar_wind_kms']:.0f} km/s", (0.56, 0.88, 0.98)),
        ("IMF Bz", f"{solar['bz_nt']:+.1f} nT", (1.0, 0.42, 0.42) if solar["bz_nt"] <= -5.0 else (0.48, 0.96, 0.78)),
    ]
    cell_w = (W - 28.0) / len(metrics)
    for i, (mlbl, mval, mcol) in enumerate(metrics):
        mx = 16.0 + i * cell_w
        cr.set_font_size(7.6)
        cr.set_source_rgb(0.46, 0.74, 0.70)
        cr.move_to(mx, 20)
        cr.show_text(mlbl)
        cr.set_font_size(12.0)
        cr.set_source_rgb(*mcol)
        cr.move_to(mx, 39)
        cr.show_text(mval)

    # Split main area: Left 54% = X-Ray Log Chart (top) + Kp Bar Graph (bottom); Right 46% = HF Matrix
    top_y = 56.0
    avail_h = H - top_y - 8.0
    left_w = max(310.0, (W - 24.0) * 0.54)
    right_x = 16.0 + left_w
    right_w = W - right_x - 8.0

    xr_h = avail_h * 0.56
    kp_y = top_y + xr_h + 7.0
    kp_h = avail_h - xr_h - 7.0

    # ---- 2. 6-Hour GOES X-Ray Flare Flux Logarithmic Chart (A / B / C / M / X) ----
    cr.rectangle(8, top_y, left_w, xr_h)
    cr.set_source_rgb(0.02, 0.05, 0.07)
    cr.fill()
    cr.set_source_rgb(0.22, 0.46, 0.52)
    cr.set_line_width(1.0)
    cr.rectangle(8, top_y, left_w, xr_h)
    cr.stroke()

    cr.set_font_size(8.6)
    cr.set_source_rgb(0.45, 0.96, 0.86)
    cr.move_to(15, top_y + 14)
    cr.show_text("GOES PRIMARY X-RAY FLUX (6-HR LOG W/m²)")
    r_code, r_txt = cond["r_scale"]
    r_badge = f"{r_code} {r_txt}  PEAK {format_xray_class(solar['xray_peak'])}"
    rext = cr.text_extents(r_badge)
    cr.set_source_rgb(1.0, 0.45, 0.35) if r_code != "R0" else cr.set_source_rgb(0.42, 0.88, 0.68)
    cr.move_to(8 + left_w - rext.width - 8, top_y + 14)
    cr.show_text(r_badge)

    gx0, gy0 = 42.0, top_y + 22.0
    gw, gh = left_w - 58.0, xr_h - 36.0
    log_min, log_max = -9.0, -3.0  # 10^-9 to 10^-3 W/m^2

    def flux_to_y(fl: float) -> float:
        lv = max(log_min, min(log_max, math.log10(max(1e-9, fl))))
        return gy0 + gh * (1.0 - (lv - log_min) / (log_max - log_min))

    flare_classes = [
        (-8.0, "A", (0.28, 0.68, 0.52)),
        (-7.0, "B", (0.34, 0.82, 0.58)),
        (-6.0, "C", (0.94, 0.84, 0.26)),
        (-5.0, "M", (0.98, 0.52, 0.18)),
        (-4.0, "X", (0.98, 0.22, 0.24)),
    ]
    cr.set_font_size(7.8)
    for exp_v, cls_lbl, ccol in flare_classes:
        yy = gy0 + gh * (1.0 - (exp_v - log_min) / (log_max - log_min))
        cr.set_line_width(0.8)
        cr.set_source_rgba(ccol[0], ccol[1], ccol[2], 0.34)
        cr.move_to(gx0, yy)
        cr.line_to(gx0 + gw, yy)
        cr.stroke()
        cr.set_source_rgb(0.56, 0.72, 0.78)
        cr.move_to(12, yy + 3)
        cr.show_text(f"1e{int(exp_v)}")
        cr.set_source_rgb(*ccol)
        cr.move_to(gx0 + gw + 4, yy + 3)
        cr.show_text(cls_lbl)

    xr_long = solar.get("xray_long") or []
    xr_short = solar.get("xray_short") or []
    if len(xr_long) >= 2:
        t0, t1 = xr_long[0][0], max(xr_long[0][0] + 1.0, xr_long[-1][0])
        if len(xr_short) >= 2:
            cr.set_line_width(1.2)
            cr.set_source_rgba(0.42, 0.64, 1.0, 0.78)
            for i, (ts, fv) in enumerate(xr_short):
                px = gx0 + ((ts - t0) / (t1 - t0)) * gw
                py = flux_to_y(fv)
                if i == 0:
                    cr.move_to(px, py)
                else:
                    cr.line_to(px, py)
            cr.stroke()

        # Glowing primary 0.1-0.8nm curve
        cr.set_line_width(2.0)
        cr.set_source_rgb(1.0, 0.66, 0.20)
        for i, (ts, fv) in enumerate(xr_long):
            px = gx0 + ((ts - t0) / (t1 - t0)) * gw
            py = flux_to_y(fv)
            if i == 0:
                cr.move_to(px, py)
            else:
                cr.line_to(px, py)
        cr.stroke()

        # Time axis ticks (-6h .. NOW)
        cr.set_font_size(7.4)
        cr.set_source_rgb(0.52, 0.72, 0.76)
        for frac in (0.0, 0.33, 0.67, 1.0):
            ts_tick = t0 + frac * (t1 - t0)
            lbl_t = datetime.datetime.fromtimestamp(ts_tick, tz=datetime.timezone.utc).strftime("%H:%MZ")
            tx = gx0 + frac * gw
            cr.move_to(max(gx0, min(gx0 + gw - 34, tx - 14)), gy0 + gh + 11)
            cr.show_text(lbl_t)

    # ---- 3. Planetary Kp 3-Hour Geomagnetic Bar Graph ----
    cr.rectangle(8, kp_y, left_w, kp_h)
    cr.set_source_rgb(0.02, 0.05, 0.07)
    cr.fill()
    cr.set_source_rgb(0.22, 0.46, 0.52)
    cr.set_line_width(1.0)
    cr.rectangle(8, kp_y, left_w, kp_h)
    cr.stroke()

    cr.set_font_size(8.6)
    cr.set_source_rgb(0.45, 0.96, 0.86)
    cr.move_to(15, kp_y + 14)
    cr.show_text("PLANETARY Kp 3-HR GEOMAGNETIC INDEX")
    g_code, g_txt = cond["g_scale"]
    g_badge = f"{g_code} {g_txt}"
    gext = cr.text_extents(g_badge)
    cr.set_source_rgb(0.38, 0.95, 0.58) if g_code == "G0" else cr.set_source_rgb(1.0, 0.48, 0.24)
    cr.move_to(8 + left_w - gext.width - 8, kp_y + 14)
    cr.show_text(g_badge)

    bx0, by0 = 32.0, kp_y + 22.0
    bw_tot, bh_tot = left_w - 42.0, kp_h - 36.0
    for kv_ref in (3, 5, 7, 9):
        yy = by0 + bh_tot * (1.0 - kv_ref / 9.0)
        cr.set_line_width(0.7)
        cr.set_source_rgba(0.35, 0.55, 0.62, 0.35)
        cr.move_to(bx0, yy)
        cr.line_to(bx0 + bw_tot, yy)
        cr.stroke()
        cr.set_font_size(7.4)
        cr.set_source_rgb(0.58, 0.74, 0.80)
        cr.move_to(14, yy + 3)
        cr.show_text(f"K{kv_ref}")

    kp_bars = solar.get("kp_bars") or []
    if kp_bars:
        slot_w = bw_tot / len(kp_bars)
        for i, (klbl, kval) in enumerate(kp_bars):
            kv_c = max(0.2, min(9.0, float(kval)))
            bh = (kv_c / 9.0) * bh_tot
            sx = bx0 + i * slot_w + 4.0
            sw = max(8.0, slot_w - 8.0)
            sy = by0 + bh_tot - bh
            if kv_c < 4.0:
                bcol = (0.18, 0.86, 0.44)
            elif kv_c < 5.0:
                bcol = (0.96, 0.84, 0.20)
            elif kv_c < 6.0:
                bcol = (0.98, 0.52, 0.16)
            else:
                bcol = (0.96, 0.20, 0.24)
            cr.rectangle(sx, sy, sw, bh)
            cr.set_source_rgb(*bcol)
            cr.fill()

            cr.set_font_size(7.5)
            cr.set_source_rgb(0.90, 0.96, 0.98)
            cr.move_to(sx + 1, max(by0 + 8, sy - 3))
            cr.show_text(f"{kval:.1f}")
            if i % 2 == 0 or i == len(kp_bars) - 1:
                cr.set_font_size(7.0)
                cr.set_source_rgb(0.55, 0.74, 0.78)
                cr.move_to(sx - 2, by0 + bh_tot + 10)
                cr.show_text(klbl[:5])

    # ---- 4. Right Pane: HF Amateur Band Condition Matrix (80m..6m) + VHF ----
    cr.rectangle(right_x, top_y, right_w, avail_h)
    cr.set_source_rgb(0.02, 0.05, 0.07)
    cr.fill()
    cr.set_source_rgb(0.22, 0.46, 0.52)
    cr.set_line_width(1.0)
    cr.rectangle(right_x, top_y, right_w, avail_h)
    cr.stroke()

    cr.set_font_size(8.8)
    cr.set_source_rgb(0.45, 0.96, 0.86)
    cr.move_to(right_x + 10, top_y + 15)
    cr.show_text("HF AMATEUR BAND CONDITIONS")

    # Column Headers
    hdr_y = top_y + 31.0
    col_day_x = right_x + right_w * 0.46
    col_nit_x = right_x + right_w * 0.73
    cr.set_font_size(7.8)
    cr.set_source_rgb(0.62, 0.80, 0.84)
    cr.move_to(right_x + 10, hdr_y)
    cr.show_text("BAND / MHz")
    cr.move_to(col_day_x + 8, hdr_y)
    cr.show_text("DAY")
    cr.move_to(col_nit_x + 4, hdr_y)
    cr.show_text("NIGHT")

    pill_colors = {
        "GOOD": ((0.10, 0.44, 0.26), (0.38, 1.00, 0.66)),
        "FAIR": ((0.46, 0.34, 0.08), (1.00, 0.82, 0.28)),
        "POOR": ((0.44, 0.12, 0.14), (1.00, 0.44, 0.46)),
    }

    bands = cond["bands"]
    matrix_h = avail_h - 92.0
    row_h = max(21.0, matrix_h / max(1, len(bands)))
    pill_w = max(46.0, right_w * 0.22)

    for idx, brow in enumerate(bands):
        ry = hdr_y + 6.0 + idx * row_h
        if idx % 2 == 0:
            cr.rectangle(right_x + 4, ry, right_w - 8, row_h - 1)
            cr.set_source_rgba(0.08, 0.15, 0.18, 0.45)
            cr.fill()

        cr.set_font_size(9.0)
        cr.set_source_rgb(0.88, 0.95, 0.98)
        cr.move_to(right_x + 10, ry + row_h * 0.68)
        cr.show_text(f"{brow['band']:>3s}")
        cr.set_font_size(7.5)
        cr.set_source_rgb(0.48, 0.68, 0.74)
        cr.move_to(right_x + 44, ry + row_h * 0.68)
        cr.show_text(brow["freq"])

        for px_col, st_val in ((col_day_x, brow["day"]), (col_nit_x, brow["night"])):
            bg_c, fg_c = pill_colors.get(st_val, pill_colors["FAIR"])
            cr.rectangle(px_col, ry + 2.0, pill_w, row_h - 5.0)
            cr.set_source_rgb(*bg_c)
            cr.fill_preserve()
            cr.set_line_width(1.0)
            cr.set_source_rgba(fg_c[0], fg_c[1], fg_c[2], 0.65)
            cr.stroke()
            cr.set_font_size(8.2)
            cr.set_source_rgb(*fg_c)
            ext = cr.text_extents(st_val)
            cr.move_to(px_col + (pill_w - ext.width) * 0.5, ry + row_h * 0.68)
            cr.show_text(st_val)

    # VHF Propagation Box at bottom of Right Pane
    vy0 = hdr_y + 10.0 + len(bands) * row_h
    vh_box = max(38.0, top_y + avail_h - vy0 - 6.0)
    cr.rectangle(right_x + 6, vy0, right_w - 12, vh_box)
    cr.set_source_rgb(0.04, 0.10, 0.12)
    cr.fill()
    cr.set_source_rgba(0.28, 0.62, 0.60, 0.6)
    cr.set_line_width(1.0)
    cr.rectangle(right_x + 6, vy0, right_w - 12, vh_box)
    cr.stroke()

    cr.set_font_size(8.0)
    cr.set_source_rgb(0.46, 0.96, 0.84)
    cr.move_to(right_x + 12, vy0 + 13)
    cr.show_text(f"VHF AURORA : {cond['vhf_aurora']}")
    cr.set_source_rgb(1.0, 0.80, 0.32)
    cr.move_to(right_x + 12, vy0 + 27)
    cr.show_text(f"6m/2m E-SKIP: {cond['vhf_eskip']}")
    cr.set_font_size(7.2)
    cr.set_source_rgb(0.52, 0.72, 0.76)
    cr.move_to(right_x + 12, vy0 + min(vh_box - 4.0, 40.0))
    cr.show_text(f"FEED: {solar.get('source', 'SWPC')} ({solar.get('updated_utc', '')})")


# ---------------------------------------------------------------------------
# 3 Warm Backlit Analog Weather Instruments Renderer
# (1. BAROMETER inHg/hPa, 2. WIND COMPASS & KT/MPH, 3. TEMP / DEWPOINT / RH%)
# ---------------------------------------------------------------------------
def _draw_incandescent_dial_face(cr: cairo.Context, cx: float, cy: float, r: float):
    # Machined outer brass/charcoal bezel
    cr.arc(cx, cy, r + 4.5, 0, 2 * math.pi)
    cr.set_source_rgb(0.08, 0.09, 0.12)
    cr.fill()

    rim = cairo.LinearGradient(cx - r, cy - r, cx + r, cy + r)
    rim.add_color_stop_rgb(0.0, 0.68, 0.60, 0.42)
    rim.add_color_stop_rgb(0.5, 0.34, 0.31, 0.25)
    rim.add_color_stop_rgb(1.0, 0.54, 0.47, 0.32)
    cr.arc(cx, cy, r + 2.2, 0, 2 * math.pi)
    cr.set_source(rim)
    cr.fill()

    # Warm incandescent cream radial lamp face
    glow = cairo.RadialGradient(cx, cy + r * 0.25, r * 0.08, cx, cy, r * 1.05)
    glow.add_color_stop_rgb(0.0, 1.00, 0.95, 0.78)
    glow.add_color_stop_rgb(0.68, 0.96, 0.86, 0.58)
    glow.add_color_stop_rgb(1.0, 0.82, 0.68, 0.39)
    cr.arc(cx, cy, r, 0, 2 * math.pi)
    cr.set_source(glow)
    cr.fill()


def _draw_vfd_box(cr: cairo.Context, x: float, y: float, w: float, h: float):
    cr.rectangle(x, y, w, h)
    cr.set_source_rgb(0.03, 0.08, 0.08)
    cr.fill()
    cr.set_line_width(1.5)
    cr.set_source_rgb(0.01, 0.03, 0.03)
    cr.move_to(x, y + h)
    cr.line_to(x, y)
    cr.line_to(x + w, y)
    cr.stroke()
    cr.set_source_rgb(0.32, 0.38, 0.46)
    cr.move_to(x, y + h)
    cr.line_to(x + w, y + h)
    cr.line_to(x + w, y)
    cr.stroke()


def render_weather_instrument_cluster(
    cr: cairo.Context,
    W: float,
    H: float,
    metar: dict[str, Any],
    anim_baro_inhg: float,
    anim_wind_deg: float,
    anim_temp_f: float,
    anim_dew_f: float,
):
    cr.rectangle(0, 0, W, H)
    cr.set_source_rgb(0.16, 0.18, 0.22)
    cr.fill()

    pad = 5.0
    mod_h = (H - pad * 4.0) / 3.0
    mod_w = W - pad * 2.0
    cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)

    # =========================================================================
    # MODULE 1: BAROMETER (28.5 .. 31.0 inHg + hPa, STORM / CHANGE / FAIR)
    # =========================================================================
    y0 = pad
    cr.rectangle(pad, y0, mod_w, mod_h)
    cr.set_source_rgb(0.11, 0.13, 0.16)
    cr.fill()
    cr.set_line_width(1.2)
    cr.set_source_rgb(0.35, 0.39, 0.48)
    cr.rectangle(pad, y0, mod_w, mod_h)
    cr.stroke()

    r = min((mod_h - 18.0) * 0.5, 62.0)
    cx = pad + r + 10.0
    cy = y0 + mod_h * 0.5 + 1.0
    _draw_incandescent_dial_face(cr, cx, cy, r)

    # 28.5 .. 31.0 inHg across 260 degrees (140° .. 400°)
    a_start = math.radians(140.0)
    a_span = math.radians(260.0)

    def baro_ang(inhg: float) -> float:
        frac = max(0.0, min(1.0, (inhg - 28.5) / 2.5))
        return a_start + frac * a_span

    cr.set_line_width(1.8)
    cr.set_source_rgb(0.20, 0.16, 0.10)
    cr.arc(cx, cy, r * 0.80, a_start, a_start + a_span)
    cr.stroke()

    for step_i in range(26):
        val = 28.5 + step_i * 0.1
        ang = baro_ang(val)
        is_maj = (step_i % 5 == 0)
        r_in = r * (0.68 if is_maj else 0.74)
        cr.set_line_width(1.6 if is_maj else 0.9)
        cr.set_source_rgb(0.18, 0.14, 0.08)
        cr.move_to(cx + r_in * math.cos(ang), cy + r_in * math.sin(ang))
        cr.line_to(cx + r * 0.82 * math.cos(ang), cy + r * 0.82 * math.sin(ang))
        cr.stroke()
        if is_maj:
            cr.set_font_size(7.2)
            lbl = f"{val:.1f}"
            ext = cr.text_extents(lbl)
            tx = cx + r * 0.53 * math.cos(ang)
            ty = cy + r * 0.53 * math.sin(ang)
            cr.move_to(tx - ext.width * 0.5, ty + ext.height * 0.4)
            cr.show_text(lbl)

    # Engraved Brass STORM / CHANGE / FAIR legends
    cr.set_font_size(6.4)
    cr.set_source_rgb(0.58, 0.22, 0.10)
    cr.move_to(cx - r * 0.43, cy + r * 0.18)
    cr.show_text("STORM")
    cr.set_source_rgb(0.46, 0.32, 0.10)
    ext_ch = cr.text_extents("CHANGE")
    cr.move_to(cx - ext_ch.width * 0.5, cy - r * 0.20)
    cr.show_text("CHANGE")
    cr.set_source_rgb(0.14, 0.44, 0.22)
    cr.move_to(cx + r * 0.14, cy + r * 0.18)
    cr.show_text("FAIR")
    cr.set_source_rgb(0.28, 0.22, 0.12)
    ext_u = cr.text_extents("inHg")
    cr.move_to(cx - ext_u.width * 0.5, cy + r * 0.52)
    cr.show_text("inHg")

    # Standard 29.92 gold set-hand + crimson active pressure needle
    ang_std = baro_ang(29.92)
    cr.set_line_width(1.4)
    cr.set_source_rgba(0.76, 0.54, 0.12, 0.85)
    cr.move_to(cx, cy)
    cr.line_to(cx + r * 0.76 * math.cos(ang_std), cy + r * 0.76 * math.sin(ang_std))
    cr.stroke()

    ang_b = baro_ang(anim_baro_inhg)
    cr.set_line_width(2.3)
    cr.set_source_rgb(0.78, 0.12, 0.12)
    cr.move_to(cx - r * 0.16 * math.cos(ang_b), cy - r * 0.16 * math.sin(ang_b))
    cr.line_to(cx + r * 0.82 * math.cos(ang_b), cy + r * 0.82 * math.sin(ang_b))
    cr.stroke()
    cr.arc(cx, cy, 4.5, 0, 2 * math.pi)
    cr.set_source_rgb(0.22, 0.18, 0.14)
    cr.fill()

    # Right VFD Box for Barometer
    vx = cx + r + 10.0
    vw = max(110.0, W - vx - pad - 6.0)
    vy = y0 + 7.0
    vh = mod_h - 14.0
    _draw_vfd_box(cr, vx, vy, vw, vh)

    cr.set_font_size(8.2)
    cr.set_source_rgb(0.46, 0.88, 0.80)
    cr.move_to(vx + 8, vy + 15)
    cr.show_text("BAROMETER / ALTIM")
    cr.set_font_size(18.0)
    cr.set_source_rgb(0.28, 0.99, 0.86)
    cr.move_to(vx + 8, vy + 40)
    cr.show_text(f"{metar['altim_inhg']:05.2f}")
    cr.set_font_size(9.0)
    cr.move_to(vx + 72, vy + 40)
    cr.show_text("inHg")

    cr.set_font_size(11.0)
    cr.set_source_rgb(1.0, 0.76, 0.26)
    cr.move_to(vx + 8, vy + 62)
    cr.show_text(f"{metar['altim_hpa']:.1f} hPa")

    cr.set_font_size(8.5)
    cr.set_source_rgb(0.55, 0.96, 0.78)
    cr.move_to(vx + 8, vy + 82)
    cr.show_text(f"TREND: {metar['tendency']}")
    cr.set_font_size(7.8)
    cr.set_source_rgb(0.44, 0.74, 0.70)
    cr.move_to(vx + 8, vy + min(vh - 6.0, 102.0))
    cr.show_text(f"OBS {metar['station']} {metar['obs_time']}")

    # =========================================================================
    # MODULE 2: WIND COMPASS & KT/MPH (360° Compass Rose + Digital Gust VFD)
    # =========================================================================
    y1 = pad * 2.0 + mod_h
    cr.rectangle(pad, y1, mod_w, mod_h)
    cr.set_source_rgb(0.11, 0.13, 0.16)
    cr.fill()
    cr.set_line_width(1.2)
    cr.set_source_rgb(0.35, 0.39, 0.48)
    cr.rectangle(pad, y1, mod_w, mod_h)
    cr.stroke()

    cy2 = y1 + mod_h * 0.5 + 1.0
    _draw_incandescent_dial_face(cr, cx, cy2, r)

    # 360° Compass Rose (0° North at top = -90° Cairo angle)
    for deg_i in range(0, 360, 15):
        ra = math.radians(deg_i - 90.0)
        is_card = (deg_i % 90 == 0)
        is_inter = (deg_i % 45 == 0)
        r_in = r * (0.68 if is_card else (0.74 if is_inter else 0.80))
        cr.set_line_width(1.8 if is_card else 0.9)
        cr.set_source_rgb(0.76, 0.14, 0.12) if deg_i == 0 else cr.set_source_rgb(0.18, 0.14, 0.08)
        cr.move_to(cx + r_in * math.cos(ra), cy2 + r_in * math.sin(ra))
        cr.line_to(cx + r * 0.86 * math.cos(ra), cy2 + r * 0.86 * math.sin(ra))
        cr.stroke()

    for deg_c, clbl in ((0, "N"), (90, "E"), (180, "S"), (270, "W"), (45, "NE"), (135, "SE"), (225, "SW"), (315, "NW")):
        ra = math.radians(deg_c - 90.0)
        cr.set_font_size(8.8 if len(clbl) == 1 else 6.8)
        cr.set_source_rgb(0.78, 0.12, 0.12) if clbl == "N" else cr.set_source_rgb(0.20, 0.16, 0.10)
        ext = cr.text_extents(clbl)
        rr = r * (0.50 if len(clbl) == 1 else 0.54)
        cr.move_to(cx + rr * math.cos(ra) - ext.width * 0.5, cy2 + rr * math.sin(ra) + ext.height * 0.4)
        cr.show_text(clbl)

    # Directional Wind Arrow Needle
    if metar["wind_kt"] >= 0.5:
        wa = math.radians(anim_wind_deg - 90.0)
        if metar["gust_kt"] > metar["wind_kt"]:
            cr.new_sub_path()
            cr.arc(cx, cy2, r * 0.83, wa - 0.24, wa + 0.24)
            cr.set_line_width(3.0)
            cr.set_source_rgba(0.92, 0.42, 0.12, 0.55)
            cr.stroke()

        tip_x = cx + r * 0.80 * math.cos(wa)
        tip_y = cy2 + r * 0.80 * math.sin(wa)
        tail_x = cx - r * 0.45 * math.cos(wa)
        tail_y = cy2 - r * 0.45 * math.sin(wa)
        cr.set_line_width(2.4)
        cr.set_source_rgb(0.78, 0.12, 0.12)
        cr.move_to(tail_x, tail_y)
        cr.line_to(tip_x, tip_y)
        cr.stroke()
        # Arrowhead
        for side in (-2.55, 2.55):
            cr.move_to(tip_x, tip_y)
            cr.line_to(tip_x + 7.5 * math.cos(wa + side), tip_y + 7.5 * math.sin(wa + side))
            cr.stroke()

    cr.arc(cx, cy2, 4.5, 0, 2 * math.pi)
    cr.set_source_rgb(0.22, 0.18, 0.14)
    cr.fill()

    # Right VFD Box for Wind & Gust
    vy2 = y1 + 7.0
    _draw_vfd_box(cr, vx, vy2, vw, vh)
    cr.set_font_size(8.2)
    cr.set_source_rgb(0.46, 0.88, 0.80)
    cr.move_to(vx + 8, vy2 + 15)
    cr.show_text("WIND COMPASS & GUST")

    wdir_txt = "VRB" if metar["wind_vrb"] else (
        "CALM" if metar["wind_kt"] < 0.5 else f"{int(round(metar['wind_dir'] or 0.0)):03d}° {metar['wind_card']}"
    )
    cr.set_font_size(14.5)
    cr.set_source_rgb(0.28, 0.99, 0.86)
    cr.move_to(vx + 8, vy2 + 37)
    cr.show_text(f"{wdir_txt}")

    cr.set_font_size(12.5)
    cr.set_source_rgb(0.56, 0.98, 0.84)
    cr.move_to(vx + 8, vy2 + 57)
    cr.show_text(f"{metar['wind_kt']:.0f} KT / {metar['wind_mph']:.0f} MPH")

    # Dedicated Digital Gust VFD Pill
    cr.rectangle(vx + 7, vy2 + 65, vw - 14, 22)
    if metar["gust_kt"] > 0.5:
        cr.set_source_rgba(1.0, 0.62, 0.14, 0.22)
        cr.fill()
        cr.set_font_size(10.5)
        cr.set_source_rgb(1.0, 0.76, 0.22)
        cr.move_to(vx + 12, vy2 + 80)
        cr.show_text(f"GUST {metar['gust_kt']:.0f} KT ({metar['gust_mph']:.0f}M)")
    else:
        cr.set_source_rgba(0.16, 0.42, 0.38, 0.22)
        cr.fill()
        cr.set_font_size(9.5)
        cr.set_source_rgb(0.42, 0.84, 0.76)
        cr.move_to(vx + 12, vy2 + 80)
        cr.show_text("NO GUSTS REPORTED")

    cr.set_font_size(7.8)
    cr.set_source_rgb(0.44, 0.74, 0.70)
    cr.move_to(vx + 8, vy2 + min(vh - 6.0, 103.0))
    cr.show_text(f"VIS {metar['vis_sm']:g} SM  {metar['clouds'][0][:10]}")

    # =========================================================================
    # MODULE 3: DUAL-NEEDLE TEMP / DEWPOINT (-20°F .. 110°F) & RH% HYGROMETER
    # =========================================================================
    y2 = pad * 3.0 + mod_h * 2.0
    cr.rectangle(pad, y2, mod_w, mod_h)
    cr.set_source_rgb(0.11, 0.13, 0.16)
    cr.fill()
    cr.set_line_width(1.2)
    cr.set_source_rgb(0.35, 0.39, 0.48)
    cr.rectangle(pad, y2, mod_w, mod_h)
    cr.stroke()

    cy3 = y2 + mod_h * 0.5 + 1.0
    _draw_incandescent_dial_face(cr, cx, cy3, r)

    def temp_ang(tf: float) -> float:
        frac = max(0.0, min(1.0, (tf - (-20.0)) / 130.0))
        return a_start + frac * a_span

    # Freeze arc (-20..32°F) in cobalt blue + warm arc in dark bronze
    a_32 = temp_ang(32.0)
    cr.set_line_width(2.0)
    cr.set_source_rgb(0.14, 0.42, 0.78)
    cr.arc(cx, cy3, r * 0.80, a_start, a_32)
    cr.stroke()
    cr.set_source_rgb(0.22, 0.16, 0.10)
    cr.arc(cx, cy3, r * 0.80, a_32, a_start + a_span)
    cr.stroke()

    for tf_v in range(-20, 115, 10):
        ang = temp_ang(float(tf_v))
        is_maj = (tf_v % 30 == 0 or tf_v == 32)
        r_in = r * (0.68 if is_maj else 0.74)
        cr.set_line_width(1.4 if is_maj else 0.8)
        cr.set_source_rgb(0.18, 0.14, 0.08)
        cr.move_to(cx + r_in * math.cos(ang), cy3 + r_in * math.sin(ang))
        cr.line_to(cx + r * 0.82 * math.cos(ang), cy3 + r * 0.82 * math.sin(ang))
        cr.stroke()
        if tf_v in (-20, 10, 40, 70, 100):
            cr.set_font_size(7.0)
            lbl = f"{tf_v}"
            ext = cr.text_extents(lbl)
            tx = cx + r * 0.52 * math.cos(ang)
            ty = cy3 + r * 0.52 * math.sin(ang)
            cr.move_to(tx - ext.width * 0.5, ty + ext.height * 0.4)
            cr.show_text(lbl)

    # Lower RH% sub-legend on dial face
    cr.set_font_size(7.0)
    cr.set_source_rgb(0.26, 0.20, 0.12)
    rh_lbl = f"RH {metar['rh_pct']:.0f}%"
    ext_rh = cr.text_extents(rh_lbl)
    cr.move_to(cx - ext_rh.width * 0.5, cy3 + r * 0.48)
    cr.show_text(rh_lbl)

    # Needle 1 (Cobalt Blue): Dewpoint °F
    ang_dw = temp_ang(anim_dew_f)
    cr.set_line_width(2.0)
    cr.set_source_rgb(0.10, 0.46, 0.86)
    cr.move_to(cx, cy3)
    cr.line_to(cx + r * 0.74 * math.cos(ang_dw), cy3 + r * 0.74 * math.sin(ang_dw))
    cr.stroke()

    # Needle 2 (Crimson): Air Temperature °F
    ang_tp = temp_ang(anim_temp_f)
    cr.set_line_width(2.4)
    cr.set_source_rgb(0.80, 0.12, 0.12)
    cr.move_to(cx - r * 0.14 * math.cos(ang_tp), cy3 - r * 0.14 * math.sin(ang_tp))
    cr.line_to(cx + r * 0.82 * math.cos(ang_tp), cy3 + r * 0.82 * math.sin(ang_tp))
    cr.stroke()

    cr.arc(cx, cy3, 4.5, 0, 2 * math.pi)
    cr.set_source_rgb(0.22, 0.18, 0.14)
    cr.fill()

    # Right VFD Box for Temp / Dewpoint / RH% + Flight Category
    vy3 = y2 + 7.0
    _draw_vfd_box(cr, vx, vy3, vw, vh)
    cr.set_font_size(8.2)
    cr.set_source_rgb(0.46, 0.88, 0.80)
    cr.move_to(vx + 8, vy3 + 15)
    cr.show_text("TEMP / DEW / RH%")

    cr.set_font_size(13.5)
    cr.set_source_rgb(0.28, 0.99, 0.86)
    cr.move_to(vx + 8, vy3 + 36)
    cr.show_text(f"T {metar['temp_f']:+5.1f}°F ({metar['temp_c']:+.1f}C)")

    cr.set_font_size(11.5)
    cr.set_source_rgb(0.48, 0.84, 1.0)
    cr.move_to(vx + 8, vy3 + 55)
    cr.show_text(f"D {metar['dew_f']:+5.1f}°F ({metar['dew_c']:+.1f}C)")

    cr.set_font_size(11.0)
    cr.set_source_rgb(1.0, 0.78, 0.28)
    cr.move_to(vx + 8, vy3 + 74)
    cr.show_text(f"RH {metar['rh_pct']:.0f}%")

    # FAA Flight Category Jewel Badge
    fcat = metar["flight_cat"]
    cat_cols = {
        "VFR": ((0.10, 0.44, 0.22), (0.38, 1.00, 0.62)),
        "MVFR": ((0.12, 0.28, 0.56), (0.48, 0.82, 1.00)),
        "IFR": ((0.52, 0.12, 0.14), (1.00, 0.42, 0.42)),
        "LIFR": ((0.48, 0.12, 0.48), (1.00, 0.48, 0.96)),
    }
    cbg, cfg_c = cat_cols.get(fcat, cat_cols["VFR"])
    bx_cat = vx + vw - 54.0
    cr.rectangle(bx_cat, vy3 + 60, 46.0, 18.0)
    cr.set_source_rgb(*cbg)
    cr.fill_preserve()
    cr.set_line_width(1.0)
    cr.set_source_rgb(*cfg_c)
    cr.stroke()
    cr.set_font_size(9.5)
    ext_fc = cr.text_extents(fcat)
    cr.move_to(bx_cat + (46.0 - ext_fc.width) * 0.5, vy3 + 73)
    cr.show_text(fcat)

    cr.set_font_size(7.8)
    cr.set_source_rgb(0.48, 0.80, 0.74)
    cr.move_to(vx + 8, vy3 + min(vh - 6.0, 102.0))
    cr.show_text(metar["wx_summary"][:24])


# ---------------------------------------------------------------------------
# Main GTK 3 CDE Window (`DtRadarWindow`)
# ---------------------------------------------------------------------------
class DtRadarWindow(Gtk.Window):
    def __init__(self, self_test: bool = False):
        super().__init__(title="dtRadar — NEXRAD Doppler, GOES Satellite & HF Propagation Console")
        self._self_test = self_test
        self.set_default_size(1120, 660)
        self.set_position(Gtk.WindowPosition.CENTER)

        icon_p = Path(__file__).resolve().parent.parent / "assets" / "icons" / "dtradar.png"
        if icon_p.is_file():
            try:
                self.set_icon_from_file(str(icon_p))
            except Exception:
                pass

        chrome, sel, well = load_cde_palette()
        prov = Gtk.CssProvider()
        prov.load_from_data(build_radar_css(chrome, sel, well))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.cfg = self._load_config()
        self.map_lat = float(self.cfg["lat"])
        self.map_lon = float(self.cfg["lon"])
        self.map_zoom = int(self.cfg.get("map_zoom", 7))
        self.view_mode = int(self.cfg.get("view_mode", 0))

        # Animation & viewport pan/zoom state
        self.loop_playing = bool(self.cfg.get("loop_playing", True))
        self.frame_idx = 5
        self.sweep_deg = -35.0
        self._last_loop_step = time.monotonic()
        self._dragging = False
        self._drag_last = (0.0, 0.0)
        self._hover_latlon: tuple[float, float] | None = None
        self.ridge_zoom = 1.0
        self.ridge_pan = (0.0, 0.0)
        self.sat_zoom = 1.0
        self.sat_pan = (0.0, 0.0)
        self._updating_scrubber = False

        # Ballistic analog instrument needles
        self.anim_baro = 30.04
        self.anim_wind_deg = 230.0
        self.anim_temp_f = 47.0
        self.anim_dew_f = 27.0

        self.engine = RadarDataEngine(on_update_cb=self._on_engine_updated)

        self._build_ui()
        self._sync_view_buttons()
        self._refresh_teletype()

        # 30 FPS PPI sweep + ballistic needles + radar loop timer
        GLib.timeout_add(33, self._on_tick_30fps)
        # Periodic 4-minute auto-refresh timer
        GLib.timeout_add_seconds(240, self._on_periodic_refresh)

        self.connect("destroy", self._on_destroy)

        if self._self_test:
            GLib.timeout_add(220, self._step_gtk_self_test, 0)
        else:
            GLib.idle_add(self._trigger_live_fetches, False)

    # ---- Config Persistence ----
    def _load_config(self) -> dict[str, Any]:
        cfg = {
            "callsign": DEFAULT_CALLSIGN,
            "grid": DEFAULT_GRID,
            "lat": DEFAULT_LAT,
            "lon": DEFAULT_LON,
            "nexrad_site": DEFAULT_NEXRAD,
            "metar_id": DEFAULT_METAR,
            "goes_key": DEFAULT_GOES_KEY,
            "view_mode": 0,
            "map_zoom": 7,
