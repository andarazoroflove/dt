    "SQ": "Squalls",
}


def compute_relative_humidity(temp_c: float, dew_c: float) -> float:
    try:
        es = math.exp((17.625 * temp_c) / (243.04 + temp_c))
        ed = math.exp((17.625 * dew_c) / (243.04 + dew_c))
        return max(2.0, min(100.0, 100.0 * (ed / es)))
    except Exception:
        return 50.0


def cardinal_from_deg(deg: float | None) -> str:
    if deg is None:
        return "VRB"
    dirs = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE",
            "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]
    return dirs[int(((deg % 360.0) + 11.25) // 22.5) % 16]


def parse_metar_raw(raw_metar: str, fallback_station: str = DEFAULT_METAR) -> dict[str, Any]:
    """Parse raw ICAO/ASOS METAR string into complete numeric + decoded weather dictionary."""
    txt = (raw_metar or "").strip()
    tokens = txt.split()
    station = fallback_station.upper()
    obs_time = "--:--Z"
    idx = 0
    if tokens and tokens[0] in ("METAR", "SPECI"):
        idx = 1
    if idx < len(tokens) and re.match(r"^[A-Z0-9]{4}$", tokens[idx]):
        station = tokens[idx]
        idx += 1
    if idx < len(tokens) and re.match(r"^\d{6}Z$", tokens[idx]):
        obs_time = tokens[idx]
        idx += 1

    # Wind
    wind_dir: float | None = 0.0
    wind_vrb = False
    wind_kt = 0.0
    gust_kt = 0.0
    m_wind = re.search(r"\b(VRB|\d{3})(\d{2,3})(?:G(\d{2,3}))?(KT|MPS)\b", txt)
    if m_wind:
        d_s, spd_s, gst_s, unit = m_wind.groups()
        factor = 1.94384 if unit == "MPS" else 1.0
        wind_kt = float(spd_s) * factor
        gust_kt = float(gst_s) * factor if gst_s else 0.0
        if d_s == "VRB":
            wind_dir = None
            wind_vrb = True
        else:
            wind_dir = float(d_s)

    # Visibility (statute miles)
    vis_sm = 10.0
    m_vis_frac = re.search(r"\b(\d+)\s+(\d+)/(\d+)SM\b", txt)
    m_vis_only_frac = re.search(r"(?<!\d\s)\b(\d+)/(\d+)SM\b", txt)
    m_vis_whole = re.search(r"\b(P?)(\d+)SM\b", txt)
    if m_vis_frac:
        vis_sm = float(m_vis_frac.group(1)) + float(m_vis_frac.group(2)) / max(1.0, float(m_vis_frac.group(3)))
    elif m_vis_only_frac:
        vis_sm = float(m_vis_only_frac.group(1)) / max(1.0, float(m_vis_only_frac.group(2)))
    elif m_vis_whole:
        vis_sm = float(m_vis_whole.group(2))
    elif re.search(r"\b9999\b", txt) or "CAVOK" in tokens:
        vis_sm = 10.0

    # Sky clouds & ceiling
    clouds: list[str] = []
    ceiling_ft: int | None = None
    for tok in tokens:
        if tok == "RMK":
            break
        if tok in ("CLR", "SKC", "CAVOK", "NCD"):
            clouds.append(tok)
        else:
            mc = re.match(r"^(FEW|SCT|BKN|OVC|VV)(\d{3})(CB|TCU)?$", tok)
            if mc:
                cov, h_s, cb = mc.groups()
                ft = int(h_s) * 100
                clouds.append(f"{cov} {ft:,}ft{(' ' + cb) if cb else ''}")
                if cov in ("BKN", "OVC", "VV") and (ceiling_ft is None or ft < ceiling_ft):
                    ceiling_ft = ft
            elif tok in WX_CODES_MAP:
                pass

    wx_list: list[str] = []
    for tok in tokens:
        if tok == "RMK":
            break
        if tok in WX_CODES_MAP:
            wx_list.append(WX_CODES_MAP[tok])

    # Temperature & Dewpoint (check T-group tenths in RMK first, then standard 09/M02)
    temp_c = 8.9
    dew_c = -2.2
    m_td = re.search(r"\b(M?\d{2})/(M?\d{2})\b", txt)
    if m_td:
        ts, ds = m_td.groups()
        temp_c = -float(ts[1:]) if ts.startswith("M") else float(ts)
        dew_c = -float(ds[1:]) if ds.startswith("M") else float(ds)
    m_rmk_t = re.search(r"\bT([01])(\d{3})([01])(\d{3})\b", txt)
    if m_rmk_t:
        s1, v1, s2, v2 = m_rmk_t.groups()
        temp_c = (-1.0 if s1 == "1" else 1.0) * (int(v1) / 10.0)
        dew_c = (-1.0 if s2 == "1" else 1.0) * (int(v2) / 10.0)

    # Altimeter (inHg & hPa)
    altim_inhg = 29.92
    altim_hpa = 1013.25
    m_alt_a = re.search(r"\bA(\d{4})\b", txt)
    m_alt_q = re.search(r"\bQ(\d{4})\b", txt)
    if m_alt_a:
        altim_inhg = int(m_alt_a.group(1)) / 100.0
        altim_hpa = altim_inhg * 33.8638866667
    elif m_alt_q:
        altim_hpa = float(m_alt_q.group(1))
        altim_inhg = altim_hpa / 33.8638866667

    # 3-hour pressure tendency 5aPPP
    tendency = "STEADY"
    m_tend = re.search(r"\b5([0-8])(\d{3})\b", txt)
    if m_tend:
        code = int(m_tend.group(1))
        chg_hpa = int(m_tend.group(2)) / 10.0
        if code in (0, 1, 2, 3) and chg_hpa >= 0.3:
            tendency = f"▲ +{chg_hpa:.1f} hPa"
        elif code in (5, 6, 7, 8) and chg_hpa >= 0.3:
            tendency = f"▼ -{chg_hpa:.1f} hPa"

    # FAA Flight Category
    c_chk = ceiling_ft if ceiling_ft is not None else 99999
    if c_chk < 500 or vis_sm < 1.0:
        flt_cat = "LIFR"
    elif c_chk < 1000 or vis_sm < 3.0:
        flt_cat = "IFR"
    elif c_chk <= 3000 or vis_sm <= 5.0:
        flt_cat = "MVFR"
    else:
        flt_cat = "VFR"

    temp_f = temp_c * 9.0 / 5.0 + 32.0
    dew_f = dew_c * 9.0 / 5.0 + 32.0
    rh_pct = compute_relative_humidity(temp_c, dew_c)
    wind_mph = wind_kt * 1.15078
    gust_mph = gust_kt * 1.15078

    return {
        "station": station,
        "obs_time": obs_time,
        "raw_metar": txt,
        "raw_taf": "",
        "temp_c": round(temp_c, 1),
        "temp_f": round(temp_f, 1),
        "dew_c": round(dew_c, 1),
        "dew_f": round(dew_f, 1),
        "rh_pct": round(rh_pct, 1),
        "wind_dir": wind_dir,
        "wind_vrb": wind_vrb,
        "wind_card": "CALM" if wind_kt < 0.5 else cardinal_from_deg(wind_dir),
        "wind_kt": round(wind_kt, 1),
        "gust_kt": round(gust_kt, 1),
        "wind_mph": round(wind_mph, 1),
        "gust_mph": round(gust_mph, 1),
        "vis_sm": round(vis_sm, 2),
        "clouds": clouds if clouds else ["CLR"],
        "ceiling_ft": ceiling_ft,
        "wx_summary": ", ".join(wx_list) if wx_list else ("Clear / Fair" if not clouds or clouds == ["CLR"] else "Fair"),
        "altim_inhg": round(altim_inhg, 2),
        "altim_hpa": round(altim_hpa, 1),
        "tendency": tendency,
        "flight_cat": flt_cat,
        "source": "PARSED",
    }


