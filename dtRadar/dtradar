# ---------------------------------------------------------------------------
# Geodesy, Maidenhead Grid & Web Mercator Tile Math
# ---------------------------------------------------------------------------
def grid_to_latlon(grid: str) -> tuple[float, float] | None:
    g = grid.strip()
    if len(g) < 4:
        return None
    g_up = g[:2].upper()
    if not ("A" <= g_up[0] <= "R" and "A" <= g_up[1] <= "R"):
        return None
    if not (g[2:4].isdigit()):
        return None
    lon = -180.0 + (ord(g_up[0]) - ord("A")) * 20.0 + int(g[2]) * 2.0
    lat = -90.0 + (ord(g_up[1]) - ord("A")) * 10.0 + int(g[3]) * 1.0
    if len(g) >= 6 and g[4:6].isalpha():
        sub_x = ord(g[4].lower()) - ord("a")
        sub_y = ord(g[5].lower()) - ord("a")
        if 0 <= sub_x < 24 and 0 <= sub_y < 24:
            lon += (sub_x + 0.5) * (2.0 / 24.0)
            lat += (sub_y + 0.5) * (1.0 / 24.0)
            return (lat, lon)
    return (lat + 0.5, lon + 1.0)


def latlon_to_grid(lat: float, lon: float) -> str:
    lon_n = ((lon + 180.0) % 360.0)
    lat_n = max(0.0, min(179.9999, lat + 90.0))
    f_lon = int(lon_n // 20.0)
    f_lat = int(lat_n // 10.0)
    rem_lon = lon_n - f_lon * 20.0
    rem_lat = lat_n - f_lat * 10.0
    s_lon = int(rem_lon // 2.0)
    s_lat = int(rem_lat // 1.0)
    sub_lon = int((rem_lon - s_lon * 2.0) * 12.0)
    sub_lat = int((rem_lat - s_lat * 1.0) * 24.0)
    return (
        f"{chr(ord('A') + f_lon)}{chr(ord('A') + f_lat)}"
        f"{s_lon}{s_lat}"
        f"{chr(ord('a') + max(0, min(23, sub_lon)))}"
        f"{chr(ord('a') + max(0, min(23, sub_lat)))}"
    )


def latlon_to_world_px(lat: float, lon: float, zoom: float) -> tuple[float, float]:
    scale = TILE_SIZE * (2.0 ** zoom)
    x = ((lon + 180.0) / 360.0) * scale
    lat_c = max(-85.05112878, min(85.05112878, lat))
    sin_lat = math.sin(math.radians(lat_c))
    y = (0.5 - math.log((1.0 + sin_lat) / (1.0 - sin_lat)) / (4.0 * math.pi)) * scale
    return (x, y)


def world_px_to_latlon(wx: float, wy: float, zoom: float) -> tuple[float, float]:
    scale = TILE_SIZE * (2.0 ** zoom)
    lon = ((wx / scale) * 360.0 - 180.0 + 180.0) % 360.0 - 180.0
    n = math.pi - 2.0 * math.pi * max(0.0, min(1.0, wy / scale))
    lat = math.degrees(math.atan(math.sinh(n)))
    return (lat, lon)


def latlon_to_tile_xy(lat: float, lon: float, z: int) -> tuple[int, int]:
    wx, wy = latlon_to_world_px(lat, lon, float(z))
    n = 1 << z
    tx = int(wx // TILE_SIZE) % n
    ty = max(0, min(n - 1, int(wy // TILE_SIZE)))
    return (tx, ty)


def dest_latlon_km(lat: float, lon: float, bearing_deg: float, dist_km: float) -> tuple[float, float]:
    ang_d = dist_km / EARTH_RADIUS_KM
    brg = math.radians(bearing_deg)
    lat1 = math.radians(lat)
    lon1 = math.radians(lon)
    sin_lat2 = math.sin(lat1) * math.cos(ang_d) + math.cos(lat1) * math.sin(ang_d) * math.cos(brg)
    lat2 = math.asin(max(-1.0, min(1.0, sin_lat2)))
    y = math.sin(brg) * math.sin(ang_d) * math.cos(lat1)
    x = math.cos(ang_d) - math.sin(lat1) * math.sin(lat2)
    lon2 = lon1 + math.atan2(y, x)
    lon_deg = ((math.degrees(lon2) + 180.0) % 360.0) - 180.0
    return (math.degrees(lat2), lon_deg)


def haversine_bearing_km(lat1: float, lon1: float, lat2: float, lon2: float) -> tuple[float, float]:
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dp = math.radians(lat2 - lat1)
    dl = math.radians(lon2 - lon1)
    a = math.sin(dp * 0.5) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl * 0.5) ** 2
    dist_km = 2.0 * EARTH_RADIUS_KM * math.asin(min(1.0, math.sqrt(a)))
    y = math.sin(dl) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
    brg = (math.degrees(math.atan2(y, x)) + 360.0) % 360.0
    return (dist_km, brg)


# ---------------------------------------------------------------------------
# Cairo Surface Conversion & Dark Tactical Map LUT
# ---------------------------------------------------------------------------
def apply_dark_tactical_lut(rgb_arr: np.ndarray) -> np.ndarray:
    f = rgb_arr.astype(np.float32)
    r, g, b = f[:, :, 0], f[:, :, 1], f[:, :, 2]
    lum = 0.299 * r + 0.587 * g + 0.114 * b
    is_water = (b > r + 14.0) & (b > g - 6.0) & (b > 110.0)
    inv = 255.0 - lum
    nr = np.clip(18.0 + inv * 0.24, 12.0, 86.0)
    ng = np.clip(26.0 + inv * 0.32, 18.0, 112.0)
    nb = np.clip(37.0 + inv * 0.43, 25.0, 146.0)
    nr = np.where(is_water, 9.0 + (255.0 - b) * 0.04, nr)
    ng = np.where(is_water, 18.0 + (255.0 - b) * 0.06, ng)
    nb = np.where(is_water, 31.0 + (255.0 - b) * 0.10, nb)
    return np.stack([nr, ng, nb], axis=-1).astype(np.uint8)


def rgb_to_cairo_surface(rgb_arr: np.ndarray) -> cairo.ImageSurface:
    h, w, _ = rgb_arr.shape
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
    bgra = np.empty((h, w, 4), dtype=np.uint8)
    bgra[:, :, 0] = rgb_arr[:, :, 2]
    bgra[:, :, 1] = rgb_arr[:, :, 1]
    bgra[:, :, 2] = rgb_arr[:, :, 0]
    bgra[:, :, 3] = 255
    buf = surf.get_data()
    raw = bgra.tobytes()
    buf[: len(raw)] = raw
    surf.mark_dirty()
    return surf


def rgba_to_cairo_surface(rgba_arr: np.ndarray, alpha_scale: float = 1.0) -> cairo.ImageSurface:
    h, w, _ = rgba_arr.shape
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
    a_norm = (rgba_arr[:, :, 3:4].astype(np.float32) * alpha_scale) / 255.0
    a_u8 = np.clip(rgba_arr[:, :, 3].astype(np.float32) * alpha_scale, 0.0, 255.0).astype(np.uint8)
    bgra = np.empty((h, w, 4), dtype=np.uint8)
    bgra[:, :, 0] = np.clip(rgba_arr[:, :, 2] * a_norm[:, :, 0], 0.0, 255.0).astype(np.uint8)
    bgra[:, :, 1] = np.clip(rgba_arr[:, :, 1] * a_norm[:, :, 0], 0.0, 255.0).astype(np.uint8)
    bgra[:, :, 2] = np.clip(rgba_arr[:, :, 0] * a_norm[:, :, 0], 0.0, 255.0).astype(np.uint8)
    bgra[:, :, 3] = a_u8
    buf = surf.get_data()
    raw = bgra.tobytes()
    buf[: len(raw)] = raw
    surf.mark_dirty()
    return surf


