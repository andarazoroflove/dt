    def _bg_fetch_weather_and_solar(self, metar_id: str, lat: float, lon: float):
        sess = requests.Session()
        sess.headers.update(HTTP_HEADERS)

        # 1. AviationWeather.gov METAR + TAF + NWS Station Fallback
        metar_cache_p = CACHE_DIR / "metar" / f"{metar_id}.json"
        parsed: dict[str, Any] | None = None
        try:
            url_aw = f"https://aviationweather.gov/api/data/metar?ids={metar_id}&format=json&taf=true"
            r = sess.get(url_aw, timeout=7.0)
            if r.status_code == 200:
                arr = r.json()
                if isinstance(arr, list) and arr:
                    item = arr[0]
                    raw_ob = str(item.get("rawOb") or "")
                    parsed = parse_metar_raw(raw_ob, metar_id)
                    parsed["raw_taf"] = str(item.get("rawTaf") or "")
                    if item.get("temp") is not None:
                        tc = float(item["temp"])
                        parsed["temp_c"] = round(tc, 1)
                        parsed["temp_f"] = round(tc * 9.0 / 5.0 + 32.0, 1)
                    if item.get("dewp") is not None:
                        dc = float(item["dewp"])
                        parsed["dew_c"] = round(dc, 1)
                        parsed["dew_f"] = round(dc * 9.0 / 5.0 + 32.0, 1)
                        parsed["rh_pct"] = round(compute_relative_humidity(parsed["temp_c"], dc), 1)
                    if item.get("wspd") is not None:
                        wk = float(item["wspd"])
                        parsed["wind_kt"] = round(wk, 1)
                        parsed["wind_mph"] = round(wk * 1.15078, 1)
                    if item.get("wgst") is not None:
                        gk = float(item["wgst"])
                        parsed["gust_kt"] = round(gk, 1)
                        parsed["gust_mph"] = round(gk * 1.15078, 1)
                    if item.get("wdir") is not None:
                        wd = item["wdir"]
                        if str(wd).upper() == "VRB":
                            parsed["wind_dir"] = None
                            parsed["wind_vrb"] = True
                        else:
                            try:
                                parsed["wind_dir"] = float(wd)
                                parsed["wind_card"] = cardinal_from_deg(parsed["wind_dir"])
                            except Exception:
                                pass
                    if item.get("altim") is not None:
                        av = float(item["altim"])
                        if av > 800.0:
                            parsed["altim_hpa"] = round(av, 1)
                            parsed["altim_inhg"] = round(av / 33.8638866667, 2)
                        elif 25.0 <= av <= 33.0:
                            parsed["altim_inhg"] = round(av, 2)
                            parsed["altim_hpa"] = round(av * 33.8638866667, 1)
                    if item.get("fltCat"):
                        parsed["flight_cat"] = str(item["fltCat"]).upper()
                    parsed["source"] = "LIVE AVIATIONWEATHER.GOV"
                    self.online_metar = True
        except Exception:
            pass

        # Supplement or fallback with NWS api.weather.gov/stations/{ID}/observations/latest
        try:
            url_nws = f"https://api.weather.gov/stations/{metar_id}/observations/latest"
            rn = sess.get(url_nws, headers={"User-Agent": UA, "Accept": "application/geo+json"}, timeout=7.0)
            if rn.status_code == 200:
                props = rn.json().get("properties", {})
                raw_msg = str(props.get("rawMessage") or "").strip()
                if parsed is None:
                    parsed = parse_metar_raw(raw_msg, metar_id) if raw_msg else build_default_metar_data(metar_id)
                    if not raw_msg:
                        parsed["raw_metar"] = f"{metar_id} AUTO NWS ASOS OBSERVATION"
                    parsed["source"] = "LIVE API.WEATHER.GOV"
                t_val = (props.get("temperature") or {}).get("value")
                d_val = (props.get("dewpoint") or {}).get("value")
                rh_val = (props.get("relativeHumidity") or {}).get("value")
                bp_val = (props.get("barometricPressure") or {}).get("value")
                ws_obj = props.get("windSpeed") or {}
                wg_obj = props.get("windGust") or {}
                wd_val = (props.get("windDirection") or {}).get("value")
                desc = str(props.get("textDescription") or "").strip()
                if t_val is not None:
                    tc = float(t_val)
                    parsed["temp_c"] = round(tc, 1)
                    parsed["temp_f"] = round(tc * 9.0 / 5.0 + 32.0, 1)
                if d_val is not None:
                    dc = float(d_val)
                    parsed["dew_c"] = round(dc, 1)
                    parsed["dew_f"] = round(dc * 9.0 / 5.0 + 32.0, 1)
                if rh_val is not None:
                    parsed["rh_pct"] = round(float(rh_val), 1)
                if bp_val is not None and float(bp_val) > 50000.0 and parsed.get("altim_inhg", 29.92) == 29.92:
                    hpa = float(bp_val) / 100.0
                    parsed["altim_hpa"] = round(hpa, 1)
                    parsed["altim_inhg"] = round(hpa / 33.8638866667, 2)
                if wd_val is not None and parsed.get("wind_dir") is None:
                    parsed["wind_dir"] = float(wd_val)
                    parsed["wind_card"] = cardinal_from_deg(float(wd_val))
                if ws_obj.get("value") is not None and parsed.get("wind_kt", 0.0) == 0.0:
                    wv = float(ws_obj["value"])
                    ucode = str(ws_obj.get("unitCode") or "")
                    wk = wv / 1.852 if "km_h" in ucode else (wv * 1.94384 if "m_s" in ucode else wv)
                    parsed["wind_kt"] = round(wk, 1)
                    parsed["wind_mph"] = round(wk * 1.15078, 1)
                if wg_obj.get("value") is not None and parsed.get("gust_kt", 0.0) == 0.0:
                    gv = float(wg_obj["value"])
                    ucode = str(wg_obj.get("unitCode") or "")
                    gk = gv / 1.852 if "km_h" in ucode else (gv * 1.94384 if "m_s" in ucode else gv)
                    parsed["gust_kt"] = round(gk, 1)
                    parsed["gust_mph"] = round(gk * 1.15078, 1)
                if desc:
                    parsed["wx_summary"] = desc
                self.online_metar = True
        except Exception:
            pass

        if parsed is not None:
            try:
                metar_cache_p.write_text(json.dumps(parsed, indent=2), encoding="utf-8")
            except Exception:
                pass
        elif metar_cache_p.is_file():
            try:
                parsed = json.loads(metar_cache_p.read_text(encoding="utf-8"))
                parsed["source"] = "DISK CACHE"
            except Exception:
                parsed = build_default_metar_data(metar_id)
        else:
            parsed = build_default_metar_data(metar_id)

        with self._lock:
            self.metar_data = parsed
        self._notify_ui()

        # 2. Active NWS CAP Alerts + Warning Polygons
        alerts_cache_p = CACHE_DIR / "metar" / "alerts.json"
        new_alerts: list[dict[str, Any]] | None = None
        try:
            url_al = f"https://api.weather.gov/alerts/active?point={lat:.4f},{lon:.4f}"
            ra = sess.get(url_al, headers={"User-Agent": UA, "Accept": "application/geo+json"}, timeout=7.5)
            if ra.status_code == 200:
                feats = list(ra.json().get("features") or [])
                # Also pull nearby regional polygon warnings within 220 km if inside CONUS
                if 24.0 <= lat <= 50.0 and -125.0 <= lon <= -66.0:
                    state_guess = "ID" if (41.9 <= lat <= 49.0 and -117.2 <= lon <= -111.0) else ""
                    if state_guess:
                        try:
                            rs = sess.get(
                                f"https://api.weather.gov/alerts/active?area={state_guess}",
                                headers={"User-Agent": UA, "Accept": "application/geo+json"},
                                timeout=6.5,
                            )
                            if rs.status_code == 200:
                                seen_ids = {f.get("id") for f in feats}
                                for sf in (rs.json().get("features") or []):
                                    if sf.get("id") not in seen_ids and sf.get("geometry"):
                                        feats.append(sf)
                        except Exception:
                            pass
                new_alerts = []
                for f in feats[:18]:
                    pr = f.get("properties") or {}
                    geom = f.get("geometry") or {}
                    polys: list[list[tuple[float, float]]] = []
                    gtype = geom.get("type")
                    coords = geom.get("coordinates") or []
                    if gtype == "Polygon":
                        for ring in coords[:1]:
                            polys.append([(float(pt[1]), float(pt[0])) for pt in ring if len(pt) >= 2])
                    elif gtype == "MultiPolygon":
                        for poly in coords:
                            for ring in poly[:1]:
                                polys.append([(float(pt[1]), float(pt[0])) for pt in ring if len(pt) >= 2])
                    new_alerts.append({
                        "event": str(pr.get("event") or "Weather Alert"),
                        "severity": str(pr.get("severity") or "Moderate"),
                        "headline": str(pr.get("headline") or pr.get("event") or ""),
                        "areaDesc": str(pr.get("areaDesc") or ""),
                        "expires": str(pr.get("expires") or ""),
                        "polygons": polys,
                    })
                alerts_cache_p.write_text(json.dumps(new_alerts, indent=2), encoding="utf-8")
        except Exception:
            if alerts_cache_p.is_file():
                try:
                    new_alerts = json.loads(alerts_cache_p.read_text(encoding="utf-8"))
                except Exception:
                    new_alerts = []

        if new_alerts is not None:
            with self._lock:
                self.alerts = new_alerts
            self._notify_ui()

        # 3. NOAA SWPC Space Weather (X-Ray 6h, Planetary Kp, 10.7cm SFI, Solar Wind & Bz)
        swpc_cache_p = CACHE_DIR / "swpc" / "solar_state.json"
        swpc_ok = False
        sol = build_default_solar_data()
        try:
            rx = sess.get("https://services.swpc.noaa.gov/json/goes/primary/xrays-6-hour.json", timeout=8.0)
            if rx.status_code == 200:
                xarr = rx.json()
                xr_l: list[tuple[float, float]] = []
                xr_s: list[tuple[float, float]] = []
                for row in xarr:
                    fl = float(row.get("flux") or 0.0)
                    if fl <= 0.0:
                        continue
                    t_str = str(row.get("time_tag") or "").replace("Z", "+00:00")
                    try:
                        ts = datetime.datetime.fromisoformat(t_str).timestamp()
                    except Exception:
                        continue
                    en = str(row.get("energy") or "")
                    if "0.1-0.8" in en:
                        xr_l.append((ts, fl))
                    elif "0.05-0.4" in en:
                        xr_s.append((ts, fl))
                if len(xr_l) >= 8:
                    sol["xray_long"] = xr_l[-240:]
                    sol["xray_short"] = xr_s[-240:] if xr_s else []
                    sol["xray_flux"] = xr_l[-1][1]
                    sol["xray_peak"] = max(v for _, v in xr_l)
                    swpc_ok = True
        except Exception:
            pass

        try:
            rk = sess.get("https://services.swpc.noaa.gov/products/noaa-planetary-k-index.json", timeout=7.5)
            if rk.status_code == 200:
                karr = rk.json()
                bars: list[tuple[str, float]] = []
                for row in karr[-12:]:
                    if isinstance(row, list) and len(row) >= 2:
                        if str(row[0]).lower().startswith("time"):
                            continue
                        try:
                            kv = float(row[1])
                            lbl = str(row[0])[11:16] + "Z"
                            bars.append((lbl, kv))
                        except Exception:
                            pass
                    elif isinstance(row, dict):
                        try:
                            kv = float(row.get("Kp") or row.get("kp_index") or 0.0)
                            lbl = str(row.get("time_tag") or "")[11:16] + "Z"
                            bars.append((lbl, kv))
                        except Exception:
                            pass
                if bars:
                    sol["kp_bars"] = bars[-8:]
                    sol["kp"] = bars[-1][1]
                    sol["a_index"] = float(round(sum(kp_to_ap(v) for _, v in bars[-8:]) / len(bars[-8:])))
                    swpc_ok = True
        except Exception:
            pass

        try:
            rf = sess.get("https://services.swpc.noaa.gov/products/summary/10cm-flux.json", timeout=6.5)
            if rf.status_code == 200:
                fobj = rf.json()
                fv = fobj.get("Flux") or fobj.get("flux")
                if fv is not None:
                    sol["sfi"] = float(fv)
                    sol["ssn"] = max(0, int(round((sol["sfi"] - 67.0) * 1.18)))
                    swpc_ok = True
        except Exception:
            pass

        try:
            rw = sess.get("https://services.swpc.noaa.gov/products/summary/solar-wind-speed.json", timeout=6.0)
            if rw.status_code == 200:
                wv = rw.json().get("WindSpeed")
                if wv is not None:
                    sol["solar_wind_kms"] = float(wv)
        except Exception:
            pass

        try:
            rb = sess.get("https://services.swpc.noaa.gov/products/summary/solar-wind-mag-field.json", timeout=6.0)
            if rb.status_code == 200:
                bobj = rb.json()
                if bobj.get("Bt") is not None:
                    sol["bt_nt"] = float(bobj["Bt"])
                if bobj.get("Bz") is not None:
                    sol["bz_nt"] = float(bobj["Bz"])
        except Exception:
            pass

        if swpc_ok:
            sol["cond"] = calculate_hf_band_conditions(
                sol["sfi"], sol["kp"], sol["a_index"], sol["xray_flux"], sol["bz_nt"]
            )
            sol["source"] = "LIVE NOAA SWPC"
            sol["updated_utc"] = datetime.datetime.now(datetime.timezone.utc).strftime("%H:%M:%S UTC")
            self.online_swpc = True
            try:
                swpc_cache_p.write_text(json.dumps(sol), encoding="utf-8")
            except Exception:
                pass
        elif swpc_cache_p.is_file():
            try:
                sol = json.loads(swpc_cache_p.read_text(encoding="utf-8"))
                sol["source"] = "DISK CACHE"
            except Exception:
                pass

        with self._lock:
            self.solar_data = sol
        self._notify_ui()


