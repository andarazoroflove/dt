    # ---- METAR / TAF + NWS Station Obs + Active CAP Alerts ----
    def fetch_all_telemetry_async(self, metar_id: str, lat: float, lon: float):
        threading.Thread(
            target=self._bg_fetch_weather_and_solar,
            args=(metar_id.strip().upper() or DEFAULT_METAR, float(lat), float(lon)),
