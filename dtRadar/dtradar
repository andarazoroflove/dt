def build_default_metar_data(metar_id: str) -> dict[str, Any]:
    now_utc = datetime.datetime.now(datetime.timezone.utc)
    stamp = now_utc.strftime("%d%H53Z")
    raw = (
        f"{metar_id.upper()} {stamp} 23012G19KT 10SM FEW065 SCT120 08/M03 A3004 "
        f"RMK AO2 SLP176 T00831028 52008"
    )
    d = parse_metar_raw(raw, metar_id)
    h0 = now_utc.strftime("%d%H")
    h1 = (now_utc + datetime.timedelta(hours=24)).strftime("%d%H")
    d["raw_taf"] = (
        f"TAF {metar_id.upper()} {now_utc.strftime('%d%H30Z')} {h0}/{h1} "
        f"23013G21KT P6SM SCT070 BKN130 FM{now_utc.strftime('%d')}1800 25016G25KT P6SM -SHRA BKN055"
    )
    d["source"] = "OFFLINE BASELINE"
    return d


def build_default_solar_data() -> dict[str, Any]:
    now = datetime.datetime.now(datetime.timezone.utc)
    # 6h synthetic GOES X-ray curve (realistic C-class background + minor C4.8 flare peak)
    xr_long: list[tuple[float, float]] = []
    xr_short: list[tuple[float, float]] = []
    for i in range(180):
        t_min = -360.0 + i * 2.0
        ts = (now + datetime.timedelta(minutes=t_min)).timestamp()
        base = 1.1e-6 + 0.35e-6 * math.sin(i * 0.09)
        flare1 = 3.8e-6 * math.exp(-((i - 118.0) / 14.0) ** 2)
        flare2 = 1.2e-6 * math.exp(-((i - 48.0) / 10.0) ** 2)
        fl_l = max(1.5e-8, base + flare1 + flare2)
        fl_s = max(2.0e-9, fl_l * 0.14 + flare1 * 0.12)
        xr_long.append((ts, fl_l))
        xr_short.append((ts, fl_s))

    kp_bars: list[tuple[str, float]] = []
    sample_kps = [2.0, 2.33, 3.0, 3.67, 4.33, 3.33, 2.67, 2.33]
    for idx, kv in enumerate(sample_kps):
        bt = now - datetime.timedelta(hours=(7 - idx) * 3)
        kp_bars.append((bt.strftime("%H:%MZ"), kv))

    sfi = 158.0
    kp = sample_kps[-1]
    a_idx = float(round(sum(kp_to_ap(k) for k in sample_kps) / len(sample_kps)))
    latest_xray = xr_long[-1][1]
    bz = -2.4
    cond = calculate_hf_band_conditions(sfi, kp, a_idx, latest_xray, bz)
    return {
        "sfi": sfi,
        "ssn": 114,
        "kp": kp,
        "a_index": a_idx,
        "solar_wind_kms": 428.0,
        "bt_nt": 6.2,
        "bz_nt": bz,
        "xray_flux": latest_xray,
        "xray_peak": max(v for _, v in xr_long),
        "xray_long": xr_long,
        "xray_short": xr_short,
        "kp_bars": kp_bars,
        "cond": cond,
        "source": "OFFLINE BASELINE",
        "updated_utc": now.strftime("%H:%M:%S UTC"),
    }


# ---------------------------------------------------------------------------
# Async Disk-Cached Network & Tile Engine
# ---------------------------------------------------------------------------
class RadarDataEngine:
    """Thread-safe HTTP tile & NOAA/NWS/SWPC telemetry downloader with ~/.cache/dtradar/ persistence."""

    def __init__(self, on_update_cb=None):
        self.on_update_cb = on_update_cb
        for sub in ("osm", "nexrad", "ridge", "sat", "swpc", "metar"):
            (CACHE_DIR / sub).mkdir(parents=True, exist_ok=True)

        self._lock = threading.Lock()
        self._osm_surfs: collections.OrderedDict[tuple[int, int, int], cairo.ImageSurface] = collections.OrderedDict()
        self._nex_surfs: collections.OrderedDict[tuple[str, int, int, int], cairo.ImageSurface] = collections.OrderedDict()
        self._inflight: set[tuple] = set()
        self._failed_until: dict[tuple, float] = {}
        self._tile_queue: collections.deque[tuple] = collections.deque()
        self._cond = threading.Condition()
        self._stop = False

        self.online_osm = False
        self.online_nexrad = False
        self.online_metar = False
        self.online_swpc = False

        # RIDGE unpacked frames: key = (site, is_loop) -> list[cairo.ImageSurface]
        self.ridge_frames: dict[tuple[str, bool], list[cairo.ImageSurface]] = {}
        self.ridge_status: str = "AWAITING RIDGE FETCH"

        # GOES / SWPC Satellite images: key = goes_key -> cairo.ImageSurface
        self.sat_surfaces: dict[str, cairo.ImageSurface] = {}
        self.sat_timestamps: dict[str, str] = {}

        # Weather & Solar state
        self.metar_data: dict[str, Any] = build_default_metar_data(DEFAULT_METAR)
        self.alerts: list[dict[str, Any]] = []
        self.solar_data: dict[str, Any] = build_default_solar_data()

        for i in range(3):
            t = threading.Thread(target=self._tile_worker, name=f"dtradar-tile-{i}", daemon=True)
            t.start()

    def shutdown(self):
        self._stop = True
        with self._cond:
            self._cond.notify_all()

    def _notify_ui(self):
        if self.on_update_cb is not None:
            GLib.idle_add(self.on_update_cb)

    # ---- Slippy OSM Dark-LUT + IEM NEXRAD Tiles ----
    def get_osm_tile(self, z: int, x: int, y: int) -> cairo.ImageSurface | None:
        key = (z, x, y)
        with self._lock:
            if key in self._osm_surfs:
                self._osm_surfs.move_to_end(key)
                return self._osm_surfs[key]
        # Check disk cache synchronously if fast, else queue
        disk_p = CACHE_DIR / "osm" / f"{z}_{x}_{y}.png"
        if disk_p.is_file():
            try:
                im = Image.open(disk_p).convert("RGB")
                surf = rgb_to_cairo_surface(apply_dark_tactical_lut(np.asarray(im, dtype=np.uint8)))
                with self._lock:
                    self._osm_surfs[key] = surf
                    while len(self._osm_surfs) > 280:
                        self._osm_surfs.popitem(last=False)
                return surf
            except Exception:
                pass
        self._enqueue_tile(("osm", z, x, y))
        return None

    def get_nexrad_tile(self, lag_id: str, z: int, x: int, y: int) -> cairo.ImageSurface | None:
        key = (lag_id, z, x, y)
        with self._lock:
            if key in self._nex_surfs:
                self._nex_surfs.move_to_end(key)
                return self._nex_surfs[key]
        disk_p = CACHE_DIR / "nexrad" / f"{lag_id}_{z}_{x}_{y}.png"
        now = time.time()
        if disk_p.is_file() and (now - disk_p.stat().st_mtime) < 240.0:
            try:
                im = Image.open(disk_p).convert("RGBA")
                arr = np.asarray(im, dtype=np.uint8)
                surf = rgba_to_cairo_surface(arr, alpha_scale=0.84)
                with self._lock:
                    self._nex_surfs[key] = surf
                    self.online_nexrad = True
                    while len(self._nex_surfs) > 420:
                        self._nex_surfs.popitem(last=False)
                return surf
            except Exception:
                pass
        self._enqueue_tile(("nexrad", lag_id, z, x, y))
        return None

    def _enqueue_tile(self, job: tuple):
        now = time.time()
        with self._cond:
            if job in self._inflight:
                return
            if self._failed_until.get(job, 0.0) > now:
                return
            self._inflight.add(job)
            self._tile_queue.append(job)
            while len(self._tile_queue) > 96:
                dropped = self._tile_queue.popleft()
                self._inflight.discard(dropped)
            self._cond.notify()

    def _tile_worker(self):
        sess = requests.Session()
        sess.headers.update(HTTP_HEADERS)
        while not self._stop:
            with self._cond:
                while not self._tile_queue and not self._stop:
                    self._cond.wait(timeout=2.0)
                if self._stop:
                    return
                job = self._tile_queue.pop()
            try:
                kind = job[0]
                if kind == "osm":
                    _, z, x, y = job
                    url = f"https://tile.openstreetmap.org/{z}/{x}/{y}.png"
                    r = sess.get(url, timeout=6.0)
                    r.raise_for_status()
                    disk_p = CACHE_DIR / "osm" / f"{z}_{x}_{y}.png"
                    disk_p.write_bytes(r.content)
                    im = Image.open(io.BytesIO(r.content)).convert("RGB")
                    surf = rgb_to_cairo_surface(apply_dark_tactical_lut(np.asarray(im, dtype=np.uint8)))
                    with self._lock:
                        self._osm_surfs[(z, x, y)] = surf
                        self.online_osm = True
                        while len(self._osm_surfs) > 280:
                            self._osm_surfs.popitem(last=False)
                    self._notify_ui()
                elif kind == "nexrad":
                    _, lag_id, z, x, y = job
                    layer = "nexrad-n0q-900913" if lag_id == "live" else f"nexrad-n0q-900913-{lag_id}"
                    url = f"https://mesonet.agron.iastate.edu/cache/tile.py/1.0.0/{layer}/{z}/{x}/{y}.png"
                    r = sess.get(url, timeout=6.5)
                    r.raise_for_status()
                    disk_p = CACHE_DIR / "nexrad" / f"{lag_id}_{z}_{x}_{y}.png"
                    disk_p.write_bytes(r.content)
                    im = Image.open(io.BytesIO(r.content)).convert("RGBA")
                    surf = rgba_to_cairo_surface(np.asarray(im, dtype=np.uint8), alpha_scale=0.84)
                    with self._lock:
                        self._nex_surfs[(lag_id, z, x, y)] = surf
                        self.online_nexrad = True
                        while len(self._nex_surfs) > 420:
                            self._nex_surfs.popitem(last=False)
                    self._notify_ui()
            except Exception:
                with self._cond:
                    self._failed_until[job] = time.time() + 45.0
            finally:
                with self._cond:
                    self._inflight.discard(job)

    def clear_nexrad_cache_for_refresh(self):
        with self._lock:
            self._nex_surfs.clear()
        with self._cond:
            self._failed_until.clear()

    # ---- NWS Station RIDGE Multi-Frame GIF Unpacker ----
    def fetch_ridge_async(self, site: str, is_loop: bool, force: bool = False):
        site_u = site.strip().upper() or DEFAULT_NEXRAD
        key = (site_u, bool(is_loop))
        if not force and key in self.ridge_frames and self.ridge_frames[key]:
            return
        threading.Thread(
            target=self._bg_fetch_ridge, args=(site_u, bool(is_loop), force), daemon=True
        ).start()

    def _unpack_gif_bytes(self, raw_bytes: bytes) -> list[cairo.ImageSurface]:
        im = Image.open(io.BytesIO(raw_bytes))
        n_frames = max(1, int(getattr(im, "n_frames", 1)))
        frames: list[cairo.ImageSurface] = []
        canvas = Image.new("RGBA", im.size, (0, 0, 0, 255))
        for idx in range(min(24, n_frames)):
            im.seek(idx)
            frame_rgba = im.convert("RGBA")
            canvas = Image.alpha_composite(canvas, frame_rgba)
            arr = np.asarray(canvas, dtype=np.uint8)
            frames.append(rgba_to_cairo_surface(arr, alpha_scale=1.0))
        return frames

    def _bg_fetch_ridge(self, site: str, is_loop: bool, force: bool):
        suffix = "loop" if is_loop else "0"
        disk_p = CACHE_DIR / "ridge" / f"{site}_{suffix}.gif"
        raw_bytes: bytes | None = None
        now = time.time()

        if not force and disk_p.is_file() and (now - disk_p.stat().st_mtime) < 240.0:
            try:
                raw_bytes = disk_p.read_bytes()
            except Exception:
                raw_bytes = None

        if raw_bytes is None:
            url = f"https://radar.weather.gov/ridge/standard/{site}_{suffix}.gif"
            try:
                r = requests.get(url, headers=HTTP_HEADERS, timeout=10.0)
                r.raise_for_status()
                raw_bytes = r.content
                disk_p.write_bytes(raw_bytes)
                self.ridge_status = f"LIVE NOAA RIDGE {site} ({suffix.upper()})"
            except Exception:
                if disk_p.is_file():
                    try:
                        raw_bytes = disk_p.read_bytes()
                        self.ridge_status = f"CACHED NOAA RIDGE {site}"
                    except Exception:
                        raw_bytes = None
                if raw_bytes is None:
                    self.ridge_status = f"OFFLINE SYNTHETIC PPI — {site}"

        if raw_bytes:
            try:
                surfs = self._unpack_gif_bytes(raw_bytes)
                if surfs:
                    with self._lock:
                        self.ridge_frames[(site, is_loop)] = surfs
                    self._notify_ui()
            except Exception:
                pass

