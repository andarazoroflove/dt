# ---------------------------------------------------------------------------
# IMA-ADPCM Decoder for KiwiSDR Compressed Audio Frames (flags & 0x10)
# ---------------------------------------------------------------------------
IMA_STEP_TABLE = (
    7, 8, 9, 10, 11, 12, 13, 14, 16, 17, 19, 21, 23, 25, 28, 31,
    34, 37, 41, 45, 50, 55, 60, 66, 73, 80, 88, 97, 107, 118, 130, 143,
    157, 173, 190, 209, 230, 253, 279, 307, 337, 371, 408, 449, 494, 544, 598, 658,
    724, 796, 876, 963, 1060, 1166, 1282, 1411, 1552, 1707, 1878, 2066, 2272, 2499, 2749, 3024,
    3327, 3660, 4026, 4428, 4871, 5358, 5894, 6484, 7132, 7845, 8630, 9493, 10442, 11487, 12635, 13899,
    15289, 16818, 18500, 20350, 22385, 24623, 27086, 29794, 32767,
)
IMA_INDEX_TABLE = (-1, -1, -1, -1, 2, 4, 6, 8, -1, -1, -1, -1, 2, 4, 6, 8)


def decode_ima_adpcm(data: bytes, state: list[int]) -> bytes:
    pred, idx = state[0], state[1]
    out = array.array("h")
    append = out.append
    for b in data:
        for nib in (b & 0x0F, (b >> 4) & 0x0F):
            step = IMA_STEP_TABLE[idx]
            diff = step >> 3
            if nib & 1:
                diff += step >> 2
            if nib & 2:
                diff += step >> 1
            if nib & 4:
                diff += step
            if nib & 8:
                pred -= diff
                if pred < -32768:
                    pred = -32768
            else:
                pred += diff
                if pred > 32767:
                    pred = 32767
            idx += IMA_INDEX_TABLE[nib]
            if idx < 0:
                idx = 0
            elif idx > 88:
                idx = 88
            append(pred)
    state[0], state[1] = pred, idx
    return out.tobytes()


# ---------------------------------------------------------------------------
# RTL-SDR Hardware Detection Helper
# ---------------------------------------------------------------------------
def detect_rtlsdr_status() -> tuple[bool, str]:
    has_bin = bool(shutil.which("rtl_fm"))
    has_usb = False
    try:
        for dev in Path("/sys/bus/usb/devices").glob("*"):
            vid_f = dev / "idVendor"
            pid_f = dev / "idProduct"
            if vid_f.is_file() and pid_f.is_file():
                vid = vid_f.read_text().strip().lower()
                pid = pid_f.read_text().strip().lower()
                if vid == "0bda" and pid in ("2838", "2832"):
                    has_usb = True
                    break
    except Exception:
        pass
    if has_usb and has_bin:
        return True, "RTL2832U USB SDR READY"
    if has_usb and not has_bin:
        return False, "RTL2832U FOUND (INSTALL rtl-sdr)"
    return False, "NO USB RTL-SDR CONNECTED (PLUG IN LATER)"


