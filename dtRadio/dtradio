        self._refresh_memory_labels()
        self._populate_channels_for_bank(0, tune=False)
        self._sync_mode_buttons()
        self._sync_step_buttons()

        # 6. Bottom CDE Sunken Status Strip
        st_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        st_bar.get_style_context().add_class("cde-status")
        outer.pack_start(st_bar, False, False, 0)

        self.status_lbl = Gtk.Label(label="READY")
        self.status_lbl.set_xalign(0.0)
        st_bar.pack_start(self.status_lbl, True, True, 0)

        _, rtl_txt = detect_rtlsdr_status()
        self.hw_lbl = Gtk.Label(label=rtl_txt)
        self.hw_lbl.set_xalign(1.0)
        st_bar.pack_end(self.hw_lbl, False, False, 0)

    def _make_latch_btn(self, text: str, cb, tip: str) -> Gtk.Button:
        b = Gtk.Button(label=text)
        b.set_tooltip_text(tip)
        b.connect("clicked", cb)
