# Interactive Machined Vintage Rotary Knob Widget (Cairo)
# ---------------------------------------------------------------------------
class RotaryKnob(Gtk.DrawingArea):
    def __init__(self, label: str, init_val: float, default_val: float, on_change, fmt_fn=None):
        super().__init__()
        self.label = label
        self.value = max(0.0, min(1.0, init_val))
        self.default_val = default_val
        self.on_change = on_change
        self.fmt_fn = fmt_fn
        self._drag_y = None
        self._drag_start_val = self.value

        self.set_size_request(86, 86)
        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.SCROLL_MASK
        )
        self.connect("draw", self._on_draw)
        self.connect("button-press-event", self._on_press)
        self.connect("button-release-event", self._on_release)
        self.connect("motion-notify-event", self._on_motion)
        self.connect("scroll-event", self._on_scroll)

    def set_value(self, v: float, notify: bool = False):
        self.value = max(0.0, min(1.0, v))
        self.queue_draw()
        if notify and self.on_change:
            self.on_change(self.value)

    def _on_press(self, _w, ev):
        if ev.type == Gdk.EventType._2BUTTON_PRESS:
            self.set_value(self.default_val, notify=True)
            return True
        if ev.button == 1:
            self._drag_y = ev.y
            self._drag_start_val = self.value
            return True
        return False

    def _on_release(self, _w, _ev):
        self._drag_y = None
        return True

    def _on_motion(self, _w, ev):
        if self._drag_y is not None:
            dy = self._drag_y - ev.y
            self.set_value(self._drag_start_val + dy / 110.0, notify=True)
            return True
        return False

    def _on_scroll(self, _w, ev):
        step = 0.04
        if ev.direction == Gdk.ScrollDirection.UP:
            self.set_value(self.value + step, notify=True)
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            self.set_value(self.value - step, notify=True)
        elif ev.direction == Gdk.ScrollDirection.SMOOTH:
            _, _dx, dy = ev.get_scroll_deltas()
            self.set_value(self.value - dy * 0.03, notify=True)
        return True

    def _on_draw(self, w, cr: cairo.Context):
        alloc = w.get_allocation()
        cx = alloc.width * 0.5
        cy = 34.0
        r = 21.0

        # Scale ticks (-135 deg to +135 deg from top = 135..405 deg in math coords)
        a_start = math.radians(135.0)
        a_span = math.radians(270.0)
        for i in range(11):
            frac = i / 10.0
            ang = a_start + frac * a_span
            r0 = r + 3.5
            r1 = r + (7.0 if i in (0, 5, 10) else 5.2)
            cr.set_line_width(1.5 if i in (0, 5, 10) else 1.0)
            if frac <= self.value + 0.001:
                cr.set_source_rgb(0.32, 0.94, 0.82)
            else:
                cr.set_source_rgb(0.62, 0.67, 0.76)
            cr.move_to(cx + r0 * math.cos(ang), cy + r0 * math.sin(ang))
            cr.line_to(cx + r1 * math.cos(ang), cy + r1 * math.sin(ang))
            cr.stroke()

        # Drop shadow
        cr.arc(cx + 1.5, cy + 2.2, r + 1.0, 0, 2 * math.pi)
        cr.set_source_rgba(0.05, 0.06, 0.08, 0.75)
        cr.fill()

        # Outer knurled dark skirt
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.set_source_rgb(0.16, 0.18, 0.22)
        cr.fill()

        # Knurl notches
        cr.set_line_width(1.0)
        cr.set_source_rgba(0.45, 0.50, 0.60, 0.55)
        for k in range(18):
            ka = k * (2.0 * math.pi / 18.0)
            cr.move_to(cx + (r - 2.5) * math.cos(ka), cy + (r - 2.5) * math.sin(ka))
            cr.line_to(cx + r * math.cos(ka), cy + r * math.sin(ka))
            cr.stroke()

        # Brushed aluminum cap gradient
        pat = cairo.LinearGradient(cx - r, cy - r, cx + r, cy + r)
        pat.add_color_stop_rgb(0.0, 0.82, 0.85, 0.91)
        pat.add_color_stop_rgb(0.5, 0.53, 0.57, 0.65)
        pat.add_color_stop_rgb(1.0, 0.30, 0.34, 0.40)
        cr.arc(cx, cy, r - 3.2, 0, 2 * math.pi)
        cr.set_source(pat)
        cr.fill()

        # Pointer line
        val_ang = a_start + self.value * a_span
        cr.set_line_width(2.4)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_source_rgb(1.0, 0.44, 0.16)
        cr.move_to(cx + 4.0 * math.cos(val_ang), cy + 4.0 * math.sin(val_ang))
        cr.line_to(cx + (r - 4.8) * math.cos(val_ang), cy + (r - 4.8) * math.sin(val_ang))
        cr.stroke()

        # Engraved label + compact readout
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(9.5)
        ext = cr.text_extents(self.label)
        cr.set_source_rgb(0.86, 0.90, 0.96)
        cr.move_to(cx - ext.width * 0.5, 72.0)
        cr.show_text(self.label)

        if self.fmt_fn:
            sub = self.fmt_fn(self.value)
            cr.set_font_size(8.2)
            ext2 = cr.text_extents(sub)
            cr.set_source_rgb(0.45, 0.92, 0.82)
            cr.move_to(cx - ext2.width * 0.5, 83.5)
            cr.show_text(sub)
        return False


# ---------------------------------------------------------------------------
# Main Audio DSP + KiwiSDR WebSocket + HTTP Stream + RTL-SDR Engine
# ---------------------------------------------------------------------------
class ReceiverAudioEngine:
    def __init__(self, on_level_cb, on_meta_cb, on_status_cb):
        self.on_level_cb = on_level_cb
        self.on_meta_cb = on_meta_cb
        self.on_status_cb = on_status_cb

        self.af_gain = 0.78
        self.rf_gain = 0.80
        self.squelch = 0.0
        self.clarifier_khz = 0.0
        self.clar_enabled = False
        self.if_width_norm = 0.68  # 0.0=300Hz CW .. 1.0=12kHz Wide
        self.tone_norm = 0.60
        self.nb_enabled = False
        self.anl_enabled = False
        self.att_enabled = False
        self.agc_slow = False
        self.muted = False
        self.squelch_open = True

        self.recording = False
        self._wav_lock = threading.Lock()
        self._wav_fp = None
        self.rec_path = ""

        self._pipe = None
        self._appsrc = None
        self._rf_vol = None
        self._af_vol = None
        self._if_bp = None
        self._tone_eq = None
        self._nb_comp = None

        self._worker_stop = threading.Event()
        self._worker_thread = None
        self._kiwi_cmd_q: queue.Queue[str] = queue.Queue()
        self._rtl_proc = None

        self.kiwi_servers: list[tuple[str, str]] = list(SEED_KIWISDRS)
        self.selected_kiwi_idx = 0  # 0 = Auto

    def _teardown_workers(self):
        self._worker_stop.set()
        if self._rtl_proc is not None:
            try:
                self._rtl_proc.terminate()
                self._rtl_proc.wait(timeout=1.0)
            except Exception:
                try:
                    self._rtl_proc.kill()
                except Exception:
                    pass
            self._rtl_proc = None
        if self._worker_thread and self._worker_thread.is_alive():
            self._worker_thread.join(timeout=1.2)
        self._worker_thread = None
        self._worker_stop = threading.Event()
        while not self._kiwi_cmd_q.empty():
            try:
                self._kiwi_cmd_q.get_nowait()
            except Exception:
                break

    def stop_pipeline(self):
        self._teardown_workers()
        if self._pipe is not None:
            try:
                self._pipe.set_state(Gst.State.NULL)
            except Exception:
                pass
            self._pipe = None
            self._appsrc = None
            self._rf_vol = None
            self._af_vol = None
            self._if_bp = None
            self._tone_eq = None
            self._nb_comp = None

    def _build_dsp_tail(self, pipe: Gst.Pipeline) -> Gst.Element:
        conv1 = Gst.ElementFactory.make("audioconvert", None)
        res1 = Gst.ElementFactory.make("audioresample", None)
        capsf = Gst.ElementFactory.make("capsfilter", None)
        capsf.set_property("caps", Gst.Caps.from_string("audio/x-raw,format=F32LE,rate=48000,channels=1"))

        rf_vol = Gst.ElementFactory.make("volume", "rf_vol")
        nb_comp = Gst.ElementFactory.make("audiodynamic", "nb_comp")
        if_bp = Gst.ElementFactory.make("audiochebband", "if_bp")
        tone_eq = Gst.ElementFactory.make("equalizer-3bands", "tone_eq")
        lvl = Gst.ElementFactory.make("level", "smeter_lvl")
        lvl.set_property("interval", 40_000_000)  # 25 Hz
        lvl.set_property("post-messages", True)
        af_vol = Gst.ElementFactory.make("volume", "af_vol")

        tee = Gst.ElementFactory.make("tee", "rec_tee")
        q_audio = Gst.ElementFactory.make("queue", None)
        conv_out = Gst.ElementFactory.make("audioconvert", None)
        res_out = Gst.ElementFactory.make("audioresample", None)
        sink = Gst.ElementFactory.make("autoaudiosink", None)

        q_rec = Gst.ElementFactory.make("queue", None)
        conv_rec = Gst.ElementFactory.make("audioconvert", None)
        res_rec = Gst.ElementFactory.make("audioresample", None)
        caps_rec = Gst.ElementFactory.make("capsfilter", None)
        caps_rec.set_property("caps", Gst.Caps.from_string("audio/x-raw,format=S16LE,rate=22050,channels=1"))
        appsink = Gst.ElementFactory.make("appsink", "wav_tap")
        appsink.set_property("emit-signals", True)
        appsink.set_property("sync", False)
        appsink.set_property("drop", True)
        appsink.set_property("max-buffers", 12)
        appsink.connect("new-sample", self._on_rec_sample)

        for el in (
            conv1, res1, capsf, rf_vol, nb_comp, if_bp, tone_eq, lvl, af_vol,
            tee, q_audio, conv_out, res_out, sink,
            q_rec, conv_rec, res_rec, caps_rec, appsink,
        ):
            pipe.add(el)

        conv1.link(res1)
        res1.link(capsf)
        capsf.link(rf_vol)
        rf_vol.link(nb_comp)
        nb_comp.link(if_bp)
        if_bp.link(tone_eq)
        tone_eq.link(lvl)
        lvl.link(af_vol)
        af_vol.link(tee)

        tee.link(q_audio)
        q_audio.link(conv_out)
        conv_out.link(res_out)
        res_out.link(sink)

        tee.link(q_rec)
        q_rec.link(conv_rec)
        conv_rec.link(res_rec)
        res_rec.link(caps_rec)
        caps_rec.link(appsink)

        self._rf_vol = rf_vol
        self._nb_comp = nb_comp
        self._if_bp = if_bp
        self._tone_eq = tone_eq
        self._af_vol = af_vol
        self.apply_dsp_params()

        bus = pipe.get_bus()
        bus.add_signal_watch()
        bus.connect("message", self._on_bus_msg)
        return conv1

    def _on_rec_sample(self, appsink):
        sample = appsink.emit("pull-sample")
        if sample and self.recording:
            buf = sample.get_buffer()
            ok, mapinfo = buf.map(Gst.MapFlags.READ)
            if ok:
                try:
                    with self._wav_lock:
                        if self._wav_fp is not None:
                            self._wav_fp.writeframesraw(mapinfo.data)
                finally:
                    buf.unmap(mapinfo)
        return Gst.FlowReturn.OK

    def toggle_recording(self) -> tuple[bool, str]:
        with self._wav_lock:
            if self.recording:
                self.recording = False
                if self._wav_fp is not None:
                    try:
                        self._wav_fp.close()
                    except Exception:
                        pass
                    self._wav_fp = None
                return False, self.rec_path
            REC_DIR.mkdir(parents=True, exist_ok=True)
            ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
            out_p = REC_DIR / f"dtradio_aircheck_{ts}.wav"
            wf = wave.open(str(out_p), "wb")
            wf.setnchannels(1)
            wf.setsampwidth(2)
            wf.setframerate(22050)
            self._wav_fp = wf
            self.rec_path = str(out_p)
            self.recording = True
            return True, self.rec_path

    def apply_dsp_params(self):
        if self._rf_vol is not None:
            rf = max(0.05, self.rf_gain * 1.25)
            if self.att_enabled:
                rf *= 0.25  # -12 dB pad
            self._rf_vol.set_property("volume", rf)

        if self._nb_comp is not None:
            if self.nb_enabled:
                Gst.util_set_object_arg(self._nb_comp, "mode", "compressor")
                Gst.util_set_object_arg(self._nb_comp, "characteristics", "hard-knee")
                self._nb_comp.set_property("threshold", 0.30)
                self._nb_comp.set_property("ratio", 8.0)
            else:
                self._nb_comp.set_property("threshold", 1.0)
                self._nb_comp.set_property("ratio", 1.0)

        if self._if_bp is not None:
            Gst.util_set_object_arg(self._if_bp, "mode", "band-pass")
            # Map IF WIDTH knob (0..1) from 350 Hz narrow CW to 11.5 kHz wide
            span_hz = 350.0 * math.pow(33.0, self.if_width_norm)
            if self.anl_enabled:
                low_hz = 280.0
                high_hz = min(span_hz, 2950.0)
            else:
                low_hz = 95.0 if self.if_width_norm > 0.25 else 360.0
                high_hz = max(low_hz + 260.0, min(14000.0, low_hz + span_hz))
            # Subtle Clarifier passband shift when on web stream
            if self.clar_enabled and abs(self.clarifier_khz) > 0.01:
                shift = self.clarifier_khz * 120.0
                low_hz = max(60.0, low_hz + shift * 0.5)
                high_hz = max(low_hz + 260.0, min(15000.0, high_hz + shift))
            self._if_bp.set_property("lower-frequency", float(low_hz))
            self._if_bp.set_property("upper-frequency", float(high_hz))

        if self._tone_eq is not None:
            # Tone knob shapes HF hiss rolloff (-18 dB .. +4 dB on band2)
            hi_db = -18.0 + self.tone_norm * 22.0
            mid_db = -3.0 + self.tone_norm * 5.0
            if self.anl_enabled:
                hi_db = min(hi_db, -9.0)
            self._tone_eq.set_property("band0", -2.0 if self.anl_enabled else 0.0)
            self._tone_eq.set_property("band1", float(mid_db))
            self._tone_eq.set_property("band2", float(hi_db))

        self._update_af_gate()

    def _update_af_gate(self):
        if self._af_vol is not None:
            if self.muted or not self.squelch_open:
                self._af_vol.set_property("volume", 0.0)
            else:
                self._af_vol.set_property("volume", float(self.af_gain * 1.35))

    def _on_bus_msg(self, _bus, msg):
        t = msg.type
        if t == Gst.MessageType.ELEMENT:
            st = msg.get_structure()
            if st and st.get_name() == "level":
                rms_list = st.get_value("rms")
                if rms_list and len(rms_list) > 0:
                    rms_db = float(rms_list[0])
                    # Map RMS (-65 .. -6 dB) to 0..1 signal strength
                    norm = max(0.0, min(1.0, (rms_db + 62.0) / 54.0))
                    sq_open = (self.squelch <= 0.02) or (norm >= self.squelch * 0.85)
                    if sq_open != self.squelch_open:
                        self.squelch_open = sq_open
                        self._update_af_gate()
                    self.on_level_cb(rms_db, norm, self.squelch_open)
        elif t == Gst.MessageType.TAG:
            tags = msg.parse_tag()
            ok_t, title = tags.get_string("title")
            ok_o, org = tags.get_string("organization")
            txt = title if ok_t and title else (org if ok_o and org else "")
            if txt:
                self.on_meta_cb(txt.strip())
        elif t == Gst.MessageType.ERROR:
            err, _dbg = msg.parse_error()
            self.on_status_cb(f"STREAM ERR: {err.message[:48]}")

    # ---- Mode 1: Direct Web Stream (HTTP MP3/AAC/HLS) ----
    def start_web_stream(self, url: str, title: str):
        self.stop_pipeline()
        self.on_status_cb(f"TUNING STREAM: {title[:44]}...")
        pipe = Gst.Pipeline.new("rx_stream_pipe")
        src = Gst.ElementFactory.make("uridecodebin", "urisrc")
        src.set_property("uri", url)
        pipe.add(src)
        dsp_head = self._build_dsp_tail(pipe)

        def on_pad_added(_el, pad):
            caps = pad.get_current_caps() or pad.query_caps(None)
            if caps and caps.get_size() > 0:
                name = caps.get_structure(0).get_name()
                if name.startswith("audio/"):
                    sink_pad = dsp_head.get_static_pad("sink")
                    if sink_pad and not sink_pad.is_linked():
                        pad.link(sink_pad)
                        GLib.idle_add(self.on_status_cb, f"LOCKED STREAM: {title[:46]}")

        src.connect("pad-added", on_pad_added)
        self._pipe = pipe
        pipe.set_state(Gst.State.PLAYING)

    # ---- Mode 2: Live 0-30 MHz KiwiSDR WebSocket Receiver ----
    def _build_appsrc_pipeline(self, sample_rate: int = 12000):
        pipe = Gst.Pipeline.new("rx_pcm_pipe")
        appsrc = Gst.ElementFactory.make("appsrc", "pcmsrc")
        appsrc.set_property("is-live", True)
        appsrc.set_property("format", Gst.Format.TIME)
        appsrc.set_property("do-timestamp", True)
        appsrc.set_property(
            "caps",
            Gst.Caps.from_string(f"audio/x-raw,format=S16LE,channels=1,rate={sample_rate},layout=interleaved"),
        )
        pipe.add(appsrc)
        dsp_head = self._build_dsp_tail(pipe)
        appsrc.link(dsp_head)
        self._pipe = pipe
        self._appsrc = appsrc
        pipe.set_state(Gst.State.PLAYING)

    def _kiwi_mod_cmd(self, freq_khz: float, mode: str) -> str:
        eff_khz = max(10.0, min(30000.0, freq_khz + (self.clarifier_khz if self.clar_enabled else 0.0)))
        m = mode.upper()
        if m == "USB":
            return f"SET mod=usb low_cut=300 high_cut=2700 freq={eff_khz:.3f}"
        if m == "LSB":
            return f"SET mod=lsb low_cut=-2700 high_cut=-300 freq={eff_khz:.3f}"
        if m == "CW":
            return f"SET mod=cw low_cut=300 high_cut=900 freq={eff_khz:.3f}"
        if m == "NFM":
            return f"SET mod=nbfm low_cut=-6000 high_cut=6000 freq={eff_khz:.3f}"
        return f"SET mod=am low_cut=-4500 high_cut=4500 freq={eff_khz:.3f}"

    def retune_kiwi_live(self, freq_khz: float, mode: str):
        if self._worker_thread and self._worker_thread.is_alive():
            self._kiwi_cmd_q.put(self._kiwi_mod_cmd(freq_khz, mode))
            nb_flag = 1 if self.nb_enabled else 0
            self._kiwi_cmd_q.put(f"SET nb={nb_flag}")

    def start_kiwisdr(self, freq_khz: float, mode: str, title: str):
        self.stop_pipeline()
        self._build_appsrc_pipeline(12000)

        # Build candidate server order
        if self.selected_kiwi_idx > 0 and self.selected_kiwi_idx <= len(self.kiwi_servers):
            chosen = [self.kiwi_servers[self.selected_kiwi_idx - 1]] + self.kiwi_servers
        else:
            chosen = list(self.kiwi_servers)

        stop_ev = self._worker_stop

        def worker():
            for base_url, srv_label in chosen:
                if stop_ev.is_set():
                    return
                p = urllib.parse.urlparse(base_url)
                host = p.hostname
                port = p.port or 80
                if not host:
                    continue
                GLib.idle_add(self.on_status_cb, f"CONNECTING HF SDR: {srv_label[:38]}...")
                try:
                    ts = int(time.time())
                    sock = socket.create_connection((host, port), timeout=4.2)
                    key = base64.b64encode(os.urandom(16)).decode("ascii")
                    host_hdr = f"{host}:{port}" if p.port else host
                    req = (
                        f"GET /kiwi/{ts}/SND HTTP/1.1\r\n"
                        f"Host: {host_hdr}\r\n"
                        f"Upgrade: websocket\r\n"
                        f"Connection: Upgrade\r\n"
                        f"Sec-WebSocket-Key: {key}\r\n"
                        f"Sec-WebSocket-Version: 13\r\n\r\n"
                    )
                    sock.sendall(req.encode("ascii"))
                    hdr = b""
                    while b"\r\n\r\n" not in hdr:
                        ch = sock.recv(1024)
                        if not ch:
                            raise ConnectionError("EOF")
                        hdr += ch
                    if b"101" not in hdr.split(b"\r\n", 1)[0]:
                        sock.close()
                        continue

                    def ws_send(txt: str):
                        payload = txt.encode("utf-8")
                        mask = os.urandom(4)
                        masked = bytes(b ^ mask[i & 3] for i, b in enumerate(payload))
                        ln = len(payload)
                        frm = (
                            struct.pack("!BB", 0x81, 0x80 | ln)
                            if ln < 126
                            else struct.pack("!BBH", 0x81, 0x80 | 126, ln)
                        ) + mask + masked
                        sock.sendall(frm)

                    ws_send("SET auth t=kiwi p=")
                    buf = hdr.split(b"\r\n\r\n", 1)[1]
                    sock.settimeout(0.25)
                    adpcm_state = [0, 0]
                    tuned = False
                    got_audio = False
                    last_ka = time.time()
                    connect_t0 = time.time()

                    while not stop_ev.is_set():
                        # Drain live retune commands
                        while not self._kiwi_cmd_q.empty():
                            cmd = self._kiwi_cmd_q.get_nowait()
                            ws_send(cmd)

                        now = time.time()
                        if now - last_ka >= 4.5:
                            ws_send("SET keepalive")
                            last_ka = now
                        if not got_audio and now - connect_t0 > 5.0:
                            break  # Try next KiwiSDR if busy/redirected

                        try:
                            more = sock.recv(4096)
                            if not more:
                                break
                            buf += more
                        except socket.timeout:
                            continue

                        while len(buf) >= 2:
                            b0, b1 = buf[0], buf[1]
                            op = b0 & 0x0F
                            ln = b1 & 0x7F
                            off = 2
                            if ln == 126:
                                if len(buf) < 4:
                                    break
                                ln = struct.unpack("!H", buf[2:4])[0]
                                off = 4
                            elif ln == 127:
                                if len(buf) < 10:
                                    break
                                ln = struct.unpack("!Q", buf[2:10])[0]
                                off = 10
                            if len(buf) < off + ln:
                                break
                            pkt = buf[off : off + ln]
                            buf = buf[off + ln :]

                            if op == 8:
                                sock.close()
                                got_audio = False
                                break
                            if pkt[:3] == b"MSG":
                                txt = pkt[4:].decode("utf-8", "ignore")
                                if "too_busy=" in txt and not txt.endswith("too_busy=0"):
                                    buf = b""
                                    raise ConnectionError("busy")
                                m_sr = re.search(r"(?:audio_rate|sample_rate)=([\d.]+)", txt)
                                if m_sr and not tuned:
                                    rate = int(float(m_sr.group(1)))
                                    if self._appsrc is not None:
                                        self._appsrc.set_property(
                                            "caps",
                                            Gst.Caps.from_string(
                                                f"audio/x-raw,format=S16LE,channels=1,rate={rate},layout=interleaved"
                                            ),
                                        )
                                    ws_send(f"SET AR OK in={rate} out=44100")
                                    ws_send(self._kiwi_mod_cmd(freq_khz, mode))
                                    ws_send("SET agc=1 hang=0 thresh=-100 slope=6 decay=500 manGain=50")
                                    ws_send("SET ident_user=dtRadio")
                                    ws_send("SET compression=1")
                                    tuned = True
                            elif pkt[:3] == b"SND" and len(pkt) > 10:
                                flags = pkt[3]
                                smeter_raw = struct.unpack(">H", pkt[8:10])[0]
                                dbm = 0.1 * smeter_raw - 127.0
                                raw_audio = pkt[10:]
                                if flags & 0x10:
                                    pcm = decode_ima_adpcm(raw_audio, adpcm_state)
                                elif flags & 0x80:
                                    pcm = raw_audio
                                else:
                                    # Big-endian S16 -> Little-endian S16
                                    nsamp = len(raw_audio) // 2
                                    arr = array.array("h")
                                    arr.frombytes(raw_audio[: nsamp * 2])
                                    arr.byteswap()
                                    pcm = arr.tobytes()

                                if self._appsrc is not None and pcm:
                                    gbuf = Gst.Buffer.new_wrapped(pcm)
                                    self._appsrc.emit("push-buffer", gbuf)
                                if not got_audio:
                                    got_audio = True
                                    GLib.idle_add(self.on_meta_cb, f"RX via {srv_label}")
                                    GLib.idle_add(self.on_status_cb, f"LIVE HF SDR ({dbm:.0f} dBm) — {srv_label[:34]}")
                    try:
                        sock.close()
                    except Exception:
                        pass
                    if got_audio and stop_ev.is_set():
                        return
                except Exception:
                    continue
            if not stop_ev.is_set():
                GLib.idle_add(self.on_status_cb, "ALL KIWISDR SLOTS BUSY — SELECT ANOTHER KIWI RX OR WEB STREAM")

        self._worker_thread = threading.Thread(target=worker, daemon=True)
        self._worker_thread.start()

    # ---- Mode 3: Local USB RTL-SDR (`rtl_fm`) Engine ----
    def start_rtlsdr(self, freq_khz: float, mode: str, title: str):
        self.stop_pipeline()
        ok_hw, msg = detect_rtlsdr_status()
        if not ok_hw:
            self.on_status_cb(f"RTL-SDR STANDBY: {msg}")
            self.on_meta_cb("USB RTL-SDR slot ready — connect RTL2832U dongle anytime")
            return

        rate = 24000
        self._build_appsrc_pipeline(rate)
        m_map = {"NFM": "fm", "AM": "am", "USB": "usb", "LSB": "lsb", "CW": "usb"}
        rtl_m = m_map.get(mode.upper(), "fm")
        eff_hz = int((freq_khz + (self.clarifier_khz if self.clar_enabled else 0.0)) * 1000.0)
        sq_lvl = int(self.squelch * 120)
        cmd = [
            "rtl_fm",
            "-f", str(eff_hz),
            "-M", rtl_m,
            "-s", str(rate),
            "-r", str(rate),
            "-l", str(sq_lvl),
            "-",
        ]
        stop_ev = self._worker_stop

        def rtl_worker():
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
                self._rtl_proc = proc
                GLib.idle_add(self.on_status_cb, f"USB RTL-SDR ACTIVE: {freq_khz/1000.0:.4f} MHz ({mode})")
                while not stop_ev.is_set():
                    chunk = proc.stdout.read(2048) if proc.stdout else b""
                    if not chunk:
                        break
                    if self._appsrc is not None:
                        self._appsrc.emit("push-buffer", Gst.Buffer.new_wrapped(chunk))
            except Exception as e:
                GLib.idle_add(self.on_status_cb, f"RTL-SDR ERR: {e}")

        self._worker_thread = threading.Thread(target=rtl_worker, daemon=True)
        self._worker_thread.start()


