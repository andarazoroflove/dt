    # ---- Persistence ----
    def _load_memories(self) -> list[dict]:
        if MEM_FILE.is_file():
            try:
                data = json.loads(MEM_FILE.read_text(encoding="utf-8"))
                if isinstance(data, list) and len(data) == 12:
                    return data
            except Exception:
                pass
        return [dict(m) for m in DEFAULT_MEMORIES]

    def _save_memories(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        MEM_FILE.write_text(json.dumps(self.memories, indent=2), encoding="utf-8")

    def _load_saved_state(self):
        if STATE_FILE.is_file():
            try:
                st = json.loads(STATE_FILE.read_text(encoding="utf-8"))
                self.freq_khz = float(st.get("freq_khz", self.freq_khz))
                self.mode = str(st.get("mode", self.mode))
                self.source_kind = str(st.get("source", self.source_kind))
                self.current_url = str(st.get("url", self.current_url))
                self.station_title = str(st.get("title", self.station_title))
                self.knob_af.set_value(float(st.get("af_gain", 0.78)), notify=True)
                self.knob_rf.set_value(float(st.get("rf_gain", 0.80)), notify=True)
                self.knob_sq.set_value(float(st.get("squelch", 0.0)), notify=True)
                self.knob_if.set_value(float(st.get("if_width", 0.68)), notify=True)
                self.knob_tone.set_value(float(st.get("tone", 0.60)), notify=True)
                self._sync_mode_buttons()
