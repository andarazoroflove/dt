    # ---- Instrument Deck Drawing (S-Meter + Glowing VFD + Vernier Scale + VFO Wheel) ----
    def _draw_instrument_deck(self, w, cr: cairo.Context):
        alloc = w.get_allocation()
        W, H = float(alloc.width), float(alloc.height)

        # Recessed dark faceplate background
        cr.rectangle(0, 0, W, H)
        cr.set_source_rgb(0.12, 0.14, 0.17)
        cr.fill()

        pad = 8.0
        sm_w = max(215.0, W * 0.26)
        vfo_w = max(168.0, W * 0.19)
        vfd_x = pad + sm_w + 8.0
        vfd_w = max(260.0, W - vfd_x - vfo_w - pad - 8.0)

        self._vfo_geom = (W - pad - vfo_w * 0.5, H * 0.5, min(vfo_w, H) * 0.41)

        # ---- A. Warm Backlit Analog S-Meter ----
        sx, sy, sw, sh = pad, pad, sm_w, H - 2 * pad
        # Outer dark bezel
        cr.rectangle(sx, sy, sw, sh)
        cr.set_source_rgb(0.07, 0.08, 0.10)
        cr.fill()
        # Warm incandescent radial lamp glow
        mx, my, mw, mh = sx + 6, sy + 6, sw - 12, sh - 12
        glow = cairo.RadialGradient(mx + mw * 0.5, my + mh * 0.95, 8.0, mx + mw * 0.5, my + mh * 0.65, mw * 0.85)
        glow.add_color_stop_rgb(0.0, 1.00, 0.94, 0.74)
        glow.add_color_stop_rgb(0.65, 0.97, 0.85, 0.55)
        glow.add_color_stop_rgb(1.0, 0.84, 0.69, 0.38)
        cr.rectangle(mx, my, mw, mh)
        cr.set_source(glow)
        cr.fill()

        piv_x = mx + mw * 0.5
        piv_y = my + mh + 26.0
        arc_r = min(mw * 0.62, mh * 0.98)
        a0 = math.radians(-128.0)
        a1 = math.radians(-52.0)
        a_s9 = a0 + 0.58 * (a1 - a0)

        # S1..S9 black arc
        cr.set_line_width(2.2)
        cr.set_source_rgb(0.14, 0.12, 0.10)
        cr.arc(piv_x, piv_y, arc_r, a0, a_s9)
        cr.stroke()
        # +10..+60 dB red arc
        cr.set_line_width(3.2)
        cr.set_source_rgb(0.78, 0.14, 0.12)
        cr.arc(piv_x, piv_y, arc_r, a_s9, a1)
        cr.stroke()

        marks = [
            (0.00, "1", False),
            (0.14, "3", False),
            (0.29, "5", False),
            (0.43, "7", False),
            (0.58, "9", False),
            (0.72, "+20", True),
            (0.86, "+40", True),
            (1.00, "+60", True),
        ]
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(9.5)
        for frac, lbl, is_red in marks:
            ang = a0 + frac * (a1 - a0)
            cr.set_source_rgb(0.78, 0.14, 0.12) if is_red else cr.set_source_rgb(0.14, 0.12, 0.10)
            cr.set_line_width(1.7)
            cr.move_to(piv_x + (arc_r - 5) * math.cos(ang), piv_y + (arc_r - 5) * math.sin(ang))
            cr.line_to(piv_x + (arc_r + 6) * math.cos(ang), piv_y + (arc_r + 6) * math.sin(ang))
            cr.stroke()
            tx = piv_x + (arc_r + 16) * math.cos(ang)
            ty = piv_y + (arc_r + 16) * math.sin(ang)
            ext = cr.text_extents(lbl)
            cr.move_to(tx - ext.width * 0.5, ty + ext.height * 0.4)
            cr.show_text(lbl)

        # Minor S-unit ticks
        cr.set_line_width(1.0)
        cr.set_source_rgb(0.22, 0.18, 0.14)
        for i in range(25):
            ang = a0 + (i / 24.0) * (a1 - a0)
            cr.move_to(piv_x + (arc_r - 2.5) * math.cos(ang), piv_y + (arc_r - 2.5) * math.sin(ang))
            cr.line_to(piv_x + (arc_r + 2.5) * math.cos(ang), piv_y + (arc_r + 2.5) * math.sin(ang))
            cr.stroke()

        # 'S-UNITS / dB' legend
        cr.set_font_size(9.0)
        cr.set_source_rgb(0.24, 0.19, 0.12)
        cr.move_to(mx + 8, my + 15)
        cr.show_text("SIGNAL")
        if not self.engine.squelch_open:
            cr.set_source_rgb(0.75, 0.22, 0.12)
            cr.move_to(mx + mw - 42, my + 15)
            cr.show_text("SQL")

        # Ballistic S-Meter Needle (clipped inside meter window)
        cr.save()
        cr.rectangle(mx, my, mw, mh)
        cr.clip()
        n_ang = a0 + max(0.0, min(1.0, self.needle_norm)) * (a1 - a0)
        # Subtle needle shadow
        cr.set_line_width(2.2)
        cr.set_source_rgba(0.1, 0.08, 0.05, 0.35)
        cr.move_to(piv_x + 2.0, piv_y + 2.0)
        cr.line_to(piv_x + 2.0 + (arc_r + 9) * math.cos(n_ang), piv_y + 2.0 + (arc_r + 9) * math.sin(n_ang))
        cr.stroke()
        # Crisp crimson/black needle
        cr.set_line_width(2.0)
        cr.set_source_rgb(0.76, 0.11, 0.11)
        cr.move_to(piv_x, piv_y)
        cr.line_to(piv_x + (arc_r + 9) * math.cos(n_ang), piv_y + (arc_r + 9) * math.sin(n_ang))
        cr.stroke()
        # Pivot cap
        cr.arc(piv_x, my + mh + 4.0, 12.0, 0, 2 * math.pi)
        cr.set_source_rgb(0.16, 0.16, 0.18)
        cr.fill()
        cr.restore()

        # ---- B. Glowing Vacuum Fluorescent Display (VFD) + Vernier Dial ----
        vy, vh = pad, H - 2 * pad
        cr.rectangle(vfd_x, vy, vfd_w, vh)
        cr.set_source_rgb(0.03, 0.07, 0.07)
        cr.fill()
        # Recessed glass bevel
        cr.set_line_width(2.0)
        cr.set_source_rgb(0.01, 0.03, 0.03)
        cr.move_to(vfd_x, vy + vh)
        cr.line_to(vfd_x, vy)
        cr.line_to(vfd_x + vfd_w, vy)
        cr.stroke()
        cr.set_source_rgb(0.32, 0.37, 0.45)
        cr.move_to(vfd_x, vy + vh)
        cr.line_to(vfd_x + vfd_w, vy + vh)
        cr.line_to(vfd_x + vfd_w, vy)
        cr.stroke()

        # Top VFD Annunciator badges
        src_badge = {"kiwi": "HF KIWISDR", "stream": "WEB STREAM", "rtlsdr": "USB RTL-SDR"}.get(self.source_kind, "RX")
        badges = [
            (src_badge, True, (0.24, 0.98, 0.84)),
            ("NB", self.engine.nb_enabled, (0.36, 0.98, 0.62)),
            ("ANL", self.engine.anl_enabled, (0.36, 0.98, 0.62)),
            ("ATT", self.engine.att_enabled, (1.00, 0.72, 0.25)),
            ("CLAR", self.engine.clar_enabled, (1.00, 0.72, 0.25)),
            ("LOCK", self.dial_locked, (1.00, 0.45, 0.32)),
            ("REC", self.engine.recording, (1.00, 0.30, 0.30)),
        ]
        bx = vfd_x + 12.0
        cr.set_font_size(9.5)
        for btxt, bon, col in badges:
            ext = cr.text_extents(btxt)
            if bon:
                cr.set_source_rgba(col[0], col[1], col[2], 0.18)
                cr.rectangle(bx - 4, vy + 7, ext.width + 8, 15)
                cr.fill()
                cr.set_source_rgb(*col)
            else:
                cr.set_source_rgba(0.16, 0.34, 0.32, 0.48)
            cr.move_to(bx, vy + 18)
            cr.show_text(btxt)
            bx += ext.width + 13.0

        # Solar SFI/Kp badge at top-right of VFD
        cr.set_source_rgb(0.35, 0.85, 0.78)
        sext = cr.text_extents(self.solar_badge)
        cr.move_to(vfd_x + vfd_w - sext.width - 12, vy + 18)
        cr.show_text(self.solar_badge)

        # Main Glowing VFD Frequency Digits
        eff_khz = self.freq_khz + (self.engine.clarifier_khz if self.engine.clar_enabled else 0.0)
        if eff_khz >= 30000.0:
            freq_str = f"{eff_khz / 1000.0:07.3f}"
            unit_str = "MHz"
        else:
            mhz = int(eff_khz) // 1000
            rem = eff_khz - mhz * 1000.0
            freq_str = f"{mhz:2d}.{rem:06.2f}"
            unit_str = "kHz"

        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(36.0)
        # Phosphor halo glow
        cr.set_source_rgba(0.18, 0.98, 0.84, 0.18)
        cr.move_to(vfd_x + 17.5, vy + 66.5)
        cr.show_text(freq_str)
        # Crisp bright VFD segments
        cr.set_source_rgb(0.26, 0.99, 0.86)
        cr.move_to(vfd_x + 16.0, vy + 65.0)
        cr.show_text(freq_str)

        f_ext = cr.text_extents(freq_str)
        cr.set_font_size(13.0)
        cr.set_source_rgb(0.45, 0.90, 0.82)
        cr.move_to(vfd_x + 24.0 + f_ext.width, vy + 65.0)
        cr.show_text(unit_str)

        # Amber Mode Pill on right of frequency
        cr.set_font_size(15.0)
        m_ext = cr.text_extents(self.mode)
        mx0 = vfd_x + vfd_w - m_ext.width - 24.0
        cr.set_source_rgba(1.0, 0.68, 0.18, 0.18)
        cr.rectangle(mx0 - 7, vy + 43, m_ext.width + 14, 24)
        cr.fill()
        cr.set_source_rgb(1.0, 0.74, 0.24)
        cr.move_to(mx0, vy + 61)
        cr.show_text(self.mode)

        # Station / Live Alert / Flash Memory Sub-line
        cr.set_font_size(10.5)
        now = time.time()
        if now < self.flash_until and self.flash_vfd_msg:
            cr.set_source_rgb(1.0, 0.76, 0.24)
            line1 = self.flash_vfd_msg
        else:
            cr.set_source_rgb(0.58, 0.96, 0.88)
            line1 = self.station_title

        cr.save()
        cr.rectangle(vfd_x + 12, vy + 72, vfd_w - 24, 38)
        cr.clip()
        cr.move_to(vfd_x + 14, vy + 86)
        cr.show_text(line1[:58])
        if self.live_meta:
            cr.set_font_size(9.2)
            cr.set_source_rgb(0.38, 0.78, 0.72)
            cr.move_to(vfd_x + 14, vy + 102)
            cr.show_text(self.live_meta[:66])
        cr.restore()

        # Illuminated Analog Vernier Slide-Rule Scale at bottom of VFD
        sy0 = vy + vh - 46.0
        sh0 = 38.0
        cr.save()
        cr.rectangle(vfd_x + 8, sy0, vfd_w - 16, sh0)
        cr.clip()
        cr.set_source_rgb(0.05, 0.11, 0.11)
        cr.rectangle(vfd_x + 8, sy0, vfd_w - 16, sh0)
        cr.fill()

        mid_x = vfd_x + vfd_w * 0.5
        px_per_khz = 14.0
        base_k = int(math.floor(eff_khz))
        frac_k = eff_khz - base_k
        cr.set_font_size(8.8)
        for dk in range(-22, 23):
            k_val = base_k + dk
            if k_val < 0:
                continue
            tx = mid_x + (dk - frac_k) * px_per_khz
            if tx < vfd_x + 6 or tx > vfd_x + vfd_w - 6:
                continue
            if k_val % 10 == 0:
                th = 15.0
                cr.set_line_width(1.6)
                cr.set_source_rgb(0.36, 0.96, 0.84)
                lbl_k = f"{k_val}" if k_val < 30000 else f"{k_val/1000.0:.2f}"
                ext_k = cr.text_extents(lbl_k)
                cr.move_to(tx - ext_k.width * 0.5, sy0 + 33.0)
                cr.show_text(lbl_k)
            elif k_val % 5 == 0:
                th = 10.5
                cr.set_line_width(1.2)
                cr.set_source_rgb(0.26, 0.74, 0.66)
            else:
                th = 6.5
                cr.set_line_width(0.9)
                cr.set_source_rgb(0.18, 0.52, 0.48)
            cr.move_to(tx, sy0 + 3.0)
            cr.line_to(tx, sy0 + 3.0 + th)
            cr.stroke()

        # Red illuminated center hairline cursor
        cr.set_line_width(2.0)
        cr.set_source_rgb(1.0, 0.28, 0.22)
        cr.move_to(mid_x, sy0)
        cr.line_to(mid_x, sy0 + sh0)
        cr.stroke()
        cr.restore()

        # ---- C. Spun-Aluminum Main VFO Tuning Wheel ----
        vcx, vcy, vr = self._vfo_geom
        # Outer recessed bezel shadow
        cr.arc(vcx + 2, vcy + 3, vr + 5, 0, 2 * math.pi)
        cr.set_source_rgba(0.03, 0.04, 0.05, 0.85)
        cr.fill()

        # Knurled rubber grip ring
        cr.arc(vcx, vcy, vr + 4, 0, 2 * math.pi)
        cr.set_source_rgb(0.14, 0.16, 0.20)
        cr.fill()
        cr.set_line_width(1.4)
        cr.set_source_rgb(0.36, 0.40, 0.48)
        for i in range(36):
            ang = self._vfo_angle + i * (2 * math.pi / 36.0)
            cr.move_to(vcx + (vr + 0.5) * math.cos(ang), vcy + (vr + 0.5) * math.sin(ang))
            cr.line_to(vcx + (vr + 4.0) * math.cos(ang), vcy + (vr + 4.0) * math.sin(ang))
            cr.stroke()

        # Brushed aluminum flywheel face
        vpat = cairo.LinearGradient(vcx - vr, vcy - vr, vcx + vr, vcy + vr)
        vpat.add_color_stop_rgb(0.0, 0.88, 0.90, 0.95)
        vpat.add_color_stop_rgb(0.45, 0.58, 0.62, 0.70)
        vpat.add_color_stop_rgb(1.0, 0.30, 0.34, 0.41)
        cr.arc(vcx, vcy, vr - 1.0, 0, 2 * math.pi)
        cr.set_source(vpat)
        cr.fill()

        # Inner concentric machined ring
        cr.set_line_width(1.2)
        cr.set_source_rgba(0.20, 0.23, 0.28, 0.7)
        cr.arc(vcx, vcy, vr * 0.70, 0, 2 * math.pi)
        cr.stroke()

        # Orbiting finger dimple
        dim_r = vr * 0.53
        dx = vcx + dim_r * math.cos(self._vfo_angle)
        dy = vcy + dim_r * math.sin(self._vfo_angle)
        dpat = cairo.RadialGradient(dx - 3, dy - 3, 1.5, dx, dy, vr * 0.22)
        dpat.add_color_stop_rgb(0.0, 0.16, 0.18, 0.22)
        dpat.add_color_stop_rgb(1.0, 0.42, 0.46, 0.54)
        cr.arc(dx, dy, vr * 0.21, 0, 2 * math.pi)
        cr.set_source(dpat)
        cr.fill()

        cr.set_font_size(9.0)
        cr.set_source_rgb(0.78, 0.83, 0.90)
        v_lbl = "MAIN VFO"
        v_ext = cr.text_extents(v_lbl)
        cr.move_to(vcx - v_ext.width * 0.5, vy + vh - 2.0)
        cr.show_text(v_lbl)
        return False

    # ---- VFO Wheel Mouse & Scroll Interaction ----
    def _on_deck_press(self, _w, ev):
        if ev.button == 1 and hasattr(self, "_vfo_geom"):
            vcx, vcy, vr = self._vfo_geom
            if math.hypot(ev.x - vcx, ev.y - vcy) <= vr + 12:
                self._vfo_dragging = True
                self._vfo_last_ang = math.atan2(ev.y - vcy, ev.x - vcx)
                return True
        return False

    def _on_deck_release(self, _w, _ev):
        self._vfo_dragging = False
        return False

    def _on_deck_motion(self, _w, ev):
        if self._vfo_dragging and hasattr(self, "_vfo_geom"):
            vcx, vcy, _vr = self._vfo_geom
            ang = math.atan2(ev.y - vcy, ev.x - vcx)
            da = ang - self._vfo_last_ang
            while da > math.pi:
                da -= 2 * math.pi
            while da < -math.pi:
                da += 2 * math.pi
            self._vfo_last_ang = ang
            if not self.dial_locked:
                self._vfo_angle += da
                steps = da / (math.pi / 14.0)
                self._nudge_vfo(steps * self.step_khz)
            return True
        return False

    def _on_deck_scroll(self, _w, ev):
        if self.dial_locked:
            return True
        if ev.direction == Gdk.ScrollDirection.UP:
            self._vfo_angle += 0.22
            self._nudge_vfo(+self.step_khz)
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            self._vfo_angle -= 0.22
            self._nudge_vfo(-self.step_khz)
        elif ev.direction == Gdk.ScrollDirection.SMOOTH:
            _, _dx, dy = ev.get_scroll_deltas()
            self._vfo_angle -= dy * 0.18
            self._nudge_vfo(-dy * self.step_khz)
        return True

    def _nudge_vfo(self, delta_khz: float):
        if self.dial_locked:
            self._flash_vfd("DIAL LOCKED")
            return
        # If currently on a web stream below 30 MHz and user spins VFO, seamlessly hand off to live HF KiwiSDR!
        if self.source_kind == "stream" and self.freq_khz <= 30000.0:
            self.source_kind = "kiwi"
            self.station_title = "MANUAL VFO TUNING (LIVE HF SDR)"
            self.live_meta = ""
            self.freq_khz = max(10.0, min(30000.0, self.freq_khz + delta_khz))
            self._tune_current()
            return

        if self.source_kind == "rtlsdr":
            self.freq_khz = max(24000.0, min(1766000.0, self.freq_khz + delta_khz))
            self._tune_current()
        else:
            self.freq_khz = max(10.0, min(30000.0, self.freq_khz + delta_khz))
            self.engine.retune_kiwi_live(self.freq_khz, self.mode)
        self.deck_area.queue_draw()

    # ---- Station & Bank Selection ----
    def _populate_channels_for_bank(self, bank_idx: int, tune: bool = True):
        if bank_idx < 0 or bank_idx >= len(STATION_BANKS):
            return
        self._updating_combos = True
        self.chan_combo.remove_all()
        for item in STATION_BANKS[bank_idx][1]:
            self.chan_combo.append_text(item["title"])
        self.chan_combo.set_active(0)
        self._updating_combos = False
        if tune:
            self._apply_channel_dict(STATION_BANKS[bank_idx][1][0])

    def _on_bank_changed(self, combo):
        if self._updating_combos:
            return
        idx = combo.get_active()
        if idx >= 0:
            self._populate_channels_for_bank(idx, tune=True)

    def _on_channel_changed(self, combo):
        if self._updating_combos:
            return
        b_idx = self.bank_combo.get_active()
        c_idx = combo.get_active()
        if b_idx >= 0 and c_idx >= 0 and c_idx < len(STATION_BANKS[b_idx][1]):
            self.active_mem_idx = -1
            self._refresh_memory_labels()
            self._apply_channel_dict(STATION_BANKS[b_idx][1][c_idx])

    def _on_kiwi_changed(self, combo):
        idx = combo.get_active()
        if idx >= 0:
            self.engine.selected_kiwi_idx = idx
            if self.source_kind == "kiwi":
                self._tune_current()

    def _apply_channel_dict(self, ch: dict):
        self.station_title = ch["title"]
        self.freq_khz = float(ch["freq_khz"])
        self.mode = ch["mode"]
        self.source_kind = ch["source"]
        self.current_url = ch.get("url", "")
        self.live_meta = ""
        self._sync_mode_buttons()
        self._tune_current()

    def _tune_current(self):
        self.deck_area.queue_draw()
        self._save_state()
        if self.source_kind == "stream" and self.current_url:
            self.engine.start_web_stream(self.current_url, self.station_title)
        elif self.source_kind == "rtlsdr":
            self.engine.start_rtlsdr(self.freq_khz, self.mode, self.station_title)
        else:
            self.engine.start_kiwisdr(self.freq_khz, self.mode, self.station_title)

    # ---- Direct Orange [FEMA / EMERG] & Blue [NOAA WX] Buttons ----
    def _on_noaa_clicked(self, _btn):
        noaa_bank_idx = 3
        noaa_list = STATION_BANKS[noaa_bank_idx][1]
        ch = noaa_list[self.noaa_cycle_idx % len(noaa_list)]
        self.noaa_cycle_idx = (self.noaa_cycle_idx + 1) % len(noaa_list)

        self._updating_combos = True
        self.bank_combo.set_active(noaa_bank_idx)
        self.chan_combo.remove_all()
        for item in noaa_list:
            self.chan_combo.append_text(item["title"])
        self.chan_combo.set_active((self.noaa_cycle_idx - 1) % len(noaa_list))
        self._updating_combos = False

        self.active_mem_idx = -1
        self._refresh_memory_labels()
        self._flash_vfd("NOAA ALL-HAZARDS WX")
        self._apply_channel_dict(ch)

    def _on_fema_clicked(self, _btn):
        fema_bank_idx = 4
        fema_list = STATION_BANKS[fema_bank_idx][1]
