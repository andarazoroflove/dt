    # ---- 12-Channel Hold-to-Save Memory Bank ----
    def _refresh_memory_labels(self):
        for i, mb in enumerate(self.mem_btns):
            m = self.memories[i]
            mb.set_label(f"M{i+1:02d}\n{m.get('label', 'MEM')[:7]}")
            mb.set_tooltip_text(f"M{i+1:02d}: {m.get('title', '')}\n(Click: Recall | Hold 0.65s: Save Current)")
            ctx = mb.get_style_context()
            if i == self.active_mem_idx:
                ctx.add_class("mem-active")
            else:
                ctx.remove_class("mem-active")

    def _on_mem_press(self, _w, ev, idx: int):
        if ev.button != 1:
            return False
        self._mem_held_fired.discard(idx)
        tid = GLib.timeout_add(650, self._store_memory_on_hold, idx)
        self._mem_hold_timer[idx] = tid
        return False

    def _store_memory_on_hold(self, idx: int):
        self._mem_hold_timer.pop(idx, None)
        self._mem_held_fired.add(idx)
        short = f"{self.freq_khz/1000.0:.2f}M" if self.freq_khz >= 30000 else f"{int(self.freq_khz)}k"
        self.memories[idx] = {
            "label": short[:7],
            "title": self.station_title,
            "freq_khz": self.freq_khz,
            "mode": self.mode,
            "source": self.source_kind,
            "url": self.current_url,
        }
        self.active_mem_idx = idx
        self._save_memories()
        self._refresh_memory_labels()
        self._flash_vfd(f"★ MEMORY M{idx+1:02d} STORED ({short})")
        self._set_status(f"STORED FAVORITE TO M{idx+1:02d}: {self.station_title[:46]}")
        return False

    def _on_mem_release(self, _w, ev, idx: int):
        if ev.button != 1:
            return False
        tid = self._mem_hold_timer.pop(idx, None)
        if tid is not None:
            GLib.source_remove(tid)
        if idx in self._mem_held_fired:
            self._mem_held_fired.discard(idx)
            return True
        self.active_mem_idx = idx
        self._refresh_memory_labels()
        self._apply_channel_dict(self.memories[idx])
        return False

    # ---- Telemetry, Alerts & S-Meter Ballistics ----
    def _flash_vfd(self, msg: str, dur: float = 2.2):
        self.flash_vfd_msg = msg
        self.flash_until = time.time() + dur
        self.deck_area.queue_draw()

    def _on_audio_level(self, rms_db: float, norm: float, _sq_open: bool):
        # Add realistic gentle HF atmospheric micro-flutter around RMS level
        self.peak_db = rms_db
        self.target_s_norm = max(0.04, min(0.98, norm * self.engine.rf_gain * (0.55 if self.engine.att_enabled else 1.05)))

    def _on_stream_meta(self, txt: str):
        self.live_meta = txt
        self.deck_area.queue_draw()

    def _set_status(self, txt: str):
        self.status_lbl.set_text(txt)

    def _tick_meter_and_vfd(self):
        # Analog needle ballistics: fast attack, Fast/Slow AGC release
        diff = self.target_s_norm - self.needle_norm
        if diff > 0:
            self.needle_norm += diff * 0.42
        else:
            decay = 0.08 if self.engine.agc_slow else 0.22
            self.needle_norm += diff * decay
        # Gentle decay toward noise floor if stream pauses
        self.target_s_norm = max(0.03, self.target_s_norm * 0.96)
        self.deck_area.queue_draw()
        return True

    def _bg_fetch_kiwis_and_solar(self):
        # 1. Fetch NOAA SWPC Solar Flux & Kp Index
        try:
            sfi_raw = urllib.request.urlopen(
                urllib.request.Request("https://services.swpc.noaa.gov/json/f107_cm_flux.json", headers={"User-Agent": UA}),
                timeout=6.0,
            ).read()
            sfi_arr = json.loads(sfi_raw)
            sfi_val = int(float(sfi_arr[-1].get("flux", 0))) if sfi_arr else 0

            kp_raw = urllib.request.urlopen(
                urllib.request.Request("https://services.swpc.noaa.gov/products/noaa-planetary-k-index.json", headers={"User-Agent": UA}),
                timeout=6.0,
            ).read()
            kp_arr = json.loads(kp_raw)
            kp_val = kp_arr[-1][1] if len(kp_arr) > 1 else "?"
            GLib.idle_add(self._set_solar_badge, f"SFI {sfi_val} · Kp {kp_val}")
        except Exception:
            pass

        # 2. Fetch live open KiwiSDRs from rx.linkfanel.net
        try:
            js = urllib.request.urlopen(
                urllib.request.Request("http://rx.linkfanel.net/kiwisdr_com.js", headers={"User-Agent": UA}),
                timeout=9.0,
            ).read().decode("utf-8", errors="ignore")
            entries = re.findall(r'\{[^{}]*"url"\s*:\s*"http://[^"]+"[^{}]*\}', js)
            found: list[tuple[int, str, str]] = []
            for raw in entries:
                try:
                    o = json.loads(raw)
                except Exception:
                    continue
                u = o.get("url", "")
                if ".proxy.kiwisdr.com" in u and not re.search(r":\d+$", u):
                    continue  # Avoid HTTP 307 redirects on port-80 proxy aliases
                users = int(o.get("users", 99))
                umax = int(o.get("users_max", 0))
                if o.get("offline") == "no" and 0 <= users < umax <= 12:
                    loc = o.get("loc", "")
                    nm = o.get("name", "")
                    prio = 100 if any(k in (loc + " " + nm).upper() for k in ("USA", ", US", "CANADA", "ONTARIO", "UTAH", "TEXAS", "MA", "WA", "VA", "NY", "CA")) else 10
                    found.append((prio + (umax - users), u, f"{nm[:22]} ({users}/{umax})"))
            found.sort(reverse=True)
            merged = list(SEED_KIWISDRS)
            seen_u = {u for u, _ in merged}
            for _sc, u, lbl in found[:24]:
                if u not in seen_u:
                    seen_u.add(u)
                    merged.append((u, lbl))
            GLib.idle_add(self._update_kiwi_combo, merged)
        except Exception:
            pass

    def _set_solar_badge(self, txt: str):
        self.solar_badge = txt
        self.deck_area.queue_draw()

    def _update_kiwi_combo(self, servers: list[tuple[str, str]]):
        self.engine.kiwi_servers = servers
        cur = self.kiwi_combo.get_active()
        self.kiwi_combo.remove_all()
        self.kiwi_combo.append_text("AUTO HF ANTENNA")
        for _u, lbl in servers:
            self.kiwi_combo.append_text(lbl[:28])
        self.kiwi_combo.set_active(max(0, cur))

    def _bg_fetch_fema_and_eas_alerts(self):
        parts = []
        try:
            req = urllib.request.Request(
                "https://www.fema.gov/api/open/v2/DisasterDeclarationsSummaries?$orderby=declarationDate%20desc&$top=2",
                headers={"User-Agent": UA, "Accept": "application/json"},
            )
            data = json.loads(urllib.request.urlopen(req, timeout=6.0).read())
            for d in data.get("DisasterDeclarationsSummaries", [])[:2]:
                st = d.get("state", "")
                ttl = d.get("declarationTitle", "")
                if st and ttl:
                    parts.append(f"FEMA [{st}]: {ttl}")
        except Exception:
            pass
        try:
            req2 = urllib.request.Request(
                "https://api.weather.gov/alerts/active?severity=Extreme,Severe&limit=2",
                headers={"User-Agent": UA, "Accept": "application/geo+json"},
            )
            data2 = json.loads(urllib.request.urlopen(req2, timeout=6.0).read())
            for feat in data2.get("features", [])[:2]:
                hl = feat.get("properties", {}).get("headline", "")
                if hl:
                    parts.append(hl)
        except Exception:
            pass
        if parts:
            GLib.idle_add(self._on_stream_meta, "  •  ".join(parts))

    # ---- Automated Self-Test Mode (--self-test) ----
    def _run_self_test(self, step: int):
        if step == 0:
            self._on_noaa_clicked(self.btn_noaa)
            GLib.timeout_add(900, self._run_self_test, 1)
        elif step == 1:
            self._on_fema_clicked(self.btn_fema)
            GLib.timeout_add(900, self._run_self_test, 2)
        elif step == 2:
            # Test KiwiSDR live 10.000 MHz WWV tuning + Clarifier + NB
            self._toggle_nb(self.btn_nb)
            self.knob_clar.set_value(0.55, notify=True)
            self._apply_channel_dict(STATION_BANKS[0][1][0])
            GLib.timeout_add(1400, self._run_self_test, 3)
        else:
            print("DTRADIO_SELF_TEST_OK")
            sys.stdout.flush()
            self.destroy()
        return False

    def _on_destroy(self, _w):
        self._save_state()
        self.engine.stop_pipeline()
        Gtk.main_quit()


