    def _on_drop(self, _w, context, _x, _y, data, _info, time_):
        uris = data.get_uris()
        cand = None
        if uris:
            for u in uris:
                if u.startswith("file://"):
                    p = Path(urllib.parse.unquote(urllib.parse.urlparse(u).path))
                    if p.is_file():
                        cand = p
                        break
        if not cand:
            raw = (data.get_text() or "").strip().splitlines()
            if raw:
                t = raw[0].strip()
                p = Path(urllib.parse.unquote(urllib.parse.urlparse(t).path)) if t.startswith("file://") else Path(t)
                if p.is_file():
                    cand = p
        Gtk.drag_finish(context, bool(cand), False, time_)
        if cand:
            self.load_pdf(cand)

    def load_pdf(self, pdf_path: Path, restore_page: int = 0):
        try:
            rp = pdf_path.expanduser().resolve()
            uri = rp.as_uri()
            doc = EvinceDocument.Document.factory_get_document(uri)
            self.doc = doc
            self.current_path = rp
            self.model.set_document(doc)

            n_pages = doc.get_n_pages()
            self.lbl_pages.set_text(f"/ {n_pages}")
            self._rebuild_sidebar(n_pages)

            if 0 <= restore_page < n_pages:
                self.model.set_page(restore_page)
            self._sync_page_ui()

            is_form = has_interactive_forms(doc)
            if is_form:
                self.form_banner.show()
                self.lbl_status.set_text(f"Loaded '{rp.name}' ({n_pages} pages) — Interactive Fillable PDF Form")
            else:
                self.form_banner.hide()
                self.lbl_status.set_text(f"Loaded '{rp.name}' ({n_pages} pages)")
            self.set_title(f"{rp.name} — dtReader")
        except Exception as exc:
            self._error(f"Failed to open PDF '{pdf_path}':\n{exc}")

    def _rebuild_sidebar(self, n_pages: int):
        for ch in self.page_list.get_children():
            self.page_list.remove(ch)
        for i in range(n_pages):
            row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label=f"  Page {i + 1}", xalign=0, margin=4)
            row.add(lbl)
            self.page_list.add(row)
        self.page_list.show_all()

    def _on_sidebar_row_selected(self, _lb, row):
        if row is not None and self.doc is not None:
            idx = row.get_index()
            if idx != self.model.get_page():
                self.model.set_page(idx)

    def _on_page_changed(self, *_args):
        self._sync_page_ui()

    def _sync_page_ui(self):
        if not self.doc:
            return
        cur = self.model.get_page()
        self.ent_page.set_text(str(cur + 1))
        r = self.page_list.get_row_at_index(cur)
        if r and r != self.page_list.get_selected_row():
            self.page_list.select_row(r)

    def _on_page_entry(self, _ent):
        if not self.doc:
            return
        try:
            p = int(self.ent_page.get_text().strip()) - 1
            p = max(0, min(p, self.doc.get_n_pages() - 1))
            self.model.set_page(p)
        except ValueError:
            self._sync_page_ui()

    def on_open(self, *_args):
        dlg = Gtk.FileChooserDialog(title="Open PDF Document — dtReader", parent=self, action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Open", Gtk.ResponseType.OK)
        flt = Gtk.FileFilter()
        flt.set_name("PDF Documents (*.pdf)")
        flt.add_pattern("*.pdf")
        flt.add_pattern("*.PDF")
        flt.add_mime_type("application/pdf")
        dlg.add_filter(flt)
        if dlg.run() == Gtk.ResponseType.OK:
            self.load_pdf(Path(dlg.get_filename()))
        dlg.destroy()

    def _commit_active_focus(self):
        """Move focus away from any active inline PDF Entry widget so its text commits to Poppler before saving."""
        self.set_focus(None)
        while Gtk.events_pending():
            Gtk.main_iteration_do(False)

    def on_save(self, *_args):
        if not self.doc or not self.current_path:
            return
        self._commit_active_focus()
        cur_page = self.model.get_page()
        parent_dir = self.current_path.parent
        try:
            # Poppler cannot overwrite an mmap'd source PDF directly; write sibling temp & atomic replace
            fd, tmp_str = tempfile.mkstemp(prefix=f".{self.current_path.stem}_", suffix=".pdf", dir=str(parent_dir))
            os.close(fd)
            tmp_path = Path(tmp_str)
            try:
                self.doc.save(tmp_path.as_uri())
                os.replace(tmp_path, self.current_path)
            finally:
                tmp_path.unlink(missing_ok=True)
            self.load_pdf(self.current_path, restore_page=cur_page)
            self.lbl_status.set_text(f"Saved filled PDF changes to {self.current_path}")
        except Exception as exc:
            self._error(f"Could not save '{self.current_path.name}' (try Save As...):\n{exc}")

    def on_save_as(self, *_args):
        if not self.doc:
            return
        self._commit_active_focus()
        dlg = Gtk.FileChooserDialog(title="Save PDF As — dtReader", parent=self, action=Gtk.FileChooserAction.SAVE)
        dlg.set_do_overwrite_confirmation(True)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save PDF", Gtk.ResponseType.OK)
        if self.current_path:
            dlg.set_current_folder(str(self.current_path.parent))
            dlg.set_current_name(self.current_path.name)
        else:
            dlg.set_current_name("filled_document.pdf")
        if dlg.run() == Gtk.ResponseType.OK:
            dest = Path(dlg.get_filename()).resolve()
            dlg.destroy()
            cur_page = self.model.get_page()
            try:
                if self.current_path and dest == self.current_path:
                    self.on_save()
                    return
                self.doc.save(dest.as_uri())
                self.load_pdf(dest, restore_page=cur_page)
                self.lbl_status.set_text(f"Saved PDF as {dest}")
            except Exception as exc:
                self._error(f"Save As failed:\n{exc}")
        else:
            dlg.destroy()

    def on_print(self, *_args):
        if not self.doc:
            return
        try:
            pop = EvinceView.PrintOperation.new(self.doc)
            pop.run(self)
        except Exception as exc:
            self._error(f"Print error:\n{exc}")

    def on_zoom_in(self, *_args):
        self.model.set_sizing_mode(EvinceView.SizingMode.FREE)
        if self.view.can_zoom_in():
            self.view.zoom_in()

    def on_zoom_out(self, *_args):
        self.model.set_sizing_mode(EvinceView.SizingMode.FREE)
        if self.view.can_zoom_out():
            self.view.zoom_out()

    def _set_sizing(self, mode: str):
        if mode == "fit_width":
            self.model.set_sizing_mode(EvinceView.SizingMode.FIT_WIDTH)
        elif mode == "fit_page":
            self.model.set_sizing_mode(EvinceView.SizingMode.FIT_PAGE)

    def _on_zoom_combo(self, cmb):
        zid = cmb.get_active_id()
        if not zid:
            return
        if zid in ("fit_width", "fit_page"):
            self._set_sizing(zid)
        else:
            self.model.set_sizing_mode(EvinceView.SizingMode.FREE)
            self.model.set_scale(float(zid))

    def _rotate(self, delta: int):
        cur = self.model.get_rotation()
        self.model.set_rotation((cur + delta) % 360)

    def on_toggle_sidebar(self, *_args):
        if self.side_frame.get_visible():
            self.side_frame.hide()
        else:
            self.side_frame.show()

    def on_toggle_find(self, *_args):
        if self.find_bar.get_visible():
            self.find_bar.hide()
            self.view.find_set_highlight_search(False)
        else:
            self.find_bar.show()
            self.ent_find.grab_focus()

    def _on_find_changed(self, _ent):
        if not self.doc:
            return
        txt = self.ent_find.get_text().strip()
        if not txt:
            self.view.find_set_highlight_search(False)
            return
        try:
            job = EvinceView.JobFind.new(self.doc, self.model.get_page(), self.doc.get_n_pages(), txt, False)
            self.view.find_started(job)
            self.view.find_set_highlight_search(True)
            EvinceView.Job.scheduler_push_job(job, EvinceView.JobPriority.PRIORITY_NONE)
        except Exception:
            pass

    def on_about(self, *_args):
        md = Gtk.MessageDialog(
            transient_for=self, flags=0, message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK, text="dtReader — CDE PDF Reader & Form Filler",
        )
        md.format_secondary_text(
            "Native Common Desktop Environment PDF viewer and interactive AcroForm editor.\n"
            "Click fillable fields directly on any PDF form and press Ctrl+S (or Save As) to save."
        )
        md.run()
        md.destroy()

    def _error(self, msg: str):
        md = Gtk.MessageDialog(transient_for=self, flags=0, message_type=Gtk.MessageType.ERROR,
                               buttons=Gtk.ButtonsType.OK, text=msg)
        md.run()
        md.destroy()


def main():
    EvinceDocument.init()
    provider = Gtk.CssProvider()
    provider.load_from_data(load_cde_css())
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    init_pdf = Path(sys.argv[1]).expanduser() if len(sys.argv) > 1 else None
    win = DtReaderWindow(init_pdf)
    win.connect("destroy", Gtk.main_quit)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
