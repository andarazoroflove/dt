    return css.encode("utf-8")


def has_interactive_forms(doc) -> bool:
    if not isinstance(doc, EvinceDocument.DocumentForms):
        return False
    try:
        n = doc.get_n_pages()
        for i in range(min(n, 50)):
            page = doc.get_page(i)
            mapping = doc.get_form_field_mapping(page)
            if mapping and mapping.length() > 0:
                return True
    except Exception:
        # Even if length helper differs across GI bindings, truthy non-empty MappingList check
        try:
            for i in range(min(doc.get_n_pages(), 50)):
                m = doc.get_form_field_mapping(doc.get_page(i))
                if m:
                    return True
        except Exception:
            pass
    return False


