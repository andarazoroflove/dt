    }}
    button:active, button:checked {{
        border-top: 2px solid #565a69;
        border-left: 2px solid #565a69;
        border-right: 2px solid #e6e9f2;
        border-bottom: 2px solid #e6e9f2;
    }}
    button.cde-save {{
        background-color: #266048;
        color: #ffffff;
        border-top: 2px solid #52997b;
        border-left: 2px solid #52997b;
        border-right: 2px solid #113023;
        border-bottom: 2px solid #113023;
        font-weight: bold;
    }}
