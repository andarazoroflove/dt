#!/usr/bin/env python3
"""
dtReader — Common Desktop Environment (CDE) PDF Reader & Fillable Form Editor
Powered by EvinceDocument 3.0 + EvinceView 3.0 (Poppler + native AcroForm engine).

Features:
- Crisp PDF viewing with thumbnails/outline sidebar, zoom, rotation, search, & print
- Interactive fillable PDF form editing directly on the page (text fields, checkboxes,
  radio buttons, combo boxes/dropdowns)
- Atomic Save (Ctrl+S) and Save As (Ctrl+Shift+S) preserving filled AcroForm data
- Styled natively to match CDE's active OSF/Motif palette
"""

import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.parse
from pathlib import Path

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("EvinceDocument", "3.0")
gi.require_version("EvinceView", "3.0")
from gi.repository import EvinceDocument, EvinceView, Gdk, GLib, Gtk

HOME = Path.home()
DT_ICONS = HOME / ".dt" / "icons"


def load_cde_css() -> bytes:
    chrome = "#aeb2c3"
    sel = "#2c567e"
    well = "#fff7e9"
    try:
        out = subprocess.check_output(["xrdb", "-query"], text=True, stderr=subprocess.DEVNULL)
        pal_name = "Crimson.dp"
        for ln in out.splitlines():
            if "ColorPalette:" in ln:
                pal_name = ln.split(":", 1)[1].strip()
                break
        for pdir in (HOME / ".dt/palettes", Path("/usr/dt/palettes")):
            pf = pdir / pal_name
            if pf.is_file():
                hexes = [l.strip() for l in pf.read_text().splitlines() if l.strip().startswith("#")]
                if len(hexes) >= 4:
                    def norm16(h):
                        h = h.lstrip("#")
                        return f"#{h[0:2]}{h[4:6]}{h[8:10]}" if len(h) == 12 else "#" + h[:6]
                    chrome = norm16(hexes[1])
                    sel = norm16(hexes[2])
                    well = norm16(hexes[3])
                break
    except Exception:
        pass

    css = f"""
    window, dialog, .background {{
        background-color: {chrome};
        color: #101014;
        font-family: "DejaVu Sans", "Liberation Sans", sans-serif;
        font-size: 10pt;
    }}
    menubar {{
        background-color: {chrome};
        border-bottom: 2px solid #585c6c;
    }}
    menuitem:hover {{
        background-color: {sel};
        color: #ffffff;
    }}
    .cde-toolbar {{
        background-color: {chrome};
        padding: 4px 6px;
        border-top: 2px solid #e6e9f2;
        border-left: 2px solid #e6e9f2;
        border-right: 2px solid #585c6c;
        border-bottom: 2px solid #585c6c;
    }}
    .cde-form-banner {{
        background-color: #eef4db;
        color: #163020;
        padding: 4px 10px;
        border-bottom: 2px solid #585c6c;
        font-weight: bold;
    }}
    .cde-status {{
        background-color: {chrome};
        padding: 3px 8px;
        border-top: 2px solid #585c6c;
        border-left: 2px solid #585c6c;
        border-right: 2px solid #e6e9f2;
        border-bottom: 2px solid #e6e9f2;
    }}
    frame {{
        border-top: 2px solid #585c6c;
        border-left: 2px solid #585c6c;
        border-right: 2px solid #e6e9f2;
        border-bottom: 2px solid #e6e9f2;
        border-radius: 0px;
    }}
    button {{
        background-image: none;
        background-color: {chrome};
        color: #101014;
        border-top: 2px solid #e6e9f2;
