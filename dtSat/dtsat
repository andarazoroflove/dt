    def _on_tick_1hz(self) -> bool:
        self.now_ts = time.time()
        self.primary_tel = self._compute_telemetry_snapshot(self.now_ts)
        if abs(self.now_ts - self._last_track_ts) >= 20.0 or self._last_track_sat != self.selected_norad_id:
            self._refresh_ground_track(force=False)

        self.vfd_area.queue_draw()
        self.map_area.queue_draw()
        self.radar_area.queue_draw()
        self.doppler_area.queue_draw()
        return True

    def _refresh_ground_track(self, force: bool = False) -> None:
        sat = self.sat_by_id.get(self.selected_norad_id, self.sats[0])
        self.past_segs, self.fut_segs = compute_ground_track_segments(sat, self.obs, self.now_ts)
        self._last_track_ts = self.now_ts
        self._last_track_sat = sat.norad_id

    def _active_or_next_pass_for_selected(self) -> SatPass | None:
        for p in self.upcoming_passes:
            if p.sat.norad_id == self.selected_norad_id and p.los_ts >= self.now_ts:
                return p
        # Compute directly if table is filtered above its elevation
        sat = self.sat_by_id.get(self.selected_norad_id)
        if sat is None:
            return None
        ps = predict_passes_for_sat(sat, self.obs, self.now_ts, hours=24.0, min_el_deg=0.5)
        return ps[0] if ps else None

    def _recompute_passes(self) -> None:
        target_sats = self.sats[:20] if self.pass_all_sats else [self.sat_by_id[self.selected_norad_id]]
        self.upcoming_passes = predict_passes_catalog(
            target_sats, self.obs, time.time(), hours=24.0, min_el_deg=self.min_el_deg
        )
        self.pass_store.clear()
        now = time.time()
        for idx, p in enumerate(self.upcoming_passes[:120]):
            loc_dt = datetime.datetime.fromtimestamp(p.aos_ts)
            utc_aos = datetime.datetime.fromtimestamp(p.aos_ts, tz=datetime.timezone.utc)
            utc_los = datetime.datetime.fromtimestamp(p.los_ts, tz=datetime.timezone.utc)
            mm, ss = divmod(int(round(p.duration_s)), 60)
            if p.aos_ts <= now <= p.los_ts:
                status = "● IN VIEW NOW"
                bg = "#c8f2d2"
                wt = Pango.Weight.BOLD
            else:
                in_m = max(0, int((p.aos_ts - now) // 60))
                hh_w, mm_w = divmod(in_m, 60)
                status = f"T-{hh_w:02d}h{mm_w:02d}m" + (" ★ HIGH" if p.max_el >= 45.0 else "")
                bg = "#eef6ea" if (idx % 2 == 0) else "#dcebd6"
                wt = Pango.Weight.BOLD if p.sat.norad_id == self.selected_norad_id else Pango.Weight.NORMAL

            self.pass_store.append([
                idx,
                p.sat.name,
                loc_dt.strftime("%m-%d %H:%M:%S"),
                utc_aos.strftime("%H:%M:%SZ"),
                f"{p.aos_az:05.1f}° {az_to_compass(p.aos_az):>3s}",
                f"{p.max_el:4.1f}°",
                utc_los.strftime("%H:%M:%SZ"),
                f"{p.los_az:05.1f}° {az_to_compass(p.los_az):>3s}",
                f"{mm:02d}m {ss:02d}s",
                status,
                bg,
                int(wt),
            ])
        self._update_status_bar()

    def _sync_preset_for_satellite(self, norad_id: int) -> None:
        for idx, (_, p_nid, dn, up, note) in enumerate(RADIO_PRESETS):
            if p_nid == norad_id:
                self._syncing_preset = True
                self.cmb_preset.set_active(idx)
                self.down_mhz, self.up_mhz, self.mode_note = dn, up, note
                self.ent_down.set_text(f"{dn:.4f}")
                self.ent_up.set_text(f"{up:.4f}")
                self._syncing_preset = False
                return

    def _select_satellite(self, norad_id: int, clear_preview: bool = True) -> None:
        if norad_id not in self.sat_by_id:
            return
        self.selected_norad_id = norad_id
        if clear_preview:
            self.preview_pass = None
        if self.cmb_sat.get_active_id() != str(norad_id):
            self.cmb_sat.set_active_id(str(norad_id))
        self._sync_preset_for_satellite(norad_id)
        self.primary_tel = self._compute_telemetry_snapshot(time.time())
        self._refresh_ground_track(force=True)
        if not self.pass_all_sats:
            self._recompute_passes()
        self._save_config()
        self._update_status_bar()
        self.vfd_area.queue_draw()
        self.map_area.queue_draw()
        self.radar_area.queue_draw()
        self.doppler_area.queue_draw()

    def _step_satellite(self, delta: int) -> None:
        ids = [s.norad_id for s in self.sats]
        if not ids:
            return
        cur_idx = ids.index(self.selected_norad_id) if self.selected_norad_id in ids else 0
        self._select_satellite(ids[(cur_idx + delta) % len(ids)])

