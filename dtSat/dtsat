    def _on_map_clicked(self, _widget: Gtk.Widget, event: Gdk.EventButton) -> bool:
        if event.button != 1:
            return False
        best_sat: TLESatellite | None = None
        best_d2 = 196.0  # 14 px click radius
        for tx, ty, sat in self.map_hit_targets:
            d2 = (event.x - tx) ** 2 + (event.y - ty) ** 2
            if d2 <= best_d2:
                best_d2 = d2
                best_sat = sat
        if best_sat is not None:
            self._select_satellite(best_sat.norad_id)
            return True
        return False

    # -----------------------------------------------------------------------
    # Live CelesTrak Async TLE Updater
    # -----------------------------------------------------------------------
    def _trigger_tle_update(self, silent: bool = False) -> None:
        if self._updating_tle:
            return
        self._updating_tle = True
        self.btn_tle.set_sensitive(False)
        if not silent:
            self.lbl_status.set_text("Fetching live NORAD TLEs from CelesTrak (stations, amateur, weather)...")

        def worker() -> None:
            chunks: list[str] = []
            ok_groups: list[str] = []
            for grp, url in CELESTRAK_URLS:
                try:
                    resp = requests.get(url, headers={"User-Agent": UA}, timeout=7)
                    if resp.status_code == 200 and "1 " in resp.text and "2 " in resp.text:
                        chunks.append(resp.text.strip())
                        ok_groups.append(grp)
                except Exception:
                    pass

            def finish() -> bool:
                self._updating_tle = False
                self.btn_tle.set_sensitive(True)
                if chunks:
                    try:
                        CACHE_DIR.mkdir(parents=True, exist_ok=True)
                        combined = "\n".join(chunks) + "\n"
                        TLE_CACHE_FILE.write_text(combined, encoding="utf-8")
                        self._load_initial_tles()
                        self.tle_source_label = f"CelesTrak Live ({'+'.join(ok_groups)}, {len(self.sats)} sats)"
                        self._populate_sat_combo()
                        self.primary_tel = self._compute_telemetry_snapshot(time.time())
                        self._refresh_ground_track(force=True)
                        self._recompute_passes()
                    except Exception as exc:
                        if not silent:
                            self.lbl_status.set_text(f"TLE cache write error: {exc}")
                elif not silent:
                    self._update_status_bar(extra_msg="Offline / CelesTrak unreachable — using embedded NORAD baseline")
                return False

            GLib.idle_add(finish)

        threading.Thread(target=worker, daemon=True).start()

    def _update_status_bar(self, extra_msg: str = "") -> None:
        mode_str = (
            f"PREVIEWING {self.preview_pass.sat.name} ({datetime.datetime.fromtimestamp(self.preview_pass.aos_ts, tz=datetime.timezone.utc).strftime('%H:%MZ')} MAX {self.preview_pass.max_el:.1f}°)"
            if self.preview_pass is not None
            else "LIVE REAL-TIME TRACKING"
        )
        base = (
            f"QTH: {self.obs.callsign} [{self.obs.grid}] ({self.obs.lat_deg:.4f}°, {self.obs.lon_deg:.4f}°, {self.obs.alt_m:.0f}m)  |  "
            f"{self.tle_source_label}  |  Passes (24h): {len(self.upcoming_passes)}  |  {mode_str}"
        )
        if extra_msg:
            base = f"{base}  [{extra_msg}]"
        self.lbl_status.set_text(base)

    # -----------------------------------------------------------------------
    # Cairo Widget Draw Callbacks
    # -----------------------------------------------------------------------
    def _on_draw_vfd_bar(self, widget: Gtk.Widget, cr: cairo.Context) -> bool:
        nxt = self.preview_pass if self.preview_pass is not None else self._active_or_next_pass_for_selected()
        render_vfd_telemetry_bar(
            cr,
            widget.get_allocated_width(),
            widget.get_allocated_height(),
            self.primary_tel,
            nxt,
            self.now_ts,
        )
        return False

    def _on_draw_world_map(self, widget: Gtk.Widget, cr: cairo.Context) -> bool:
        self.map_hit_targets = render_norad_world_map(
            cr,
            widget.get_allocated_width(),
            widget.get_allocated_height(),
            self.theme_key,
            self.obs,
            self.all_tels,
            self.primary_tel,
            self.past_segs,
            self.fut_segs,
            self.preview_pass,
            self.now_ts,
            show_maidenhead=self.show_maidenhead,
            show_all_sats=self.show_all_sats,
        )
        return False

    def _on_draw_radar(self, widget: Gtk.Widget, cr: cairo.Context) -> bool:
        active_p = self.preview_pass if self.preview_pass is not None else self._active_or_next_pass_for_selected()
        render_polar_sky_dome(
            cr,
            widget.get_allocated_width(),
            widget.get_allocated_height(),
            self.theme_key,
            self.all_tels,
            self.primary_tel,
            active_p,
            is_preview=(self.preview_pass is not None),
        )
        return False

    def _on_draw_doppler_vfd(self, widget: Gtk.Widget, cr: cairo.Context) -> bool:
        render_doppler_vfd(
            cr,
            widget.get_allocated_width(),
            widget.get_allocated_height(),
            self.down_mhz,
            self.up_mhz,
            self.primary_tel.range_rate_km_s,
            self.mode_note,
        )
        return False


# ---------------------------------------------------------------------------
# Headless Self-Test Suite (--self-test)
# ---------------------------------------------------------------------------
def run_self_test() -> int:
    # 1. Verify Maidenhead & Default QTH (W1AW / FN31pr Newington, CT)
    obs = GroundStation()
    assert obs.callsign == "W1AW" and obs.grid == "FN31pr"
    assert latlon_to_grid(obs.lat_deg, obs.lon_deg) == "FN31pr", latlon_to_grid(obs.lat_deg, obs.lon_deg)
    ll = grid_to_latlon("FN31pr")
    assert ll is not None and abs(ll[0] - obs.lat_deg) < 0.01 and abs(ll[1] - obs.lon_deg) < 0.01

    # 2. Verify TLE Parser + Mod-10 Checksums on all 15 Built-in Iconic Spacecraft
    sats = parse_tle_catalog(BUILTIN_TLES_RAW, strict_checksum=True)
    assert len(sats) == 15, f"Expected 15 built-in satellites, got {len(sats)}"

    # 3. Verify SGP4/J2 Orbital Propagator, WGS84 Geodetics, Az/El & Range-Rate Consistency
    t_test = datetime.datetime(2026, 11, 27, 2, 0, 0, tzinfo=datetime.timezone.utc).timestamp()
    all_tels: list[SatTelemetry] = []
    for sat in sats:
        tel = propagate_satellite(sat, t_test, obs)
        all_tels.append(tel)
        assert -90.0 <= tel.lat_deg <= 90.0
        assert -180.0 <= tel.lon_deg <= 180.0
        if sat.norad_id == 53106:  # IO-117 MEO (~5830 km)
            assert 5400.0 <= tel.alt_km <= 6300.0, f"IO-117 alt out of range: {tel.alt_km}"
        else:  # LEO spacecraft
            assert 300.0 <= tel.alt_km <= 1700.0, f"{sat.name} alt out of range: {tel.alt_km}"
        assert 5.0 <= tel.vel_km_s <= 8.2, f"{sat.name} vel out of range: {tel.vel_km_s}"
        assert 0.0 <= tel.az_deg < 360.0
        assert -90.0 <= tel.el_deg <= 90.0
        assert tel.footprint_radius_km > 1500.0

        # Finite-difference check on slant range-rate (analytical vs numerical d(rho)/dt)
        t_minus = propagate_satellite(sat, t_test - 0.5, obs)
        t_plus = propagate_satellite(sat, t_test + 0.5, obs)
        num_rr = t_plus.slant_range_km - t_minus.slant_range_km
        assert abs(num_rr - tel.range_rate_km_s) < 0.05, (
            f"{sat.name} range-rate mismatch: analytical={tel.range_rate_km_s:.4f}, numerical={num_rr:.4f}"
        )

    # Verify J2 nodal regression sign: prograde ISS (51.6°) regresses Westward (<0), sun-sync NOAA 19 (99.16°) precesses Eastward (>0)
    iss = [s for s in sats if s.norad_id == 25544][0]
    noaa19 = [s for s in sats if s.norad_id == 33591][0]
    assert math.cos(iss.inc_rad) > 0.0 and math.cos(noaa19.inc_rad) < 0.0

    # 4. Verify Full-Duplex Radio Doppler Shift Math (Approaching vs Receding)
    rx_app, df_rx_app, tx_app, df_tx_app = compute_doppler_pair(437.800, 145.990, -6.5)
    assert rx_app > 437.800 and df_rx_app > 9000.0
    assert tx_app < 145.990 and df_tx_app < -3000.0
    rx_rec, df_rx_rec, tx_rec, df_tx_rec = compute_doppler_pair(437.800, 145.990, +6.5)
    assert rx_rec < 437.800 and df_rx_rec < -9000.0
    assert tx_rec > 145.990 and df_tx_rec > 3000.0

    # 5. Verify 24-Hour Pass Predictor from W1AW [FN31pr]
    iss_passes = predict_passes_for_sat(iss, obs, t_test, hours=24.0, min_el_deg=5.0)
    assert len(iss_passes) >= 2, f"Expected >=2 ISS passes in 24h from FN31pr, got {len(iss_passes)}"
    p0 = iss_passes[0]
    assert p0.aos_ts < p0.tca_ts < p0.los_ts
    assert p0.max_el >= 5.0 and len(p0.arc_points) >= 10

    # 6. Verify Offscreen Cairo Rendering (NORAD World Map in all 3 themes, Polar Sky-Dome, VFD & Doppler)
    past_segs, fut_segs = compute_ground_track_segments(iss, obs, t_test)
    assert len(fut_segs) >= 1

    surf_map = cairo.ImageSurface(cairo.FORMAT_ARGB32, 690, 360)
    cr_map = cairo.Context(surf_map)
    for th_key in ("norad", "p31", "amber"):
        targets = render_norad_world_map(
            cr_map, 690, 360, th_key, obs, all_tels, all_tels[0], past_segs, fut_segs, p0, t_test
        )
        assert len(targets) == 15

    surf_rad = cairo.ImageSurface(cairo.FORMAT_ARGB32, 404, 198)
    cr_rad = cairo.Context(surf_rad)
    render_polar_sky_dome(cr_rad, 404, 198, "norad", all_tels, all_tels[0], p0, is_preview=False)

    surf_vfd = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1100, 48)
    cr_vfd = cairo.Context(surf_vfd)
    render_vfd_telemetry_bar(cr_vfd, 1100, 48, all_tels[0], p0, t_test)
    render_doppler_vfd(cr_vfd, 400, 48, 437.800, 145.990, -5.2, "FM · PL 67.0 Hz")

    print("DTSAT_SELF_TEST_OK")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="dtSat — Vintage NASA/NORAD & Amateur Radio Satellite Tracker")
    parser.add_argument("--self-test", action="store_true", help="Run orbital mechanics, Doppler, pass predictor & Cairo self-tests")
    args = parser.parse_args()

    if args.self_test:
        return run_self_test()

    win = DtSatWindow()
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
