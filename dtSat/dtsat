@dataclasses.dataclass
class GroundStation:
    callsign: str = DEFAULT_CALLSIGN
    grid: str = DEFAULT_GRID
    lat_deg: float = DEFAULT_LAT
    lon_deg: float = DEFAULT_LON
    alt_m: float = DEFAULT_ALT_M

    def ecef_and_enu(self) -> tuple[tuple[float, float, float], tuple[tuple[float, float, float], tuple[float, float, float], tuple[float, float, float]]]:
        lat = math.radians(self.lat_deg)
        lon = math.radians(self.lon_deg)
        sl, cl = math.sin(lat), math.cos(lat)
        so, co = math.sin(lon), math.cos(lon)
        alt_km = self.alt_m / 1000.0
        n_rad = RE_WGS84 / math.sqrt(1.0 - E2_WGS84 * sl * sl)
        ox = (n_rad + alt_km) * cl * co
        oy = (n_rad + alt_km) * cl * so
        oz = (n_rad * (1.0 - E2_WGS84) + alt_km) * sl
        east = (-so, co, 0.0)
        north = (-sl * co, -sl * so, cl)
        up = (cl * co, cl * so, sl)
        return (ox, oy, oz), (east, north, up)


