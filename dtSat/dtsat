            if p.sat.norad_id != self.selected_norad_id:
                self._select_satellite(p.sat.norad_id, clear_preview=False)
                self.preview_pass = p
            self.past_segs, self.fut_segs = compute_ground_track_segments(p.sat, self.obs, p.aos_ts, past_min=15.0, future_orbits=1.2)
            self._update_status_bar()
            self.map_area.queue_draw()
            self.radar_area.queue_draw()

