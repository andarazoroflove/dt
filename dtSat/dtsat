    def _on_grid_activated(self, *_: Any) -> None:
        res = grid_to_latlon(self.ent_grid.get_text())
        if res is not None:
            lat, lon = res
            self.ent_lat.set_text(f"{lat:.4f}")
            self.ent_lon.set_text(f"{lon:.4f}")
            self._on_save_qth_clicked()

    def _on_save_qth_clicked(self, *_: Any) -> None:
        call = self.ent_call.get_text().strip().upper() or DEFAULT_CALLSIGN
        grid_txt = self.ent_grid.get_text().strip()
        try:
            lat = clamp(float(self.ent_lat.get_text().strip()), -89.99, 89.99)
            lon = clamp(float(self.ent_lon.get_text().strip()), -180.0, 180.0)
            alt = clamp(float(self.ent_alt.get_text().strip()), -450.0, 9000.0)
        except ValueError:
            parsed = grid_to_latlon(grid_txt)
            if parsed is None:
                return
            lat, lon = parsed
            alt = self.obs.alt_m

        # If user changed grid text away from current obs.grid and kept old lat/lon, honor new grid
        if grid_txt and grid_txt.lower() != self.obs.grid.lower():
            parsed = grid_to_latlon(grid_txt)
            if parsed is not None and abs(lat - self.obs.lat_deg) < 1e-4 and abs(lon - self.obs.lon_deg) < 1e-4:
                lat, lon = parsed

        grid_calc = latlon_to_grid(lat, lon)
        self.obs = GroundStation(callsign=call, grid=grid_calc, lat_deg=lat, lon_deg=lon, alt_m=alt)
        self.ent_call.set_text(call)
        self.ent_grid.set_text(grid_calc)
        self.ent_lat.set_text(f"{lat:.4f}")
        self.ent_lon.set_text(f"{lon:.4f}")
        self.ent_alt.set_text(f"{alt:.0f}")

        self.preview_pass = None
        self.primary_tel = self._compute_telemetry_snapshot(time.time())
        self._refresh_ground_track(force=True)
        self._recompute_passes()
        self._save_config()

