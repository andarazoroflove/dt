# Maidenhead Grid & Geodetic Helpers
# ---------------------------------------------------------------------------
def clamp(v: float, lo: float, hi: float) -> float:
    return lo if v < lo else (hi if v > hi else v)


def latlon_to_grid(lat: float, lon: float) -> str:
    lon_c = ((lon + 180.0) % 360.0)
    lat_c = clamp(lat + 90.0, 0.0, 179.9999)
    f_lon = int(lon_c // 20.0)
    f_lat = int(lat_c // 10.0)
    rem_lon = lon_c - f_lon * 20.0
    rem_lat = lat_c - f_lat * 10.0
    s_lon = int(rem_lon // 2.0)
    s_lat = int(rem_lat // 1.0)
    sub_lon = int((rem_lon - s_lon * 2.0) * 12.0)
    sub_lat = int((rem_lat - s_lat * 1.0) * 24.0)
    sub_lon = max(0, min(23, sub_lon))
    sub_lat = max(0, min(23, sub_lat))
    return (
        chr(ord("A") + f_lon)
        + chr(ord("A") + f_lat)
        + str(s_lon)
        + str(s_lat)
        + chr(ord("a") + sub_lon)
        + chr(ord("a") + sub_lat)
    )


def grid_to_latlon(grid: str) -> tuple[float, float] | None:
    g = grid.strip()
    if len(g) < 4:
        return None
    g0, g1 = g[0].upper(), g[1].upper()
    if not ("A" <= g0 <= "R" and "A" <= g1 <= "R" and g[2].isdigit() and g[3].isdigit()):
        return None
    lon = -180.0 + (ord(g0) - ord("A")) * 20.0 + int(g[2]) * 2.0
    lat = -90.0 + (ord(g1) - ord("A")) * 10.0 + int(g[3]) * 1.0
    if len(g) >= 6 and ("a" <= g[4].lower() <= "x") and ("a" <= g[5].lower() <= "x"):
        lon += (ord(g[4].lower()) - ord("a") + 0.5) * (2.0 / 24.0)
        lat += (ord(g[5].lower()) - ord("a") + 0.5) * (1.0 / 24.0)
    else:
        lon += 1.0
        lat += 0.5
    return round(lat, 4), round(lon, 4)


def az_to_compass(az: float) -> str:
    pts = [
        "N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE",
        "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW",
    ]
    return pts[int(((az % 360.0) + 11.25) // 22.5) % 16]


