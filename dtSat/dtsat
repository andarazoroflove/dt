def tle_checksum(line68: str) -> int:
    total = 0
    for ch in line68[:68]:
        if "0" <= ch <= "9":
            total += ord(ch) - 48
        elif ch == "-":
            total += 1
    return total % 10


def _parse_tle_exp(field: str) -> float:
    s = field.strip()
    if not s or s in ("00000-0", "00000+0", "+00000-0", "-00000-0"):
        return 0.0
    m = re.match(r"^([+-]?)(\d+)([+-]\d+)$", s)
    if m:
        sgn = -1.0 if m.group(1) == "-" else 1.0
        mant = float("0." + m.group(2))
        return sgn * mant * (10.0 ** int(m.group(3)))
    try:
        return float(s)
    except ValueError:
        return 0.0


def parse_tle_triplet(name: str, line1: str, line2: str, strict_checksum: bool = False) -> TLESatellite:
    l1 = line1.strip()
    l2 = line2.strip()
    if len(l1) < 68 or len(l2) < 68 or not l1.startswith("1 ") or not l2.startswith("2 "):
        raise ValueError(f"Malformed TLE lines for {name!r}")
    if strict_checksum and len(l1) >= 69 and len(l2) >= 69:
        if int(l1[68]) != tle_checksum(l1[:68]) or int(l2[68]) != tle_checksum(l2[:68]):
            raise ValueError(f"TLE checksum mismatch for {name!r}")

    norad_id = int(l1[2:7].strip())
    intl_desig = l1[9:17].strip()
    ep_yr2 = int(l1[18:20].strip())
    epoch_year = 2000 + ep_yr2 if ep_yr2 < 57 else 1900 + ep_yr2
    epoch_doy = float(l1[20:32].strip())
    ep_dt = datetime.datetime(epoch_year, 1, 1, tzinfo=datetime.timezone.utc) + datetime.timedelta(days=epoch_doy - 1.0)
    epoch_unix = ep_dt.timestamp()

    nd_raw = l1[33:43].strip()
    if nd_raw.startswith(".") or nd_raw.startswith("+.") or nd_raw.startswith("-."):
        nd_raw = nd_raw.replace("+.", "+0.").replace("-.", "-0.")
        if nd_raw.startswith("."):
            nd_raw = "0" + nd_raw
    ndot_rev_day2 = float(nd_raw or 0.0)
    bstar = _parse_tle_exp(l1[53:61])

    inc_deg = float(l2[8:16].strip())
    raan_deg = float(l2[17:25].strip())
    ecc0 = float("0." + l2[26:33].strip())
    argp_deg = float(l2[34:42].strip())
    ma_deg = float(l2[43:51].strip())
    n0_rev_day = float(l2[52:63].strip())
    rev_str = l2[63:68].strip()
    rev_epoch = int(rev_str) if rev_str.isdigit() else 0

    inc_rad = math.radians(inc_deg)
    raan0_rad = math.radians(raan_deg)
    argp0_rad = math.radians(argp_deg)
    ma0_rad = math.radians(ma_deg)

    # Recover Brouwer mean motion & semi-major axis from Kozai mean motion (SGP4 initialization)
    n0_rad_s = n0_rev_day * TWO_PI / SEC_PER_DAY
    a1 = (MU_EARTH / (n0_rad_s * n0_rad_s)) ** (1.0 / 3.0)
    cos_i = math.cos(inc_rad)
    theta2 = cos_i * cos_i
    beta02 = max(1e-8, 1.0 - ecc0 * ecc0)
    beta0 = math.sqrt(beta02)
    k2 = 0.5 * J2_EARTH * RE_WGS84 * RE_WGS84
    del1 = 1.5 * k2 * (3.0 * theta2 - 1.0) / (a1 * a1 * beta0 * beta02)
    a0 = a1 * (1.0 - del1 / 3.0 - del1 * del1 - (134.0 / 81.0) * (del1 ** 3))
    del0 = 1.5 * k2 * (3.0 * theta2 - 1.0) / (a0 * a0 * beta0 * beta02)
    n0_dp_rad_s = n0_rad_s / (1.0 + del0)
    a0_dp_km = (MU_EARTH / (n0_dp_rad_s * n0_dp_rad_s)) ** (1.0 / 3.0)

    clean_name = CORE_NORAD_NAMES.get(norad_id, name.strip())
    return TLESatellite(
        name=clean_name,
        line1=l1,
        line2=l2,
        norad_id=norad_id,
        intl_desig=intl_desig,
        epoch_unix=epoch_unix,
        epoch_year=epoch_year,
        epoch_doy=epoch_doy,
        ndot_rev_day2=ndot_rev_day2,
        bstar=bstar,
        inc_rad=inc_rad,
        raan0_rad=raan0_rad,
        ecc0=ecc0,
        argp0_rad=argp0_rad,
        ma0_rad=ma0_rad,
        n0_rev_day=n0_rev_day,
        rev_epoch=rev_epoch,
        n0_dp_rad_s=n0_dp_rad_s,
        a0_dp_km=a0_dp_km,
    )


def parse_tle_catalog(text: str, strict_checksum: bool = False) -> list[TLESatellite]:
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
    sats: dict[int, TLESatellite] = {}
    i = 0
    while i < len(lines):
        if i + 2 < len(lines) and lines[i + 1].startswith("1 ") and lines[i + 2].startswith("2 "):
            try:
                sat = parse_tle_triplet(lines[i], lines[i + 1], lines[i + 2], strict_checksum=strict_checksum)
                sats[sat.norad_id] = sat
            except Exception:
                pass
            i += 3
        elif i + 1 < len(lines) and lines[i].startswith("1 ") and lines[i + 1].startswith("2 "):
            try:
                cid = int(lines[i][2:7].strip())
                sat = parse_tle_triplet(f"NORAD {cid}", lines[i], lines[i + 1], strict_checksum=strict_checksum)
                sats[sat.norad_id] = sat
            except Exception:
                pass
            i += 2
        else:
            i += 1
    return list(sats.values())


def gmst_radians(unix_ts: float) -> float:
    jd = unix_ts / SEC_PER_DAY + 2440587.5
    d_ut1 = jd - 2451545.0
    t_cent = d_ut1 / 36525.0
    gmst_deg = (
        280.46061837
        + 360.98564736629 * d_ut1
        + 0.000387933 * t_cent * t_cent
        - (t_cent ** 3) / 38710000.0
    ) % 360.0
    return math.radians(gmst_deg)


def solar_ephemeris(unix_ts: float) -> tuple[tuple[float, float, float], float, float]:
    """Return (sun_unit_eci, subsolar_lat_deg, subsolar_lon_deg)."""
    jd = unix_ts / SEC_PER_DAY + 2440587.5
    n_d = jd - 2451545.0
    mean_lon = (280.460 + 0.9856474 * n_d) % 360.0
    mean_anom = math.radians((357.528 + 0.9856003 * n_d) % 360.0)
    ecl_lon = math.radians(mean_lon + 1.915 * math.sin(mean_anom) + 0.020 * math.sin(2.0 * mean_anom))
    obliq = math.radians(23.439 - 0.0000004 * n_d)

    sx = math.cos(ecl_lon)
    sy = math.cos(obliq) * math.sin(ecl_lon)
    sz = math.sin(obliq) * math.sin(ecl_lon)

    sun_lat_deg = math.degrees(math.asin(clamp(sz, -1.0, 1.0)))
    sun_ra_rad = math.atan2(sy, sx)
    gmst_rad = gmst_radians(unix_ts)
    sun_lon_deg = ((math.degrees(sun_ra_rad - gmst_rad) + 180.0) % 360.0) - 180.0
    return (sx, sy, sz), sun_lat_deg, sun_lon_deg


def propagate_satellite(
    sat: TLESatellite,
    unix_ts: float,
    obs: GroundStation,
    obs_cache: tuple[tuple[float, float, float], tuple[tuple[float, float, float], tuple[float, float, float], tuple[float, float, float]]] | None = None,
    sun_unit_eci: tuple[float, float, float] | None = None,
) -> SatTelemetry:
    dt_sec = unix_ts - sat.epoch_unix
    dt_days = dt_sec / SEC_PER_DAY

    # Secular atmospheric drag update (clamped so multi-year offline epochs stay in valid LEO)
    drag_frac = clamp((2.0 * sat.ndot_rev_day2 * dt_days) / max(0.1, sat.n0_rev_day), -0.015, 0.015)
    bstar_frac = clamp(1.5 * sat.bstar * sat.n0_dp_rad_s * dt_sec * 0.02, -0.01, 0.01)
    n_sec = sat.n0_dp_rad_s * (1.0 + drag_frac + bstar_frac)
    a_km = (MU_EARTH / (n_sec * n_sec)) ** (1.0 / 3.0)
    ecc = clamp(sat.ecc0 * (1.0 - abs(sat.bstar) * abs(dt_days) * 0.02), 1e-6, 0.95)

    # J2 secular nodal regression, apsidal precession, and mean anomaly rate
    cos_i0 = math.cos(sat.inc_rad)
    sin_i0 = math.sin(sat.inc_rad)
    cos2_i0 = cos_i0 * cos_i0
    sin2_i0 = sin_i0 * sin_i0
    one_minus_e2 = max(1e-8, 1.0 - ecc * ecc)
    p_km = a_km * one_minus_e2
    k2 = 0.5 * J2_EARTH * RE_WGS84 * RE_WGS84
    j2_factor = (k2 / (p_km * p_km)) * sat.n0_dp_rad_s

    raan_dot = -3.0 * j2_factor * cos_i0
    argp_dot = 1.5 * j2_factor * (5.0 * cos2_i0 - 1.0)
    ma_dot = n_sec + 1.5 * j2_factor * math.sqrt(one_minus_e2) * (3.0 * cos2_i0 - 1.0)

    raan_sec = (sat.raan0_rad + raan_dot * dt_sec) % TWO_PI
    argp_sec = (sat.argp0_rad + argp_dot * dt_sec) % TWO_PI
    ma = (sat.ma0_rad + ma_dot * dt_sec) % TWO_PI

    # Solve Kepler's equation M = E - e*sin(E) via Newton-Raphson
    ea = ma + ecc * math.sin(ma)
    for _ in range(8):
        f_val = ea - ecc * math.sin(ea) - ma
        fp_val = 1.0 - ecc * math.cos(ea)
        dea = -f_val / fp_val
        ea += dea
        if abs(dea) < 1e-12:
            break

    sin_e = math.sin(ea)
    cos_e = math.cos(ea)
    nu = 2.0 * math.atan2(math.sqrt(1.0 + ecc) * sin_e * 0.5 / max(1e-12, math.cos(ea * 0.5)) if abs(math.cos(ea * 0.5)) > 1e-8 else math.sqrt(1.0 + ecc) * math.sin(ea * 0.5),
                          1.0 if abs(math.cos(ea * 0.5)) > 1e-8 else math.sqrt(1.0 - ecc) * math.cos(ea * 0.5))
    # Direct clean half-angle formula
    nu = 2.0 * math.atan2(math.sqrt(1.0 + ecc) * math.sin(0.5 * ea), math.sqrt(1.0 - ecc) * math.cos(0.5 * ea))
    r_kepler = a_km * (1.0 - ecc * cos_e)
    u_kepler = argp_sec + nu

    # SGP4 short-period J2 osculating refinements
    sin_2u = math.sin(2.0 * u_kepler)
    cos_2u = math.cos(2.0 * u_kepler)
    r_km = r_kepler + (0.5 * k2 / p_km) * sin2_i0 * cos_2u
    u_rad = u_kepler - (0.25 * k2 / (p_km * p_km)) * (7.0 * cos2_i0 - 1.0) * sin_2u
    raan_rad = raan_sec + (1.5 * k2 / (p_km * p_km)) * cos_i0 * sin_2u
    inc_rad = sat.inc_rad + (1.5 * k2 / (p_km * p_km)) * sin_i0 * cos_i0 * cos_2u

    v_scale = math.sqrt(MU_EARTH / p_km)
    r_dot = v_scale * ecc * math.sin(nu) - (n_sec * k2 / p_km) * sin2_i0 * sin_2u
    rf_dot = v_scale * (1.0 + ecc * math.cos(nu)) + (n_sec * k2 / p_km) * (sin2_i0 * cos_2u + 1.5 * (1.0 - 1.5 * sin2_i0))

    # Orientation unit vectors U_hat, V_hat -> ECI position & velocity
    cos_o, sin_o = math.cos(raan_rad), math.sin(raan_rad)
    cos_u, sin_u = math.cos(u_rad), math.sin(u_rad)
    cos_i, sin_i = math.cos(inc_rad), math.sin(inc_rad)

    ux = cos_o * cos_u - sin_o * sin_u * cos_i
    uy = sin_o * cos_u + cos_o * sin_u * cos_i
    uz = sin_u * sin_i

    vx_u = -cos_o * sin_u - sin_o * cos_u * cos_i
    vy_u = -sin_o * sin_u + cos_o * cos_u * cos_i
    vz_u = cos_u * sin_i

    x_eci = r_km * ux
    y_eci = r_km * uy
    z_eci = r_km * uz

    vx_eci = r_dot * ux + rf_dot * vx_u
    vy_eci = r_dot * uy + rf_dot * vy_u
    vz_eci = r_dot * uz + rf_dot * vz_u
    vel_km_s = math.sqrt(vx_eci * vx_eci + vy_eci * vy_eci + vz_eci * vz_eci)

    # ECI -> ECEF via GMST Earth rotation
    gmst = gmst_radians(unix_ts)
    cg, sg = math.cos(gmst), math.sin(gmst)
    x_ecef = x_eci * cg + y_eci * sg
    y_ecef = -x_eci * sg + y_eci * cg
    z_ecef = z_eci

    vx_ecef = vx_eci * cg + vy_eci * sg + OMEGA_EARTH * y_ecef
    vy_ecef = -vx_eci * sg + vy_eci * cg - OMEGA_EARTH * x_ecef
    vz_ecef = vz_eci

    # ECEF -> WGS84 Geodetic Lat, Lon, Alt
    lon_rad = math.atan2(y_ecef, x_ecef)
    p_xy = math.hypot(x_ecef, y_ecef)
    lat_rad = math.atan2(z_ecef, p_xy * (1.0 - E2_WGS84))
    n_prime = RE_WGS84
    for _ in range(5):
        sl = math.sin(lat_rad)
        n_prime = RE_WGS84 / math.sqrt(1.0 - E2_WGS84 * sl * sl)
        lat_rad = math.atan2(z_ecef + E2_WGS84 * n_prime * sl, p_xy)
    if abs(math.cos(lat_rad)) > 1e-5:
        alt_km = p_xy / math.cos(lat_rad) - n_prime
    else:
        alt_km = abs(z_ecef) / max(1e-5, abs(math.sin(lat_rad))) - n_prime * (1.0 - E2_WGS84)

    lat_deg = math.degrees(lat_rad)
    lon_deg = math.degrees(lon_rad)

    # Topocentric Azimuth, Elevation, Slant Range & Range-Rate from Ground Station
    (ox, oy, oz), (east, north, up) = obs_cache if obs_cache is not None else obs.ecef_and_enu()
    rx = x_ecef - ox
    ry = y_ecef - oy
    rz = z_ecef - oz
    slant_km = max(1e-3, math.sqrt(rx * rx + ry * ry + rz * rz))

    e_comp = rx * east[0] + ry * east[1] + rz * east[2]
    n_comp = rx * north[0] + ry * north[1] + rz * north[2]
    u_comp = rx * up[0] + ry * up[1] + rz * up[2]

    az_deg = math.degrees(math.atan2(e_comp, n_comp)) % 360.0
    el_deg = math.degrees(math.asin(clamp(u_comp / slant_km, -1.0, 1.0)))
    range_rate_km_s = (rx * vx_ecef + ry * vy_ecef + rz * vz_ecef) / slant_km

    # Sunlit vs Earth cylindrical umbral eclipse check
    if sun_unit_eci is None:
        sun_unit_eci, _, _ = solar_ephemeris(unix_ts)
    s_dot = x_eci * sun_unit_eci[0] + y_eci * sun_unit_eci[1] + z_eci * sun_unit_eci[2]
    if s_dot >= 0.0:
        sunlit = True
    else:
        px_s = x_eci - s_dot * sun_unit_eci[0]
        py_s = y_eci - s_dot * sun_unit_eci[1]
        pz_s = z_eci - s_dot * sun_unit_eci[2]
        perp_sq = px_s * px_s + py_s * py_s + pz_s * pz_s
        sunlit = perp_sq >= (RE_WGS84 * RE_WGS84)

    # Orbit number & visibility footprint radius R = R_E * arccos(R_E / (R_E + h))
    total_revs = dt_days * (ma_dot * SEC_PER_DAY / TWO_PI) + (sat.ma0_rad / TWO_PI)
    orbit_num = max(1, sat.rev_epoch + int(math.floor(total_revs)))
    half_ang = math.acos(clamp(RE_WGS84 / (RE_WGS84 + max(1.0, alt_km)), -1.0, 1.0))
    fp_radius_km = RE_WGS84 * half_ang

    return SatTelemetry(
        sat=sat,
        unix_ts=unix_ts,
        lat_deg=lat_deg,
        lon_deg=lon_deg,
        alt_km=alt_km,
        vel_km_s=vel_km_s,
        az_deg=az_deg,
        el_deg=el_deg,
        slant_range_km=slant_km,
        range_rate_km_s=range_rate_km_s,
        orbit_num=orbit_num,
        sunlit=sunlit,
        footprint_radius_km=fp_radius_km,
        footprint_half_angle_rad=half_ang,
        eci_km=(x_eci, y_eci, z_eci),
        ecef_km=(x_ecef, y_ecef, z_ecef),
    )


def compute_doppler_pair(down_mhz: float, up_mhz: float, range_rate_km_s: float) -> tuple[float, float, float, float]:
    """
    Compute live two-way satellite Doppler shift:
      - RX Downlink observed at ground: f_rx = f_down * (1 - v_r / c)
      - TX Uplink pre-compensated at ground so satellite receives f_up: f_tx = f_up * (1 + v_r / c)
    Returns (rx_mhz, df_rx_hz, tx_mhz, df_tx_hz).
    """
    beta = range_rate_km_s / C_LIGHT_KM_S
    if down_mhz > 0.0:
        rx_mhz = down_mhz * (1.0 - beta)
        df_rx_hz = -down_mhz * 1e6 * beta
    else:
        rx_mhz, df_rx_hz = 0.0, 0.0

    if up_mhz > 0.0:
        tx_mhz = up_mhz * (1.0 + beta)
        df_tx_hz = +up_mhz * 1e6 * beta
    else:
        tx_mhz, df_tx_hz = 0.0, 0.0
    return rx_mhz, df_rx_hz, tx_mhz, df_tx_hz


# ---------------------------------------------------------------------------
# Fast 24-Hour Pass Predictor (Bisection AOS/LOS + Golden-Section TCA)
# ---------------------------------------------------------------------------
def predict_passes_for_sat(
    sat: TLESatellite,
    obs: GroundStation,
    start_ts: float,
    hours: float = 24.0,
    min_el_deg: float = 0.0,
) -> list[SatPass]:
    obs_cache = obs.ecef_and_enu()
    end_ts = start_ts + hours * 3600.0
    # Step size scaled to orbital period (~45s for LEO, ~120s for MEO)
    step_s = 90.0 if sat.n0_rev_day < 9.0 else 45.0

    def el_at(ts: float) -> float:
        return propagate_satellite(sat, ts, obs, obs_cache=obs_cache, sun_unit_eci=(1.0, 0.0, 0.0)).el_deg

    def bisect_horizon(t_lo: float, t_hi: float, rising: bool) -> float:
        a, b = t_lo, t_hi
        for _ in range(14):
            mid = 0.5 * (a + b)
            em = el_at(mid)
            if (em < 0.0 and rising) or (em >= 0.0 and not rising):
                a = mid
            else:
                b = mid
        return 0.5 * (a + b)

    def refine_tca(t_a: float, t_b: float) -> tuple[float, float]:
        gr = (math.sqrt(5.0) - 1.0) * 0.5
        a, b = t_a, t_b
        c = b - gr * (b - a)
        d = a + gr * (b - a)
        ec, ed = el_at(c), el_at(d)
        for _ in range(16):
            if ec > ed:
                b = d
                d = c
                ed = ec
                c = b - gr * (b - a)
                ec = el_at(c)
            else:
                a = c
                c = d
                ec = ed
                d = a + gr * (b - a)
                ed = el_at(d)
        t_peak = 0.5 * (a + b)
        return t_peak, el_at(t_peak)

    # If pass is already in progress at start_ts, walk backward up to 90 min to capture true AOS
    scan_t0 = start_ts
    if el_at(start_ts) > 0.0:
        back = start_ts
        while back > start_ts - 5400.0 and el_at(back) > 0.0:
            back -= step_s
        scan_t0 = back

    passes: list[SatPass] = []
    t_prev = scan_t0
    e_prev = el_at(t_prev)
    in_pass = e_prev >= 0.0
    aos_t = scan_t0 if in_pass else 0.0

    t_cur = scan_t0 + step_s
    while t_cur <= end_ts + 2400.0:
        e_cur = el_at(t_cur)
        if not in_pass and e_cur >= 0.0:
            aos_t = bisect_horizon(t_prev, t_cur, rising=True)
            in_pass = True
        elif in_pass and e_cur < 0.0:
            los_t = bisect_horizon(t_prev, t_cur, rising=False)
            in_pass = False
            if los_t >= start_ts and aos_t <= end_ts:
                tca_t, max_el = refine_tca(aos_t, los_t)
                if max_el >= min_el_deg and (los_t - aos_t) >= 15.0:
                    aos_tel = propagate_satellite(sat, aos_t, obs, obs_cache=obs_cache)
                    tca_tel = propagate_satellite(sat, tca_t, obs, obs_cache=obs_cache)
                    los_tel = propagate_satellite(sat, los_t, obs, obs_cache=obs_cache)

                    # Sample trajectory arc points from AOS -> LOS
                    dur = los_t - aos_t
                    n_samples = max(16, min(72, int(dur / 20.0) + 2))
                    arc_pts: list[tuple[float, float, float, float, float]] = []
                    for k in range(n_samples + 1):
                        tk = aos_t + dur * (k / n_samples)
                        pt_tel = propagate_satellite(sat, tk, obs, obs_cache=obs_cache)
                        arc_pts.append((tk, pt_tel.az_deg, max(0.0, pt_tel.el_deg), pt_tel.lat_deg, pt_tel.lon_deg))

                    passes.append(
                        SatPass(
                            sat=sat,
                            aos_ts=aos_t,
                            tca_ts=tca_t,
                            los_ts=los_t,
                            aos_az=aos_tel.az_deg,
                            max_el=max_el,
                            tca_az=tca_tel.az_deg,
                            los_az=los_tel.az_deg,
                            duration_s=dur,
                            arc_points=arc_pts,
                        )
                    )
            if t_cur > end_ts and not in_pass:
                break
        t_prev, e_prev = t_cur, e_cur
        t_cur += step_s

    return passes


def predict_passes_catalog(
    sats: list[TLESatellite],
    obs: GroundStation,
    start_ts: float,
    hours: float = 24.0,
    min_el_deg: float = 5.0,
) -> list[SatPass]:
    all_passes: list[SatPass] = []
    for sat in sats:
        all_passes.extend(predict_passes_for_sat(sat, obs, start_ts, hours=hours, min_el_deg=min_el_deg))
    all_passes.sort(key=lambda p: p.aos_ts)
    return all_passes


# ---------------------------------------------------------------------------
# Cairo Rendering Primitives (NORAD World Map, Polar Sky-Dome, VFD Panels)
# ---------------------------------------------------------------------------
def compute_ground_track_segments(
    sat: TLESatellite,
    obs: GroundStation,
    center_ts: float,
    past_min: float = 45.0,
    future_orbits: float = 3.0,
) -> tuple[list[list[tuple[float, float]]], list[list[tuple[float, float]]]]:
    """Return anti-meridian-split (past_segments, future_segments) of (lon, lat)."""
    obs_cache = obs.ecef_and_enu()
    period_min = 1440.0 / max(1.0, sat.n0_rev_day)
    fut_min = min(360.0, future_orbits * period_min)
    step_s = 45.0 if period_min < 130.0 else 90.0

    def sample_span(t0: float, t1: float) -> list[list[tuple[float, float]]]:
        segs: list[list[tuple[float, float]]] = []
        cur: list[tuple[float, float]] = []
        t = t0
        while t <= t1 + 1e-3:
            tel = propagate_satellite(sat, t, obs, obs_cache=obs_cache, sun_unit_eci=(1.0, 0.0, 0.0))
            pt = (tel.lon_deg, tel.lat_deg)
            if cur and abs(pt[0] - cur[-1][0]) > 170.0:
                if len(cur) >= 2:
                    segs.append(cur)
                cur = [pt]
            else:
                cur.append(pt)
            t += step_s
        if len(cur) >= 2:
            segs.append(cur)
        return segs

    past_segs = sample_span(center_ts - past_min * 60.0, center_ts)
    fut_segs = sample_span(center_ts, center_ts + fut_min * 60.0)
    return past_segs, fut_segs


def compute_footprint_ring(lat_deg: float, lon_deg: float, half_angle_rad: float, n_pts: int = 84) -> list[tuple[float, float]]:
    """Return spherical visibility circle points (unwrapped_lon_deg, lat_deg) around sub-satellite point."""
    phi1 = math.radians(lat_deg)
    lam1 = math.radians(lon_deg)
    sin_p1, cos_p1 = math.sin(phi1), math.cos(phi1)
    sin_d, cos_d = math.sin(half_angle_rad), math.cos(half_angle_rad)

    pts: list[tuple[float, float]] = []
    prev_lon: float | None = None
    for i in range(n_pts + 1):
        brg = TWO_PI * (i / n_pts)
        sin_p2 = clamp(sin_p1 * cos_d + cos_p1 * sin_d * math.cos(brg), -1.0, 1.0)
        phi2 = math.asin(sin_p2)
        dlon = math.atan2(math.sin(brg) * sin_d * cos_p1, cos_d - sin_p1 * sin_p2)
        lon2 = math.degrees(lam1 + dlon)
        if prev_lon is not None:
            while lon2 - prev_lon > 180.0:
                lon2 -= 360.0
            while lon2 - prev_lon < -180.0:
                lon2 += 360.0
        prev_lon = lon2
        pts.append((lon2, math.degrees(phi2)))
    return pts


def render_norad_world_map(
    cr: cairo.Context,
    width: int,
    height: int,
    theme_key: str,
    obs: GroundStation,
    all_tels: list[SatTelemetry],
    primary_tel: SatTelemetry,
    past_segs: list[list[tuple[float, float]]],
    fut_segs: list[list[tuple[float, float]]],
    preview_pass: SatPass | None,
    unix_ts: float,
    show_maidenhead: bool = True,
    show_all_sats: bool = True,
) -> list[tuple[float, float, TLESatellite]]:
    """Render Cheyenne Mountain / NASA Mission-Control World Map and return clickable (x, y, sat) targets."""
    th = MAP_THEMES.get(theme_key, MAP_THEMES["norad"])
    pad_l, pad_r, pad_t, pad_b = 28.0, 10.0, 18.0, 18.0
    mw = max(80.0, width - pad_l - pad_r)
    mh = max(60.0, height - pad_t - pad_b)

    def proj(lon: float, lat: float) -> tuple[float, float]:
        x = pad_l + ((lon + 180.0) / 360.0) * mw
        y = pad_t + ((90.0 - lat) / 180.0) * mh
        return x, y

    # Outer console matte frame
    cr.set_source_rgb(0.05, 0.07, 0.10)
    cr.rectangle(0, 0, width, height)
    cr.fill()

    # Ocean base inside map viewport
    cr.save()
    cr.rectangle(pad_l, pad_t, mw, mh)
    cr.clip()

    cr.set_source_rgb(*th["ocean"])
    cr.rectangle(pad_l, pad_t, mw, mh)
    cr.fill()

    # Vector Continents & Islands (with inland lakes cut out cleanly)
    for is_hole, poly in WORLD_POLYGONS:
        if len(poly) < 3:
            continue
        x0, y0 = proj(poly[0][0], poly[0][1])
        cr.new_path()
        cr.move_to(x0, y0)
        for lon, lat in poly[1:]:
            px, py = proj(lon, lat)
            cr.line_to(px, py)
        cr.close_path()
        if is_hole:
            cr.set_source_rgb(*th["ocean"])
            cr.fill_preserve()
        else:
            cr.set_source_rgb(*th["land_fill"])
            cr.fill_preserve()
        cr.set_source_rgb(*th["coast"])
        cr.set_line_width(0.85)
        cr.stroke()

    # US State & International Tactical Borders
    cr.set_source_rgba(th["border"][0], th["border"][1], th["border"][2], 0.80)
    cr.set_line_width(0.65)
    for line in BORDER_POLYLINES:
        if len(line) < 2:
            continue
        cr.new_path()
        x0, y0 = proj(line[0][0], line[0][1])
        cr.move_to(x0, y0)
        for lon, lat in line[1:]:
            px, py = proj(lon, lat)
            cr.line_to(px, py)
        cr.stroke()

    # Astronomical Solar Day/Night Terminator Overlay
    _, sun_lat, sun_lon = solar_ephemeris(unix_ts)
    dec_rad = math.radians(sun_lat)
    tan_dec = math.tan(dec_rad)
    if abs(tan_dec) < 1e-4:
        tan_dec = 1e-4 if dec_rad >= 0.0 else -1e-4

    term_pts: list[tuple[float, float]] = []
    for lon_i in range(-180, 181, 2):
        ha_rad = math.radians(lon_i - sun_lon)
        lat_term = math.degrees(math.atan(-math.cos(ha_rad) / tan_dec))
        term_pts.append((float(lon_i), lat_term))

    cr.new_path()
    tx0, ty0 = proj(term_pts[0][0], term_pts[0][1])
    cr.move_to(tx0, ty0)
    for tlon, tlat in term_pts[1:]:
        px, py = proj(tlon, tlat)
        cr.line_to(px, py)
    # Close polygon over the dark pole
    dark_pole_lat = -90.0 if sun_lat >= 0.0 else 90.0
    p_end = proj(180.0, dark_pole_lat)
    p_start = proj(-180.0, dark_pole_lat)
    cr.line_to(p_end[0], p_end[1])
    cr.line_to(p_start[0], p_start[1])
    cr.close_path()
    cr.set_source_rgba(*th["night_rgba"])
    cr.fill()

    # Glowing Greyline Terminator Curve
    cr.new_path()
    cr.move_to(tx0, ty0)
    for tlon, tlat in term_pts[1:]:
        px, py = proj(tlon, tlat)
        cr.line_to(px, py)
    cr.set_source_rgba(th["term_line"][0], th["term_line"][1], th["term_line"][2], 0.65)
    cr.set_line_width(1.15)
    cr.stroke()

    # Lat/Lon Graticule (every 30 deg) + Equator & Tropics
    cr.set_source_rgba(th["grid"][0], th["grid"][1], th["grid"][2], 0.65)
    cr.set_line_width(0.6)
    for lon_g in range(-150, 180, 30):
        gx, _ = proj(lon_g, 0.0)
        cr.move_to(gx, pad_t)
        cr.line_to(gx, pad_t + mh)
    for lat_g in (-60, -30, 0, 30, 60):
        _, gy = proj(0.0, lat_g)
        cr.move_to(pad_l, gy)
        cr.line_to(pad_l + mw, gy)
    cr.stroke()

    # Equator emphasis
    _, eq_y = proj(0.0, 0.0)
    cr.set_source_rgba(th["coast"][0], th["coast"][1], th["coast"][2], 0.38)
    cr.set_line_width(0.9)
    cr.move_to(pad_l, eq_y)
    cr.line_to(pad_l + mw, eq_y)
    cr.stroke()

    # Optional 20x10 deg Maidenhead Field Grid (AA..RR)
    if show_maidenhead:
        cr.set_source_rgba(th["maiden"][0], th["maiden"][1], th["maiden"][2], 0.34)
        cr.set_dash([2.0, 3.0])
        cr.set_line_width(0.55)
        for lon_m in range(-160, 180, 20):
            gx, _ = proj(lon_m, 0.0)
            cr.move_to(gx, pad_t)
            cr.line_to(gx, pad_t + mh)
        for lat_m in range(-80, 90, 10):
            _, gy = proj(0.0, lat_m)
            cr.move_to(pad_l, gy)
            cr.line_to(pad_l + mw, gy)
        cr.stroke()
        cr.set_dash([])

        # Subtle Maidenhead field labels around North America / Europe / Pacific
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(7.5)
        cr.set_source_rgba(th["maiden"][0], th["maiden"][1], th["maiden"][2], 0.52)
        for fi in range(0, 18, 2):
            for fj in range(2, 16, 2):
                lbl = chr(ord("A") + fi) + chr(ord("A") + fj)
                lx, ly = proj(-180.0 + fi * 20.0 + 2.0, -90.0 + fj * 10.0 + 8.0)
                cr.move_to(lx, ly)
                cr.show_text(lbl)

    # Subsolar Sun Marker
    sun_x, sun_y = proj(sun_lon, sun_lat)
    cr.set_source_rgba(1.0, 0.86, 0.24, 0.90)
    cr.arc(sun_x, sun_y, 3.8, 0.0, TWO_PI)
    cr.fill()
    cr.set_line_width(1.0)
    for k in range(8):
        ang = k * (math.pi / 4.0)
        cr.move_to(sun_x + 5.2 * math.cos(ang), sun_y + 5.2 * math.sin(ang))
        cr.line_to(sun_x + 8.0 * math.cos(ang), sun_y + 8.0 * math.sin(ang))
    cr.stroke()

    # Primary Satellite Past & 3-Orbit Future Ground Track
    cr.set_dash([4.0, 3.0])
    cr.set_source_rgba(th["track_past"][0], th["track_past"][1], th["track_past"][2], 0.78)
    cr.set_line_width(1.2)
    for seg in past_segs:
        cr.new_path()
        x0, y0 = proj(seg[0][0], seg[0][1])
        cr.move_to(x0, y0)
        for lon, lat in seg[1:]:
            px, py = proj(lon, lat)
            cr.line_to(px, py)
        cr.stroke()
    cr.set_dash([])

    cr.set_source_rgba(th["track_fut"][0], th["track_fut"][1], th["track_fut"][2], 0.92)
    cr.set_line_width(1.6)
    for seg in fut_segs:
        cr.new_path()
        x0, y0 = proj(seg[0][0], seg[0][1])
        cr.move_to(x0, y0)
        for lon, lat in seg[1:]:
            px, py = proj(lon, lat)
            cr.line_to(px, py)
        cr.stroke()

    # Direction chevrons along first future segment
    if fut_segs and len(fut_segs[0]) >= 8:
        fseg = fut_segs[0]
        for idx in range(6, min(len(fseg) - 1, 42), 10):
            x1, y1 = proj(fseg[idx - 1][0], fseg[idx - 1][1])
            x2, y2 = proj(fseg[idx][0], fseg[idx][1])
            if math.hypot(x2 - x1, y2 - y1) < 80.0:
                hdg = math.atan2(y2 - y1, x2 - x1)
                cr.move_to(x2, y2)
                cr.line_to(x2 - 6.0 * math.cos(hdg - 0.5), y2 - 6.0 * math.sin(hdg - 0.5))
                cr.move_to(x2, y2)
                cr.line_to(x2 - 6.0 * math.cos(hdg + 0.5), y2 - 6.0 * math.sin(hdg + 0.5))
                cr.stroke()

    # Highlighted Preview Pass Ground-Track Segment (if user clicked a row in Pass Table)
    if preview_pass is not None and len(preview_pass.arc_points) >= 2:
        cr.set_source_rgba(1.0, 0.92, 0.30, 0.98)
        cr.set_line_width(2.8)
        prev_l: float | None = None
        cr.new_path()
        for _, _, _, plat, plon in preview_pass.arc_points:
            px, py = proj(plon, plat)
            if prev_l is not None and abs(plon - prev_l) > 170.0:
                cr.stroke()
                cr.new_path()
                cr.move_to(px, py)
            elif prev_l is None:
                cr.move_to(px, py)
            else:
                cr.line_to(px, py)
            prev_l = plon
        cr.stroke()

    # Live Spherical Radio-Visibility Footprint Circle for Primary Satellite
    deg_half = math.degrees(primary_tel.footprint_half_angle_rad)
    encloses_north = (primary_tel.lat_deg + deg_half) >= 89.8
    encloses_south = (primary_tel.lat_deg - deg_half) <= -89.8
    fp_pts = compute_footprint_ring(primary_tel.lat_deg, primary_tel.lon_deg, primary_tel.footprint_half_angle_rad)

    if encloses_north or encloses_south:
        # Polar-cap footprint: wrap longitudes to [-180, 180], sort W->E, and close over the enclosed pole
        wrapped = sorted([(((lon + 180.0) % 360.0) - 180.0, lat) for lon, lat in fp_pts], key=lambda p: p[0])
        pole_lat = 90.0 if encloses_north else -90.0
        cr.new_path()
        cr.move_to(*proj(-180.0, wrapped[0][1]))
        for lon, lat in wrapped:
            cr.line_to(*proj(lon, lat))
        cr.line_to(*proj(180.0, wrapped[-1][1]))
        cr.line_to(*proj(180.0, pole_lat))
        cr.line_to(*proj(-180.0, pole_lat))
        cr.close_path()
        cr.set_source_rgba(*th["foot_fill"])
        cr.fill()
        cr.new_path()
        cr.move_to(*proj(wrapped[0][0], wrapped[0][1]))
        for lon, lat in wrapped[1:]:
            cr.line_to(*proj(lon, lat))
        cr.set_source_rgba(*th["foot_stroke"])
        cr.set_line_width(1.4)
        cr.stroke()
    else:
        # Draw shifted copies (-360, 0, +360) so Date-Line crossing footprints fill & stroke seamlessly
        for lon_shift in (-360.0, 0.0, 360.0):
            cr.new_path()
            x0, y0 = proj(fp_pts[0][0] + lon_shift, fp_pts[0][1])
            cr.move_to(x0, y0)
            for lon, lat in fp_pts[1:]:
                cr.line_to(*proj(lon + lon_shift, lat))
            cr.close_path()
            cr.set_source_rgba(*th["foot_fill"])
            cr.fill_preserve()
            cr.set_source_rgba(*th["foot_stroke"])
            cr.set_line_width(1.35)
            cr.stroke()

    # Ground Station Beacon: W1AW [FN31pr]
    qx, qy = proj(obs.lon_deg, obs.lat_deg)
    cr.set_source_rgba(th["qth"][0], th["qth"][1], th["qth"][2], 0.28)
    cr.arc(qx, qy, 8.5, 0.0, TWO_PI)
    cr.fill()
    cr.set_source_rgb(*th["qth"])
    cr.move_to(qx, qy - 5.0)
    cr.line_to(qx + 5.0, qy)
    cr.line_to(qx, qy + 5.0)
    cr.line_to(qx - 5.0, qy)
    cr.close_path()
    cr.fill()

    cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(8.5)
    q_lbl = f"{obs.callsign} [{obs.grid}]"
    cr.set_source_rgba(0.0, 0.0, 0.0, 0.75)
    cr.move_to(qx + 7.0, qy + 3.5)
    cr.show_text(q_lbl)
    cr.set_source_rgb(*th["qth"])
    cr.move_to(qx + 6.0, qy + 2.5)
    cr.show_text(q_lbl)

    # Active Line-of-Sight (LOS) Tactical Beam when Primary Satellite Elevation > 0 deg
    sx_pri, sy_pri = proj(primary_tel.lon_deg, primary_tel.lat_deg)
    if primary_tel.el_deg > 0.0 and abs(primary_tel.lon_deg - obs.lon_deg) < 175.0:
        cr.set_source_rgba(th["los"][0], th["los"][1], th["los"][2], 0.35)
        cr.set_line_width(4.0)
        cr.move_to(qx, qy)
        cr.line_to(sx_pri, sy_pri)
        cr.stroke()

        cr.set_dash([5.0, 3.0])
        cr.set_source_rgb(*th["los"])
        cr.set_line_width(1.6)
        cr.move_to(qx, qy)
        cr.line_to(sx_pri, sy_pri)
        cr.stroke()
        cr.set_dash([])

    # Plot Tracked Satellites (Secondary first, Primary on top)
    hit_targets: list[tuple[float, float, TLESatellite]] = []
    if show_all_sats:
        cr.set_font_size(7.8)
        for tel in all_tels:
            if tel.sat.norad_id == primary_tel.sat.norad_id:
                continue
            tx, ty = proj(tel.lon_deg, tel.lat_deg)
            hit_targets.append((tx, ty, tel.sat))
            col = th["los"] if tel.el_deg > 0.0 else th["sat_other"]
            cr.set_source_rgb(*col)
            cr.rectangle(tx - 2.6, ty - 2.6, 5.2, 5.2)
            cr.fill()
            # Solar wing ticks
            cr.set_line_width(1.1)
            cr.move_to(tx - 6.5, ty)
            cr.line_to(tx + 6.5, ty)
            cr.stroke()

            short_nm = tel.sat.name.split("(")[0].strip()
            cr.set_source_rgba(0.0, 0.0, 0.0, 0.80)
            cr.move_to(tx + 6.5, ty - 2.5)
            cr.show_text(short_nm)
            cr.set_source_rgba(col[0], col[1], col[2], 0.92)
            cr.move_to(tx + 5.5, ty - 3.5)
            cr.show_text(short_nm)

    # Primary Satellite Reticle + Spacecraft Icon + Telemetry Tag
    hit_targets.append((sx_pri, sy_pri, primary_tel.sat))
    pcol = th["sat_pri"]
    cr.set_source_rgba(pcol[0], pcol[1], pcol[2], 0.25)
    cr.arc(sx_pri, sy_pri, 10.5, 0.0, TWO_PI)
    cr.fill()

    cr.set_source_rgb(*pcol)
    cr.set_line_width(1.6)
    cr.arc(sx_pri, sy_pri, 6.5, 0.0, TWO_PI)
    cr.stroke()
    # Crosshair & solar wings
    cr.move_to(sx_pri - 11.0, sy_pri)
    cr.line_to(sx_pri - 4.0, sy_pri)
    cr.move_to(sx_pri + 4.0, sy_pri)
    cr.line_to(sx_pri + 11.0, sy_pri)
    cr.move_to(sx_pri, sy_pri - 10.0)
    cr.line_to(sx_pri, sy_pri - 4.0)
    cr.move_to(sx_pri, sy_pri + 4.0)
    cr.line_to(sx_pri, sy_pri + 10.0)
    cr.stroke()
    cr.rectangle(sx_pri - 2.5, sy_pri - 2.5, 5.0, 5.0)
    cr.fill()

    cr.set_font_size(9.0)
    pri_tag = f"{primary_tel.sat.name} ({primary_tel.alt_km:.0f}km)"
    ext = cr.text_extents(pri_tag)
    lbl_x = sx_pri + 10.0 if sx_pri + ext.width + 16.0 < pad_l + mw else sx_pri - ext.width - 10.0
    lbl_y = sy_pri - 6.0 if sy_pri - 16.0 > pad_t else sy_pri + 14.0
    cr.set_source_rgba(0.03, 0.05, 0.08, 0.82)
    cr.rectangle(lbl_x - 3.0, lbl_y - 10.0, ext.width + 6.0, 13.0)
    cr.fill()
    cr.set_source_rgb(*pcol)
    cr.move_to(lbl_x, lbl_y)
    cr.show_text(pri_tag)

    # Subtle CRT scanline sheen
    cr.set_source_rgba(1.0, 1.0, 1.0, 0.018)
    cr.set_line_width(1.0)
    for sy_line in range(int(pad_t), int(pad_t + mh), 3):
        cr.move_to(pad_l, sy_line + 0.5)
        cr.line_to(pad_l + mw, sy_line + 0.5)
    cr.stroke()

    cr.restore()

    # Map Viewport Border + Coordinate Margin Labels
    cr.set_source_rgb(*th["coast"])
    cr.set_line_width(1.2)
    cr.rectangle(pad_l, pad_t, mw, mh)
    cr.stroke()

    cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(7.5)
    cr.set_source_rgb(0.68, 0.78, 0.88)
    for lon_g in range(-180, 181, 60):
        gx, _ = proj(lon_g, 0.0)
        txt = f"{abs(lon_g)}°{'W' if lon_g < 0 else ('E' if lon_g > 0 else '')}"
        cr.move_to(max(2.0, min(width - 28.0, gx - 12.0)), pad_t + mh + 12.0)
        cr.show_text(txt)
    for lat_g in (-60, -30, 0, 30, 60):
        _, gy = proj(0.0, lat_g)
        txt = f"{abs(lat_g)}°{'S' if lat_g < 0 else ('N' if lat_g > 0 else '')}"
        cr.move_to(2.0, gy + 3.0)
        cr.show_text(txt)

    # Top Header Banner on Console Screen
    mode_banner = (
        f"NORAD / CHEYENNE MTN ORBITAL DISPLAY  ·  PREVIEW PASS: {preview_pass.sat.name}"
        if preview_pass is not None
        else f"NORAD / CHEYENNE MTN ORBITAL DISPLAY  ·  FOOTPRINT R={primary_tel.footprint_radius_km:.0f} km"
    )
    cr.set_source_rgb(*th["track_fut"])
    cr.move_to(pad_l + 2.0, 12.5)
    cr.show_text(mode_banner)

    utc_str = datetime.datetime.fromtimestamp(unix_ts, tz=datetime.timezone.utc).strftime("UTC %Y-%m-%d %H:%M:%SZ")
    u_ext = cr.text_extents(utc_str)
    cr.set_source_rgb(0.84, 0.92, 0.98)
    cr.move_to(pad_l + mw - u_ext.width - 2.0, 12.5)
    cr.show_text(utc_str)

    return hit_targets


def render_polar_sky_dome(
    cr: cairo.Context,
    width: int,
    height: int,
    theme_key: str,
    all_tels: list[SatTelemetry],
    primary_tel: SatTelemetry,
    active_pass: SatPass | None,
    is_preview: bool = False,
) -> None:
    """Render Circular Az/El Polar Sky-Dome Radar (0° outer horizon, 30°/60° rings, 90° zenith)."""
    th = MAP_THEMES.get(theme_key, MAP_THEMES["norad"])
    cr.set_source_rgb(0.05, 0.07, 0.10)
    cr.rectangle(0, 0, width, height)
    cr.fill()

    cx = width * 0.5
    cy = height * 0.5 + 4.0
    radius = max(40.0, min(width, height - 18.0) * 0.43)

    def azel_to_xy(az_deg: float, el_deg: float) -> tuple[float, float]:
        r = radius * (90.0 - clamp(el_deg, 0.0, 90.0)) / 90.0
        ang = math.radians(az_deg)
        return cx + r * math.sin(ang), cy - r * math.cos(ang)

    # Radar circular phosphor background
    cr.set_source_rgb(*th["radar_bg"])
    cr.arc(cx, cy, radius + 3.0, 0.0, TWO_PI)
    cr.fill()

    # Elevation rings: 0° (horizon), 30°, 60°
    for el_ring, lw in ((0.0, 1.5), (30.0, 0.8), (60.0, 0.8)):
        rr = radius * (90.0 - el_ring) / 90.0
        cr.set_source_rgba(th["radar_ring"][0], th["radar_ring"][1], th["radar_ring"][2], 0.88 if el_ring == 0.0 else 0.52)
        cr.set_line_width(lw)
        cr.arc(cx, cy, rr, 0.0, TWO_PI)
        cr.stroke()

    # Azimuth spokes every 30° + Zenith crosshair
    cr.set_source_rgba(th["radar_ring"][0], th["radar_ring"][1], th["radar_ring"][2], 0.42)
    cr.set_line_width(0.65)
    for az_s in range(0, 360, 30):
        ang = math.radians(az_s)
        r_in = 0.0 if az_s % 90 == 0 else radius * (30.0 / 90.0)
        cr.move_to(cx + r_in * math.sin(ang), cy - r_in * math.cos(ang))
        cr.line_to(cx + radius * math.sin(ang), cy - radius * math.cos(ang))
    cr.stroke()

    # Compass Cardinal Labels (N / E / S / W) & Ring Elevation Labels
    cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(8.5)
    cr.set_source_rgb(0.86, 0.94, 1.0)
    for lbl, az_c in (("N", 0.0), ("E", 90.0), ("S", 180.0), ("W", 270.0)):
        ang = math.radians(az_c)
        lx = cx + (radius + 10.5) * math.sin(ang)
        ly = cy - (radius + 10.5) * math.cos(ang)
        ext = cr.text_extents(lbl)
        cr.move_to(lx - ext.width * 0.5, ly + ext.height * 0.4)
        cr.show_text(lbl)

    cr.set_font_size(7.0)
    cr.set_source_rgba(th["radar_ring"][0], th["radar_ring"][1], th["radar_ring"][2], 0.85)
    for el_lbl in (30, 60):
        _, ly = azel_to_xy(15.0, float(el_lbl))
        cr.move_to(cx + 3.0, ly - 2.0)
        cr.show_text(f"{el_lbl}°")

    # Pass Trajectory Arc (AOS -> MAX EL -> LOS) with 1-minute tick marks
    if active_pass is not None and len(active_pass.arc_points) >= 2:
        arc_col = (1.0, 0.88, 0.28) if is_preview else th["radar_arc"]
        cr.new_path()
        x0, y0 = azel_to_xy(active_pass.arc_points[0][1], active_pass.arc_points[0][2])
        cr.move_to(x0, y0)
        for _, paz, pel, _, _ in active_pass.arc_points[1:]:
            px, py = azel_to_xy(paz, pel)
            cr.line_to(px, py)
        cr.set_source_rgba(arc_col[0], arc_col[1], arc_col[2], 0.28)
        cr.set_line_width(3.8)
        cr.stroke_preserve()
        cr.set_source_rgba(arc_col[0], arc_col[1], arc_col[2], 0.95)
        cr.set_line_width(1.6)
        cr.stroke()

        # 1-Minute Tick Marks along the Pass Arc
        first_min = int(math.ceil(active_pass.aos_ts / 60.0)) * 60
        pts = active_pass.arc_points
        idx = 0
        for m_ts in range(first_min, int(active_pass.los_ts), 60):
            while idx + 1 < len(pts) and pts[idx + 1][0] < m_ts:
                idx += 1
            if idx + 1 < len(pts):
                t0, az0, el0, _, _ = pts[idx]
                t1, az1, el1, _, _ = pts[idx + 1]
                frac = (m_ts - t0) / max(1e-3, t1 - t0)
                x_a, y_a = azel_to_xy(az0, el0)
                x_b, y_b = azel_to_xy(az1, el1)
                mx = x_a + frac * (x_b - x_a)
                my = y_a + frac * (y_b - y_a)
                dx, dy = x_b - x_a, y_b - y_a
                ln = max(1e-3, math.hypot(dx, dy))
                nx, ny = -dy / ln, dx / ln
                cr.move_to(mx - nx * 3.2, my - ny * 3.2)
                cr.line_to(mx + nx * 3.2, my + ny * 3.2)
                cr.set_line_width(1.2)
                cr.stroke()

        # AOS, MAX EL, and LOS Markers
        ax_s, ay_s = azel_to_xy(active_pass.aos_az, 0.0)
        lx_s, ly_s = azel_to_xy(active_pass.los_az, 0.0)
        tx_s, ty_s = azel_to_xy(active_pass.tca_az, active_pass.max_el)

        cr.set_source_rgb(0.42, 1.0, 0.56)
        cr.arc(ax_s, ay_s, 3.3, 0.0, TWO_PI)
        cr.fill()
        cr.set_font_size(7.2)
        cr.move_to(ax_s + 4.0, ay_s - 3.0)
        cr.show_text("AOS")

        cr.set_source_rgb(1.0, 0.45, 0.36)
        cr.arc(lx_s, ly_s, 3.3, 0.0, TWO_PI)
        cr.fill()
        cr.move_to(lx_s + 4.0, ly_s + 7.0)
        cr.show_text("LOS")

        cr.set_source_rgb(1.0, 0.92, 0.36)
        cr.arc(tx_s, ty_s, 3.2, 0.0, TWO_PI)
        cr.fill()
        cr.move_to(tx_s + 4.5, ty_s - 2.0)
        cr.show_text(f"MAX {active_pass.max_el:.0f}°")

    # Plot All Currently Visible Satellites (El > 0°)
    for tel in all_tels:
        if tel.el_deg <= 0.0:
            continue
        bx, by = azel_to_xy(tel.az_deg, tel.el_deg)
        is_pri = tel.sat.norad_id == primary_tel.sat.norad_id
        col = th["sat_pri"] if is_pri else th["los"]
        if is_pri:
            cr.set_source_rgba(col[0], col[1], col[2], 0.32)
            cr.arc(bx, by, 8.0, 0.0, TWO_PI)
            cr.fill()
        cr.set_source_rgb(*col)
        cr.arc(bx, by, 3.8 if is_pri else 2.8, 0.0, TWO_PI)
        cr.fill()
        cr.set_font_size(7.5 if is_pri else 7.0)
        cr.move_to(bx + 5.0, by + 2.5)
        cr.show_text(tel.sat.name.split("(")[0].strip())

    # Top-left & Top-right Sky-Dome Header
    cr.set_font_size(7.5)
    hdr = "SKY-DOME AZ/EL RADAR"
    cr.set_source_rgb(*th["radar_arc"])
    cr.move_to(6.0, 11.0)
    cr.show_text(hdr)

    if active_pass is not None:
        tag = ("PREVIEW " if is_preview else "NEXT ") + datetime.datetime.fromtimestamp(
            active_pass.aos_ts, tz=datetime.timezone.utc
        ).strftime("%H:%MZ")
        ext = cr.text_extents(tag)
        cr.set_source_rgb(1.0, 0.88, 0.36 if is_preview else 0.86)
        cr.move_to(width - ext.width - 6.0, 11.0)
        cr.show_text(tag)


def render_vfd_telemetry_bar(
    cr: cairo.Context,
    width: int,
    height: int,
    primary_tel: SatTelemetry,
    next_pass: SatPass | None,
    unix_ts: float,
) -> None:
    """Render glowing cyan-green Vacuum Fluorescent Display (VFD) telemetry strip."""
    # Deep recessed VFD glass filter
    cr.set_source_rgb(0.035, 0.075, 0.078)
    cr.rectangle(0, 0, width, height)
    cr.fill()

    # Subtle VFD filament grid lines
    cr.set_source_rgba(0.18, 0.55, 0.50, 0.09)
    cr.set_line_width(1.0)
    for gx in range(0, width, 16):
        cr.move_to(gx + 0.5, 0)
        cr.line_to(gx + 0.5, height)
    cr.stroke()

    # Compute AOS / LOS Countdown
    if primary_tel.el_deg > 0.0 and next_pass is not None and next_pass.aos_ts <= unix_ts <= next_pass.los_ts:
        rem = max(0, int(round(next_pass.los_ts - unix_ts)))
        hh, rem2 = divmod(rem, 3600)
        mm, ss = divmod(rem2, 60)
        timer_lbl = "IN VIEW · LOS COUNTDOWN"
        timer_val = f"LOS T- {hh:02d}:{mm:02d}:{ss:02d}"
        timer_col = (0.45, 1.00, 0.62)
    elif next_pass is not None and next_pass.aos_ts > unix_ts:
        rem = max(0, int(round(next_pass.aos_ts - unix_ts)))
        hh, rem2 = divmod(rem, 3600)
        mm, ss = divmod(rem2, 60)
        timer_lbl = f"NEXT AOS ({next_pass.max_el:.0f}° MAX)"
        timer_val = f"AOS T- {hh:02d}:{mm:02d}:{ss:02d}"
        timer_col = (0.38, 0.98, 0.86)
    else:
        timer_lbl = "NEXT PASS (24H)"
        timer_val = "SEARCHING..."
        timer_col = (0.62, 0.82, 0.80)

    el_col = (0.46, 1.00, 0.60) if primary_tel.el_deg > 0.0 else (0.38, 0.96, 0.84)
    sun_val = "☀ SUNLIT" if primary_tel.sunlit else "◐ ECLIPSED"
    sun_col = (1.00, 0.86, 0.34) if primary_tel.sunlit else (0.56, 0.78, 0.98)

    cells = [
        ("SPACECRAFT / NORAD", f"{primary_tel.sat.name}", f"#{primary_tel.sat.norad_id:05d} · {primary_tel.lat_deg:+.2f}°, {primary_tel.lon_deg:+.2f}°", (1.00, 0.90, 0.36), 1.45),
        ("AZIMUTH", f"{primary_tel.az_deg:05.1f}°", f"BRG {az_to_compass(primary_tel.az_deg)}", (0.38, 0.98, 0.86), 0.88),
        ("ELEVATION", f"{primary_tel.el_deg:+05.1f}°", "AOS ACTIVE" if primary_tel.el_deg > 0.0 else "BELOW HORIZ", el_col, 0.92),
        ("SLANT RANGE", f"{primary_tel.slant_range_km:6.0f} km", f"dR/dt {primary_tel.range_rate_km_s:+.2f} km/s", (0.38, 0.98, 0.86), 1.05),
        ("ALTITUDE / VEL", f"{primary_tel.alt_km:5.1f} km", f"V {primary_tel.vel_km_s:.2f} km/s", (0.38, 0.98, 0.86), 0.98),
        ("ORBIT / ILLUM", f"#{primary_tel.orbit_num:05d}", sun_val, sun_col, 0.98),
        (timer_lbl, timer_val, datetime.datetime.now().strftime("LOC %H:%M:%S"), timer_col, 1.30),
    ]

    total_w = sum(c[4] for c in cells)
    x_cur = 4.0
    usable_w = max(100.0, width - 8.0)

    for idx, (title, main_v, sub_v, col, weight) in enumerate(cells):
        cw = usable_w * (weight / total_w)
        if idx > 0:
            cr.set_source_rgba(0.24, 0.62, 0.58, 0.35)
            cr.set_line_width(1.0)
            cr.move_to(x_cur, 5.0)
            cr.line_to(x_cur, height - 5.0)
            cr.stroke()

        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(7.2)
        cr.set_source_rgba(0.55, 0.88, 0.82, 0.85)
        cr.move_to(x_cur + 6.0, 11.5)
        cr.show_text(title)

        cr.set_font_size(12.5)
        cr.set_source_rgb(*col)
        cr.move_to(x_cur + 6.0, 29.0)
        cr.show_text(main_v)

        cr.set_font_size(7.6)
        cr.set_source_rgba(0.66, 0.94, 0.88, 0.88)
        cr.move_to(x_cur + 6.0, 42.5)
        cr.show_text(sub_v)

        x_cur += cw


def render_doppler_vfd(
    cr: cairo.Context,
    width: int,
    height: int,
    down_mhz: float,
    up_mhz: float,
    range_rate_km_s: float,
    mode_note: str,
) -> None:
    """Render glowing dual-channel RX Downlink & TX Uplink Doppler VFD readout."""
    cr.set_source_rgb(0.032, 0.070, 0.074)
    cr.rectangle(0, 0, width, height)
    cr.fill()

    rx_mhz, df_rx_hz, tx_mhz, df_tx_hz = compute_doppler_pair(down_mhz, up_mhz, range_rate_km_s)
    half_w = width * 0.5

    cr.set_source_rgba(0.24, 0.62, 0.58, 0.35)
    cr.set_line_width(1.0)
    cr.move_to(half_w, 4.0)
    cr.line_to(half_w, height - 4.0)
    cr.stroke()

    cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)

    # Left: RX DOWNLINK
    cr.set_font_size(7.4)
    cr.set_source_rgba(0.55, 0.90, 0.84, 0.90)
    cr.move_to(7.0, 12.0)
    cr.show_text("RX DOWNLINK (TUNE RECEIVER)")

    cr.set_font_size(13.0)
    cr.set_source_rgb(0.38, 1.00, 0.84)
    cr.move_to(7.0, 29.5)
    cr.show_text(f"{rx_mhz:10.6f} MHz".strip() if down_mhz > 0.0 else "---.------ MHz")

    cr.set_font_size(7.8)
    cr.set_source_rgb(0.82, 0.96, 0.62)
    cr.move_to(7.0, 43.5)
    cr.show_text(f"Δf {df_rx_hz:+7.0f} Hz  ({mode_note})" if down_mhz > 0.0 else "NO DOWNLINK")

    # Right: TX UPLINK
    cr.set_font_size(7.4)
    cr.set_source_rgba(0.96, 0.78, 0.48, 0.92)
    cr.move_to(half_w + 7.0, 12.0)
    cr.show_text("TX UPLINK (PRE-COMPENSATED)")

    cr.set_font_size(13.0)
    if up_mhz > 0.0:
        cr.set_source_rgb(1.00, 0.82, 0.34)
        cr.move_to(half_w + 7.0, 29.5)
        cr.show_text(f"{tx_mhz:10.6f} MHz".strip())
        cr.set_font_size(7.8)
        cr.set_source_rgb(0.96, 0.88, 0.68)
        cr.move_to(half_w + 7.0, 43.5)
        cr.show_text(f"Δf {df_tx_hz:+7.0f} Hz  (Nom {up_mhz:.3f})")
    else:
        cr.set_source_rgba(0.52, 0.68, 0.68, 0.75)
        cr.move_to(half_w + 7.0, 29.5)
        cr.show_text("RX-ONLY BEACON")
        cr.set_font_size(7.8)
        cr.move_to(half_w + 7.0, 43.5)
        cr.show_text(mode_note)


# ---------------------------------------------------------------------------
# Main GTK3 Application Window
# ---------------------------------------------------------------------------
class DtSatWindow(Gtk.Window):
    def __init__(self) -> None:
        super().__init__(title="dtSat — NASA/NORAD Orbital Pass & Amateur Radio Doppler Console")
        self.set_wmclass("dtSat", "DtSat")
        self.set_default_size(1120, 660)

        # Load application icon if available
        script_dir = Path(__file__).resolve().parent
        for icon_candidate in (
            script_dir / "icons" / "dtsat.pm",
            script_dir.parent / "assets" / "icons" / "dtsat.png",
            HOME / ".dt" / "icons" / "dtsat.pm",
        ):
            if icon_candidate.is_file():
                try:
                    self.set_icon_from_file(str(icon_candidate))
                    break
                except Exception:
                    pass

        chrome, sel, well = load_cde_palette()
        provider = Gtk.CssProvider()
        provider.load_from_data(build_sat_css(chrome, sel, well))
        screen = Gdk.Screen.get_default()
        if screen is not None:
            Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # Configuration & Ground Station State
        self.obs = GroundStation()
        self.theme_key = "norad"
        self.show_maidenhead = True
        self.show_all_sats = True
        self.pass_all_sats = True
        self.min_el_deg = 5.0
        self.selected_norad_id = 25544
        self._load_config()

        # Load TLE Catalog (Built-in 15 + Cached CelesTrak Updates)
        self.tle_source_label = "Built-in NORAD Baseline (15 Spacecraft)"
        self.sats: list[TLESatellite] = []
        self.sat_by_id: dict[int, TLESatellite] = {}
        self._load_initial_tles()

        # Live Telemetry, Ground Track, and Pass Predictor Caches
        self.now_ts = time.time()
        self.all_tels: list[SatTelemetry] = []
        self.primary_tel: SatTelemetry = self._compute_telemetry_snapshot(self.now_ts)
        self.past_segs: list[list[tuple[float, float]]] = []
        self.fut_segs: list[list[tuple[float, float]]] = []
        self._last_track_ts = 0.0
        self._last_track_sat = -1

        self.upcoming_passes: list[SatPass] = []
        self.preview_pass: SatPass | None = None
        self.map_hit_targets: list[tuple[float, float, TLESatellite]] = []
        self._updating_tle = False
        self._syncing_preset = False

        # Current Radio Doppler Settings
        self.down_mhz = 437.8000
        self.up_mhz = 145.9900
        self.mode_note = "FM · PL 67.0 Hz"

        self._build_ui()
        self._sync_preset_for_satellite(self.selected_norad_id)
        self._refresh_ground_track(force=True)
        self._recompute_passes()

        # 1 Hz Real-Time Orbital & Doppler Update Timer
        GLib.timeout_add(1000, self._on_tick_1hz)

        # Async CelesTrak refresh on startup if cache is missing or older than 12h
        if not TLE_CACHE_FILE.is_file() or (time.time() - TLE_CACHE_FILE.stat().st_mtime) > 43200:
            self._trigger_tle_update(silent=True)

        self.connect("destroy", lambda *_: Gtk.main_quit())

    # -----------------------------------------------------------------------
    # Persistence & TLE Loading
    # -----------------------------------------------------------------------
    def _load_config(self) -> None:
        if not CONFIG_FILE.is_file():
            return
        try:
            cfg = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
            self.obs.callsign = str(cfg.get("callsign", DEFAULT_CALLSIGN)).strip() or DEFAULT_CALLSIGN
            self.obs.grid = str(cfg.get("grid", DEFAULT_GRID)).strip() or DEFAULT_GRID
            self.obs.lat_deg = clamp(float(cfg.get("lat_deg", DEFAULT_LAT)), -89.99, 89.99)
            self.obs.lon_deg = clamp(float(cfg.get("lon_deg", DEFAULT_LON)), -180.0, 180.0)
            self.obs.alt_m = clamp(float(cfg.get("alt_m", DEFAULT_ALT_M)), -450.0, 9000.0)
            if cfg.get("theme") in MAP_THEMES:
                self.theme_key = cfg["theme"]
            self.show_maidenhead = bool(cfg.get("show_maidenhead", True))
            self.show_all_sats = bool(cfg.get("show_all_sats", True))
            self.pass_all_sats = bool(cfg.get("pass_all_sats", True))
            self.min_el_deg = clamp(float(cfg.get("min_el_deg", 5.0)), 0.0, 60.0)
            self.selected_norad_id = int(cfg.get("selected_norad_id", 25544))
        except Exception:
            pass

    def _save_config(self) -> None:
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            data = {
                "callsign": self.obs.callsign,
                "grid": self.obs.grid,
                "lat_deg": round(self.obs.lat_deg, 4),
                "lon_deg": round(self.obs.lon_deg, 4),
                "alt_m": round(self.obs.alt_m, 1),
                "theme": self.theme_key,
                "show_maidenhead": self.show_maidenhead,
                "show_all_sats": self.show_all_sats,
                "pass_all_sats": self.pass_all_sats,
                "min_el_deg": self.min_el_deg,
                "selected_norad_id": self.selected_norad_id,
            }
            CONFIG_FILE.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
        except Exception:
            pass

    def _load_initial_tles(self) -> None:
        builtin_list = parse_tle_catalog(BUILTIN_TLES_RAW)
        merged: dict[int, TLESatellite] = {s.norad_id: s for s in builtin_list}
        if TLE_CACHE_FILE.is_file():
            try:
                cached = parse_tle_catalog(TLE_CACHE_FILE.read_text(encoding="utf-8", errors="ignore"))
                if cached:
                    for cs in cached:
                        if cs.norad_id in CORE_NORAD_NAMES:
                            merged[cs.norad_id] = cs
                    # Keep the 15 iconic spacecraft first, plus up to 35 popular cached amateur/weather sats
                    extras = [cs for cs in cached if cs.norad_id not in merged][:35]
                    for ex in extras:
                        merged[ex.norad_id] = ex
                    age_h = (time.time() - TLE_CACHE_FILE.stat().st_mtime) / 3600.0
                    self.tle_source_label = f"CelesTrak Cache ({len(merged)} sats, {age_h:.1f}h old)"
            except Exception:
                pass

        core_order = list(CORE_NORAD_NAMES.keys())
        ordered = [merged[nid] for nid in core_order if nid in merged]
        ordered.extend(sorted([s for nid, s in merged.items() if nid not in CORE_NORAD_NAMES], key=lambda x: x.name))
        self.sats = ordered
        self.sat_by_id = {s.norad_id: s for s in self.sats}
        if self.selected_norad_id not in self.sat_by_id and self.sats:
            self.selected_norad_id = self.sats[0].norad_id

    def _compute_telemetry_snapshot(self, unix_ts: float) -> SatTelemetry:
        obs_cache = self.obs.ecef_and_enu()
        sun_eci, _, _ = solar_ephemeris(unix_ts)
        tels: list[SatTelemetry] = []
        pri_tel: SatTelemetry | None = None
        for sat in self.sats:
            t = propagate_satellite(sat, unix_ts, self.obs, obs_cache=obs_cache, sun_unit_eci=sun_eci)
            tels.append(t)
            if sat.norad_id == self.selected_norad_id:
                pri_tel = t
        self.all_tels = tels
        if pri_tel is None:
            pri_tel = tels[0]
        return pri_tel

    # -----------------------------------------------------------------------
    # UI Construction (1120x660 CDE Mission Control Layout)
    # -----------------------------------------------------------------------
    def _build_ui(self) -> None:
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        root.set_margin_top(3)
        root.set_margin_bottom(3)
        root.set_margin_start(4)
        root.set_margin_end(4)
        self.add(root)

        # 1. Top Ground Station & Tactical Display Control Bar
        top_strip = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        top_strip.get_style_context().add_class("sat-strip")
        root.pack_start(top_strip, False, False, 0)

        def mk_lbl(txt: str) -> Gtk.Label:
            lb = Gtk.Label(label=txt)
            lb.get_style_context().add_class("sat-engraved")
            return lb

        top_strip.pack_start(mk_lbl("QTH:"), False, False, 0)
        self.ent_call = Gtk.Entry()
        self.ent_call.set_width_chars(7)
        self.ent_call.set_text(self.obs.callsign)
        self.ent_call.set_tooltip_text("Station Callsign")
        top_strip.pack_start(self.ent_call, False, False, 0)

        top_strip.pack_start(mk_lbl("GRID:"), False, False, 0)
        self.ent_grid = Gtk.Entry()
        self.ent_grid.set_width_chars(6)
        self.ent_grid.set_text(self.obs.grid)
        self.ent_grid.set_tooltip_text("Maidenhead Locator (e.g. FN31pr) — press Enter to sync Lat/Lon")
        self.ent_grid.connect("activate", self._on_grid_activated)
        top_strip.pack_start(self.ent_grid, False, False, 0)

        top_strip.pack_start(mk_lbl("LAT:"), False, False, 0)
        self.ent_lat = Gtk.Entry()
        self.ent_lat.set_width_chars(8)
        self.ent_lat.set_text(f"{self.obs.lat_deg:.4f}")
        top_strip.pack_start(self.ent_lat, False, False, 0)

        top_strip.pack_start(mk_lbl("LON:"), False, False, 0)
        self.ent_lon = Gtk.Entry()
        self.ent_lon.set_width_chars(9)
        self.ent_lon.set_text(f"{self.obs.lon_deg:.4f}")
        top_strip.pack_start(self.ent_lon, False, False, 0)

        top_strip.pack_start(mk_lbl("EL(m):"), False, False, 0)
        self.ent_alt = Gtk.Entry()
        self.ent_alt.set_width_chars(5)
        self.ent_alt.set_text(f"{self.obs.alt_m:.0f}")
        top_strip.pack_start(self.ent_alt, False, False, 0)

        btn_qth = Gtk.Button(label="SAVE QTH")
        btn_qth.connect("clicked", self._on_save_qth_clicked)
        top_strip.pack_start(btn_qth, False, False, 0)

        # Spacer
        top_strip.pack_start(Gtk.Box(), True, True, 0)

        top_strip.pack_start(mk_lbl("CRT:"), False, False, 0)
        self.cmb_theme = Gtk.ComboBoxText()
