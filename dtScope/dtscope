# Main dtScope GTK Window (1100 x 650 CDE Bench Instrument)
# ---------------------------------------------------------------------------
class DtScopeWindow(Gtk.Window):
    def __init__(self, self_test: bool = False):
        super().__init__(title="dtScope — Audio Oscilloscope & Function Generator")
        self.set_default_size(1100, 650)
        self.set_resizable(True)
        self._self_test = self_test
        self._updating_gen_widgets = False
        self._drag_target: str | None = None

        for icon_cand in (
            HOME / ".dt" / "icons" / "dtscope.pm",
            Path(__file__).resolve().parent / "icons" / "dtscope.pm",
        ):
            if icon_cand.is_file():
                try:
                    self.set_icon_from_file(str(icon_cand))
                    break
                except Exception:
                    pass

        chrome, sel, well = load_cde_palette()
        prov = Gtk.CssProvider()
        prov.load_from_data(build_scope_css(chrome, sel, well))
        scr = Gdk.Screen.get_default()
        if scr is not None:
            Gtk.StyleContext.add_provider_for_screen(
                scr, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        self.engine = ScopeAudioAndGenEngine(on_status_cb=self._set_status)
        self.ctrl = ScopeController(self.engine)

        self._build_ui()
        self._load_state()
        self._sync_all_button_states()

        self.engine.start(headless=self._self_test)
        GLib.timeout_add(33, self._on_frame_tick)
        self.connect("destroy", self._on_destroy)

        if self._self_test:
            GLib.timeout_add(120, self._run_gui_self_test, 0)

    # ---- UI Construction ----
    def _build_ui(self):
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(outer)

        cab = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        cab.get_style_context().add_class("rx-cabinet")
        outer.pack_start(cab, True, True, 0)

        # 1. Top Digital VFD Counter & Telemetry Bar
