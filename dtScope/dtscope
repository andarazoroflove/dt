        self.ctrl.draw_vfd_bar(cr, float(alloc.width), float(alloc.height))
        return False

    def _on_draw_crt(self, w, cr: cairo.Context):
        alloc = w.get_allocation()
        self.ctrl.draw_crt(cr, float(alloc.width), float(alloc.height))
        return False

    def _load_state(self):
        if not STATE_FILE.is_file():
            return
        try:
            st = json.loads(STATE_FILE.read_text(encoding="utf-8"))
            if st.get("mode") in self.mode_btns:
                self.ctrl.display_mode = st["mode"]
            if st.get("theme") in self.theme_btns:
                self.ctrl.theme_key = st["theme"]
            if st.get("source") in self.src_btns:
                self.engine.input_source = st["source"]
            if st.get("waveform") in self.wf_btns:
                self.engine.gen_waveform = st["waveform"]
            self.knob_time.set_value(float(st.get("k_time", self.knob_time.value)), notify=True)
            self.knob_volts.set_value(float(st.get("k_volts", self.knob_volts.value)), notify=True)
            self.knob_trig.set_value(float(st.get("k_trig", self.knob_trig.value)), notify=True)
            self.knob_inten.set_value(float(st.get("k_inten", self.knob_inten.value)), notify=True)
            self.knob_persist.set_value(float(st.get("k_persist", self.knob_persist.value)), notify=True)
            self.knob_gen_freq.set_value(float(st.get("k_gfreq", self.knob_gen_freq.value)), notify=True)
            self.knob_gen_lvl.set_value(float(st.get("k_glvl", self.knob_gen_lvl.value)), notify=True)
        except Exception:
            pass

    def _save_state(self):
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            st = {
                "mode": self.ctrl.display_mode,
                "theme": self.ctrl.theme_key,
                "source": self.engine.input_source,
                "waveform": self.engine.gen_waveform,
                "k_time": self.knob_time.value,
                "k_volts": self.knob_volts.value,
                "k_trig": self.knob_trig.value,
                "k_inten": self.knob_inten.value,
                "k_persist": self.knob_persist.value,
                "k_gfreq": self.knob_gen_freq.value,
                "k_glvl": self.knob_gen_lvl.value,
            }
            STATE_FILE.write_text(json.dumps(st, indent=2), encoding="utf-8")
        except Exception:
            pass

    def _run_gui_self_test(self, step: int) -> bool:
        if step == 0:
            self.engine.input_source = "synth"
            self.engine.gen_waveform = "SINE"
            self.engine.gen_freq_hz = 1000.0
            self.engine.synthesize_block(12000)
            self.ctrl.step_dsp()
            # Offscreen verification render across modes & themes
            surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 700, 460)
            cr = cairo.Context(surf)
            self.ctrl.draw_vfd_bar(cr, 700.0, 56.0)
            for m in ("SCOPE", "DUAL", "FFT", "WATERFALL", "XY"):
                self.ctrl.display_mode = m
                self.ctrl.draw_crt(cr, 700.0, 460.0)
            self.ctrl.display_mode = "SCOPE"
            GLib.timeout_add(120, self._run_gui_self_test, 1)
        else:
            print("DTSCOPE_SELF_TEST_OK")
            sys.stdout.flush()
            self.destroy()
        return False

    def _on_destroy(self, _w):
        if not self._self_test:
            self._save_state()
        self.engine.stop()
        if Gtk.main_level() > 0:
            Gtk.main_quit()


# ---------------------------------------------------------------------------
# Headless / Display-Agnostic Self-Test Runner (--self-test)
# ---------------------------------------------------------------------------
def run_headless_self_test() -> int:
    eng = ScopeAudioAndGenEngine()
    eng.input_source = "synth"
    eng.gen_waveform = "SINE"
    eng.gen_freq_hz = 1000.0
    eng.gen_level = 0.80
    eng.synthesize_block(16384)

    ctrl = ScopeController(eng)
    ctrl.step_dsp()

    f_est = ctrl.telemetry["freq_hz"]
    dom_est = ctrl.telemetry["dom_fft_hz"]
    assert 995.0 <= f_est <= 1005.0, f"Expected ~1000 Hz counter, got {f_est}"
    assert 995.0 <= dom_est <= 1005.0, f"Expected ~1000 Hz FFT peak, got {dom_est}"

    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 720, 480)
    cr = cairo.Context(surf)
    ctrl.draw_vfd_bar(cr, 1080.0, 56.0)

    for theme in ("P31", "P7", "P4", "DSO"):
        ctrl.theme_key = theme
        for mode in ("SCOPE", "DUAL", "FFT", "WATERFALL", "XY"):
            ctrl.display_mode = mode
            ctrl.step_dsp()
            ctrl.draw_crt(cr, 720.0, 480.0)

    # Test 2-Tone SSB + CTCSS + DTMF synthesis & DSP pass
    eng.gen_waveform = "2-TONE"
    eng.ctcss_hz = 100.0
    eng.synthesize_block(8192)
    ctrl.step_dsp()

    eng.trigger_dtmf_burst("5", 0.5)
    eng.synthesize_block(8192)
    ctrl.step_dsp()

    eng.stop()
    print("DTSCOPE_SELF_TEST_OK")
    sys.stdout.flush()
    return 0


def main():
    self_test = "--self-test" in sys.argv[1:]
    gtk_ok, _ = Gtk.init_check(sys.argv)

    if self_test and not gtk_ok:
        sys.exit(run_headless_self_test())

    if not gtk_ok:
        sys.stderr.write("dtScope: cannot open X11 display.\n")
        sys.exit(1)

    win = DtScopeWindow(self_test=self_test)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
