    # ---- Formatting Helpers ----
    @staticmethod
    def _fmt_time_div(ms: float) -> str:
        return f"{ms * 1000.0:.0f}us" if ms < 1.0 else f"{ms:.1f}ms"

    @staticmethod
    def _fmt_hz_short(hz: float) -> str:
        return f"{hz / 1000.0:.2f}k" if hz >= 1000.0 else f"{hz:.0f}Hz"

    def _set_btn_class(self, btn: Gtk.Button, cls_name: str, active: bool):
        ctx = btn.get_style_context()
        if active:
            ctx.add_class(cls_name)
        else:
            ctx.remove_class(cls_name)

    def _sync_all_button_states(self):
        for k, b in self.mode_btns.items():
            self._set_btn_class(b, "sw-active", k == self.ctrl.display_mode)
        for k, b in self.theme_btns.items():
            self._set_btn_class(b, "sw-active", k == self.ctrl.theme_key)
        for k, b in self.trig_mode_btns.items():
            self._set_btn_class(b, "sw-active", k == self.ctrl.trig_mode)
        for k, b in self.src_btns.items():
            self._set_btn_class(b, "sw-active", k == self.engine.input_source)
        for k, b in self.wf_btns.items():
            self._set_btn_class(b, "sw-active", k == self.engine.gen_waveform)

        self.btn_slope.set_label("SLOPE ↗" if self.ctrl.trig_rising else "SLOPE ↘")
        self._set_btn_class(self.btn_freeze, "sw-amber", self.ctrl.frozen)
        self._set_btn_class(self.btn_cursors, "sw-active", self.ctrl.cursors_visible)
        self.btn_fft_scale.set_label("FFT LOG" if self.ctrl.fft_log else "FFT LIN")
        self._set_btn_class(self.btn_fft_scale, "sw-active", self.ctrl.fft_log)
        self._set_btn_class(self.btn_pk_hold, "sw-active", self.ctrl.fft_peak_hold)
        self.btn_ch2.set_label("CH2: GEN" if self.engine.ch2_mode == "gen" else "CH2: R/QUAD")
        self._set_btn_class(self.btn_ch2, "sw-active", self.engine.ch2_mode == "gen")

        self._set_btn_class(self.btn_auto_cal, "sw-active", self.engine.auto_cal_standby)
        self._set_btn_class(self.btn_probe_cal, "sw-amber", self.engine.probe_cal_1khz)

        self.btn_gen_out.set_label("● GEN OUT ON" if self.engine.gen_out_enabled else "GEN OUT OFF")
        self._set_btn_class(self.btn_gen_out, "btn-gen-on", self.engine.gen_out_enabled)
        self._update_gen_status_label()

    def _update_gen_status_label(self):
        pl = f" + PL {self.engine.ctcss_hz:.1f}Hz" if self.engine.ctcss_hz > 0 else ""
        spkr = "SPKR ON" if self.engine.gen_out_enabled else "INT BUS"
        if self.engine.probe_cal_1khz:
            self.gen_status_lbl.set_text(f"CAL: 1000.0 Hz SQUARE ({spkr})")
        elif self.engine.gen_waveform == "2-TONE":
            self.gen_status_lbl.set_text(f"GEN: 2-TONE 700+1900 Hz{pl} ({spkr})")
        else:
            self.gen_status_lbl.set_text(
                f"GEN: {self.engine.gen_waveform} {self.engine.gen_freq_hz:.1f} Hz{pl} ({spkr})"
            )

