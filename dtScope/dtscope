# Spun-Aluminum Machined Rotary Knob Widget (Drag / Wheel / Double-Click Reset)
# ---------------------------------------------------------------------------
class RotaryKnob(Gtk.DrawingArea):
    def __init__(
        self,
        label: str,
        init_val: float,
        default_val: float,
        on_change,
        fmt_fn=None,
        accent_rgb: tuple[float, float, float] = (1.0, 0.44, 0.16),
    ):
        super().__init__()
        self.label = label
        self.value = max(0.0, min(1.0, init_val))
        self.default_val = default_val
        self.on_change = on_change
        self.fmt_fn = fmt_fn
        self.accent_rgb = accent_rgb
        self._drag_y = None
        self._drag_start_val = self.value

        self.set_size_request(86, 74)
        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.SCROLL_MASK
        )
        self.connect("draw", self._on_draw)
        self.connect("button-press-event", self._on_press)
        self.connect("button-release-event", self._on_release)
        self.connect("motion-notify-event", self._on_motion)
        self.connect("scroll-event", self._on_scroll)

    def set_value(self, v: float, notify: bool = False):
        self.value = max(0.0, min(1.0, v))
        self.queue_draw()
        if notify and self.on_change:
            self.on_change(self.value)

    def _on_press(self, _w, ev):
        if ev.type == Gdk.EventType._2BUTTON_PRESS:
            self.set_value(self.default_val, notify=True)
            return True
        if ev.button == 1:
            self._drag_y = ev.y
            self._drag_start_val = self.value
            return True
        return False

    def _on_release(self, _w, _ev):
        self._drag_y = None
        return True

    def _on_motion(self, _w, ev):
        if self._drag_y is not None:
            dy = self._drag_y - ev.y
            self.set_value(self._drag_start_val + dy / 115.0, notify=True)
            return True
        return False

    def _on_scroll(self, _w, ev):
        step = 0.035
        if ev.direction == Gdk.ScrollDirection.UP:
            self.set_value(self.value + step, notify=True)
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            self.set_value(self.value - step, notify=True)
        elif ev.direction == Gdk.ScrollDirection.SMOOTH:
            _, _dx, dy = ev.get_scroll_deltas()
            self.set_value(self.value - dy * 0.025, notify=True)
        return True

    def _on_draw(self, w, cr: cairo.Context):
        alloc = w.get_allocation()
        cx = alloc.width * 0.5
        cy = 28.5
        r = 18.5

        a_start = math.radians(135.0)
        a_span = math.radians(270.0)
        for i in range(11):
            frac = i / 10.0
            ang = a_start + frac * a_span
            r0 = r + 3.0
            r1 = r + (6.2 if i in (0, 5, 10) else 4.6)
            cr.set_line_width(1.4 if i in (0, 5, 10) else 1.0)
            if frac <= self.value + 0.001:
                cr.set_source_rgb(0.32, 0.94, 0.82)
            else:
                cr.set_source_rgb(0.58, 0.63, 0.72)
            cr.move_to(cx + r0 * math.cos(ang), cy + r0 * math.sin(ang))
            cr.line_to(cx + r1 * math.cos(ang), cy + r1 * math.sin(ang))
            cr.stroke()

        # Drop shadow
        cr.arc(cx + 1.4, cy + 2.0, r + 1.0, 0, 2 * math.pi)
        cr.set_source_rgba(0.04, 0.05, 0.07, 0.78)
        cr.fill()

        # Knurled skirt
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.set_source_rgb(0.16, 0.18, 0.22)
        cr.fill()

        cr.set_line_width(1.0)
        cr.set_source_rgba(0.45, 0.50, 0.60, 0.55)
        for k in range(16):
            ka = k * (2.0 * math.pi / 16.0)
            cr.move_to(cx + (r - 2.3) * math.cos(ka), cy + (r - 2.3) * math.sin(ka))
            cr.line_to(cx + r * math.cos(ka), cy + r * math.sin(ka))
            cr.stroke()

        # Brushed spun-aluminum cap
        pat = cairo.LinearGradient(cx - r, cy - r, cx + r, cy + r)
        pat.add_color_stop_rgb(0.0, 0.84, 0.87, 0.92)
        pat.add_color_stop_rgb(0.5, 0.54, 0.58, 0.66)
        pat.add_color_stop_rgb(1.0, 0.29, 0.33, 0.39)
        cr.arc(cx, cy, r - 3.0, 0, 2 * math.pi)
        cr.set_source(pat)
        cr.fill()

        # Pointer indicator
        val_ang = a_start + self.value * a_span
        cr.set_line_width(2.3)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_source_rgb(*self.accent_rgb)
        cr.move_to(cx + 3.5 * math.cos(val_ang), cy + 3.5 * math.sin(val_ang))
        cr.line_to(cx + (r - 4.3) * math.cos(val_ang), cy + (r - 4.3) * math.sin(val_ang))
        cr.stroke()

        # Engraved label + glowing value sub-readout
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.4)
        ext = cr.text_extents(self.label)
        cr.set_source_rgb(0.86, 0.90, 0.96)
        cr.move_to(cx - ext.width * 0.5, 60.5)
        cr.show_text(self.label)

        if self.fmt_fn:
            sub = self.fmt_fn(self.value)
            cr.set_font_size(8.0)
            ext2 = cr.text_extents(sub)
            cr.set_source_rgb(0.42, 0.95, 0.84)
            cr.move_to(cx - ext2.width * 0.5, 71.0)
            cr.show_text(sub)
        return False


# ---------------------------------------------------------------------------
# Phase-Coherent Bench Function, CTCSS PL & DTMF Tone Generator + Audio I/O
# ---------------------------------------------------------------------------
def discover_pulse_sources() -> tuple[str | None, str | None]:
    """Discover default PulseAudio/PipeWire .monitor source and microphone source via pactl."""
    monitor_src = None
    mic_src = None
    try:
        sink = subprocess.check_output(
            ["pactl", "get-default-sink"], text=True, stderr=subprocess.DEVNULL, timeout=1.2
        ).strip()
        if sink:
            monitor_src = f"{sink}.monitor"
    except Exception:
        pass

    try:
        src_out = subprocess.check_output(
            ["pactl", "list", "short", "sources"], text=True, stderr=subprocess.DEVNULL, timeout=1.2
        )
        monitors = []
        mics = []
        for ln in src_out.splitlines():
            parts = ln.split()
            if len(parts) >= 2:
                name = parts[1]
                if name.endswith(".monitor"):
                    monitors.append(name)
                else:
                    mics.append(name)
        if monitor_src and monitors and monitor_src not in monitors:
            monitor_src = monitors[0]
        elif not monitor_src and monitors:
            monitor_src = monitors[0]
        if mics:
            mic_src = mics[0]
    except Exception:
        pass

    try:
        def_src = subprocess.check_output(
            ["pactl", "get-default-source"], text=True, stderr=subprocess.DEVNULL, timeout=1.2
        ).strip()
        if def_src and not def_src.endswith(".monitor"):
            mic_src = def_src
    except Exception:
        pass

    return monitor_src, mic_src


class ScopeAudioAndGenEngine:
    """Manages live S16LE 48kHz audio capture, phase-continuous bench generator, and DSP ring buffers."""

    def __init__(self, on_status_cb=None):
        self.on_status_cb = on_status_cb

        # Ring buffers (float32 in [-1.0, +1.0])
        self.lock = threading.Lock()
        self.ring_ext_l = np.zeros(RING_LEN, dtype=np.float32)
        self.ring_ext_r = np.zeros(RING_LEN, dtype=np.float32)
        self.ring_gen_a = np.zeros(RING_LEN, dtype=np.float32)
        self.ring_gen_b = np.zeros(RING_LEN, dtype=np.float32)  # Quadrature / reference channel
        self.last_ext_rms = 0.0
        self.last_ext_active_ts = 0.0

        # Source selection: "monitor" | "mic" | "synth"
        self.input_source = "monitor"
        self.auto_cal_standby = True
        self.probe_cal_1khz = False
        self.ch2_mode = "auto"  # "auto" | "gen" | "stereo_r"

        # Bench Generator state
        self.gen_waveform = "SINE"  # SINE | SQUARE | TRIANGLE | SAWTOOTH | NOISE | 2-TONE
        self.gen_freq_hz = 1000.0
        self.gen_level = 0.65
        self.gen_out_enabled = False
        self.ctcss_hz = 0.0  # 0.0 = OFF
        self.dtmf_held_key: str | None = None
        self.dtmf_burst_key: str | None = None
        self.dtmf_burst_until = 0.0

        # Continuous phase accumulators (radians)
        self._ph_main = 0.0
        self._ph_ssb1 = 0.0
        self._ph_ssb2 = 0.0
        self._ph_ctcss = 0.0
        self._ph_dtmf_lo = 0.0
        self._ph_dtmf_hi = 0.0
        self._ph_cal = 0.0
        self._rng = np.random.default_rng(465)

        # GStreamer pipelines
        self.monitor_dev, self.mic_dev = discover_pulse_sources()
        self.active_dev_label = "INTERNAL SYNTH"
        self._cap_pipe = None
        self._out_pipe = None
        self._out_appsrc = None

        self._stop_evt = threading.Event()
        self._gen_thread = None

    def start(self, headless: bool = False):
        self._stop_evt.clear()
        if not headless:
            self.set_input_source(self.input_source)
            self._gen_thread = threading.Thread(target=self._gen_pump_loop, daemon=True)
            self._gen_thread.start()

    def stop(self):
        self._stop_evt.set()
        if self._gen_thread and self._gen_thread.is_alive():
            self._gen_thread.join(timeout=0.8)
        self._gen_thread = None
        self._stop_capture_pipeline()
        self._stop_output_pipeline()

    def _emit_status(self, msg: str):
        if self.on_status_cb:
            GLib.idle_add(self.on_status_cb, msg)

    # ---- Audio Capture Pipeline ----
    def _stop_capture_pipeline(self):
        if self._cap_pipe is not None:
            try:
                self._cap_pipe.set_state(Gst.State.NULL)
            except Exception:
                pass
            self._cap_pipe = None

    def set_input_source(self, source_kind: str):
        self.input_source = source_kind
        self._stop_capture_pipeline()

        if source_kind == "synth":
            self.active_dev_label = "INTERNAL BENCH SYNTH"
            self._emit_status("SOURCE: INTERNAL BENCH SYNTH / 1kHz PROBE COMP (48.0 kHz)")
            return

        # Re-discover PulseAudio/PipeWire sources dynamically
        self.monitor_dev, self.mic_dev = discover_pulse_sources()

        pipe = Gst.Pipeline.new("scope_capture")
        src = None
        dev_desc = "DEFAULT AUDIO"

        if source_kind == "monitor":
            if self.monitor_dev and Gst.ElementFactory.find("pulsesrc"):
                src = Gst.ElementFactory.make("pulsesrc", "cap_src")
                src.set_property("device", self.monitor_dev)
                dev_desc = self.monitor_dev
            elif Gst.ElementFactory.find("pulsesrc"):
                src = Gst.ElementFactory.make("pulsesrc", "cap_src")
                dev_desc = "pulsesrc (default)"
            else:
                src = Gst.ElementFactory.make("autoaudiosrc", "cap_src")
                dev_desc = "autoaudiosrc"
        else:  # "mic"
            if self.mic_dev and Gst.ElementFactory.find("pulsesrc"):
                src = Gst.ElementFactory.make("pulsesrc", "cap_src")
                src.set_property("device", self.mic_dev)
                dev_desc = self.mic_dev
            elif Gst.ElementFactory.find("pulsesrc"):
                src = Gst.ElementFactory.make("pulsesrc", "cap_src")
                dev_desc = "pulsesrc (mic)"
            else:
                src = Gst.ElementFactory.make("autoaudiosrc", "cap_src")
                dev_desc = "autoaudiosrc (mic)"

        q = Gst.ElementFactory.make("queue", None)
        q.set_property("max-size-buffers", 8)
        q.set_property("leaky", 2)  # downstream
        conv = Gst.ElementFactory.make("audioconvert", None)
        res = Gst.ElementFactory.make("audioresample", None)
        capsf = Gst.ElementFactory.make("capsfilter", None)
        capsf.set_property(
            "caps",
            Gst.Caps.from_string("audio/x-raw,format=S16LE,layout=interleaved,rate=48000,channels=2"),
        )
        appsink = Gst.ElementFactory.make("appsink", "cap_sink")
        appsink.set_property("emit-signals", True)
        appsink.set_property("sync", False)
        appsink.set_property("drop", True)
        appsink.set_property("max-buffers", 8)
        appsink.connect("new-sample", self._on_capture_sample)

        if not all((pipe, src, q, conv, res, capsf, appsink)):
            self.active_dev_label = "SYNTH FALLBACK"
            self._emit_status("AUDIO CAPTURE UNAVAILABLE — USING INTERNAL SYNTH")
            return

        for el in (src, q, conv, res, capsf, appsink):
            pipe.add(el)
        src.link(q)
        q.link(conv)
        conv.link(res)
        res.link(capsf)
        capsf.link(appsink)

        bus = pipe.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", self._on_cap_bus_error)

        ret = pipe.set_state(Gst.State.PLAYING)
        if ret == Gst.StateChangeReturn.FAILURE:
            pipe.set_state(Gst.State.NULL)
            self.active_dev_label = "SYNTH STANDBY"
            self._emit_status(f"CAPTURE OFFLINE ({dev_desc}) — SYNTH STANDBY ACTIVE")
        else:
            self._cap_pipe = pipe
            self.active_dev_label = dev_desc
            tag = "DESKTOP MONITOR" if source_kind == "monitor" else "MIC / LINE-IN"
            self._emit_status(f"{tag}: {dev_desc} @ 48.0 kHz S16LE")

    def _on_cap_bus_error(self, _bus, msg):
        err, _dbg = msg.parse_error()
        self._stop_capture_pipeline()
        self.active_dev_label = "SYNTH STANDBY"
        self._emit_status(f"AUDIO SRC STANDBY ({err.message[:42]}) — INTERNAL SYNTH READY")

    def _on_capture_sample(self, appsink):
        sample = appsink.emit("pull-sample")
        if not sample:
            return Gst.FlowReturn.OK
        buf = sample.get_buffer()
        ok, mapinfo = buf.map(Gst.MapFlags.READ)
        if ok:
            try:
                pcm = np.frombuffer(mapinfo.data, dtype=np.int16)
                n_frames = len(pcm) // 2
                if n_frames > 0:
                    stereo = pcm[: n_frames * 2].astype(np.float32).reshape(-1, 2) * (1.0 / 32768.0)
                    ch_l = stereo[:, 0]
                    ch_r = stereo[:, 1]
                    rms = float(np.sqrt(np.mean(ch_l * ch_l + ch_r * ch_r) * 0.5))
                    now = time.monotonic()
                    with self.lock:
                        if n_frames >= RING_LEN:
                            self.ring_ext_l[:] = ch_l[-RING_LEN:]
                            self.ring_ext_r[:] = ch_r[-RING_LEN:]
                        else:
                            self.ring_ext_l[:-n_frames] = self.ring_ext_l[n_frames:]
                            self.ring_ext_l[-n_frames:] = ch_l
                            self.ring_ext_r[:-n_frames] = self.ring_ext_r[n_frames:]
                            self.ring_ext_r[-n_frames:] = ch_r
                        self.last_ext_rms = rms
                        if rms > 3.5e-4:
                            self.last_ext_active_ts = now
            finally:
                buf.unmap(mapinfo)
        return Gst.FlowReturn.OK

    # ---- Speaker Output Pipeline for Bench Generator ----
    def _stop_output_pipeline(self):
        if self._out_pipe is not None:
            try:
                self._out_pipe.set_state(Gst.State.NULL)
            except Exception:
                pass
            self._out_pipe = None
            self._out_appsrc = None

    def set_gen_speaker_out(self, enabled: bool):
        self.gen_out_enabled = enabled
        if not enabled:
            self._stop_output_pipeline()
            return
        if self._out_pipe is not None:
            return

        pipe = Gst.Pipeline.new("scope_gen_out")
        appsrc = Gst.ElementFactory.make("appsrc", "gen_src")
        appsrc.set_property("is-live", True)
        appsrc.set_property("block", False)
        appsrc.set_property("format", Gst.Format.TIME)
        appsrc.set_property(
            "caps",
            Gst.Caps.from_string("audio/x-raw,format=S16LE,layout=interleaved,rate=48000,channels=2"),
        )
        q = Gst.ElementFactory.make("queue", None)
        q.set_property("max-size-buffers", 6)
        q.set_property("leaky", 2)
        conv = Gst.ElementFactory.make("audioconvert", None)
        res = Gst.ElementFactory.make("audioresample", None)
        sink = Gst.ElementFactory.make("autoaudiosink", None)
        if sink:
            try:
                sink.set_property("sync", False)
            except Exception:
                pass

        if not all((pipe, appsrc, q, conv, res, sink)):
            self.gen_out_enabled = False
            return

        for el in (appsrc, q, conv, res, sink):
            pipe.add(el)
        appsrc.link(q)
        q.link(conv)
        conv.link(res)
        res.link(sink)

        ret = pipe.set_state(Gst.State.PLAYING)
        if ret == Gst.StateChangeReturn.FAILURE:
            pipe.set_state(Gst.State.NULL)
            self.gen_out_enabled = False
        else:
            self._out_pipe = pipe
            self._out_appsrc = appsrc

    # ---- Synthesis Engine ----
    def trigger_dtmf_burst(self, key: str, duration_s: float = 0.36):
        if key in DTMF_FREQS:
            self.dtmf_burst_key = key
            self.dtmf_burst_until = time.monotonic() + duration_s

    def synthesize_block(self, n_frames: int) -> tuple[np.ndarray, np.ndarray]:
        """Synthesize n_frames of Bench Generator (gen_a) + Quadrature/Cal Reference (gen_b)."""
        idx = np.arange(n_frames, dtype=np.float64)
        two_pi = 2.0 * math.pi

        # 1 kHz Probe Comp reference square wave (always maintained phase-coherent)
        dph_cal = two_pi * 1000.0 / SAMPLE_RATE
        ph_cal = self._ph_cal + idx * dph_cal
        self._ph_cal = float((self._ph_cal + n_frames * dph_cal) % two_pi)
        cal_sq = np.where(np.sin(ph_cal) >= 0.0, 0.5, -0.5).astype(np.float32)

        # Active DTMF check
        now = time.monotonic()
        dtmf_key = self.dtmf_held_key
        if dtmf_key is None and self.dtmf_burst_key is not None and now < self.dtmf_burst_until:
            dtmf_key = self.dtmf_burst_key

        amp = float(self.gen_level)

        if self.probe_cal_1khz and dtmf_key is None:
            sig_a = cal_sq.copy()
            # Reference channel: 1 kHz quadrature sine for Lissajous & Dual comparison
            sig_b = (0.5 * np.cos(ph_cal)).astype(np.float32)
        elif dtmf_key is not None and dtmf_key in DTMF_FREQS:
            flo, fhi = DTMF_FREQS[dtmf_key]
            d_lo = two_pi * flo / SAMPLE_RATE
            d_hi = two_pi * fhi / SAMPLE_RATE
            p_lo = self._ph_dtmf_lo + idx * d_lo
            p_hi = self._ph_dtmf_hi + idx * d_hi
            self._ph_dtmf_lo = float((self._ph_dtmf_lo + n_frames * d_lo) % two_pi)
            self._ph_dtmf_hi = float((self._ph_dtmf_hi + n_frames * d_hi) % two_pi)
            # Standard telco +2 dB twist between low and high group
            sig_a = (max(0.25, amp) * (0.44 * np.sin(p_lo) + 0.56 * np.sin(p_hi))).astype(np.float32)
            sig_b = (max(0.25, amp) * 0.70 * np.sin(p_lo)).astype(np.float32)
        else:
            f = max(20.0, min(20000.0, float(self.gen_freq_hz)))
            dph = two_pi * f / SAMPLE_RATE
            ph = self._ph_main + idx * dph
            self._ph_main = float((self._ph_main + n_frames * dph) % two_pi)

            wf = self.gen_waveform
            if wf == "SINE":
                raw = np.sin(ph)
                quad = np.cos(ph)
            elif wf == "SQUARE":
                raw = np.where(np.sin(ph) >= 0.0, 1.0, -1.0)
                quad = np.sin(ph)
            elif wf == "TRIANGLE":
                raw = (2.0 / math.pi) * np.arcsin(np.sin(ph))
                quad = (2.0 / math.pi) * np.arcsin(np.cos(ph))
            elif wf == "SAWTOOTH":
                u = (ph / two_pi) % 1.0
                raw = 2.0 * u - 1.0
                quad = np.sin(ph)
            elif wf == "NOISE":
                raw = self._rng.uniform(-1.0, 1.0, n_frames)
                quad = self._rng.uniform(-1.0, 1.0, n_frames)
            else:  # "2-TONE" (700 Hz + 1900 Hz ARRL SSB Two-Tone Test)
                d1 = two_pi * 700.0 / SAMPLE_RATE
                d2 = two_pi * 1900.0 / SAMPLE_RATE
                p1 = self._ph_ssb1 + idx * d1
                p2 = self._ph_ssb2 + idx * d2
                self._ph_ssb1 = float((self._ph_ssb1 + n_frames * d1) % two_pi)
                self._ph_ssb2 = float((self._ph_ssb2 + n_frames * d2) % two_pi)
                raw = 0.5 * (np.sin(p1) + np.sin(p2))
                quad = 0.5 * (np.cos(p1) + np.sin(p2))

            # Mix sub-audible Ham CTCSS PL tone if enabled
            if self.ctcss_hz > 0.0:
                d_pl = two_pi * self.ctcss_hz / SAMPLE_RATE
                p_pl = self._ph_ctcss + idx * d_pl
                self._ph_ctcss = float((self._ph_ctcss + n_frames * d_pl) % two_pi)
                raw = 0.84 * raw + 0.16 * np.sin(p_pl)

            sig_a = (amp * raw).astype(np.float32)
            sig_b = (amp * quad).astype(np.float32)

        with self.lock:
            if n_frames >= RING_LEN:
                self.ring_gen_a[:] = sig_a[-RING_LEN:]
                self.ring_gen_b[:] = sig_b[-RING_LEN:]
            else:
                self.ring_gen_a[:-n_frames] = self.ring_gen_a[n_frames:]
                self.ring_gen_a[-n_frames:] = sig_a
                self.ring_gen_b[:-n_frames] = self.ring_gen_b[n_frames:]
                self.ring_gen_b[-n_frames:] = sig_b

        return sig_a, sig_b

    def _gen_pump_loop(self):
        chunk_frames = 960  # 20 ms @ 48000 Hz
        dt = chunk_frames / float(SAMPLE_RATE)
        next_t = time.monotonic()

        while not self._stop_evt.is_set():
            sig_a, sig_b = self.synthesize_block(chunk_frames)

            if self.gen_out_enabled and self._out_appsrc is not None:
                stereo = np.empty(chunk_frames * 2, dtype=np.int16)
                s_i16 = np.clip(sig_a * 30000.0, -32767.0, 32767.0).astype(np.int16)
                stereo[0::2] = s_i16
                stereo[1::2] = s_i16
                try:
                    self._out_appsrc.emit("push-buffer", Gst.Buffer.new_wrapped(stereo.tobytes()))
                except Exception:
                    pass

            next_t += dt
            sleep_s = next_t - time.monotonic()
            if sleep_s > 0.001:
                time.sleep(sleep_s)
            elif sleep_s < -0.1:
                next_t = time.monotonic()

    def snapshot_channels(self) -> tuple[np.ndarray, np.ndarray, str]:
        """Return (ch1, ch2, active_badge) arrays of length RING_LEN."""
        now = time.monotonic()
        with self.lock:
            ext_l = self.ring_ext_l.copy()
            ext_r = self.ring_ext_r.copy()
            gen_a = self.ring_gen_a.copy()
            gen_b = self.ring_gen_b.copy()
            ext_live = (now - self.last_ext_active_ts) < 1.1

        if self.probe_cal_1khz:
            return gen_a, gen_b, "1kHz PROBE CAL"

        if self.input_source == "synth":
            ch2 = gen_b if self.ch2_mode != "gen" else gen_a
            return gen_a, ch2, "INTERNAL SYNTH"

        # External source (Desktop Monitor or Mic)
        if not ext_live and self.auto_cal_standby:
            return gen_a, gen_b, "SYNTH STANDBY (NO EXT AUDIO)"

        if self.ch2_mode == "gen":
            ch2 = gen_a
        else:
            ch2 = ext_r
        badge = "DESKTOP MON" if self.input_source == "monitor" else "MIC / LINE"
        return ext_l, ch2, badge


# ---------------------------------------------------------------------------
# Signal Processing: Sub-Sample Trigger, Telemetry & 4096-pt Hanning FFT
# ---------------------------------------------------------------------------
HANNING_WIN = np.hanning(FFT_SIZE).astype(np.float32)
HANNING_COHERENT_GAIN = float(np.sum(HANNING_WIN) / FFT_SIZE)
FFT_FREQS = np.fft.rfftfreq(FFT_SIZE, d=1.0 / SAMPLE_RATE)


def build_waterfall_lut(theme_key: str) -> np.ndarray:
    """Create a 256x4 BGRA uint8 lookup table matched to each CRT phosphor / DSO theme."""
    t = np.linspace(0.0, 1.0, 256, dtype=np.float32)
    lut = np.zeros((256, 4), dtype=np.uint8)
    lut[:, 3] = 255

    if theme_key == "P31":
        r = np.clip((t - 0.55) * 2.1, 0.0, 1.0) * 220.0 + 6.0
        g = np.power(t, 0.72) * 248.0 + 7.0
        b = np.power(t, 1.15) * 165.0 + 12.0
    elif theme_key == "P7":
        r = np.power(t, 0.68) * 248.0 + 7.0
        g = np.power(t, 1.15) * 210.0 + 4.0
        b = np.clip((t - 0.62) * 2.4, 0.0, 1.0) * 195.0 + 3.0
    elif theme_key == "P4":
        r = np.power(t, 0.90) * 240.0 + 10.0
        g = np.power(t, 0.85) * 245.0 + 12.0
        b = np.power(t, 0.75) * 242.0 + 13.0
    else:  # DSO multi-color thermal/cyan/yellow/magenta
        r = np.clip(np.where(t < 0.45, t * 0.4, (t - 0.45) / 0.55), 0.0, 1.0) * 255.0
        g = np.clip(np.sin(np.clip(t * 1.15, 0.0, 1.0) * math.pi * 0.85), 0.0, 1.0) * 245.0
        b = np.clip(np.where(t < 0.5, 0.15 + t * 1.7, 1.0 - (t - 0.5) * 1.3), 0.0, 1.0) * 255.0

    lut[:, 0] = np.clip(b, 0, 255).astype(np.uint8)  # Blue (BGRA little-endian)
    lut[:, 1] = np.clip(g, 0, 255).astype(np.uint8)  # Green
    lut[:, 2] = np.clip(r, 0, 255).astype(np.uint8)  # Red
    return lut


WF_LUTS = {k: build_waterfall_lut(k) for k in PHOSPHOR_THEMES}


def compute_telemetry_and_fft(ch1: np.ndarray) -> dict:
    """Compute VFD counter metrics + 4096-pt Hanning RFFT spectrum & harmonic peaks."""
    seg = ch1[-MEAS_SIZE:]
    v_max = float(np.max(seg))
    v_min = float(np.min(seg))
    vpp = v_max - v_min
    vrms = float(np.sqrt(np.mean(seg * seg)))
    peak_abs = max(abs(v_max), abs(v_min), 1e-5)
    peak_dbfs = max(-96.0, min(0.0, 20.0 * math.log10(peak_abs)))

    # 4096-pt Hanning-windowed FFT
    fseg = ch1[-FFT_SIZE:] * HANNING_WIN
    spec = np.fft.rfft(fseg)
    mag = np.abs(spec) / (FFT_SIZE * HANNING_COHERENT_GAIN * 0.5)
    mag[0] *= 0.5
    spec_db = 20.0 * np.log10(np.maximum(mag, 1e-5))
    spec_db = np.clip(spec_db, -96.0, 6.0)

    # Dominant FFT peak with parabolic log-magnitude sub-bin interpolation (20 Hz .. 20 kHz)
    k_lo = max(1, int(20.0 * FFT_SIZE / SAMPLE_RATE))
    k_hi = min(len(spec_db) - 2, int(20000.0 * FFT_SIZE / SAMPLE_RATE))
    sub_db = spec_db[k_lo : k_hi + 1]
    pk_rel = int(np.argmax(sub_db))
    pk_bin = k_lo + pk_rel
    pk_val_db = float(spec_db[pk_bin])

    dom_fft_hz = 0.0
    if pk_val_db > -78.0 and 1 <= pk_bin < len(spec_db) - 1:
        a = float(spec_db[pk_bin - 1])
        b = float(spec_db[pk_bin])
        g = float(spec_db[pk_bin + 1])
        denom = a - 2.0 * b + g
        delta = 0.5 * (a - g) / denom if abs(denom) > 1e-6 else 0.0
        delta = max(-0.5, min(0.5, delta))
        dom_fft_hz = (pk_bin + delta) * (SAMPLE_RATE / float(FFT_SIZE))

    # Top 4 annotated local maxima peaks for FFT overlay
    peaks: list[tuple[float, float]] = []
    if pk_val_db > -76.0:
        # Local maxima search with minimum bin separation (~85 Hz)
        min_sep = 7
        cand = []
        for k in range(k_lo + 1, k_hi):
            val = spec_db[k]
            if val > -72.0 and val >= spec_db[k - 1] and val > spec_db[k + 1]:
                cand.append((float(val), k))
        cand.sort(reverse=True)
        used_bins: list[int] = []
        for val, k in cand:
            if all(abs(k - uk) >= min_sep for uk in used_bins):
                a, b, g = float(spec_db[k - 1]), float(spec_db[k]), float(spec_db[k + 1])
                denom = a - 2.0 * b + g
                d = max(-0.5, min(0.5, 0.5 * (a - g) / denom)) if abs(denom) > 1e-6 else 0.0
                f_hz = (k + d) * (SAMPLE_RATE / float(FFT_SIZE))
                peaks.append((f_hz, val))
                used_bins.append(k)
                if len(peaks) >= 4:
                    break

    # Precision Schmitt-hysteresis zero-crossing Frequency Counter on DC-removed lightly smoothed signal
    freq_hz = 0.0
    if vpp > 0.012:
        centered = seg - float(np.mean(seg))
        # Light 3-point smoothing filter to reject high-freq noise jitter on zero crossings
        sm = 0.25 * centered[:-2] + 0.50 * centered[1:-1] + 0.25 * centered[2:]
        hyst = max(0.004, 0.08 * float(np.max(np.abs(sm))))
        crossings: list[float] = []
        armed = bool(sm[0] < -hyst)
        for i in range(len(sm) - 1):
            y0 = float(sm[i])
            y1 = float(sm[i + 1])
            if not armed:
                if y0 < -hyst:
                    armed = True
            else:
                if y0 <= 0.0 < y1:
                    frac = -y0 / (y1 - y0) if (y1 - y0) > 1e-9 else 0.0
                    crossings.append(i + frac)
                    armed = False

        if len(crossings) >= 2:
            span = crossings[-1] - crossings[0]
            n_cycles = len(crossings) - 1
            if span > 1.0:
                est_hz = (n_cycles * SAMPLE_RATE) / span
                if 15.0 <= est_hz <= 22000.0:
                    freq_hz = est_hz

    if freq_hz <= 0.0 and dom_fft_hz >= 20.0 and pk_val_db > -60.0:
        freq_hz = dom_fft_hz

    period_ms = (1000.0 / freq_hz) if freq_hz > 0.5 else 0.0

    return {
        "freq_hz": freq_hz,
        "period_ms": period_ms,
        "vpp": vpp,
        "vrms": vrms,
        "peak_dbfs": peak_dbfs,
        "dom_fft_hz": dom_fft_hz,
        "spec_db": spec_db,
        "peaks": peaks,
    }


def extract_triggered_sweep(
    ch1: np.ndarray,
    ch2: np.ndarray,
    sweep_samples: int,
    trig_level: float,
    rising: bool,
) -> tuple[np.ndarray, np.ndarray, float, bool]:
    """
    Extract triggered (seg1, seg2, sub_sample_frac, locked) centered at X=50% of the CRT screen.
    Returns sweep_samples + 2 samples for clean sub-sample interpolation across all 10 divisions.
    """
    half = max(8, sweep_samples // 2)
    need = sweep_samples + 4
    n = len(ch1)
    if n < need + 16:
        return ch1[-sweep_samples:], ch2[-sweep_samples:], 0.0, False

    # Search recent window so trigger crosses at midpoint of the returned sweep
    search_end = n - half - 3
    search_span = min(max(sweep_samples * 2, 2400), search_end - half - 2)
    search_start = max(half + 2, search_end - search_span)

    y = ch1[search_start : search_end + 1]
    hyst = 0.015

    trig_idx = -1
    frac = 0.0

    if rising:
        # Search backward from latest crossing for lowest latency display
        cond = (y[:-1] <= trig_level) & (y[1:] > trig_level)
        idxs = np.flatnonzero(cond)
        for k in reversed(idxs):
            abs_i = search_start + int(k)
            # Check slight pre-crossing hysteresis to avoid noise chatter
            pre_min = float(np.min(ch1[max(0, abs_i - 12) : abs_i + 1]))
            if pre_min <= trig_level - hyst or ( float(np.max(ch1[abs_i : min(n, abs_i + 12)])) - pre_min ) > 0.02:
                y0 = float(ch1[abs_i])
                y1 = float(ch1[abs_i + 1])
                frac = (trig_level - y0) / (y1 - y0) if abs(y1 - y0) > 1e-9 else 0.0
                trig_idx = abs_i
                break
    else:
        cond = (y[:-1] >= trig_level) & (y[1:] < trig_level)
        idxs = np.flatnonzero(cond)
        for k in reversed(idxs):
            abs_i = search_start + int(k)
            pre_max = float(np.max(ch1[max(0, abs_i - 12) : abs_i + 1]))
            if pre_max >= trig_level + hyst or ( pre_max - float(np.min(ch1[abs_i : min(n, abs_i + 12)])) ) > 0.02:
                y0 = float(ch1[abs_i])
                y1 = float(ch1[abs_i + 1])
                frac = (trig_level - y0) / (y1 - y0) if abs(y1 - y0) > 1e-9 else 0.0
                trig_idx = abs_i
                break

    if trig_idx >= 0:
        s0 = trig_idx - half
        s1 = s0 + sweep_samples + 2
        return ch1[s0:s1].copy(), ch2[s0:s1].copy(), max(0.0, min(1.0, frac)), True

    # Untriggered fallback (latest window)
    s1 = n
    s0 = max(0, s1 - (sweep_samples + 2))
    return ch1[s0:s1].copy(), ch2[s0:s1].copy(), 0.0, False


# ---------------------------------------------------------------------------
# Core Oscilloscope Display & Instrument Controller (Reusable for GUI + Self-Test)
# ---------------------------------------------------------------------------
class ScopeController:
    def __init__(self, engine: ScopeAudioAndGenEngine):
        self.engine = engine

        # Display & Theme
        self.display_mode = "SCOPE"  # SCOPE | DUAL | FFT | WATERFALL | XY
        self.theme_key = "P31"       # P31 | P7 | P4 | DSO

        # Scope Knob normalized values & mapped physical quantities
        self.time_div_ms = 0.50      # 0.2 ms .. 50 ms
        self.volts_gain = 1.00       # 0.2x .. 25x
        self.trig_level = 0.00       # -1.0 .. +1.0
        self.y_pos_div = 0.00        # -4.0 .. +4.0 divisions
        self.intensity = 0.82        # 0.15 .. 1.00
        self.persistence = 0.38      # 0.00 .. 0.95

        # Trigger & Analysis options
        self.trig_rising = True
        self.trig_mode = "AUTO"      # AUTO | NORM | SINGLE
        self.single_armed = False
        self.frozen = False
        self.fft_log = True
        self.fft_peak_hold = True
        self.cursors_manual = False

        # Movable ΔT / ΔV Cursor normalized coordinates [0..1]
        self.cur_t1 = 0.30
        self.cur_t2 = 0.70
        self.cur_v1 = 0.28
        self.cur_v2 = 0.72

        # Live processed buffers & telemetry
        self.telemetry = {
            "freq_hz": 0.0,
            "period_ms": 0.0,
            "vpp": 0.0,
            "vrms": 0.0,
            "peak_dbfs": -96.0,
            "dom_fft_hz": 0.0,
            "spec_db": np.full(FFT_SIZE // 2 + 1, -96.0, dtype=np.float32),
            "peaks": [],
        }
        self.peak_hold_db = np.full(FFT_SIZE // 2 + 1, -96.0, dtype=np.float32)
        self.active_badge = "DESKTOP MON"
        self.trig_locked = False

        self.held_seg1: np.ndarray | None = None
        self.held_seg2: np.ndarray | None = None
        self.held_frac = 0.0
        self.held_xy1: np.ndarray | None = None
        self.held_xy2: np.ndarray | None = None

        # Persistence Cairo surface + Waterfall RGB24 pixel buffer
        self._persist_surf: cairo.ImageSurface | None = None
        self._persist_wh = (0, 0)
        self._persist_mode_tag = ""
        self._wf_buf = np.zeros((WF_H, WF_W, 4), dtype=np.uint8)
        self._wf_buf[:, :, 3] = 255
        self._crt_screen_rect = (16.0, 14.0, 640.0, 420.0)

    @property
    def cursors_visible(self) -> bool:
        return self.theme_key == "DSO" or self.cursors_manual

    def clear_persistence(self):
        if self._persist_surf is not None:
            pcr = cairo.Context(self._persist_surf)
            pcr.set_operator(cairo.OPERATOR_CLEAR)
            pcr.paint()

    def reset_peak_hold(self):
        self.peak_hold_db.fill(-96.0)

    def step_dsp(self):
        """Run one ~30 fps DSP update cycle unless frozen or single-shot captured."""
        if self.frozen:
            return
        if self.trig_mode == "SINGLE" and not self.single_armed and self.held_seg1 is not None:
            return

        ch1, ch2, badge = self.engine.snapshot_channels()
        self.active_badge = badge

        tel = compute_telemetry_and_fft(ch1)
        self.telemetry = tel

        if self.fft_peak_hold:
            # Slow ballistic decay on peak hold (-0.12 dB/frame) + instant attack
            self.peak_hold_db = np.maximum(self.peak_hold_db - 0.08, tel["spec_db"])
        else:
            self.peak_hold_db[:] = tel["spec_db"]

        sweep_samples = max(48, min(24000, int(round(10.0 * (self.time_div_ms / 1000.0) * SAMPLE_RATE))))
        # Trigger level on screen corresponds to signal threshold = trig_level / volts_gain
        eff_trig = (self.trig_level * 2.5) / max(0.2, self.volts_gain)
        seg1, seg2, frac, locked = extract_triggered_sweep(
            ch1, ch2, sweep_samples, eff_trig, self.trig_rising
        )

        if locked:
            self.trig_locked = True
            self.held_seg1 = seg1
            self.held_seg2 = seg2
            self.held_frac = frac
            if self.trig_mode == "SINGLE" and self.single_armed:
                self.single_armed = False
        else:
            self.trig_locked = False
            if self.trig_mode == "AUTO" or self.held_seg1 is None:
                self.held_seg1 = seg1
                self.held_seg2 = seg2
                self.held_frac = 0.0

        # X-Y vector slice (2048 samples = 42.6 ms trail per frame)
        self.held_xy1 = ch1[-2048:].copy()
        self.held_xy2 = ch2[-2048:].copy()

        # Advance Waterfall Spectrogram row
        self._push_waterfall_row(tel["spec_db"])

    def _push_waterfall_row(self, spec_db: np.ndarray):
        self._wf_buf[1:] = self._wf_buf[:-1]
        cols_x = np.linspace(0.0, 1.0, WF_W, dtype=np.float32)
        if self.fft_log:
            freqs = 20.0 * np.power(1000.0, cols_x)  # 20 Hz .. 20 kHz
        else:
            freqs = 20.0 + cols_x * (20000.0 - 20.0)
        row_db = np.interp(freqs, FFT_FREQS, spec_db)
        norm = np.clip((row_db + 88.0) / 84.0, 0.0, 1.0)
        idx = (norm * 255.0).astype(np.uint8)
        self._wf_buf[0] = WF_LUTS[self.theme_key][idx]

    # ---- Top VFD Counter & Telemetry Bar Renderer ----
    def draw_vfd_bar(self, cr: cairo.Context, W: float, H: float):
        # Outer recessed VFD housing
        cr.rectangle(0, 0, W, H)
        cr.set_source_rgb(0.03, 0.06, 0.065)
        cr.fill()

        # 3D sunken glass bevel
        cr.set_line_width(2.0)
        cr.set_source_rgb(0.01, 0.02, 0.025)
        cr.move_to(0, H)
        cr.line_to(0, 0)
        cr.line_to(W, 0)
        cr.stroke()
        cr.set_source_rgb(0.35, 0.40, 0.48)
        cr.move_to(0, H)
        cr.line_to(W, H)
        cr.line_to(W, 0)
        cr.stroke()

        tel = self.telemetry
        f_hz = tel["freq_hz"]
        if f_hz >= 1000.0:
            freq_txt = f"{f_hz:7.1f} Hz"
        elif f_hz > 0.5:
            freq_txt = f"{f_hz:7.2f} Hz"
        else:
            freq_txt = "  ---.- Hz"

        per_txt = f"{tel['period_ms']:6.3f} ms" if tel["period_ms"] > 0.001 else " --.--- ms"
        vpp_txt = f"{tel['vpp']:5.3f} V"
        rms_txt = f"{tel['vrms']:5.3f} V"
        pk_txt = f"{tel['peak_dbfs']:+5.1f} dB"
        dom_txt = f"{tel['dom_fft_hz']:6.1f} Hz" if tel["dom_fft_hz"] >= 20.0 else " ---.- Hz"

        cells = [
            ("COUNTER FREQ", freq_txt, 1.24, (0.24, 0.99, 0.86)),
            ("PERIOD", per_txt, 1.00, (0.36, 0.95, 0.82)),
            ("AMPL Vpp", vpp_txt, 0.92, (0.36, 0.95, 0.82)),
            ("TRUE Vrms", rms_txt, 0.92, (0.36, 0.95, 0.82)),
            ("PEAK dBFS", pk_txt, 0.96, (1.00, 0.78, 0.30) if tel["peak_dbfs"] > -3.0 else (0.36, 0.95, 0.82)),
            ("DOMINANT FFT", dom_txt, 1.06, (0.48, 0.92, 1.00)),
        ]

        led_w = 112.0
        usable_w = max(400.0, W - led_w - 18.0)
        w_sum = sum(c[2] for c in cells)
        x = 8.0

        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        for title, val, weight, col in cells:
            cw = usable_w * (weight / w_sum)
            # Subtle VFD cell frame
            cr.rectangle(x + 2, 6, cw - 4, H - 12)
            cr.set_source_rgba(0.08, 0.22, 0.22, 0.36)
            cr.fill()

            cr.set_font_size(8.2)
            cr.set_source_rgb(0.42, 0.76, 0.72)
            cr.move_to(x + 8, 17.5)
            cr.show_text(title)

            # Phosphor VFD segment glow + crisp digits
            cr.set_font_size(15.0 if weight > 1.1 else 13.5)
            cr.set_source_rgba(col[0], col[1], col[2], 0.20)
            cr.move_to(x + 9.2, H - 11.0)
            cr.show_text(val)
            cr.set_source_rgb(*col)
            cr.move_to(x + 8.0, H - 12.0)
            cr.show_text(val)
            x += cw

        # Right Trigger Lock & Hold Status LED Block
        lx = W - led_w - 6.0
        cr.rectangle(lx, 6, led_w, H - 12)
        cr.set_source_rgba(0.06, 0.14, 0.16, 0.55)
        cr.fill()

        if self.frozen or (self.trig_mode == "SINGLE" and not self.single_armed):
            led_col = (0.28, 0.90, 1.00)
            trig_lbl = "HOLD / STOPPED"
        elif self.trig_locked:
            led_col = (0.22, 1.00, 0.54)
            trig_lbl = "TRIG'D  LOCK"
        elif self.trig_mode == "SINGLE":
            led_col = (1.00, 0.72, 0.20)
            trig_lbl = "ARMED  SNGL"
        else:
            led_col = (1.00, 0.68, 0.22)
            trig_lbl = "AUTO  FREE"

        cr.set_font_size(8.2)
        cr.set_source_rgb(0.46, 0.78, 0.74)
        cr.move_to(lx + 8, 17.5)
        cr.show_text(f"TRIG ({self.trig_mode})")

        # Glowing LED lamp
        led_cx, led_cy = lx + 14.0, H - 17.0
        cr.arc(led_cx, led_cy, 6.8, 0, 2 * math.pi)
        cr.set_source_rgba(led_col[0], led_col[1], led_col[2], 0.32)
        cr.fill()
        cr.arc(led_cx, led_cy, 4.0, 0, 2 * math.pi)
        cr.set_source_rgb(*led_col)
        cr.fill()

        cr.set_font_size(9.5)
        cr.set_source_rgb(*led_col)
        cr.move_to(lx + 25.0, H - 13.5)
        cr.show_text(trig_lbl[:11])

    # ---- Main Hybrid Analog CRT / DSO Screen Renderer ----
    def draw_crt(self, cr: cairo.Context, W: float, H: float):
        th = PHOSPHOR_THEMES[self.theme_key]

        # Molded dark bezel surround
        cr.rectangle(0, 0, W, H)
        cr.set_source_rgb(0.09, 0.105, 0.13)
        cr.fill()

        pad_x, pad_y = 14.0, 12.0
        sx = pad_x
        sy = pad_y
        sw = max(120.0, W - 2.0 * pad_x)
        sh = max(96.0, H - 2.0 * pad_y)
        self._crt_screen_rect = (sx, sy, sw, sh)

        # Recessed CRT bezel shadow rim
        cr.rectangle(sx - 4, sy - 4, sw + 8, sh + 8)
        cr.set_source_rgb(0.04, 0.045, 0.055)
        cr.fill()

        # Phosphor CRT Glass Gradient
        glass = cairo.LinearGradient(sx, sy, sx, sy + sh)
        glass.add_color_stop_rgb(0.0, *th["glass_top"])
        glass.add_color_stop_rgb(1.0, *th["glass_bot"])
        cr.rectangle(sx, sy, sw, sh)
        cr.set_source(glass)
        cr.fill()

        # Prepare/update persistence trail surface for beam modes (SCOPE, DUAL, FFT, XY)
        iw, ih = max(32, int(sw)), max(32, int(sh))
        mode_tag = f"{self.display_mode}:{self.theme_key}"
        if self._persist_surf is None or self._persist_wh != (iw, ih) or self._persist_mode_tag != mode_tag:
            self._persist_surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, iw, ih)
            self._persist_wh = (iw, ih)
            self._persist_mode_tag = mode_tag

        cr.save()
        cr.rectangle(sx, sy, sw, sh)
        cr.clip()

        if self.display_mode == "WATERFALL":
            self._draw_waterfall_mode(cr, sx, sy, sw, sh, th)
        else:
            # Decay existing phosphor persistence buffer
            pcr = cairo.Context(self._persist_surf)
            decay = 0.0 if self.persistence < 0.02 else min(0.95, self.persistence)
            pcr.save()
            pcr.set_operator(cairo.OPERATOR_DEST_IN)
            pcr.set_source_rgba(0.0, 0.0, 0.0, decay)
            pcr.paint()
            pcr.restore()

            # Draw live electron beam onto persistence buffer (local coords 0..iw, 0..ih)
            if self.display_mode in ("SCOPE", "DUAL"):
                self._draw_scope_traces(pcr, float(iw), float(ih), th)
            elif self.display_mode == "FFT":
                self._draw_fft_traces(pcr, float(iw), float(ih), th)
            elif self.display_mode == "XY":
                self._draw_xy_traces(pcr, float(iw), float(ih), th)

            # Composite phosphor beam buffer onto CRT glass before/with etched internal graticule
            cr.save()
            cr.set_operator(cairo.OPERATOR_ADD)
            cr.set_source_surface(self._persist_surf, sx, sy)
            cr.paint()
            cr.restore()

            # Internal etched 10x8 graticule + center crosshair sub-ticks
            self._draw_graticule(cr, sx, sy, sw, sh, th)

            # Mode-specific non-persistent crisp annotations (FFT peak labels, trigger arrow, cursors, HUD)
            if self.display_mode == "FFT":
                self._draw_fft_annotations(cr, sx, sy, sw, sh, th)
            elif self.display_mode in ("SCOPE", "DUAL"):
                self._draw_trigger_markers(cr, sx, sy, sw, sh, th)

        if self.cursors_visible:
            self._draw_measurement_cursors(cr, sx, sy, sw, sh, th)

        self._draw_crt_readout_hud(cr, sx, sy, sw, sh, th)

        # Subtle curved CRT glass specular highlight at top edge
        spec_grad = cairo.LinearGradient(sx, sy, sx, sy + sh * 0.28)
        spec_grad.add_color_stop_rgba(0.0, 1.0, 1.0, 1.0, 0.055)
        spec_grad.add_color_stop_rgba(1.0, 1.0, 1.0, 1.0, 0.0)
        cr.rectangle(sx, sy, sw, sh * 0.28)
        cr.set_source(spec_grad)
        cr.fill()

        cr.restore()

        # Crisp inner CRT bezel border
        cr.rectangle(sx, sy, sw, sh)
        cr.set_line_width(1.6)
        cr.set_source_rgb(0.24, 0.28, 0.34)
        cr.stroke()

    def _draw_graticule(self, cr: cairo.Context, sx: float, sy: float, sw: float, sh: float, th: dict):
        dx = sw / 10.0
        dy = sh / 8.0

        cr.set_line_width(1.0)
        if self.theme_key == "DSO":
            cr.set_dash([2.0, 3.0])
        cr.set_source_rgba(*th["grat"])

        for i in range(1, 10):
            gx = sx + i * dx
            cr.move_to(gx, sy)
            cr.line_to(gx, sy + sh)
        for j in range(1, 8):
            gy = sy + j * dy
            cr.move_to(sx, gy)
            cr.line_to(sx + sw, gy)
        cr.stroke()
        cr.set_dash([])

        # Solid center crosshair axes + 5 sub-divisions per division (50 x 40 sub-ticks)
        cx = sx + 5.0 * dx
        cy = sy + 4.0 * dy
        cr.set_source_rgba(*th["grat_sub"])
        cr.set_line_width(1.2)
        cr.move_to(cx, sy)
        cr.line_to(cx, sy + sh)
        cr.move_to(sx, cy)
        cr.line_to(sx + sw, cy)
        cr.stroke()

        cr.set_line_width(1.0)
        sub_dx = sw / 50.0
        for k in range(1, 50):
            if k % 5 != 0:
                tx = sx + k * sub_dx
                cr.move_to(tx, cy - 3.5)
                cr.line_to(tx, cy + 3.5)
        sub_dy = sh / 40.0
        for k in range(1, 40):
            if k % 5 != 0:
                ty = sy + k * sub_dy
                cr.move_to(cx - 3.5, ty)
                cr.line_to(cx + 3.5, ty)
        cr.stroke()

        # Tektronix-style 100% / 90% / 10% / 0% rise-time calibration marks on left & right
        cr.set_font_size(7.8)
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        for div_off, pct in ((-2.5, "100"), (-2.0, "90"), (2.0, "10"), (2.5, "0%")):
            my = cy + div_off * dy
            cr.move_to(sx, my)
            cr.line_to(sx + 5.0, my)
            cr.stroke()
            cr.move_to(sx + 7.0, my + 2.8)
            cr.show_text(pct)

    def _stroke_phosphor_beam(
        self,
        pcr: cairo.Context,
        xs: np.ndarray,
        ys: np.ndarray,
        halo_rgb: tuple[float, float, float],
        core_rgb: tuple[float, float, float],
        hot_rgb: tuple[float, float, float] | None = None,
    ):
        if len(xs) < 2:
            return
        inten = self.intensity

        pcr.new_path()
        pcr.move_to(float(xs[0]), float(ys[0]))
        for i in range(1, len(xs)):
            pcr.line_to(float(xs[i]), float(ys[i]))

        pcr.set_line_join(cairo.LINE_JOIN_ROUND)
        pcr.set_line_cap(cairo.LINE_CAP_ROUND)

        # 1. Wide phosphor bloom halo
        pcr.set_line_width(5.2 * (0.65 + 0.55 * inten))
        pcr.set_source_rgba(halo_rgb[0], halo_rgb[1], halo_rgb[2], 0.22 * inten)
        pcr.stroke_preserve()

        # 2. Main phosphor trace body
        pcr.set_line_width(2.0 * (0.75 + 0.35 * inten))
        pcr.set_source_rgba(core_rgb[0], core_rgb[1], core_rgb[2], min(1.0, 0.82 * inten + 0.16))
        if hot_rgb is not None and inten > 0.45:
            pcr.stroke_preserve()
            pcr.set_line_width(0.95)
            pcr.set_source_rgba(hot_rgb[0], hot_rgb[1], hot_rgb[2], 0.72 * inten)
            pcr.stroke()
        else:
            pcr.stroke()

    def _draw_scope_traces(self, pcr: cairo.Context, W: float, H: float, th: dict):
        if self.held_seg1 is None or len(self.held_seg1) < 4:
            return
        seg1 = self.held_seg1
        seg2 = self.held_seg2
        n_total = len(seg1) - 2
        if n_total < 2:
            return

        dy = H / 8.0
        cy = H * 0.5 - self.y_pos_div * dy
        scale_y = 2.5 * dy * self.volts_gain  # ±1.0 FS @ 1.0x spans ±2.5 divisions

        # Resample/decimate cleanly to max ~720 screen points with sub-sample trigger shift
        n_pts = min(720, max(160, int(W)))
        if n_total <= n_pts:
            t_idx = np.arange(len(seg1), dtype=np.float64)
            xs = ((t_idx - self.held_frac) / float(n_total)) * W
            ys1 = cy - seg1 * scale_y
            ys2 = cy - seg2 * scale_y if seg2 is not None else None
        else:
            # Peak-preserving / interpolated projection onto n_pts columns
            grid = np.linspace(0.0, float(n_total), n_pts) + self.held_frac
            src_idx = np.arange(len(seg1), dtype=np.float64)
            xs = np.linspace(0.0, W, n_pts)
            ys1 = cy - np.interp(grid, src_idx, seg1) * scale_y
            ys2 = (cy - np.interp(grid, src_idx, seg2) * scale_y) if seg2 is not None else None

        if self.display_mode == "DUAL" and ys2 is not None:
            # Slight vertical separation if user hasn't shifted, or overlaid on same graticule
            self._stroke_phosphor_beam(pcr, xs, ys2, th["ch2_halo"], th["ch2_core"], None)

        self._stroke_phosphor_beam(pcr, xs, ys1, th["ch1_halo"], th["ch1_core"], th["ch1_hot"])

    def _draw_trigger_markers(self, cr: cairo.Context, sx: float, sy: float, sw: float, sh: float, th: dict):
        dy = sh / 8.0
        cy = sy + sh * 0.5 - self.y_pos_div * dy
        # Trigger level Y on screen: eff_trig = (trig_level * 2.5) / gain -> y = cy - eff_trig * (2.5 * dy * gain) = cy - trig_level * 2.5 * dy
        ty = max(sy + 6.0, min(sy + sh - 6.0, cy - self.trig_level * 2.5 * dy))

        # Faint dashed horizontal trigger level guide when dragging or in DSO theme
        cr.set_line_width(1.0)
        cr.set_dash([3.0, 4.0])
        cr.set_source_rgba(th["cursor_v"][0], th["cursor_v"][1], th["cursor_v"][2], 0.34)
        cr.move_to(sx, ty)
        cr.line_to(sx + sw, ty)
        cr.stroke()
        cr.set_dash([])

        # Right-edge draggable Trigger Level arrow (◀ T)
        rx = sx + sw
        cr.set_source_rgb(*th["cursor_v"])
        cr.move_to(rx - 12.0, ty)
        cr.line_to(rx - 2.0, ty - 5.5)
        cr.line_to(rx - 2.0, ty + 5.5)
        cr.close_path()
        cr.fill()

        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.5)
        cr.move_to(rx - 21.0, ty + 3.0)
        cr.show_text("T")

        # Top center X=50% Trigger Time marker (▼)
        tx = sx + sw * 0.5
        cr.move_to(tx, sy + 9.0)
        cr.line_to(tx - 5.0, sy + 1.5)
        cr.line_to(tx + 5.0, sy + 1.5)
        cr.close_path()
        cr.fill()

    def _draw_fft_traces(self, pcr: cairo.Context, W: float, H: float, th: dict):
        spec_db = self.telemetry["spec_db"]
        n_pts = min(640, max(200, int(W)))
        xs = np.linspace(0.0, W, n_pts)
        u = np.linspace(0.0, 1.0, n_pts)
        freqs = 20.0 * np.power(1000.0, u) if self.fft_log else (20.0 + u * (20000.0 - 20.0))

        vals_db = np.interp(freqs, FFT_FREQS, spec_db)
        # Map -96 dBFS .. +4 dBFS across H (100 dB total = 12.5 dB/div across 8 vertical divisions)
        ys = H - np.clip((vals_db + 96.0) / 100.0, 0.0, 1.0) * H

        # Subtle translucent phosphor fill under live FFT curve
        pcr.save()
        pcr.new_path()
        pcr.move_to(0.0, H)
        for i in range(n_pts):
            pcr.line_to(float(xs[i]), float(ys[i]))
        pcr.line_to(W, H)
        pcr.close_path()
        pcr.set_source_rgba(th["ch1_halo"][0], th["ch1_halo"][1], th["ch1_halo"][2], 0.14 * self.intensity)
        pcr.fill()
        pcr.restore()

        # Peak-Hold trace
        if self.fft_peak_hold:
            pk_vals = np.interp(freqs, FFT_FREQS, self.peak_hold_db)
            pk_ys = H - np.clip((pk_vals + 96.0) / 100.0, 0.0, 1.0) * H
            pcr.new_path()
            pcr.move_to(float(xs[0]), float(pk_ys[0]))
            for i in range(1, n_pts):
                pcr.line_to(float(xs[i]), float(pk_ys[i]))
            pcr.set_line_width(1.3)
            pcr.set_source_rgba(th["peak"][0], th["peak"][1], th["peak"][2], 0.72 * self.intensity)
            pcr.stroke()

        self._stroke_phosphor_beam(pcr, xs, ys, th["ch1_halo"], th["ch1_core"], th["ch1_hot"])

    def _draw_fft_annotations(self, cr: cairo.Context, sx: float, sy: float, sw: float, sh: float, th: dict):
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.2)

        # Frequency axis grid labels along bottom
        if self.fft_log:
            marks = [(20, "20"), (50, "50"), (100, "100"), (200, "200"), (500, "500"),
                     (1000, "1k"), (2000, "2k"), (5000, "5k"), (10000, "10k"), (20000, "20k")]
            for f, lbl in marks:
                u = math.log10(f / 20.0) / 3.0
                gx = sx + u * sw
                cr.set_source_rgba(*th["grat_sub"])
                cr.set_line_width(0.8)
                cr.move_to(gx, sy + sh - 6)
                cr.line_to(gx, sy + sh)
                cr.stroke()
                ext = cr.text_extents(lbl)
                tx = max(sx + 3.0, min(sx + sw - ext.width - 3.0, gx - ext.width * 0.5))
                cr.set_source_rgb(*th["hud"])
                cr.move_to(tx, sy + sh - 9.0)
                cr.show_text(lbl)
        else:
            for k in range(0, 21, 4):
                f = max(20.0, k * 1000.0)
                u = (f - 20.0) / (20000.0 - 20.0)
                gx = sx + u * sw
                lbl = f"{k}k" if k > 0 else "20Hz"
                ext = cr.text_extents(lbl)
                tx = max(sx + 3.0, min(sx + sw - ext.width - 3.0, gx - ext.width * 0.5))
                cr.set_source_rgb(*th["hud"])
                cr.move_to(tx, sy + sh - 9.0)
                cr.show_text(lbl)

        # Auto-annotated top harmonic peaks
        for idx, (f_hz, db_val) in enumerate(self.telemetry["peaks"]):
            if not (20.0 <= f_hz <= 20000.0):
                continue
            u = (math.log10(f_hz / 20.0) / 3.0) if self.fft_log else ((f_hz - 20.0) / (20000.0 - 20.0))
            px = sx + u * sw
            py = sy + sh - np.clip((db_val + 96.0) / 100.0, 0.0, 1.0) * sh

            # Diamond marker + callout
            cr.set_source_rgb(*(th["peak"] if idx > 0 else th["ch1_hot"]))
            cr.move_to(px, py - 5.0)
            cr.line_to(px + 4.0, py)
            cr.line_to(px, py + 5.0)
            cr.line_to(px - 4.0, py)
            cr.close_path()
            cr.fill()

            tag = f"{f_hz / 1000.0:.2f}k" if f_hz >= 1000.0 else f"{f_hz:.0f}Hz"
            ext = cr.text_extents(tag)
            lx = max(sx + 4.0, min(sx + sw - ext.width - 4.0, px - ext.width * 0.5))
            ly = max(sy + 26.0, py - 9.0)
            cr.set_source_rgba(0.02, 0.04, 0.06, 0.72)
            cr.rectangle(lx - 2, ly - 9, ext.width + 4, 11)
            cr.fill()
            cr.set_source_rgb(*th["peak"])
            cr.move_to(lx, ly)
            cr.show_text(tag)

    def _draw_waterfall_mode(self, cr: cairo.Context, sx: float, sy: float, sw: float, sh: float, th: dict):
        # Top 26% live spectrum trace + Bottom 74% high-res scrolling phosphor spectrogram
        spec_h = sh * 0.27
        wf_y = sy + spec_h
        wf_h = sh - spec_h

        # Blit NumPy ARGB32/RGB24 waterfall image scaled cleanly to CRT width
        wf_surf = cairo.ImageSurface.create_for_data(
            self._wf_buf, cairo.FORMAT_RGB24, WF_W, WF_H, WF_W * 4
        )
        cr.save()
        cr.translate(sx, wf_y)
        cr.scale(sw / float(WF_W), wf_h / float(WF_H))
        cr.set_source_surface(wf_surf, 0.0, 0.0)
        cr.paint()
        cr.restore()

        # Live mini FFT trace in top strip
        spec_db = self.telemetry["spec_db"]
        n_pts = min(520, max(160, int(sw)))
        xs = sx + np.linspace(0.0, sw, n_pts)
        u = np.linspace(0.0, 1.0, n_pts)
        freqs = 20.0 * np.power(1000.0, u) if self.fft_log else (20.0 + u * (20000.0 - 20.0))
        vals_db = np.interp(freqs, FFT_FREQS, spec_db)
        ys = sy + spec_h - np.clip((vals_db + 96.0) / 100.0, 0.04, 0.94) * spec_h

        self._stroke_phosphor_beam(cr, xs, ys, th["ch1_halo"], th["ch1_core"], th["ch1_hot"])

        # Separator scale bar between live FFT and scrolling waterfall
        cr.set_line_width(1.4)
        cr.set_source_rgba(*th["grat_sub"])
        cr.move_to(sx, wf_y)
        cr.line_to(sx + sw, wf_y)
        cr.stroke()

        self._draw_graticule(cr, sx, sy, sw, sh, th)
        self._draw_fft_annotations(cr, sx, sy, sw, spec_h + 14.0, th)

    def _draw_xy_traces(self, pcr: cairo.Context, W: float, H: float, th: dict):
        if self.held_xy1 is None or self.held_xy2 is None:
            return
        x_sig = self.held_xy1
        y_sig = self.held_xy2
        dy = H / 8.0
        scale = 2.5 * dy * self.volts_gain
        cx = W * 0.5
        cy = H * 0.5 - self.y_pos_div * dy

        # Subsample cleanly to 900 points for crisp high-speed vector drawing
        step = max(1, len(x_sig) // 900)
        xs = cx + x_sig[::step] * scale
        ys = cy - y_sig[::step] * scale

        self._stroke_phosphor_beam(pcr, xs, ys, th["ch1_halo"], th["ch1_core"], th["ch1_hot"])

    def _draw_measurement_cursors(self, cr: cairo.Context, sx: float, sy: float, sw: float, sh: float, th: dict):
        x1 = sx + self.cur_t1 * sw
        x2 = sx + self.cur_t2 * sw
        y1 = sy + self.cur_v1 * sh
        y2 = sy + self.cur_v2 * sh

        cr.set_line_width(1.2)
        cr.set_dash([5.0, 3.0])

        # Vertical T1 / T2 cursors
        cr.set_source_rgba(th["cursor_t"][0], th["cursor_t"][1], th["cursor_t"][2], 0.88)
        cr.move_to(x1, sy)
        cr.line_to(x1, sy + sh)
        cr.move_to(x2, sy)
        cr.line_to(x2, sy + sh)
        cr.stroke()

        # Horizontal V1 / V2 cursors
        cr.set_source_rgba(th["cursor_v"][0], th["cursor_v"][1], th["cursor_v"][2], 0.88)
        cr.move_to(sx, y1)
        cr.line_to(sx + sw, y1)
        cr.move_to(sx, y2)
        cr.line_to(sx + sw, y2)
        cr.stroke()
        cr.set_dash([])

        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.5)
        cr.set_source_rgb(*th["cursor_t"])
        cr.move_to(x1 + 3, sy + sh - 22)
        cr.show_text("T1")
        cr.move_to(x2 + 3, sy + sh - 22)
        cr.show_text("T2")

        cr.set_source_rgb(*th["cursor_v"])
        cr.move_to(sx + 24, y1 - 3)
        cr.show_text("V1")
        cr.move_to(sx + 24, y2 - 3)
        cr.show_text("V2")

        # Compute physical ΔT / ΔV or ΔF / ΔdB readout box at top-right of CRT
        if self.display_mode in ("FFT", "WATERFALL"):
            def u_to_f(u: float) -> float:
                return 20.0 * math.pow(1000.0, u) if self.fft_log else (20.0 + u * (20000.0 - 20.0))
            f1, f2 = u_to_f(self.cur_t1), u_to_f(self.cur_t2)
            df = abs(f2 - f1)
            db1 = 4.0 - self.cur_v1 * 100.0
            db2 = 4.0 - self.cur_v2 * 100.0
            line1 = f"F1:{f1:6.0f}Hz F2:{f2:6.0f}Hz ΔF:{df:6.0f}Hz"
            line2 = f"L1:{db1:+5.1f}dB L2:{db2:+5.1f}dB ΔL:{db2-db1:+5.1f}dB"
        else:
            full_ms = 10.0 * self.time_div_ms
            dt_ms = abs(self.cur_t2 - self.cur_t1) * full_ms
            inv_hz = (1000.0 / dt_ms) if dt_ms > 1e-4 else 0.0
            # Full vertical height is 8 divisions; 2.5 divs = 1.0 V @ gain=1.0 -> 1 div = 0.40 / gain V
            v_per_div = 0.40 / max(0.2, self.volts_gain)
            v1_val = ((0.5 - self.cur_v1) * 8.0 - self.y_pos_div) * v_per_div
            v2_val = ((0.5 - self.cur_v2) * 8.0 - self.y_pos_div) * v_per_div
            dv_val = abs(v2_val - v1_val)
            line1 = f"ΔT:{dt_ms:6.2f}ms  1/ΔT:{inv_hz:6.1f}Hz"
            line2 = f"V1:{v1_val:+5.2f}V  V2:{v2_val:+5.2f}V  ΔV:{dv_val:5.2f}V"

        cr.set_font_size(8.4)
        w_box = max(cr.text_extents(line1).width, cr.text_extents(line2).width) + 14.0
        bx = sx + sw - w_box - 8.0
        by = sy + 24.0
        cr.set_source_rgba(0.02, 0.04, 0.07, 0.80)
        cr.rectangle(bx, by, w_box, 30.0)
        cr.fill()
        cr.set_line_width(1.0)
        cr.set_source_rgba(th["hud"][0], th["hud"][1], th["hud"][2], 0.45)
        cr.rectangle(bx, by, w_box, 30.0)
        cr.stroke()

        cr.set_source_rgb(*th["cursor_t"])
        cr.move_to(bx + 7.0, by + 12.0)
        cr.show_text(line1)
        cr.set_source_rgb(*th["cursor_v"])
        cr.move_to(bx + 7.0, by + 24.5)
        cr.show_text(line2)

    def _draw_crt_readout_hud(self, cr: cairo.Context, sx: float, sy: float, sw: float, _sh: float, th: dict):
        """Tektronix 2465B / HP 54600 top CRT character-generator scale readout."""
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.8)

        v_div = 0.40 / max(0.2, self.volts_gain)
        v_str = f"{v_div * 1000.0:.0f}mV/div" if v_div < 0.1 else f"{v_div:.2f}V/div"
        t_str = f"{self.time_div_ms * 1000.0:.0f}us/div" if self.time_div_ms < 1.0 else f"{self.time_div_ms:.2f}ms/div"
        slope = "↗" if self.trig_rising else "↘"

        if self.display_mode in ("FFT", "WATERFALL"):
            scale_txt = f"FFT 4096-PT HANNING  {'LOG' if self.fft_log else 'LIN'} 20Hz-20kHz  12.5dB/div"
        elif self.display_mode == "XY":
            corr = 0.0
            if self.held_xy1 is not None and self.held_xy2 is not None:
                n1 = float(np.linalg.norm(self.held_xy1))
                n2 = float(np.linalg.norm(self.held_xy2))
                if n1 > 1e-4 and n2 > 1e-4:
                    cval = max(-1.0, min(1.0, float(np.dot(self.held_xy1, self.held_xy2)) / (n1 * n2)))
                    corr = math.degrees(math.acos(cval))
            scale_txt = f"X-Y LISSAJOUS   CH1/CH2: {v_str} ({self.volts_gain:.1f}x)   PHASE φ≈{corr:4.0f}°"
        else:
            ch2_lbl = f"  CH2:{v_str}" if self.display_mode == "DUAL" else ""
            scale_txt = f"CH1:{v_str} ({self.volts_gain:.1f}x){ch2_lbl}   TB:{t_str}   TRIG:{slope}{self.trig_level:+.2f}"

        cr.set_source_rgba(0.01, 0.03, 0.04, 0.65)
        ext = cr.text_extents(scale_txt)
        cr.rectangle(sx + 6, sy + 4, ext.width + 10, 15)
        cr.fill()
        cr.set_source_rgb(*th["hud"])
        cr.move_to(sx + 11, sy + 15)
        cr.show_text(scale_txt)

        # Right-corner source / freeze badge
        rt_txt = f"[FROZEN] {self.active_badge}" if self.frozen else self.active_badge
        rext = cr.text_extents(rt_txt)
        rx = sx + sw - rext.width - 14.0
        cr.set_source_rgba(0.01, 0.03, 0.04, 0.65)
        cr.rectangle(rx - 4, sy + 4, rext.width + 10, 15)
        cr.fill()
        cr.set_source_rgb(*( (1.0, 0.76, 0.28) if "STANDBY" in rt_txt or self.frozen else th["hud"] ))
        cr.move_to(rx + 1, sy + 15)
        cr.show_text(rt_txt)


