    # ---- Interactive CRT Mouse Dragging (Trigger Level + ΔT/ΔV Cursors + Wheel Timebase) ----
    def _on_crt_press(self, _w, ev):
        if ev.button != 1:
            return False
        sx, sy, sw, sh = self.ctrl._crt_screen_rect
        if not (sx <= ev.x <= sx + sw and sy <= ev.y <= sy + sh):
            return False

        # Hit-test movable cursors if active
        if self.ctrl.cursors_visible:
            x1 = sx + self.ctrl.cur_t1 * sw
            x2 = sx + self.ctrl.cur_t2 * sw
            y1 = sy + self.ctrl.cur_v1 * sh
            y2 = sy + self.ctrl.cur_v2 * sh
            cands = [
                (abs(ev.x - x1), "t1"),
                (abs(ev.x - x2), "t2"),
                (abs(ev.y - y1), "v1"),
                (abs(ev.y - y2), "v2"),
            ]
            best_d, best_name = min(cands, key=lambda t: t[0])
            if best_d <= 11.0:
                self._drag_target = best_name
                return True

        # Hit-test right-side Trigger Level handle in SCOPE / DUAL modes
        if self.ctrl.display_mode in ("SCOPE", "DUAL") and ev.x >= sx + sw - 34.0:
            self._drag_target = "trig"
            self._update_crt_drag(ev.x, ev.y)
            return True

        return False

    def _on_crt_release(self, _w, _ev):
        self._drag_target = None
        return True

    def _on_crt_motion(self, _w, ev):
        if self._drag_target is not None:
            self._update_crt_drag(ev.x, ev.y)
            return True
        return False

    def _update_crt_drag(self, mx: float, my: float):
        sx, sy, sw, sh = self.ctrl._crt_screen_rect
        ux = max(0.02, min(0.98, (mx - sx) / max(1.0, sw)))
        uy = max(0.02, min(0.98, (my - sy) / max(1.0, sh)))

        if self._drag_target == "t1":
            self.ctrl.cur_t1 = ux
        elif self._drag_target == "t2":
            self.ctrl.cur_t2 = ux
        elif self._drag_target == "v1":
            self.ctrl.cur_v1 = uy
        elif self._drag_target == "v2":
            self.ctrl.cur_v2 = uy
        elif self._drag_target == "trig":
            dy = sh / 8.0
            cy = sy + sh * 0.5 - self.ctrl.y_pos_div * dy
            lvl = max(-1.0, min(1.0, (cy - my) / (2.5 * dy)))
            self.knob_trig.set_value(0.5 + lvl * 0.5, notify=True)
        self.crt_area.queue_draw()

    def _on_crt_scroll(self, _w, ev):
        # Scroll wheel over CRT zooms TIME / DIV smoothly
        step = 0.035
        if ev.direction == Gdk.ScrollDirection.UP:
            self.knob_time.set_value(self.knob_time.value - step, notify=True)
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            self.knob_time.set_value(self.knob_time.value + step, notify=True)
        elif ev.direction == Gdk.ScrollDirection.SMOOTH:
            _, _dx, dy = ev.get_scroll_deltas()
            self.knob_time.set_value(self.knob_time.value + dy * 0.025, notify=True)
        return True

