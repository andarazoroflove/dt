    def _greenbar_cell_func(self, _col, cell, model, tree_iter, _cidx):
        path = model.get_path(tree_iter)
        row_idx = path.get_indices()[0] if path else 0
        if self.dark_radium:
            bg = "#101c17" if (row_idx % 2 == 0) else "#16261f"
            fg = "#7ef7c4"
        else:
            # Classic 1970s tractor-feed greenbar paper striping
            bg = "#dff0d8" if (row_idx % 2 == 0) else "#f8fbf6"
            fg = "#122116"
        cell.set_property("cell-background", bg)
        cell.set_property("foreground", fg)

    def _sync_toggle_styles(self):
        def set_cls(btn: Gtk.Button, cls_name: str, on: bool):
            ctx = btn.get_style_context()
            if on:
                ctx.add_class(cls_name)
            else:
                ctx.remove_class(cls_name)

        set_cls(self.btn_radium, "sw-active", self.dark_radium)
        self.btn_radium.set_label("RADIUM" if self.compact_rack else ("RADIUM DIALS: ON" if self.dark_radium else "DARK RADIUM DIALS"))

        set_cls(self.btn_chart, "btn-amber", self.paper_mode)
        set_cls(self.btn_chart, "sw-active", not self.paper_mode)
        if self.compact_rack:
            self.btn_chart.set_label("PAPER" if self.paper_mode else "CRT")
        else:
            self.btn_chart.set_label("CHART: PAPER ROLL" if self.paper_mode else "CHART: CRT PHOSPHOR")

        set_cls(self.btn_sort_cpu, "sw-active", self.proc_sort == "cpu")
        set_cls(self.btn_sort_mem, "sw-active", self.proc_sort == "mem")
        set_cls(self.btn_sort_pid, "sw-active", self.proc_sort == "pid")

        self.btn_procs_toggle.set_label("PROCS ▼" if self.procs_visible else "PROCS ▲")
        set_cls(self.btn_procs_toggle, "sw-active", self.procs_visible)

        if self.compact_rack:
            self.lbl_plate.set_text("DTSYS")
            self.btn_compact.set_label("[FULL CONSOLE]")
            self.full_ctrl_box.hide()
            self.mode_stack.set_visible_child_name("rack")
        else:
            self.lbl_plate.set_text("DTSYS // CONTROL-ROOM TELEMETRY")
            self.btn_compact.set_label("[COMPACT RACK]")
            self.full_ctrl_box.show_all()
            self.mode_stack.set_visible_child_name("full")
            if self.procs_visible:
                self.proc_box.show_all()
            else:
                self.proc_box.hide()

    def _sync_iface_combo(self):
        if self.tel.available_ifaces == self._known_ifaces:
            return
        self._known_ifaces = list(self.tel.available_ifaces)
        self._updating_ui = True
        self.combo_iface.remove_all()
        self.combo_iface.append_text("AUTO")
        active_idx = 0
        for idx, nic in enumerate(self._known_ifaces, start=1):
            self.combo_iface.append_text(nic)
            if nic == self.tel.selected_iface:
                active_idx = idx
        self.combo_iface.set_active(active_idx)
        self._updating_ui = False

    # ---- Interactive Callbacks ----
    def _on_toggle_radium(self, _btn):
        self.dark_radium = not self.dark_radium
        self._sync_toggle_styles()
        self.proc_view.queue_draw()
        self._queue_redraw_all()

    def _on_toggle_chart(self, _btn):
