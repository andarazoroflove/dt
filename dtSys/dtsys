        self._sync_toggle_styles()

    def _on_toggle_compact(self, _btn):
        self.compact_rack = not self.compact_rack
        self._sync_toggle_styles()
        if self.compact_rack:
            self.resize(340, 600)
            self._set_status("Compact Telemetry Rack (340x600 — SGI gr_osview / SunOS perfmeter mode)")
        else:
            self.resize(1080, 650)
            self._set_status("Full Control-Room Telemetry Console (1080x650)")
        self._queue_redraw_all()

    def _on_iface_changed(self, combo):
        if self._updating_ui:
            return
        txt = combo.get_active_text()
        if txt:
            self.tel.selected_iface = txt
            self.tel.poll_telemetry(record_history=False)
            self._queue_redraw_all()

    def _on_rate_changed(self, combo):
        txt = combo.get_active_text() or "1.0s"
        if txt == "PAUSE":
            self.paused = True
        else:
            self.paused = False
            self.sample_rate_sec = float(txt.rstrip("s"))
        self.vfd_area.queue_draw()

    def _set_proc_sort(self, col_name: str):
        self.proc_sort = col_name
        self._sync_toggle_styles()
        self._refresh_process_table()

    def _refresh_process_table(self):
        # Preserve selected PID across refreshes
        sel_pid = None
        sel = self.proc_view.get_selection()
        if sel is not None:
            model, it = sel.get_selected()
            if it is not None:
                sel_pid = model.get_value(it, 0)

        rows = self.tel.scan_processes(sort_by=self.proc_sort, limit=65)
        self.proc_store.clear()
        restore_iter = None
        for r in rows:
            it = self.proc_store.append([
                r["pid"],
                r["user"],
                r["state"],
                f"{r['cpu']:5.1f}",
                f"{r['mem']:5.1f}",
                fmt_bytes_total(r["rss"]),
                r["cmd"],
                r["uid"],
            ])
            if sel_pid is not None and r["pid"] == sel_pid:
                restore_iter = it
        if restore_iter is not None and sel is not None:
            sel.select_iter(restore_iter)

    def _signal_selected_proc(self, sig: int, sig_name: str):
        sel = self.proc_view.get_selection()
        model, it = sel.get_selected()
        if it is None:
            self._set_status("Select a user-owned process in the Greenbar table first.")
            return
        pid = model.get_value(it, 0)
        uid = model.get_value(it, 7)
        cmd = model.get_value(it, 6)
        my_uid = os.getuid()
        if uid != my_uid and my_uid != 0:
            self._set_status(f"Denied: PID {pid} is not owned by UID {my_uid}.")
            return
        if pid == os.getpid():
            self._set_status("Refusing to terminate dtSys itself.")
            return
        try:
            os.kill(pid, sig)
            self._set_status(f"Sent {sig_name} to PID {pid} ({cmd[:42]})")
            GLib.timeout_add(250, lambda: (self._refresh_process_table(), False)[1])
        except Exception as exc:
            self._set_status(f"Failed {sig_name} on PID {pid}: {exc}")

    def _set_status(self, msg: str):
        self.status_lbl.set_text(msg)

    # ---- 18 fps Ballistic Needle Inertia & Scheduled Telemetry Loop ----
    def _on_frame_tick(self) -> bool:
        now = time.monotonic()
        if not self.paused and (now - self._last_sample_mono) >= self.sample_rate_sec:
            self._last_sample_mono = now
            self.tel.poll_telemetry(record_history=True)
            self._sync_iface_combo()
            if not self.compact_rack and self.procs_visible and (now - self._last_proc_mono) >= max(1.5, self.sample_rate_sec * 2.0):
                self._last_proc_mono = now
                self._refresh_process_table()

        targets = {
            "cpu": max(0.0, min(1.0, self.tel.cpu_total_pct / 100.0)),
            "mem": max(0.0, min(1.0, self.tel.mem_used_pct / 100.0)),
            "temp": max(0.0, min(1.0, (self.tel.temp_c - 20.0) / 85.0)),
            "bat": max(0.0, min(1.0, self.tel.bat_pct / 100.0)),
        }

        # Critically damped analog meter movement (stiffness + viscous coil damping)
        for k, tgt in targets.items():
            pos = self.needles[k]
            vel = self.needle_vel[k]
            acc = (tgt - pos) * 0.24 - vel * 0.56
            vel += acc
            pos = max(0.0, min(1.0, pos + vel))
            self.needles[k] = pos
            self.needle_vel[k] = vel

        self._queue_redraw_all()
        return True

    def _queue_redraw_all(self):
        if self.compact_rack:
            self.rack_area.queue_draw()
        else:
            self.dials_area.queue_draw()
            self.strips_area.queue_draw()
            self.vfd_area.queue_draw()

