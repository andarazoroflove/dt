WHOLE_DISK_RE = re.compile(r"^(sd[a-z]+|nvme\d+n\d+|mmcblk\d+|vd[a-z]+|hd[a-z]+|xvd[a-z]+)$")


def fmt_bytes_rate(bps: float) -> str:
    if bps >= 1024.0 * 1024.0:
        return f"{bps / (1024.0 * 1024.0):5.2f} MB/s"
    if bps >= 1024.0:
        return f"{bps / 1024.0:5.1f} KB/s"
    return f"{bps:5.0f} B/s"


def fmt_bytes_total(b: float) -> str:
    if b >= 1024.0 ** 3:
        return f"{b / (1024.0 ** 3):.2f}G"
    if b >= 1024.0 ** 2:
        return f"{b / (1024.0 ** 2):.1f}M"
    if b >= 1024.0:
        return f"{b / 1024.0:.0f}K"
    return f"{int(b)}B"


class TelemetryEngine:
    def __init__(self):
        self.clk_tck = os.sysconf("SC_CLK_TCK") if hasattr(os, "sysconf") else 100
        self.page_size = os.sysconf("SC_PAGE_SIZE") if hasattr(os, "sysconf") else 4096
        uname = os.uname()
        self.demo_mask = os.environ.get("DT_SCREENSHOT_DEMO") == "1"
        self.hostname = "cde-workstation" if self.demo_mask else uname.nodename
        self.kernel = uname.release
        self.arch = uname.machine
        self.uid_cache: dict[int, str] = {}

        # Previous counters for delta calculation
        self._prev_cpu: dict[str, tuple[int, ...]] = {}
        self._prev_net: dict[str, tuple[int, int]] = {}
        self._prev_net_ts = 0.0
        self._prev_disk: tuple[int, int] | None = None
        self._prev_disk_ts = 0.0
        self._prev_proc_ticks: dict[int, int] = {}
        self._prev_proc_ts = 0.0

        # Live instantaneous snapshot
        self.cpu_total_pct = 0.0
        self.cpu_usr_pct = 0.0
        self.cpu_sys_pct = 0.0
        self.cpu_iow_pct = 0.0
        self.core_pcts: list[float] = [0.0]
        self.core_splits: list[tuple[float, float, float]] = [(0.0, 0.0, 0.0)]  # usr, sys, iow
        self.core_peaks: list[float] = [0.0]
        self.cpu_mhz = 0.0
        self.cpu_model = "CPU"

        self.mem_total_gib = 1.0
        self.mem_used_gib = 0.0
        self.mem_bufcache_gib = 0.0
        self.mem_used_pct = 0.0
        self.mem_bufcache_pct = 0.0
        self.mem_dirty_mib = 0.0
        self.swap_total_gib = 0.0
        self.swap_used_gib = 0.0
        self.swap_pct = 0.0

        self.temp_c = 45.0
        self.temp_f = 113.0
        self.temp_zone_name = "thermal"
        self.cooling_cur = 0
        self.cooling_max = 0

        # Workstation Battery & AC Mains
        self.bat_present = False
        self.bat_name = "BAT1"
        self.bat_model = "AC-ONLY"
        self.bat_status = "Unknown"
        self.bat_pct = 100.0
        self.bat_volts = 0.0
        self.bat_watts = 0.0
        self.bat_now_wh = 0.0
        self.bat_full_wh = 0.0
        self.bat_design_wh = 0.0
        self.bat_health_pct = 100.0
        self.ac_online = True

        # Load, Uptime, Counts
        self.load_1m = 0.0
        self.load_5m = 0.0
        self.load_15m = 0.0
        self.procs_running = 1
        self.threads_total = 1
        self.procs_total = 1
        self.uptime_sec = 0.0

        # Network
        self.selected_iface = "AUTO"
        self.active_iface = "lo"
        self.available_ifaces: list[str] = ["lo"]
        self.net_rx_bps = 0.0
        self.net_tx_bps = 0.0
        self.net_rx_total = 0
        self.net_tx_total = 0

        # Disk I/O & Filesystems
        self.disk_read_bps = 0.0
        self.disk_write_bps = 0.0
        self.disk_label = "sda"
        self.fs_root = (0.0, 1.0, 0.0)  # used_gib, total_gib, pct
        self.fs_home = (0.0, 1.0, 0.0)

        # Rolling 120-sample histories
        self.hist_cpu = collections.deque([0.0] * HISTORY_LEN, maxlen=HISTORY_LEN)
        self.hist_load = collections.deque([0.0] * HISTORY_LEN, maxlen=HISTORY_LEN)
        self.hist_net_rx = collections.deque([0.0] * HISTORY_LEN, maxlen=HISTORY_LEN)
        self.hist_net_tx = collections.deque([0.0] * HISTORY_LEN, maxlen=HISTORY_LEN)
        self.hist_disk_r = collections.deque([0.0] * HISTORY_LEN, maxlen=HISTORY_LEN)
        self.hist_disk_w = collections.deque([0.0] * HISTORY_LEN, maxlen=HISTORY_LEN)
        self.sample_seq = 0

        # Prime baseline counters
        self._read_cpu_model()
        self.poll_telemetry(record_history=False)

    def _read_cpu_model(self):
        try:
            for ln in Path("/proc/cpuinfo").read_text(errors="ignore").splitlines():
                if ln.startswith("model name"):
                    self.cpu_model = ln.split(":", 1)[1].strip()
                    break
        except Exception:
            pass

    def poll_telemetry(self, record_history: bool = True):
        now = time.monotonic()
        self._poll_cpu()
        self._poll_cpu_freq()
        self._poll_meminfo()
        self._poll_thermal()
        self._poll_power()
        self._poll_load_and_uptime()
        self._poll_network(now)
        self._poll_disk(now)
        self._poll_filesystems()

        if record_history:
            self.hist_cpu.append(self.cpu_total_pct)
            ncores = max(1, len(self.core_pcts))
            load_norm = min(100.0, (self.load_1m / ncores) * 100.0)
            self.hist_load.append(load_norm)
            self.hist_net_rx.append(self.net_rx_bps)
            self.hist_net_tx.append(self.net_tx_bps)
            self.hist_disk_r.append(self.disk_read_bps)
            self.hist_disk_w.append(self.disk_write_bps)
            self.sample_seq += 1

    def _poll_cpu(self):
        try:
            lines = Path("/proc/stat").read_text(errors="ignore").splitlines()
        except Exception:
            return
        cores_pct: list[float] = []
        cores_split: list[tuple[float, float, float]] = []
        for ln in lines:
            if not ln.startswith("cpu"):
                continue
            parts = ln.split()
            tag = parts[0]
            vals = tuple(int(x) for x in parts[1:9])
            prev = self._prev_cpu.get(tag)
            self._prev_cpu[tag] = vals
            if prev is None:
                if tag != "cpu":
                    cores_pct.append(0.0)
                    cores_split.append((0.0, 0.0, 0.0))
                continue
            deltas = [max(0, b - a) for a, b in zip(prev, vals)]
            tot = sum(deltas)
            if tot <= 0:
                usr_p = sys_p = iow_p = busy_p = 0.0
            else:
                usr_d = deltas[0] + deltas[1]
                sys_d = deltas[2] + (deltas[5] if len(deltas) > 5 else 0) + (deltas[6] if len(deltas) > 6 else 0)
                idle_d = deltas[3]
                iow_d = deltas[4] if len(deltas) > 4 else 0
                busy_p = max(0.0, min(100.0, 100.0 * (tot - idle_d) / tot))
                usr_p = max(0.0, min(100.0, 100.0 * usr_d / tot))
                sys_p = max(0.0, min(100.0, 100.0 * sys_d / tot))
                iow_p = max(0.0, min(100.0, 100.0 * iow_d / tot))
            if tag == "cpu":
                self.cpu_total_pct = busy_p
                self.cpu_usr_pct = usr_p
                self.cpu_sys_pct = sys_p
                self.cpu_iow_pct = iow_p
            else:
                cores_pct.append(busy_p)
                cores_split.append((usr_p, sys_p, iow_p))
        if cores_pct:
            self.core_pcts = cores_pct
            self.core_splits = cores_split
            if len(self.core_peaks) != len(cores_pct):
                self.core_peaks = list(cores_pct)
            else:
                self.core_peaks = [
                    max(c, p * 0.92) for c, p in zip(cores_pct, self.core_peaks)
                ]

    def _poll_cpu_freq(self):
        freqs: list[float] = []
        try:
            for p in sorted(Path("/sys/devices/system/cpu").glob("cpu[0-9]*/cpufreq/scaling_cur_freq")):
                v = int(p.read_text().strip())
                if v > 0:
                    freqs.append(v / 1000.0)
        except Exception:
            pass
        if not freqs:
            try:
                for ln in Path("/proc/cpuinfo").read_text(errors="ignore").splitlines():
                    if "cpu MHz" in ln:
                        freqs.append(float(ln.split(":", 1)[1].strip()))
            except Exception:
                pass
        if freqs:
            self.cpu_mhz = sum(freqs) / len(freqs)

    def _poll_meminfo(self):
        info: dict[str, int] = {}
        try:
            for ln in Path("/proc/meminfo").read_text(errors="ignore").splitlines():
                if ":" in ln:
                    k, rest = ln.split(":", 1)
                    num = rest.strip().split()[0]
                    if num.isdigit():
                        info[k] = int(num)
        except Exception:
            return
        mt = max(1, info.get("MemTotal", 1))
        ma = info.get("MemAvailable", info.get("MemFree", 0))
        buf = info.get("Buffers", 0)
        cached = info.get("Cached", 0) + info.get("SReclaimable", 0)
        used = max(0, mt - ma)

        self.mem_total_gib = mt / (1024.0 * 1024.0)
        self.mem_used_gib = used / (1024.0 * 1024.0)
        self.mem_bufcache_gib = (buf + cached) / (1024.0 * 1024.0)
        self.mem_used_pct = max(0.0, min(100.0, 100.0 * used / mt))
        self.mem_bufcache_pct = max(0.0, min(100.0, 100.0 * (buf + cached) / mt))
        self.mem_dirty_mib = info.get("Dirty", 0) / 1024.0

        st = info.get("SwapTotal", 0)
        sf = info.get("SwapFree", 0)
        su = max(0, st - sf)
        self.swap_total_gib = st / (1024.0 * 1024.0)
        self.swap_used_gib = su / (1024.0 * 1024.0)
        self.swap_pct = (100.0 * su / st) if st > 0 else 0.0

    def _poll_thermal(self):
        best_pkg: tuple[float, str] | None = None
        best_any: tuple[float, str] | None = None
        tbase = Path("/sys/class/thermal")
        if tbase.is_dir():
            for zd in sorted(tbase.glob("thermal_zone*")):
                try:
                    ztype = (zd / "type").read_text().strip()
                    raw = int((zd / "temp").read_text().strip())
                    tc = raw / 1000.0 if abs(raw) >= 1000 else float(raw)
                    if tc <= 0.5 or tc > 135.0:
                        continue
                    if ztype == "x86_pkg_temp":
                        best_pkg = (tc, ztype)
                    if best_any is None or tc > best_any[0]:
                        best_any = (tc, ztype)
                except Exception:
                    continue
            cur_sum = 0
            max_sum = 0
            for cd in sorted(tbase.glob("cooling_device*")):
                try:
                    cs = int((cd / "cur_state").read_text().strip())
                    ms = int((cd / "max_state").read_text().strip())
                    if cs >= 0 and ms > 0:
                        cur_sum = max(cur_sum, cs)
                        max_sum = max(max_sum, ms)
                except Exception:
                    continue
            self.cooling_cur = cur_sum
            self.cooling_max = max_sum

        chosen = best_pkg or best_any
        if chosen is not None:
            self.temp_c, self.temp_zone_name = chosen
            self.temp_f = self.temp_c * 9.0 / 5.0 + 32.0

    def _poll_power(self):
        pbase = Path("/sys/class/power_supply")
        if not pbase.is_dir():
            return
        ac_found = False
        ac_on = False
        bat_dirs: list[Path] = []
        periph_bats: list[Path] = []

        for d in sorted(pbase.iterdir()):
            try:
                ptype = (d / "type").read_text().strip()
            except Exception:
                ptype = ""
            name = d.name
            if ptype == "Mains" or name.upper().startswith(("AC", "ADP", "ACAD")):
                try:
                    on = int((d / "online").read_text().strip())
                    ac_found = True
                    if on == 1:
                        ac_on = True
                except Exception:
                    pass
            elif ptype == "Battery" or name.upper().startswith("BAT"):
                if "hidpp" in name.lower() or "mouse" in name.lower() or "keyboard" in name.lower():
                    periph_bats.append(d)
                else:
                    bat_dirs.append(d)

        if ac_found:
            self.ac_online = ac_on

        # Prioritize BAT0/BAT1 system battery packs over HID peripherals
        target_bat: Path | None = None
        for b in bat_dirs:
            if b.name == "BAT1":
                target_bat = b
                break
        if target_bat is None and bat_dirs:
            target_bat = bat_dirs[0]
        if target_bat is None and periph_bats:
            target_bat = periph_bats[0]

        if target_bat is None:
            self.bat_present = False
            return

        kv: dict[str, str] = {}
        try:
            for ln in (target_bat / "uevent").read_text(errors="ignore").splitlines():
                if "=" in ln:
                    k, v = ln.split("=", 1)
                    kv[k.strip()] = v.strip()
        except Exception:
            pass

        self.bat_present = kv.get("POWER_SUPPLY_PRESENT", "1") != "0"
        self.bat_name = kv.get("POWER_SUPPLY_NAME", target_bat.name)
        raw_model = kv.get("POWER_SUPPLY_MODEL_NAME", self.bat_name) or self.bat_name
        self.bat_model = "LI-ION-PACK" if self.demo_mask else raw_model
        self.bat_status = kv.get("POWER_SUPPLY_STATUS", "Unknown")

        try:
            self.bat_pct = max(0.0, min(100.0, float(kv.get("POWER_SUPPLY_CAPACITY", "0"))))
        except Exception:
            pass

        v_now = float(kv.get("POWER_SUPPLY_VOLTAGE_NOW", "0") or 0) / 1e6
        self.bat_volts = v_now

        if "POWER_SUPPLY_POWER_NOW" in kv:
            p_uw = float(kv.get("POWER_SUPPLY_POWER_NOW", "0") or 0)
            self.bat_watts = p_uw / 1e6
        elif "POWER_SUPPLY_CURRENT_NOW" in kv:
            i_ua = float(kv.get("POWER_SUPPLY_CURRENT_NOW", "0") or 0)
            self.bat_watts = (i_ua / 1e6) * (v_now if v_now > 0 else 11.1)

        if "POWER_SUPPLY_ENERGY_FULL" in kv:
            ef = float(kv.get("POWER_SUPPLY_ENERGY_FULL", "0") or 0) / 1e6
            ed = float(kv.get("POWER_SUPPLY_ENERGY_FULL_DESIGN", "0") or 0) / 1e6
            en = float(kv.get("POWER_SUPPLY_ENERGY_NOW", "0") or 0) / 1e6
        else:
            v_nom = v_now if v_now > 1.0 else float(kv.get("POWER_SUPPLY_VOLTAGE_MIN_DESIGN", "11100000") or 11100000) / 1e6
            ef = (float(kv.get("POWER_SUPPLY_CHARGE_FULL", "0") or 0) / 1e6) * v_nom
            ed = (float(kv.get("POWER_SUPPLY_CHARGE_FULL_DESIGN", "0") or 0) / 1e6) * v_nom
            en = (float(kv.get("POWER_SUPPLY_CHARGE_NOW", "0") or 0) / 1e6) * v_nom

        self.bat_now_wh = en
        self.bat_full_wh = ef
        self.bat_design_wh = ed
        if ed > 0.1 and ef > 0.1:
            self.bat_health_pct = max(0.0, min(100.0, 100.0 * ef / ed))
        elif en > 0 and ef > 0 and self.bat_pct == 0:
            self.bat_pct = max(0.0, min(100.0, 100.0 * en / ef))

    def _poll_load_and_uptime(self):
        try:
            parts = Path("/proc/loadavg").read_text().split()
            self.load_1m = float(parts[0])
            self.load_5m = float(parts[1])
            self.load_15m = float(parts[2])
            if "/" in parts[3]:
                r_s, t_s = parts[3].split("/", 1)
                self.procs_running = int(r_s)
                self.threads_total = int(t_s)
        except Exception:
            pass
        try:
            self.uptime_sec = float(Path("/proc/uptime").read_text().split()[0])
        except Exception:
            pass
        try:
            self.procs_total = sum(1 for d in os.listdir("/proc") if d.isdigit())
        except Exception:
            pass

    def _poll_network(self, now: float):
        ifaces: dict[str, tuple[int, int]] = {}
        try:
            for ln in Path("/proc/net/dev").read_text(errors="ignore").splitlines()[2:]:
                if ":" not in ln:
                    continue
                name, rest = ln.split(":", 1)
                name = name.strip()
                cols = rest.split()
                if len(cols) >= 9:
                    ifaces[name] = (int(cols[0]), int(cols[8]))
        except Exception:
            return

        if not ifaces:
            return
        self.available_ifaces = sorted(ifaces.keys(), key=lambda x: (x == "lo", x))

        dt = now - self._prev_net_ts if self._prev_net_ts > 0 else 0.0
        deltas: dict[str, tuple[float, float]] = {}
        for name, (rx, tx) in ifaces.items():
            prev = self._prev_net.get(name)
            if prev is not None and dt > 0.02:
                deltas[name] = (max(0.0, (rx - prev[0]) / dt), max(0.0, (tx - prev[1]) / dt))
            else:
                deltas[name] = (0.0, 0.0)
            self._prev_net[name] = (rx, tx)
        self._prev_net_ts = now

        if self.selected_iface != "AUTO" and self.selected_iface in ifaces:
            chosen = self.selected_iface
        else:
            non_lo = [n for n in self.available_ifaces if n != "lo"]
            if non_lo:
                # Pick interface with active live rate, or highest cumulative traffic
                chosen = max(
                    non_lo,
                    key=lambda n: (deltas[n][0] + deltas[n][1] > 1.0, ifaces[n][0] + ifaces[n][1]),
                )
            else:
                chosen = "lo" if "lo" in ifaces else self.available_ifaces[0]

        self.active_iface = chosen
        self.net_rx_bps, self.net_tx_bps = deltas.get(chosen, (0.0, 0.0))
        self.net_rx_total, self.net_tx_total = ifaces.get(chosen, (0, 0))

    def _poll_disk(self, now: float):
        r_bytes = 0
        w_bytes = 0
        names: list[str] = []
        try:
            for ln in Path("/proc/diskstats").read_text(errors="ignore").splitlines():
                cols = ln.split()
                if len(cols) < 10:
                    continue
                dev = cols[2]
                if WHOLE_DISK_RE.match(dev):
                    names.append(dev)
                    r_bytes += int(cols[5]) * 512
                    w_bytes += int(cols[9]) * 512
        except Exception:
            return
        if names:
            self.disk_label = "+".join(names[:2])
        dt = now - self._prev_disk_ts if self._prev_disk_ts > 0 else 0.0
        if self._prev_disk is not None and dt > 0.02:
            self.disk_read_bps = max(0.0, (r_bytes - self._prev_disk[0]) / dt)
            self.disk_write_bps = max(0.0, (w_bytes - self._prev_disk[1]) / dt)
        self._prev_disk = (r_bytes, w_bytes)
        self._prev_disk_ts = now

    def _poll_filesystems(self):
        for attr, path in (("fs_root", "/"), ("fs_home", str(HOME))):
            try:
                st = os.statvfs(path)
                tot = st.f_blocks * st.f_frsize
                avail = st.f_bavail * st.f_frsize
                used = max(0, tot - (st.f_bfree * st.f_frsize))
                if tot > 0:
                    pct = max(0.0, min(100.0, 100.0 * (tot - avail) / tot))
                    setattr(self, attr, (used / (1024.0 ** 3), tot / (1024.0 ** 3), pct))
            except Exception:
                pass

    def _uid_name(self, uid: int) -> str:
        if self.demo_mask:
            return "root" if uid == 0 else "operator"
        if uid not in self.uid_cache:
            try:
                self.uid_cache[uid] = pwd.getpwuid(uid).pw_name
            except Exception:
                self.uid_cache[uid] = str(uid)
        return self.uid_cache[uid]

    def scan_processes(self, sort_by: str = "cpu", limit: int = 65) -> list[dict]:
        now = time.monotonic()
        dt = now - self._prev_proc_ts if self._prev_proc_ts > 0 else 1.0
        dt = max(0.05, dt)
        new_ticks: dict[int, int] = {}
        mem_tot_bytes = max(1.0, self.mem_total_gib * (1024.0 ** 3))
        rows: list[dict] = []

        try:
            pids = [int(d) for d in os.listdir("/proc") if d.isdigit()]
        except Exception:
            pids = []

        for pid in pids:
            pdir = f"/proc/{pid}"
            try:
                st_os = os.stat(pdir)
                uid = st_os.st_uid
                stat_raw = Path(f"{pdir}/stat").read_text(errors="ignore")
                rparen = stat_raw.rfind(")")
                if rparen < 0:
                    continue
                lparen = stat_raw.find("(")
                comm = stat_raw[lparen + 1 : rparen]
                after = stat_raw[rparen + 2 :].split()
                state = after[0]
                utime = int(after[11])
                stime = int(after[12])
                rss_pages = int(after[21])
                tot_tck = utime + stime
                new_ticks[pid] = tot_tck

                prev_tck = self._prev_proc_ticks.get(pid)
                if prev_tck is not None:
                    cpu_pct = max(0.0, 100.0 * (tot_tck - prev_tck) / (self.clk_tck * dt))
                else:
                    cpu_pct = 0.0

                rss_bytes = max(0, rss_pages * self.page_size)
                mem_pct = 100.0 * rss_bytes / mem_tot_bytes

                cmd_raw = Path(f"{pdir}/cmdline").read_bytes()
                if cmd_raw:
                    cmd = " ".join(cmd_raw.replace(b"\x00", b" ").decode("utf-8", errors="replace").split())
                else:
                    cmd = f"[{comm}]"

                rows.append({
                    "pid": pid,
                    "uid": uid,
                    "user": self._uid_name(uid),
                    "state": state,
                    "cpu": cpu_pct,
                    "mem": mem_pct,
                    "rss": rss_bytes,
                    "cmd": (re.sub(r"/home/[^/\s]+", "/home/operator", cmd) if self.demo_mask else cmd)[:110],
                })
            except Exception:
                continue

        self._prev_proc_ticks = new_ticks
        self._prev_proc_ts = now

        if sort_by == "mem":
            rows.sort(key=lambda r: (r["mem"], r["cpu"]), reverse=True)
        elif sort_by == "pid":
            rows.sort(key=lambda r: r["pid"])
        else:
            rows.sort(key=lambda r: (r["cpu"], r["mem"]), reverse=True)
        return rows[:limit]


