# Cairo Vintage Analog Dial, Strip-Chart & VFD Renderer
# ---------------------------------------------------------------------------
class VintageRenderer:
    """Shared Cairo drawing primitives for Full Console, Compact Rack & Self-Test."""

    @staticmethod
    def draw_screw(cr: cairo.Context, cx: float, cy: float, r: float, angle: float, brass: bool = False):
        # Recessed hole shadow
        cr.new_sub_path()
        cr.arc(cx + 0.6, cy + 0.7, r + 0.8, 0, 2 * math.pi)
        cr.set_source_rgba(0.04, 0.05, 0.06, 0.75)
        cr.fill()
        # Screw head gradient
        pat = cairo.LinearGradient(cx - r, cy - r, cx + r, cy + r)
        if brass:
            pat.add_color_stop_rgb(0.0, 0.86, 0.72, 0.42)
            pat.add_color_stop_rgb(1.0, 0.42, 0.32, 0.14)
        else:
            pat.add_color_stop_rgb(0.0, 0.76, 0.80, 0.86)
            pat.add_color_stop_rgb(1.0, 0.30, 0.33, 0.39)
        cr.new_sub_path()
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.set_source(pat)
        cr.fill()
        # Flathead slot
        cr.set_line_width(max(1.1, r * 0.42))
        cr.set_source_rgb(0.14, 0.15, 0.18)
        cr.move_to(cx - (r * 0.72) * math.cos(angle), cy - (r * 0.72) * math.sin(angle))
        cr.line_to(cx + (r * 0.72) * math.cos(angle), cy + (r * 0.72) * math.sin(angle))
        cr.stroke()

    @staticmethod
    def draw_jewel_lamp(
        cr: cairo.Context,
        cx: float,
        cy: float,
        r: float,
        rgb: tuple[float, float, float],
        lit: bool,
        label: str = "",
        dark_face: bool = False,
    ):
        # Chrome bezel ring
        cr.new_sub_path()
        cr.arc(cx, cy, r + 1.8, 0, 2 * math.pi)
        cr.set_source_rgb(0.22, 0.24, 0.28)
        cr.fill()
        cr.new_sub_path()
        cr.arc(cx, cy, r + 0.9, 0, 2 * math.pi)
        cr.set_source_rgb(0.66, 0.70, 0.76)
        cr.fill()

        if lit:
            # Outer halo glow
            glow = cairo.RadialGradient(cx, cy, r * 0.2, cx, cy, r * 2.4)
            glow.add_color_stop_rgba(0.0, rgb[0], rgb[1], rgb[2], 0.50)
            glow.add_color_stop_rgba(1.0, rgb[0], rgb[1], rgb[2], 0.0)
            cr.arc(cx, cy, r * 2.4, 0, 2 * math.pi)
            cr.set_source(glow)
            cr.fill()

            gem = cairo.RadialGradient(cx - r * 0.3, cy - r * 0.3, r * 0.1, cx, cy, r)
            gem.add_color_stop_rgb(0.0, min(1.0, rgb[0] + 0.35), min(1.0, rgb[1] + 0.35), min(1.0, rgb[2] + 0.35))
            gem.add_color_stop_rgb(0.7, rgb[0], rgb[1], rgb[2])
            gem.add_color_stop_rgb(1.0, rgb[0] * 0.45, rgb[1] * 0.45, rgb[2] * 0.45)
            cr.arc(cx, cy, r, 0, 2 * math.pi)
            cr.set_source(gem)
            cr.fill()
            # Specular glint
            cr.arc(cx - r * 0.32, cy - r * 0.32, r * 0.28, 0, 2 * math.pi)
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.75)
            cr.fill()
        else:
            cr.arc(cx, cy, r, 0, 2 * math.pi)
            cr.set_source_rgb(rgb[0] * 0.22, rgb[1] * 0.22, rgb[2] * 0.22)
            cr.fill()
            cr.arc(cx - r * 0.3, cy - r * 0.3, r * 0.22, 0, 2 * math.pi)
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.22)
            cr.fill()

        if label:
            cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(7.6)
            if dark_face:
                cr.set_source_rgb(0.72, 0.90, 0.76) if lit else cr.set_source_rgb(0.45, 0.56, 0.48)
            else:
                cr.set_source_rgb(0.16, 0.13, 0.09) if lit else cr.set_source_rgb(0.36, 0.31, 0.24)
            cr.move_to(cx + r + 3.5, cy + 2.8)
            cr.show_text(label)

    @staticmethod
    def draw_vfd_inset(
        cr: cairo.Context,
        x: float,
        y: float,
        w: float,
        h: float,
        line1: str,
        line2: str = "",
        amber: bool = False,
    ):
        # Recessed dark VFD vacuum glass window
        cr.rectangle(x, y, w, h)
        cr.set_source_rgb(0.04, 0.08, 0.08) if not amber else cr.set_source_rgb(0.09, 0.06, 0.03)
        cr.fill()

        # Inner 3D shadow bevel
        cr.set_line_width(1.3)
        cr.set_source_rgb(0.01, 0.02, 0.02)
        cr.move_to(x, y + h)
        cr.line_to(x, y)
        cr.line_to(x + w, y)
        cr.stroke()
        cr.set_source_rgb(0.36, 0.40, 0.46)
        cr.move_to(x, y + h)
        cr.line_to(x + w, y + h)
        cr.line_to(x + w, y)
        cr.stroke()

        c_main = (1.00, 0.74, 0.24) if amber else (0.28, 0.98, 0.85)
        c_sub = (0.86, 0.60, 0.20) if amber else (0.48, 0.88, 0.80)

        cr.save()
        cr.rectangle(x + 2, y + 1, w - 4, h - 2)
        cr.clip()
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)

        if line2:
            cr.set_font_size(10.0)
            ext1 = cr.text_extents(line1)
            tx1 = x + max(4.0, (w - ext1.width) * 0.5)
            # Subtle phosphor glow
            cr.set_source_rgba(c_main[0], c_main[1], c_main[2], 0.22)
            cr.move_to(tx1 + 0.8, y + 12.8)
            cr.show_text(line1)
            cr.set_source_rgb(*c_main)
            cr.move_to(tx1, y + 12.0)
            cr.show_text(line1)

            cr.set_font_size(8.2)
            ext2 = cr.text_extents(line2)
            tx2 = x + max(4.0, (w - ext2.width) * 0.5)
            cr.set_source_rgb(*c_sub)
            cr.move_to(tx2, y + h - 4.2)
            cr.show_text(line2)
        else:
            cr.set_font_size(10.8)
            ext1 = cr.text_extents(line1)
            tx1 = x + max(4.0, (w - ext1.width) * 0.5)
            cr.set_source_rgb(*c_main)
            cr.move_to(tx1, y + h * 0.5 + 3.8)
            cr.show_text(line1)
        cr.restore()

    @classmethod
    def draw_analog_gauge_box(
        cls,
        cr: cairo.Context,
        x: float,
        y: float,
        w: float,
        h: float,
        title: str,
        unit_lbl: str,
        norm_val: float,
        marks: list[tuple[float, str, bool]],
        red_span: tuple[float, float] | None,
        dark_radium: bool,
        vfd_l1: str,
        vfd_l2: str,
        lamps: list[tuple[str, tuple[float, float, float], bool]],
        secondary_norm: float | None = None,
        core_bars: list[float] | None = None,
        badge_tag: str = "",
        screw_seed: int = 0,
    ):
        # 1. Brushed Steel / Brass Outer Meter Bezel
        bezel_pat = cairo.LinearGradient(x, y, x, y + h)
        if dark_radium:
            bezel_pat.add_color_stop_rgb(0.0, 0.30, 0.33, 0.39)
            bezel_pat.add_color_stop_rgb(0.5, 0.20, 0.23, 0.28)
            bezel_pat.add_color_stop_rgb(1.0, 0.13, 0.15, 0.19)
        else:
            # Warm aged brass-steel bezel
            bezel_pat.add_color_stop_rgb(0.0, 0.52, 0.47, 0.36)
            bezel_pat.add_color_stop_rgb(0.5, 0.36, 0.33, 0.26)
            bezel_pat.add_color_stop_rgb(1.0, 0.22, 0.20, 0.16)
        cr.rectangle(x, y, w, h)
        cr.set_source(bezel_pat)
        cr.fill()

        # Outer 3D Motif bevel
        cr.set_line_width(1.6)
        cr.set_source_rgb(0.68, 0.65, 0.55) if not dark_radium else cr.set_source_rgb(0.50, 0.55, 0.64)
        cr.move_to(x + 0.8, y + h - 0.8)
        cr.line_to(x + 0.8, y + 0.8)
        cr.line_to(x + w - 0.8, y + 0.8)
        cr.stroke()
        cr.set_source_rgb(0.09, 0.10, 0.12)
        cr.move_to(x + 0.8, y + h - 0.8)
        cr.line_to(x + w - 0.8, y + h - 0.8)
        cr.line_to(x + w - 0.8, y + 0.8)
        cr.stroke()

        # 4 Corner Flathead Mounting Screws
        angles = (0.45 + screw_seed * 0.3, -0.65 + screw_seed * 0.2, 1.10 - screw_seed * 0.25, -0.20 + screw_seed * 0.4)
        sr = 3.6
        for (sx, sy), ang in zip(
            [(x + 7.5, y + 7.5), (x + w - 7.5, y + 7.5), (x + 7.5, y + h - 7.5), (x + w - 7.5, y + h - 7.5)],
            angles,
        ):
            cls.draw_screw(cr, sx, sy, sr, ang, brass=not dark_radium)

        # Engraved Bezel Top Nameplate
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.6)
        ext_t = cr.text_extents(title)
        cr.set_source_rgb(0.95, 0.91, 0.78) if not dark_radium else cr.set_source_rgb(0.76, 0.96, 0.84)
        cr.move_to(x + (w - ext_t.width) * 0.5, y + 11.5)
        cr.show_text(title)

        # 2. Inner Backlit Dial Window
        mx = x + 9.0
        my = y + 16.0
        mw = w - 18.0
        mh = h - 25.0

        if dark_radium:
            # Radium night face: deep matte gunmetal with soft green tritium center glow
            fpat = cairo.RadialGradient(mx + mw * 0.5, my + mh * 0.45, 6.0, mx + mw * 0.5, my + mh * 0.5, mw * 0.72)
            fpat.add_color_stop_rgb(0.0, 0.08, 0.15, 0.12)
            fpat.add_color_stop_rgb(0.65, 0.05, 0.08, 0.08)
            fpat.add_color_stop_rgb(1.0, 0.03, 0.04, 0.05)
        else:
            # Warm edge-lit incandescent cream/amber dial face
            fpat = cairo.RadialGradient(mx + mw * 0.5, my + 6.0, 8.0, mx + mw * 0.5, my + mh * 0.55, mw * 0.78)
            fpat.add_color_stop_rgb(0.0, 1.00, 0.96, 0.82)
            fpat.add_color_stop_rgb(0.55, 0.98, 0.90, 0.68)
            fpat.add_color_stop_rgb(1.0, 0.87, 0.75, 0.50)

        cr.rectangle(mx, my, mw, mh)
        cr.set_source(fpat)
        cr.fill()

        # Recessed shadow inside meter glass
        cr.set_line_width(1.5)
        cr.set_source_rgba(0.05, 0.04, 0.02, 0.65)
        cr.move_to(mx, my + mh)
        cr.line_to(mx, my)
        cr.line_to(mx + mw, my)
        cr.stroke()

        # 3. Jewel Pilot Lamps along upper corners of dial face
        if len(lamps) == 1:
            lbl, col, lit = lamps[0]
            cls.draw_jewel_lamp(cr, mx + mw - 36.0, my + 11.0, 3.8, col, lit, lbl, dark_face=dark_radium)
        elif len(lamps) >= 2:
            spacing = (mw - 18.0) / len(lamps)
            for idx, (lbl, col, lit) in enumerate(lamps):
                lx = mx + 12.0 + idx * spacing
                cls.draw_jewel_lamp(cr, lx, my + 10.5, 3.5, col, lit, lbl, dark_face=dark_radium)

        if badge_tag:
            cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(7.8)
            cr.set_source_rgb(0.35, 0.88, 0.68) if dark_radium else cr.set_source_rgb(0.34, 0.25, 0.14)
            cr.move_to(mx + 7.0, my + 13.0)
            cr.show_text(badge_tag)

        # 4. Etched Radial Dial Scale & Redline Danger Arc
        vfd_h = 28.0
        vfd_y = my + mh - vfd_h - 4.0
        piv_x = mx + mw * 0.5
        piv_y = vfd_y + 7.0
        arc_r = min(mw * 0.43, max(38.0, piv_y - (my + 26.0)))
        a0 = -math.pi * 0.80
        a1 = -math.pi * 0.20

        # Secondary arc (e.g. Buffers + Cache on Memory gauge)
        if secondary_norm is not None and secondary_norm > 0.01:
            s_end = a0 + max(0.0, min(1.0, secondary_norm)) * (a1 - a0)
            cr.new_sub_path()
            cr.set_line_width(4.2)
            cr.set_source_rgba(0.95, 0.68, 0.16, 0.55) if dark_radium else cr.set_source_rgba(0.84, 0.48, 0.08, 0.45)
            cr.arc(piv_x, piv_y, arc_r - 5.5, a0, s_end)
            cr.stroke()

        # Redline danger zone arc
        if red_span is not None:
            ra0 = a0 + red_span[0] * (a1 - a0)
            ra1 = a0 + red_span[1] * (a1 - a0)
            cr.new_sub_path()
            cr.set_line_width(4.0)
            cr.set_source_rgb(0.95, 0.25, 0.22) if dark_radium else cr.set_source_rgb(0.80, 0.14, 0.12)
            cr.arc(piv_x, piv_y, arc_r + 1.8, ra0, ra1)
            cr.stroke()

        # Main scale baseline arc
        cr.new_sub_path()
        cr.set_line_width(1.4)
        cr.set_source_rgb(0.32, 0.92, 0.58) if dark_radium else cr.set_source_rgb(0.18, 0.14, 0.09)
        cr.arc(piv_x, piv_y, arc_r, a0, a1)
        cr.stroke()

        # Minor 25 subdivisions
        cr.set_line_width(0.9)
        cr.set_source_rgba(0.32, 0.85, 0.55, 0.72) if dark_radium else cr.set_source_rgba(0.24, 0.19, 0.12, 0.75)
        for i in range(21):
            ang = a0 + (i / 20.0) * (a1 - a0)
            cr.move_to(piv_x + (arc_r - 2.8) * math.cos(ang), piv_y + (arc_r - 2.8) * math.sin(ang))
            cr.line_to(piv_x + (arc_r + 2.5) * math.cos(ang), piv_y + (arc_r + 2.5) * math.sin(ang))
            cr.stroke()

        # Major ticks & numerals
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.2)
        for frac, lbl, is_red in marks:
            ang = a0 + frac * (a1 - a0)
            if is_red:
                cr.set_source_rgb(1.00, 0.34, 0.30) if dark_radium else cr.set_source_rgb(0.78, 0.12, 0.10)
            else:
                cr.set_source_rgb(0.46, 0.98, 0.68) if dark_radium else cr.set_source_rgb(0.14, 0.11, 0.08)
            cr.set_line_width(1.6)
            cr.move_to(piv_x + (arc_r - 4.8) * math.cos(ang), piv_y + (arc_r - 4.8) * math.sin(ang))
            cr.line_to(piv_x + (arc_r + 5.0) * math.cos(ang), piv_y + (arc_r + 5.0) * math.sin(ang))
            cr.stroke()

            tx = piv_x + (arc_r + 12.8) * math.cos(ang)
            ty = piv_y + (arc_r + 12.8) * math.sin(ang)
            ext = cr.text_extents(lbl)
            cr.move_to(tx - ext.width * 0.5, ty + ext.height * 0.38)
            cr.show_text(lbl)

        # Center unit legend under scale arc
        cr.set_font_size(8.0)
        cr.set_source_rgba(0.45, 0.90, 0.65, 0.85) if dark_radium else cr.set_source_rgba(0.28, 0.22, 0.14, 0.85)
        u_ext = cr.text_extents(unit_lbl)
        cr.move_to(piv_x - u_ext.width * 0.5, piv_y - arc_r * 0.46)
        cr.show_text(unit_lbl)

        # Optional per-core mini bars (for CPU dial)
        if core_bars:
            nb = min(16, len(core_bars))
            tot_bw = min(mw * 0.56, nb * 11.0)
            bx0 = piv_x - tot_bw * 0.5
            by0 = piv_y - arc_r * 0.34
            bh = 10.0
            cell_w = tot_bw / max(1, nb)
            for ci in range(nb):
                cp = max(0.0, min(100.0, core_bars[ci])) / 100.0
                cx0 = bx0 + ci * cell_w + 1.0
                cw0 = max(2.5, cell_w - 2.0)
                cr.rectangle(cx0, by0, cw0, bh)
                cr.set_source_rgba(0.06, 0.10, 0.09, 0.55) if dark_radium else cr.set_source_rgba(0.25, 0.20, 0.12, 0.22)
                cr.fill()
                fh = bh * cp
                cr.rectangle(cx0, by0 + bh - fh, cw0, fh)
                if cp > 0.82:
                    cr.set_source_rgb(0.92, 0.22, 0.18)
                elif dark_radium:
                    cr.set_source_rgb(0.28, 0.96, 0.68)
                else:
                    cr.set_source_rgb(0.18, 0.52, 0.34)
                cr.fill()

        # 5. Ballistic Analog Needle (clipped to dial face above VFD)
        cr.save()
        cr.rectangle(mx + 1, my + 1, mw - 2, mh - 2)
        cr.clip()
        n_ang = a0 + max(0.0, min(1.0, norm_val)) * (a1 - a0)
        tip_r = arc_r + 7.5

        # Needle drop shadow
        cr.set_line_width(2.2)
        cr.set_source_rgba(0.05, 0.04, 0.02, 0.38)
        cr.move_to(piv_x + 2.0, piv_y + 2.0)
        cr.line_to(piv_x + 2.0 + tip_r * math.cos(n_ang), piv_y + 2.0 + tip_r * math.sin(n_ang))
        cr.stroke()

        # Tapered needle shaft + luminous tip
        if dark_radium:
            cr.set_line_width(2.1)
            cr.set_source_rgb(0.75, 0.98, 0.80)
            cr.move_to(piv_x - 7.0 * math.cos(n_ang), piv_y - 7.0 * math.sin(n_ang))
            cr.line_to(piv_x + (tip_r * 0.68) * math.cos(n_ang), piv_y + (tip_r * 0.68) * math.sin(n_ang))
            cr.stroke()
            cr.set_line_width(2.3)
            cr.set_source_rgb(1.00, 0.44, 0.16)
            cr.move_to(piv_x + (tip_r * 0.62) * math.cos(n_ang), piv_y + (tip_r * 0.62) * math.sin(n_ang))
            cr.line_to(piv_x + tip_r * math.cos(n_ang), piv_y + tip_r * math.sin(n_ang))
            cr.stroke()
        else:
            cr.set_line_width(2.0)
            cr.set_source_rgb(0.16, 0.15, 0.15)
            cr.move_to(piv_x - 7.0 * math.cos(n_ang), piv_y - 7.0 * math.sin(n_ang))
            cr.line_to(piv_x + (tip_r * 0.55) * math.cos(n_ang), piv_y + (tip_r * 0.55) * math.sin(n_ang))
            cr.stroke()
            cr.set_line_width(2.0)
            cr.set_source_rgb(0.80, 0.12, 0.10)
            cr.move_to(piv_x + (tip_r * 0.50) * math.cos(n_ang), piv_y + (tip_r * 0.50) * math.sin(n_ang))
            cr.line_to(piv_x + tip_r * math.cos(n_ang), piv_y + tip_r * math.sin(n_ang))
            cr.stroke()

        # Machined center pivot boss
        cr.new_sub_path()
        cr.arc(piv_x, piv_y, 7.5, 0, 2 * math.pi)
        cr.set_source_rgb(0.18, 0.19, 0.22)
        cr.fill()
        cr.new_sub_path()
        cr.arc(piv_x, piv_y, 3.6, 0, 2 * math.pi)
        cr.set_source_rgb(0.72, 0.66, 0.52) if not dark_radium else cr.set_source_rgb(0.56, 0.62, 0.70)
        cr.fill()
        cr.restore()

        # 6. Inset Glowing VFD Sub-Window at bottom of dial
        cls.draw_vfd_inset(cr, mx + 6.0, vfd_y, mw - 12.0, vfd_h, vfd_l1, vfd_l2, amber=False)

        # Subtle glass reflection diagonal highlight
        cr.save()
        cr.rectangle(mx, my, mw, mh - vfd_h - 6)
        cr.clip()
        gl = cairo.LinearGradient(mx, my, mx + mw * 0.45, my + mh * 0.55)
        gl.add_color_stop_rgba(0.0, 1.0, 1.0, 1.0, 0.08 if dark_radium else 0.14)
        gl.add_color_stop_rgba(1.0, 1.0, 1.0, 1.0, 0.0)
        cr.rectangle(mx, my, mw, mh * 0.5)
        cr.set_source(gl)
        cr.fill()
        cr.restore()

    @classmethod
    def _draw_recorder_frame(
        cls,
        cr: cairo.Context,
        x: float,
        y: float,
        w: float,
        h: float,
        title: str,
        subtitle: str,
        paper_mode: bool,
        sample_seq: int,
    ) -> tuple[float, float, float, float]:
        # Outer dark steel recorder cassette bezel
        cr.rectangle(x, y, w, h)
        cr.set_source_rgb(0.20, 0.23, 0.28)
        cr.fill()
        cr.set_line_width(1.5)
        cr.set_source_rgb(0.45, 0.50, 0.60)
        cr.move_to(x + 0.7, y + h - 0.7)
        cr.line_to(x + 0.7, y + 0.7)
        cr.line_to(x + w - 0.7, y + 0.7)
        cr.stroke()
        cr.set_source_rgb(0.08, 0.10, 0.13)
        cr.move_to(x + 0.7, y + h - 0.7)
        cr.line_to(x + w - 0.7, y + h - 0.7)
        cr.line_to(x + w - 0.7, y + 0.7)
        cr.stroke()

        # Header nameplate strip
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.2)
        cr.set_source_rgb(0.90, 0.93, 0.98)
        cr.move_to(x + 7.0, y + 12.0)
        cr.show_text(title)

        if subtitle:
            cr.set_font_size(7.8)
            ext_s = cr.text_extents(subtitle)
            cr.set_source_rgb(0.45, 0.96, 0.82) if not paper_mode else cr.set_source_rgb(1.00, 0.84, 0.48)
            cr.move_to(x + w - ext_s.width - 7.0, y + 12.0)
            cr.show_text(subtitle)

        px = x + 5.0
        py = y + 17.0
        pw = w - 10.0
        ph = h - 22.0

        if paper_mode:
            # Vintage Cream Drum Paper Roll with Top/Bottom Tractor Sprocket Strips!
            pap = cairo.LinearGradient(px, py, px + pw, py)
            pap.add_color_stop_rgb(0.0, 0.91, 0.87, 0.76)
            pap.add_color_stop_rgb(0.08, 0.98, 0.95, 0.87)
            pap.add_color_stop_rgb(0.94, 0.99, 0.96, 0.89)
            pap.add_color_stop_rgb(1.0, 0.88, 0.83, 0.72)
            cr.rectangle(px, py, pw, ph)
            cr.set_source(pap)
            cr.fill()

            # Top & bottom tractor-feed sprocket margins
            sp_h = 8.5
            cr.set_source_rgba(0.84, 0.79, 0.66, 0.65)
            cr.rectangle(px, py, pw, sp_h)
            cr.rectangle(px, py + ph - sp_h, pw, sp_h)
            cr.fill()

            # Perforation dashed tear lines
            cr.set_line_width(0.8)
            cr.set_source_rgba(0.55, 0.48, 0.36, 0.55)
            cr.move_to(px, py + sp_h)
            cr.line_to(px + pw, py + sp_h)
            cr.move_to(px, py + ph - sp_h)
            cr.line_to(px + pw, py + ph - sp_h)
            cr.stroke()

            # Scrolling sprocket holes!
            pitch = 14.0
            offset = (sample_seq * 2.5) % pitch
            cr.save()
            cr.rectangle(px + 2, py, pw - 4, ph)
            cr.clip()
            hx = px + pw - offset
            while hx >= px - pitch:
                for hy in (py + sp_h * 0.5, py + ph - sp_h * 0.5):
                    cr.arc(hx, hy, 2.3, 0, 2 * math.pi)
                    cr.set_source_rgb(0.24, 0.26, 0.30)
                    cr.fill()
                    cr.arc(hx, hy, 2.3, 0, 2 * math.pi)
                    cr.set_line_width(0.6)
                    cr.set_source_rgba(0.52, 0.45, 0.34, 0.7)
                    cr.stroke()
                hx -= pitch
            cr.restore()

            cx0, cy0, cw0, ch0 = px + 4.0, py + sp_h + 2.0, pw - 8.0, ph - 2 * sp_h - 4.0

            # Ruled olive/sepia chart millimeter grid
            cr.set_line_width(0.65)
            cr.set_source_rgba(0.46, 0.58, 0.42, 0.38)
            for gi_y in range(5):
                gy = cy0 + (gi_y / 4.0) * ch0
                cr.move_to(cx0, gy)
                cr.line_to(cx0 + cw0, gy)
            step_x = cw0 / 10.0
            gx_off = (sample_seq * (cw0 / HISTORY_LEN)) % step_x
            gx = cx0 + cw0 - gx_off
            while gx >= cx0:
                cr.move_to(gx, cy0)
                cr.line_to(gx, cy0 + ch0)
                gx -= step_x
            cr.stroke()
        else:
            # Tektronix / SGI Dark CRT Phosphor Screen
            cr.rectangle(px, py, pw, ph)
            cr.set_source_rgb(0.03, 0.07, 0.06)
            cr.fill()

            cx0, cy0, cw0, ch0 = px + 5.0, py + 5.0, pw - 10.0, ph - 10.0
            # Etched CRT graticule grid
            cr.set_line_width(0.7)
            cr.set_source_rgba(0.16, 0.42, 0.32, 0.42)
            for gi_y in range(5):
                gy = cy0 + (gi_y / 4.0) * ch0
                cr.move_to(cx0, gy)
                cr.line_to(cx0 + cw0, gy)
            for gi_x in range(11):
                gx = cx0 + (gi_x / 10.0) * cw0
                cr.move_to(gx, cy0)
                cr.line_to(gx, cy0 + ch0)
            cr.stroke()

        # Inner recessed glass shadow
        cr.set_line_width(1.3)
        cr.set_source_rgba(0.02, 0.03, 0.04, 0.7)
        cr.rectangle(px + 0.6, py + 0.6, pw - 1.2, ph - 1.2)
        cr.stroke()

        return cx0, cy0, cw0, ch0

    @staticmethod
    def _plot_trace(
        cr: cairo.Context,
        cx: float,
        cy: float,
        cw: float,
        ch: float,
        samples: list[float],
        max_val: float,
        rgb: tuple[float, float, float],
        paper_mode: bool,
        fill_alpha: float = 0.14,
    ):
        if not samples or cw <= 4 or ch <= 4:
            return
        mv = max(1e-6, max_val)
        n = len(samples)
        pts: list[tuple[float, float]] = []
        plot_w = cw - 7.0  # leave room on right for fountain-pen nib / beam head
        for i, v in enumerate(samples):
            frac_x = i / max(1, n - 1)
            frac_y = max(0.0, min(1.0, v / mv))
            pts.append((cx + frac_x * plot_w, cy + ch - frac_y * ch))

        cr.save()
        cr.rectangle(cx, cy, cw, ch)
        cr.clip()

        # Subtle area wash under trace
        if fill_alpha > 0.0:
            cr.move_to(pts[0][0], cy + ch)
            for px, py in pts:
                cr.line_to(px, py)
            cr.line_to(pts[-1][0], cy + ch)
            cr.close_path()
            cr.set_source_rgba(rgb[0], rgb[1], rgb[2], fill_alpha)
            cr.fill()

        # Phosphor halo glow in CRT mode
        if not paper_mode:
            cr.set_line_width(3.0)
            cr.set_source_rgba(rgb[0], rgb[1], rgb[2], 0.24)
            cr.move_to(*pts[0])
            for px, py in pts[1:]:
                cr.line_to(px, py)
            cr.stroke()

        # Crisp ink / beam trace
        cr.set_line_width(1.45 if paper_mode else 1.65)
        cr.set_source_rgb(*rgb)
        cr.move_to(*pts[0])
        for px, py in pts[1:]:
            cr.line_to(px, py)
        cr.stroke()

        # Right-edge Fountain-Pen Brass Nib (Paper Mode) or Glowing Electron Beam Dot (CRT Mode)
        lx, ly = pts[-1]
        if paper_mode:
            cr.move_to(lx, ly)
            cr.line_to(lx + 6.5, ly - 2.8)
            cr.line_to(lx + 6.5, ly + 2.8)
            cr.close_path()
            cr.set_source_rgb(*rgb)
            cr.fill()
        else:
            cr.arc(lx, ly, 2.5, 0, 2 * math.pi)
            cr.set_source_rgb(min(1.0, rgb[0] + 0.3), min(1.0, rgb[1] + 0.3), min(1.0, rgb[2] + 0.3))
            cr.fill()
        cr.restore()

    @classmethod
    def draw_top_dials(
        cls,
        cr: cairo.Context,
        W: int,
        H: int,
        tel: TelemetryEngine,
        needles: dict[str, float],
        dark_radium: bool,
    ):
        pad = 4.0
        gap = 6.0
        gw = (W - 2 * pad - 3 * gap) / 4.0
        gh = H - 2 * pad
        if gw < 60 or gh < 60:
            return

        # 1. CPU UTILIZATION (%)
        freq_txt = f"{tel.cpu_mhz / 1000.0:.2f} GHz" if tel.cpu_mhz >= 1000 else f"{tel.cpu_mhz:.0f} MHz"
        cpu_lamp_col = (0.95, 0.20, 0.18) if tel.cpu_total_pct > 85 else ((0.98, 0.72, 0.16) if tel.cpu_total_pct > 65 else (0.18, 0.90, 0.48))
        cls.draw_analog_gauge_box(
            cr,
            pad,
            pad,
            gw,
            gh,
            title="CPU UTILIZATION",
            unit_lbl="% BUSY",
            norm_val=needles["cpu"],
            marks=[(0.0, "0", False), (0.25, "25", False), (0.50, "50", False), (0.75, "75", False), (1.0, "100", True)],
            red_span=(0.80, 1.00),
            dark_radium=dark_radium,
            vfd_l1=f"{tel.cpu_total_pct:5.1f}%  {freq_txt}",
            vfd_l2=f"USR {tel.cpu_usr_pct:4.1f}% SYS {tel.cpu_sys_pct:4.1f}%",
            lamps=[("PEAK", cpu_lamp_col, tel.cpu_total_pct > 65.0)],
            core_bars=tel.core_pcts,
            badge_tag=f"{len(tel.core_pcts)}C",
            screw_seed=1,
        )

        # 2. MEMORY & SWAP
        swp_col = (0.95, 0.20, 0.18) if tel.swap_pct > 35 else ((0.98, 0.70, 0.16) if tel.swap_pct > 5 else (0.18, 0.88, 0.48))
        cls.draw_analog_gauge_box(
            cr,
            pad + (gw + gap),
            pad,
            gw,
            gh,
            title="MEMORY & SWAP",
            unit_lbl="RAM %",
            norm_val=needles["mem"],
            marks=[(0.0, "0", False), (0.25, "25", False), (0.50, "50", False), (0.75, "75", False), (1.0, "100", True)],
            red_span=(0.85, 1.00),
            dark_radium=dark_radium,
            vfd_l1=f"{tel.mem_used_gib:.2f} / {tel.mem_total_gib:.1f} GiB",
            vfd_l2=f"CACHE {tel.mem_bufcache_gib:.1f}G  SWP {tel.swap_pct:.0f}%",
            lamps=[("SWAP", swp_col, tel.swap_pct > 5.0)],
            secondary_norm=min(1.0, (tel.mem_used_pct + tel.mem_bufcache_pct) / 100.0),
            badge_tag="RAM+BUF",
            screw_seed=2,
        )

        # 3. CORE THERMAL (°C) — 20°C .. 105°C
        th_col = (0.96, 0.20, 0.18) if tel.temp_c >= 82.0 else ((0.98, 0.72, 0.16) if tel.temp_c >= 65.0 else (0.18, 0.90, 0.48))
        cool_str = f"COOL {tel.cooling_cur}/{tel.cooling_max}" if tel.cooling_max > 0 else "PASSIVE"
        zshort = "PKG" if "pkg" in tel.temp_zone_name else tel.temp_zone_name[:7].upper()
        cls.draw_analog_gauge_box(
            cr,
            pad + 2 * (gw + gap),
            pad,
            gw,
            gh,
            title="CORE THERMAL",
            unit_lbl="DEG °C",
            norm_val=needles["temp"],
            marks=[(0.0, "20", False), (0.235, "40", False), (0.47, "60", False), (0.706, "80", True), (1.0, "105", True)],
            red_span=(0.706, 1.00),
            dark_radium=dark_radium,
            vfd_l1=f"{tel.temp_c:4.1f}°C / {tel.temp_f:5.1f}°F",
            vfd_l2=f"{zshort} • {cool_str}",
            lamps=[("HOT", th_col, tel.temp_c >= 65.0)],
            badge_tag=zshort,
            screw_seed=3,
        )

        # 4. SYSTEM BATTERY & AC MAINS
        low_bat = tel.bat_present and (tel.bat_pct <= 20.0)
        on_batt = tel.bat_present and (not tel.ac_online or tel.bat_status.lower() == "discharging")
        pwr_lamps = [
            ("AC", (0.16, 0.95, 0.52), tel.ac_online),
            ("BAT", (1.00, 0.72, 0.16), on_batt),
            ("LOW", (0.98, 0.20, 0.20), low_bat),
        ]
        if tel.bat_present:
            vfd1 = f"{tel.bat_pct:3.0f}%  {tel.bat_volts:5.2f}V  {tel.bat_watts:4.1f}W"
            if tel.bat_design_wh > 0.1:
                vfd2 = f"{tel.bat_full_wh:.1f}/{tel.bat_design_wh:.1f}Wh ({tel.bat_health_pct:.0f}%)"
            else:
                vfd2 = f"{tel.bat_status.upper()[:18]}"
        else:
            vfd1 = "AC MAINS ONLINE" if tel.ac_online else "NO PACK"
            vfd2 = "EXTERNAL REGULATED"

        cls.draw_analog_gauge_box(
            cr,
            pad + 3 * (gw + gap),
            pad,
            gw,
            gh,
            title=f"BATTERY ({tel.bat_name})",
            unit_lbl=tel.bat_model[:11],
            norm_val=needles["bat"],
            marks=[(0.0, "E", True), (0.25, "25", False), (0.50, "50", False), (0.75, "75", False), (1.0, "F", False)],
            red_span=(0.00, 0.20),
            dark_radium=dark_radium,
            vfd_l1=vfd1,
            vfd_l2=vfd2,
            lamps=pwr_lamps,
            screw_seed=4,
        )

    @classmethod
    def draw_strip_recorders(
        cls,
        cr: cairo.Context,
        W: int,
        H: int,
        tel: TelemetryEngine,
        paper_mode: bool,
    ):
        pad = 4.0
        gap = 6.0
        cw = (W - 2 * pad - 3 * gap) / 4.0
        ch = H - 2 * pad
        if cw < 60 or ch < 60:
            return

        # Pen / Phosphor Color Pairings
        c_pri = (0.78, 0.12, 0.12) if paper_mode else (0.24, 0.96, 0.56)
        c_sec = (0.12, 0.34, 0.76) if paper_mode else (1.00, 0.72, 0.20)
        c_txt = (0.20, 0.16, 0.10) if paper_mode else (0.66, 0.96, 0.80)

        # ---- Recorder 1: CPU & LOAD AVG (1m / 5m / 15m) ----
        rx0, ry0, rw0, rh0 = cls._draw_recorder_frame(
            cr,
            pad,
            pad,
            cw,
            ch,
            "CPU & LOAD AVG",
            f"{tel.load_1m:.2f} {tel.load_5m:.2f} {tel.load_15m:.2f}",
            paper_mode,
            tel.sample_seq,
        )
        cls._plot_trace(cr, rx0, ry0, rw0, rh0, list(tel.hist_cpu), 100.0, c_pri, paper_mode, 0.16)
        cls._plot_trace(cr, rx0, ry0, rw0, rh0, list(tel.hist_load), 100.0, c_sec, paper_mode, 0.05)
        cls._draw_trace_legend(cr, rx0 + 4, ry0 + 10, [("CPU%", c_pri), ("LOAD", c_sec)], c_txt)

        # ---- Recorder 2: NETWORK THROUGHPUT (RX / TX) ----
        rx_hist = list(tel.hist_net_rx)
        tx_hist = list(tel.hist_net_tx)
        net_peak = max(1024.0 * 8.0, max(rx_hist, default=0.0), max(tx_hist, default=0.0)) * 1.15
        rx1, ry1, rw1, rh1 = cls._draw_recorder_frame(
            cr,
            pad + (cw + gap),
            pad,
            cw,
            ch,
            f"NET [{tel.active_iface}]",
            f"↓{fmt_bytes_total(tel.net_rx_total)} ↑{fmt_bytes_total(tel.net_tx_total)}",
            paper_mode,
            tel.sample_seq,
        )
        cls._plot_trace(cr, rx1, ry1, rw1, rh1, rx_hist, net_peak, c_pri, paper_mode, 0.16)
        cls._plot_trace(cr, rx1, ry1, rw1, rh1, tx_hist, net_peak, c_sec, paper_mode, 0.06)
        cls._draw_trace_legend(
            cr,
            rx1 + 4,
            ry1 + 10,
            [(f"RX {fmt_bytes_rate(tel.net_rx_bps).strip()}", c_pri), (f"TX {fmt_bytes_rate(tel.net_tx_bps).strip()}", c_sec)],
            c_txt,
        )

        # ---- Recorder 3: DISK I/O + / & /home ANALOG FUEL BARS ----
        dr_hist = list(tel.hist_disk_r)
        dw_hist = list(tel.hist_disk_w)
        d_peak = max(1024.0 * 64.0, max(dr_hist, default=0.0), max(dw_hist, default=0.0)) * 1.15
        rx2, ry2, rw2, rh2 = cls._draw_recorder_frame(
            cr,
            pad + 2 * (cw + gap),
            pad,
            cw,
            ch,
            f"DISK [{tel.disk_label}]",
            f"R:{tel.disk_read_bps/(1024*1024):.1f} W:{tel.disk_write_bps/(1024*1024):.1f}M/s",
            paper_mode,
            tel.sample_seq,
        )
        fuel_h = 34.0
        plot_h2 = max(24.0, rh2 - fuel_h - 3.0)
        cls._plot_trace(cr, rx2, ry2, rw2, plot_h2, dr_hist, d_peak, c_pri, paper_mode, 0.16)
        cls._plot_trace(cr, rx2, ry2, rw2, plot_h2, dw_hist, d_peak, c_sec, paper_mode, 0.06)
        cls._draw_trace_legend(cr, rx2 + 4, ry2 + 10, [("RD", c_pri), ("WR", c_sec)], c_txt)

        # / and /home statvfs analog fuel bars
        fy0 = ry2 + plot_h2 + 4.0
        for idx_f, (mnt, (u_g, t_g, f_pct)) in enumerate([("/", tel.fs_root), ("/home", tel.fs_home)]):
            by = fy0 + idx_f * 15.5
            cls._draw_fuel_bar(cr, rx2 + 2, by, rw2 - 4, 13.0, mnt, f_pct, f"{u_g:.0f}/{t_g:.0f}G", paper_mode)

        # ---- Recorder 4: SGI gr_osview PER-CORE & MEMORY PRESSURE MATRIX ----
        rx3, ry3, rw3, rh3 = cls._draw_recorder_frame(
            cr,
            pad + 3 * (cw + gap),
            pad,
            cw,
            ch,
            "SGI OS-VIEW MATRIX",
            f"{len(tel.core_splits)} CORES + VM",
            paper_mode,
            tel.sample_seq,
        )
        cls._draw_sgi_matrix(cr, rx3, ry3, rw3, rh3, tel, paper_mode)

    @staticmethod
    def _draw_trace_legend(
        cr: cairo.Context,
        x: float,
        y: float,
        items: list[tuple[str, tuple[float, float, float]]],
        txt_rgb: tuple[float, float, float],
    ):
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(7.6)
        cx = x
        for lbl, col in items:
            cr.rectangle(cx, y - 6.0, 6.5, 6.5)
            cr.set_source_rgb(*col)
            cr.fill()
            cx += 9.0
            cr.set_source_rgb(*txt_rgb)
            cr.move_to(cx, y)
            cr.show_text(lbl)
            cx += cr.text_extents(lbl).width + 8.0

    @staticmethod
    def _draw_fuel_bar(
        cr: cairo.Context,
        x: float,
        y: float,
        w: float,
        h: float,
        label: str,
        pct: float,
        val_txt: str,
        paper_mode: bool,
    ):
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(7.6)
        cr.set_source_rgb(0.18, 0.15, 0.10) if paper_mode else cr.set_source_rgb(0.68, 0.96, 0.82)
        cr.move_to(x, y + h - 3.0)
        cr.show_text(label)

        bx = x + 34.0
        bw = max(24.0, w - 92.0)
        cr.rectangle(bx, y + 1.5, bw, h - 3.0)
        cr.set_source_rgba(0.15, 0.14, 0.10, 0.18) if paper_mode else cr.set_source_rgb(0.06, 0.13, 0.11)
        cr.fill()

        fill_w = bw * max(0.0, min(1.0, pct / 100.0))
        cr.rectangle(bx, y + 1.5, fill_w, h - 3.0)
        if pct >= 88.0:
            cr.set_source_rgb(0.86, 0.18, 0.16)
        elif paper_mode:
            cr.set_source_rgb(0.16, 0.44, 0.68)
        else:
            cr.set_source_rgb(0.24, 0.88, 0.62)
        cr.fill()

        # Segmented ticks
        cr.set_line_width(0.8)
        cr.set_source_rgba(0.98, 0.95, 0.88, 0.65) if paper_mode else cr.set_source_rgba(0.03, 0.07, 0.06, 0.75)
        for s in range(1, 5):
            sx = bx + (s / 5.0) * bw
            cr.move_to(sx, y + 1.5)
            cr.line_to(sx, y + h - 1.5)
        cr.stroke()

        cr.set_source_rgb(0.20, 0.16, 0.10) if paper_mode else cr.set_source_rgb(0.82, 0.96, 0.88)
        cr.move_to(bx + bw + 4.0, y + h - 3.0)
        cr.show_text(val_txt)

    @staticmethod
    def _draw_sgi_matrix(
        cr: cairo.Context,
        x: float,
        y: float,
        w: float,
        h: float,
        tel: TelemetryEngine,
        paper_mode: bool,
    ):
        # Rows: C0..Cn (up to 8 compact), MEM (Used+Cache), SWP, LD1
        rows: list[tuple[str, list[tuple[float, tuple[float, float, float]]], float]] = []
        c_usr = (0.16, 0.48, 0.78) if paper_mode else (0.20, 0.92, 0.54)
        c_sys = (0.82, 0.18, 0.16) if paper_mode else (0.98, 0.34, 0.24)
        c_iow = (0.86, 0.56, 0.12) if paper_mode else (1.00, 0.78, 0.22)
        c_cache = (0.48, 0.66, 0.42) if paper_mode else (0.24, 0.62, 0.86)

        max_cores = min(6, len(tel.core_splits))
        for ci in range(max_cores):
            u, s, io = tel.core_splits[ci]
            pk = tel.core_peaks[ci] if ci < len(tel.core_peaks) else (u + s + io)
            rows.append((f"CPU{ci}", [(u, c_usr), (s, c_sys), (io, c_iow)], pk))

        rows.append(("MEM", [(tel.mem_used_pct, c_usr), (tel.mem_bufcache_pct, c_cache)], tel.mem_used_pct))
        rows.append(("SWAP", [(tel.swap_pct, c_sys)], tel.swap_pct))
        ncores = max(1, len(tel.core_splits))
        ld_pct = min(100.0, 100.0 * tel.load_1m / ncores)
        rows.append(("LOAD", [(ld_pct, c_iow)], ld_pct))

        nrows = len(rows)
        row_h = min(16.0, max(9.5, (h - 4.0) / max(1, nrows)))
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(7.5)

        for idx, (lbl, segs, peak) in enumerate(rows):
            ry = y + 2.0 + idx * row_h
            if ry + row_h > y + h + 1:
                break
            cr.set_source_rgb(0.18, 0.15, 0.10) if paper_mode else cr.set_source_rgb(0.68, 0.96, 0.82)
            cr.move_to(x + 2.0, ry + row_h * 0.76)
            cr.show_text(lbl)

            bx = x + 31.0
            bw = max(24.0, w - 65.0)
            bh = max(5.5, row_h - 3.2)
            by = ry + 1.5

            cr.rectangle(bx, by, bw, bh)
            cr.set_source_rgba(0.16, 0.14, 0.10, 0.16) if paper_mode else cr.set_source_rgb(0.06, 0.13, 0.11)
            cr.fill()

            cur_x = bx
            tot_pct = 0.0
            for spct, scol in segs:
                sw = bw * max(0.0, min(1.0 - (cur_x - bx) / bw, spct / 100.0))
                if sw > 0.4:
                    cr.rectangle(cur_x, by, sw, bh)
                    cr.set_source_rgb(*scol)
                    cr.fill()
                    cur_x += sw
                tot_pct += spct

            # Peak hold tick mark
            pk_x = bx + bw * max(0.0, min(1.0, peak / 100.0))
            cr.set_line_width(1.3)
            cr.set_source_rgb(0.75, 0.10, 0.10) if paper_mode else cr.set_source_rgb(1.00, 0.88, 0.36)
            cr.move_to(pk_x, by)
            cr.line_to(pk_x, by + bh)
            cr.stroke()

            cr.set_source_rgb(0.20, 0.16, 0.10) if paper_mode else cr.set_source_rgb(0.78, 0.96, 0.86)
            vstr = f"{min(100.0, rows[idx][2] if lbl != 'MEM' else tel.mem_used_pct):3.0f}%"
            cr.move_to(bx + bw + 3.5, ry + row_h * 0.76)
            cr.show_text(vstr)

    @classmethod
    def draw_vfd_uptime_bar(
        cls,
        cr: cairo.Context,
        W: int,
        H: int,
        tel: TelemetryEngine,
        paused: bool,
        rate_sec: float,
    ):
        # Recessed Vacuum Fluorescent Display Strip
        cr.rectangle(0, 0, W, H)
        cr.set_source_rgb(0.03, 0.07, 0.07)
        cr.fill()
        cr.set_line_width(1.8)
        cr.set_source_rgb(0.01, 0.02, 0.02)
        cr.move_to(0, H)
        cr.line_to(0, 0)
        cr.line_to(W, 0)
        cr.stroke()
        cr.set_source_rgb(0.36, 0.41, 0.49)
        cr.move_to(0, H)
        cr.line_to(W, H)
        cr.line_to(W, 0)
        cr.stroke()

        up = int(tel.uptime_sec)
        days = up // 86400
        hrs = (up % 86400) // 3600
        mins = (up % 3600) // 60
        secs = up % 60
        up_str = f"{days:03d}:{hrs:02d}:{mins:02d}:{secs:02d}"

        cr.save()
        cr.rectangle(6, 2, W - 12, H - 4)
        cr.clip()
        cr.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(10.5)

        segments = [
            ("HOST", tel.hostname, (0.28, 0.98, 0.86)),
            ("KERN", tel.kernel.split("-")[0] + "-" + tel.arch, (0.48, 0.90, 0.82)),
            ("UPTIME", up_str, (1.00, 0.76, 0.24)),
            ("TASKS", f"{tel.procs_running}R / {tel.procs_total}P / {tel.threads_total}T", (0.36, 0.96, 0.72)),
            ("GATE", "HOLD/PAUSE" if paused else f"{rate_sec:.1f}s LIVE", (1.00, 0.44, 0.34) if paused else (0.28, 0.98, 0.86)),
        ]

        cx = 12.0
        cy = H * 0.5 + 4.0
        for tag, val, col in segments:
            cr.set_font_size(8.2)
            cr.set_source_rgba(0.42, 0.78, 0.72, 0.80)
            cr.move_to(cx, cy - 0.5)
            cr.show_text(tag + ":")
            cx += cr.text_extents(tag + ":").width + 5.0

            cr.set_font_size(10.5)
            cr.set_source_rgba(col[0], col[1], col[2], 0.20)
            cr.move_to(cx + 0.8, cy + 0.8)
            cr.show_text(val)
            cr.set_source_rgb(*col)
            cr.move_to(cx, cy)
            cr.show_text(val)
            cx += cr.text_extents(val).width + 20.0
        cr.restore()

    @classmethod
    def draw_compact_rack(
        cls,
        cr: cairo.Context,
        W: int,
        H: int,
        tel: TelemetryEngine,
        needles: dict[str, float],
        dark_radium: bool,
        paper_mode: bool,
    ):
        """Sleek vertical 340x600 desktop telemetry rack (SGI gr_osview + SunOS perfmeter)."""
        pad = 4.0
        gap = 5.0
        # Row 1: Twin Edge-Lit Analog Dials (CPU% + BATTERY / THERMAL)
        dial_h = 152.0
        dw = (W - 2 * pad - gap) * 0.5

        cls.draw_analog_gauge_box(
            cr,
            pad,
            pad,
            dw,
            dial_h,
            title="CPU & TEMP",
            unit_lbl=f"{tel.temp_c:.0f}°C PKG",
            norm_val=needles["cpu"],
            marks=[(0.0, "0", False), (0.5, "50", False), (1.0, "100", True)],
            red_span=(0.80, 1.00),
            dark_radium=dark_radium,
            vfd_l1=f"{tel.cpu_total_pct:4.1f}% {tel.cpu_mhz/1000.0:.2f}G",
            vfd_l2=f"{tel.temp_c:4.1f}°C / {tel.load_1m:.2f}L",
            lamps=[("HOT", (0.96, 0.22, 0.18), tel.temp_c >= 75.0)],
            screw_seed=1,
        )

        cls.draw_analog_gauge_box(
            cr,
            pad + dw + gap,
            pad,
            dw,
            dial_h,
            title=f"PWR ({tel.bat_name})",
            unit_lbl=tel.bat_model[:9],
            norm_val=needles["bat"],
            marks=[(0.0, "E", True), (0.5, "50", False), (1.0, "F", False)],
            red_span=(0.00, 0.20),
            dark_radium=dark_radium,
            vfd_l1=f"{tel.bat_pct:3.0f}% {tel.bat_volts:4.1f}V",
            vfd_l2=f"{'AC ON' if tel.ac_online else 'BATT'} {tel.bat_watts:4.1f}W",
            lamps=[("AC", (0.18, 0.95, 0.52), tel.ac_online), ("LOW", (0.98, 0.20, 0.20), tel.bat_pct <= 20.0)],
            screw_seed=4,
        )

        # Row 2: SGI gr_osview Bar Matrix
        y_cur = pad + dial_h + gap
        mat_h = 148.0
        rxm, rym, rwm, rhm = cls._draw_recorder_frame(
            cr,
            pad,
            y_cur,
            W - 2 * pad,
            mat_h,
            "SGI GR_OSVIEW TELEMETRY",
            f"RAM {tel.mem_used_gib:.1f}/{tel.mem_total_gib:.1f}G",
            paper_mode,
            tel.sample_seq,
        )
        cls._draw_sgi_matrix(cr, rxm, rym, rwm, rhm, tel, paper_mode)

        # Row 3: SunOS perfmeter Rolling Strip-Chart (CPU + NET + DISK)
        y_cur += mat_h + gap
        vfd_h = 30.0
        st_h = max(80.0, H - y_cur - vfd_h - 2 * gap)
        half_h = (st_h - gap) * 0.5

        c_pri = (0.78, 0.12, 0.12) if paper_mode else (0.24, 0.96, 0.56)
        c_sec = (0.12, 0.34, 0.76) if paper_mode else (1.00, 0.72, 0.20)
        c_txt = (0.20, 0.16, 0.10) if paper_mode else (0.66, 0.96, 0.80)

        rxs1, rys1, rws1, rhs1 = cls._draw_recorder_frame(
            cr,
            pad,
            y_cur,
            W - 2 * pad,
            half_h,
            "PERFMETER CPU / LOAD",
            f"1m:{tel.load_1m:.2f} 5m:{tel.load_5m:.2f}",
            paper_mode,
            tel.sample_seq,
        )
        cls._plot_trace(cr, rxs1, rys1, rws1, rhs1, list(tel.hist_cpu), 100.0, c_pri, paper_mode, 0.16)
        cls._plot_trace(cr, rxs1, rys1, rws1, rhs1, list(tel.hist_load), 100.0, c_sec, paper_mode, 0.05)
        cls._draw_trace_legend(cr, rxs1 + 4, rys1 + 10, [("CPU%", c_pri), ("LOAD", c_sec)], c_txt)

        y_cur += half_h + gap
        rx_hist = list(tel.hist_net_rx)
        tx_hist = list(tel.hist_net_tx)
        net_peak = max(1024.0 * 8.0, max(rx_hist, default=0.0), max(tx_hist, default=0.0)) * 1.15
        rxs2, rys2, rws2, rhs2 = cls._draw_recorder_frame(
            cr,
            pad,
            y_cur,
            W - 2 * pad,
            half_h,
            f"NET [{tel.active_iface}] & DISK",
            f"R:{tel.disk_read_bps/(1024*1024):.1f}M/s",
            paper_mode,
            tel.sample_seq,
        )
        cls._plot_trace(cr, rxs2, rys2, rws2, rhs2, rx_hist, net_peak, c_pri, paper_mode, 0.16)
        cls._plot_trace(cr, rxs2, rys2, rws2, rhs2, tx_hist, net_peak, c_sec, paper_mode, 0.06)
        cls._draw_trace_legend(
            cr,
            rxs2 + 4,
            rys2 + 10,
            [(f"RX {fmt_bytes_rate(tel.net_rx_bps).strip()}", c_pri), (f"TX {fmt_bytes_rate(tel.net_tx_bps).strip()}", c_sec)],
            c_txt,
        )

        # Row 4: Mini VFD Uptime Footer
        y_cur += half_h + gap
        up = int(tel.uptime_sec)
        up_s = f"{up // 86400:02d}d {(up % 86400) // 3600:02d}:{(up % 3600) // 60:02d}:{up % 60:02d}"
        cls.draw_vfd_inset(
            cr,
            pad,
            y_cur,
            W - 2 * pad,
            vfd_h,
            f"{tel.hostname} • UP {up_s} • {tel.procs_total} PROCS",
        )


# ---------------------------------------------------------------------------
# Main dtSys GTK3 Vintage Telemetry Console Window
# ---------------------------------------------------------------------------
class DtSysWindow(Gtk.Window):
    def __init__(self, self_test: bool = False):
        super().__init__(title="dtSys — Analog System Telemetry & Strip-Chart Console")
        self.set_default_size(1080, 650)
        self.set_resizable(True)
        self._self_test = self_test

        for ic_candidate in (
            HOME / ".dt" / "icons" / "dtsys.pm",
            Path(__file__).resolve().parent / "icons" / "dtsys.pm",
        ):
            if ic_candidate.is_file():
                try:
                    self.set_icon_from_file(str(ic_candidate))
                    break
                except Exception:
                    pass

        chrome, sel, well = load_cde_palette()
        prov = Gtk.CssProvider()
        prov.load_from_data(build_sys_css(chrome, sel, well))
        screen = Gdk.Screen.get_default()
        if screen is not None:
            Gtk.StyleContext.add_provider_for_screen(
                screen, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        self.tel = TelemetryEngine()

        # UI / Instrument Preferences
        self.dark_radium = False
        self.paper_mode = True
        self.compact_rack = False
        self.procs_visible = True
        self.sample_rate_sec = 1.0
        self.paused = False
        self.proc_sort = "cpu"
        self._last_sample_mono = 0.0
        self._last_proc_mono = 0.0
        self._known_ifaces: list[str] = []
        self._updating_ui = False

        # Ballistic damped spring-inertia needles (0.0 .. 1.0)
        self.needles = {"cpu": 0.05, "mem": 0.25, "temp": 0.30, "bat": 0.90}
        self.needle_vel = {"cpu": 0.0, "mem": 0.0, "temp": 0.0, "bat": 0.0}

        self._load_state()
        self._build_ui()
        self._sync_toggle_styles()

        # Initial live telemetry & process poll
        self.tel.poll_telemetry(record_history=True)
        self._sync_iface_combo()
        self._refresh_process_table()

        # 18 fps (55 ms) smooth damped needle physics + scheduled telemetry sampling
        self._anim_timer = GLib.timeout_add(55, self._on_frame_tick)
        self.connect("destroy", self._on_destroy)

        if self._self_test:
            GLib.timeout_add(220, self._run_gui_self_test, 0)

    # ---- Persistence ----
    def _load_state(self):
        if STATE_FILE.is_file():
            try:
                st = json.loads(STATE_FILE.read_text(encoding="utf-8"))
                self.dark_radium = bool(st.get("dark_radium", False))
                self.paper_mode = bool(st.get("paper_mode", True))
                self.sample_rate_sec = float(st.get("sample_rate_sec", 1.0))
                self.procs_visible = bool(st.get("procs_visible", True))
                self.proc_sort = str(st.get("proc_sort", "cpu"))
                self.tel.selected_iface = str(st.get("selected_iface", "AUTO"))
            except Exception:
                pass

    def _save_state(self):
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            st = {
                "dark_radium": self.dark_radium,
                "paper_mode": self.paper_mode,
                "sample_rate_sec": self.sample_rate_sec,
                "procs_visible": self.procs_visible,
                "proc_sort": self.proc_sort,
                "selected_iface": self.tel.selected_iface,
            }
            STATE_FILE.write_text(json.dumps(st, indent=2), encoding="utf-8")
        except Exception:
            pass

    # ---- UI Construction ----
    def _build_ui(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(root)

        cab = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        cab.get_style_context().add_class("sys-cabinet")
        root.pack_start(cab, True, True, 0)

        # Top Control & Instrument Mode Strip (shared / adaptive)
        ctrl = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        ctrl.get_style_context().add_class("sys-strip")
        cab.pack_start(ctrl, False, False, 0)

        self.lbl_plate = Gtk.Label(label="DTSYS // CONTROL-ROOM TELEMETRY")
        self.lbl_plate.get_style_context().add_class("sys-engraved")
        ctrl.pack_start(self.lbl_plate, False, False, 4)

        self.btn_radium = Gtk.Button(label="DARK RADIUM DIALS")
        self.btn_radium.set_tooltip_text("Toggle Warm Incandescent Cream Dials vs Dark Radium / Phosphor Night Dials")
        self.btn_radium.connect("clicked", self._on_toggle_radium)
        ctrl.pack_start(self.btn_radium, False, False, 0)

        self.btn_chart = Gtk.Button(label="CHART: PAPER ROLL")
        self.btn_chart.set_tooltip_text("Switch between Cream Paper-Roll + Fountain-Pen Ink and CRT Phosphor Strip-Charts")
        self.btn_chart.connect("clicked", self._on_toggle_chart)
        ctrl.pack_start(self.btn_chart, False, False, 0)

