    # ---- Automated GUI Self-Test ----
    def _run_gui_self_test(self, step: int) -> bool:
        if step == 0:
            self._on_toggle_radium(self.btn_radium)
            self._on_toggle_chart(self.btn_chart)
            GLib.timeout_add(220, self._run_gui_self_test, 1)
        elif step == 1:
            self._on_toggle_compact(self.btn_compact)
            GLib.timeout_add(220, self._run_gui_self_test, 2)
        elif step == 2:
            self._on_toggle_compact(self.btn_compact)
            self._on_toggle_radium(self.btn_radium)
            self._on_toggle_chart(self.btn_chart)
            GLib.timeout_add(220, self._run_gui_self_test, 3)
        else:
            run_offscreen_verification(self.tel)
            print("DTSYS_SELF_TEST_OK")
            sys.stdout.flush()
            self.destroy()
        return False

    def _on_destroy(self, _w):
        if getattr(self, "_anim_timer", 0):
            GLib.source_remove(self._anim_timer)
            self._anim_timer = 0
        self._save_state()
        Gtk.main_quit()


# ---------------------------------------------------------------------------
# Offscreen Telemetry + Cairo Verification (Works With or Without $DISPLAY)
# ---------------------------------------------------------------------------
def run_offscreen_verification(tel: TelemetryEngine | None = None):
    eng = tel or TelemetryEngine()
    time.sleep(0.06)
    eng.poll_telemetry(record_history=True)
    procs = eng.scan_processes(sort_by="cpu", limit=25)
    assert eng.mem_total_gib > 0.1, "Invalid /proc/meminfo parse"
    assert len(eng.core_pcts) >= 1, "Invalid /proc/stat core parse"
    assert len(procs) >= 1, "Invalid /proc/[pid] process scan"

    needles = {
        "cpu": max(0.05, min(1.0, eng.cpu_total_pct / 100.0)),
        "mem": max(0.05, min(1.0, eng.mem_used_pct / 100.0)),
        "temp": max(0.05, min(1.0, (eng.temp_c - 20.0) / 85.0)),
        "bat": max(0.05, min(1.0, eng.bat_pct / 100.0)),
    }

    # Verify Top Dials (Cream Incandescent + Dark Radium)
    for dark in (False, True):
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1060, 190)
        cr = cairo.Context(surf)
        VintageRenderer.draw_top_dials(cr, 1060, 190, eng, needles, dark_radium=dark)
        surf.flush()
        assert any(surf.get_data()), "Empty Cairo dial surface"

    # Verify Strip-Chart Recorders (Paper Fountain-Pen + CRT Phosphor)
    for paper in (True, False):
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1060, 180)
        cr = cairo.Context(surf)
        VintageRenderer.draw_strip_recorders(cr, 1060, 180, eng, paper_mode=paper)
        surf.flush()
        assert any(surf.get_data()), "Empty Cairo strip-chart surface"

    # Verify VFD Bar & 340x600 Compact Rack
    surf_vfd = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1060, 32)
    VintageRenderer.draw_vfd_uptime_bar(cairo.Context(surf_vfd), 1060, 32, eng, False, 1.0)
    surf_vfd.flush()
    assert any(surf_vfd.get_data()), "Empty Cairo VFD surface"

    surf_rack = cairo.ImageSurface(cairo.FORMAT_ARGB32, 340, 600)
    VintageRenderer.draw_compact_rack(cairo.Context(surf_rack), 340, 600, eng, needles, False, True)
    surf_rack.flush()
    assert any(surf_rack.get_data()), "Empty Cairo Compact Rack surface"


def main():
    self_test = "--self-test" in sys.argv[1:]
    gtk_ok, _ = Gtk.init_check(sys.argv)
    if self_test and not gtk_ok:
        run_offscreen_verification()
        print("DTSYS_SELF_TEST_OK")
        sys.stdout.flush()
        return

    if not gtk_ok:
        sys.stderr.write("dtSys: cannot open X11 display (set DISPLAY or run --self-test).\n")
        sys.exit(1)

    win = DtSysWindow(self_test=self_test)
    win.show_all()
    win._sync_toggle_styles()
    Gtk.main()


if __name__ == "__main__":
