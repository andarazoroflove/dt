def load_source_roots() -> list[Path]:
    """Discover configured or standard local CDE source directories."""
    candidates: list[Path] = []
    env_root = os.environ.get("DT_SOURCE_ROOT", "").strip()
    if env_root:
        candidates.append(Path(env_root).expanduser())

    if SOURCES_CFG.is_file():
        try:
            cfg = json.loads(SOURCES_CFG.read_text(encoding="utf-8"))
            for p in cfg.get("source_dirs", []):
                candidates.append(Path(p).expanduser())
        except Exception:
            pass

    # Also check sibling repo folders if dtUpdate is run from a git checkout
    here = Path(__file__).resolve().parent
    if (here.parent / "dtMail" / "Makefile").is_file():
        candidates.append(here.parent)

    for std in (HOME / "dt", HOME / "src" / "dt", HOME / ".local" / "src" / "dt", HOME / "cde-system-applets"):
        candidates.append(std)

    seen = set()
    valid = []
    for c in candidates:
        rc = c.resolve() if c.exists() else None
        if rc and rc.is_dir() and rc not in seen:
            seen.add(rc)
            valid.append(rc)
    return valid


def parse_apt_simulated_upgrades() -> list[dict]:
    """Run `apt-get -s dist-upgrade` and parse all `Inst` lines."""
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    res = subprocess.run(
        ["apt-get", "-s", "dist-upgrade"],
        env=env, text=True, capture_output=True, timeout=60,
    )
    if res.returncode != 0:
        raise RuntimeError(res.stderr.strip() or "apt-get -s dist-upgrade failed")

    # Formats:
    # Inst pkg [1.2-1] (1.2-2 Debian:13.1/stable [amd64])
    # Inst newpkg (1.0-1 Debian:13.1/stable [amd64])
    inst_re = re.compile(r"^Inst\s+(\S+)\s+(?:\[([^\]]+)\]\s+)?\(([^\s\)]+)\s+([^)\[]+)")
    upgrades = []
    for ln in res.stdout.splitlines():
        m = inst_re.match(ln.strip())
        if m:
            pkg, old_v, new_v, origin = m.group(1), (m.group(2) or "NEW"), m.group(3), m.group(4).strip()
            action = "New Dependency" if old_v == "NEW" else "Upgrade"
            upgrades.append({
                "pkg": pkg,
                "pkg_base": pkg.split(":", 1)[0],
                "old_ver": old_v,
                "new_ver": new_v,
                "origin": origin,
                "action": action,
            })
    return upgrades


def inspect_binary_ldd(bin_path: Path) -> tuple[set[str], bool]:
    """Return (resolved_so_paths, has_missing_or_broken_symbols) for an ELF binary."""
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    res = subprocess.run(["ldd", "-r", str(bin_path)], env=env, text=True, capture_output=True, timeout=15)
    so_paths: set[str] = set()
    broken = False
    out = (res.stdout or "") + "\n" + (res.stderr or "")
    for ln in out.splitlines():
        s = ln.strip()
        if "not found" in s or s.startswith("undefined symbol:"):
            broken = True
        m = re.search(r"=>\s+(/\S+)\s+\(0x", s)
        if m:
            so_paths.add(m.group(1))
    return so_paths, broken


def map_files_to_dpkg_packages(file_paths: set[str]) -> dict[str, str]:
    """Batch-resolve shared library file paths to owning Debian package names."""
    if not file_paths:
        return {}
    expanded = set()
    for fp in list(file_paths):
        bases = {fp}
        try:
            bases.add(str(Path(fp).resolve()))
        except Exception:
            pass
        for b in bases:
            expanded.add(b)
            # Handle merged-/usr (/lib/x86_64-linux-gnu vs /usr/lib/x86_64-linux-gnu)
            if b.startswith("/usr/lib/"):
                expanded.add(b[4:])
            elif b.startswith("/lib/"):
                expanded.add("/usr" + b)

    res = subprocess.run(
        ["dpkg", "-S", *sorted(expanded)],
        text=True, capture_output=True, timeout=25,
    )
    mapping: dict[str, str] = {}
    for ln in (res.stdout or "").splitlines():
        if ln.startswith("diversion ") or ": /" not in ln:
            continue
        pkg_part, rel_path = ln.split(": /", 1)
        pkg_base = pkg_part.split(",")[0].split(":", 1)[0].strip()
        mapping["/" + rel_path.strip()] = pkg_base
    return mapping


def analyze_cde_rebuild_plan(apt_upgrades: list[dict], force_all: bool = False) -> list[dict]:
    """
    Determine which CDE applications need recompilation or verification.
    Only returns items that genuinely need action (unless force_all=True).
    """
    upgrading_pkgs = {u["pkg_base"]: u for u in apt_upgrades}
    roots = load_source_roots()
    plan: list[dict] = []

    # Locate C/Motif build directories
    applets_makefile_dir = None
    split_repo_dir = None
    for r in roots:
        if (r / "Makefile").is_file() and (r / "cde_mail.c").is_file():
            applets_makefile_dir = r
        if (r / "dtMail" / "Makefile").is_file():
            split_repo_dir = r

    # 1. Analyze C/Motif binaries
    c_candidates = []
    if applets_makefile_dir:
        for label, target, inst_path, src_files in MOTIF_TARGET_MAP:
            if (applets_makefile_dir / src_files[0]).is_file():
                c_candidates.append((label, target, inst_path, applets_makefile_dir, [applets_makefile_dir / sf for sf in src_files]))
    elif split_repo_dir:
        for folder, label, target, inst_path, sfiles in [
            ("dtMail",     "dtMail (cde-mail)", "cde-mail",     LOCAL_BIN / "cde-mail",     ["cde_mail.c", "cde_oe_icons.h"]),
            ("dtCalendar", "dtCalendar (dtcm)", "cde-calendar", LOCAL_BIN / "cde-calendar", ["cde_calendar.c"]),
        ]:
            bdir = split_repo_dir / folder
            if (bdir / "Makefile").is_file():
                c_candidates.append((label, target, inst_path, bdir, [bdir / sf for sf in sfiles]))

    # Batch ldd + dpkg -S across all installed C binaries
    bin_ldd_map: dict[Path, tuple[set[str], bool]] = {}
    all_so_files: set[str] = set()
    for _lbl, _tgt, inst_p, _bdir, _sfiles in c_candidates:
        if inst_p.is_file():
            sos, broken = inspect_binary_ldd(inst_p)
            bin_ldd_map[inst_p] = (sos, broken)
            all_so_files.update(sos)

    so_to_pkg = map_files_to_dpkg_packages(all_so_files)
    toolchain_triggers = {p for p in upgrading_pkgs if p.startswith(("gcc", "libc6-dev", "libmotif-dev", "libx11-dev", "libxt-dev", "libxpm-dev", "cde-desktop"))}

    for label, target, inst_p, bdir, sfiles in c_candidates:
        reasons = []
        if force_all:
            reasons.append("Forced full CDE binary rebuild requested")
        if not inst_p.is_file():
            reasons.append(f"Binary not yet installed ({inst_p.name})")
        else:
            bmtime = inst_p.stat().st_mtime
            newer_srcs = [sf.name for sf in sfiles if sf.is_file() and sf.stat().st_mtime > bmtime + 1.0]
            if newer_srcs:
                reasons.append(f"Source updated ({', '.join(newer_srcs)})")

            sos, broken = bin_ldd_map.get(inst_p, (set(), False))
            if broken:
                reasons.append("Broken shared library link / undefined symbol detected by ldd")

            matched_libs = set()
            for so in sos:
                so_bases = {so}
                try:
                    so_bases.add(str(Path(so).resolve()))
                except Exception:
                    pass
                so_cands = set()
                for sb in so_bases:
                    so_cands.add(sb)
                    if sb.startswith("/lib/"):
                        so_cands.add("/usr" + sb)
                    elif sb.startswith("/usr/lib/"):
                        so_cands.add(sb[4:])
                for cand in so_cands:
                    pk = so_to_pkg.get(cand)
                    if pk and pk in upgrading_pkgs:
                        u = upgrading_pkgs[pk]
                        matched_libs.add(f"{pk} ({u['old_ver']} → {u['new_ver']})")
            if matched_libs:
                reasons.append("Linked library updated: " + ", ".join(sorted(matched_libs)[:3]))
            elif toolchain_triggers:
                reasons.append("Core Motif/X11 header package updated: " + ", ".join(sorted(toolchain_triggers)[:2]))

        if reasons:
            plan.append({
                "kind": "c_motif",
                "label": label,
                "target": target,
                "build_dir": str(bdir),
                "install_path": str(inst_p),
                "action": "Recompile & Install Binary",
                "reason": "; ".join(reasons),
            })

    # 2. Analyze Python/GTK/GStreamer CDE Utilities
    for app_label, bin_name, dep_prefixes in PYTHON_CDE_APPS:
        inst_script = LOCAL_BIN / bin_name
        repo_script = (split_repo_dir / app_label / bin_name) if split_repo_dir else None
        reasons = []

        if repo_script and repo_script.is_file():
            if not inst_script.is_file():
                reasons.append("Not yet installed in ~/.local/bin")
            elif repo_script.stat().st_mtime > inst_script.stat().st_mtime + 1.0:
                # Check if content actually differs
                if repo_script.read_bytes() != inst_script.read_bytes():
                    reasons.append(f"Updated source in {app_label}/{bin_name}")

        if inst_script.is_file():
            matched_deps = [
                f"{pk} ({u['old_ver']} → {u['new_ver']})"
                for pk, u in upgrading_pkgs.items()
                if any(pk.startswith(pref) for pref in dep_prefixes)
            ]
            if matched_deps:
                reasons.append("Runtime updated: " + ", ".join(sorted(matched_deps)[:3]))

        if reasons:
            plan.append({
                "kind": "python_app",
                "label": app_label,
                "target": bin_name,
                "repo_script": str(repo_script) if (repo_script and repo_script.is_file()) else "",
                "install_path": str(inst_script),
                "action": "Sync & Verify Bytecode",
                "reason": "; ".join(reasons),
            })

    return plan


