    def on_configure_sources(self, *_args):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        cur_roots = [str(p) for p in load_source_roots()]
        dlg = Gtk.Dialog(title="CDE Source Directories — dtUpdate", transient_for=self, flags=0)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save", Gtk.ResponseType.OK)
        dlg.set_default_size(540, 240)
        box = dlg.get_content_area()
        box.set_spacing(8)
        box.set_margin_top(10); box.set_margin_bottom(10); box.set_margin_start(12); box.set_margin_end(12)
        box.pack_start(Gtk.Label(label="Local CDE source directories (one path per line):", xalign=0), False, False, 0)

        tv = Gtk.TextView()
        tv.get_buffer().set_text("\n".join(cur_roots))
        sw = Gtk.ScrolledWindow(); sw.set_vexpand(True); sw.add(tv)
        fr = Gtk.Frame(); fr.add(sw)
        box.pack_start(fr, True, True, 0)
        dlg.show_all()

        if dlg.run() == Gtk.ResponseType.OK:
            buf = tv.get_buffer()
            raw = buf.get_text(*buf.get_bounds(), True)
            dirs = [ln.strip() for ln in raw.splitlines() if ln.strip()]
            SOURCES_CFG.write_text(json.dumps({"source_dirs": dirs}, indent=2), encoding="utf-8")
            self.lbl_status.set_text(f"Saved {len(dirs)} CDE source path(s) to {SOURCES_CFG}")
        dlg.destroy()

    def on_save_log(self, *_args):
        dlg = Gtk.FileChooserDialog(title="Save dtUpdate Log", parent=self, action=Gtk.FileChooserAction.SAVE)
        dlg.set_do_overwrite_confirmation(True)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save", Gtk.ResponseType.OK)
        dlg.set_current_name(f"dtupdate_{datetime.date.today().isoformat()}.log")
        if dlg.run() == Gtk.ResponseType.OK:
            out_p = Path(dlg.get_filename())
            dlg.destroy()
            b_log = self.txt_log.get_buffer()
            full = (self.last_summary_text + "\n\n=== RAW CONSOLE LOG ===\n" +
                    b_log.get_text(*b_log.get_bounds(), True)).strip()
            out_p.write_text(full + "\n", encoding="utf-8")
            self.lbl_status.set_text(f"Saved update log to {out_p}")
        else:
            dlg.destroy()

