    # ---------------- Logging & UI Helpers ----------------
    def append_log(self, line: str):
        def _do():
            buf = self.txt_log.get_buffer()
            buf.insert(buf.get_end_iter(), line.rstrip("\r\n") + "\n")
            adj = self.sw_log.get_vadjustment()
            adj.set_value(max(0.0, adj.get_upper() - adj.get_page_size()))
            return False
        GLib.idle_add(_do)

    def set_progress(self, frac: float, text: str, phase: str | None = None):
        def _do():
            self.prog.set_fraction(max(0.0, min(1.0, frac)))
            self.prog.set_text(text)
            if phase is not None:
                self.lbl_phase.set_text(phase)
            self.lbl_status.set_text(text)
            return False
        GLib.idle_add(_do)

    # ---------------- Sudo Authentication ----------------
    def _ensure_sudo_authenticated(self) -> bool:
        # Test cached pw first if already entered this session
        if self._sudo_pw:
            if self._verify_sudo_pw(self._sudo_pw):
                return True
            self._sudo_pw = ""

        err_msg = ""
        for _attempt in range(3):
            dlg = SudoPromptDialog(self, error_hint=err_msg)
            resp = dlg.run()
            pw = dlg.get_password()
            dlg.destroy()
            if resp != Gtk.ResponseType.OK:
                return False
            if self._verify_sudo_pw(pw):
                self._sudo_pw = pw
                return True
            err_msg = "Incorrect sudo password — please try again."
        return False

    @staticmethod
    def _verify_sudo_pw(pw: str) -> bool:
        try:
            res = subprocess.run(
                ["sudo", "-S", "-k", "-p", "", "true"],
                input=(pw or "") + "\n",
                text=True,
                capture_output=True,
                timeout=10,
            )
            return res.returncode == 0
        except Exception:
            return False

    def _run_sudo_streamed(self, args: list[str], extra_env: dict | None = None,
                           on_line=None, status_fd_cb=None) -> int:
        """
        Execute `sudo -S -p "" env ... <args>` feeding password on stdin immediately,
        streaming stdout/stderr lines to on_line and optional APT Status-Fd pipe to status_fd_cb.
        """
        env_kv = ["LC_ALL=C", "DEBIAN_FRONTEND=noninteractive"]
        if extra_env:
            for k, v in extra_env.items():
                env_kv.append(f"{k}={v}")

        pass_fds = ()
        st_r, st_w = -1, -1
        final_args = list(args)
        if status_fd_cb is not None:
            st_r, st_w = os.pipe()
            os.set_inheritable(st_w, True)
            pass_fds = (st_w,)
            #sudo closes FDs >= 3 unless -C <num> is passed; check if sudo -C is permitted, else parse stdout!
            test_c = subprocess.run(
                ["sudo", "-S", "-C", str(st_w + 1), "-p", "", "true"],
                input=self._sudo_pw + "\n", text=True, capture_output=True,
            )
            if test_c.returncode == 0:
                cmd = ["sudo", "-S", "-C", str(st_w + 1), "-p", "", "env", *env_kv, *final_args, f"-o=APT::Status-Fd={st_w}"]
            else:
                os.close(st_r); os.close(st_w)
                st_r = st_w = -1
                pass_fds = ()
                cmd = ["sudo", "-S", "-p", "", "env", *env_kv, *final_args]
        else:
            cmd = ["sudo", "-S", "-p", "", "env", *env_kv, *final_args]

        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            pass_fds=pass_fds,
        )
        if st_w >= 0:
            os.close(st_w)

        try:
            proc.stdin.write(self._sudo_pw + "\n")
            proc.stdin.flush()
            proc.stdin.close()
        except Exception:
            pass

        if st_r >= 0 and status_fd_cb is not None:
            def _read_status_fd():
                with os.fdopen(st_r, "r", errors="replace") as sf:
                    for sln in sf:
                        parts = sln.strip().split(":", 3)
                        if len(parts) >= 4 and parts[0] in ("dlstatus", "pmstatus"):
                            try:
                                pct = float(parts[2])
                                status_fd_cb(parts[0], pct, parts[3].strip())
                            except ValueError:
                                pass
            threading.Thread(target=_read_status_fd, daemon=True).start()

        if proc.stdout:
            for ln in proc.stdout:
                s = ln.rstrip("\r\n")
                if s:
                    self.append_log(s)
                    if on_line:
                        on_line(s)

        return proc.wait()

    # ---------------- Phase 1: apt-get update & Plan Generation ----------------
    def on_check_updates(self):
        if self._busy:
            return
        if not self._ensure_sudo_authenticated():
            self.lbl_status.set_text("Authentication cancelled.")
            return

        self._busy = True
        self.btn_check.set_sensitive(False)
        self.decision_bar.hide()
        self.nb.set_current_page(0)
        self.txt_log.get_buffer().set_text("")
        self.append_log(f"=== [{datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] Starting apt-get update ===")
        self.set_progress(0.08, "Running sudo apt-get update...", "Refreshing APT")

        force_cde = self.chk_force_cde.get_active()

        def _worker():
            try:
                hit_cnt = [0]

                def _apt_upd_line(ln: str):
                    if ln.startswith(("Hit:", "Get:", "Ign:")):
                        hit_cnt[0] += 1
                        frac = min(0.65, 0.08 + hit_cnt[0] * 0.035)
                        self.set_progress(frac, f"Updating package lists: {ln[:72]}", "apt-get update")

                rc = self._run_sudo_streamed(["apt-get", "update"], on_line=_apt_upd_line)
                if rc != 0:
                    raise RuntimeError(f"apt-get update exited with status {rc} (see Live Log tab).")

                self.set_progress(0.75, "Calculating upgradable Debian packages...", "Analyzing Packages")
                apt_upgs = parse_apt_simulated_upgrades()

                self.set_progress(0.90, "Inspecting CDE C/Motif binaries (ldd / dpkg) & sources...", "Checking CDE Apps")
                cde_rebuilds = analyze_cde_rebuild_plan(apt_upgs, force_all=force_cde)

                GLib.idle_add(self._on_plan_ready, apt_upgs, cde_rebuilds, None)
            except Exception as exc:
                GLib.idle_add(self._on_plan_ready, [], [], str(exc))

        threading.Thread(target=_worker, daemon=True).start()

    def _on_force_cde_toggled(self, *_args):
        if not self._busy and (self.apt_plan or self.cde_plan or self._sudo_pw):
            try:
                self.cde_plan = analyze_cde_rebuild_plan(self.apt_plan, force_all=self.chk_force_cde.get_active())
                self._render_plan_tables()
            except Exception:
                pass

    def _on_plan_ready(self, apt_upgs: list[dict], cde_rebuilds: list[dict], err: str | None):
        self._busy = False
        self.btn_check.set_sensitive(True)

        if err:
            self.set_progress(0.0, f"Update check failed: {err}", "Error")
            self.nb.set_current_page(1)
            return

        self.apt_plan = apt_upgs
        self.cde_plan = cde_rebuilds
        self._render_plan_tables()

    def _render_plan_tables(self):
        self.apt_store.clear()
        self.cde_store.clear()

        self.lbl_apt_hdr.set_text(f"  📦 Debian System Updates ({len(self.apt_plan)} package{'s' if len(self.apt_plan) != 1 else ''})")
        if not self.apt_plan:
            self.apt_store.append([
                "✔ All Debian packages are up to date", "—", "—", "None Needed", "", self.well_hex, int(Pango.Weight.BOLD)
            ])
        else:
            for idx, u in enumerate(self.apt_plan):
                bg = self.well_alt_hex if (idx % 2 == 1) else self.well_hex
                self.apt_store.append([
                    u["pkg"], u["old_ver"], u["new_ver"], u["action"], u["origin"], bg, int(Pango.Weight.BOLD)
                ])

        self.lbl_cde_hdr.set_text(
            f"  🛠 CDE Applications Rebuild Plan ({len(self.cde_plan)} needed)"
        )
        if not self.cde_plan:
            self.cde_store.append([
                "✔ All CDE apps & Motif binaries up to date", "—", "No Rebuild Needed",
                "All shared libraries (ldd) and local sources match installed binaries.",
                self.well_hex, int(Pango.Weight.NORMAL),
            ])
        else:
            for idx, item in enumerate(self.cde_plan):
                bg = self.well_alt_hex if (idx % 2 == 1) else self.well_hex
                self.cde_store.append([
                    item["label"], item["target"], item["action"], item["reason"], bg, int(Pango.Weight.BOLD)
                ])

        n_apt = len(self.apt_plan)
        n_cde = len(self.cde_plan)
        if n_apt == 0 and n_cde == 0:
            self.set_progress(1.0, "System & all CDE applications are completely up to date!", "Up to Date")
            self.decision_bar.hide()
        else:
            summary_q = (
                f"<b>Update Plan Ready:</b>  <b>{n_apt}</b> Debian package update(s)  and  "
                f"<b>{n_cde}</b> CDE application rebuild(s) planned.  Proceed now?"
            )
            self.lbl_decision.set_markup(summary_q)
            for ch in self.decision_bar.get_children():
                ch.show_all()
            self.decision_bar.show()
            self.set_progress(1.0, f"Plan ready: {n_apt} Debian package(s), {n_cde} CDE app rebuild(s). Choose Yes or No above.", "Awaiting Approval")

    # ---------------- Phase 2: Yes / No Execution Engine ----------------
    def on_answer_no(self, *_args):
        self.decision_bar.hide()
        self.set_progress(0.0, "Update cancelled by user — no changes were made.", "Cancelled")

    def on_answer_yes(self, *_args):
        if self._busy:
            return
        if not self._ensure_sudo_authenticated():
            return

        self.decision_bar.hide()
        self._busy = True
        self.btn_check.set_sensitive(False)
        self.nb.set_current_page(0)

        apt_snapshot = list(self.apt_plan)
        cde_snapshot = list(self.cde_plan)

        def _exec_worker():
            started_at = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            rebuilt_ok: list[str] = []
            rebuilt_err: list[str] = []
            wm_restarted = False

            # Keep sudo timestamp alive every 40s during long upgrades
            stop_keepalive = threading.Event()

            def _keepalive():
                while not stop_keepalive.wait(40.0):
                    if self._sudo_pw:
                        subprocess.run(
                            ["sudo", "-S", "-p", "", "-v"],
                            input=self._sudo_pw + "\n", text=True, capture_output=True,
                        )

            threading.Thread(target=_keepalive, daemon=True).start()

            try:
                # 1. Download Debian Packages (0% -> 40%)
                if apt_snapshot:
                    self.append_log("\n=== PHASE 1: Downloading Debian Package Updates ===")
                    self.set_progress(0.04, f"Downloading {len(apt_snapshot)} Debian package(s)...", "Downloading")

                    def _dl_status(_kind, pct, msg):
                        self.set_progress(0.04 + (pct / 100.0) * 0.36, f"Downloading ({int(pct)}%): {msg}", "Downloading")

                    dl_rc = self._run_sudo_streamed(
                        ["apt-get", "-y", "--download-only", "dist-upgrade"],
                        status_fd_cb=_dl_status,
                    )
                    if dl_rc != 0:
                        raise RuntimeError(f"Package download failed (exit code {dl_rc}).")

                    # 2. Install Debian Packages (40% -> 74%)
                    self.append_log("\n=== PHASE 2: Installing Debian Package Updates ===")
                    self.set_progress(0.42, f"Installing {len(apt_snapshot)} Debian package(s)...", "Installing")

                    inst_seen = [0]
                    tot_inst = max(1, len(apt_snapshot) * 2)

                    def _pm_status(_kind, pct, msg):
                        self.set_progress(0.40 + (pct / 100.0) * 0.34, f"Installing ({int(pct)}%): {msg}", "Installing")

                    def _inst_line(ln: str):
                        if ln.startswith(("Unpacking ", "Setting up ")):
                            inst_seen[0] += 1
                            frac = min(0.74, 0.40 + (inst_seen[0] / float(tot_inst)) * 0.34)
                            self.set_progress(frac, ln[:78], "Installing")

                    up_rc = self._run_sudo_streamed(
                        [
                            "apt-get", "-y",
                            "-o", "Dpkg::Options::=--force-confdef",
                            "-o", "Dpkg::Options::=--force-confold",
                            "dist-upgrade",
                        ],
                        on_line=_inst_line,
                        status_fd_cb=_pm_status,
                    )
                    if up_rc != 0:
                        raise RuntimeError(f"apt-get dist-upgrade exited with status {up_rc}.")
                else:
                    self.set_progress(0.74, "No Debian package downloads needed — proceeding to CDE rebuilds...", "CDE Rebuilds")

                # Re-scan CDE binaries post-apt in case newly upgraded .so paths triggered additional links!
                post_extra = analyze_cde_rebuild_plan([], force_all=False)
                planned_targets = {x["target"] for x in cde_snapshot}
                for pe in post_extra:
                    if pe["target"] not in planned_targets:
                        cde_snapshot.append(pe)
                        planned_targets.add(pe["target"])

                # 3. Recompile & Sync Planned CDE Binaries (74% -> 92%)
                if cde_snapshot:
                    self.append_log("\n=== PHASE 3: Recompiling & Verifying CDE Applications ===")
                    LOCAL_BIN.mkdir(parents=True, exist_ok=True)
                    LOCAL_LIB.mkdir(parents=True, exist_ok=True)

                    for idx, item in enumerate(cde_snapshot):
                        frac = 0.75 + ((idx + 0.5) / float(len(cde_snapshot))) * 0.17
                        lbl = item["label"]
                        tgt = item["target"]
                        self.set_progress(frac, f"Building {lbl} ({tgt})...", f"Building {idx + 1}/{len(cde_snapshot)}")
                        self.append_log(f"--> [{idx + 1}/{len(cde_snapshot)}] {lbl}: {item['reason']}")

                        if item["kind"] == "c_motif":
                            bdir = Path(item["build_dir"])
                            inst_p = Path(item["install_path"])
                            built_p = bdir / tgt
                            built_p.unlink(missing_ok=True)

                            res = subprocess.run(["make", "-C", str(bdir), tgt], text=True, capture_output=True)
                            if res.stdout:
                                self.append_log(res.stdout)
                            if res.stderr:
                                self.append_log(res.stderr)
                            if res.returncode != 0 or not built_p.is_file():
                                rebuilt_err.append(f"{lbl} ({tgt}): build failed")
                                continue

                            # Atomic install via .new + os.replace so running daemons never hit ETXTBSY!
                            tmp_dest = inst_p.with_name(inst_p.name + ".dtupd_new")
                            shutil.copy2(built_p, tmp_dest)
                            tmp_dest.chmod(0o755)
                            os.replace(tmp_dest, inst_p)

                            # Keep dtcm / dtmail aliases synced
                            if tgt == "cde-calendar":
                                dtcm_p = LOCAL_BIN / "dtcm"
                                tmp_cm = LOCAL_BIN / "dtcm.dtupd_new"
                                shutil.copy2(built_p, tmp_cm); tmp_cm.chmod(0o755); os.replace(tmp_cm, dtcm_p)
                            rebuilt_ok.append(f"{lbl} -> {inst_p}")
                        else:
                            inst_p = Path(item["install_path"])
                            repo_s = item.get("repo_script") or ""
                            if repo_s and Path(repo_s).is_file():
                                tmp_dest = inst_p.with_name(inst_p.name + ".dtupd_new")
                                shutil.copy2(repo_s, tmp_dest)
                                tmp_dest.chmod(0o755)
                                os.replace(tmp_dest, inst_p)
                            if inst_p.is_file():
                                py_compile.compile(str(inst_p), cfile=f"/tmp/{tgt}_verify.pyc", doraise=True)
                                rebuilt_ok.append(f"{lbl} ({inst_p.name}) — verified Python/GI runtime")

                # 4. Reload CDE Actions & Restart Workspace Manager (dtwm) (92% -> 100%)
                self.append_log("\n=== PHASE 4: Restarting CDE Workspace Manager (dtwm) ===")
                self.set_progress(0.94, "Reloading CDE Actions & restarting Workspace Manager (dtwm)...", "Restarting dtwm")
                wm_restarted = self._restart_cde_workspace_manager()

                finished_at = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                report = self._format_completion_report(
                    started_at, finished_at, apt_snapshot, rebuilt_ok, rebuilt_err, wm_restarted
                )
                GLib.idle_add(self._on_execution_complete, report, None)
            except Exception as exc:
                GLib.idle_add(self._on_execution_complete, "", str(exc))
            finally:
                stop_keepalive.set()

        threading.Thread(target=_exec_worker, daemon=True).start()

    def _restart_cde_workspace_manager(self) -> bool:
        if Path("/usr/dt/bin/dtaction").is_file():
            subprocess.run(["/usr/dt/bin/dtaction", "ReloadActions"], stderr=subprocess.DEVNULL)
            time.sleep(0.4)

        # Prefer cde-panel-tray + cde-apply-layout if installed so system tray stays docked!
        apply_bin = LOCAL_BIN / "cde-apply-layout"
        tray_bin = LOCAL_BIN / "cde-panel-tray"
        if apply_bin.is_file() and os.access(apply_bin, os.X_OK):
            if tray_bin.is_file() and os.access(tray_bin, os.X_OK):
                subprocess.run(["pkill", "-u", str(os.getuid()), "-f", "/cde-panel-tray"], stderr=subprocess.DEVNULL)
                Path(f"/tmp/cde-panel-tray-{os.getuid()}.pid").unlink(missing_ok=True)
                time.sleep(0.2)
                subprocess.Popen([str(tray_bin), "--daemon"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                time.sleep(0.5)
            rc = subprocess.run([str(apply_bin)], capture_output=True, text=True)
            if rc.stdout:
                self.append_log(rc.stdout.strip())
            time.sleep(1.5)
            return rc.returncode == 0

        # Standard CDE dtwm restart fallback
        dtwm_pids = subprocess.run(
            ["pgrep", "-u", str(os.getuid()), "-x", "dtwm"], capture_output=True, text=True
        ).stdout.split()
        if dtwm_pids and Path("/usr/dt/bin/dtwm").is_file():
            subprocess.run(["kill", dtwm_pids[0]], stderr=subprocess.DEVNULL)
            time.sleep(0.5)
            subprocess.Popen(["/usr/dt/bin/dtwm"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            time.sleep(1.5)
            return True
        return False

    def _format_completion_report(self, started: str, finished: str, apt_done: list[dict],
                                  rebuilt_ok: list[str], rebuilt_err: list[str], wm_ok: bool) -> str:
        lines = [
            "==========================================================================",
            "  dtUpdate — System & CDE Workstation Update Summary Overview",
            "==========================================================================",
            f"  Started:   {started}",
            f"  Finished:  {finished}",
            f"  dtwm WM:   {'Restarted cleanly & Front Panel reloaded' if wm_ok else 'Reloaded actions (dtwm not active)'}",
            "",
            f"1. DEBIAN SYSTEM PACKAGES UPDATED ({len(apt_done)})",
            "--------------------------------------------------------------------------",
        ]
        if not apt_done:
            lines.append("  • No Debian package upgrades were required.")
        else:
            kernel_updated = False
            for u in apt_done:
                lines.append(f"  • {u['pkg']:32s}  {u['old_ver']}  ->  {u['new_ver']}")
                if u["pkg"].startswith("linux-image-"):
                    kernel_updated = True
            if kernel_updated:
                lines.append("")
                lines.append("  [!] Note: A new Linux kernel image was installed. Reboot at your convenience.")

        lines += [
            "",
            f"2. CDE APPLICATIONS RECOMPILED / VERIFIED ({len(rebuilt_ok)})",
            "--------------------------------------------------------------------------",
        ]
        if not rebuilt_ok and not rebuilt_err:
            lines.append("  • No CDE binaries required recompilation.")
        for item in rebuilt_ok:
            lines.append(f"  ✔ {item}")
        for err in rebuilt_err:
            lines.append(f"  ✖ {err}")

        lines.append("")
        lines.append("All updates finished.")
        return "\n".join(lines)

    def _on_execution_complete(self, report: str, err: str | None):
        self._busy = False
        self.btn_check.set_sensitive(True)

        if err:
            self.set_progress(0.0, f"Update error: {err}", "Error")
            self.nb.set_current_page(1)
            md = Gtk.MessageDialog(
                transient_for=self, flags=0, message_type=Gtk.MessageType.ERROR,
                buttons=Gtk.ButtonsType.OK, text="dtUpdate encountered an error",
            )
            md.format_secondary_text(f"{err}\n\nCheck the 'Live Build & APT Log' tab for details.")
            md.run(); md.destroy()
            return

        self.last_summary_text = report
        self.apt_plan.clear()
        self.cde_plan.clear()
        self.txt_summary.get_buffer().set_text(report)
        self.nb.set_current_page(2)
        self.set_progress(1.0, "Update, CDE recompilation & Workspace Manager restart complete!", "Finished")

        md = Gtk.MessageDialog(
            transient_for=self, flags=0, message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK, text="dtUpdate Complete — All Updates & Rebuilds Finished!",
        )
        md.format_secondary_text(
            "Your Debian packages, needed CDE binaries, and the CDE Workspace Manager (dtwm) "
            "have been updated and reloaded.\n\n"
            "The full itemized changelog is now displayed in the 'Finished Overview' tab."
        )
        md.run(); md.destroy()

