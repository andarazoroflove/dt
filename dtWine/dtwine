# Windows .lnk Parser & GOG Manifest / Post-Install Target Detector
# ---------------------------------------------------------------------------
def parse_lnk_file(lnk_path: Path) -> dict | None:
    """Parse MS-SHLLINK (.lnk) binary shortcut to extract target, args, workdir, icon."""
    try:
        b = lnk_path.read_bytes()
        if len(b) < 0x4C or struct.unpack_from("<I", b, 0)[0] != 0x0000004C:
            return None
        flags = struct.unpack_from("<I", b, 0x14)[0]
        is_unicode = bool(flags & 0x80)
        pos = 0x4C

        # HasLinkTargetIDList
        if flags & 0x01:
            if pos + 2 > len(b):
                return None
            idlist_size = struct.unpack_from("<H", b, pos)[0]
            pos += 2 + idlist_size

        target_win = ""
        # HasLinkInfo
        if flags & 0x02:
            if pos + 28 > len(b):
                return None
            li_size, li_hdr_size, li_flags = struct.unpack_from("<III", b, pos)
            local_base_off = struct.unpack_from("<I", b, pos + 16)[0]
            common_suf_off = struct.unpack_from("<I", b, pos + 24)[0]
            if (li_flags & 0x01) and local_base_off < li_size:
                s_start = pos + local_base_off
                s_end = b.find(b"\x00", s_start, pos + li_size)
                if s_end != -1:
                    base_str = b[s_start:s_end].decode("cp1252", errors="replace")
                    suf_str = ""
                    if common_suf_off < li_size:
                        c_start = pos + common_suf_off
                        c_end = b.find(b"\x00", c_start, pos + li_size)
                        if c_end != -1:
                            suf_str = b[c_start:c_end].decode("cp1252", errors="replace")
                    target_win = base_str + suf_str
            pos += li_size

        def read_str() -> str:
            nonlocal pos
            if pos + 2 > len(b):
                return ""
            cnt = struct.unpack_from("<H", b, pos)[0]
            pos += 2
            if is_unicode:
                raw = b[pos : pos + cnt * 2]
                pos += cnt * 2
                return raw.decode("utf-16le", errors="replace")
            else:
                raw = b[pos : pos + cnt]
                pos += cnt
                return raw.decode("cp1252", errors="replace")

        name_str = read_str() if (flags & 0x04) else ""
        rel_path = read_str() if (flags & 0x08) else ""
        work_dir = read_str() if (flags & 0x10) else ""
        args_str = read_str() if (flags & 0x20) else ""
        icon_loc = read_str() if (flags & 0x40) else ""

        if not target_win and rel_path and work_dir:
            target_win = work_dir.rstrip("\\/") + "\\" + rel_path.lstrip(".\\/")

        return {
            "lnk_name": lnk_path.stem,
            "target_win": target_win,
            "work_dir_win": work_dir,
            "args": args_str,
            "icon_win": icon_loc,
            "desc": name_str,
        }
    except Exception:
        return None


def snapshot_prefix_files(prefix: Path) -> set[str]:
    drive_c = prefix / "drive_c"
    snap = set()
    if not drive_c.is_dir():
        return snap
    skip_roots = {"windows", "vrclient", "openxr"}
    for root, dirs, files in os.walk(drive_c):
        rel_root = Path(root).relative_to(drive_c)
        if rel_root.parts and rel_root.parts[0].lower() in skip_roots:
            dirs[:] = []
            continue
        for f in files:
            low = f.lower()
            if low.endswith((".exe", ".lnk", ".info", ".bat")):
                snap.add(str(rel_root / f))
    return snap


def detect_installed_targets(prefix: Path, pre_snap: set[str], preferred_title: str = "") -> list[dict]:
    """
    Precision 3-tier post-install target discovery:
    1) GOG goggame-*.info official playTasks manifest (handles native + DOSBox/ScummVM!)
    2) Windows Start Menu / Desktop .lnk shortcuts (filtering out Uninstall/Readme/etc.)
    3) Newly added .exe files in drive_c (filtering out unins000/vcredist/dxsetup/etc.)
    Returns ordered list of candidate dicts:
       {label, exe_path, args, work_dir, icon_path, source}
    """
    drive_c = prefix / "drive_c"
    candidates = []
    seen_keys = set()

    def add_cand(label: str, exe_p: Path, args: str = "", work_p: Path | None = None,
                 ico_p: Path | None = None, source: str = "", priority: int = 50):
        if not exe_p or not exe_p.is_file():
            return
        key = (str(exe_p.resolve()), args.strip())
        if key in seen_keys:
            return
        seen_keys.add(key)
        candidates.append({
            "label": label.strip() or exe_p.stem,
            "exe_path": exe_p.resolve(),
            "args": args.strip(),
            "work_dir": (work_p.resolve() if (work_p and work_p.is_dir()) else exe_p.resolve().parent),
            "icon_path": (ico_p.resolve() if (ico_p and ico_p.is_file()) else None),
            "source": source,
            "priority": priority,
        })

    # Tier 1: GOG goggame-*.info manifests
    for info_file in sorted(drive_c.rglob("goggame-*.info")):
        rel_str = str(info_file.relative_to(drive_c))
        is_new = (not pre_snap) or (rel_str not in pre_snap)
        try:
            info = json.loads(info_file.read_text(encoding="utf-8", errors="replace"))
            gog_name = info.get("name") or preferred_title
            game_id = info.get("gameId", "")
            base_dir = info_file.parent
            ico_candidate = base_dir / f"goggame-{game_id}.ico"
            if not ico_candidate.is_file():
                icos = list(base_dir.glob("goggame-*.ico"))
                ico_candidate = icos[0] if icos else None

            for task in info.get("playTasks", []):
                if task.get("type") != "FileTask":
                    continue
                cat = (task.get("category") or "").lower()
                tname = task.get("name") or gog_name
                if cat in ("document", "other") or JUNK_LNK_PATTERNS.search(tname or ""):
                    continue
                rel_exe = (task.get("path") or "").replace("\\", "/").lstrip("/")
                if not rel_exe:
                    continue
                exe_p = resolve_win_path_in_prefix(prefix, str(base_dir / rel_exe)) if ":" in rel_exe else (base_dir / rel_exe)
                if not exe_p.is_file():
                    # Case-insensitive fallback relative to base_dir
                    cur = base_dir
                    for seg in rel_exe.split("/"):
                        if not seg:
                            continue
                        matches = [c for c in cur.iterdir() if c.name.lower() == seg.lower()] if cur.is_dir() else []
                        cur = matches[0] if matches else (cur / seg)
                    exe_p = cur
                wdir_rel = (task.get("workingDir") or "").replace("\\", "/").strip("/")
                work_p = (base_dir / wdir_rel) if wdir_rel else exe_p.parent
                args = task.get("arguments") or ""
                is_primary = bool(task.get("isPrimary"))
                prio = (100 if is_new else 85) + (10 if is_primary else 0)
                add_cand(gog_name if is_primary else tname, exe_p, args, work_p, ico_candidate, "GOG Manifest", prio)
        except Exception:
            pass

    # Tier 2: Start Menu & Desktop .lnk shortcuts inside drive_c
    for lnk_file in sorted(drive_c.rglob("*.lnk")):
        rel_str = str(lnk_file.relative_to(drive_c))
        if JUNK_LNK_PATTERNS.search(lnk_file.stem):
            continue
        parsed = parse_lnk_file(lnk_file)
        if not parsed or not parsed["target_win"]:
            continue
        exe_p = resolve_win_path_in_prefix(prefix, parsed["target_win"])
        if not exe_p or not exe_p.is_file():
            continue
        if exe_p.suffix.lower() not in (".exe", ".bat", ".com"):
            continue
        if JUNK_EXE_PATTERNS.search(exe_p.name):
            continue
        work_p = resolve_win_path_in_prefix(prefix, parsed["work_dir_win"]) if parsed["work_dir_win"] else exe_p.parent
        ico_p = resolve_win_path_in_prefix(prefix, parsed["icon_win"]) if parsed["icon_win"] else None
        is_new = (not pre_snap) or (rel_str not in pre_snap)
        lbl = parsed["lnk_name"]
        lbl = re.sub(r"^Launch\s+", "", lbl, flags=re.IGNORECASE).strip()
        add_cand(lbl, exe_p, parsed["args"], work_p, ico_p, "Shortcut (.lnk)", 90 if is_new else 70)

    # Tier 3: Filesystem scan of .exe files in drive_c
    skip_roots = {"windows", "users", "vrclient", "openxr", "programdata"}
    title_words = {w.lower() for w in re.findall(r"[a-zA-Z0-9]{3,}", preferred_title)}
    for root, dirs, files in os.walk(drive_c):
        rel_root = Path(root).relative_to(drive_c)
        if rel_root.parts and rel_root.parts[0].lower() in skip_roots:
            dirs[:] = []
            continue
        # Skip Common Files / Internet Explorer / Windows NT / Windows Media Player boilerplate
        if len(rel_root.parts) >= 2 and rel_root.parts[0].lower().startswith("program files"):
            sub_low = rel_root.parts[1].lower()
            if sub_low in ("common files", "internet explorer", "windows media player", "windows nt"):
                dirs[:] = []
                continue
        for f in files:
            if not f.lower().endswith(".exe"):
                continue
            if JUNK_EXE_PATTERNS.search(f):
                continue
            rel_str = str(rel_root / f)
            if JUNK_EXE_PATTERNS.search(rel_str.replace("\\", "/")):
                continue
            exe_p = Path(root) / f
            is_new = (not pre_snap) or (rel_str not in pre_snap)
            if pre_snap and not is_new:
                continue
            try:
                sz = exe_p.stat().st_size
            except OSError:
                sz = 0
            stem_words = {w.lower() for w in re.findall(r"[a-zA-Z0-9]{3,}", exe_p.stem)}
            name_bonus = 15 if (title_words and (title_words & stem_words)) else 0
            gog_bonus = 10 if "gog games" in rel_str.lower() else 0
            size_bonus = min(10, sz // (512 * 1024))
            prio = (65 if is_new else 40) + name_bonus + gog_bonus + size_bonus
            add_cand(preferred_title or exe_p.stem, exe_p, "", exe_p.parent, None, "Detected .exe", prio)

    candidates.sort(key=lambda c: c["priority"], reverse=True)
    return candidates


