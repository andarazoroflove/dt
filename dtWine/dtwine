            self.ent_file.set_text(fpath)
            if not self.ent_title.get_text().strip():
                self.ent_title.set_text(clean_installer_title(fpath))
            elif Path(fpath).name.lower().startswith("setup_"):
                self.ent_title.set_text(clean_installer_title(fpath))
            if detect_pe_arch(fpath) == "win64":
                self.cmb_arch.set_active_id("win64")
