        if dl.is_dir():
            dlg.set_current_folder(str(dl))
        flt = Gtk.FileFilter()
        flt.set_name("Windows Executables & Installers (*.exe, *.msi, *.bat)")
        for pat in ("*.exe", "*.EXE", "*.msi", "*.MSI", "*.bat", "*.BAT", "*.com", "*.COM"):
            flt.add_pattern(pat)
        dlg.add_filter(flt)
        flt_all = Gtk.FileFilter()
        flt_all.set_name("All Files")
        flt_all.add_pattern("*")
        dlg.add_filter(flt_all)

