    def _append_log(self, text: str):
        def _do():
            buf = self.txt_log.get_buffer()
            buf.insert(buf.get_end_iter(), text)
            mark = buf.create_mark(None, buf.get_end_iter(), False)
            self.txt_log.scroll_to_mark(mark, 0.0, True, 0.0, 1.0)
        GLib.idle_add(_do)

    def _on_cancel(self, _btn):
        if self._worker_running and hasattr(self, "_cur_prefix"):
            subprocess.run(["wineserver", "-k"], env=wine_env(self._cur_prefix),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.response(Gtk.ResponseType.CANCEL)

    def _on_next_clicked(self, _btn):
        cur_page = self.stack.get_visible_child_name()
        if cur_page == "step1":
            self._start_install_worker()
        elif cur_page == "step3":
            self._finalize_registration()

    def _start_install_worker(self):
        fpath_str = self.ent_file.get_text().strip()
        if not fpath_str or not Path(fpath_str).is_file():
            self._error("Please select a valid .exe, .msi, or .bat file first.")
            return

        installer_path = Path(fpath_str).resolve()
        title = self.ent_title.get_text().strip() or clean_installer_title(installer_path.name)
        category = "game" if self.rb_cat_game.get_active() else "app"
        is_portable = self.rb_mode_port.get_active()
        arch = self.cmb_arch.get_active_id() or "win64"
        if detect_pe_arch(str(installer_path)) == "win64" and arch == "win32":
            arch = "win64"
        winver = self.cmb_winver.get_active_id() or "win10"
        vdesktop = self.cmb_vdesk.get_active_id() or ""
        verbs = [v for v, cb in self.chk_wt.items() if cb.get_active()]

        slug = make_slug(title)
        prefix = GAMES_ROOT / f"{slug}-wine"
        idx = 2
        while prefix.exists() and (prefix / "system.reg").exists():
            slug_try = f"{slug[:15]}_{idx}"
            prefix = GAMES_ROOT / f"{slug_try}-wine"
            if not prefix.exists():
                slug = slug_try
                break
            idx += 1

        self._cur_slug = slug
        self._cur_title = title
        self._cur_category = category
        self._cur_prefix = prefix
        self._cur_arch = arch
        self._cur_winver = winver
        self._cur_vdesktop = vdesktop
        self._candidates = []

        self.stack.set_visible_child_name("step2")
        self.btn_next.set_sensitive(False)
        self._worker_running = True

        def worker():
            try:
                apply_prefix_settings(prefix, arch, winver, self._append_log)
                env = wine_env(prefix, arch)

                if verbs and WINETRICKS_BIN.is_file():
                    self._append_log(f"==> Installing Winetricks components: {' '.join(verbs)}\n")
                    p = subprocess.Popen(
                        [str(WINETRICKS_BIN), "-q"] + verbs,
                        env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                    )
                    for ln in p.stdout:
                        if "Vulkan support" not in ln:
                            self._append_log(ln)
                    p.wait()
                    subprocess.run(["wineserver", "-w"], env=env)

                if is_portable:
                    dest_root = prefix / "drive_c" / ("Games" if category == "game" else "Program Files") / slug
                    dest_root.parent.mkdir(parents=True, exist_ok=True)
                    src_dir = installer_path.parent
                    # If single loose exe in ~/Downloads, copy just the exe; otherwise copy app folder
                    if src_dir in (HOME, HOME / "Downloads", HOME / "Desktop", Path("/tmp")):
                        dest_root.mkdir(parents=True, exist_ok=True)
                        target_exe = dest_root / installer_path.name
                        self._append_log(f"==> Copying {installer_path.name} -> {target_exe}\n")
                        shutil.copy2(installer_path, target_exe)
                    else:
                        self._append_log(f"==> Copying folder {src_dir} -> {dest_root}\n")
                        shutil.copytree(src_dir, dest_root, dirs_exist_ok=True)
                        target_exe = dest_root / installer_path.name
                    candidates = [{
                        "label": title,
                        "exe_path": target_exe,
                        "args": "",
                        "work_dir": target_exe.parent,
                        "icon_path": None,
                        "source": "Portable Import",
                        "priority": 100,
                    }]
                else:
                    pre_snap = snapshot_prefix_files(prefix)
                    GLib.idle_add(self.lbl_progress.set_text,
                                  f"Running installer: {installer_path.name}  (Complete the Windows setup wizard on screen)")
                    self._append_log(f"\n==> Launching installer: {installer_path}\n")
                    ext = installer_path.suffix.lower()
                    if ext == ".msi":
                        cmd = ["wine", "msiexec", "/i", str(installer_path)]
                    elif ext == ".bat":
                        cmd = ["wine", "cmd", "/c", str(installer_path)]
                    else:
                        cmd = ["wine", str(installer_path)]
                    proc = subprocess.Popen(
                        cmd, cwd=str(installer_path.parent), env=env,
                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                    )
                    for ln in proc.stdout:
                        if "Vulkan support" not in ln and "ntlm_auth" not in ln:
                            self._append_log(ln)
                    proc.wait()
                    self._append_log("==> Waiting for background setup tasks to finish (wineserver -w)...\n")
                    subprocess.run(["wineserver", "-w"], env=env)
                    self._append_log("==> Scanning prefix for installed main executable & icon...\n")
                    candidates = detect_installed_targets(prefix, pre_snap, title)

                self._candidates = candidates
                GLib.idle_add(self._enter_step3)
            except Exception as exc:
                self._append_log(f"\n[ERROR] {exc}\n")
                GLib.idle_add(self.btn_next.set_sensitive, True)
            finally:
                self._worker_running = False

        threading.Thread(target=worker, daemon=True).start()

    def _enter_step3(self):
        self.stack.set_visible_child_name("step3")
        self.cmb_candidates.remove_all()
        self.ent_final_title.set_text(self._cur_title)

        stack_label = "Games" if self._cur_category == "game" else "Personal Applications"
        self.lbl_dest_info.set_markup(
            f"<b>CDE Panel Destination:</b>  Icon from main <tt>.exe</tt> only  →  <b>{stack_label}</b> stack"
        )

        if self._candidates:
            for idx, c in enumerate(self._candidates):
                rel = c["exe_path"]
                try:
                    rel = c["exe_path"].relative_to(self._cur_prefix / "drive_c")
                except ValueError:
                    pass
                tag = f"[{c['source']}] {c['label']}  —  C:\\{str(rel).replace('/', chr(92))}"
                self.cmb_candidates.append(str(idx), tag)
            self.cmb_candidates.set_active(0)
        else:
            self.cmb_candidates.append("-1", "(No new .exe auto-detected — click Browse drive_c...)")
            self.cmb_candidates.set_active(0)
            self._refresh_icon_preview()

        self.btn_next.set_label(f"Add to \"{stack_label}\" Stack & Finish  ✔")
        self.btn_next.set_sensitive(True)

    def _on_candidate_changed(self, cmb):
        cid = cmb.get_active_id()
        if cid is None or cid == "-1":
            return
        idx = int(cid)
        if 0 <= idx < len(self._candidates):
            c = self._candidates[idx]
            self._selected_hint_ico = c.get("icon_path")
            self._selected_workdir = c.get("work_dir")
            self.ent_final_exe.set_text(str(c["exe_path"]))
            self.ent_final_args.set_text(c.get("args", ""))
            if c.get("source") == "GOG Manifest" and c.get("label"):
                self.ent_final_title.set_text(c["label"])
            self._refresh_icon_preview()

    def _on_browse_drive_c(self, _btn):
        dlg = Gtk.FileChooserDialog(
            title="Select Main Executable inside Prefix drive_c",
            parent=self,
            action=Gtk.FileChooserAction.OPEN,
        )
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Select", Gtk.ResponseType.OK)
        dc = self._cur_prefix / "drive_c"
        if dc.is_dir():
            dlg.set_current_folder(str(dc))
        flt = Gtk.FileFilter()
        flt.set_name("Windows Executables (*.exe, *.bat, *.msi)")
        for p in ("*.exe", "*.EXE", "*.bat", "*.BAT", "*.com", "*.COM"):
            flt.add_pattern(p)
        dlg.add_filter(flt)
        if dlg.run() == Gtk.ResponseType.OK:
            p = Path(dlg.get_filename())
            self._selected_hint_ico = None
            self._selected_workdir = p.parent
            self.ent_final_exe.set_text(str(p))
        dlg.destroy()

    def _refresh_icon_preview(self, *_args):
        exe_txt = self.ent_final_exe.get_text().strip()
        exe_p = Path(exe_txt) if exe_txt else None
        hint = getattr(self, "_selected_hint_ico", None)
        im = extract_best_icon(exe_p, hint, getattr(self, "_cur_category", "game"))
        self.img_preview.set_from_pixbuf(pil_to_pixbuf(im, 48))

    def _finalize_registration(self):
        exe_txt = self.ent_final_exe.get_text().strip()
        if not exe_txt or not Path(exe_txt).is_file():
            self._error("Please select the installed main .exe file inside drive_c.")
            return
        exe_p = Path(exe_txt).resolve()
        title = self.ent_final_title.get_text().strip() or self._cur_title
        hint_ico = getattr(self, "_selected_hint_ico", None)
        wdir = getattr(self, "_selected_workdir", None) or exe_p.parent

        entry = {
            "slug": self._cur_slug,
            "title": title,
            "category": self._cur_category,
            "prefix": str(self._cur_prefix),
            "arch": self._cur_arch,
            "winver": self._cur_winver,
            "exe_path": str(exe_p),
            "work_dir": str(wdir),
            "args": self.ent_final_args.get_text().strip(),
            "vdesktop": self._cur_vdesktop,
            "icon_source": str(hint_ico) if hint_ico else "",
        }
        register_cde_entry(entry)
        reload_cde_panel()
        self.result_entry = entry
        self.response(Gtk.ResponseType.OK)

    def _error(self, msg: str):
        md = Gtk.MessageDialog(transient_for=self, flags=0, message_type=Gtk.MessageType.ERROR,
                               buttons=Gtk.ButtonsType.OK, text=msg)
        md.run()
        md.destroy()


