# ---------------------------------------------------------------------------
# Helpers: Slugs, PE Architecture, Windows Paths
# ---------------------------------------------------------------------------
def make_slug(text: str, max_len: int = 18) -> str:
    s = re.sub(r"[^a-z0-9]+", "_", text.lower()).strip("_")
    if not s or not s[0].isalpha():
        s = "app_" + s
    return s[:max_len].rstrip("_")


def clean_installer_title(filename: str) -> str:
    stem = Path(filename).stem
    # GOG pattern: setup_game_name_1.2.3_(64bit)_(12345)
    s = re.sub(r"^setup[_\-\s]+", "", stem, flags=re.IGNORECASE)
    s = re.sub(r"_\(\d+\)$", "", s)
    s = re.sub(r"_\((?:32|64)bit\)", "", s, flags=re.IGNORECASE)
    s = re.sub(r"[_\-]+v?\d+(?:\.\d+)+[a-z0-9_\-]*$", "", s, flags=re.IGNORECASE)
    s = re.sub(r"[_\-]+(setup|install|installer|gog|win32|win64)$", "", s, flags=re.IGNORECASE)
    s = s.replace("_", " ").replace("-", " ").strip()
    if not s:
        s = stem.replace("_", " ").strip()
    # Title-case words unless already mixed case
    if s == s.lower():
        s = " ".join(w.capitalize() if w not in ("of", "and", "the", "in", "to", "ii", "iii", "iv")
                     else (w.upper() if w in ("ii", "iii", "iv") else w)
                     for w in s.split())
        if s:
            s = s[0].upper() + s[1:]
    return s or "Windows Program"


def detect_pe_arch(path: str) -> str:
    """Inspect MZ/PE/NE header to return 'win64', 'win32', 'win16', or 'unknown'."""
    try:
        with open(path, "rb") as f:
            mz = f.read(64)
            if len(mz) < 64 or mz[:2] != b"MZ":
                return "unknown"
            lfanew = struct.unpack_from("<I", mz, 0x3C)[0]
            f.seek(lfanew)
            sig = f.read(6)
            if sig[:4] == b"PE\x00\x00" and len(sig) >= 6:
                machine = struct.unpack_from("<H", sig, 4)[0]
                if machine == 0x8664:
                    return "win64"
                if machine == 0x014C:
                    return "win32"
            elif sig[:2] == b"NE":
                return "win16"
    except Exception:
        pass
    return "unknown"


def resolve_win_path_in_prefix(prefix: Path, win_path: str) -> Path | None:
    """Resolve a Windows path like C:\\GOG Games\\Foo\\bar.exe case-insensitively inside drive_c."""
    if not win_path:
        return None
    p = win_path.strip().strip('"')
    p = p.replace("\\", "/")
    if re.match(r"^[a-zA-Z]:/", p):
        drive = p[0].lower()
        rel = p[3:].lstrip("/")
        base = prefix / "drive_c" if drive == "c" else prefix / "dosdevices" / f"{drive}:"
    else:
        base = prefix / "drive_c"
        rel = p.lstrip("/")

    cur = base
    for part in [seg for seg in rel.split("/") if seg and seg != "."]:
        exact = cur / part
        if exact.exists():
            cur = exact
            continue
        found = None
        if cur.is_dir():
            low = part.lower()
            try:
                for child in cur.iterdir():
                    if child.name.lower() == low:
                        found = child
                        break
            except OSError:
                pass
        if found is None:
            return exact
        cur = found
    return cur


# ---------------------------------------------------------------------------
# Pure-Python PE32 / PE32+ / 16-bit NE / ICO Icon Extractor -> CDE XPM (.pm)
# ---------------------------------------------------------------------------
def decode_dib_icon(data: bytes) -> Image.Image | None:
    """Decode a raw RT_ICON payload (PNG or BITMAPINFOHEADER DIB + 1-bit AND mask)."""
    if len(data) < 16:
        return None
    if data[:8] == b"\x89PNG\r\n\x1a\n":
        try:
            return Image.open(io.BytesIO(data)).convert("RGBA")
        except Exception:
            return None

    try:
        hdr_size = struct.unpack_from("<I", data, 0)[0]
        if hdr_size < 40 or len(data) < hdr_size:
            return None
        width, height2, planes, bpp, compression, img_size = struct.unpack_from("<iiHHII", data, 4)
        clr_used = struct.unpack_from("<I", data, 32)[0]
        width = abs(width)
        height = abs(height2) // 2
        if width <= 0 or height <= 0 or width > 512 or height > 512:
            return None
        if compression not in (0, 3):  # BI_RGB or BI_BITFIELDS
            # Try wrapping in ICO container for Pillow fallback
            return None

        offset = hdr_size
        if compression == 3 and bpp in (16, 32):
            offset += 12

        palette = []
        if bpp <= 8:
            num_colors = clr_used if clr_used > 0 else (1 << bpp)
            for i in range(num_colors):
                if offset + 4 > len(data):
                    break
                b, g, r, _ = struct.unpack_from("<BBBB", data, offset)
                palette.append((r, g, b))
                offset += 4

        xor_stride = ((width * bpp + 31) // 32) * 4
        and_stride = ((width + 31) // 32) * 4
        xor_bytes = xor_stride * height
        if offset + xor_bytes > len(data):
            return None
        xor_data = data[offset : offset + xor_bytes]
        and_offset = offset + xor_bytes
        and_data = data[and_offset : and_offset + and_stride * height]

        im = Image.new("RGBA", (width, height))
        px = im.load()
        has_alpha_channel = False

        for row in range(height):
            y = height - 1 - row  # Bottom-up DIB
            row_off = row * xor_stride
            and_row_off = row * and_stride
            for x in range(width):
                mask_transparent = False
                if len(and_data) >= and_row_off + (x // 8) + 1:
                    mask_byte = and_data[and_row_off + (x // 8)]
                    mask_transparent = bool((mask_byte >> (7 - (x % 8))) & 1)

                if bpp == 32:
                    b, g, r, a = struct.unpack_from("<BBBB", xor_data, row_off + x * 4)
                    if a > 0:
                        has_alpha_channel = True
                    px[x, y] = (r, g, b, a)
                elif bpp == 24:
                    b, g, r = struct.unpack_from("<BBB", xor_data, row_off + x * 3)
                    px[x, y] = (r, g, b, 0 if mask_transparent else 255)
                elif bpp == 16:
                    val = struct.unpack_from("<H", xor_data, row_off + x * 2)[0]
                    r = ((val >> 10) & 0x1F) * 255 // 31
                    g = ((val >> 5) & 0x1F) * 255 // 31
                    b = (val & 0x1F) * 255 // 31
                    px[x, y] = (r, g, b, 0 if mask_transparent else 255)
                elif bpp == 8:
                    idx = xor_data[row_off + x]
                    r, g, b = palette[idx] if idx < len(palette) else (0, 0, 0)
                    px[x, y] = (r, g, b, 0 if mask_transparent else 255)
                elif bpp == 4:
                    byte = xor_data[row_off + (x // 2)]
                    idx = (byte >> 4) & 0x0F if (x % 2 == 0) else (byte & 0x0F)
                    r, g, b = palette[idx] if idx < len(palette) else (0, 0, 0)
                    px[x, y] = (r, g, b, 0 if mask_transparent else 255)
                elif bpp == 1:
                    byte = xor_data[row_off + (x // 8)]
                    idx = (byte >> (7 - (x % 8))) & 1
                    r, g, b = palette[idx] if idx < len(palette) else ((255, 255, 255) if idx else (0, 0, 0))
                    px[x, y] = (r, g, b, 0 if mask_transparent else 255)

        # Some older 32bpp icons leave alpha=0 everywhere and rely on the 1-bit AND mask
        if bpp == 32 and not has_alpha_channel:
            for row in range(height):
                y = height - 1 - row
                and_row_off = row * and_stride
                for x in range(width):
                    r, g, b, _ = px[x, y]
                    mask_transparent = False
                    if len(and_data) >= and_row_off + (x // 8) + 1:
                        mask_byte = and_data[and_row_off + (x // 8)]
                        mask_transparent = bool((mask_byte >> (7 - (x % 8))) & 1)
                    px[x, y] = (r, g, b, 0 if mask_transparent else 255)

        return im
    except Exception:
        return None


def score_icon_candidate(width: int, height: int, bpp: int) -> tuple:
    # Prefer >= 48px (ideal for CDE .l.pm), up to 256px, and higher bit depth
    size_tier = 3 if (48 <= width <= 256) else (2 if width == 32 else (1 if width > 256 else 0))
    pref_dist = -abs(width - 64) if width >= 48 else width
    return (size_tier, bpp, pref_dist)


def extract_icon_from_ico_bytes(data: bytes) -> Image.Image | None:
    if len(data) < 6:
        return None
    try:
        reserved, ico_type, count = struct.unpack_from("<HHH", data, 0)
        if reserved == 0 and ico_type == 1 and 0 < count <= 64:
            best_img = None
            best_score = (-1, -1, -9999)
            for i in range(count):
                ent_off = 6 + i * 16
                if ent_off + 16 > len(data):
                    break
                w, h, color_cnt, _, planes, bpp, size, offset = struct.unpack_from("<BBBBHHII", data, ent_off)
                w = 256 if w == 0 else w
                h = 256 if h == 0 else h
                if offset + size > len(data) or size == 0:
                    continue
                blob = data[offset : offset + size]
                im = decode_dib_icon(blob)
                if im is not None:
                    eff_bpp = bpp or (32 if blob[:8] == b"\x89PNG\r\n\x1a\n" else 8)
                    sc = score_icon_candidate(im.width, im.height, eff_bpp)
                    if sc > best_score:
                        best_score = sc
                        best_img = im
            if best_img is not None:
                return best_img
    except Exception:
        pass
    try:
        im = Image.open(io.BytesIO(data))
        return im.convert("RGBA")
    except Exception:
        return None


def extract_pe_icon(data: bytes, pe_off: int) -> Image.Image | None:
    if pe_off + 24 > len(data) or data[pe_off : pe_off + 4] != b"PE\x00\x00":
        return None
    _, num_sections, _, _, _, opt_hdr_size, _ = struct.unpack_from("<HHIIIHH", data, pe_off + 4)
    opt_off = pe_off + 24
    if opt_off + opt_hdr_size > len(data) or opt_hdr_size < 96:
        return None
    magic = struct.unpack_from("<H", data, opt_off)[0]
    dd_off = opt_off + (112 if magic == 0x20B else 96)
    if dd_off + 24 > opt_off + opt_hdr_size:
        return None
    rsrc_rva, rsrc_size = struct.unpack_from("<II", data, dd_off + 16)  # Index 2 = Resource Table
    if rsrc_rva == 0 or rsrc_size == 0:
        return None

    sec_table_off = opt_off + opt_hdr_size
    sections = []
    for i in range(num_sections):
        soff = sec_table_off + i * 40
        if soff + 40 > len(data):
            break
        vsize, vrva, raw_size, raw_ptr = struct.unpack_from("<IIII", data, soff + 8)
        sections.append((vrva, max(vsize, raw_size), raw_ptr, raw_size))

    def rva_to_off(rva: int) -> int | None:
        for vrva, span, raw_ptr, raw_size in sections:
            if vrva <= rva < vrva + span:
                off = raw_ptr + (rva - vrva)
                return off if off < len(data) else None
        return None

    rsrc_base = rva_to_off(rsrc_rva)
    if rsrc_base is None:
        return None

    def iter_dir(dir_off: int):
        if dir_off + 16 > len(data):
            return
        named_cnt, id_cnt = struct.unpack_from("<HH", data, dir_off + 12)
        pos = dir_off + 16
        for _ in range(named_cnt + id_cnt):
            if pos + 8 > len(data):
                break
            name_or_id, offset_to_data = struct.unpack_from("<II", data, pos)
            pos += 8
            is_dir = bool(offset_to_data & 0x80000000)
            sub_off = rsrc_base + (offset_to_data & 0x7FFFFFFF)
            ident = None if (name_or_id & 0x80000000) else (name_or_id & 0xFFFF)
            yield ident, is_dir, sub_off

    def read_first_leaf(node_off: int) -> bytes | None:
        for _, is_dir, sub_off in iter_dir(node_off):
            if is_dir:
                res = read_first_leaf(sub_off)
                if res is not None:
                    return res
            else:
                if sub_off + 16 <= len(data):
                    data_rva, size = struct.unpack_from("<II", data, sub_off)
                    foff = rva_to_off(data_rva)
                    if foff is not None and foff + size <= len(data):
                        return data[foff : foff + size]
        return None

    rt_icons = {}
    group_blobs = []

    for type_id, is_dir, type_sub in iter_dir(rsrc_base):
        if not is_dir:
            continue
        if type_id == 3:  # RT_ICON
            for icon_id, icon_is_dir, icon_sub in iter_dir(type_sub):
                if icon_id is None:
                    continue
                blob = read_first_leaf(icon_sub) if icon_is_dir else None
                if blob:
                    rt_icons[icon_id] = blob
        elif type_id == 14:  # RT_GROUP_ICON
            for _, grp_is_dir, grp_sub in iter_dir(type_sub):
                blob = read_first_leaf(grp_sub) if grp_is_dir else None
                if blob:
                    group_blobs.append(blob)

    best_img = None
    best_score = (-1, -1, -9999)

    # Parse primary icon group first (Windows Explorer uses first RT_GROUP_ICON)
    for gblob in group_blobs[:2]:
        if len(gblob) < 6:
            continue
        reserved, gtype, gcount = struct.unpack_from("<HHH", gblob, 0)
        if gtype != 1 or gcount == 0 or gcount > 64:
            continue
        pos = 6
        for _ in range(gcount):
            if pos + 14 > len(gblob):
                break
            w, h, _, _, planes, bpp, bytes_in_res, icon_id = struct.unpack_from("<BBBBHHIH", gblob, pos)
            pos += 14
            raw = rt_icons.get(icon_id)
            if not raw:
                continue
            im = decode_dib_icon(raw)
            if im is not None:
                eff_bpp = bpp or (32 if raw[:8] == b"\x89PNG\r\n\x1a\n" else 8)
                sc = score_icon_candidate(im.width, im.height, eff_bpp)
                if sc > best_score:
                    best_score = sc
                    best_img = im
        if best_img is not None:
            return best_img

    # Fallback: try all RT_ICON entries directly
    for raw in rt_icons.values():
        im = decode_dib_icon(raw)
        if im is not None:
            sc = score_icon_candidate(im.width, im.height, 32)
            if sc > best_score:
                best_score = sc
                best_img = im
    return best_img


def extract_ne_icon(data: bytes, ne_off: int) -> Image.Image | None:
    """Extract icon from 16-bit Windows 3.x / Win95 NE executables."""
    try:
        if ne_off + 0x28 > len(data) or data[ne_off : ne_off + 2] != b"NE":
            return None
        rsrc_rel = struct.unpack_from("<H", data, ne_off + 0x24)[0]
        rsrc_off = ne_off + rsrc_rel
        if rsrc_off + 4 > len(data):
            return None
        align_shift = struct.unpack_from("<H", data, rsrc_off)[0]
        pos = rsrc_off + 2
        rt_icons = {}
        while pos + 8 <= len(data):
            type_id = struct.unpack_from("<H", data, pos)[0]
            if type_id == 0:
                break
            count = struct.unpack_from("<H", data, pos + 2)[0]
            pos += 8
            for _ in range(count):
                if pos + 12 > len(data):
                    break
                rn_off, rn_len, _, rn_id = struct.unpack_from("<HHHH", data, pos)
                pos += 12
                file_off = rn_off << align_shift
                byte_len = rn_len << align_shift
                if type_id == 0x8003 and file_off + byte_len <= len(data):
                    rt_icons[rn_id & 0x7FFF] = data[file_off : file_off + byte_len]
        best = None
        best_sc = (-1, -1, -9999)
        for raw in rt_icons.values():
            im = decode_dib_icon(raw)
            if im is not None:
                sc = score_icon_candidate(im.width, im.height, 8)
                if sc > best_sc:
                    best_sc = sc
                    best = im
        return best
    except Exception:
        return None


def make_fallback_cde_icon(category: str = "game") -> Image.Image:
    """Generate a crisp 48x48 CDE Motif fallback icon when an EXE has no embedded icon."""
    im = Image.new("RGBA", (48, 48), (0, 0, 0, 0))
    d = ImageDraw.Draw(im)
    # Beveled Motif tile
    d.rectangle([4, 5, 43, 43], outline=(33, 33, 33, 255), fill=(173, 173, 173, 255))
    d.line([(5, 6), (42, 6)], fill=(230, 230, 230, 255))
    d.line([(5, 6), (5, 42)], fill=(230, 230, 230, 255))
    d.line([(6, 42), (42, 42)], fill=(90, 90, 90, 255))
    d.line([(42, 6), (42, 42)], fill=(90, 90, 90, 255))
    if category == "game":
        # Classic CD-ROM + joystick/gamepad motif
        d.ellipse([10, 10, 37, 37], outline=(33, 33, 33, 255), fill=(108, 172, 208, 255))
        d.ellipse([20, 20, 27, 27], outline=(33, 33, 33, 255), fill=(173, 173, 173, 255))
        d.line([(14, 15), (20, 21)], fill=(255, 255, 255, 255), width=2)
    else:
        # Classic CDE Window application motif
        d.rectangle([7, 8, 40, 14], fill=(44, 86, 126, 255))
        d.rectangle([8, 16, 39, 39], outline=(90, 90, 90, 255), fill=(230, 232, 240, 255))
    return im


def extract_best_icon(exe_path: Path | None, hint_ico: Path | None = None, category: str = "game") -> Image.Image:
    """Extract the best RGBA icon from hint .ico, GOG directory .ico, or target .exe."""
    # 1. Explicit hint .ico (from GOG manifest or .lnk)
    if hint_ico and hint_ico.is_file():
        try:
            im = extract_icon_from_ico_bytes(hint_ico.read_bytes())
            if im is not None:
                return im
        except Exception:
            pass

    if exe_path and exe_path.is_file():
        exe_dir = exe_path.parent
        low_name = exe_path.name.lower()
        # 2. If GOG wrapper (dosbox/scummvm), prefer goggame-*.ico in game folder or parent
        if any(k in low_name for k in ("dosbox", "scummvm")):
            for search_dir in (exe_dir, exe_dir.parent, exe_dir.parent.parent):
                for ico_file in sorted(search_dir.glob("goggame-*.ico")):
                    im = extract_icon_from_ico_bytes(ico_file.read_bytes())
                    if im is not None:
                        return im

        # 3. Direct .ico file passed
        if low_name.endswith(".ico"):
            im = extract_icon_from_ico_bytes(exe_path.read_bytes())
            if im is not None:
                return im

        # 4. Parse PE32 / PE32+ / 16-bit NE resources inside the .exe
        try:
            raw = exe_path.read_bytes()
            if len(raw) >= 64 and raw[:2] == b"MZ":
                lfanew = struct.unpack_from("<I", raw, 0x3C)[0]
                if lfanew + 4 <= len(raw):
                    if raw[lfanew : lfanew + 4] == b"PE\x00\x00":
                        im = extract_pe_icon(raw, lfanew)
                        if im is not None:
                            return im
                    elif raw[lfanew : lfanew + 2] == b"NE":
                        im = extract_ne_icon(raw, lfanew)
                        if im is not None:
                            return im
        except Exception:
            pass

        # 5. Any goggame-*.ico or *.ico alongside the executable
        for ico_file in sorted(list(exe_dir.glob("goggame-*.ico")) + list(exe_dir.glob("*.ico"))):
            try:
                im = extract_icon_from_ico_bytes(ico_file.read_bytes())
                if im is not None:
                    return im
            except Exception:
                pass

    return make_fallback_cde_icon(category)


XPM_CHARS = " .+@#$%&*=-;>,')!~{]^/(_:<[}|1234567890abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"


def save_rgba_as_xpm(im: Image.Image, size: int, out_path: Path, var_name: str):
    """Resize RGBA image cleanly and write CDE-compatible XPM3 with transparent 'None'."""
    src = im.convert("RGBA")
    # Keep pixel-art sharp when upscaling small Win95 16/32px icons, Lanczos when downscaling
    resample = Image.Resampling.NEAREST if (src.width <= 32 and size > src.width and size % src.width == 0) else Image.Resampling.LANCZOS
    scaled = src.resize((size, size), resample)
    alpha = scaled.getchannel("A")
    rgb_quant = scaled.convert("RGB").quantize(colors=220, method=Image.Quantize.MEDIANCUT).convert("RGB")

    px_rgb = rgb_quant.load()
    px_a = alpha.load()

    colors = []
    seen = {}
    for y in range(size):
        for x in range(size):
            if px_a[x, y] < 96:
                continue
            c = px_rgb[x, y]
            if c not in seen:
                seen[c] = len(colors)
                colors.append(c)

    cpp = 1 if (len(colors) + 1) <= len(XPM_CHARS) else 2

    def sym(idx: int) -> str:
        if cpp == 1:
            return XPM_CHARS[idx]
        return XPM_CHARS[idx // len(XPM_CHARS)] + XPM_CHARS[idx % len(XPM_CHARS)]

    lines = [
        "/* XPM */",
        f"static char * {var_name} [] = {{",
        f'"{size} {size} {len(colors) + 1} {cpp}",',
        f'"{sym(0)}\tc None",',
    ]
    for i, (r, g, b) in enumerate(colors, start=1):
        lines.append(f'"{sym(i)}\tc #{r:02X}{g:02X}{b:02X}",')

    for y in range(size):
        row = []
        for x in range(size):
            if px_a[x, y] < 96:
                row.append(sym(0))
            else:
                row.append(sym(seen[px_rgb[x, y]] + 1))
        tail = "," if y < size - 1 else "};"
        lines.append('"' + "".join(row) + '"' + tail)

    out_path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def write_cde_icon_set(im: Image.Image, icon_base: str):
    DT_ICONS.mkdir(parents=True, exist_ok=True)
    clean_var = re.sub(r"[^a-zA-Z0-9_]", "_", icon_base)
    save_rgba_as_xpm(im, 48, DT_ICONS / f"{icon_base}.l.pm", f"{clean_var}_l")
    save_rgba_as_xpm(im, 48, DT_ICONS / f"{icon_base}.pm",   f"{clean_var}")
    save_rgba_as_xpm(im, 32, DT_ICONS / f"{icon_base}.m.pm", f"{clean_var}_m")
    save_rgba_as_xpm(im, 24, DT_ICONS / f"{icon_base}.s.pm", f"{clean_var}_s")
    save_rgba_as_xpm(im, 16, DT_ICONS / f"{icon_base}.t.pm", f"{clean_var}_t")


def pil_to_pixbuf(im: Image.Image, size: int = 48) -> GdkPixbuf.Pixbuf:
    buf = io.BytesIO()
    im.convert("RGBA").resize((size, size), Image.Resampling.LANCZOS).save(buf, format="PNG")
    loader = GdkPixbuf.PixbufLoader.new_with_type("png")
    loader.write(buf.getvalue())
    loader.close()
    return loader.get_pixbuf()


