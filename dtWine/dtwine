def reload_cde_panel():
    """Reload CDE actions database and trigger silent dtwm Front Panel refresh."""
    env = os.environ.copy()
    env["PATH"] = f"/usr/dt/bin:{env.get('PATH', '')}"
    if Path("/usr/dt/bin/dtaction").is_file():
        subprocess.run(["/usr/dt/bin/dtaction", "ReloadActions"], env=env,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # Trigger _DtWmRestartNoConfirm via libDtSvc so new subpanel icons appear immediately
    try:
        x11 = ctypes.CDLL("libX11.so.6")
        dtsvc = ctypes.CDLL("/usr/dt/lib/libDtSvc.so.2")
        x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
        x11.XOpenDisplay.restype = ctypes.c_void_p
        x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
        x11.XDefaultRootWindow.restype = ctypes.c_ulong
        x11.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
        x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
        dtsvc._DtWmRestartNoConfirm.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        dtsvc._DtWmRestartNoConfirm.restype = ctypes.c_int

        dpy = x11.XOpenDisplay(None)
        if dpy:
            root = x11.XDefaultRootWindow(dpy)
            dtsvc._DtWmRestartNoConfirm(dpy, root)
            x11.XSync(dpy, 0)
            x11.XCloseDisplay(dpy)
    except Exception:
        pass


def register_cde_entry(entry: dict) -> dict:
    """
    Generate launcher script, extract .exe icon -> CDE .pm icons, write .dt action,
    Template file, and fp_dynamic/*.fp targeting Games or Personal Applications.
    """
    slug = entry["slug"]
    action_id = entry.get("action_id") or f"dw_{slug}"
    icon_name = entry.get("icon_name") or f"dw_{slug}"
    fp_file_name = entry.get("fp_file") or f"dw_{slug[:8]}1.fp"

    prefix = Path(entry["prefix"])
    exe_path = Path(entry["exe_path"])
    work_dir = Path(entry.get("work_dir") or exe_path.parent)
    args = entry.get("args", "").strip()
    arch = entry.get("arch", "win64")
    vdesktop = entry.get("vdesktop", "")
    category = entry.get("category", "game")  # "game" or "app"
    title = entry["title"].strip()

    # 1. Extract icon from main .exe (or hint .ico) -> CDE XPM icon set
    hint_ico = Path(entry["icon_source"]) if entry.get("icon_source") else None
    icon_img = extract_best_icon(exe_path, hint_ico, category)
    write_cde_icon_set(icon_img, icon_name)

    # 2. Write dedicated Wine launcher script in ~/.local/bin/
    LOCAL_BIN.mkdir(parents=True, exist_ok=True)
    launcher_path = entry.get("launcher")
    launcher = Path(launcher_path) if launcher_path else (LOCAL_BIN / f"dw-{slug}")

    q_prefix = shlex.quote(str(prefix))
    q_workdir = shlex.quote(str(work_dir))
    q_exe = shlex.quote(str(exe_path))

    if vdesktop:
        desk_name = re.sub(r"[^a-zA-Z0-9]", "", slug)[:12] or "dtwine"
        exec_line = f'exec wine explorer /desktop={desk_name},{vdesktop} {q_exe} {args} "$@"'
    elif exe_path.suffix.lower() == ".msi":
        exec_line = f'exec wine msiexec /i {q_exe} {args} "$@"'
    elif exe_path.suffix.lower() == ".bat":
        exec_line = f'exec wine cmd /c {q_exe} {args} "$@"'
    else:
        exec_line = f'exec wine {q_exe} {args} "$@"'

    script_text = f"""#!/usr/bin/env bash
# Auto-generated by dtWine for {title}
export WINEPREFIX={q_prefix}
export WINEARCH={arch}
export WINE_D3D_CONFIG="renderer=gl"
export WINEDLLOVERRIDES="locationapi=d;winemenubuilder.exe=d;mscoree,mshtml="

# Keep Battle.net CEF hardware acceleration off if present in prefix
CFG="$WINEPREFIX/drive_c/users/${{USER:-$(id -un)}}/AppData/Roaming/Battle.net/Battle.net.config"
if [ -f "$CFG" ]; then
    sed -i 's/"HardwareAcceleration"[[:space:]]*:[[:space:]]*"true"/"HardwareAcceleration": "false"/g' "$CFG"
fi

cd {q_workdir} || exit 1
{exec_line}
"""
    launcher.write_text(script_text, encoding="utf-8")
    launcher.chmod(0o755)

    # 3. Write CDE Action file ~/.dt/types/<action_id>.dt
    DT_TYPES.mkdir(parents=True, exist_ok=True)
    dt_file = DT_TYPES / f"{action_id}.dt"
    safe_label = title.replace("\n", " ").strip()
    stack_human = "Games" if category == "game" else "Personal Applications"
    dt_content = f"""######################################################################
# CDE Action Definition generated by dtWine for {safe_label}
######################################################################
set DtDbVersion=1.0

ACTION {action_id}
{{
     LABEL         {safe_label}
     TYPE          COMMAND
     EXEC_STRING   {launcher}
     ICON          {icon_name}
     WINDOW_TYPE   NO_STDIO
     DESCRIPTION   {safe_label} (Wine — {stack_human}).
}}
"""
    dt_file.write_text(dt_content, encoding="utf-8")

    # 4. Write CDE Template file ~/Templates/<action_id>
    TEMPLATES_DIR.mkdir(parents=True, exist_ok=True)
    tmpl = TEMPLATES_DIR / action_id
    tmpl.write_text(
        "# Common Desktop Environment (CDE) action generated by dtWine.\n"
        f'exec "{launcher}" "$@"\n',
        encoding="utf-8",
    )
    tmpl.chmod(0o755)

    # 5. Write CDE Front Panel control in ~/.dt/types/fp_dynamic/
    DT_FP_DYN.mkdir(parents=True, exist_ok=True)
    target_subpanel = SUBPANEL_GAMES if category == "game" else SUBPANEL_APPS
    fp_path = DT_FP_DYN / fp_file_name
    fp_content = f"""CONTROL\t{action_id}
{{
   TYPE\ticon
   CONTAINER_TYPE\tSUBPANEL
   CONTAINER_NAME\t{target_subpanel}
   POSITION_HINTS\tlast
   LABEL\t{safe_label}
   ICON\t{icon_name}
   PUSH_ACTION\t{action_id}
   HELP_STRING\t{safe_label} (Managed by dtWine).
}}
"""
    fp_path.write_text(fp_content, encoding="utf-8")

    entry["action_id"] = action_id
    entry["icon_name"] = icon_name
    entry["fp_file"] = fp_file_name
    entry["launcher"] = str(launcher)
    return entry


def unregister_cde_entry(entry: dict):
    action_id = entry.get("action_id", "")
    icon_name = entry.get("icon_name", "")
    fp_file = entry.get("fp_file", "")
    launcher = entry.get("launcher", "")

    if fp_file and (DT_FP_DYN / fp_file).exists():
        (DT_FP_DYN / fp_file).unlink(missing_ok=True)
    if action_id and action_id not in ("battlenet", "dtWine", "dtwine"):
        (DT_TYPES / f"{action_id}.dt").unlink(missing_ok=True)
        (TEMPLATES_DIR / action_id).unlink(missing_ok=True)
    if icon_name and icon_name not in ("battlenet", "dtWine", "dtwine"):
        for suf in (".l.pm", ".m.pm", ".s.pm", ".t.pm", ".pm"):
            (DT_ICONS / f"{icon_name}{suf}").unlink(missing_ok=True)
    if launcher and Path(launcher).name.startswith("dw-"):
        Path(launcher).unlink(missing_ok=True)


# ---------------------------------------------------------------------------
# Wine Prefix Operations (OpenGL WineD3D)
# ---------------------------------------------------------------------------
def wine_env(prefix: Path, arch: str = "win64") -> dict:
    env = os.environ.copy()
    env["WINEPREFIX"] = str(prefix)
    env["WINEARCH"] = arch
    env["WINE_D3D_CONFIG"] = "renderer=gl"
    env["WINEDLLOVERRIDES"] = "locationapi=d;winemenubuilder.exe=d;mscoree,mshtml="
    env.setdefault("DISPLAY", ":0.0")
    return env


def apply_prefix_settings(prefix: Path, arch: str, winver: str, log_cb=None):
    env = wine_env(prefix, arch)
    prefix.mkdir(parents=True, exist_ok=True)

    def run_logged(cmd, desc=""):
        if log_cb and desc:
            log_cb(f"==> {desc}\n")
        proc = subprocess.Popen(cmd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in proc.stdout:
            if log_cb and "Vulkan support is incomplete" not in line:
                log_cb(line)
        proc.wait()
        return proc.returncode

    if not (prefix / "system.reg").is_file():
        run_logged(["wineboot", "-u"], f"Initializing {arch} Wine prefix at {prefix}...")
        subprocess.run(["wineserver", "-w"], env=env)

    # Force OpenGL WineD3D OpenGL Direct3D/DirectDraw settings
    run_logged(["wine", "reg", "add", r"HKCU\Software\Wine\Direct3D",
                "/v", "renderer", "/t", "REG_SZ", "/d", "gl", "/f"],
               "Configuring WineD3D OpenGL renderer (OpenGL WineD3D)...")
    run_logged(["wine", "reg", "add", r"HKCU\Software\Wine\Direct3D",
                "/v", "DirectDrawRenderer", "/t", "REG_SZ", "/d", "opengl", "/f"])
    if winver:
        run_logged(["wine", "winecfg", "-v", winver], f"Setting Windows compatibility version to {winver}...")
    subprocess.run(["wineserver", "-w"], env=env)


# ---------------------------------------------------------------------------
# Catalog Persistence & Existing Battle.net Auto-Discovery
# ---------------------------------------------------------------------------
def load_entries() -> list[dict]:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    entries = []
    if not ENTRIES_JSON.is_file() and (LEGACY_CONFIG_DIR / "entries.json").is_file():
        shutil.copy2(LEGACY_CONFIG_DIR / "entries.json", ENTRIES_JSON)
    if ENTRIES_JSON.is_file():
        try:
            entries = json.loads(ENTRIES_JSON.read_text(encoding="utf-8"))
        except Exception:
            entries = []

    known_prefixes = {e.get("prefix") for e in entries}
    bnet_pfx = GAMES_ROOT / "battlenet-wine"
    bnet_exe = bnet_pfx / "drive_c" / "Program Files (x86)" / "Battle.net" / "Battle.net Launcher.exe"
    if str(bnet_pfx) not in known_prefixes and bnet_exe.is_file():
        entries.append({
            "slug": "battlenet",
            "title": "Battle.net",
            "category": "app",
            "prefix": str(bnet_pfx),
            "arch": "win64",
            "winver": "win10",
            "exe_path": str(bnet_exe),
            "work_dir": str(bnet_exe.parent),
            "args": "",
            "vdesktop": "",
            "action_id": "battlenet",
            "icon_name": "battlenet",
            "fp_file": "battlenet1.fp",
            "launcher": str(LOCAL_BIN / "battlenet-wine"),
        })
        save_entries(entries)
    return entries


def save_entries(entries: list[dict]):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    ENTRIES_JSON.write_text(json.dumps(entries, indent=2), encoding="utf-8")


