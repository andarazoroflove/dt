        self.right_nb.append_page(sc, Gtk.Label(label="Wine Log"))

    def _log(self, text: str):
        def _do():
            buf = self.main_log.get_buffer()
            buf.insert(buf.get_end_iter(), text)
            mark = buf.create_mark(None, buf.get_end_iter(), False)
            self.main_log.scroll_to_mark(mark, 0.0, True, 0.0, 1.0)
        GLib.idle_add(_do)

    def _populate_list(self, select_idx: int = 0):
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        for e in self.entries:
            row = Gtk.ListBoxRow()
            hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, margin=4)
            ic_pm = DT_ICONS / f"{e.get('icon_name', '')}.m.pm"
            if ic_pm.is_file():
                try:
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_size(str(ic_pm), 28, 28)
                    hb.pack_start(Gtk.Image.new_from_pixbuf(pb), False, False, 0)
                except Exception:
                    pass
            vb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            lbl_n = Gtk.Label(xalign=0)
            lbl_n.set_markup(f"<b>{GLib.markup_escape_text(e['title'])}</b>")
            badge = "Games Stack" if e.get("category") == "game" else "Personal Apps Stack"
            lbl_c = Gtk.Label(label=badge, xalign=0)
            vb.pack_start(lbl_n, False, False, 0)
            vb.pack_start(lbl_c, False, False, 0)
            hb.pack_start(vb, True, True, 0)
            row.add(hb)
            self.listbox.add(row)

        self.listbox.show_all()
        if self.entries:
            idx = max(0, min(select_idx, len(self.entries) - 1))
            self.listbox.select_row(self.listbox.get_row_at_index(idx))
        else:
            self._set_detail_enabled(False)

    def _set_detail_enabled(self, sensitive: bool):
        for w in (self.btn_launch, self.btn_kill, self.btn_save, self.btn_patch, self.btn_delete):
            w.set_sensitive(sensitive)

    def _on_row_selected(self, _lb, row):
        if row is None:
            self.selected_idx = -1
            self._set_detail_enabled(False)
            return
        idx = row.get_index()
        self.selected_idx = idx
        e = self.entries[idx]
        self._set_detail_enabled(True)

        ic_pm = DT_ICONS / f"{e.get('icon_name', '')}.l.pm"
        if ic_pm.is_file():
            try:
                self.img_detail.set_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_size(str(ic_pm), 48, 48))
            except Exception:
                pass

        stack_txt = "Games" if e.get("category") == "game" else "Personal Applications"
        self.lbl_detail_title.set_markup(
            f"<span size='large'><b>{GLib.markup_escape_text(e['title'])}</b></span>\n"
            f"<small>CDE Stack: {stack_txt}  •  Arch: {e.get('arch', 'win64')}</small>"
        )
        self.ed_title.set_text(e.get("title", ""))
        self.ed_cat.set_active_id(e.get("category", "game"))
        self.ed_exe.set_text(e.get("exe_path", ""))
        self.ed_args.set_text(e.get("args", ""))
        self.ed_winver.set_active_id(e.get("winver", "win10"))
        self.ed_vdesk.set_active_id(e.get("vdesktop", ""))
        self.lbl_prefix.set_text(e.get("prefix", ""))

    def open_install_wizard(self, initial_installer: str = ""):
        wiz = InstallWizardDialog(self, initial_installer)
        resp = wiz.run()
        new_entry = wiz.result_entry
        wiz.destroy()
        if resp == Gtk.ResponseType.OK and new_entry:
            self.entries.append(new_entry)
            save_entries(self.entries)
            self._populate_list(len(self.entries) - 1)
            stack_name = "Games" if new_entry["category"] == "game" else "Personal Applications"
            self._log(f"Installed '{new_entry['title']}' and added icon to CDE '{stack_name}' stack.\n")

    def _current_entry(self) -> dict | None:
        if 0 <= self.selected_idx < len(self.entries):
            return self.entries[self.selected_idx]
        return None

    def _on_launch(self, _btn):
        e = self._current_entry()
        if not e:
            return
        launcher = Path(e.get("launcher", ""))
        if not launcher.is_file():
            register_cde_entry(e)
            save_entries(self.entries)
            launcher = Path(e["launcher"])
        self._log(f"==> Launching {e['title']} ({launcher})...\n")
        subprocess.Popen([str(launcher)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    def _on_kill_wine(self, _btn):
        e = self._current_entry()
        if not e:
            return
        subprocess.run(["wineserver", "-k"], env=wine_env(Path(e["prefix"]), e.get("arch", "win64")))
        self._log(f"==> Stopped all Wine processes in {e['prefix']}.\n")

    def _on_browse_edit_exe(self, _btn):
        e = self._current_entry()
        if not e:
            return
        dlg = Gtk.FileChooserDialog(title="Select Main Executable", parent=self, action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Select", Gtk.ResponseType.OK)
        dc = Path(e["prefix"]) / "drive_c"
        if dc.is_dir():
            dlg.set_current_folder(str(dc))
        if dlg.run() == Gtk.ResponseType.OK:
            self.ed_exe.set_text(dlg.get_filename())
        dlg.destroy()

    def _on_save_entry(self, _btn):
        e = self._current_entry()
        if not e:
            return
        old_winver = e.get("winver", "win10")
        e["title"] = self.ed_title.get_text().strip() or e["title"]
        e["category"] = self.ed_cat.get_active_id() or "game"
        e["exe_path"] = self.ed_exe.get_text().strip()
        e["work_dir"] = str(Path(e["exe_path"]).parent) if e["exe_path"] else e.get("work_dir", "")
        e["args"] = self.ed_args.get_text().strip()
        e["winver"] = self.ed_winver.get_active_id() or "win10"
        e["vdesktop"] = self.ed_vdesk.get_active_id() or ""

        # For pre-existing battlenet, keep its custom launcher name intact unless moved
        register_cde_entry(e)
        save_entries(self.entries)
        reload_cde_panel()
        self._populate_list(self.selected_idx)

        if e["winver"] != old_winver:
            threading.Thread(
                target=apply_prefix_settings,
                args=(Path(e["prefix"]), e.get("arch", "win64"), e["winver"], self._log),
                daemon=True,
            ).start()
        self._log(f"==> Saved '{e['title']}' and updated CDE Front Panel icon.\n")

    def _on_run_patch(self, _btn):
        e = self._current_entry()
        if not e:
            return
        dlg = Gtk.FileChooserDialog(title="Select Patch / DLC / Setup .exe or .msi", parent=self, action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Run in Prefix", Gtk.ResponseType.OK)
        if (HOME / "Downloads").is_dir():
            dlg.set_current_folder(str(HOME / "Downloads"))
        if dlg.run() == Gtk.ResponseType.OK:
            fpath = Path(dlg.get_filename())
            dlg.destroy()
            self.right_nb.set_current_page(2)
            env = wine_env(Path(e["prefix"]), e.get("arch", "win64"))
            cmd = ["wine", "msiexec", "/i", str(fpath)] if fpath.suffix.lower() == ".msi" else ["wine", str(fpath)]

            def run_bg():
                self._log(f"==> Running {fpath.name} in {e['prefix']}...\n")
                p = subprocess.Popen(cmd, cwd=str(fpath.parent), env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                for ln in p.stdout:
                    if "Vulkan support" not in ln:
                        self._log(ln)
                p.wait()
                self._log("==> Finished.\n")

            threading.Thread(target=run_bg, daemon=True).start()
        else:
            dlg.destroy()

    def _on_delete_entry(self, _btn):
        e = self._current_entry()
        if not e:
            return
        dlg = Gtk.MessageDialog(
            transient_for=self, flags=0, message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE,
            text=f"Remove '{e['title']}' from dtWine and CDE Front Panel?",
        )
        dlg.format_secondary_text(f"Prefix path: {e['prefix']}")
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                        "Remove Icon Only", 1,
                        "Delete Prefix & Icon", 2)
        resp = dlg.run()
        dlg.destroy()
        if resp not in (1, 2):
            return

        unregister_cde_entry(e)
        if resp == 2:
            pfx = Path(e["prefix"])
            subprocess.run(["wineserver", "-k"], env=wine_env(pfx, e.get("arch", "win64")),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if pfx.is_dir() and pfx.parent == GAMES_ROOT:
                shutil.rmtree(pfx, ignore_errors=True)

        self.entries.pop(self.selected_idx)
        save_entries(self.entries)
        reload_cde_panel()
        self._populate_list(0)

    def _run_prefix_tool(self, cmd_fn):
        e = self._current_entry()
        if not e:
            return
        subprocess.Popen(cmd_fn(e), env=wine_env(Path(e["prefix"]), e.get("arch", "win64")),
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def _on_open_drive_c(self, _btn):
        e = self._current_entry()
        if not e:
            return
        dc = Path(e["prefix"]) / "drive_c"
        dc.mkdir(parents=True, exist_ok=True)
        for fm in ("nautilus", "xdg-open", "/usr/dt/bin/dtfile"):
            if shutil.which(fm):
                subprocess.Popen([fm, str(dc)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                break

    def _on_custom_winetricks(self, _btn):
        verbs = self.ent_wt_custom.get_text().strip().split()
        if verbs:
            self._run_winetricks(verbs)

    def _run_winetricks(self, verbs: list[str]):
        e = self._current_entry()
        if not e or not WINETRICKS_BIN.is_file():
            return
        self.right_nb.set_current_page(2)
        env = wine_env(Path(e["prefix"]), e.get("arch", "win64"))

        def worker():
            self._log(f"==> Running winetricks {' '.join(verbs)} in {e['prefix']}...\n")
            p = subprocess.Popen([str(WINETRICKS_BIN), "-q"] + verbs, env=env,
                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            for ln in p.stdout:
                if "Vulkan support" not in ln:
                    self._log(ln)
            p.wait()
            self._log(f"==> winetricks {' '.join(verbs)} completed (exit {p.returncode}).\n")

        threading.Thread(target=worker, daemon=True).start()

    def _on_reload_panel(self, _btn):
        reload_cde_panel()
        self._log("==> Reloaded CDE actions and refreshed Front Panel.\n")


def main():
    provider = Gtk.CssProvider()
    provider.load_from_data(CDE_MOTIF_CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    initial_arg = sys.argv[1].strip() if len(sys.argv) > 1 else ""
    win = DtWineWindow(initial_arg)
    win.connect("destroy", Gtk.main_quit)
    Gtk.main()


if __name__ == "__main__":
    main()
