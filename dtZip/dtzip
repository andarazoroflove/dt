ARCHIVE_EXT_RE = re.compile(
    r"\.(tar\.gz|tgz|tar\.bz2|tbz2|tbz|tar\.xz|txz|tar\.zst|tzst|tar|zip|7z|rar|gz|bz2|xz|z|iso|cab)$",
    re.IGNORECASE,
)

